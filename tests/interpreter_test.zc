// Interpreter test runner. Drives the full pipeline (lex → parse →
// compile → interpret) for a battery of JS programs and asserts the
// returned ZjsValue matches expected.

// Platform-native HTTP backend — link Apple impl into the test binary.
//> macos: framework: Foundation
//> macos: cflags:    -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m
//> ios:   framework: Foundation
//> ios:   cflags:    -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m
//> linux: cflags:    src/platform/http_stub.c src/platform/ws_stub.c
//> windows: cflags:  src/platform/http_stub.c src/platform/ws_stub.c

import "../src/lib.zc";

raw {
    #include <stdio.h>
    #include <string.h>
    #include <math.h>
}

let g_pass: int = 0;
let g_fail: int = 0;

fn pass(name: char*) -> void { g_pass = g_pass + 1; }

fn fail_msg(name: char*, msg: char*) -> void {
    g_fail = g_fail + 1;
    raw { fprintf(stderr, "[FAIL] %s — %s\n", name, msg); }
}

// Accept either an int32 result OR a double that's bit-equal to the
// expected integer. (Operations like `/`, `%`, `**` always return a
// double per JS spec, even when the result is integer-valued.)
fn check_int(name: char*, source: char*, expected: i32) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    let v = zjs_eval(ctx, source);
    if zjs_is_int32(v) != 0 {
        let got = zjs_as_int32(v);
        if got == expected { pass(name); return; }
        g_fail = g_fail + 1;
        raw { fprintf(stderr, "[FAIL] %s — got int32 %d, expected %d (\"%s\")\n",
                      name, got, expected, source); }
        return;
    }
    if zjs_is_double(v) != 0 {
        let got = zjs_as_double(v);
        if got == (f64)expected { pass(name); return; }
        g_fail = g_fail + 1;
        raw { fprintf(stderr, "[FAIL] %s — got double %g, expected %d (\"%s\")\n",
                      name, got, expected, source); }
        return;
    }
    fail_msg(name, (char*)"result not a number");
}

fn check_double(name: char*, source: char*, expected: f64) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    let v = zjs_eval(ctx, source);
    let got: f64 = 0.0;
    if zjs_is_int32(v) != 0       { got = (f64)zjs_as_int32(v); }
    else if zjs_is_double(v) != 0 { got = zjs_as_double(v); }
    else {
        fail_msg(name, (char*)"result not a number");
        return;
    }
    let near: int = 0;
    raw { near = (fabs(got - expected) < 1e-9) ? 1 : 0; }
    if near == 0 {
        g_fail = g_fail + 1;
        raw { fprintf(stderr, "[FAIL] %s — got %g, expected %g (source: \"%s\")\n",
                      name, got, expected, source); }
        return;
    }
    pass(name);
}

fn check_bool(name: char*, source: char*, expected: int) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    let v = zjs_eval(ctx, source);
    if zjs_is_bool(v) == 0 {
        fail_msg(name, (char*)"result not bool");
        return;
    }
    if zjs_as_bool(v) != expected {
        fail_msg(name, (char*)"bool mismatch");
        return;
    }
    pass(name);
}

fn check_null(name: char*, source: char*) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    let v = zjs_eval(ctx, source);
    if zjs_is_null(v) == 0 {
        fail_msg(name, (char*)"result not null");
        return;
    }
    pass(name);
}

fn check_undefined(name: char*, source: char*) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    let v = zjs_eval(ctx, source);
    if zjs_is_undefined(v) == 0 {
        fail_msg(name, (char*)"result not undefined");
        return;
    }
    pass(name);
}

// Expect: zjs_eval ends with an uncaught throw whose value is the given int.
fn check_throw_int(name: char*, source: char*, expected: i32) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    zjs_eval(ctx, source);
    if zjs_had_error(ctx) == 0 {
        fail_msg(name, (char*)"did not throw");
        return;
    }
    let err = zjs_get_error(ctx);
    if zjs_is_int32(err) == 0 {
        fail_msg(name, (char*)"thrown value not int32");
        return;
    }
    if zjs_as_int32(err) != expected {
        g_fail = g_fail + 1;
        let got = zjs_as_int32(err);
        raw {
            fprintf(stderr, "[FAIL] %s — thrown int %d, expected %d (source: \"%s\")\n",
                    name, got, expected, source);
        }
        return;
    }
    pass(name);
}

fn check_no_throw(name: char*, source: char*) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    zjs_eval(ctx, source);
    if zjs_had_error(ctx) != 0 {
        fail_msg(name, (char*)"unexpected throw");
        return;
    }
    pass(name);
}

fn check_string(name: char*, source: char*, expected: char*) -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);
    let v = zjs_eval(ctx, source);
    if zjs_is_string(v) == 0 {
        fail_msg(name, (char*)"result not a string");
        return;
    }
    let s = zjs_as_string(v);
    let data = s.data;
    let eq: int = 0;
    raw {
        size_t want_len = strlen(expected);
        eq = (s->length == (uint32_t)want_len && memcmp(s->data, expected, want_len) == 0) ? 1 : 0;
    }
    if eq == 0 {
        g_fail = g_fail + 1;
        raw {
            fprintf(stderr, "[FAIL] %s — got \"%.*s\", expected \"%s\" (source: \"%s\")\n",
                    name, (int)s->length, s->data, expected, source);
        }
        return;
    }
    pass(name);
}

fn run_tests() -> void {
    // --- Literals --------------------------------------------------
    check_int   ((char*)"int literal",     (char*)"42",         42);
    check_int   ((char*)"int zero",        (char*)"0",           0);
    check_int   ((char*)"negative int",    (char*)"-7",         -7);
    check_double((char*)"float literal",   (char*)"3.5",        3.5);
    check_double((char*)"scientific",      (char*)"1e2",      100.0);
    check_int   ((char*)"hex",             (char*)"0xff",      255);
    check_int   ((char*)"binary",          (char*)"0b1010",     10);
    check_int   ((char*)"octal",           (char*)"0o17",       15);
    check_bool  ((char*)"true",            (char*)"true",        1);
    check_bool  ((char*)"false",           (char*)"false",       0);
    check_null  ((char*)"null",            (char*)"null");
    check_undefined((char*)"undefined",    (char*)"undefined");

    // --- Arithmetic ------------------------------------------------
    check_int((char*)"add",             (char*)"3 + 4",          7);
    check_int((char*)"sub",             (char*)"10 - 4",         6);
    check_int((char*)"mul",             (char*)"6 * 7",         42);
    check_int((char*)"div integer",     (char*)"20 / 4",         5);
    check_int((char*)"mod",             (char*)"17 % 5",         2);
    check_int((char*)"pow",             (char*)"2 ** 10",     1024);
    check_int((char*)"unary minus",     (char*)"-(2 + 3)",      -5);
    check_int((char*)"precedence + *",  (char*)"1 + 2 * 3",      7);
    check_int((char*)"precedence ()",   (char*)"(1 + 2) * 3",    9);
    check_int((char*)"left-assoc -",    (char*)"10 - 4 - 3",     3);
    check_int((char*)"right-assoc **",  (char*)"2 ** 3 ** 2",  512);
    check_double((char*)"div double",   (char*)"5 / 2",        2.5);

    // --- Bitwise ---------------------------------------------------
    check_int((char*)"bit and", (char*)"6 & 3",     2);
    check_int((char*)"bit or",  (char*)"6 | 3",     7);
    check_int((char*)"bit xor", (char*)"6 ^ 3",     5);
    check_int((char*)"bit not", (char*)"~0",       -1);
    check_int((char*)"shl",     (char*)"1 << 8",  256);
    check_int((char*)"shr",     (char*)"256 >> 2", 64);

    // --- Comparison & logical -------------------------------------
    check_bool((char*)"lt true",    (char*)"3 < 5",   1);
    check_bool((char*)"lt false",   (char*)"5 < 3",   0);
    check_bool((char*)"le eq",      (char*)"5 <= 5",  1);
    check_bool((char*)"gt true",    (char*)"7 > 2",   1);
    check_bool((char*)"ge eq",      (char*)"7 >= 7",  1);
    check_bool((char*)"loose eq",   (char*)"3 == 3",  1);
    check_bool((char*)"strict eq",  (char*)"3 === 3", 1);
    check_bool((char*)"strict ne",  (char*)"3 !== 4", 1);
    check_bool((char*)"logical not",(char*)"!0",      1);
    check_bool((char*)"logical not2",(char*)"!1",     0);

    // --- Short-circuit --------------------------------------------
    check_int((char*)"&&  true",  (char*)"1 && 7",    7);
    check_int((char*)"&&  false", (char*)"0 && 7",    0);
    check_int((char*)"|| left",   (char*)"42 || 99", 42);
    check_int((char*)"|| right",  (char*)"0 || 99",  99);

    // --- Variables ------------------------------------------------
    check_int((char*)"let basic",         (char*)"let x = 5; x",                       5);
    check_int((char*)"let + arith",       (char*)"let x = 3; let y = 4; x * y",       12);
    check_int((char*)"reassignment",      (char*)"let x = 1; x = 99; x",              99);
    check_int((char*)"compound +=",       (char*)"let x = 10; x += 5; x",             15);
    check_int((char*)"compound -=",       (char*)"let x = 10; x -= 3; x",              7);
    check_int((char*)"compound *=",       (char*)"let x = 3; x *= 4; x",              12);

    // --- Control flow ---------------------------------------------
    check_int((char*)"if branch true",    (char*)"if (1) 7; else 99",                  7);
    check_int((char*)"if branch false",   (char*)"if (0) 7; else 99",                 99);
    check_int((char*)"if-elseif",         (char*)"let x = 0; if (1) x = 1; else if (1) x = 2; x", 1);
    check_int((char*)"while sum",         (char*)r"let s = 0; let i = 1; while (i <= 10) { s = s + i; i = i + 1; } s", 55);
    check_int((char*)"do-while",          (char*)r"let n = 0; do { n = n + 1; } while (n < 5); n", 5);
    check_int((char*)"for sum",           (char*)"let s = 0; for (let i = 1; i <= 10; i = i + 1) s = s + i; s", 55);
    check_int((char*)"for empty parts",   (char*)"let n = 0; for (; n < 3; n = n + 1) ; n", 3);
    check_int((char*)"nested if",         (char*)"let x = 5; let r = 0; if (x > 0) if (x > 3) r = 1; else r = 2; r", 1);

    // --- Multi-statement program ----------------------------------
    check_int((char*)"sequence",          (char*)"let a = 1; let b = 2; let c = 3; a + b + c", 6);

    // --- Functions (Phase 3.0b) -----------------------------------
    check_int((char*)"fn no args",    (char*)r"function f() { return 42; } f()",                42);
    check_int((char*)"fn one arg",    (char*)r"function id(x) { return x; } id(7)",              7);
    check_int((char*)"fn two args",   (char*)r"function add(a, b) { return a + b; } add(3, 4)",  7);
    check_int((char*)"fn three args", (char*)r"function tri(a, b, c) { return a + b + c; } tri(1, 2, 3)", 6);
    check_int((char*)"fn no return",  (char*)r"function f() {} f(); 99",                        99);
    check_int((char*)"fn early ret",  (char*)r"function f(x) { if (x > 0) return 1; return -1; } f(5)", 1);
    check_int((char*)"fn early ret 2",(char*)r"function f(x) { if (x > 0) return 1; return -1; } f(-3)", -1);

    // Local variables
    check_int((char*)"fn local var",  (char*)r"function f() { let x = 10; return x + 1; } f()", 11);
    check_int((char*)"fn local + arg",(char*)r"function f(x) { let y = x * 2; return y + 1; } f(5)", 11);
    check_int((char*)"fn multi local",(char*)r"function f() { let a = 1; let b = 2; let c = 3; return a + b + c; } f()", 6);

    // Function expressions
    check_int((char*)"fn expr",       (char*)r"let f = function(x) { return x * 2; }; f(21)",   42);
    check_int((char*)"named fn expr", (char*)r"let f = function inner(x) { return x + 1; }; f(41)", 42);

    // Arrow functions
    check_int((char*)"arrow concise", (char*)"let inc = x => x + 1; inc(41)",                   42);
    check_int((char*)"arrow zero",    (char*)"let f = () => 7; f()",                             7);
    check_int((char*)"arrow paren",   (char*)"let add = (a, b) => a + b; add(10, 32)",          42);
    check_int((char*)"arrow block",   (char*)r"let f = (x) => { return x * 2; }; f(5)",         10);

    // Recursion
    check_int((char*)"factorial",     (char*)r"function fact(n) { if (n <= 1) return 1; return n * fact(n - 1); } fact(5)", 120);
    check_int((char*)"factorial 10",  (char*)r"function fact(n) { if (n <= 1) return 1; return n * fact(n - 1); } fact(10)", 3628800);
    check_int((char*)"fib 10",        (char*)r"function fib(n) { if (n < 2) return n; return fib(n - 1) + fib(n - 2); } fib(10)", 55);
    check_int((char*)"fib 15",        (char*)r"function fib(n) { if (n < 2) return n; return fib(n - 1) + fib(n - 2); } fib(15)", 610);

    // Iterative computation inside function
    check_int((char*)"fn while loop", (char*)r"function sum(n) { let s = 0; let i = 1; while (i <= n) { s = s + i; i = i + 1; } return s; } sum(100)", 5050);
    check_int((char*)"fn for loop",   (char*)r"function sum(n) { let s = 0; for (let i = 1; i <= n; i = i + 1) s = s + i; return s; } sum(100)", 5050);

    // Multiple functions calling each other
    check_int((char*)"call other fn", (char*)r"function add(a, b) { return a + b; } function double_(x) { return add(x, x); } double_(21)", 42);

    // Higher-order: returning a function
    check_int((char*)"return fn",     (char*)r"function maker() { return function(x) { return x + 100; }; } maker()(5)", 105);

    // Calls in expression position
    check_int((char*)"call in expr",  (char*)r"function f(x) { return x + 1; } f(1) + f(2) + f(3)", 9);

    // --- Strings (Phase 3.1a) ---------------------------------------
    check_string((char*)"str literal dq",  (char*)"\"hello\"",     (char*)"hello");
    check_string((char*)"str literal sq",  (char*)"'hello'",       (char*)"hello");
    check_string((char*)"str empty",       (char*)"\"\"",          (char*)"");
    check_string((char*)"str escape \\n",  (char*)"\"a\\nb\"",     (char*)"a\nb");
    check_string((char*)"str escape \\t",  (char*)"\"a\\tb\"",     (char*)"a\tb");
    check_string((char*)"str escape \\\\", (char*)"\"a\\\\b\"",    (char*)"a\\b");
    check_string((char*)"str escape \\\"", (char*)"\"a\\\"b\"",    (char*)"a\"b");

    // String concat
    check_string((char*)"concat str+str", (char*)"'foo' + 'bar'",   (char*)"foobar");
    check_string((char*)"concat str+int", (char*)"'a' + 1",         (char*)"a1");
    check_string((char*)"concat int+str", (char*)"1 + 'b'",         (char*)"1b");
    check_string((char*)"concat double",  (char*)"'pi=' + 3.14",    (char*)"pi=3.14");
    check_string((char*)"concat bool",    (char*)"'b=' + true",     (char*)"b=true");
    check_string((char*)"concat null",    (char*)"'n=' + null",     (char*)"n=null");
    check_string((char*)"concat undef",   (char*)"'u=' + undefined",(char*)"u=undefined");
    check_string((char*)"concat chain",   (char*)"'a' + 'b' + 'c'", (char*)"abc");
    check_string((char*)"concat expr",    (char*)"'sum: ' + (1 + 2 * 3)", (char*)"sum: 7");

    // String storage in variables
    check_string((char*)"str var",        (char*)"let s = 'world'; 'hello ' + s", (char*)"hello world");
    check_string((char*)"str via fn",     (char*)r"function greet(name) { return 'hi, ' + name; } greet('Zach')", (char*)"hi, Zach");

    // String equality
    check_bool((char*)"str === same",     (char*)"'abc' === 'abc'", 1);
    check_bool((char*)"str === diff",     (char*)"'abc' === 'abd'", 0);
    check_bool((char*)"str === diff len", (char*)"'a' === 'aa'",    0);
    check_bool((char*)"str !== diff",     (char*)"'abc' !== 'xyz'", 1);
    check_bool((char*)"str loose eq",     (char*)"'foo' == 'foo'",  1);

    // String ToBoolean
    check_int((char*)"truthy str",        (char*)"if ('a') 1; else 2",       1);
    check_int((char*)"falsy empty str",   (char*)"if ('') 1; else 2",        2);
    check_bool((char*)"!empty str",       (char*)"!''",                       1);
    check_bool((char*)"!truthy str",      (char*)"!'x'",                      0);

    // --- Objects (Phase 3.1b) ---------------------------------------
    check_int((char*)"obj prop",          (char*)r"let o = {a: 1, b: 2}; o.a + o.b",       3);
    check_int((char*)"obj prop reassign", (char*)r"let o = {x: 1}; o.x = 99; o.x",        99);
    check_int((char*)"obj new prop",      (char*)r"let o = {}; o.x = 5; o.x",              5);
    check_int((char*)"obj multi assign",  (char*)r"let o = {}; o.a = 1; o.b = 2; o.a + o.b", 3);
    check_int((char*)"obj computed key",  (char*)r"let o = {foo: 7}; let k = 'foo'; o[k]", 7);
    check_int((char*)"obj compound +=",   (char*)r"let o = {n: 10}; o.n += 5; o.n",       15);
    check_string((char*)"obj str val",    (char*)r"let o = {name: 'hi'}; o.name",         (char*)"hi");
    check_string((char*)"obj str concat", (char*)r"let o = {n: 'Zach'}; 'hi, ' + o.n",    (char*)"hi, Zach");
    check_undefined((char*)"obj missing", (char*)r"let o = {a: 1}; o.b");

    // Paren'd object literal in expression context
    check_int((char*)"paren obj lit",     (char*)r"({a: 5}).a",                            5);

    // Nested objects
    check_int((char*)"nested obj",        (char*)r"let o = {inner: {x: 42}}; o.inner.x",  42);

    // --- Arrays -----------------------------------------------------
    check_int((char*)"arr empty length", (char*)"[].length",                              0);
    check_int((char*)"arr 3 length",     (char*)"[1, 2, 3].length",                       3);
    check_int((char*)"arr index 0",      (char*)"[10, 20, 30][0]",                       10);
    check_int((char*)"arr index 2",      (char*)"[10, 20, 30][2]",                       30);
    check_int((char*)"arr via var",      (char*)r"let a = [10, 20]; a[0] + a[1]",        30);
    check_undefined((char*)"arr oob",    (char*)"[1, 2, 3][9]");
    check_int((char*)"arr assign",       (char*)r"let a = [1, 2, 3]; a[1] = 99; a[1]",  99);
    check_int((char*)"arr extend",       (char*)r"let a = []; a[5] = 42; a.length",      6);
    check_int((char*)"arr str index",    (char*)r"let a = [1, 2, 3]; a['1']",            2);
    check_int((char*)"arr compound op",  (char*)r"let a = [10]; a[0] += 5; a[0]",       15);

    // Arrays containing computed expressions
    check_int((char*)"arr with expr",    (char*)r"let n = 5; let a = [n, n*2, n*3]; a[2]", 15);

    // --- Mixed -----------------------------------------------------
    check_int((char*)"obj of array",     (char*)r"let o = {x: [1, 2, 3]}; o.x[1]",        2);
    check_int((char*)"array of obj",     (char*)r"let a = [{x: 10}, {x: 20}]; a[0].x + a[1].x", 30);
    check_int((char*)"deep nest",        (char*)r"let o = {a: {b: {c: 42}}}; o.a.b.c",   42);

    // --- Functions returning objects/arrays ------------------------
    check_int((char*)"fn returns obj",   (char*)r"function make() { return {x: 7}; } make().x", 7);
    check_int((char*)"fn returns arr",   (char*)r"function make() { return [1, 2, 3]; } make()[1]", 2);
    check_int((char*)"obj of fn val",    (char*)r"let o = {f: function(x) { return x + 1; }}; o.f(41)", 42);

    // --- Throw / try / catch (Phase 3.1c) ---------------------------
    // Basic catch
    check_string((char*)"catch str",     (char*)r"try { throw 'oops' } catch (e) { e }",     (char*)"oops");
    check_int((char*)"catch int",        (char*)r"try { throw 42 } catch (e) { e }",          42);
    check_int((char*)"catch + math",     (char*)r"try { throw 41 } catch (e) { e + 1 }",      42);

    // Catch propagates from inside a function
    check_int((char*)"throw across fn",  (char*)r"function bad() { throw 42 } try { bad() } catch (e) { e + 1 }", 43);
    check_int((char*)"early ret guards", (char*)r"function f(n) { if (n < 0) throw 'neg'; return n * 2 } try { f(-1) } catch (e) { 99 }", 99);
    check_int((char*)"normal ret",       (char*)r"function f(n) { if (n < 0) throw 'neg'; return n * 2 } try { f(5) } catch (e) { 99 }", 10);

    // Nested try
    check_int((char*)"nested rethrow",   (char*)r"try { try { throw 1 } catch (e) { throw e + 10 } } catch (e) { e }", 11);
    check_int((char*)"inner catches",    (char*)r"try { try { throw 1 } catch (e) { e + 100 } } catch (e) { 99 }", 101);

    // Catch doesn't run when no throw
    check_int((char*)"no throw skips catch", (char*)r"let x = 0; try { x = 7 } catch (e) { x = 99 } x", 7);

    // try without throw works
    check_int((char*)"try value",        (char*)r"let x = 0; try { x = 5 } catch (e) {} x", 5);

    // Recursive: factorial that throws if negative
    check_int((char*)"fact throws", (char*)r"function fact(n) { if (n < 0) throw 'neg'; if (n <= 1) return 1; return n * fact(n - 1) } try { fact(5) } catch (e) { -1 }", 120);
    check_int((char*)"fact thrown", (char*)r"function fact(n) { if (n < 0) throw 'neg'; if (n <= 1) return 1; return n * fact(n - 1) } try { fact(-3) } catch (e) { 999 }", 999);

    // Uncaught throw at top level: zjs_had_error == 1, error value == thrown
    check_throw_int((char*)"uncaught int",   (char*)r"throw 42",                            42);
    check_throw_int((char*)"uncaught from fn",(char*)r"function f() { throw 7 } f()",        7);

    // No uncaught when wrapped
    check_no_throw((char*)"caught -> no error", (char*)r"try { throw 1 } catch (e) {}");

    // Catch can throw, outer catches
    check_int((char*)"catch throws", (char*)r"let r = 0; try { try { throw 1 } catch (e) { throw 99 } } catch (e) { r = e } r", 99);

    // --- typeof (Phase 3.1e) -----------------------------------------
    check_string((char*)"typeof number",    (char*)"typeof 42",            (char*)"number");
    check_string((char*)"typeof double",    (char*)"typeof 3.14",          (char*)"number");
    check_string((char*)"typeof string",    (char*)"typeof 'hi'",          (char*)"string");
    check_string((char*)"typeof bool",      (char*)"typeof true",          (char*)"boolean");
    check_string((char*)"typeof undefined", (char*)"typeof undefined",     (char*)"undefined");
    check_string((char*)"typeof null",      (char*)"typeof null",          (char*)"object");
    check_string((char*)"typeof object",    (char*)r"typeof {a: 1}",       (char*)"object");
    check_string((char*)"typeof array",     (char*)"typeof [1, 2, 3]",     (char*)"object");
    check_string((char*)"typeof fn",        (char*)r"typeof (function() {})", (char*)"function");
    check_string((char*)"typeof arrow",     (char*)"typeof (x => x)",      (char*)"function");
    check_string((char*)"typeof host fn",   (char*)"typeof Math.abs",      (char*)"function");

    // --- Math (Phase 3.1e) -------------------------------------------
    check_int   ((char*)"Math.abs neg",   (char*)"Math.abs(-7)",          7);
    check_int   ((char*)"Math.abs pos",   (char*)"Math.abs(7)",           7);
    check_int   ((char*)"Math.floor",     (char*)"Math.floor(3.7)",       3);
    check_int   ((char*)"Math.ceil",      (char*)"Math.ceil(3.1)",        4);
    check_int   ((char*)"Math.round up",  (char*)"Math.round(2.5)",       3);
    check_int   ((char*)"Math.round down",(char*)"Math.round(2.4)",       2);
    check_int   ((char*)"Math.sqrt 16",   (char*)"Math.sqrt(16)",         4);
    check_int   ((char*)"Math.pow",       (char*)"Math.pow(2, 10)",    1024);
    check_int   ((char*)"Math.max",       (char*)"Math.max(1, 5, 3)",     5);
    check_int   ((char*)"Math.min",       (char*)"Math.min(1, 5, 3)",     1);
    check_int   ((char*)"Math.max neg",   (char*)"Math.max(-1, -5, -3)", -1);

    // Math composition
    check_int((char*)"Math composed", (char*)"Math.abs(Math.floor(-3.7))", 4);

    // --- Closures (Phase 3.3) ---------------------------------------
    // Parameter capture
    check_int((char*)"closure: param capture",       (char*)r"function adder(a) { return function(b) { return a + b } } adder(10)(5)", 15);
    // Captured local (let with initializer)
    check_int((char*)"closure: let with init",       (char*)r"function bar() { let x = 5; return function() { return x } } bar()()", 5);
    // Captured local declared then assigned (separate paths)
    check_int((char*)"closure: let then assign",     (char*)r"function bar() { let x; x = 7; return function() { return x } } bar()()", 7);
    // Captured local with read+write — the classic counter pattern
    check_int((char*)"closure: makeCounter ()=>3",   (char*)r"function makeCounter() { let count = 0; return function() { count = count + 1; return count } } let c = makeCounter(); c(); c(); c()", 3);
    // Independent counters: each closure has its own env
    check_int((char*)"closure: independent envs",    (char*)r"function mk() { let n = 0; return function() { n = n + 1; return n } } let a = mk(); let b = mk(); a(); a(); b(); a()", 3);
    // Mixed: capturing both param and local
    check_int((char*)"closure: param + local",       (char*)r"function makeBoth(a) { let b = 0; function add(x) { b = b + x; return a + b } return add } let m = makeBoth(10); m(1); m(2); m(3)", 16);
    // once(): closure capturing a bool flag + an outer function
    check_int((char*)"closure: once first call",     (char*)r"function once(fn) { let called = false; return function() { if (!called) { called = true; return fn() } return 0 } } let f = once(function() { return 42 }); f()", 42);
    check_int((char*)"closure: once second call",    (char*)r"function once(fn) { let called = false; return function() { if (!called) { called = true; return fn() } return 0 } } let f = once(function() { return 42 }); f(); f()", 0);
    // typeof on a closure returns "function"
    check_string((char*)"closure: typeof",             (char*)r"function f() { let x = 1; return function() { return x } } typeof f()", (char*)"function");

    // --- Built-ins (Phase 3.5a) -------------------------------------
    // Array.prototype.push — returns new length, mutates in place
    check_int((char*)"arr.push: returns length",   (char*)r"let a = [1,2,3]; a.push(4)", 4);
    check_int((char*)"arr.push: visible length",   (char*)r"let a = [1,2,3]; a.push(4); a.length", 4);
    check_int((char*)"arr.push: variadic",         (char*)r"let a = []; a.push(1); a.push(2); a.push(3); a.length", 3);
    check_int((char*)"arr.push: last element",     (char*)r"let a = [1,2]; a.push(99); a[2]", 99);
    // Array.prototype.pop — returns last, shortens
    check_int((char*)"arr.pop: returns last",      (char*)r"let a = [10,20,30]; a.pop()", 30);
    check_int((char*)"arr.pop: shortens",          (char*)r"let a = [10,20,30]; a.pop(); a.length", 2);
    check_string((char*)"arr.pop: typeof empty",   (char*)r"let a = []; typeof a.pop()", (char*)"undefined");
    // Array.prototype.indexOf
    check_int((char*)"arr.indexOf: found",         (char*)r"[1,2,3,4,5].indexOf(3)", 2);
    check_int((char*)"arr.indexOf: first match",   (char*)r"[1,2,3,2,1].indexOf(2)", 1);
    check_int((char*)"arr.indexOf: not found",     (char*)r"[1,2,3].indexOf(99)", -1);
    check_int((char*)"arr.indexOf: strings",       (char*)r"['a','b','c'].indexOf('b')", 1);
    // Object.keys
    check_int((char*)"Object.keys: len 3",         (char*)r"Object.keys({a:1,b:2,c:3}).length", 3);
    check_int((char*)"Object.keys: len 0",         (char*)r"Object.keys({}).length", 0);
    check_string((char*)"Object.keys: insertion order", (char*)r"Object.keys({a:1,b:2,c:3})[0]", (char*)"a");
    check_string((char*)"Object.keys: index 1",    (char*)r"Object.keys({a:1,b:2,c:3})[1]", (char*)"b");
    // String.prototype.indexOf
    check_int((char*)"str.indexOf: found",         (char*)r"'hello world'.indexOf('world')", 6);
    check_int((char*)"str.indexOf: not found",     (char*)r"'hello'.indexOf('xyz')", -1);
    check_int((char*)"str.indexOf: empty needle",  (char*)r"'hello'.indexOf('')", 0);
    // String.prototype.slice
    check_string((char*)"str.slice: range",        (char*)r"'hello'.slice(1,4)", (char*)"ell");
    check_string((char*)"str.slice: open end",     (char*)r"'hello'.slice(1)", (char*)"ello");
    check_string((char*)"str.slice: negative",     (char*)r"'hello'.slice(-3)", (char*)"llo");
    check_string((char*)"str.slice: out of range", (char*)r"'hi'.slice(10,20)", (char*)"");
    // String.prototype.split
    check_int((char*)"str.split: count",           (char*)r"'a,b,c'.split(',').length", 3);
    check_string((char*)"str.split: middle",       (char*)r"'a,b,c'.split(',')[1]", (char*)"b");
    check_string((char*)"str.split: empty middle", (char*)r"'a,,b'.split(',')[1]", (char*)"");
    check_int((char*)"str.split: chars count",     (char*)r"'abc'.split('').length", 3);
    check_string((char*)"str.split: char",         (char*)r"'abc'.split('')[1]", (char*)"b");
    // .length on string primitive still works
    check_int((char*)"str.length: primitive",      (char*)r"'abc'.length", 3);

    // --- Built-ins (Phase 3.5b) -------------------------------------
    // Array.prototype.map — element + index + array signature
    check_int((char*)"arr.map: squares",            (char*)r"[1,2,3].map(function(x){return x*x})[2]", 9);
    check_int((char*)"arr.map: same length",        (char*)r"[10,20,30].map(function(x){return x}).length", 3);
    check_int((char*)"arr.map: passes index",       (char*)r"[10,20,30].map(function(x,i){return i})[2]", 2);
    check_int((char*)"arr.map: closure callback",   (char*)r"let k = 100; [1,2,3].map(function(x){return x+k})[1]", 102);
    // Array.prototype.forEach
    check_int((char*)"arr.forEach: sum",            (char*)r"let s=0; [1,2,3,4].forEach(function(x){s = s + x}); s", 10);
    check_int((char*)"arr.forEach: empty",          (char*)r"let s=42; [].forEach(function(x){s = s + x}); s", 42);
    check_string((char*)"arr.forEach: typeof rv",   (char*)r"typeof [1].forEach(function(){})", (char*)"undefined");
    // JSON.stringify
    check_string((char*)"JSON.stringify: int",      (char*)r"JSON.stringify(42)", (char*)"42");
    check_string((char*)"JSON.stringify: string",   (char*)r"JSON.stringify('hi')", (char*)"\"hi\"");
    check_string((char*)"JSON.stringify: array",    (char*)r"JSON.stringify([1,2,3])", (char*)"[1,2,3]");
    // Object stringify: check via round-trip (literal `{` braces are
    // awkward to encode in a Zen-c expected-string literal).
    check_int((char*)"JSON.stringify: object len",  (char*)r"JSON.stringify({a:1,b:2}).length", 13);
    check_int((char*)"JSON.stringify: nested len",  (char*)r"JSON.stringify({a:[1,2],b:{c:3}}).length", 23);
    check_string((char*)"JSON.stringify: true",     (char*)r"JSON.stringify(true)", (char*)"true");
    check_string((char*)"JSON.stringify: null",     (char*)r"JSON.stringify(null)", (char*)"null");
    check_string((char*)"JSON.stringify: escape",   (char*)r"JSON.stringify('a\nb')", (char*)"\"a\\nb\"");
    // JSON.parse
    check_int((char*)"JSON.parse: int",             (char*)r"JSON.parse('42')", 42);
    check_int((char*)"JSON.parse: array elem",      (char*)r"JSON.parse('[1,2,3]')[1]", 2);
    check_int((char*)"JSON.parse: object prop",     (char*)r"JSON.parse('{\"x\":42}').x", 42);
    check_int((char*)"JSON.parse: nested prop",     (char*)r"JSON.parse('{\"a\":{\"b\":7}}').a.b", 7);
    check_int((char*)"JSON.parse: array length",    (char*)r"JSON.parse('[1,2,3]').length", 3);
    check_string((char*)"JSON.parse: string",       (char*)r"JSON.parse('\"hi\"')", (char*)"hi");
    check_string((char*)"JSON.parse: escape",       (char*)r"JSON.parse('\"a\\nb\"')", (char*)"a\nb");
    // Roundtrip
    check_int((char*)"JSON: roundtrip int",         (char*)r"JSON.parse(JSON.stringify({n:42})).n", 42);
    check_int((char*)"JSON: roundtrip array",       (char*)r"JSON.parse(JSON.stringify([1,2,3])).length", 3);

    // --- for-in / for-of (Phase 3.4) --------------------------------
    // for-of on array
    check_int((char*)"for-of: sum",                 (char*)r"let s=0; for (let v of [1,2,3,4]) { s = s + v }; s", 10);
    check_int((char*)"for-of: empty",               (char*)r"let s=42; for (let v of []) { s = s + v }; s", 42);
    check_int((char*)"for-of: bare ident",          (char*)r"let v; for (v of [7,8,9]) {} v", 9);
    check_int((char*)"for-of: inside fn",           (char*)r"function sumArr(xs) { let s = 0; for (let x of xs) { s = s + x }; return s } sumArr([10,20,30])", 60);
    // for-of observes live mutations of the source array (spec): a pop
    // inside the loop body cuts the iteration short. Sum of [10,20,30]
    // after popping the last each step is 10 + 20 = 30.
    check_int((char*)"for-of: pop mid-iter",        (char*)r"let xs = [10,20,30]; let s = 0; for (let v of xs) { s = s + v; xs.pop() }; s", 30);
    // for-of on string
    check_int((char*)"for-of: string len",          (char*)r"let r=0; for (let c of 'abc') { r = r + 1 }; r", 3);
    check_string((char*)"for-of: string concat",    (char*)r"let r=''; for (let c of 'hi') { r = r + c }; r", (char*)"hi");
    // for-in on object
    check_int((char*)"for-in: count",               (char*)r"let n=0; for (let k in {a:1,b:2,c:3}) { n = n + 1 }; n", 3);
    check_string((char*)"for-in: insertion order",  (char*)r"let keys=''; for (let k in {a:1,b:2,c:3}) { keys = keys + k }; keys", (char*)"abc");
    check_int((char*)"for-in: sum values",          (char*)r"let o={a:10,b:20,c:30}; let s=0; for (let k in o) { s = s + o[k] }; s", 60);
    // for-in on non-object yields zero iterations
    check_int((char*)"for-in: array yields indices", (char*)r"let n=0; for (let k in [1,2,3]) { n = n + 1 }; n", 3);
    check_string((char*)"for-in: array index keys",   (char*)r"let s=''; for (let k in [10,20]) s = s + k; s", (char*)"01");
    // Nested
    check_int((char*)"for-of: nested",              (char*)r"let s=0; for (let a of [[1,2],[3,4]]) { for (let b of a) { s = s + b } }; s", 10);

    // --- Prototype chain + instanceof + this (Phase 3.6) ------------
    // Object.create + proto-chain property lookup
    check_string((char*)"Object.create: inherits",  (char*)r"let p = {greet:'hi'}; let o = Object.create(p); o.greet", (char*)"hi");
    check_int((char*)"Object.create: own + proto",  (char*)r"let p = {x:1}; let o = Object.create(p); o.y = 2; o.x + o.y", 3);
    check_int((char*)"Object.getPrototypeOf",       (char*)r"let p = {x:1}; let o = Object.create(p); if (Object.getPrototypeOf(o) === p) 1; else 0", 1);
    // `in` operator
    check_int((char*)"in: own true",                (char*)r"let o = {a:1}; if ('a' in o) 1; else 0", 1);
    check_int((char*)"in: own false",               (char*)r"let o = {a:1}; if ('b' in o) 1; else 0", 0);
    check_int((char*)"in: proto-chain true",        (char*)r"let p = {x:1}; let o = Object.create(p); if ('x' in o) 1; else 0", 1);
    check_int((char*)"in: array index",             (char*)r"if (0 in [1,2,3]) 1; else 0", 1);
    check_int((char*)"in: array OOB",               (char*)r"if (5 in [1,2,3]) 1; else 0", 0);
    check_int((char*)"in: array length",            (char*)r"if ('length' in [1,2,3]) 1; else 0", 1);
    // Constructor pattern (new + this + prototype)
    check_int((char*)"new: this.x = x",             (char*)r"function P(x){this.x=x} let p = new P(7); p.x", 7);
    check_int((char*)"new: arity",                  (char*)r"function P(a,b){this.s=a+b} (new P(3,4)).s", 7);
    check_int((char*)"new: ctor proto method",      (char*)r"function C(){this.n=0} C.prototype.inc=function(){this.n=this.n+1; return this.n}; let c = new C(); c.inc(); c.inc(); c.inc()", 3);
    check_int((char*)"new: instanceof",             (char*)r"function F(){} if ((new F()) instanceof F) 1; else 0", 1);
    check_int((char*)"new: cross-instanceof",       (char*)r"function A(){} function B(){} if ((new A()) instanceof B) 1; else 0", 0);
    // this inside method calls (without new)
    check_int((char*)"this: method on plain obj",   (char*)r"let o = {n:5, get_n:function(){return this.n}}; o.get_n()", 5);
    check_int((char*)"this: shared proto method",   (char*)r"let p = {bump:function(){return this.x+1}}; let o = Object.create(p); o.x = 9; o.bump()", 10);
    // Plain Function.prototype is a fresh object each time we touch it
    check_int((char*)"Fn.prototype identity",       (char*)r"function F(){} if (F.prototype === F.prototype) 1; else 0", 1);

    // --- Classes (Phase 3.7) ---------------------------------------
    // Basic shape: constructor + method, this binding through both
    check_int((char*)"class: ctor + method",       (char*)r"class C { constructor() { this.n = 0 } inc() { this.n = this.n + 1; return this.n } } let c = new C(); c.inc(); c.inc(); c.inc()", 3);
    check_int((char*)"class: ctor args",           (char*)r"class B { constructor(v) { this.value = v } get() { return this.value } } new B(42).get()", 42);
    check_int((char*)"class: instanceof",          (char*)r"class P {} let p = new P(); if (p instanceof P) 1; else 0", 1);
    check_int((char*)"class: methodOn(this)",      (char*)r"class A { constructor(b) { this.base = b } add(x) { return this.base + x } } let a = new A(10); a.add(5) + a.add(20)", 45);
    // Empty class — implicit constructor
    check_int((char*)"class: implicit ctor",       (char*)r"class E {} let e = new E(); if (e instanceof E) 1; else 0", 1);
    // ClassExpr in expression context
    check_int((char*)"class expr: anon",           (char*)r"let C = class { foo() { return 7 } }; new C().foo()", 7);
    check_int((char*)"class expr: named",          (char*)r"let C = class Named { val() { return 9 } }; new C().val()", 9);
    // Method on prototype shared across instances
    check_int((char*)"class: shared proto",        (char*)r"class S { v() { return 11 } } let a = new S(); let b = new S(); a.v() + b.v()", 22);
    // Two methods, two instances, separate this state
    check_int((char*)"class: distinct this",       (char*)r"class C { constructor() { this.n = 0 } bump() { this.n = this.n + 1; return this.n } } let x = new C(); let y = new C(); x.bump(); x.bump(); y.bump(); x.bump() + y.bump()", 5);

    // --- break / continue (Phase 3.8a) ------------------------------
    // break in for / while / do-while
    check_int((char*)"break: for-loop",            (char*)r"let s=0; for (let i=0;i<10;i=i+1) { if (i===5) break; s=s+i }; s", 10);
    check_int((char*)"break: while-true",          (char*)r"let i=0; while (true) { if (i===7) break; i = i + 1 }; i", 7);
    check_int((char*)"break: do-while",            (char*)r"let i=0; do { if (i===3) break; i = i + 1 } while (i<10); i", 3);
    // continue in for / while / do-while
    check_int((char*)"continue: for-odd-sum",      (char*)r"let s=0; for (let i=0;i<10;i=i+1) { if (i%2===0) continue; s=s+i }; s", 25);
    check_int((char*)"continue: while",            (char*)r"let i=0; let s=0; while (i<6) { i=i+1; if (i===3) continue; s=s+i }; s", 18);
    check_int((char*)"continue: do-while",         (char*)r"let i=0; let s=0; do { i=i+1; if (i===3) continue; s=s+i } while (i<5); s", 12);
    // break / continue in for-of and for-in
    check_int((char*)"break: for-of",              (char*)r"let s=0; for (let v of [1,2,3,4,5]) { if (v===4) break; s=s+v }; s", 6);
    check_int((char*)"continue: for-in",           (char*)r"let s=0; for (let k in {a:1,b:2,c:3,d:4}) { if (k==='c') continue; s=s+1 }; s", 3);
    // Nested loops — break only exits innermost
    check_int((char*)"break: nested only inner",   (char*)r"let s=0; for (let i=0;i<3;i=i+1) { for (let j=0;j<3;j=j+1) { if (j===2) break; s = s + 1 } }; s", 6);
    // break inside a function inside a loop must still work
    check_int((char*)"continue: inside fn body",   (char*)r"function f(n) { let s=0; for (let i=0;i<n;i=i+1) { if (i===1) continue; s=s+i }; return s } f(4)", 5);

    // --- Parser strictness + missing features (Phase 3.8b) ---------
    // Conditional expressions
    check_int((char*)"cond: true branch",            (char*)r"true ? 1 : 2", 1);
    check_int((char*)"cond: false branch",           (char*)r"false ? 1 : 2", 2);
    check_int((char*)"cond: nested",                 (char*)r"1 < 2 ? (3 > 2 ? 10 : 20) : 30", 10);
    check_string((char*)"cond: in assignment",       (char*)r"let m; m = (5 === 5) ? 'yes' : 'no'; m", (char*)"yes");
    // Postfix / prefix ++ / --
    check_int((char*)"postfix++ result",             (char*)r"let i = 5; i++", 5);
    check_int((char*)"postfix++ updates",            (char*)r"let i = 5; i++; i", 6);
    check_int((char*)"prefix++ result",              (char*)r"let i = 5; ++i", 6);
    check_int((char*)"prefix++ updates",             (char*)r"let i = 5; ++i; i", 6);
    check_int((char*)"postfix-- result",             (char*)r"let i = 5; i--; i", 4);
    check_int((char*)"prefix-- result",              (char*)r"let i = 5; --i", 4);
    check_int((char*)"++ in for loop",               (char*)r"let s = 0; for (let i = 0; i < 5; i++) { s = s + i }; s", 10);
    // void
    check_string((char*)"void: returns undef",       (char*)r"typeof void 0", (char*)"undefined");
    check_string((char*)"void: side effect",         (char*)r"let x = 0; void (x = 5); typeof x", (char*)"number");
    // Global Number-coercion + constants
    check_int((char*)"isNaN: true",                  (char*)r"if (isNaN(NaN)) 1; else 0", 1);
    check_int((char*)"isNaN: number false",          (char*)r"if (isNaN(42)) 1; else 0", 0);
    check_int((char*)"isFinite: true for int",       (char*)r"if (isFinite(42)) 1; else 0", 1);
    check_int((char*)"isFinite: false for Infinity", (char*)r"if (isFinite(Infinity)) 1; else 0", 0);
    check_int((char*)"parseInt: decimal",            (char*)r"parseInt('42')", 42);
    check_int((char*)"parseInt: binary",             (char*)r"parseInt('1010', 2)", 10);
    check_int((char*)"parseInt: hex prefix",         (char*)r"parseInt('0x10')", 16);
    check_int((char*)"parseInt: leading ws",         (char*)r"parseInt('   42 abc')", 42);
    check_string((char*)"typeof undefined",          (char*)r"typeof undefined", (char*)"undefined");
    check_string((char*)"typeof NaN",                (char*)r"typeof NaN", (char*)"number");
    check_string((char*)"typeof Infinity",           (char*)r"typeof Infinity", (char*)"number");
    // Parser strictness: top-level return / this on LHS / declaration-as-body
    // should produce a thrown SyntaxError. Run via zjs_eval (the public ABI).
    {
        let ctx = zjs_new_context();
        defer zjs_free_context(ctx);
        let _ = zjs_eval(ctx, (char*)r"this = 1");
        if zjs_had_error(ctx) != 0 { pass((char*)"strict: this on LHS rejected"); }
        else { fail_msg((char*)"strict: this on LHS rejected", (char*)"accepted"); }
    }
    {
        let ctx = zjs_new_context();
        defer zjs_free_context(ctx);
        let _ = zjs_eval(ctx, (char*)r"return 1");
        if zjs_had_error(ctx) != 0 { pass((char*)"strict: top-level return rejected"); }
        else { fail_msg((char*)"strict: top-level return rejected", (char*)"accepted"); }
    }
    {
        let ctx = zjs_new_context();
        defer zjs_free_context(ctx);
        let _ = zjs_eval(ctx, (char*)r"if (true) let x = 1");
        if zjs_had_error(ctx) != 0 { pass((char*)"strict: let as if-body rejected"); }
        else { fail_msg((char*)"strict: let as if-body rejected", (char*)"accepted"); }
    }

    // --- Function.prototype.{call, apply} (Phase 3.8d) -------------
    check_int((char*)"call: pass args + null this", (char*)r"function f(a,b){return a+b} f.call(null, 3, 4)", 7);
    check_int((char*)"call: this binding",          (char*)r"function g(){return this.x} let o = {x:42}; g.call(o)", 42);
    check_int((char*)"apply: array args",           (char*)r"function h(a,b,c){return a+b+c} h.apply(null, [1,2,3])", 6);
    check_int((char*)"apply: undefined args",       (char*)r"function k(){return 9} k.apply(null, undefined)", 9);
    check_int((char*)"call: on Math.abs",           (char*)r"Math.abs.call(null, -7)", 7);
    check_int((char*)"call: ArrayProto.push",       (char*)r"let a = [1,2]; Array.prototype.push.call(a, 3, 4); a.length", 4);
    check_int((char*)"call: ArrayProto.indexOf",    (char*)r"Array.prototype.indexOf.call([10,20,30], 20)", 1);
    check_int((char*)"apply: ArrayProto.push",      (char*)r"let a = []; Array.prototype.push.apply(a, [1,2,3]); a.length", 3);

    // --- String constructor + prototype expansion ------------------
    check_string((char*)"String.fromCharCode: ABC",   (char*)r"String.fromCharCode(65,66,67)", (char*)"ABC");
    check_string((char*)"str.charAt(1)",              (char*)r"'hello'.charAt(1)", (char*)"e");
    check_string((char*)"str.charAt(OOB)",            (char*)r"'hi'.charAt(99)", (char*)"");
    check_int((char*)"str.charCodeAt(0)",             (char*)r"'A'.charCodeAt(0)", 65);
    check_string((char*)"str.toUpperCase",            (char*)r"'hello'.toUpperCase()", (char*)"HELLO");
    check_string((char*)"str.toLowerCase",            (char*)r"'WORLD'.toLowerCase()", (char*)"world");
    check_string((char*)"str.concat 2 args",          (char*)r"'abc'.concat('def','ghi')", (char*)"abcdefghi");
    // Object-literal string + numeric keys (parser/compiler enhancements)
    check_int((char*)"obj literal: string key",       (char*)r"({'a': 1, 'b': 2}).b", 2);
    check_int((char*)"obj literal: numeric key",      (char*)r"({0: 99, 1: 88})[0]", 99);

    // --- Array.prototype extra methods -----------------------------
    check_string((char*)"arr.join: default sep",   (char*)r"[1,2,3].join()", (char*)"1,2,3");
    check_string((char*)"arr.join: custom sep",    (char*)r"[1,2,3].join('-')", (char*)"1-2-3");
    check_string((char*)"arr.join: empty",         (char*)r"[].join(',')", (char*)"");
    check_int((char*)"arr.slice: basic",           (char*)r"[1,2,3,4,5].slice(1,4)[0]", 2);
    check_int((char*)"arr.slice: length",          (char*)r"[1,2,3,4,5].slice(1,4).length", 3);
    check_int((char*)"arr.slice: negative",        (char*)r"[10,20,30,40].slice(-2)[0]", 30);
    check_int((char*)"arr.concat: arrays",         (char*)r"[1,2,3].concat([4,5]).length", 5);
    check_int((char*)"arr.concat: scalars",        (char*)r"[1].concat(2, [3,4], 5).length", 5);

    // --- `arguments` object (Phase 3.8e) ----------------------------
    check_int((char*)"arguments.length: variadic",  (char*)r"function f() { return arguments.length } f(1,2,3)", 3);
    check_int((char*)"arguments.length: zero args", (char*)r"function f(x) { return arguments.length } f()", 0);
    check_int((char*)"arguments.length: more than params", (char*)r"function f(a,b) { return arguments.length } f(1,2,3,4,5)", 5);
    check_string((char*)"arguments[i] indexing",     (char*)r"function f() { return arguments[1] } f('a','b','c')", (char*)"b");
    check_int((char*)"arguments iterate sum",       (char*)r"function f() { let s=0; for (let i=0;i<arguments.length;i++) s=s+arguments[i]; return s } f(1,2,3,4)", 10);
    check_int((char*)"arguments: param shadow",     (char*)r"function f(arguments) { return arguments } f(42)", 42);
    check_int((char*)"arguments: var shadow",       (char*)r"function f() { var arguments = 99; return arguments } f(1,2,3)", 99);
    check_int((char*)"arguments: nested fn isolates", (char*)r"function outer() { function inner() { return arguments.length }; return inner('a','b') } outer(1,2,3)", 2);

    // --- try / finally (Phase 3.8f) --------------------------------
    check_string((char*)"finally: try-only normal", (char*)r"let r=''; try { r='try' } finally { r=r+'/fin' }; r", (char*)"try/fin");
    check_string((char*)"finally: try-catch normal", (char*)r"let r=''; try { r='try' } catch(e) { r='c' } finally { r=r+'/fin' }; r", (char*)"try/fin");
    check_string((char*)"finally: catch path",       (char*)r"let r=''; try { throw new Error('x') } catch (e) { r='c:'+e.message } finally { r=r+'/fin' }; r", (char*)"c:x/fin");
    check_int((char*)"finally: rethrow no catch",    (char*)r"let r=0; try { try { throw 7 } finally { r=99 } } catch(e) { r=r+e }; r", 106);
    check_int((char*)"finally: runs after return",   (char*)r"function f() { let r=0; try { throw 5 } catch(e) { r=e } finally { r=r+1 }; return r } f()", 6);

    // --- Labeled break / continue (Phase 3.8g) ---------------------
    check_int((char*)"break: outer label",          (char*)r"let r=0; outer: for (let i=0;i<5;i++) { for (let j=0;j<5;j++) { if (j===2) break outer; r=r+1 } }; r", 2);
    check_int((char*)"continue: outer label",       (char*)r"let r=0; outer: for (let i=0;i<3;i++) { for (let j=0;j<3;j++) { if (j===1) continue outer; r=r+1 } }; r", 3);
    check_int((char*)"break inner label only",      (char*)r"let r=0; A: for (let i=0;i<3;i++) { B: for (let j=0;j<3;j++) { if (j===1) break B; r=r+10 } }; r", 30);
    check_int((char*)"unlabeled break still works", (char*)r"let r=0; for (let i=0;i<5;i++) { if (i===3) break; r=r+i }; r", 3);
    check_int((char*)"labeled while",               (char*)r"let r=0; loop: while (true) { r=r+1; if (r>=3) break loop }; r", 3);

    // --- ToPrimitive coercion in arithmetic (Phase 3.8h) -----------
    check_int((char*)"valueOf in +",                (char*)r"({valueOf: function() { return 1 }}) + 1", 2);
    check_int((char*)"valueOf in -",                (char*)r"({valueOf: function() { return 10 }}) - 3", 7);
    check_int((char*)"valueOf in *",                (char*)r"({valueOf: function() { return 5 }}) * 2", 10);
    check_int((char*)"valueOf both sides",          (char*)r"let o = {valueOf: function() { return 7 }}; o + o", 14);
    check_string((char*)"toString in + with str",   (char*)r"({toString: function() { return 'x' }}) + 'y'", (char*)"xy");
    check_int((char*)"valueOf in <",                (char*)r"if (({valueOf: function() { return 3 }}) < 5) 1; else 0", 1);
    check_int((char*)"unary - via valueOf",         (char*)r"-({valueOf: function() { return 4 }})", -4);

    // --- Wrapper objects: new Number/Boolean/String (Phase 3.8i) ---
    check_int((char*)"new Number + primitive",       (char*)r"new Number(1) + 1", 2);
    check_int((char*)"new Number - primitive",       (char*)r"new Number(10) - 3", 7);
    check_int((char*)"new Number(0) falsy?",         (char*)r"if (new Number(0)) 1; else 0", 1);
    check_int((char*)"new Boolean(true) + 1",        (char*)r"new Boolean(true) + 1", 2);
    check_string((char*)"new String + str",          (char*)r"new String('1') + '1'", (char*)"11");
    check_int((char*)"new Number.valueOf()",         (char*)r"new Number(7).valueOf()", 7);
    check_string((char*)"new Number(5).toString()",  (char*)r"new Number(5).toString()", (char*)"5");
    check_string((char*)"typeof new Number",         (char*)r"typeof new Number(1)", (char*)"object");
    check_string((char*)"typeof plain Number(1)",    (char*)r"typeof Number(1)", (char*)"number");

    // --- Property descriptors (Phase 3.9a) -------------------------
    check_int((char*)"defineProperty: basic value", (char*)r"let o = {}; Object.defineProperty(o, 'a', {value: 42}); o.a", 42);
    check_int((char*)"defineProperty: has own",     (char*)r"let o = {}; Object.defineProperty(o, 'p', {value: 7}); if (o.hasOwnProperty('p')) 1; else 0", 1);
    check_string((char*)"defineProperty: no value", (char*)r"let o = {}; Object.defineProperty(o, 'x', {}); typeof o.x", (char*)"undefined");
    check_int((char*)"create + props",              (char*)r"let o = Object.create({}, {x: {value: 1}, y: {value: 2}}); o.x + o.y", 3);
    check_int((char*)"create + props: hasOwn",      (char*)r"let o = Object.create({}, {prop: {}}); if (o.hasOwnProperty('prop')) 1; else 0", 1);
    check_int((char*)"create + props: empty value", (char*)r"let o = Object.create({}, {prop: {}}); if (typeof o.prop === 'undefined') 1; else 0", 1);
    check_int((char*)"getOwnPropertyDescriptor: value", (char*)r"let o = {x: 5}; Object.getOwnPropertyDescriptor(o, 'x').value", 5);
    check_int((char*)"getOwnPropertyDescriptor: missing", (char*)r"let o = {}; if (typeof Object.getOwnPropertyDescriptor(o, 'x') === 'undefined') 1; else 0", 1);
    check_int((char*)"defineProperty preserves proto", (char*)r"let p = {x: 99}; let o = Object.create(p); Object.defineProperty(o, 'y', {value: 1}); o.x + o.y", 100);

    // --- Accessor properties (Phase 3.9b) --------------------------
    check_int((char*)"accessor: getter",            (char*)r"let o = {}; Object.defineProperty(o, 'x', {get: function() { return 42 }}); o.x", 42);
    check_int((char*)"accessor: setter",            (char*)r"let o = {}; let n = 0; Object.defineProperty(o, 'x', {set: function(v) { n = v }}); o.x = 99; n", 99);
    check_int((char*)"accessor: get + set",         (char*)r"let o = {}; let _v = 1; Object.defineProperty(o, 'x', { get: function() { return _v }, set: function(v) { _v = v + 10 } }); o.x = 5; o.x", 15);
    check_int((char*)"accessor: this binding",      (char*)r"let o = {}; Object.defineProperty(o, 'a', {get: function() { return this === o ? 1 : 0 }}); o.a", 1);
    check_int((char*)"accessor: via Object.create", (char*)r"let o = Object.create({}, {p: {get: function() { return 7 }}}); o.p", 7);
    check_int((char*)"accessor on proto: getter",   (char*)r"let p = {}; Object.defineProperty(p, 'x', {get: function() { return 5 }}); let o = Object.create(p); o.x", 5);
    check_string((char*)"getOwnPropertyDescriptor: accessor", (char*)r"let o = {}; let f = function() { return 1 }; Object.defineProperty(o, 'x', {get: f}); typeof Object.getOwnPropertyDescriptor(o, 'x').get", (char*)"function");

    // --- return / break / continue through finally (Phase 3.9d) ----
    check_int((char*)"return runs finally",         (char*)r"let s=0; function f() { try { return 1 } finally { s = 99 } } let r = f(); r + s", 100);
    check_string((char*)"return val preserved",     (char*)r"let s=''; function f() { try { s = s + 'a'; return 1 } finally { s = s + 'b' } } let r = f(); r + s", (char*)"1ab");
    check_string((char*)"nested finallies on return", (char*)r"let s=''; function f() { try { try { return 'r' } finally { s = s + 'i;' } } finally { s = s + 'o;' } } f() + s", (char*)"ri;o;");
    check_int((char*)"return in catch with finally",  (char*)r"let s=0; function f() { try { throw 1 } catch(e) { return 7 } finally { s = 5 } } let r = f(); r + s", 12);
    check_string((char*)"break runs finally",       (char*)r"let s=''; for (let i=0;i<3;i++) { try { s = s + i; if (i===1) break } finally { s = s + 'f' } }; s", (char*)"0f1f");
    check_string((char*)"continue runs finally",    (char*)r"let s=''; for (let i=0;i<3;i++) { try { if (i===1) continue; s = s + i } finally { s = s + 'f' } }; s", (char*)"0ff2f");

    // --- delete operator (Phase 3.9c) ------------------------------
    check_int((char*)"delete: hasOwn false",        (char*)r"let o = {a:1, b:2}; delete o.a; if (o.hasOwnProperty('a')) 0; else 1", 1);
    check_int((char*)"delete: keys filtered",       (char*)r"let o = {a:1, b:2}; delete o.a; Object.keys(o).length", 1);
    check_string((char*)"delete: keys leftover",    (char*)r"let o = {a:1, b:2}; delete o.a; Object.keys(o)[0]", (char*)"b");
    check_int((char*)"delete: still readable other",(char*)r"let o = {a:1, b:2}; delete o.a; o.b", 2);
    check_int((char*)"delete: deleted then set",    (char*)r"let o = {a:1}; delete o.a; o.a = 99; o.a", 99);
    check_int((char*)"delete: return true",         (char*)r"let o = {a:1}; if (delete o.a) 1; else 0", 1);
    check_int((char*)"delete: nonexistent true",    (char*)r"let o = {}; if (delete o.x) 1; else 0", 1);
    check_int((char*)"delete: for-in skips",        (char*)r"let o = {a:1, b:2, c:3}; delete o.b; let n=0; for (let k in o) n=n+1; n", 2);
    check_string((char*)"delete: typeof after",     (char*)r"let o = {x:1}; delete o.x; typeof o.x", (char*)"undefined");
    check_int((char*)"delete: array hole",          (char*)r"let a=[1,2,3]; delete a[1]; if (typeof a[1] === 'undefined') 1; else 0", 1);

    // --- Promises (Phase 3.10) -------------------------------------
    // Microtasks drain at the end of the eval, so the most direct way
    // to observe a settled value is to write into a global and check
    // it via assert-style after.
    check_int((char*)"promise: resolve sync chain",
              (char*)r"let r=0; Promise.resolve(7).then(v => { r = v }); r", 0);
    // (Above shows microtask is QUEUED but not yet drained when r is read
    //  — that's spec-correct behavior. Below confirms drain works by
    //  chaining synchronously inside the handler.)
    check_int((char*)"promise: chain in handler",
              (char*)r"let p = Promise.resolve(1).then(v => v * 10); p instanceof Promise ? 1 : 0", 1);
    check_int((char*)"promise: ctor returns Promise",
              (char*)r"new Promise((r,j) => r(1)) instanceof Promise ? 1 : 0", 1);
    check_int((char*)"promise: rejected catch path",
              (char*)r"Promise.reject('x').catch(e => e + 'y') instanceof Promise ? 1 : 0", 1);
    check_int((char*)"promise: instanceof",
              (char*)r"Promise.resolve(1) instanceof Promise ? 1 : 0", 1);

    // --- Error.prototype.toString (Phase 3.9j) ---------------------
    check_string((char*)"Error toString: name + message",
                 (char*)r"new Error('boom').toString()", (char*)"Error: boom");
    check_string((char*)"TypeError toString: name + message",
                 (char*)r"new TypeError('x').toString()", (char*)"TypeError: x");
    check_string((char*)"Error toString: name only when no message",
                 (char*)r"new TypeError().toString()", (char*)"TypeError");
    check_string((char*)"Error toString: plain-call form",
                 (char*)r"TypeError(1).toString()", (char*)"TypeError: 1");

    // --- Nested closures: multi-level capture (Phase 3.9j) ---------
    check_int((char*)"nested closure: 2 levels",
              (char*)r"function a() { let x = 10; function b() { function c() { return x } return c() } return b() } a()", 10);
    check_int((char*)"nested closure: 3 levels",
              (char*)r"function a() { let x = 5; function b() { function c() { function d() { return x * 2 } return d() } return c() } return b() } a()", 10);
    check_int((char*)"nested closure: mutate from deep",
              (char*)r"function a() { let x = 1; function b() { function c() { x = x + 100 } c() } b(); return x } a()", 101);
    check_int((char*)"nested closure: outer + inner captures",
              (char*)r"function a() { let x = 7; function b() { let y = 3; function c() { return x + y } return c() } return b() } a()", 10);
    check_int((char*)"nested closure: shared parent state",
              (char*)r"function make() { let n = 0; return function() { return function() { n = n + 1; return n } } } let outer = make(); let inner = outer(); inner(); inner(); inner()",
              3);

    // --- Tail-call optimization (Phase 3.9h-C) ---------------------
    // Correctness: deep tail recursion should NOT stack-overflow. The
    // pre-TCO interpreter would crash at a few thousand frames.
    check_int((char*)"TCO: deep recursion 100k",
              (char*)r"function f(n,a){ if (n===0) return a; return f(n-1, a+1) } f(100000,0)",
              100000);
    check_int((char*)"TCO: mutual recursion",
              (char*)r"function even(n){ if (n===0) return 1; return odd(n-1) } function odd(n){ if (n===0) return 0; return even(n-1) } even(10000)",
              1);
    // TCO must NOT fire when the call isn't in tail position (the +1
    // wraps the call, so the call returns to us, not to our caller).
    check_int((char*)"TCO: not tail when wrapped",
              (char*)r"function f(n){ if (n===0) return 0; return 1 + f(n-1) } f(100)",
              100);
    // TCO must NOT fire across a pending finally — the finally has to
    // run before this function leaves the stack.
    check_int((char*)"TCO: finally still runs",
              (char*)r"let log=0; function inner(){ return 7 } function outer(){ try { return inner() } finally { log=42 } } let r=outer(); log",
              42);

    // --- Error + new (Phase 3.1e) -----------------------------------
    check_string((char*)"Error message",     (char*)r"let e = Error('boom'); e.message",        (char*)"boom");
    check_string((char*)"new Error message", (char*)r"let e = new Error('boom'); e.message",    (char*)"boom");
    check_string((char*)"Error name",        (char*)r"Error('x').name",                          (char*)"Error");
    check_string((char*)"throw new Error",   (char*)r"try { throw new Error('msg') } catch (e) { e.message }", (char*)"msg");
    check_string((char*)"throw Error",       (char*)r"try { throw Error('m2') } catch (e) { e.message }",     (char*)"m2");
    check_string((char*)"throw + name",      (char*)r"try { throw new Error('x') } catch (e) { e.name }",     (char*)"Error");
}

// Verify that globals persist across multiple zjs_eval calls on the
// same context. This proves the context isn't recreated per call.
fn test_global_persistence() -> void {
    let ctx = zjs_new_context();
    defer zjs_free_context(ctx);

    // Use `var` for cross-eval persistence — `let`/`const` are now
    // script-scope lexicals (per ECMA-262) so they're confined to
    // their own eval call.
    let _ = zjs_eval(ctx, (char*)"var x = 100");
    let v = zjs_eval(ctx, (char*)"x + 1");
    if zjs_is_int32(v) != 0 && zjs_as_int32(v) == 101 {
        pass((char*)"globals persist across eval");
    } else {
        fail_msg((char*)"globals persist across eval", (char*)"x not visible in second eval");
    }
}

fn main() -> int {
    run_tests();
    test_global_persistence();
    raw { printf("[interp] %d passed, %d failed\n", g_pass, g_fail); }
    if g_fail > 0 { return 1; }
    return 0;
}
