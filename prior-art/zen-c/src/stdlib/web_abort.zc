// AbortController + AbortSignal — pure-JS bootstrap.
//
// The JS source lives in `src/stdlib/web_abort.js` (real file, full
// editor support). Embedded as a C string literal at build time via
// tools/embed_js.py — see Makefile's stdlib-embed rule.
//
// Standalone API surface today. fetch() and the timer APIs don't yet
// honor signals — those integrations are tracked as a follow-up. The
// shape is in place so consumer code can pass `{ signal }` and not
// crash, and signals fire 'abort' events for code that observes them.
//
// The JS uses `var Name = class extends ...` for the same reason as
// web_events.zc: script-scope class declarations are block-scoped,
// so they wouldn't hoist onto the global env. `var X = class ...` does.

raw {
    #include "stdlib/web_abort.gen.h"
}

fn zjs_install_web_abort(ctx: ZjsContext*) -> void {
    let src: char* = NULL;
    raw { src = (char*)WEB_ABORT_SOURCE; }
    let r = zjs_eval(ctx, src);
    if ctx.had_error {
        let err = ctx.last_error;
        let name_s: ZjsString* = NULL;
        let msg_s:  ZjsString* = NULL;
        if zjs_is_object(err) != 0 {
            let n = property_get(ctx, err, ctx_intern_string(ctx, (char*)"name", 4));
            let m = property_get(ctx, err, ctx_intern_string(ctx, (char*)"message", 7));
            if zjs_is_string(n) != 0 { name_s = zjs_as_string(n); }
            if zjs_is_string(m) != 0 { msg_s  = zjs_as_string(m); }
        }
        raw {
            fprintf(stderr, "[stdlib] web_abort bootstrap failed: %.*s: %.*s\n",
                    name_s ? (int)name_s->length : 7,
                    name_s ? name_s->data : "Unknown",
                    msg_s  ? (int)msg_s->length  : 0,
                    msg_s  ? msg_s->data  : "");
        }
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
    }
}
