// node:stream — classic Node streams (Readable / Writable / Duplex /
// Transform / PassThrough + pipeline/finished). The implementation is a
// JS module source (src/stdlib/node_stream.js, embedded as
// NODE_STREAM_SOURCE) registered as a builtin module; it `import`s
// node:events for the EventEmitter base.

raw {
    #include "stdlib/node_stream.gen.h"
}

fn zjs_register_node_stream(ctx: ZjsContext*) -> void {
    let src: char* = NULL; raw { src = (char*)NODE_STREAM_SOURCE; }
    let len: u32 = 0; raw { len = (uint32_t)(sizeof(NODE_STREAM_SOURCE) - 1); }
    ctx_register_builtin_module_source(ctx, (char*)"node:stream", src, len);
}
