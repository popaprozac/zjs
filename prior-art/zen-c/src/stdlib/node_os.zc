// node:os — operating-system info accessors.
//
// Apple/Linux POSIX today; Windows shims tracked in
// docs/platform-port-status.md. Surface is the common app-code subset:
// tmpdir / homedir / platform / arch / type / release / EOL / cpus /
// totalmem / freemem / hostname / userInfo.

raw {
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>

    #if defined(_WIN32)
        #ifndef WIN32_LEAN_AND_MEAN
        #define WIN32_LEAN_AND_MEAN
        #endif
        #include <windows.h>
        #include <lmcons.h>   /* UNLEN for GetUserNameA */
    #else
        #include <unistd.h>
        #include <sys/utsname.h>
        #include <pwd.h>
    #endif

    #if defined(__APPLE__)
        #include <sys/sysctl.h>
        #include <mach/mach.h>
        #include <mach/mach_host.h>
    #elif defined(__linux__)
        #include <sys/sysinfo.h>
    #endif
}

fn os_string(ctx: ZjsContext*, s: char*) -> ZjsValue {
    if s == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
    let n: u32 = 0; raw { n = (uint32_t)strlen(s); }
    return ctx_intern_string(ctx, s, n);
}

fn host_os_tmpdir(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let buf: char[1024];
    let p: char* = NULL;
    raw {
        #if defined(_WIN32)
            /* GetTempPathA returns "C:\Users\X\AppData\Local\Temp\" —
               Node strips the trailing separator. */
            DWORD n = GetTempPathA(1024, &buf[0]);
            if (n > 0 && n < 1024) {
                if (n > 1 && buf[n-1] == '\\') buf[n-1] = 0;
                p = &buf[0];
            } else p = (char*)"C:\\Windows\\Temp";
        #else
            (void)buf;
            p = getenv("TMPDIR");
            if (!p || !*p) p = "/tmp";
        #endif
    }
    return os_string(ctx, p);
}

fn host_os_homedir(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p: char* = NULL;
    raw {
        #if defined(_WIN32)
            p = getenv("USERPROFILE");
            if (!p || !*p) p = (char*)"C:\\";
        #else
            p = getenv("HOME");
            if (!p || !*p) {
                struct passwd* pw = getpwuid(getuid());
                p = pw ? pw->pw_dir : (char*)"/";
            }
        #endif
    }
    return os_string(ctx, p);
}

fn host_os_platform(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p: char* = NULL;
    raw {
        #if defined(__APPLE__)
            p = (char*)"darwin";
        #elif defined(__linux__)
            p = (char*)"linux";
        #elif defined(_WIN32)
            p = (char*)"win32";
        #else
            p = (char*)"unknown";
        #endif
    }
    return os_string(ctx, p);
}

fn host_os_arch(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p: char* = NULL;
    raw {
        #if defined(__aarch64__) || defined(__arm64__)
            p = (char*)"arm64";
        #elif defined(__x86_64__) || defined(_M_X64)
            p = (char*)"x64";
        #elif defined(__i386__)
            p = (char*)"ia32";
        #else
            p = (char*)"unknown";
        #endif
    }
    return os_string(ctx, p);
}

fn host_os_type(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let buf: char[256];
    let p: char* = NULL;
    raw {
        #if defined(_WIN32)
            (void)buf;
            p = (char*)"Windows_NT";
        #else
            struct utsname un;
            if (uname(&un) == 0) { strncpy(&buf[0], un.sysname, 255); buf[255] = 0; p = &buf[0]; }
            else p = (char*)"Unknown";
        #endif
    }
    return os_string(ctx, p);
}

fn host_os_release(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let buf: char[256];
    let p: char* = NULL;
    raw {
        #if defined(_WIN32)
            /* GetVersionExA lies post-8.1 without a manifest; RtlGetVersion
               (ntdll) reports the true version, matching Node's os.release(). */
            typedef LONG (WINAPI *RtlGetVersionFn)(PRTL_OSVERSIONINFOW);
            RTL_OSVERSIONINFOW vi;
            memset(&vi, 0, sizeof(vi));
            vi.dwOSVersionInfoSize = sizeof(vi);
            HMODULE ntdll = GetModuleHandleA("ntdll.dll");
            RtlGetVersionFn rtl = ntdll ? (RtlGetVersionFn)(void*)GetProcAddress(ntdll, "RtlGetVersion") : NULL;
            if (rtl && rtl(&vi) == 0) {
                snprintf(&buf[0], 256, "%lu.%lu.%lu",
                         (unsigned long)vi.dwMajorVersion,
                         (unsigned long)vi.dwMinorVersion,
                         (unsigned long)vi.dwBuildNumber);
                p = &buf[0];
            } else p = (char*)"";
        #else
            struct utsname un;
            if (uname(&un) == 0) { strncpy(&buf[0], un.release, 255); buf[255] = 0; p = &buf[0]; }
            else p = (char*)"";
        #endif
    }
    return os_string(ctx, p);
}

fn host_os_hostname(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let buf: char[256];
    raw {
        #if defined(_WIN32)
            /* DnsHostname matches POSIX gethostname() (no winsock dep). */
            DWORD len = 256;
            if (!GetComputerNameExA(ComputerNameDnsHostname, &buf[0], &len)) buf[0] = 0;
            buf[255] = 0;
        #else
            if (gethostname(&buf[0], 256) != 0) buf[0] = 0;
            buf[255] = 0;
        #endif
    }
    let p: char* = NULL; raw { p = &buf[0]; }
    return os_string(ctx, p);
}

fn host_os_totalmem(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let bytes: f64 = 0.0;
    raw {
        #if defined(__APPLE__)
            int64_t mem = 0;
            size_t len = sizeof(mem);
            if (sysctlbyname("hw.memsize", &mem, &len, NULL, 0) == 0) bytes = (double)mem;
        #elif defined(__linux__)
            struct sysinfo si;
            if (sysinfo(&si) == 0) bytes = (double)si.totalram * (double)si.mem_unit;
        #elif defined(_WIN32)
            MEMORYSTATUSEX ms;
            ms.dwLength = sizeof(ms);
            if (GlobalMemoryStatusEx(&ms)) bytes = (double)ms.ullTotalPhys;
        #endif
    }
    return zjs_double(bytes);
}

fn host_os_freemem(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let bytes: f64 = 0.0;
    raw {
        #if defined(__APPLE__)
            mach_port_t port = mach_host_self();
            vm_size_t page_size = 0;
            host_page_size(port, &page_size);
            vm_statistics64_data_t vmstat;
            mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
            if (host_statistics64(port, HOST_VM_INFO64, (host_info64_t)&vmstat, &count) == KERN_SUCCESS) {
                // Available = free + inactive (typical "freemem" metric)
                bytes = ((double)vmstat.free_count + (double)vmstat.inactive_count) * (double)page_size;
            }
        #elif defined(__linux__)
            struct sysinfo si;
            if (sysinfo(&si) == 0) bytes = (double)si.freeram * (double)si.mem_unit;
        #elif defined(_WIN32)
            MEMORYSTATUSEX ms;
            ms.dwLength = sizeof(ms);
            if (GlobalMemoryStatusEx(&ms)) bytes = (double)ms.ullAvailPhys;
        #endif
    }
    return zjs_double(bytes);
}

fn host_os_cpus(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let count: i32 = 1;
    let model_buf: char[256];
    let model_p: char* = NULL;
    let speed_mhz: f64 = 0.0;
    raw {
        model_buf[0] = 0;
        #if defined(__APPLE__)
            size_t cnt_len = sizeof(count);
            sysctlbyname("hw.ncpu", &count, &cnt_len, NULL, 0);
            size_t m_len = 256;
            sysctlbyname("machdep.cpu.brand_string", &model_buf[0], &m_len, NULL, 0);
            int64_t hz = 0;
            size_t h_len = sizeof(hz);
            if (sysctlbyname("hw.cpufrequency", &hz, &h_len, NULL, 0) == 0) {
                speed_mhz = (double)hz / 1e6;
            }
        #elif defined(__linux__)
            long n = sysconf(_SC_NPROCESSORS_ONLN);
            if (n > 0) count = (int)n;
            // /proc/cpuinfo first model name + cpu MHz — cheap enough.
            FILE* f = fopen("/proc/cpuinfo", "r");
            if (f) {
                char line[512];
                while (fgets(line, sizeof(line), f)) {
                    if (model_buf[0] == 0 && strncmp(line, "model name", 10) == 0) {
                        char* colon = strchr(line, ':');
                        if (colon) {
                            colon += 2;
                            size_t L = strlen(colon);
                            if (L > 0 && colon[L-1] == '\n') colon[--L] = 0;
                            strncpy(model_buf, colon, 255); model_buf[255] = 0;
                        }
                    } else if (speed_mhz == 0.0 && strncmp(line, "cpu MHz", 7) == 0) {
                        char* colon = strchr(line, ':');
                        if (colon) speed_mhz = atof(colon + 1);
                    }
                    if (model_buf[0] && speed_mhz != 0.0) break;
                }
                fclose(f);
            }
        #elif defined(_WIN32)
            SYSTEM_INFO si;
            GetNativeSystemInfo(&si);
            if (si.dwNumberOfProcessors > 0) count = (int)si.dwNumberOfProcessors;
            /* Same model+speed for every core (matches the documented
               divergence on the other platforms): registry CentralProcessor\0. */
            HKEY key;
            if (RegOpenKeyExA(HKEY_LOCAL_MACHINE,
                              "HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0",
                              0, KEY_QUERY_VALUE, &key) == ERROR_SUCCESS) {
                DWORD len = 255;
                DWORD type = 0;
                if (RegQueryValueExA(key, "ProcessorNameString", NULL, &type,
                                     (LPBYTE)&model_buf[0], &len) == ERROR_SUCCESS
                    && type == REG_SZ) {
                    model_buf[len < 255 ? len : 255] = 0;
                }
                DWORD mhz = 0;
                len = sizeof(mhz);
                if (RegQueryValueExA(key, "~MHz", NULL, &type,
                                     (LPBYTE)&mhz, &len) == ERROR_SUCCESS
                    && type == REG_DWORD) {
                    speed_mhz = (double)mhz;
                }
                RegCloseKey(key);
            }
        #endif
        if (model_buf[0] == 0) strcpy(model_buf, "unknown");
        model_p = &model_buf[0];
    }
    if count < 1 { count = 1; }
    let arr_v = ctx_new_array(ctx, (u32)count);
    let arr = zjs_as_array(arr_v);
    arr.length = (u32)count;
    let mlen: u32 = 0; raw { mlen = (uint32_t)strlen(model_p); }
    let model_str = ctx_intern_string(ctx, model_p, mlen);
    let model_atom = ctx_intern_atom(ctx, (char*)"model", 5);
    let speed_atom = ctx_intern_atom(ctx, (char*)"speed", 5);
    let speed_v = zjs_double(speed_mhz);
    let i: u32 = 0;
    while i < (u32)count {
        let entry_v = ctx_new_object(ctx);
        let entry = zjs_as_object(entry_v);
        object_set(ctx, entry, model_atom, model_str);
        object_set(ctx, entry, speed_atom, speed_v);
        arr.elements[i] = entry_v;
        i = i + 1;
    }
    return arr_v;
}

fn host_os_user_info(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let uid: i32 = 0;
    let gid: i32 = 0;
    let username_buf: char[256];
    let homedir_buf: char[1024];
    let shell_buf: char[256];
    raw {
        username_buf[0] = 0;
        homedir_buf[0] = 0;
        shell_buf[0] = 0;
        #if defined(_WIN32)
            /* Node on Windows: uid/gid are -1 and shell is null. */
            uid = -1;
            gid = -1;
            DWORD ulen = 256;
            if (!GetUserNameA(&username_buf[0], &ulen)) username_buf[0] = 0;
            const char* hp = getenv("USERPROFILE");
            if (hp) { strncpy(homedir_buf, hp, 1023); homedir_buf[1023] = 0; }
        #else
            uid = (int32_t)getuid();
            gid = (int32_t)getgid();
            struct passwd* pw = getpwuid((uid_t)uid);
            if (pw) {
                strncpy(username_buf, pw->pw_name ? pw->pw_name : "", 255); username_buf[255] = 0;
                strncpy(homedir_buf, pw->pw_dir ? pw->pw_dir : "", 1023);   homedir_buf[1023] = 0;
                strncpy(shell_buf, pw->pw_shell ? pw->pw_shell : "", 255);   shell_buf[255] = 0;
            }
        #endif
    }
    let o_v = ctx_new_object(ctx);
    let o = zjs_as_object(o_v);
    let u_p: char* = NULL; raw { u_p = &username_buf[0]; }
    let h_p: char* = NULL; raw { h_p = &homedir_buf[0]; }
    let s_p: char* = NULL; raw { s_p = &shell_buf[0]; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"uid", 3),      zjs_int32(uid));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"gid", 3),      zjs_int32(gid));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"username", 8), os_string(ctx, u_p));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"homedir", 7),  os_string(ctx, h_p));
    // Node on Windows reports shell: null (no $SHELL equivalent).
    let shell_v: ZjsValue = os_string(ctx, s_p);
    raw {
        #if defined(_WIN32)
            shell_v = zjs_null();
        #endif
    }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"shell", 5),    shell_v);
    return o_v;
}

fn os_attach(ctx: ZjsContext*, obj: ZjsObject*, name: char*, name_len: u32, ptr: void*) -> void {
    object_set(ctx, obj, ctx_intern_atom(ctx, name, name_len),
               ctx_make_host_function(ctx, name, ptr));
}

fn populate_node_os(ctx: ZjsContext*, exports: ZjsObject*) -> void {
    let p1: void* = NULL; raw { p1 = (void*)host_os_tmpdir; }
    let p2: void* = NULL; raw { p2 = (void*)host_os_homedir; }
    let p3: void* = NULL; raw { p3 = (void*)host_os_platform; }
    let p4: void* = NULL; raw { p4 = (void*)host_os_arch; }
    let p5: void* = NULL; raw { p5 = (void*)host_os_type; }
    let p6: void* = NULL; raw { p6 = (void*)host_os_release; }
    let p7: void* = NULL; raw { p7 = (void*)host_os_hostname; }
    let p8: void* = NULL; raw { p8 = (void*)host_os_totalmem; }
    let p9: void* = NULL; raw { p9 = (void*)host_os_freemem; }
    let pA: void* = NULL; raw { pA = (void*)host_os_cpus; }
    let pB: void* = NULL; raw { pB = (void*)host_os_user_info; }
    os_attach(ctx, exports, (char*)"tmpdir", 6,   p1);
    os_attach(ctx, exports, (char*)"homedir", 7,  p2);
    os_attach(ctx, exports, (char*)"platform", 8, p3);
    os_attach(ctx, exports, (char*)"arch", 4,     p4);
    os_attach(ctx, exports, (char*)"type", 4,     p5);
    os_attach(ctx, exports, (char*)"release", 7,  p6);
    os_attach(ctx, exports, (char*)"hostname", 8, p7);
    os_attach(ctx, exports, (char*)"totalmem", 8, p8);
    os_attach(ctx, exports, (char*)"freemem", 7,  p9);
    os_attach(ctx, exports, (char*)"cpus", 4,     pA);
    os_attach(ctx, exports, (char*)"userInfo", 8, pB);
    // EOL constant.
    let eol_v: ZjsValue = ctx_intern_string(ctx, (char*)"\n", 1);
    raw {
        #if defined(_WIN32)
            eol_v = ctx_intern_string(ctx, (char*)"\r\n", 2);
        #endif
    }
    object_set(ctx, exports, ctx_intern_atom(ctx, (char*)"EOL", 3), eol_v);
}

fn zjs_register_node_os(ctx: ZjsContext*) -> void {
    let ptr: void* = NULL; raw { ptr = (void*)populate_node_os; }
    ctx_register_builtin_module(ctx, (char*)"node:os", ptr);
}
