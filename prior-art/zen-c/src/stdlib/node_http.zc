// node:http — HTTP/1.1 server on top of node:net.
//
// Scope (Tier 3.E v0.1):
//   http.createServer((req, res) => { res.writeHead(200); res.end('hi'); })
//   server.listen(port, host?, cb?)
//   server.close()
//
//   req:  IncomingMessage  — { method, url, httpVersion, headers, on('data'), on('end') }
//   res:  ServerResponse   — writeHead(status, headers), setHeader, write, end
//
// Parser is request-line + headers (line-by-line), then forwards the
// body bytes verbatim to 'data' / 'end' events. No transfer-encoding:
// chunked decode, no upgrade negotiation, no keep-alive (server sends
// Connection: close after each response). Enough for the common
// "small JSON API server" use case; chunked + keep-alive land in a
// follow-up.
//
// Pure JS — sits on the node:net surface, no extra native code.

raw {
    static const char NODE_HTTP_MODULE[] =
        "import { EventEmitter } from 'node:events';\n"
        "import { createServer as netCreateServer } from 'node:net';\n"
        "\n"
        "const STATUS_TEXT = {\n"
        "  100: 'Continue', 101: 'Switching Protocols',\n"
        "  200: 'OK', 201: 'Created', 202: 'Accepted', 204: 'No Content',\n"
        "  301: 'Moved Permanently', 302: 'Found', 304: 'Not Modified',\n"
        "  400: 'Bad Request', 401: 'Unauthorized', 403: 'Forbidden',\n"
        "  404: 'Not Found', 405: 'Method Not Allowed', 408: 'Request Timeout',\n"
        "  409: 'Conflict', 413: 'Payload Too Large', 415: 'Unsupported Media Type',\n"
        "  500: 'Internal Server Error', 501: 'Not Implemented',\n"
        "  502: 'Bad Gateway', 503: 'Service Unavailable', 504: 'Gateway Timeout'\n"
        "};\n"
        "\n"
        "// Decode a Uint8Array into a JS string assuming UTF-8 bytes.\n"
        "// Latin-1 fast path keeps ASCII headers cheap; we only fall\n"
        "// into the full decoder for body content with non-ASCII bytes.\n"
        "function bytesToLatin1(u8) {\n"
        "  let s = '';\n"
        "  for (let i = 0; i < u8.length; i++) s += String.fromCharCode(u8[i]);\n"
        "  return s;\n"
        "}\n"
        "\n"
        "class IncomingMessage extends EventEmitter {\n"
        "  constructor(sock) {\n"
        "    super();\n"
        "    this.socket = sock;\n"
        "    this.method = '';\n"
        "    this.url = '';\n"
        "    this.httpVersion = '';\n"
        "    this.headers = Object.create(null);\n"
        "    this.complete = false;\n"
        "  }\n"
        "}\n"
        "\n"
        "class ServerResponse extends EventEmitter {\n"
        "  constructor(sock) {\n"
        "    super();\n"
        "    this.socket = sock;\n"
        "    this.statusCode = 200;\n"
        "    this.statusMessage = '';\n"
        "    this.__headers = Object.create(null);\n"
        "    this.__headersSent = false;\n"
        "    this.finished = false;\n"
        "  }\n"
        "  setHeader(name, value) {\n"
        "    this.__headers[String(name).toLowerCase()] = { name: String(name), value: String(value) };\n"
        "  }\n"
        "  getHeader(name) {\n"
        "    const e = this.__headers[String(name).toLowerCase()];\n"
        "    return e ? e.value : undefined;\n"
        "  }\n"
        "  removeHeader(name) { delete this.__headers[String(name).toLowerCase()]; }\n"
        "  writeHead(statusCode, statusMessage, headers) {\n"
        "    if (typeof statusMessage === 'object' && statusMessage !== null) {\n"
        "      headers = statusMessage; statusMessage = undefined;\n"
        "    }\n"
        "    this.statusCode = statusCode | 0;\n"
        "    if (typeof statusMessage === 'string') this.statusMessage = statusMessage;\n"
        "    if (headers) {\n"
        "      for (const k in headers) {\n"
        "        if (Object.prototype.hasOwnProperty.call(headers, k)) this.setHeader(k, headers[k]);\n"
        "      }\n"
        "    }\n"
        "    return this;\n"
        "  }\n"
        "  __flushHeaders(bodyLen) {\n"
        "    if (this.__headersSent) return;\n"
        "    const status = this.statusCode || 200;\n"
        "    const text = this.statusMessage || STATUS_TEXT[status] || 'OK';\n"
        "    // Default content-length only when set via __flushHeaders(bodyLen).\n"
        "    if (bodyLen !== undefined && !this.__headers['content-length']) {\n"
        "      this.setHeader('Content-Length', bodyLen);\n"
        "    }\n"
        "    if (!this.__headers['date']) {\n"
        "      this.setHeader('Date', new Date().toUTCString ? new Date().toUTCString() : new Date().toString());\n"
        "    }\n"
        "    if (!this.__headers['connection']) {\n"
        "      this.setHeader('Connection', 'close');\n"
        "    }\n"
        "    let head = 'HTTP/1.1 ' + status + ' ' + text + '\\r\\n';\n"
        "    for (const k in this.__headers) {\n"
        "      const e = this.__headers[k];\n"
        "      head += e.name + ': ' + e.value + '\\r\\n';\n"
        "    }\n"
        "    head += '\\r\\n';\n"
        "    this.socket.write(head);\n"
        "    this.__headersSent = true;\n"
        "  }\n"
        "  write(chunk) {\n"
        "    if (this.finished) return false;\n"
        "    if (!this.__headersSent) this.__flushHeaders();\n"
        "    return this.socket.write(chunk);\n"
        "  }\n"
        "  end(chunk) {\n"
        "    if (this.finished) return;\n"
        "    if (chunk !== undefined) {\n"
        "      // Pre-compute Content-Length when we have the whole body.\n"
        "      let len;\n"
        "      if (typeof chunk === 'string') len = chunk.length;\n"
        "      else if (chunk && typeof chunk.length === 'number') len = chunk.length;\n"
        "      if (!this.__headersSent) this.__flushHeaders(len);\n"
        "      this.socket.write(chunk);\n"
        "    } else {\n"
        "      if (!this.__headersSent) this.__flushHeaders(0);\n"
        "    }\n"
        "    this.finished = true;\n"
        "    this.emit('finish');\n"
        "    this.socket.end();\n"
        "  }\n"
        "}\n"
        "\n"
        "// Per-connection parser state machine.\n"
        "//\n"
        "// state: 0 = head (request-line + headers), 1 = body, 2 = done\n"
        "function makeParser(sock, requestListener) {\n"
        "  let buf = '';\n"
        "  let state = 0;\n"
        "  let req = null;\n"
        "  let res = null;\n"
        "  let bodyRemaining = 0;\n"
        "  let dispatched = false;\n"
        "\n"
        "  function dispatch() {\n"
        "    if (dispatched) return;\n"
        "    dispatched = true;\n"
        "    try { requestListener(req, res); }\n"
        "    catch (e) {\n"
        "      if (!res.__headersSent) {\n"
        "        try { res.writeHead(500, { 'Content-Type': 'text/plain' }); res.end('Internal Server Error'); }\n"
        "        catch (_) { try { sock.end(); } catch (_) {} }\n"
        "      } else {\n"
        "        try { sock.end(); } catch (_) {}\n"
        "      }\n"
        "    }\n"
        "  }\n"
        "\n"
        "  sock.on('data', function(chunk) {\n"
        "    // chunk is Uint8Array. Accumulate as latin-1 for header\n"
        "    // parsing (HTTP/1.1 header bytes are 7-bit ASCII anyway).\n"
        "    buf += bytesToLatin1(chunk);\n"
        "    if (state === 0) {\n"
        "      const i = buf.indexOf('\\r\\n\\r\\n');\n"
        "      if (i < 0) return;\n"
        "      const head = buf.slice(0, i);\n"
        "      buf = buf.slice(i + 4);\n"
        "      const lines = head.split('\\r\\n');\n"
        "      const reqLine = lines.shift() || '';\n"
        "      const parts = reqLine.split(' ');\n"
        "      req = new IncomingMessage(sock);\n"
        "      res = new ServerResponse(sock);\n"
        "      req.method = parts[0] || 'GET';\n"
        "      req.url = parts[1] || '/';\n"
        "      req.httpVersion = (parts[2] || 'HTTP/1.1').replace('HTTP/', '');\n"
        "      for (let li = 0; li < lines.length; li++) {\n"
        "        const colon = lines[li].indexOf(':');\n"
        "        if (colon < 0) continue;\n"
        "        const k = lines[li].slice(0, colon).trim().toLowerCase();\n"
        "        const v = lines[li].slice(colon + 1).trim();\n"
        "        req.headers[k] = v;\n"
        "      }\n"
        "      const cl = req.headers['content-length'];\n"
        "      bodyRemaining = cl ? (parseInt(cl, 10) || 0) : 0;\n"
        "      state = 1;\n"
        "      dispatch();\n"
        "      // Fall through into body handling so any already-buffered\n"
        "      // bytes belonging to the body fire 'data' on req.\n"
        "    }\n"
        "    if (state === 1) {\n"
        "      if (buf.length > 0) {\n"
        "        const take = bodyRemaining > 0\n"
        "          ? Math.min(buf.length, bodyRemaining)\n"
        "          : buf.length;\n"
        "        const piece = buf.slice(0, take);\n"
        "        buf = buf.slice(take);\n"
        "        bodyRemaining -= take;\n"
        "        if (req) {\n"
        "          // Re-pack to Uint8Array so listeners get a Buffer-shape.\n"
        "          const u = new Uint8Array(piece.length);\n"
        "          for (let i = 0; i < piece.length; i++) u[i] = piece.charCodeAt(i);\n"
        "          req.emit('data', u);\n"
        "        }\n"
        "      }\n"
        "      if (bodyRemaining <= 0 && req && !req.complete) {\n"
        "        req.complete = true;\n"
        "        req.emit('end');\n"
        "        state = 2;\n"
        "      }\n"
        "    }\n"
        "  });\n"
        "  sock.on('end', function() {\n"
        "    if (req && !req.complete) { req.complete = true; req.emit('end'); }\n"
        "  });\n"
        "  sock.on('error', function(e) {\n"
        "    if (req) req.emit('error', e);\n"
        "  });\n"
        "}\n"
        "\n"
        "class HttpServer extends EventEmitter {\n"
        "  constructor(requestListener) {\n"
        "    super();\n"
        "    const self = this;\n"
        "    this.__netServer = netCreateServer(function(sock) {\n"
        "      makeParser(sock, function(req, res) {\n"
        "        self.emit('request', req, res);\n"
        "      });\n"
        "    });\n"
        "    if (typeof requestListener === 'function') {\n"
        "      this.on('request', requestListener);\n"
        "    }\n"
        "    // Forward net-server lifecycle.\n"
        "    this.__netServer.on('listening', function() { self.emit('listening'); });\n"
        "    this.__netServer.on('close',     function() { self.emit('close'); });\n"
        "    this.__netServer.on('error',     function(e) { self.emit('error', e); });\n"
        "  }\n"
        "  listen(port, host, cb) { this.__netServer.listen(port, host, cb); return this; }\n"
        "  address() { return this.__netServer.address(); }\n"
        "  close(cb) { this.__netServer.close(cb); return this; }\n"
        "}\n"
        "\n"
        "function createServer(requestListener) { return new HttpServer(requestListener); }\n"
        "\n"
        "export { HttpServer as Server, IncomingMessage, ServerResponse, createServer };\n"
        "export default { Server: HttpServer, IncomingMessage: IncomingMessage,\n"
        "                 ServerResponse: ServerResponse, createServer: createServer };\n";
}

fn zjs_register_node_http(ctx: ZjsContext*) -> void {
    let src: char* = NULL; raw { src = (char*)NODE_HTTP_MODULE; }
    let slen: u32 = 0; raw { slen = (uint32_t)strlen(src); }
    ctx_register_builtin_module_source(ctx, (char*)"node:http", src, slen);
}
