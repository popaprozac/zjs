// EventTarget / Event / CustomEvent / DOMException — pure-JS bootstrap.
//
// The JS source lives in `src/stdlib/web_events.js` (real file, full
// editor support). Embedded as a C string literal at build time via
// tools/embed_js.py — see Makefile's stdlib-embed rule.
//
// Installed as globals at context init by running a small JS snippet
// after the host registrations are in place. Same shape Node uses
// (Web-Platform-compatible). EventTarget here is the prerequisite for
// AbortSignal in web_abort.zc.
//
// The JS uses `var X = class ...` (not bare `class X {}`) so each
// class binds as a script-scope var, which hoists onto the global
// environment record — matching how user code reaches them by bare
// name. Bare `class X {}` is block-scoped per spec, so it wouldn't
// be globally reachable.

raw {
    #include "stdlib/web_events.gen.h"
    extern ZjsValue zjs_eval(ZjsContext* ctx, char* source);
}

// Run the bootstrap snippet — defines DOMException, Event,
// CustomEvent, EventTarget as globals on globalThis.
fn zjs_install_web_events(ctx: ZjsContext*) -> void {
    let src: char* = NULL;
    raw { src = (char*)WEB_EVENTS_SOURCE; }
    let r = zjs_eval(ctx, src);
    if ctx.had_error {
        let err = ctx.last_error;
        let name_s: ZjsString* = NULL;
        let msg_s:  ZjsString* = NULL;
        if zjs_is_object(err) != 0 {
            let n = property_get(ctx, err, ctx_intern_string(ctx, (char*)"name", 4));
            let m = property_get(ctx, err, ctx_intern_string(ctx, (char*)"message", 7));
            if zjs_is_string(n) != 0 { name_s = zjs_as_string(n); }
            if zjs_is_string(m) != 0 { msg_s  = zjs_as_string(m); }
        }
        raw {
            fprintf(stderr, "[stdlib] web_events bootstrap failed: %.*s: %.*s\n",
                    name_s ? (int)name_s->length : 7,
                    name_s ? name_s->data : "Unknown",
                    msg_s  ? (int)msg_s->length  : 0,
                    msg_s  ? msg_s->data  : "");
        }
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
    }
}
