// node:events + node:util + node:assert — DX modules, pure JS.
//
// EventEmitter here is the Node-shaped sibling of WHATWG EventTarget:
// listeners receive raw args (not Event objects), 'error' with no
// listener throws, MaxListenersExceededWarning at the soft cap.
//
// node:util ships promisify / callbackify / types.* predicates /
// inspect (small) / format (printf-style).
//
// node:assert ships ok / equal / notEqual / strict variants /
// deepStrictEqual / throws / doesNotThrow / AssertionError. The
// strict-by-default `assert.strict === assert` aliasing matches
// Node 16+.

raw {
    static const char NODE_EVENTS_MODULE[] =
        "class EventEmitter {\n"
        "  constructor() {\n"
        "    this.__listeners = Object.create(null);\n"
        "    this.__maxListeners = 10;\n"
        "  }\n"
        "  setMaxListeners(n) { this.__maxListeners = (n | 0); return this; }\n"
        "  getMaxListeners() { return this.__maxListeners; }\n"
        "  on(event, listener)         { return this.__add(event, listener, false, false); }\n"
        "  addListener(event, listener) { return this.on(event, listener); }\n"
        "  prependListener(event, listener) { return this.__add(event, listener, false, true); }\n"
        "  once(event, listener)       { return this.__add(event, listener, true, false); }\n"
        "  prependOnceListener(event, listener) { return this.__add(event, listener, true, true); }\n"
        "  __add(event, listener, isOnce, prepend) {\n"
        "    if (typeof listener !== 'function') throw new TypeError('listener must be a function');\n"
        "    var k = String(event);\n"
        "    var list = this.__listeners[k];\n"
        "    if (!list) { list = []; this.__listeners[k] = list; }\n"
        "    var entry = { fn: listener, once: isOnce };\n"
        "    if (prepend) list.unshift(entry); else list.push(entry);\n"
        "    return this;\n"
        "  }\n"
        "  off(event, listener) { return this.removeListener(event, listener); }\n"
        "  removeListener(event, listener) {\n"
        "    var k = String(event);\n"
        "    var list = this.__listeners[k];\n"
        "    if (!list) return this;\n"
        "    var out = [];\n"
        "    var removed = false;\n"
        "    for (var i = 0; i < list.length; ++i) {\n"
        "      if (!removed && list[i].fn === listener) { removed = true; continue; }\n"
        "      out.push(list[i]);\n"
        "    }\n"
        "    this.__listeners[k] = out;\n"
        "    return this;\n"
        "  }\n"
        "  removeAllListeners(event) {\n"
        "    if (event === undefined) { this.__listeners = Object.create(null); return this; }\n"
        "    delete this.__listeners[String(event)];\n"
        "    return this;\n"
        "  }\n"
        "  listeners(event) {\n"
        "    var list = this.__listeners[String(event)];\n"
        "    if (!list) return [];\n"
        "    var out = [];\n"
        "    for (var i = 0; i < list.length; ++i) out.push(list[i].fn);\n"
        "    return out;\n"
        "  }\n"
        "  listenerCount(event) {\n"
        "    var list = this.__listeners[String(event)];\n"
        "    return list ? list.length : 0;\n"
        "  }\n"
        "  eventNames() { return Object.keys(this.__listeners); }\n"
        "  emit(event) {\n"
        "    var k = String(event);\n"
        "    var list = this.__listeners[k];\n"
        "    if (!list || list.length === 0) {\n"
        "      if (k === 'error') {\n"
        "        var err = arguments[1];\n"
        "        if (err === undefined) err = new Error(\"Unhandled 'error' event\");\n"
        "        throw err;\n"
        "      }\n"
        "      return false;\n"
        "    }\n"
        "    var snap = [];\n"
        "    for (var i = 0; i < list.length; ++i) snap.push(list[i]);\n"
        "    var argsArr = [];\n"
        "    for (var i = 1; i < arguments.length; ++i) argsArr.push(arguments[i]);\n"
        "    for (var i = 0; i < snap.length; ++i) {\n"
        "      var entry = snap[i];\n"
        "      if (entry.once) this.removeListener(k, entry.fn);\n"
        "      entry.fn.apply(this, argsArr);\n"
        "    }\n"
        "    return true;\n"
        "  }\n"
        "}\n"
        "EventEmitter.EventEmitter = EventEmitter;\n"
        "EventEmitter.defaultMaxListeners = 10;\n"
        "export { EventEmitter };\n"
        "export default EventEmitter;\n";

    static const char NODE_UTIL_MODULE[] =
        "function promisify(fn) {\n"
        "  if (typeof fn !== 'function') throw new TypeError('promisify: fn must be a function');\n"
        "  if (fn[promisify.custom]) return fn[promisify.custom];\n"
        "  return function() {\n"
        "    var self = this;\n"
        "    var args = [];\n"
        "    for (var i = 0; i < arguments.length; ++i) args.push(arguments[i]);\n"
        "    return new Promise(function(resolve, reject) {\n"
        "      args.push(function(err, value) { if (err) reject(err); else resolve(value); });\n"
        "      try { fn.apply(self, args); } catch (e) { reject(e); }\n"
        "    });\n"
        "  };\n"
        "}\n"
        "promisify.custom = Symbol('util.promisify.custom');\n"
        "\n"
        "function callbackify(fn) {\n"
        "  if (typeof fn !== 'function') throw new TypeError('callbackify: fn must be a function');\n"
        "  return function() {\n"
        "    var cb = arguments[arguments.length - 1];\n"
        "    if (typeof cb !== 'function') throw new TypeError('last arg must be a callback');\n"
        "    var args = [];\n"
        "    for (var i = 0; i < arguments.length - 1; ++i) args.push(arguments[i]);\n"
        "    Promise.resolve(fn.apply(this, args)).then(\n"
        "      function(v) { cb(null, v); },\n"
        "      function(e) { if (!e) e = new Error('callbackify rejected without a reason'); cb(e); });\n"
        "  };\n"
        "}\n"
        "\n"
        "var types = {\n"
        "  isPromise: function(v) { return v != null && typeof v.then === 'function'; },\n"
        "  isDate:    function(v) { return v instanceof Date; },\n"
        "  isRegExp:  function(v) { return v instanceof RegExp; },\n"
        "  isMap:     function(v) { return v instanceof Map; },\n"
        "  isSet:     function(v) { return v instanceof Set; },\n"
        "  isUint8Array:  function(v) { return v instanceof Uint8Array; },\n"
        "  isArrayBuffer: function(v) { return v instanceof ArrayBuffer; },\n"
        "  isTypedArray:  function(v) {\n"
        "    return v instanceof Uint8Array || v instanceof Int8Array ||\n"
        "           v instanceof Uint8ClampedArray ||\n"
        "           v instanceof Uint16Array || v instanceof Int16Array ||\n"
        "           v instanceof Uint32Array || v instanceof Int32Array ||\n"
        "           v instanceof Float32Array || v instanceof Float64Array;\n"
        "  },\n"
        "};\n"
        "\n"
        "function inspect(v) { return inspectValue(v, 0, new Set()); }\n"
        "function inspectValue(v, depth, seen) {\n"
        "  if (v === null) return 'null';\n"
        "  var t = typeof v;\n"
        "  if (t === 'undefined') return 'undefined';\n"
        "  if (t === 'string') return \"'\" + v.replace(/'/g, \"\\\\'\") + \"'\";\n"
        "  if (t === 'number' || t === 'boolean' || t === 'bigint') return String(v);\n"
        "  if (t === 'function') return '[Function: ' + (v.name || 'anonymous') + ']';\n"
        "  if (t === 'symbol') return v.toString();\n"
        "  if (seen.has(v)) return '[Circular]';\n"
        "  if (depth > 6) return '[depth limit]';\n"
        "  seen.add(v);\n"
        "  var s;\n"
        "  if (Array.isArray(v)) {\n"
        "    var out = [];\n"
        "    for (var i = 0; i < v.length; ++i) out.push(inspectValue(v[i], depth + 1, seen));\n"
        "    s = '[ ' + out.join(', ') + ' ]';\n"
        "  } else if (v instanceof Date) {\n"
        "    s = v.toISOString();\n"
        "  } else if (v instanceof RegExp) {\n"
        "    s = String(v);\n"
        "  } else if (v instanceof Map) {\n"
        "    var parts = [];\n"
        "    v.forEach(function(val, key) { parts.push(inspectValue(key, depth + 1, seen) + ' => ' + inspectValue(val, depth + 1, seen)); });\n"
        "    s = 'Map(' + v.size + ') { ' + parts.join(', ') + ' }';\n"
        "  } else if (v instanceof Set) {\n"
        "    var parts = [];\n"
        "    v.forEach(function(val) { parts.push(inspectValue(val, depth + 1, seen)); });\n"
        "    s = 'Set(' + v.size + ') { ' + parts.join(', ') + ' }';\n"
        "  } else {\n"
        "    var keys = Object.keys(v);\n"
        "    if (keys.length === 0) s = '{}';\n"
        "    else {\n"
        "      var parts = [];\n"
        "      for (var i = 0; i < keys.length; ++i) parts.push(keys[i] + ': ' + inspectValue(v[keys[i]], depth + 1, seen));\n"
        "      s = '{ ' + parts.join(', ') + ' }';\n"
        "    }\n"
        "  }\n"
        "  seen.delete(v);\n"
        "  return s;\n"
        "}\n"
        "\n"
        "function format() {\n"
        "  if (arguments.length === 0) return '';\n"
        "  var fmt = arguments[0];\n"
        "  if (typeof fmt !== 'string') {\n"
        "    var parts = [];\n"
        "    for (var i = 0; i < arguments.length; ++i) parts.push(inspect(arguments[i]));\n"
        "    return parts.join(' ');\n"
        "  }\n"
        "  var ai = 1;\n"
        "  var out = '';\n"
        "  // if/else chain instead of `switch ... continue` because the\n"
        "  // engine's continue-inside-switch falls through to the next\n"
        "  // case rather than jumping to the loop update (task #261).\n"
        "  for (var i = 0; i < fmt.length; ++i) {\n"
        "    var handled = false;\n"
        "    if (fmt[i] === '%' && i + 1 < fmt.length && ai < arguments.length) {\n"
        "      var spec = fmt[i + 1];\n"
        "      if      (spec === 's') { out += String(arguments[ai++]); handled = true; }\n"
        "      else if (spec === 'd') { out += String(Number(arguments[ai++])); handled = true; }\n"
        "      else if (spec === 'i') { out += String(Math.trunc(Number(arguments[ai++]))); handled = true; }\n"
        "      else if (spec === 'f') { out += String(parseFloat(arguments[ai++])); handled = true; }\n"
        "      else if (spec === 'j') { out += JSON.stringify(arguments[ai++]); handled = true; }\n"
        "      else if (spec === 'o' || spec === 'O') { out += inspect(arguments[ai++]); handled = true; }\n"
        "      else if (spec === '%') { out += '%'; handled = true; }\n"
        "      if (handled) { i++; continue; }\n"
        "    }\n"
        "    out += fmt[i];\n"
        "  }\n"
        "  while (ai < arguments.length) out += ' ' + inspect(arguments[ai++]);\n"
        "  return out;\n"
        "}\n"
        "\n"
        "export { promisify, callbackify, types, inspect, format };\n"
        "export default { promisify: promisify, callbackify: callbackify, types: types, inspect: inspect, format: format };\n";

    static const char NODE_ASSERT_MODULE[] =
        "class AssertionError extends Error {\n"
        "  constructor(opts) {\n"
        "    opts = opts || {};\n"
        "    super(opts.message || ('Failed assertion: ' + String(opts.operator || '')));\n"
        "    this.name = 'AssertionError';\n"
        "    this.actual = opts.actual;\n"
        "    this.expected = opts.expected;\n"
        "    this.operator = opts.operator;\n"
        "    this.generatedMessage = !opts.message;\n"
        "    this.code = 'ERR_ASSERTION';\n"
        "  }\n"
        "}\n"
        "function _stringify(v) { try { return JSON.stringify(v); } catch (e) { return String(v); } }\n"
        "function fail(msg) { throw new AssertionError({ message: typeof msg === 'string' ? msg : 'Failed', operator: 'fail' }); }\n"
        "function ok(value, msg) {\n"
        "  if (!value) throw new AssertionError({ message: msg || 'Expected truthy value', actual: value, expected: true, operator: '==' });\n"
        "}\n"
        "function equal(a, b, msg) { if (a != b) throw new AssertionError({ message: msg || (_stringify(a) + ' == ' + _stringify(b)), actual: a, expected: b, operator: '==' }); }\n"
        "function notEqual(a, b, msg) { if (a == b) throw new AssertionError({ message: msg || (_stringify(a) + ' != ' + _stringify(b)), actual: a, expected: b, operator: '!=' }); }\n"
        "function strictEqual(a, b, msg) { if (a !== b) throw new AssertionError({ message: msg || (_stringify(a) + ' === ' + _stringify(b)), actual: a, expected: b, operator: '===' }); }\n"
        "function notStrictEqual(a, b, msg) { if (a === b) throw new AssertionError({ message: msg || (_stringify(a) + ' !== ' + _stringify(b)), actual: a, expected: b, operator: '!==' }); }\n"
        "function _deepEq(a, b) {\n"
        "  if (a === b) return true;\n"
        "  if (a === null || b === null || typeof a !== 'object' || typeof b !== 'object') return false;\n"
        "  if (Array.isArray(a) !== Array.isArray(b)) return false;\n"
        "  if (Array.isArray(a)) {\n"
        "    if (a.length !== b.length) return false;\n"
        "    for (var i = 0; i < a.length; ++i) if (!_deepEq(a[i], b[i])) return false;\n"
        "    return true;\n"
        "  }\n"
        "  var ak = Object.keys(a), bk = Object.keys(b);\n"
        "  if (ak.length !== bk.length) return false;\n"
        "  for (var i = 0; i < ak.length; ++i) if (!_deepEq(a[ak[i]], b[ak[i]])) return false;\n"
        "  return true;\n"
        "}\n"
        "function deepStrictEqual(a, b, msg) {\n"
        "  if (!_deepEq(a, b)) throw new AssertionError({ message: msg || (_stringify(a) + ' deepStrictEqual ' + _stringify(b)), actual: a, expected: b, operator: 'deepStrictEqual' });\n"
        "}\n"
        "function throws(fn, expected, msg) {\n"
        "  if (typeof fn !== 'function') throw new TypeError('assert.throws: fn must be a function');\n"
        "  var threw = false; var thrown;\n"
        "  try { fn(); } catch (e) { threw = true; thrown = e; }\n"
        "  if (!threw) throw new AssertionError({ message: msg || 'Missing expected exception', operator: 'throws' });\n"
        "  if (expected) {\n"
        "    if (typeof expected === 'function' && !(thrown instanceof expected)) {\n"
        "      throw new AssertionError({ message: msg || ('Expected ' + expected.name + ', got ' + (thrown && thrown.name)), actual: thrown, expected: expected, operator: 'throws' });\n"
        "    }\n"
        "    if (expected instanceof RegExp && !expected.test(String(thrown && thrown.message))) {\n"
        "      throw new AssertionError({ message: msg || ('Did not match ' + String(expected)), actual: thrown, expected: expected, operator: 'throws' });\n"
        "    }\n"
        "  }\n"
        "}\n"
        "function doesNotThrow(fn, msg) {\n"
        "  try { fn(); } catch (e) {\n"
        "    throw new AssertionError({ message: msg || ('Got unwanted exception: ' + (e && e.message)), actual: e, operator: 'doesNotThrow' });\n"
        "  }\n"
        "}\n"
        "var assert = ok;\n"
        "assert.ok = ok;\n"
        "assert.equal = equal;\n"
        "assert.notEqual = notEqual;\n"
        "assert.strictEqual = strictEqual;\n"
        "assert.notStrictEqual = notStrictEqual;\n"
        "assert.deepStrictEqual = deepStrictEqual;\n"
        "assert.deepEqual = deepStrictEqual;\n"
        "assert.throws = throws;\n"
        "assert.doesNotThrow = doesNotThrow;\n"
        "assert.fail = fail;\n"
        "assert.AssertionError = AssertionError;\n"
        "assert.strict = assert;\n"
        "export { ok, equal, notEqual, strictEqual, notStrictEqual, deepStrictEqual };\n"
        "export { deepStrictEqual as deepEqual, throws, doesNotThrow, fail, AssertionError };\n"
        "export default assert;\n";
}

fn zjs_register_node_dx(ctx: ZjsContext*) -> void {
    let ev: char* = NULL; raw { ev = (char*)NODE_EVENTS_MODULE; }
    let ev_len: u32 = 0; raw { ev_len = (uint32_t)(sizeof(NODE_EVENTS_MODULE) - 1); }
    ctx_register_builtin_module_source(ctx, (char*)"node:events", ev, ev_len);

    let ut: char* = NULL; raw { ut = (char*)NODE_UTIL_MODULE; }
    let ut_len: u32 = 0; raw { ut_len = (uint32_t)(sizeof(NODE_UTIL_MODULE) - 1); }
    ctx_register_builtin_module_source(ctx, (char*)"node:util", ut, ut_len);

    let as: char* = NULL; raw { as = (char*)NODE_ASSERT_MODULE; }
    let as_len: u32 = 0; raw { as_len = (uint32_t)(sizeof(NODE_ASSERT_MODULE) - 1); }
    ctx_register_builtin_module_source(ctx, (char*)"node:assert", as, as_len);
}
