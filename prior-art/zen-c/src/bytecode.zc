// Bytecode types — emitted by the compiler, consumed by the interpreter.
//
// Uniform 4-byte instruction format: { op:u8, a:u8, b:u8, c:u8 }.
// Operands are reinterpreted per opcode. The encoding favors simplicity
// over density at this stage; Hermes-style packed-struct-per-opcode is
// the direction (see docs/jitless-design-study.md §2-3), and we can
// migrate later — the lookup-by-tag-then-decode pattern is the same.
//
// One `Function` per compiled function. The top-level program is also
// a Function. Each Function owns its bytecode, its constant pool, and
// its register count.

import "./value.zc";
import "std/mem.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
}

enum Op {
    Halt,             // safety net; interpreter never expects to hit this

    // Loads & moves
    LoadConst,        // a=dst, bc=const_idx (u16)
    LoadInt,          // a=dst, bc=imm (i16) — small-int fast path
    LoadUndefined,    // a=dst
    LoadHole,         // a=dst — zjs_deleted sentinel for array elision slots
    ThrowIfHole,      // a=reg — TDZ check: ReferenceError if regs[a] is the hole
    LoadNull,         // a=dst
    LoadTrue,         // a=dst
    LoadFalse,        // a=dst
    Mov,              // a=dst, b=src

    // Globals (program-scope variables)
    DefineGlobal,     // a=src, bc=slot (u16)   — initialize globals[slot] = regs[a]
    LoadGlobal,       // a=dst, bc=slot (u16)  — throws ReferenceError if undeclared
    StoreGlobal,      // a=src, bc=slot (u16)  — also defines the global (sloppy semantics)
    LoadGlobalOrUndefined,  // a=dst, bc=slot (u16) — typeof's special-case load: undefined if undeclared

    // `with` statement scope (ECMA-262 §14.11). The active with-objects
    // live on a runtime stack on the context; identifier access inside a
    // with-body is compiled as WithLookup + a branch on the result.
    WithEnter,        // a=src  — ToObject(regs[a]) then push onto the with-stack
    WithLeave,        // (none) — pop the innermost with-object
    WithLookup,       // a=dst, b=name_reg — dst = innermost with-object whose
                      //   HasProperty(regs[b]) is true (Symbol.unscopables-aware),
                      //   else undefined. Caller branches on undefined.

    // Binary arithmetic
    Add, Sub, Mul, Div, Mod, Pow,

    // Fused arithmetic-with-immediate (Phase 3.9g). Hot path: int32 +/-
    // small constant. Folds LoadInt + Add/Sub into a single dispatch.
    // c is the immediate, reinterpreted as i8 (range -128..127). The
    // interpreter still falls through to general numeric coercion if
    // the source register isn't int32.
    AddImm,           // a=dst, b=src_reg, c=imm (i8)
    SubImm,           // a=dst, b=src_reg, c=imm (i8)

    // Fused comparison-with-immediate. RHS-only (LHS-imm version is
    // ambiguous under ToPrimitive when LHS could be an object). Same
    // i8 immediate range as AddImm/SubImm. Falls through to general
    // comparison if the source reg isn't int32.
    CmpLtImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    CmpLeImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    CmpGtImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    CmpGeImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    BitAnd, BitOr, BitXor,
    Shl, Shr, UShr,

    // Comparison — prefix with Cmp to avoid collisions with TokenKind
    // variants of the same name (Zen-c codegen merges variant symbols
    // across enums in the same TU). See reference_zen-c.md gotcha #11.
    CmpEq, CmpNe, CmpStrictEq, CmpStrictNe,
    CmpLt, CmpLe, CmpGt, CmpGe,

    // Unary
    Neg, BitNot, LogicalNot,

    // Control flow
    Jmp,              // bc = signed offset in instructions
    JmpIfTrue,        // a=src, bc=offset
    JmpIfFalse,       // a=src, bc=offset
    JmpIfNotNullish,  // a=src, bc=offset — used by ??; jumps when src
                      // is anything other than null or undefined.
    JmpIfNullish,     // a=src, bc=offset — inverse of the above.
                      // Fused emit for `if (x != null) body` and
                      // `if (x !== undefined) body` (loose check).
                      // Eliminates the LoadNull / LoadUndefined +
                      // CmpNe pair (4.9% combined on richards).

    // Fused compare-and-branch — collapses Cmp + JmpIfFalse (the
    // standard while/for/if loop-exit shape) into a single dispatch.
    // Two-instruction encoding: the op carries the operands (a=lhs,
    // b=rhs reg OR i8 imm), and the next instruction's bc bytes hold
    // the i16 branch offset (relative to inst[J+2], same convention
    // as a plain Jmp at J+1). Branches when the comparison is *false*.
    // Falls through to the spec ToPrimitive-then-numeric path when
    // operands aren't both int32 (same shape as CmpLtImm fast paths).
    JmpIfNotLt,       // a=lhs_reg, b=rhs_reg ; next.bc = i16 offset
    JmpIfNotLe,
    JmpIfNotGt,
    JmpIfNotGe,
    JmpIfNotLtImm,    // a=lhs_reg, b=imm_i8 ; next.bc = i16 offset
    JmpIfNotLeImm,
    JmpIfNotGtImm,
    JmpIfNotGeImm,
    // Same shape — fuses Cmp{Eq,Ne,StrictEq,StrictNe} + JmpIfFalse.
    // Profile (richards): CmpEq→JmpIfFalse alone was 3.4% of dispatches;
    // splay added another 2.7%. Strict variants pick up the
    // `x === null` / `x !== undefined` church traffic.
    JmpIfNotEq,       // a=lhs_reg, b=rhs_reg ; next.bc = i16 offset
    JmpIfNotNe,
    JmpIfNotStrictEq,
    JmpIfNotStrictNe,

    // Universal return — exits interpret() with regs[a] as the value.
    Return,

    // Function call. a=dst, b=base, c=arg_count.
    // Convention: regs[base] holds the callee; args are in regs[base+1
    // ..base+arg_count]. Result is written to regs[dst]; dst can be
    // the same as base (the caller's "result reg" reuses the callee
    // slot, which is what the compiler does by default).
    //
    // Named `Invoke` (not `Call`) to avoid the cross-enum-variant
    // collision with NodeKind::Call. Zen-c codegen merges variant
    // symbols across enums in the same TU — see reference_zen-c.md.
    Invoke,

    // Phase 3.9h-C — tail-call optimization. Encoded like Invoke but
    // the caller's CallFrame is REPLACED in-place rather than a new
    // frame pushed: the callee returns directly to *our* original
    // caller. Used when a function ends with `return f(...)` with no
    // pending finallies. inst.a is unused (the return_dst comes from
    // the current frame's stored value).
    TailInvoke,       // b=base, c=arg_count

    // Inline-cached property access (Phase 3.2b).
    // ic_slot indexes into f.ics[] — a per-Function side-table of
    // {atom_name, last-seen HiddenClass, slot} entries patched in
    // place on cache miss. Fast path: pointer-compare the cached
    // class against obj.cls, then indexed slots[] read or write.
    LoadProp,         // a=dst, b=obj_reg, c=ic_slot (u8)
    StoreProp,        // a=obj_reg, b=ic_slot (u8), c=val_reg

    // Specialized built-in calls — fold LoadGlobal(Math) + LoadProp(.<m>) +
    // MethodInvoke into a single dispatch. Compiler emits these when it
    // statically proves the receiver is the global Math object (i.e., `Math`
    // is not a local or captured outer binding) and the method name matches.
    // Caveat: user-installed overrides on Math (`Math.sqrt = fn`) are NOT
    // honored on a specialized site — same compromise as Hermes/V8.
    MathSqrt,         // a=dst, b=arg_reg
    MathAbs,          // a=dst, b=arg_reg
    MathFloor,        // a=dst, b=arg_reg
    MathCeil,         // a=dst, b=arg_reg

    // Iteration setup (Phase 3.4).
    //
    // IterPrepare normalizes the iterable into a plain array of items
    // to walk. `kind` selects the iteration mode:
    //   0 = for-in  — collect own enumerable string keys
    //   1 = for-of  — collect element values (string → char strings)
    // The result is an array; the loop walks 0..length with regular
    // LoadElem + ArrayLength.
    IterPrepare,      // a=dst, b=src, c=kind

    // Direct array.length read — bypasses property_get for the
    // for-in/of loop bound. Returns 0 for non-arrays.
    ArrayLength,      // a=dst, b=src

    // `delete obj[key]` / `delete obj.name` (Phase 3.9c).
    // Marks the slot DELETED (sentinel value), so subsequent lookups
    // walk the proto chain as if the property is absent. Returns
    // boolean to regs[a] (always true in MVP — no non-configurable
    // enforcement yet).
    DeleteElem,       // a=dst (bool), b=obj_reg, c=key_reg

    // `arguments` (Phase 3.8e).
    // Emitted at function entry when the body references `arguments`.
    // Builds a fresh array containing all call args and stores it in
    // regs[a]. Reads interp()'s `args` + `arg_count` parameters.
    BuildArguments,   // a=dst

    // Rest parameter (2026-05-15).
    // Emitted at function entry when the param list ends with `...name`.
    // Builds an array from args_base[skip..argc] — the overflow args
    // beyond the regular declared params. Always read from args_base,
    // so the function's Function.has_rest_param flag opts into the
    // args_base population in push_call_frame.
    BuildRestArgs,    // a=dst, b=skip_count (u8 — index of first arg
                      //   to include; equals param_count of regular
                      //   params preceding the rest binding)

    // ES modules (2026-05-15).
    // Emitted in module-mode top-level code only.
    //   ImportBind reads the source module's exports[name] and writes
    //     to a local in the current module's scope. The source module
    //     is resolved at runtime against ctx.current_module's abs_path.
    //   ExportBind writes a local's current value into the current
    //     module's exports map under the given name.
    // Both encode the relevant string atoms in the function's const
    // pool — b / c index that pool as u8 (cap 256, fine for module
    // bodies).
    ImportBind,       // a=dst_reg,    b=spec_const_idx, c=name_const_idx
    ExportBind,       // a=src_reg,    b=name_const_idx, c=unused
    // Dynamic import (ES2020). DynamicImport reads regs[b] as the specifier,
    // resolves + loads the module, and writes a Promise of the namespace to
    // regs[a]. ImportMeta writes the `import.meta` object to regs[a].
    DynamicImport,    // a=dst_reg, b=spec_reg
    ImportMeta,       // a=dst_reg

    // async / await (2026-05-15).
    // Op::Await reads regs[b] as the awaited value and writes the
    // unwrapped result to regs[a]:
    //   - non-Promise:     pass through (already resolved)
    //   - fulfilled:       extract value
    //   - rejected:        throw the rejection reason
    //   - pending:         (current impl) drain microtasks once and
    //                      re-check; throw if still pending. Full
    //                      frame-suspension semantics are a follow-up.
    Await,            // a=dst, b=src

    // Generators (2026-05-15).
    // Inside a generator body: build { value: regs[b], done: false },
    // save the frame snapshot onto the current generator, then unwind
    // out to the iter.next() host caller. resume puts the .next(arg)
    // value into regs[a].
    Yield,            // a=resume_dst, b=value_reg
    // Emitted at the end of a generator function's prologue (after
    // default-init / pattern-param fan-out). Initial call to the
    // generator runs through the prologue and hits this op, which
    // snapshots state and unwinds — caller receives the generator
    // iterator. First .next() resumes at the instruction after this.
    GeneratorStart,   // no operands
    // Tagged-template strings array (ECMA-262 GetTemplateObject). Looks
    // up the cached array for site bc; on a miss builds it from
    // f.template_cooked / template_raw, attaches .raw, freezes, and
    // caches in f.template_cache. Subsequent reaches return the same
    // cell — required by tests that rely on tag identity / per-site
    // tagged-template caching.
    TemplateObject,   // a=dst, bc=site_idx (u16)

    // Spread support (2026-05-15).
    // Append the value in regs[b] to the array in regs[a]. Used by
    // array literals when at least one element is `...expr` — those
    // require dynamic-length construction.
    ArrayPush,        // a=arr_reg, b=value_reg
    // Iterate the iterable in regs[b] and append each element to the
    // array in regs[a]. Currently supports arrays and array-like
    // objects; strings/iterators come later.
    ArraySpread,      // a=arr_reg, b=iterable_reg
    // Object spread: copies own enumerable string-keyed properties
    // from regs[b] onto regs[a]. Used by `{ ...obj, k: v }`.
    ObjectSpread,     // a=target_obj, b=source
    // Array-rest slice for destructuring: build a fresh array
    // containing regs[b][c .. length]. Empty when src is non-array or
    // shorter than `c`. Used by `let [..., ...rest] = src`.
    ArrayRestFrom,    // a=dst, b=src_arr, c=start_index
    // Throws TypeError when regs[a] is null or undefined. Used at
    // the head of destructuring to enforce RequireObjectCoercible.
    AssertCoercible,  // a=src_reg

    // Live iterator protocol (2026-05-16). Used by array destructuring
    // (and eventually for-of) to step src one .next() at a time
    // instead of materializing the whole iterable.
    //   IterGet: regs[a] = GetIterator(regs[b])
    //   IterStep: regs[a] = value, regs[c] = done (bool). Sets done=true
    //              and value=undefined on either iterator exhaustion or
    //              an abrupt completion from iter.next() (latter sets
    //              pending throw, picked up by the host bridge).
    //   IterRestCollect: drains regs[b] starting from current position
    //              into a fresh array at regs[a], setting regs[c]=true
    //              when complete. Used for the `...rest` element of an
    //              array pattern.
    //   IterClose: regs[b] is the done flag — when false, calls
    //              regs[a].return() (best-effort). Spec
    //              IteratorClose(NormalCompletion).
    IterGet,          // a=dst_iter, b=src
    // for-await-of uses this instead of IterGet so we look up
    // `@@asyncIterator` first per §14.7.5.3, falling back to
    // `@@iterator` (whose next() result the awaiter wraps in
    // Promise.resolve). Without this, `for await (... of obj)`
    // where obj only exposes Symbol.asyncIterator silently bails.
    IterGetAsync,     // a=dst_iter, b=src
    IterStep,         // a=value_dst, b=iter, c=done_dst
    IterRestCollect,  // a=dst_arr, b=iter, c=done_reg
    IterClose,        // a=iter, b=done_reg
    // for-await-of: call iter.next() and write the RAW result (Promise
    // or { value, done } object) into a single dst register. Caller is
    // responsible for awaiting and reading .value / .done — the spec
    // (§14.7.5.3) awaits the next() result BEFORE inspecting .done, so
    // we can't split here the way IterStep does.
    IterNextRaw,      // a=dst_result, b=iter

    // Variadic-call dispatch — used when an argument list contains
    // `...arr`. Args live in the array at regs[b+1] (plain SpreadInvoke)
    // or regs[b+2] (SpreadMethodInvoke / receiver at regs[b+1]). argc
    // comes from the array's length at runtime. Same fall-through to
    // user vs host callee as plain Invoke.
    SpreadInvoke,        // a=dst, b=base (callee), c=unused
    SpreadMethodInvoke,  // a=dst, b=base (callee), c=unused — receiver at base+1, args-array at base+2
    SpreadNewInvoke,     // a=dst, b=base (ctor),   c=unused — args-array at base+1

    // Method calls (Phase 3.5).
    // Same encoding shape as Invoke, but regs[base+1] is the receiver
    // (`this`) and explicit JS args start at regs[base+2]. arg_count
    // counts only the explicit args. Used whenever the source is a
    // member-expression call like `obj.method(args)`. Host functions
    // see the receiver via ctx.host_this; user Function/Closure callees
    // ignore it (no `this` binding for user functions yet).
    MethodInvoke,     // a=dst, b=base, c=arg_count

    // Tail variant of MethodInvoke; same semantics as TailInvoke but
    // also sets ctx.host_this = regs[base+1] for the duration of the
    // callee's execution.
    TailMethodInvoke, // b=base, c=arg_count

    // Closures (Phase 3.3).
    // Object-literal accessor shorthand (`{ get foo() {}, set foo(v) {} }`).
    // Installs / merges a ZjsAccessor cell at obj[name].
    //   a = obj_reg
    //   b = name_const_reg (LoadConst loaded the atom-ZjsValue here)
    //   c = fn_reg
    DefineGetter,
    DefineSetter,
    // 2026-05-15: class get/set accessors. Same shape as DefineGetter
    // /Setter but installs the property as non-enumerable per spec.
    DefineMethodGetter,
    DefineMethodSetter,

    MakeClosure,      // a=dst, b=fn_reg, c=env_reg
                      //   wraps regs[b] (a function value) with regs[c] (an env object)
                      //   into a fresh closure cell.
    LoadEnv,          // a=dst
                      //   dst = current closure's env (or undefined if no closure).
    LoadCallee,       // a=dst
                      //   dst = the function value currently invoking
                      //   this frame (the closure if one was made,
                      //   else the bare Function*). Used to bind the
                      //   name inside `(function name() { ... name ... })`
                      //   per §15.7.1 (the "name" SS).

    // Heap-cell creation + access (Phase 3.1b).
    NewRegex,         // a=dst, b=src_const_idx, c=flags_const_idx.
                      // Builds a fresh RegExp from two constant-pool
                      // strings (JS source between the slashes and the
                      // raw flag letters). Each evaluation creates a new
                      // instance so .lastIndex is independent.
                      // Const-pool indices fit in u8 — if either grows
                      // past 255, the compiler emits NewRegexR instead
                      // (LoadConst-into-temp + register-indexed build).
    NewRegexR,        // a=dst, b=pat_reg, c=flag_reg.
                      // Same as NewRegex but the source / flag strings
                      // are read from registers. Used when the const-
                      // pool index exceeds the u8 range — moment.js
                      // and lodash both pile up enough literals to
                      // need this path.
    NewObject,        // a=dst. Creates an empty {} object.
    NewArray,         // a=dst, b=base, c=count.
                      // Builds an array containing regs[base..base+count).
                      // Safe even if dst==base — the interpreter copies
                      // elements out before writing dst.
    LoadElem,         // a=dst, b=obj_reg, c=key_reg.
                      // dst = obj[key]. For arrays: numeric/numeric-string
                      // index, or special-case "length". For objects:
                      // ToString(key), linear prop lookup.
    StoreElem,        // a=obj_reg, b=key_reg, c=val_reg.
                      // obj[key] = val. Auto-grows arrays.

    // Exceptions (Phase 3.1c).
    Throw,            // a=src. Raises regs[src] as the thrown value.
    EnterTry,         // a=catch_reg, bc=offset (i16).
                      // Push a try frame. On throw, ip jumps to
                      // (this_inst + 1 + offset) and regs[catch_reg]
                      // receives the thrown value.
    LeaveTry,         // No operands. Pop the innermost try frame.
                      // Emitted at the normal end of a try block.

    // Prototype chain + new (Phase 3.6).
    //
    // `In b in c` checks if regs[b] is a key of regs[c] (string key on
    // an object; integer index on an array). Returns boolean.
    //
    // `Instanceof b instanceof c` checks regs[c].prototype is in
    // regs[b]'s proto chain.
    //
    // `LoadThis` reads ctx.host_this (the implicit `this`).
    //
    // `NewInvoke` is like Invoke but:
    //   - allocates a fresh object whose proto is callee.prototype
    //   - calls callee with that object bound as `this`
    //   - if callee returns an object, uses that; else uses the new obj
    In,               // a=dst, b=key_reg, c=obj_reg
    Instanceof,       // a=dst, b=val_reg, c=ctor_reg
    LoadThis,         // a=dst
    // `new.target` — when ctx.new_target_active is true, the current
    // call entered via `new` (or super()), and ctx.host_this is the
    // newly-allocated instance. Returns that instance. Otherwise
    // returns undefined.
    LoadNewTarget,    // a=dst
    NewInvoke,        // a=dst, b=base, c=arg_count

    // Type introspection (Phase 3.1e).
    Typeof,           // a=dst, b=src.
    // Class machinery (2026-05-15).
    // SetProto: assign regs[b]'s prototype to be regs[a].
    //   regs[a] must be an Object (typically a constructor's
    //   .prototype); regs[b] must be an Object too. Used by the
    //   class-extends path to wire Child.prototype.[[Prototype]] =
    //   Parent.prototype after the methods are attached.
    SetProto,         // a=proto, b=obj.
    // SuperCall: call regs[b] (the parent constructor) with the
    //   current ctx.host_this and ctx.new_target_active preserved,
    //   args at regs[b+1 .. b+c]. Used to compile super(...) in a
    //   derived-class constructor. Unlike Op::Invoke this DOES NOT
    //   reset host_this to undefined/global.
    SuperCall,        // a=dst, b=base, c=argc.
    // DefineMethod: like StoreProp but the resulting slot's attrs
    //   are (writable + configurable, NOT enumerable). Used by
    //   class method definitions which spec-mandate non-enumerable.
    DefineMethod,     // a=obj, b=ic_slot, c=val_reg.
    // DefineMethodComputed: same attrs as DefineMethod (writable +
    // configurable, NOT enumerable) but the key is in regs[b]
    // rather than encoded as an IC slot. Used by `static [expr]() {}`
    // so the install overwrites an existing slot (e.g. the class's
    // synthesized .name) instead of falling back to property_set's
    // writable-respecting object_set path.
    DefineMethodComputed,  // a=obj, b=key_reg, c=val_reg.
    // SetParentCtor: record regs[b] (the parent constructor) on
    //   the Function* in regs[a]. Used by class-extends so
    //   Object.getPrototypeOf(Child) returns Parent.
    SetParentCtor,    // a=ctor, b=parent.
    // SetFunctionName: install `name` data property on the Function /
    // Closure value in regs[a] with spec attrs
    // { writable: false, enumerable: false, configurable: true }.
    // b = name-string register. Emitted by NamedEvaluation
    // (anonymous func/class assigned to a binding) so the descriptor
    // matches the spec instead of PROP_DEFAULT.
    SetFunctionName,  // a=fn_reg, b=name_string_reg.
                      // dst = a string from ECMA-262 §13.5.3
                      // (one of: "undefined" "object" "boolean"
                      // "number" "string" "function").
    // InitObjData: object-literal data-property initialization.
    //   ECMA-262 PropertyDefinitionEvaluation uses
    //   CreateDataPropertyOrThrow — a [[DefineOwnProperty]], NOT a
    //   [[Set]]. So it installs an own enumerable+writable+configurable
    //   data property and must NOT invoke an inherited setter (e.g. the
    //   Object.prototype `__proto__` accessor). a=obj, b=key, c=val.
    InitObjData,      // a=obj, b=key_reg, c=val_reg.
    // SpreadSuperCall: super(...args). Same as SuperCall but the args are
    //   materialized into an array at regs[base+1] (NewArray + ArrayPush /
    //   ArraySpread); argc = the array length at runtime. Shares the
    //   SuperCall interpreter handler. Emitted for `super(...e)` — esbuild
    //   produces this when lowering a subclass with instance fields.
    //   Appended at the END of the enum so no existing op renumbers (AOT
    //   bytecode + the op-name table are positional).
    SpreadSuperCall,  // a=dst, b=base (parent); args-array at base+1.

    // Inverse-polarity fused compare-and-branch — branches when the
    // comparison is *TRUE*. Same two-instruction encoding as the
    // JmpIfNot* family above (operands in slot J, i16 offset in slot
    // J+1's bc bytes, offset base J+2). Emitted ONLY as the backward
    // bottom-test of a ROTATED loop (#379: while/for with a relational
    // condition compile to entry-Jmp → body → bottom test that branches
    // back while true — eliminating the per-iteration unconditional
    // back-edge Jmp, ~25% of tight-loop dispatches). The taken
    // (backward) path is the loop back-edge, so the handler GC-polls
    // there, replacing the poll the old backward Jmp provided.
    // Appended at the END of the enum so no existing op renumbers
    // (AOT bytecode is positional; ZJS_AOT_VERSION bumped to 7 since
    // OLD binaries would silently skip these unknown ops and then
    // execute the offset-carrier slot as an unconditional backward
    // Jmp — an infinite loop, not a clean error).
    JmpIfLt,          // a=lhs_reg, b=rhs_reg ; next.bc = i16 offset
    JmpIfLe,
    JmpIfGt,
    JmpIfGe,
    JmpIfLtImm,       // a=lhs_reg, b=imm_i8 ; next.bc = i16 offset
    JmpIfLeImm,
    JmpIfGtImm,
    JmpIfGeImm,

    // Fused global-callee call (#394): LoadGlobal + Invoke in one
    // dispatch. The callee was re-resolved from the globals table on
    // EVERY call (18.2% of all fib dispatches), so the compiler elides
    // the LoadGlobal and bakes its slot into the call itself. Same
    // two-instruction encoding convention as the JmpIf* family above:
    // slot J carries a=dst, b=base, c=argc exactly like Invoke; the
    // carrier at J+1 (an Op::Jmp placeholder, never dispatched) holds
    // the u16 global slot in its bc bytes. The interpreter handler
    // pre-increments ip past the carrier, which makes every downstream
    // ip path (frame-push resume save, host-call fallthrough, throw
    // saves) see the J+1-relative arithmetic it already uses for
    // Invoke. Only emitted when every argument expression is
    // side-effect-free (the load moves AFTER arg evaluation — pure
    // args make the reorder unobservable) and never for tail-call
    // rewrite candidates (the Tail rewriter matches Op::Invoke in
    // place). OFF in ZJS_JIT builds, like loop rotation. Appended at
    // the END of the enum so no existing op renumbers (AOT bytecode is
    // positional; ZJS_AOT_VERSION bumped to 8 — an old binary would
    // dispatch the carrier as a real Jmp).
    InvokeGlobal,     // a=dst, b=base, c=argc ; next.bc = u16 global slot

    // Private-element brand check (#400). Emitted before every private
    // member access (read / write / call): regs[a] must carry the
    // class's hidden own brand property (installed by NewInvoke /
    // SuperCall at construction; statics handled separately) or the
    // access throws TypeError per §13.3.7.1 PrivateElementFind. bc =
    // const-pool index of the brand atom. 1-slot (no carrier).
    // Appended at the END (AOT positional; ZJS_AOT_VERSION -> 9).
    PrivateCheck,     // a=obj_reg ; bc = u16 const idx of brand atom

    // Unconditional TypeError throw with a const-pool message (#400
    // inc B). Emitted where the COMPILER can prove the access is a
    // spec TypeError (reading a setter-only private, writing a
    // private method). Generic — reusable for other compile-time-
    // provable TypeError points. 1-slot.
    ThrowTypeError,   // bc = u16 const idx of message string

    // #401 strict-mode global store (§6.2.5.6 PutValue): an
    // unresolvable reference in strict code throws ReferenceError
    // instead of creating a global. "Unresolvable" is a runtime
    // question — the slot may be undeclared yet the name still live
    // on globalThis (own or inherited), in which case the assignment
    // proceeds as a property set. Appended at the END (AOT
    // positional; ZJS_AOT_VERSION -> 11). 1-slot.
    StoreGlobalStrict, // a=value reg, bc = u16 global slot

    // #401 — IteratorClose with a THROW completion (§7.4.6 steps
    // 6-9): call iterator.return() but swallow everything it does —
    // the original (abrupt) completion always wins. Emitted in the
    // catch handler that destructure_array wraps around element
    // evaluation; the rethrow of the original error follows. 1-slot.
    IterCloseQuiet,   // a=iter reg, b=done reg

    // #402a — generator return-completion dispatch. The compiler
    // emits this DIRECTLY after every Op::Yield; gen.saved_ip points
    // here, so it is always the first op a resume executes. A normal
    // .next()/.throw() resume leaves ctx.gen_resume_is_return false
    // and the jump skips the compiler-emitted inline `return` path
    // (finally inlining + for-of closes + Return — the same sequence
    // a ReturnStmt at the yield site would emit). A .return(v) resume
    // sets the flag; this op consumes it and falls through into that
    // path with v already in the yield's dst register. Catch handlers
    // never see a return completion (it is a branch, not a throw),
    // finallys run via their compile-time inlined copies — matching
    // zjs's inline-finally design. Appended at the END (AOT
    // positional; ZJS_AOT_VERSION -> 12). 1-slot, intra-function
    // offset (no slot operand — no loader remap needed).
    JmpIfNotGenReturn, // bc = i16 jump offset
}

struct Inst {
    op: Op;
    a:  u8;
    b:  u8;
    c:  u8;
}

impl Copy for Inst {}

// --- Operand encode / decode ----------------------------------------

fn inst_bc_u16(i: Inst) -> u16 {
    return (u16)i.b | ((u16)i.c << 8);
}

fn inst_bc_i16(i: Inst) -> i32 {
    // Sign-extend the 16-bit operand into a wider signed type so callers
    // can do arithmetic on it cleanly. Zen-c doesn't expose an explicit
    // i16 sign-extension cast, so we do it via shift.
    let v = (u32)((u32)i.b | ((u32)i.c << 8));
    if v & 0x8000 != 0 { return (i32)(v | 0xffff0000); }
    return (i32)v;
}

fn make_inst_a(op: Op, a: u8) -> Inst {
    return Inst{op: op, a: a, b: 0, c: 0};
}

fn make_inst_ab(op: Op, a: u8, b: u8) -> Inst {
    return Inst{op: op, a: a, b: b, c: 0};
}

fn make_inst_abc(op: Op, a: u8, b: u8, c: u8) -> Inst {
    return Inst{op: op, a: a, b: b, c: c};
}

fn make_inst_a_u16(op: Op, a: u8, v: u16) -> Inst {
    return Inst{op: op, a: a, b: (u8)(v & 0xff), c: (u8)((v >> 8) & 0xff)};
}

fn make_inst_a_i16(op: Op, a: u8, v: i32) -> Inst {
    let u: u16 = (u16)((u32)v & 0xffff);
    return Inst{op: op, a: a, b: (u8)(u & 0xff), c: (u8)((u >> 8) & 0xff)};
}

fn make_inst_u16(op: Op, v: u16) -> Inst {
    return Inst{op: op, a: 0, b: (u8)(v & 0xff), c: (u8)((v >> 8) & 0xff)};
}

fn make_inst_i16(op: Op, v: i32) -> Inst {
    let u: u16 = (u16)((u32)v & 0xffff);
    return Inst{op: op, a: 0, b: (u8)(u & 0xff), c: (u8)((u >> 8) & 0xff)};
}

// --- Function ----------------------------------------------------
//
// A compiled function. For Phase 3.0a there's only ever one — the
// top-level "program" function. Phase 3.0b adds first-class user
// functions and stores them on the context.

// Inline-cache entry. Allocated per LoadProp/StoreProp site at
// compile time; cold (all classes NULL) until the first execution
// warms it.
//
// Phase 3.9f: polymorphic — caches up to IC_POLY_SIZE distinct
// (class, slot) pairs. Fast path linearly probes classes[0..count].
// When all slots are full and a new shape appears, the entry flips
// to `megamorphic` and the fast path is skipped from then on.
//
// The class_ pointers are WEAK refs (see gc_nullify_dead_ics): if
// the cached class is unreachable, we null it out during sweep.
def IC_POLY_SIZE: u32 = 4;

struct ICEntry {
    name:        ZjsString*;            // atom; set at compile time, immutable
    classes:     ZjsHiddenClass*[4];    // cached shapes (NULL = empty slot)
    slots:       u32[4];                // slot index per cached class. The
                                        // top bit (0x80000000) flags a
                                        // direct-prototype hit; the low 31
                                        // bits are the slot index. For
                                        // own-slot entries the flag is
                                        // clear and the fast path never
                                        // has to touch the proto side
                                        // table.
    entry_count: u8;                    // # of populated entries (0..IC_POLY_SIZE)
    megamorphic: bool;                  // once set, fast-path is skipped permanently
}

// Kept for compile-time clarity; once we have IC_POLY_SIZE entries and
// still miss, we go megamorphic immediately (no separate miss-count
// threshold needed — the polymorphic cache absorbs ordinary churn).
def IC_MEGAMORPHIC_LIMIT: u32 = IC_POLY_SIZE;

struct Function {
    header:         CellHeader; // { type_tag = TAG_FUNCTION } — must be first field
    code:           Inst*;     // bytecode (heap-allocated)
    code_len:       usize;
    constants:      ZjsValue*; // constant pool
    const_count:    u32;
    register_count: u32;       // size of the register file the interpreter must allocate
    // Watermark = params + locals + persistent temps (try/catch save
    // slots, for-loop iter regs, etc). Regs at indices `[fixed_regs,
    // register_count)` are pure scratch — temp-of-the-moment expression
    // slots that the compiler guarantees are always written before
    // read. The frame-setup code can skip the undef init for those
    // slots, which saves a measurable per-call write on hot leaves
    // (fib_recursive).
    fixed_regs:     u32;
    param_count:    u32;       // 0 for the top-level program
    // Reg index where `this` is hoisted at function entry. -1 means
    // the body never reads `this`, so no slot is reserved and the
    // interpreter skips the prologue init. Set by the compiler when
    // body_uses_this() is true. Replaces a per-call Op::LoadThis
    // dispatch (was 3.9% of dispatches on richards).
    this_reg:       i32;
    // ECMA-262 ExpectedArgumentCount — index of the first parameter
    // with a default initializer or rest binding (or = param_count if
    // none). Read by Function.length / host-func length getters.
    expected_arg_count: u32;

    // #400: the class's instance-brand atom (__zjs_brand_<classId>),
    // set on the CONSTRUCTOR Function when its class declares any
    // non-static private element. NewInvoke installs it as a hidden
    // own prop on fresh instances; SuperCall installs the parent's.
    // NULL for everything else. Interned atom — rooted by the atom
    // table, no extra GC mark needed.
    brand_atom:     ZjsString*;

    // [[Realm]] — the realm this function was compiled in (its intrinsics
    // + globals). Stamped = ctx.realm at compile time. The call boundary
    // switches ctx.realm to this on entry and restores on return, so a
    // function always runs against its own realm's intrinsics regardless
    // of which realm called it (ECMA-262 §10.2.1.x). NULL only for the
    // bootstrap window before a realm is current; a NULL realm means
    // "don't switch" (the caller's realm stands). Weak ref — realms are
    // owned by ctx.realms and outlive every Function, so not GC-marked.
    realm:          ZjsRealm*;

    // Inline-cache table for LoadProp / StoreProp (Phase 3.2b).
    ics:            ICEntry*;
    ic_count:       u32;

    // Proto-chain IC side table (Phase 3.9-richards). NULL until the
    // first IC site patches a direct-prototype hit; once allocated
    // it holds `ic_count * IC_POLY_SIZE` ZjsHiddenClass* entries (the
    // cached proto's shape at patch time). Kept out-of-line so the
    // common ICEntry stays at 64 bytes for cache locality on
    // numerical own-slot-heavy benches.
    ic_proto_cls:   ZjsHiddenClass**;

    // Closures (Phase 3.3). `needs_env` means this function should
    // allocate an env object at entry — it has nested functions that
    // capture its locals. `env_reg` is where that env lives. The
    // captured-names list drives the inner function's outer-name
    // resolution.
    needs_env:      bool;
    env_reg:        u8;

    // Phase 3.6: `.prototype` for instanceof + constructor-style use.
    // Lazy — first read auto-creates an empty object.
    prototype:      ZjsObject*;
    // `.prototype` is a WRITABLE data property; a user can assign a
    // NON-object value (`fn.prototype = undefined / null / 42`). The
    // ZjsObject* `prototype` field can't hold that, so when it happens we
    // record the value here and set `proto_nonobj_set`. The .prototype
    // getter then returns proto_nonobj, and GetPrototypeFromConstructor /
    // ctor_prototype_object treat the prototype as "not an object" (falling
    // back to the realm's intrinsic). Assigning an object again clears the
    // flag. GC-marked (the value can be a string/symbol/bigint cell).
    proto_nonobj:     ZjsValue;
    proto_nonobj_set: bool;

    // Expando bag for arbitrary properties (`fn.foo = 1`). Lazy — NULL
    // until the first non-`prototype` string-keyed property is set.
    // Matches ZjsHostFunction.props in shape and lifetime; the
    // property_get / property_set / Op::In paths route through this
    // before falling back to Object.prototype.
    props:          ZjsObject*;

    // Per-Function [[Prototype]] override (Object.setPrototypeOf on a
    // bare function value). Set when the user passes a non-capturing
    // function to setPrototypeOf — chalk's
    //   const c = (...) => strings.join(' ');   // no capture → bare fn
    //   Object.setPrototypeOf(c, Chalk.prototype);
    // pattern is the canonical case. NULL means "use the default
    // chain — Function.prototype → Object.prototype".
    //
    // Limitation: Function* is shared per-source-location (no MakeClosure
    // wrap when the body doesn't capture). So setPrototypeOf on one
    // evaluation of `function f() {}` inside a loop affects every
    // other iteration's `f` too. ES spec says distinct instances; we
    // currently fold them. Fix path if a real test exposes this:
    // unconditionally MakeClosure-wrap bare functions (small perf cost,
    // clean semantics).
    proto_override: ZjsObject*;

    // 2026-05-15 — set when this Function was emitted as a class
    // constructor. Op::Invoke / Op::MethodInvoke throw TypeError when
    // called without `new` (NewInvoke clears the flag's effect via
    // new_target_active).
    is_class_constructor: bool;
    // Class method / accessor — distinct from a constructor in that
    // it has no .prototype property and is not constructible. Read
    // by `is_proto` and the constructibility checks.
    is_method: bool;
    // Arrow function — `() => ...`. Arrows don't have their own
    // `this` / `new.target` / `arguments`; they inherit from the
    // enclosing scope. Op::MakeClosure captures the creation-time
    // ctx.host_this into the resulting ZjsClosure's captured_this
    // slot, and Op::LoadThis routes through it when the current
    // closure's function is an arrow.
    is_arrow: bool;
    // For `class Child extends Parent { ... }`: holds the parent
    // constructor so Object.getPrototypeOf(Child) === Parent. Plain
    // (non-extended) classes leave this undefined. Marked at class-
    // create time on the Function*.
    parent_ctor:          ZjsValue;
    // Synthesized default constructor for `class Child extends
    // Parent {}`. Op::NewInvoke detects this and forwards its args
    // directly to parent_ctor instead of interpreting an empty body.
    is_default_derived_ctor: bool;
    // True when the body references `arguments` (compiler emits
    // Op::BuildArguments at entry). When false, push_call_frame skips
    // the args_base population loop — the only consumer of those
    // slots is BuildArguments, which is never emitted in that case.
    uses_arguments: bool;
    // True when the param list ends with `...rest`. Op::BuildRestArgs
    // reads args_base[param_count..argc] at entry, so push_call_frame
    // must populate args_base too. Treated as args_base-needed at
    // push time (same as uses_arguments).
    has_rest_param: bool;
    // True when the source was `async function`. Call sites wrap the
    // body's return value in a Promise (resolve on return / reject on
    // throw); the body's Op::Await ops are gated by this flag.
    is_async: bool;
    // True when the source was `function* g() {}`. Call sites build
    // a generator iterator (TAG_GENERATOR) without running the body —
    // iter.next() drives execution and Op::Yield suspends back to it.
    is_generator: bool;

    // ECMA-262 strict mode. True when the function (or the program for
    // the top-level Function) runs in strict mode: a "use strict"
    // prologue, lexically nested inside strict code, a class body, or a
    // module. Drives strict-only runtime semantics — currently the
    // throw-on-failed-Set in StoreProp / StoreElem (Phase C).
    strict: bool;

    // Tagged-template site cache (ECMA-262 §13.2.8.4 GetTemplateObject).
    // Each tagged-template call site in this function gets a stable
    // index; the strings array built on first reach is cached so every
    // subsequent reach passes the SAME array. Without this, code that
    // uses tag identity (Map keyed by strings, etc.) breaks.
    //
    //  - template_count        = number of distinct tagged-template
    //                            sites in this function's bytecode.
    //  - template_cooked / raw = ZjsString*[total_segments] flat arrays.
    //  - template_seg_start    = u32[template_count + 1] — start
    //                            offset of each site's segments
    //                            (so site i has segments [start[i], start[i+1])).
    //  - template_cache        = ZjsArray*[template_count] —
    //                            cached strings array per site, NULL
    //                            until first reach.
    template_count:      u32;
    template_cooked:     ZjsString**;
    template_raw:        ZjsString**;
    template_seg_start:  u32*;
    template_cache:      ZjsArray**;

    // --- Copy-and-patch JIT cache (ZJS_JIT builds only; see docs/jit-impl-notes.md).
    // jit_state: 0=unknown (count toward hot), 1=compiled (run jit_code),
    // 2=disabled (body outside the JIT subset, or it deopted → interpret).
    // All zero-init by function_new()'s zalloc, so the default (no JIT
    // build / cold function) is "unknown → interpret".
    jit_code:    void*;   // entry: void (*)(ZjsValue *regs, int *deopt)
    jit_ret_reg: i32;     // register holding the return value after a JIT run
    jit_calls:   u32;     // hotness counter (frame entries at ip==0)
    jit_state:   i32;
    // --- OSR-entry / partial-region loop JIT (J12a). Independent of the
    // whole-function cache above: a function whose whole body is outside the
    // subset (e.g. has a top-level console.log) can still JIT just its hot
    // loop. jit_osr_state: 0=untried, 1=compiled (run jit_osr_code), 2=disabled.
    // The JIT is entered at bytecode index jit_osr_header (the loop head) and
    // deopt-exits at the loop boundary back to the interpreter.
    jit_osr_code:   void*;   // entry: void (*)(ZjsValue *regs, int *deopt)
    jit_osr_header: i32;     // loop-header bc index this region was compiled for
    jit_osr_state:  i32;     // 0=untried, 1=compiled, 2=disabled
    jit_osr_calls:  u32;     // back-edge hotness counter (per-entry burst length)
    // J12f: the loop header whose consecutive back-edges jit_osr_calls is
    // currently counting. A back-edge to a DIFFERENT header (a nested loop, or
    // re-entering this loop after leaving it) resets the burst — so jit_osr_calls
    // measures iterations within ONE loop entry, not cumulative across entries.
    // The OSR compile gate is burst-length × region-span (≈ ops executed per
    // run): this skips short tiny-bodied loops (quicksort's pivot scans) while
    // still compiling short-but-fat loops (nbody's force kernel). 0 = no burst
    // (real loop headers are always ≥ 1).
    jit_osr_burst_hdr: i32;
    // J12f: bounded multi-region retry. A region whose JIT run deopts INSIDE the
    // region (a value-type miss, or an append/grow StoreElem the fast path can't
    // do) is recorded here and skipped, but OSR is re-armed (state→0) so a
    // DIFFERENT loop in the same function can still compile — e.g. sieve's first
    // build loop appends (deopts) yet its later in-bounds sieve loops JIT
    // cleanly. After jit_osr_retries failures the function latches state=2.
    jit_osr_skip_hdr: i32;   // a header that deopted; don't recompile it (0 = none)
    jit_osr_retries:  u32;   // in-region deopts so far; cap before giving up
}

fn function_new() -> Function* {
    // zalloc so prototype / props / needs_env etc. start cleanly zeroed.
    // Several lookups check `f.prototype == NULL` / `f.props == NULL`
    // as the lazy-create gate — relying on garbage there would be a
    // very subtle bug.
    let f = zalloc<Function>();
    f.header.type_tag = TAG_FUNCTION;
    f.parent_ctor = zjs_undefined();
    f.proto_nonobj = zjs_undefined();  // unused until proto_nonobj_set
    f.this_reg = -1;  // default: body doesn't use `this`
    return f;
}

fn function_free(f: Function*) -> void {
    if f == NULL { return; }
    dealloc(f.code);
    dealloc(f.constants);
    dealloc(f.ics);
    if f.ic_proto_cls != NULL { dealloc(f.ic_proto_cls); }
    if f.template_cooked    != NULL { dealloc(f.template_cooked); }
    if f.template_raw       != NULL { dealloc(f.template_raw); }
    if f.template_seg_start != NULL { dealloc(f.template_seg_start); }
    if f.template_cache     != NULL { dealloc(f.template_cache); }
    dealloc(f);
}

// C-callable wrapper so context.zc can free functions without depending
// on bytecode.zc's import path. The forward declaration lives inside
// context.zc's `zjs_free_context` raw block.
fn function_free_void(p: void*) -> void {
    let f: Function* = NULL;
    raw { f = (Function*)p; }
    function_free(f);
}
