// Interpreter — executes a compiled Function and returns its result.
//
// Phase 3.0a: simple `while` + per-op `if` chain. Hermes-style
// computed-goto dispatch is the eventual target (see design study),
// but the per-op handlers are small and the bottleneck for a non-JIT
// engine isn't the dispatch primitive itself — it's value-rep,
// inline caches, hidden classes. Those are bigger lifts we'll attack
// later. The structure here is intentionally trivial to keep
// debugging the FIRST end-to-end execution path easy.

import "./value.zc";
import "./bytecode.zc";
import "./context.zc";

raw {
    #include <stdlib.h>
    #include <string.h>
}

// =====================================================================
// Generic property get/set. Dispatches on the object's cell tag, with
// arrays getting a numeric-index fast path and a special-case "length"
// reader.
// =====================================================================

fn property_get(ctx: ZjsContext*, obj: ZjsValue, key: ZjsValue) -> ZjsValue {
    // Array: integer index OR "length", with prototype-method fallback.
    if zjs_is_array(obj) != 0 {
        let arr = zjs_as_array(obj);
        // Fast int path
        if zjs_is_int32(key) != 0 {
            let i = zjs_as_int32(key);
            if i >= 0 { return array_get(arr, (u32)i); }
            return zjs_undefined();
        }
        // .length
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let is_length: int = 0;
            let kdata = ks.data;
            let klen  = ks.length;
            raw {
                is_length = (klen == 6 && memcmp(kdata, "length", 6) == 0) ? 1 : 0;
            }
            if is_length != 0 { return zjs_int32((i32)arr.length); }
            // String-coerced numeric index
            let idx = zjs_to_array_index(key);
            if idx >= 0 { return array_get(arr, (u32)idx); }
            // Walk array_proto then its chain (so hasOwnProperty from
            // object_proto is reachable).
            let cur = ctx.array_proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 { return cur.slots[(u32)slot]; }
                cur = cur.proto;
            }
            return zjs_undefined();
        }
        // Anything else: try ToIndex
        let idx2 = zjs_to_array_index(key);
        if idx2 >= 0 { return array_get(arr, (u32)idx2); }
        return zjs_undefined();
    }

    // String primitive: .length + prototype-method intercept.
    if zjs_is_string(obj) != 0 {
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kdata = ks.data;
            let klen  = ks.length;
            let is_length: int = 0;
            raw {
                is_length = (klen == 6 && memcmp(kdata, "length", 6) == 0) ? 1 : 0;
            }
            if is_length != 0 {
                let s = zjs_as_string(obj);
                return zjs_int32((i32)s.length);
            }
            // Walk string_proto + chain (for object_proto methods like
            // hasOwnProperty).
            let cur = ctx.string_proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 { return cur.slots[(u32)slot]; }
                cur = cur.proto;
            }
        }
        return zjs_undefined();
    }

    // Object: ToString key, linear lookup, then walk proto chain.
    if zjs_is_object(obj) != 0 {
        let o = zjs_as_object(obj);
        let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
        let name = zjs_as_string(key_str_val);
        let cur = o;
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let v = cur.slots[(u32)slot];
                // Accessor (Phase 3.9b)? Invoke the getter with this=obj.
                if zjs_is_accessor(v) != 0 {
                    let acc = zjs_as_accessor(v);
                    let g = acc.get;
                    if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
                        let nullp: ZjsValue* = NULL;
                        return zjs_call_value_with_this(ctx, g, obj, nullp, 0);
                    }
                    return zjs_undefined();
                }
                return v;
            }
            cur = cur.proto;
        }
        return zjs_undefined();
    }

    // Function: .prototype lazy-creates an object on first read.
    // Also serves .call and .apply via the cached host helpers.
    if zjs_is_function(obj) != 0 {
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_proto: int = 0;
            let is_call:  int = 0;
            let is_apply: int = 0;
            raw {
                is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0;
                is_call  = (kn == 4 && memcmp(kd, "call",      4) == 0) ? 1 : 0;
                is_apply = (kn == 5 && memcmp(kd, "apply",     5) == 0) ? 1 : 0;
            }
            if is_proto != 0 {
                let fp = zjs_cell_as_ptr(obj);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.prototype == NULL {
                    let proto_v = ctx_new_object(ctx);
                    f.prototype = zjs_as_object(proto_v);
                }
                return zjs_cell_from_ptr((void*)f.prototype);
            }
            if is_call  != 0 { return ctx.fn_call_v; }
            if is_apply != 0 { return ctx.fn_apply_v; }
        }
        return zjs_undefined();
    }
    // Closure: same .call / .apply behavior.
    if zjs_is_closure(obj) != 0 {
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_call:  int = 0;
            let is_apply: int = 0;
            raw {
                is_call  = (kn == 4 && memcmp(kd, "call",  4) == 0) ? 1 : 0;
                is_apply = (kn == 5 && memcmp(kd, "apply", 5) == 0) ? 1 : 0;
            }
            if is_call  != 0 { return ctx.fn_call_v; }
            if is_apply != 0 { return ctx.fn_apply_v; }
        }
        return zjs_undefined();
    }

    // Host function: .prototype (lazy), .call / .apply, then .props.
    if zjs_is_host_function(obj) != 0 {
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_proto: int = 0;
            let is_call:  int = 0;
            let is_apply: int = 0;
            raw {
                is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0;
                is_call  = (kn == 4 && memcmp(kd, "call",      4) == 0) ? 1 : 0;
                is_apply = (kn == 5 && memcmp(kd, "apply",     5) == 0) ? 1 : 0;
            }
            let hf = zjs_as_host_function(obj);
            if is_proto != 0 {
                if hf.prototype == NULL {
                    let proto_v = ctx_new_object(ctx);
                    hf.prototype = zjs_as_object(proto_v);
                }
                return zjs_cell_from_ptr((void*)hf.prototype);
            }
            if is_call  != 0 { return ctx.fn_call_v; }
            if is_apply != 0 { return ctx.fn_apply_v; }
            if hf.props != NULL {
                return object_get(hf.props, ks);
            }
        }
        return zjs_undefined();
    }

    // Primitives: no property access in MVP.
    return zjs_undefined();
}

fn property_set(ctx: ZjsContext*, obj: ZjsValue, key: ZjsValue, value: ZjsValue) -> void {
    if zjs_is_array(obj) != 0 {
        let arr = zjs_as_array(obj);
        if zjs_is_int32(key) != 0 {
            let i = zjs_as_int32(key);
            if i >= 0 { array_set(arr, (u32)i, value); }
            return;
        }
        let idx = zjs_to_array_index(key);
        if idx >= 0 { array_set(arr, (u32)idx, value); return; }
        // String-keyed property on an array — not supported in MVP. Drop.
        return;
    }
    if zjs_is_object(obj) != 0 {
        let o = zjs_as_object(obj);
        let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
        let name = zjs_as_string(key_str_val);
        // Walk the proto chain looking for an accessor whose setter
        // should fire (Phase 3.9b). A data property on the proto means
        // we'll shadow via an own write.
        let cur = o;
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let v = cur.slots[(u32)slot];
                if zjs_is_accessor(v) != 0 {
                    let acc = zjs_as_accessor(v);
                    let s = acc.set;
                    if zjs_is_function(s) != 0 || zjs_is_closure(s) != 0 || zjs_is_host_function(s) != 0 {
                        let arr: ZjsValue[1];
                        arr[0] = value;
                        let argp: ZjsValue* = NULL;
                        raw { argp = &arr[0]; }
                        let _ = zjs_call_value_with_this(ctx, s, obj, argp, 1);
                    }
                    return;
                }
                cur = NULL;     // data property — fall through and write our own
            } else {
                cur = cur.proto;
            }
        }
        object_set(ctx, o, name, value);
        return;
    }
    // Function.prototype = obj (Phase 3.6). Only the prototype slot is
    // writable in MVP; other function properties are ignored.
    if zjs_is_function(obj) != 0 && zjs_is_string(key) != 0 {
        let ks = zjs_as_string(key);
        let is_proto: int = 0;
        let kd = ks.data;
        let kn = ks.length;
        raw { is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0; }
        if is_proto != 0 && zjs_is_object(value) != 0 {
            let fp = zjs_cell_as_ptr(obj);
            let f: Function* = NULL;
            raw { f = (Function*)fp; }
            f.prototype = zjs_as_object(value);
        }
        return;
    }
    if zjs_is_host_function(obj) != 0 && zjs_is_string(key) != 0 {
        let ks = zjs_as_string(key);
        let is_proto: int = 0;
        let kd = ks.data;
        let kn = ks.length;
        raw { is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0; }
        let hf = zjs_as_host_function(obj);
        if is_proto != 0 && zjs_is_object(value) != 0 {
            hf.prototype = zjs_as_object(value);
            return;
        }
        // Arbitrary property — lazily create the props object.
        if hf.props == NULL {
            let pv = ctx_new_object(ctx);
            hf.props = zjs_as_object(pv);
        }
        object_set(ctx, hf.props, ks, value);
        return;
    }
    // Primitives: silently ignored (real JS throws in strict mode).
}

// Result of an interpret() call. `is_throw=true` means an exception
// escaped this function — the caller (a Phase 3.1c+ try frame in the
// outer function, or zjs_eval) decides whether to catch or propagate.
struct InterpretResult {
    is_throw: bool;
    value:    ZjsValue;
}

impl Copy for InterpretResult {}

struct TryFrame {
    catch_ip:  usize;
    catch_reg: u8;
}

def MAX_TRY_DEPTH: usize = 32;

fn interpret(ctx: ZjsContext*, f: Function*, args: ZjsValue*, arg_count: u32) -> InterpretResult {
    if f == NULL { return InterpretResult{ is_throw: false, value: zjs_undefined() }; }

    let reg_count = f.register_count;
    let regs: ZjsValue* = NULL;
    raw {
        regs = (ZjsValue*)calloc(reg_count, sizeof(ZjsValue));
    }
    defer raw { free(regs); }

    // Initialize register file to undefined so a bug doesn't crash with
    // a stray NaN-boxed garbage value.
    let init: ZjsValue = zjs_undefined();
    let ri: u32 = 0;
    while ri < reg_count {
        regs[ri] = init;
        ri = ri + 1;
    }

    // Copy incoming args into the first param_count registers.
    let copy_count: u32 = if arg_count < f.param_count { arg_count } else { f.param_count };
    let ai: u32 = 0;
    while ai < copy_count {
        regs[ai] = args[ai];
        ai = ai + 1;
    }

    // Per-call try stack. Each frame stores where to jump on throw and
    // which register receives the thrown value.
    let try_stack: TryFrame[MAX_TRY_DEPTH];
    let try_depth: usize = 0;
    let throwing: bool = false;
    let thrown:   ZjsValue = zjs_undefined();

    // Register this call frame's register file with the GC so the
    // collector can see all our temporaries + locals as roots.
    ctx_push_root_frame(ctx, regs, reg_count);
    defer ctx_pop_root_frame(ctx);

    let ip: usize = 0;

    while ip < f.code_len {
        // GC may run between instructions when allocation pressure
        // exceeds the threshold. All live values are already in our
        // rooted register file, in globals, or transitively reachable
        // — safe boundary.
        ctx_maybe_gc(ctx);

        // Unwind before fetching the next instruction.
        if throwing {
            if try_depth > 0 {
                try_depth = try_depth - 1;
                let frame = try_stack[try_depth];
                ip = frame.catch_ip;
                regs[frame.catch_reg] = thrown;
                throwing = false;
                continue;
            }
            // No catch in this function — propagate to caller.
            return InterpretResult{ is_throw: true, value: thrown };
        }

        let inst = f.code[ip];
        let op = inst.op;

        if op == Op::Return {
            return InterpretResult{ is_throw: false, value: regs[inst.a] };
        }
        if op == Op::Halt {
            return InterpretResult{ is_throw: false, value: zjs_undefined() };
        }

        if op == Op::LoadInt {
            regs[inst.a] = zjs_int32((i32)inst_bc_i16(inst));
        } else if op == Op::LoadConst {
            regs[inst.a] = f.constants[inst_bc_u16(inst)];
        } else if op == Op::LoadUndefined {
            regs[inst.a] = zjs_undefined();
        } else if op == Op::LoadNull {
            regs[inst.a] = zjs_null();
        } else if op == Op::LoadTrue {
            regs[inst.a] = zjs_bool(1);
        } else if op == Op::LoadFalse {
            regs[inst.a] = zjs_bool(0);
        } else if op == Op::Mov {
            regs[inst.a] = regs[inst.b];

        // --- globals --------------------------------------------
        } else if op == Op::DefineGlobal {
            let slot = inst_bc_u16(inst);
            ctx.globals[slot].value = regs[inst.a];
            ctx.globals[slot].defined = true;
        } else if op == Op::LoadGlobal {
            let slot = inst_bc_u16(inst);
            if !ctx.globals[slot].defined {
                let nm = ctx.globals[slot].name;
                let nl = ctx.globals[slot].name_len;
                let err = build_reference_error(ctx, nm, nl);
                throwing = true; thrown = err; continue;
            }
            regs[inst.a] = ctx.globals[slot].value;
        } else if op == Op::LoadGlobalOrUndefined {
            let slot = inst_bc_u16(inst);
            if !ctx.globals[slot].defined {
                regs[inst.a] = zjs_undefined();
            } else {
                regs[inst.a] = ctx.globals[slot].value;
            }
        } else if op == Op::StoreGlobal {
            let slot = inst_bc_u16(inst);
            ctx.globals[slot].value = regs[inst.a];
            ctx.globals[slot].defined = true;

        // --- arithmetic -----------------------------------------
        } else if op == Op::Add {
            // ECMA-262: ToPrimitive both operands with hint "default"
            // (= "number" for non-Date). If either is a string after
            // coercion, concatenate; else numeric add.
            let av = regs[inst.b];
            let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            if zjs_is_string(av) != 0 || zjs_is_string(bv) != 0 {
                regs[inst.a] = zjs_string_concat(ctx, av, bv);
            } else {
                regs[inst.a] = zjs_arith_add(av, bv);
            }
        } else if op == Op::Sub {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_arith_sub(av, bv);
        } else if op == Op::Mul {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_arith_mul(av, bv);
        } else if op == Op::Div {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_arith_div(av, bv);
        } else if op == Op::Mod {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_arith_mod(av, bv);
        } else if op == Op::Pow {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_arith_pow(av, bv);

        // --- bitwise --------------------------------------------
        } else if op == Op::BitAnd {
            regs[inst.a] = zjs_bit_and(regs[inst.b], regs[inst.c]);
        } else if op == Op::BitOr {
            regs[inst.a] = zjs_bit_or(regs[inst.b], regs[inst.c]);
        } else if op == Op::BitXor {
            regs[inst.a] = zjs_bit_xor(regs[inst.b], regs[inst.c]);
        } else if op == Op::Shl {
            regs[inst.a] = zjs_shl(regs[inst.b], regs[inst.c]);
        } else if op == Op::Shr {
            regs[inst.a] = zjs_shr(regs[inst.b], regs[inst.c]);
        } else if op == Op::UShr {
            regs[inst.a] = zjs_ushr(regs[inst.b], regs[inst.c]);

        // --- comparison -----------------------------------------
        } else if op == Op::CmpEq {
            regs[inst.a] = zjs_bool(zjs_loose_eq(regs[inst.b], regs[inst.c]));
        } else if op == Op::CmpNe {
            let eq = zjs_loose_eq(regs[inst.b], regs[inst.c]);
            regs[inst.a] = zjs_bool(if eq != 0 { 0 } else { 1 });
        } else if op == Op::CmpStrictEq {
            regs[inst.a] = zjs_bool(zjs_strict_eq(regs[inst.b], regs[inst.c]));
        } else if op == Op::CmpStrictNe {
            let eq = zjs_strict_eq(regs[inst.b], regs[inst.c]);
            regs[inst.a] = zjs_bool(if eq != 0 { 0 } else { 1 });
        } else if op == Op::CmpLt {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_bool(zjs_cmp_lt(av, bv));
        } else if op == Op::CmpLe {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_bool(zjs_cmp_le(av, bv));
        } else if op == Op::CmpGt {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_bool(zjs_cmp_lt(bv, av));
        } else if op == Op::CmpGe {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if zjs_is_object(av) != 0 { av = zjs_to_primitive(ctx, av, false); }
            if zjs_is_object(bv) != 0 { bv = zjs_to_primitive(ctx, bv, false); }
            regs[inst.a] = zjs_bool(zjs_cmp_le(bv, av));

        // --- unary ----------------------------------------------
        } else if op == Op::Neg {
            let v = regs[inst.b];
            if zjs_is_object(v) != 0 { v = zjs_to_primitive(ctx, v, false); }
            regs[inst.a] = zjs_arith_neg(v);
        } else if op == Op::BitNot {
            regs[inst.a] = zjs_bit_not(regs[inst.b]);
        } else if op == Op::LogicalNot {
            let b = zjs_to_bool_coerce(regs[inst.b]);
            regs[inst.a] = zjs_bool(if b != 0 { 0 } else { 1 });

        // --- control flow ---------------------------------------
        } else if op == Op::Jmp {
            let off = inst_bc_i16(inst);
            ip = (usize)((i32)ip + off);
            // The ip += 1 below would still happen, but we deliberately
            // structured Jmp's offset as "relative to ip + 1", so the
            // normal increment is what we want. Same for the conditional
            // jumps below.
        } else if op == Op::JmpIfTrue {
            if zjs_to_bool_coerce(regs[inst.a]) != 0 {
                let off = inst_bc_i16(inst);
                ip = (usize)((i32)ip + off);
            }
        } else if op == Op::JmpIfFalse {
            if zjs_to_bool_coerce(regs[inst.a]) == 0 {
                let off = inst_bc_i16(inst);
                ip = (usize)((i32)ip + off);
            }
        } else if op == Op::MethodInvoke {
            // Same dispatch as Invoke but regs[base+1] is `this` and
            // explicit args live at regs[base+2..]. Set ctx.host_this
            // around the call so host builtins see the receiver.
            let dst = inst.a;
            let base = inst.b;
            let argc = (u32)inst.c;
            let callee = regs[base];
            let saved_this = ctx.host_this;
            ctx.host_this = regs[base + 1];
            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let target: Function* = NULL;
                raw { target = (Function*)fp; }
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 2]; }
                let r = interpret(ctx, target, argv_ptr, argc);
                ctx.host_this = saved_this;
                if r.is_throw { throwing = true; thrown = r.value; continue; }
                regs[dst] = r.value;
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                let argv_ptr2: ZjsValue* = NULL;
                raw { argv_ptr2 = &regs[base + 2]; }
                let saved_cl = ctx.current_closure;
                ctx.current_closure = cl;
                let r2 = interpret(ctx, target2, argv_ptr2, argc);
                ctx.current_closure = saved_cl;
                ctx.host_this = saved_this;
                if r2.is_throw { throwing = true; thrown = r2.value; continue; }
                regs[dst] = r2.value;
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 2]; }
                let r: ZjsValue = zjs_undefined();
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    r = fp(ctx, argv_ptr, argc);
                }
                ctx.host_this = saved_this;
                regs[dst] = r;
            } else {
                ctx.host_this = saved_this;
                regs[dst] = zjs_undefined();
            }
        } else if op == Op::Invoke {
            let dst = inst.a;
            let base = inst.b;
            let argc = (u32)inst.c;
            let callee = regs[base];
            // Plain call: this = undefined. Save & restore so a nested
            // method call's receiver doesn't leak across.
            let saved_this_plain = ctx.host_this;
            ctx.host_this = zjs_undefined();
            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let target: Function* = NULL;
                raw { target = (Function*)fp; }
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                let r = interpret(ctx, target, argv_ptr, argc);
                ctx.host_this = saved_this_plain;
                if r.is_throw {
                    throwing = true;
                    thrown = r.value;
                    continue;       // unwind on next loop iteration
                }
                regs[dst] = r.value;
            } else if zjs_is_closure(callee) != 0 {
                // Closure: like Function, but we swap ctx.current_closure
                // around the call so LoadEnv inside the callee reads
                // OUR env, not the caller's.
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                let argv_ptr2: ZjsValue* = NULL;
                raw { argv_ptr2 = &regs[base + 1]; }
                let saved_cl = ctx.current_closure;
                ctx.current_closure = cl;
                let r2 = interpret(ctx, target2, argv_ptr2, argc);
                ctx.current_closure = saved_cl;
                ctx.host_this = saved_this_plain;
                if r2.is_throw {
                    throwing = true;
                    thrown = r2.value;
                    continue;
                }
                regs[dst] = r2.value;
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                let r: ZjsValue = zjs_undefined();
                // ctx.host_this was already cleared above for the plain
                // Invoke path; restore once after the call.
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    r = fp(ctx, argv_ptr, argc);
                }
                ctx.host_this = saved_this_plain;
                regs[dst] = r;
            } else {
                ctx.host_this = saved_this_plain;
                regs[dst] = zjs_undefined();
            }
        } else if op == Op::Typeof {
            let v = regs[inst.b];
            let label: char* = (char*)"undefined";
            if zjs_is_undefined(v) != 0 {
                label = (char*)"undefined";
            } else if zjs_is_null(v) != 0 {
                label = (char*)"object";
            } else if zjs_is_bool(v) != 0 {
                label = (char*)"boolean";
            } else if zjs_is_number(v) != 0 {
                label = (char*)"number";
            } else if zjs_is_string(v) != 0 {
                label = (char*)"string";
            } else if zjs_is_function(v) != 0 || zjs_is_host_function(v) != 0 || zjs_is_closure(v) != 0 {
                label = (char*)"function";
            } else {
                label = (char*)"object";
            }
            let llen: u32 = 0;
            raw { llen = (uint32_t)strlen(label); }
            regs[inst.a] = ctx_intern_string(ctx, label, llen);
        } else if op == Op::Throw {
            throwing = true;
            thrown = regs[inst.a];
            continue;
        } else if op == Op::EnterTry {
            if try_depth >= MAX_TRY_DEPTH {
                // Out of try slots — surface as an uncaught throw.
                throwing = true;
                thrown = zjs_undefined();
                continue;
            }
            let off = inst_bc_i16(inst);
            let target: usize = (usize)((i32)ip + 1 + off);
            try_stack[try_depth].catch_ip = target;
            try_stack[try_depth].catch_reg = inst.a;
            try_depth = try_depth + 1;
        } else if op == Op::LeaveTry {
            if try_depth > 0 { try_depth = try_depth - 1; }
        } else if op == Op::MakeClosure {
            // a = dst, b = function-value reg, c = env-object reg
            let fn_val = regs[inst.b];
            let env_val = regs[inst.c];
            let fp: void* = zjs_cell_as_ptr(fn_val);
            let env_o: ZjsObject* = NULL;
            if zjs_is_object(env_val) != 0 {
                env_o = zjs_as_object(env_val);
            }
            let cl = zjs_closure_new(fp, env_o);
            ctx_register_cell(ctx, (void*)cl);
            regs[inst.a] = zjs_cell_from_ptr((void*)cl);
        } else if op == Op::LoadEnv {
            // a = dst. Read the env of the currently-executing closure
            // (or undefined if we're not inside one).
            if ctx.current_closure != NULL && ctx.current_closure.env != NULL {
                regs[inst.a] = zjs_cell_from_ptr((void*)ctx.current_closure.env);
            } else {
                regs[inst.a] = zjs_undefined();
            }
        } else if op == Op::LoadProp {
            let dst = inst.a;
            let obj_reg = inst.b;
            let ic_slot = inst.c;
            let obj_val = regs[obj_reg];

            // Capture IC fields into locals — read-only on fast path.
            let ic_class:  ZjsHiddenClass* = f.ics[ic_slot].class_;
            let ic_slot_n: u32             = f.ics[ic_slot].slot;
            let ic_name:   ZjsString*      = f.ics[ic_slot].name;

            let took_fast: bool = false;
            if zjs_is_object(obj_val) != 0 {
                let o = zjs_as_object(obj_val);
                if o.cls == ic_class && ic_class != NULL {
                    let raw_v = o.slots[ic_slot_n];
                    // Accessor slot (Phase 3.9b): bail to the slow path
                    // which invokes the getter with the right `this`.
                    if zjs_is_accessor(raw_v) == 0 {
                        regs[dst] = raw_v;
                        took_fast = true;
                    }
                }
            }
            if !took_fast {
                let key_val = zjs_cell_from_ptr((void*)ic_name);
                regs[dst] = property_get(ctx, obj_val, key_val);
                // Patch the IC if obj is now an object that has the prop —
                // unless the slot has gone megamorphic, in which case we
                // never patch (and never fast-path) again.
                if zjs_is_object(obj_val) != 0 && !f.ics[ic_slot].megamorphic {
                    let o = zjs_as_object(obj_val);
                    let s = class_find_slot(o.cls, ic_name);
                    if s >= 0 {
                        // Real shape conflict (previously seen a different,
                        // non-NULL class)? Bump the miss counter; flip to
                        // megamorphic once the threshold is crossed.
                        if ic_class != NULL && ic_class != o.cls {
                            let mc = f.ics[ic_slot].miss_count;
                            if mc < 255 { f.ics[ic_slot].miss_count = mc + 1; }
                            if f.ics[ic_slot].miss_count >= IC_MEGAMORPHIC_LIMIT {
                                f.ics[ic_slot].megamorphic = true;
                                f.ics[ic_slot].class_ = NULL;
                                f.ics[ic_slot].slot = 0;
                            } else {
                                f.ics[ic_slot].class_ = o.cls;
                                f.ics[ic_slot].slot = (u32)s;
                            }
                        } else {
                            f.ics[ic_slot].class_ = o.cls;
                            f.ics[ic_slot].slot = (u32)s;
                        }
                    }
                }
            }
        } else if op == Op::StoreProp {
            let obj_reg = inst.a;
            let ic_slot = inst.b;
            let val_reg = inst.c;
            let obj_val = regs[obj_reg];
            let value   = regs[val_reg];

            let ic_class: ZjsHiddenClass* = f.ics[ic_slot].class_;
            let ic_slot_n: u32            = f.ics[ic_slot].slot;
            let ic_name:  ZjsString*      = f.ics[ic_slot].name;

            let took_fast: bool = false;
            if zjs_is_object(obj_val) != 0 {
                let o = zjs_as_object(obj_val);
                if o.cls == ic_class && ic_class != NULL {
                    let raw_v = o.slots[ic_slot_n];
                    // Accessor slot (Phase 3.9b): bail to the slow path
                    // which invokes the setter with `this = obj`.
                    if zjs_is_accessor(raw_v) == 0 {
                        // Existing-slot write — no transition, no GC implication.
                        o.slots[ic_slot_n] = value;
                        took_fast = true;
                    }
                }
            }
            if !took_fast {
                let key_val = zjs_cell_from_ptr((void*)ic_name);
                property_set(ctx, obj_val, key_val, value);
                // Patch unless megamorphic. Same miss-tracking logic as LoadProp.
                if zjs_is_object(obj_val) != 0 && !f.ics[ic_slot].megamorphic {
                    let o = zjs_as_object(obj_val);
                    let s = class_find_slot(o.cls, ic_name);
                    if s >= 0 {
                        if ic_class != NULL && ic_class != o.cls {
                            let mc = f.ics[ic_slot].miss_count;
                            if mc < 255 { f.ics[ic_slot].miss_count = mc + 1; }
                            if f.ics[ic_slot].miss_count >= IC_MEGAMORPHIC_LIMIT {
                                f.ics[ic_slot].megamorphic = true;
                                f.ics[ic_slot].class_ = NULL;
                                f.ics[ic_slot].slot = 0;
                            } else {
                                f.ics[ic_slot].class_ = o.cls;
                                f.ics[ic_slot].slot = (u32)s;
                            }
                        } else {
                            f.ics[ic_slot].class_ = o.cls;
                            f.ics[ic_slot].slot = (u32)s;
                        }
                    }
                }
            }
        } else if op == Op::NewObject {
            regs[inst.a] = ctx_new_object(ctx);
        } else if op == Op::NewArray {
            let dst = inst.a;
            let base = inst.b;
            let count = (u32)inst.c;
            let arr_val = ctx_new_array(ctx, count);
            let arr = zjs_as_array(arr_val);
            let i: u32 = 0;
            while i < count {
                arr.elements[i] = regs[base + (u8)i];
                i = i + 1;
            }
            arr.length = count;
            regs[dst] = arr_val;
        } else if op == Op::LoadElem {
            regs[inst.a] = property_get(ctx, regs[inst.b], regs[inst.c]);
        } else if op == Op::StoreElem {
            property_set(ctx, regs[inst.a], regs[inst.b], regs[inst.c]);
        } else if op == Op::LoadThis {
            regs[inst.a] = ctx.host_this;
        } else if op == Op::In {
            // key in obj — own property OR proto-chain hit OR builtin
            // intercept (length, array/string proto methods).
            let key = regs[inst.b];
            let obj = regs[inst.c];
            let present: int = 0;
            if zjs_is_array(obj) != 0 {
                let a = zjs_as_array(obj);
                let idx = zjs_to_array_index(key);
                if idx >= 0 && (u32)idx < a.length {
                    present = 1;
                } else if zjs_is_string(key) != 0 {
                    // Falls back through length / array_proto.
                    let pv = property_get(ctx, obj, key);
                    if zjs_is_undefined(pv) == 0 { present = 1; }
                }
            } else if zjs_is_object(obj) != 0 {
                let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name = zjs_as_string(key_str_val);
                let cur = zjs_as_object(obj);
                while cur != NULL {
                    if class_find_slot(cur.cls, name) >= 0 { present = 1; cur = NULL; }
                    else { cur = cur.proto; }
                }
            }
            regs[inst.a] = zjs_bool(present);
        } else if op == Op::Instanceof {
            // val instanceof ctor — ctor.prototype must be in val's chain.
            let val = regs[inst.b];
            let ctor = regs[inst.c];
            let proto_obj: ZjsObject* = NULL;
            if zjs_is_function(ctor) != 0 {
                let fp = zjs_cell_as_ptr(ctor);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                proto_obj = f.prototype;
            } else if zjs_is_host_function(ctor) != 0 {
                proto_obj = zjs_as_host_function(ctor).prototype;
            }
            let result: int = 0;
            if proto_obj != NULL && zjs_is_object(val) != 0 {
                let cur = zjs_as_object(val).proto;
                while cur != NULL {
                    if cur == proto_obj { result = 1; cur = NULL; }
                    else                { cur = cur.proto; }
                }
            }
            regs[inst.a] = zjs_bool(result);
        } else if op == Op::NewInvoke {
            // new Ctor(args): allocate {} with proto = Ctor.prototype,
            // bind `this` to it, call. If callee returns an object,
            // use that; otherwise use the new object.
            let dst = inst.a;
            let base = inst.b;
            let argc = (u32)inst.c;
            let callee = regs[base];

            // Lazy-create the constructor's .prototype as we did in
            // property_get, so even a never-touched ctor.prototype is
            // a real object after `new` runs.
            let proto_obj: ZjsObject* = NULL;
            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.prototype == NULL {
                    let pv = ctx_new_object(ctx);
                    f.prototype = zjs_as_object(pv);
                }
                proto_obj = f.prototype;
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let f: Function* = NULL;
                raw { f = (Function*)fp2; }
                if f.prototype == NULL {
                    let pv = ctx_new_object(ctx);
                    f.prototype = zjs_as_object(pv);
                }
                proto_obj = f.prototype;
            } else if zjs_is_host_function(callee) != 0 {
                let hf = zjs_as_host_function(callee);
                if hf.prototype == NULL {
                    let pv = ctx_new_object(ctx);
                    hf.prototype = zjs_as_object(pv);
                }
                proto_obj = hf.prototype;
            }

            let new_obj_v = ctx_new_object(ctx);
            let new_obj = zjs_as_object(new_obj_v);
            new_obj.proto = proto_obj;

            let saved_this = ctx.host_this;
            ctx.host_this = new_obj_v;

            let call_result: ZjsValue = zjs_undefined();
            let did_throw: bool = false;
            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let target: Function* = NULL;
                raw { target = (Function*)fp; }
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                let r = interpret(ctx, target, argv_ptr, argc);
                if r.is_throw { did_throw = true; call_result = r.value; }
                else          { call_result = r.value; }
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                let argv_ptr2: ZjsValue* = NULL;
                raw { argv_ptr2 = &regs[base + 1]; }
                let saved_cl = ctx.current_closure;
                ctx.current_closure = cl;
                let r2 = interpret(ctx, target2, argv_ptr2, argc);
                ctx.current_closure = saved_cl;
                if r2.is_throw { did_throw = true; call_result = r2.value; }
                else           { call_result = r2.value; }
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    call_result = fp(ctx, argv_ptr, argc);
                }
            }
            ctx.host_this = saved_this;
            if did_throw {
                throwing = true; thrown = call_result; continue;
            }
            // Use callee's return if it returned an object; else the new one.
            if zjs_is_object(call_result) != 0 || zjs_is_array(call_result) != 0 {
                regs[dst] = call_result;
            } else {
                regs[dst] = new_obj_v;
            }
        } else if op == Op::BuildArguments {
            // Build a fresh array from the call's args + arg_count and
            // stash it in regs[a]. Emitted at function entry when the
            // body references `arguments`.
            let arr_v = ctx_new_array(ctx, arg_count);
            let arr = zjs_as_array(arr_v);
            let i: u32 = 0;
            while i < arg_count {
                arr.elements[i] = args[i];
                i = i + 1;
            }
            arr.length = arg_count;
            regs[inst.a] = arr_v;
        } else if op == Op::IterPrepare {
            regs[inst.a] = iter_prepare(ctx, regs[inst.b], (u32)inst.c);
        } else if op == Op::ArrayLength {
            let src = regs[inst.b];
            if zjs_is_array(src) != 0 {
                let a = zjs_as_array(src);
                regs[inst.a] = zjs_int32((i32)a.length);
            } else {
                regs[inst.a] = zjs_int32(0);
            }
        }
        // else: unknown opcode — ignore (interpreter is permissive
        // during MVP; the compiler shouldn't emit such ops).

        ip = ip + 1;
    }

    return InterpretResult{ is_throw: false, value: zjs_undefined() };
}

// Invoke a JS-visible callable (Function | Closure | HostFunction) from
// host code. Used by Array.prototype.{map, forEach} to fire the user's
// callback. For MVP, an inner throw is dropped and `undefined` returned
// to the host — proper throw propagation across the host boundary is a
// future-work item (would need a ctx.pending_throw flag and a check in
// Op::MethodInvoke / Op::Invoke after each host call).
// ECMA-262 ToPrimitive(input, hint).
//
//  - `prefer_string = false` (the "number" or "default" hint): call
//    valueOf() first; if it returns a primitive, use it. Else call
//    toString().
//  - `prefer_string = true`: reverse the order.
//
// Returns input unchanged if it's already primitive. If neither
// valueOf nor toString returns a primitive, returns undefined
// (spec says TypeError; MVP falls back).
fn zjs_to_primitive(ctx: ZjsContext*, v: ZjsValue, prefer_string: bool) -> ZjsValue {
    if zjs_is_object(v) == 0 { return v; }

    let valueOf_atom  = ctx_intern_atom(ctx, (char*)"valueOf",  7);
    let toString_atom = ctx_intern_atom(ctx, (char*)"toString", 8);
    let first_atom: ZjsString*  = if prefer_string { toString_atom } else { valueOf_atom };
    let second_atom: ZjsString* = if prefer_string { valueOf_atom  } else { toString_atom };

    let argv: ZjsValue* = NULL;

    let m1 = property_get(ctx, v, zjs_cell_from_ptr((void*)first_atom));
    if zjs_is_function(m1) != 0 || zjs_is_closure(m1) != 0 || zjs_is_host_function(m1) != 0 {
        let r1 = zjs_call_value_with_this(ctx, m1, v, argv, 0);
        if zjs_is_object(r1) == 0 { return r1; }
    }
    let m2 = property_get(ctx, v, zjs_cell_from_ptr((void*)second_atom));
    if zjs_is_function(m2) != 0 || zjs_is_closure(m2) != 0 || zjs_is_host_function(m2) != 0 {
        let r2 = zjs_call_value_with_this(ctx, m2, v, argv, 0);
        if zjs_is_object(r2) == 0 { return r2; }
    }
    return zjs_undefined();
}

// Like zjs_call_value but explicitly binds `this`. Used by
// Function.prototype.{call, apply} to pass through a caller-chosen
// receiver. Unlike the plain helper, this does NOT clear
// ctx.host_this around host-function dispatch — the explicit
// `this_val` is the receiver the callee should see.
fn zjs_call_value_with_this(ctx: ZjsContext*, callee: ZjsValue, this_val: ZjsValue, args: ZjsValue*, argc: u32) -> ZjsValue {
    let saved = ctx.host_this;
    ctx.host_this = this_val;
    let r: ZjsValue = zjs_undefined();
    if zjs_is_function(callee) != 0 {
        let fp = zjs_cell_as_ptr(callee);
        let target: Function* = NULL;
        raw { target = (Function*)fp; }
        let rr = interpret(ctx, target, args, argc);
        r = rr.value;
    } else if zjs_is_closure(callee) != 0 {
        let cl = zjs_as_closure(callee);
        let fp2 = cl.function;
        let target2: Function* = NULL;
        raw { target2 = (Function*)fp2; }
        let saved_cl = ctx.current_closure;
        ctx.current_closure = cl;
        let rr = interpret(ctx, target2, args, argc);
        ctx.current_closure = saved_cl;
        r = rr.value;
    } else if zjs_is_host_function(callee) != 0 {
        let hf_ptr = zjs_cell_as_ptr(callee);
        raw {
            ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
            typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
            HostFn fp = (HostFn)hf->fn_ptr;
            r = fp(ctx, args, argc);
        }
    }
    ctx.host_this = saved;
    return r;
}

fn zjs_call_value(ctx: ZjsContext*, callee: ZjsValue, args: ZjsValue*, argc: u32) -> ZjsValue {
    if zjs_is_function(callee) != 0 {
        let fp = zjs_cell_as_ptr(callee);
        let target: Function* = NULL;
        raw { target = (Function*)fp; }
        let r = interpret(ctx, target, args, argc);
        return r.value;
    }
    if zjs_is_closure(callee) != 0 {
        let cl = zjs_as_closure(callee);
        let fp2 = cl.function;
        let target2: Function* = NULL;
        raw { target2 = (Function*)fp2; }
        let saved_cl = ctx.current_closure;
        ctx.current_closure = cl;
        let r2 = interpret(ctx, target2, args, argc);
        ctx.current_closure = saved_cl;
        return r2.value;
    }
    if zjs_is_host_function(callee) != 0 {
        let hf_ptr = zjs_cell_as_ptr(callee);
        let r: ZjsValue = zjs_undefined();
        let saved_this = ctx.host_this;
        ctx.host_this = zjs_undefined();
        raw {
            ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
            typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
            HostFn fp = (HostFn)hf->fn_ptr;
            r = fp(ctx, args, argc);
        }
        ctx.host_this = saved_this;
        return r;
    }
    return zjs_undefined();
}
