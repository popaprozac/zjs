                if target.is_class_constructor {
                    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                                (char*)"Class constructor cannot be invoked without 'new'", 50);
                    throwing = true; thrown = err; exit_reason = 3;
                    ctx.frames[cur_idx].ip = ip + 1; break;
                }
                if target.is_generator {
                    // Generator-function call: push frame to run the
                    // prologue; Op::GeneratorStart at end of prologue
                    // captures state into a fresh generator and unwinds.
                    let gen = zjs_generator_new();
                    ctx_register_cell(ctx, (void*)gen);
                    gen.function = target;
                    gen.reg_count = target.register_count;
                    gen.state = GEN_STARTING;
                    gen.is_async = target.is_async;
                    gen.saved_host_this = ctx.host_this;
                    ctx.frames[cur_idx].ip = ip + 1;
                    push_call_frame_inplace(ctx, target, regs_base + (u32)base + 1, argc, dst);
                    let new_fi = ctx.frame_count - 1;
                    ctx.frames[new_fi].generator = gen;
