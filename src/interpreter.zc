                // must return an iterator WITHOUT running its body.
                // tail_call_frame would instead run the body synchronously
                // and return its raw completion value. So fall back to a
                // normal (non-replacing) call here; the compiler keeps a
                // trailing Op::Return after the Tail op for us to land on,
                // which returns the produced Promise / generator.
                if target != NULL && (target.is_async || target.is_generator) {
