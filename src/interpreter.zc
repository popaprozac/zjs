                        ctx_register_cell(ctx, (void*)gen);
                        gen.function = target;
                        gen.reg_count = target.register_count;
                        gen.state = GEN_STARTING;
                        gen.is_async = target.is_async;
                        gen.saved_host_this = new_this;
                        if is_closure_callee { gen.saved_current_closure = cl_callee; }
                        ctx.frames[cur_idx].ip = ip + 1;
                        push_call_frame_inplace(ctx, target, args_at, argc, dst);
                        let new_fi = ctx.frame_count - 1;
                        ctx.frames[new_fi].generator = gen;
                        ctx.host_this = new_this;
                        if is_closure_callee { ctx.current_closure = cl_callee; }
                        exit_reason = 2;
                        break;
