                        // is only worth OSR-compiling if it executes enough ops in
                        // a single run to amortize the entry/exit spill-fill —
                        // approximated by burst × the region's instruction span.
                        if f.jit_osr_burst_hdr == (i32)header {
                            f.jit_osr_calls = f.jit_osr_calls + 1;
                        } else {
                            f.jit_osr_burst_hdr = (i32)header;
                            f.jit_osr_calls = 1;
                        }
                        let span: i64 = (i64)prev_ip - (i64)header + 1;
                        if span < 1 { span = 1; }
                        let work: i64 = (i64)f.jit_osr_calls * span;
                        if work >= (i64)jit_osr_work_threshold() {
                            jit_compile_osr(ctx, f, header, (u32)prev_ip);
                        }
