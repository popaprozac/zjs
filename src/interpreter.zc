                // Push before reassigning host_this so the new frame's
                // saved_host_this records the caller's `this`.
                push_call_frame_inplace(ctx, target, regs_base + (u32)base + 1, argc, dst);
                if target.is_async { wire_async_call(ctx, target, regs_base, dst); }
                // Non-strict default `this` is the global object per
                // ECMA-262 OrdinaryCallBindThis step 6. We don't track
                // strict-mode-per-function yet; default to global.
                if ctx.realm.global_this_obj != NULL {
                    ctx.host_this = zjs_cell_from_ptr((void*)ctx.realm.global_this_obj);
