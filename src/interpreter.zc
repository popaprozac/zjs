                if target2.is_class_constructor {
                    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                                (char*)"Class constructor cannot be invoked without 'new'", 50);
                    throwing = true; thrown = err; exit_reason = 3;
                    ctx.frames[cur_idx].ip = ip + 1; break;
                }
                if target2.is_generator {
                    let gen = zjs_generator_new();
                    ctx_register_cell(ctx, (void*)gen);
                    gen.function = target2;
                    gen.reg_count = target2.register_count;
                    gen.state = GEN_STARTING;
                    gen.is_async = target2.is_async;
                    gen.saved_host_this = new_this;
                    gen.saved_current_closure = cl;
                    ctx.frames[cur_idx].ip = ip + 1;
                    push_call_frame_inplace(ctx, target2, regs_base + (u32)base + 2, argc, dst);
                    let new_fi = ctx.frame_count - 1;
                    ctx.frames[new_fi].generator = gen;
                    ctx.host_this = new_this;
                    ctx.current_closure = cl;
                    exit_reason = 2;
                    break;
                }
                ctx.frames[cur_idx].ip = ip + 1;
                push_call_frame_inplace(ctx, target2, regs_base + (u32)base + 2, argc, dst);
                if target2.is_async { wire_async_call(ctx, target2, regs_base, dst); }
