                    ctx.frames[cur_idx].ip = ip + 1; break;
                }
                ctx.frames[cur_idx].ip = ip + 1;
                push_call_frame(ctx, target, argv_ptr, argc, dst);
                if target.is_async { wire_async_call(ctx, target, regs_base, dst); }
