            let saved_this = ctx.host_this;
            let saved_nt = ctx.new_target_active;
            let saved_ntv = ctx.new_target_value;
            ctx.host_this = new_obj_v;
            ctx.new_target_active = true;
            ctx.new_target_value = callee;

            let call_result: ZjsValue = zjs_undefined();
            let did_throw: bool = false;
            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let target: Function* = NULL;
                raw { target = (Function*)fp; }
                // Synthesized default derived constructor: forward
                // arguments straight to the parent ctor instead of
                // interpreting an empty body.
                if target.is_default_derived_ctor {
                    let parent = target.parent_ctor;
                    let argv_ptr: ZjsValue* = NULL;
                    raw { argv_ptr = &regs[base + 1]; }
                    let r: ZjsValue = zjs_undefined();
                    raw { r = zjs_call_value_with_this(ctx, parent, ctx->host_this, argv_ptr, argc); }
                    if ctx.pending_throw_active {
                        did_throw = true;
                        call_result = consume_pending_throw(ctx);
                    } else {
                        // If parent ctor returned a special cell
                        // (TAG_PROMISE, TAG_REGEXP), pivot host_this
                        // and propagate up — same logic as SuperCall.
                        if zjs_is_promise(r) != 0 || zjs_is_regexp(r) != 0 {
                            ctx.host_this = r;
                        }
                        call_result = r;
                    }
                } else {
                    let argv_ptr: ZjsValue* = NULL;
                    raw { argv_ptr = &regs[base + 1]; }
                    let r = interpret(ctx, target, argv_ptr, argc);
                    if r.is_throw { did_throw = true; call_result = r.value; }
                    else          { call_result = r.value; }
                }
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                let argv_ptr2: ZjsValue* = NULL;
                raw { argv_ptr2 = &regs[base + 1]; }
                // Default derived constructor wrapped as a closure
                // (because the class body captures outer scope). Same
                // short-circuit as the TAG_FUNCTION branch: forward
                // straight to the parent ctor instead of interpreting
                // the empty body, which would fail the spec's
                // super-called gate at Op::Return.
                if target2.is_default_derived_ctor {
                    let parent = target2.parent_ctor;
                    let saved_cl = ctx.current_closure;
                    ctx.current_closure = cl;
                    let r: ZjsValue = zjs_undefined();
                    raw { r = zjs_call_value_with_this(ctx, parent, ctx->host_this, argv_ptr2, argc); }
                    ctx.current_closure = saved_cl;
                    if ctx.pending_throw_active {
                        did_throw = true;
                        call_result = consume_pending_throw(ctx);
                    } else {
                        if zjs_is_promise(r) != 0 || zjs_is_regexp(r) != 0 {
                            ctx.host_this = r;
                        }
                        call_result = r;
                    }
                } else {
                    let saved_cl = ctx.current_closure;
                    ctx.current_closure = cl;
                    let r2 = interpret(ctx, target2, argv_ptr2, argc);
                    ctx.current_closure = saved_cl;
                    if r2.is_throw { did_throw = true; call_result = r2.value; }
                    else           { call_result = r2.value; }
                }
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                let saved_host_fn = ctx.current_host_fn;
                ctx.current_host_fn = hf_ptr;
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    call_result = fp(ctx, argv_ptr, argc);
                }
                ctx.current_host_fn = saved_host_fn;
                if ctx.pending_throw_active {
                    did_throw = true;
                    call_result = consume_pending_throw(ctx);
                }
            }
            // Capture whatever super() may have rebound `this` to
            // before restoring (e.g. Promise ctor handing back a
            // freshly-allocated TAG_PROMISE).
            let final_this = ctx.host_this;
            ctx.host_this = saved_this;
            ctx.new_target_active = saved_nt;
            ctx.new_target_value = saved_ntv;
            if did_throw {
                throwing = true; thrown = call_result; exit_reason = 3; break;
            }
            let rt2: u8 = zjs_cell_tag(call_result);
            let result_is_object: bool =
                rt2 == TAG_OBJECT
                || rt2 == TAG_ARRAY
                || rt2 == TAG_PROMISE
                || rt2 == TAG_REGEXP
                || rt2 == TAG_FUNCTION
                || rt2 == TAG_CLOSURE
                || rt2 == TAG_HOST_FUNCTION
                || rt2 == TAG_MAP
                || rt2 == TAG_SET
                || rt2 == TAG_DATE
                || rt2 == TAG_UINT8_ARRAY
                || rt2 == TAG_TYPED_ARRAY
                || rt2 == TAG_ARRAY_BUFFER
                || rt2 == TAG_DATA_VIEW
                || rt2 == TAG_WEBSOCKET
                || rt2 == TAG_PROXY;
            // Derived-class ctor: a non-undefined non-Object return is
            // a TypeError. Base ctors silently coerce to `this`.
            let callee_is_derived: bool = false;
            if zjs_is_function(callee) != 0 {
                let dfp = zjs_cell_as_ptr(callee);
                let dt: Function* = NULL;
                raw { dt = (Function*)dfp; }
                if dt.is_class_constructor && dt.parent_ctor.bits != zjs_undefined().bits {
                    callee_is_derived = true;
                }
            } else if zjs_is_closure(callee) != 0 {
                let dcl = zjs_as_closure(callee);
                let dfp2 = dcl.function;
                let dt2: Function* = NULL;
                raw { dt2 = (Function*)dfp2; }
                if dt2.is_class_constructor && dt2.parent_ctor.bits != zjs_undefined().bits {
                    callee_is_derived = true;
                }
            }
            if callee_is_derived
               && !result_is_object
               && zjs_is_undefined(call_result) == 0 {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Derived constructors may only return object or undefined", 56);
                throwing = true; thrown = err; exit_reason = 3; break;
            }
            // Use callee's return if it returned an Object (per ECMA-262
            // — any object-typed value, including callables produced by
            // `new Function(...)`).
            if result_is_object {
                regs[dst] = call_result;
            } else if final_this.bits != new_obj_v.bits
                      && (zjs_is_promise(final_this) != 0
                          || zjs_is_regexp(final_this) != 0) {
                // super() rebound `this` to a parent-allocated special
                // cell — use it as the constructor's result. This is
                // how `class Foo extends Promise { constructor(e) {
                // super(e); } }` produces a real TAG_PROMISE.
                regs[dst] = final_this;
            } else {
                regs[dst] = new_obj_v;
            }
        } else if op == Op::DeleteElem {
            // Mark the property's slot DELETED (sentinel). For arrays:
            // clear the element (set to undefined; the spec calls this
            // an "array hole"). Returns boolean true on success, false
            // when the property exists but is non-configurable.
            let dst = inst.a;
            let obj_v = regs[inst.b];
            let key   = regs[inst.c];
            let ok: bool = true;
            let obj_tag: u8 = if zjs_is_cell(obj_v) != 0 { zjs_cell_tag(obj_v) } else { 0xFF };
            // Resolve the .props expando for function / closure / host-fn
            // receivers — they route property storage through that bag.
            let props_o: ZjsObject* = NULL;
            if obj_tag == TAG_FUNCTION {
                let fp = zjs_cell_as_ptr(obj_v);
                let ff: Function* = NULL;
                raw { ff = (Function*)fp; }
                props_o = ff.props;
            } else if obj_tag == TAG_CLOSURE {
                let cl = zjs_as_closure(obj_v);
                let fp2 = cl.function;
                let ff2: Function* = NULL;
                raw { ff2 = (Function*)fp2; }
                props_o = ff2.props;
            } else if obj_tag == TAG_HOST_FUNCTION {
                let hf = zjs_as_host_function(obj_v);
                props_o = hf.props;
            }
            if zjs_is_object(obj_v) != 0 {
                let o = zjs_as_object(obj_v);
                let key_str = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name = zjs_as_string(key_str);
                let slot = class_find_slot(o.cls, name);
                if slot >= 0 {
                    let a = object_get_attrs(o, (u32)slot);
                    if (a & PROP_CONFIGURABLE) == 0 {
                        ok = false;
                    } else {
                        o.slots[(u32)slot] = zjs_deleted();
                    }
                }
                // Property not present → spec returns true.
            } else if zjs_is_array(obj_v) != 0 {
                let a = zjs_as_array(obj_v);
                let idx = zjs_to_array_index(key);
                if idx >= 0 && (u32)idx < a.length {
                    // `delete arr[i]` leaves a hole — the slot is no
                    // longer "in" the array for HasProperty purposes.
                    // Array elements aren't tracked with attrs yet, so
                    // they're always configurable per spec.
                    a.elements[(u32)idx] = zjs_deleted();
                }
            } else if obj_tag == TAG_HOST_FUNCTION {
                // Host functions synthesize `name` / `length` lazily
                // from hf.name / hf.arity rather than storing them as
                // real own slots. To honor `delete builtinFn.name`
                // (configurable: true per spec), record the override
                // by installing a deleted sentinel on hf.props — the
                // synthesizing reader checks for it first.
                let key_str = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name = zjs_as_string(key_str);
                let is_synth_name: bool =
                    (name.length == 4 && name.data[0] == (char)'n' && name.data[1] == (char)'a'
                     && name.data[2] == (char)'m' && name.data[3] == (char)'e')
                    || (name.length == 6 && name.data[0] == (char)'l' && name.data[1] == (char)'e'
                        && name.data[2] == (char)'n' && name.data[3] == (char)'g'
                        && name.data[4] == (char)'t' && name.data[5] == (char)'h');
                let hf = zjs_as_host_function(obj_v);
                if is_synth_name {
                    if hf.props == NULL {
                        let pv = ctx_new_object(ctx);
                        hf.props = zjs_as_object(pv);
                    }
                    object_set(ctx, hf.props, name, zjs_deleted());
                } else if props_o != NULL {
                    let slot = class_find_slot(props_o.cls, name);
                    if slot >= 0 {
                        let a = object_get_attrs(props_o, (u32)slot);
                        if (a & PROP_CONFIGURABLE) == 0 {
                            ok = false;
                        } else {
                            props_o.slots[(u32)slot] = zjs_deleted();
                        }
                    }
                }
            } else if props_o != NULL {
                let key_str = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name = zjs_as_string(key_str);
                let slot = class_find_slot(props_o.cls, name);
                if slot >= 0 {
                    let a = object_get_attrs(props_o, (u32)slot);
                    if (a & PROP_CONFIGURABLE) == 0 {
                        ok = false;
                    } else {
                        props_o.slots[(u32)slot] = zjs_deleted();
                    }
                }
            }
            regs[dst] = zjs_bool(ok);
        } else if op == Op::BuildArguments {
            // Build a fresh array from the call's full passed-args list.
            // Args live on the reg_stack at frame.args_base, length
            // frame.argc (covers the case where argc > param_count).
            let frame_argc = ctx.frames[cur_idx].argc;
            let frame_args_base = ctx.frames[cur_idx].args_base;
            let arr_v = ctx_new_array(ctx, frame_argc);
            let arr = zjs_as_array(arr_v);
            let i: u32 = 0;
            while i < frame_argc {
                arr.elements[i] = ctx.reg_stack[frame_args_base + i];
                i = i + 1;
            }
            arr.length = frame_argc;
            regs[inst.a] = arr_v;
        } else if op == Op::BuildRestArgs {
            // ...rest at the end of a param list. Build an array from
            // args_base[skip..argc]; empty when argc <= skip.
            let frame_argc = ctx.frames[cur_idx].argc;
            let frame_args_base = ctx.frames[cur_idx].args_base;
            let skip: u32 = (u32)inst.b;
            let rest_len: u32 = if frame_argc > skip { frame_argc - skip } else { 0 };
            let arr_v = ctx_new_array(ctx, rest_len);
            let arr = zjs_as_array(arr_v);
            let i: u32 = 0;
            while i < rest_len {
                arr.elements[i] = ctx.reg_stack[frame_args_base + skip + i];
                i = i + 1;
            }
            arr.length = rest_len;
            regs[inst.a] = arr_v;
        } else if op == Op::ArrayPush {
            // Append regs[b] to the array in regs[a]. Used by array
            // literals containing spread, where the element count
            // isn't known at compile time.
            let arr_v = regs[inst.a];
            if zjs_is_array(arr_v) != 0 {
                let arr = zjs_as_array(arr_v);
                array_set(arr, arr.length, regs[inst.b]);
            }
        } else if op == Op::ArraySpread {
            // Iterate regs[b] and append each element to regs[a].
            // Supports arrays (direct walk) and array-like objects
            // with a numeric length property. Strings and Symbol-
            // iterator protocols come later.
            let arr_v = regs[inst.a];
            let src   = regs[inst.b];
            if zjs_is_array(arr_v) != 0 {
                let arr = zjs_as_array(arr_v);
                if zjs_is_array(src) != 0 {
                    let s_arr = zjs_as_array(src);
                    let si: u32 = 0;
                    while si < s_arr.length {
                        let v = s_arr.elements[si];
                        // Holes spread as undefined per spec.
                        if zjs_is_deleted(v) != 0 { v = zjs_undefined(); }
                        array_set(arr, arr.length, v);
                        si = si + 1;
                    }
                } else if zjs_is_string(src) != 0 {
                    let s = zjs_as_string(src);
                    let si: u32 = 0;
                    while si < s.length {
                        let chv = ctx_intern_string(ctx, s.data + si, 1);
                        array_set(arr, arr.length, chv);
                        si = si + 1;
                    }
                } else {
                    // Fall through to iter_prepare which handles the
                    // @@iterator protocol (generators, user
                    // iterables). It materializes into a fresh array
                    // we can then walk like the array case above.
                    let collected = iter_prepare(ctx, src, 1);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                    if zjs_is_array(collected) != 0 {
                        let s_arr2 = zjs_as_array(collected);
                        let si2: u32 = 0;
                        while si2 < s_arr2.length {
                            let v2 = s_arr2.elements[si2];
                            if zjs_is_deleted(v2) != 0 { v2 = zjs_undefined(); }
                            array_set(arr, arr.length, v2);
                            si2 = si2 + 1;
                        }
                    } else {
                        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                                    (char*)"Spread source is not iterable", 29);
                        throwing = true; thrown = err; exit_reason = 3;
                        ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
        } else if op == Op::ObjectSpread {
            // `{ ...src }`: copy own enumerable string-keyed props from
            // src onto the target object. Spec ignores null/undefined
            // sources without throwing.
            let dst_v = regs[inst.a];
            let src   = regs[inst.b];
            if zjs_is_object(dst_v) != 0
               && zjs_is_undefined(src) == 0
               && zjs_is_null(src) == 0 {
                // Reuse for-in's "own enumerable keys" walk by calling
                // iter_prepare with kind=0, then GET/SET each key.
                let keys_v = iter_prepare(ctx, src, 0);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                if zjs_is_array(keys_v) != 0 {
                    let keys = zjs_as_array(keys_v);
                    let dst_obj = zjs_as_object(dst_v);
                    let ki: u32 = 0;
                    while ki < keys.length {
                        let k = keys.elements[ki];
                        if zjs_is_deleted(k) == 0 {
                            let v = property_get(ctx, src, k);
                            if ctx.pending_throw_active {
                                throwing = true; thrown = consume_pending_throw(ctx);
                                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                            }
                            if zjs_is_string(k) != 0 {
                                let name = zjs_as_string(k);
                                object_set(ctx, dst_obj, name, v);
                            }
                        }
                        ki = ki + 1;
                    }
                    if throwing { break; }
                }
            }
        } else if op == Op::IterGet {
            regs[inst.a] = iter_get(ctx, regs[inst.b]);
            if ctx.pending_throw_active {
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::IterGetAsync {
            regs[inst.a] = iter_get_async(ctx, regs[inst.b]);
            if ctx.pending_throw_active {
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::IterStep {
            let step = iter_step(ctx, regs[inst.b]);
            regs[inst.a] = step.value;
            regs[inst.c] = zjs_bool(step.done);
            if ctx.pending_throw_active {
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::IterNextRaw {
            regs[inst.a] = iter_call_next_raw(ctx, regs[inst.b]);
            if ctx.pending_throw_active {
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::IterRestCollect {
            let iter = regs[inst.b];
            let arr_v = ctx_new_array(ctx, 0);
            let arr = zjs_as_array(arr_v);
            let safety: u32 = 0;
            let aborted: bool = false;
            while safety < 100000000 {
                let step = iter_step(ctx, iter);
                if ctx.pending_throw_active {
                    aborted = true;
                    break;
                }
                if step.done { break; }
                array_set(arr, arr.length, step.value);
                safety = safety + 1;
            }
            regs[inst.a] = arr_v;
            regs[inst.c] = zjs_bool(true);
            if aborted {
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::IterClose {
            let done_v = regs[inst.b];
            let already_done: bool = false;
            if zjs_is_bool(done_v) != 0 { already_done = zjs_as_bool(done_v) != 0; }
            if !already_done {
                iter_close(ctx, regs[inst.a]);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
        } else if op == Op::AssertCoercible {
            let v = regs[inst.a];
            if zjs_is_undefined(v) != 0 || zjs_is_null(v) != 0 {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Cannot destructure null or undefined", 36);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::ArrayRestFrom {
            // Destructuring `let [..., ...rest] = src` — build a fresh
            // array of src[c..length]. Non-array src yields an empty
            // array (matches `Array.from(src).slice(c)` for the common
            // array case; full iterator-protocol rest is a follow-up).
            let src_v = regs[inst.b];
            let start: u32 = (u32)inst.c;
            if zjs_is_array(src_v) != 0 {
                let s_arr = zjs_as_array(src_v);
                let rest_len: u32 = if s_arr.length > start { s_arr.length - start } else { 0 };
                let arr_v = ctx_new_array(ctx, rest_len);
                let arr = zjs_as_array(arr_v);
                let ri: u32 = 0;
                while ri < rest_len {
                    let v = s_arr.elements[start + ri];
                    if zjs_is_deleted(v) != 0 { v = zjs_undefined(); }
                    arr.elements[ri] = v;
                    ri = ri + 1;
                }
                arr.length = rest_len;
                regs[inst.a] = arr_v;
            } else {
                regs[inst.a] = ctx_new_array(ctx, 0);
            }
        } else if op == Op::IterPrepare {
            regs[inst.a] = iter_prepare(ctx, regs[inst.b], (u32)inst.c);
            if ctx.pending_throw_active {
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::ArrayLength {
            let src = regs[inst.b];
            if zjs_is_array(src) != 0 {
                let a = zjs_as_array(src);
                regs[inst.a] = zjs_int32((i32)a.length);
            } else {
                regs[inst.a] = zjs_int32(0);
            }
        }
        // else: unknown opcode — ignore (interpreter is permissive
        // during MVP; the compiler shouldn't emit such ops).

        // Pending-throw bridge is no longer per-instruction — each
        // opcode handler that can call a host helper checks
        // ctx.pending_throw_active inline (right after the helper
        // returns) and promotes it to a local throw. Keeping the hot
        // dispatch loop straight-line saves a memory load + branch per
        // instruction. The slow-path checks live in:
        //   - Op::Invoke / MethodInvoke / TailInvoke /
        //     TailMethodInvoke / NewInvoke (host-fn callee branch)
        //   - Op::Add / Sub / Mul / Div / Mod / Pow / AddImm-slow /
        //     SubImm-slow (after zjs_to_primitive)
        //   - Op::CmpEq / CmpNe / CmpLt / CmpLe / CmpGt / CmpGe
        //     and their *Imm slow paths
        //   - Op::Neg
        //   - Op::LoadProp / StoreProp / LoadElem / StoreElem
        //     (property accessors fire callbacks)

        ip = ip + 1;
        }   // end inner while ip < code_len

        // Inner loop exited. Decide why and how to handle.
        if exit_reason == 0 {
            // Ran off end of code — implicit return undefined.
            let f_top = ctx.frames[ctx.frame_count - 1].f;
            let async_outer = ctx.frames[ctx.frame_count - 1].outer_promise;
            let is_async_top = f_top != NULL && f_top.is_async && zjs_is_promise(async_outer) != 0;
            let implicit_rv: ZjsValue = zjs_undefined();
            // Generator implicit return: { value: undefined, done: true }.
            let gen_top = ctx.frames[ctx.frame_count - 1].generator;
            if f_top != NULL && f_top.is_generator && gen_top != NULL {
                gen_top.state = GEN_COMPLETED;
                implicit_rv = build_iter_result(ctx, zjs_undefined(), true);
            }
            if is_async_top {
                promise_resolve_with(ctx, async_outer, implicit_rv);
                implicit_rv = async_outer;
            }
            let ret_dst = pop_call_frame(ctx);
            if ctx.frame_count <= entry_frame {
                final_result = implicit_rv;
            } else if !is_async_top {
                let cidx = ctx.frame_count - 1;
                let cb = ctx.frames[cidx].regs_base;
                ctx.reg_stack[cb + (u32)ret_dst] = implicit_rv;
            }
        }
        // exit_reason == 1: Return/Halt already popped + wrote return value
        // exit_reason == 2: Invoke pushed a new frame — frame.ip saved before push
        // exit_reason == 3: throwing/thrown set — outer loop unwinds next iter
    }   // end outer while ctx.frame_count > entry_frame

    if throwing {
        return InterpretResult{ is_throw: true, value: thrown };
    }
    return InterpretResult{ is_throw: false, value: final_result };
}

// Invoke a JS-visible callable (Function | Closure | HostFunction) from
// host code. Used by Array.prototype.{map, forEach} to fire the user's
// callback. For MVP, an inner throw is dropped and `undefined` returned
// to the host — proper throw propagation across the host boundary is a
// future-work item (would need a ctx.pending_throw flag and a check in
// Op::MethodInvoke / Op::Invoke after each host call).
// ECMA-262 ToPrimitive(input, hint).
//
//  - `prefer_string = false` (the "number" or "default" hint): call
//    valueOf() first; if it returns a primitive, use it. Else call
//    toString().
//  - `prefer_string = true`: reverse the order.
//
// Returns input unchanged if it's already primitive. If neither
// valueOf nor toString returns a primitive, returns undefined
// (spec says TypeError; MVP falls back).
// True if `v` is any kind of object reference that requires ToPrimitive
// before numeric / string-comparison coercion: plain objects, arrays,
// and callable values (Function / Closure / HostFunction). Primitives
// (numbers, strings, bool, null, undefined) return 0.
fn is_object_like(v: ZjsValue) -> int {
    // Hot path: called from every Add / Sub / Mul / Mod / Pow opcode
    // to detect whether a ToPrimitive coercion is needed. Single
    // cell-tag load + chained `tag == TAG_X` compares — the C
    // compiler folds these into one indirect-branch dispatch instead
    // of 9 sequential `zjs_cell_tag` calls.
    let tag: u8 = zjs_cell_tag(v);
    if tag == TAG_OBJECT
       || tag == TAG_ARRAY
       || tag == TAG_FUNCTION
       || tag == TAG_CLOSURE
       || tag == TAG_HOST_FUNCTION
       || tag == TAG_DATE
       || tag == TAG_REGEXP
       || tag == TAG_MAP
       || tag == TAG_SET {
        return 1;
    }
    return 0;
}

// Read + clear the pending-throw bridge state. Called from each
// opcode handler that just executed a host helper which may have
// raised an exception (zjs_to_primitive, zjs_call_value, accessor
// get/set, etc.). Returns the thrown value; caller is responsible
// for setting throwing/exit_reason and breaking out of the inner
// loop. ctx.pending_throw_active should be checked separately.
fn consume_pending_throw(ctx: ZjsContext*) -> ZjsValue {
    let v = ctx.pending_throw_value;
    ctx.pending_throw_active = false;
    ctx.pending_throw_value  = zjs_undefined();
    return v;
}

fn zjs_to_primitive(ctx: ZjsContext*, v: ZjsValue, prefer_string: bool) -> ZjsValue {
    // ECMA-262 §7.1.1 OrdinaryToPrimitive. Host instance types (Date,
    // RegExp, Map, Set) are "object-like" per spec too — they have
    // toString/valueOf on their prototypes and `new Date() + ""`,
    // `+new Date()`, etc. must invoke those methods.
    if is_object_like(v) == 0 { return v; }

    // §7.1.1 step 4: look up Symbol.toPrimitive first. If callable,
    // it overrides the normal valueOf/toString dance. The hint string
    // is "string" / "number" / "default" per the caller's intent;
    // here we pass "string" when prefer_string is set and "default"
    // otherwise (callers that need a "number" hint should grow a
    // separate path — but the most common consumers, `==` and `+`,
    // both spec to "default" anyway).
    let toprim_key = ctx_intern_atom(ctx, (char*)"@@toPrimitive", 13);
    let toprim_fn = property_get(ctx, v, zjs_cell_from_ptr((void*)toprim_key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    // Spec §7.1.1 step 4 via GetMethod: undefined/null means "no
    // override, fall through to valueOf/toString"; anything else that
    // isn't callable is a TypeError. Without this check zjs silently
    // skipped malformed @@toPrimitive overrides instead of rejecting.
    let toprim_present = zjs_is_undefined(toprim_fn) == 0 && zjs_is_null(toprim_fn) == 0;
    let toprim_callable = zjs_is_function(toprim_fn) != 0
                          || zjs_is_closure(toprim_fn) != 0
                          || zjs_is_host_function(toprim_fn) != 0;
    if toprim_present && !toprim_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"@@toPrimitive is not callable", 29);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    if toprim_callable {
        let hint_str = if prefer_string {
            ctx_intern_string(ctx, (char*)"string", 6)
        } else {
            ctx_intern_string(ctx, (char*)"default", 7)
        };
        let argv_tp: ZjsValue*; let one: ZjsValue;
        one = hint_str;
        raw { argv_tp = &one; }
        let r = zjs_call_value_with_this(ctx, toprim_fn, v, argv_tp, 1);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r_objy: int = 0;
        if zjs_is_object(r) != 0 || zjs_is_array(r) != 0
           || zjs_is_function(r) != 0 || zjs_is_closure(r) != 0
           || zjs_is_host_function(r) != 0 { r_objy = 1; }
        if r_objy == 0 { return r; }
        // Spec: if Symbol.toPrimitive returns an object, throw TypeError.
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert object to primitive value", 40);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }

    let valueOf_atom  = ctx_intern_atom(ctx, (char*)"valueOf",  7);
    let toString_atom = ctx_intern_atom(ctx, (char*)"toString", 8);
    let first_atom: ZjsString*  = if prefer_string { toString_atom } else { valueOf_atom };
    let second_atom: ZjsString* = if prefer_string { valueOf_atom  } else { toString_atom };

    let argv: ZjsValue* = NULL;

    let m1 = property_get(ctx, v, zjs_cell_from_ptr((void*)first_atom));
    if zjs_is_function(m1) != 0 || zjs_is_closure(m1) != 0 || zjs_is_host_function(m1) != 0 {
        let r1 = zjs_call_value_with_this(ctx, m1, v, argv, 0);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r1_objy: int = 0;
        if zjs_is_object(r1) != 0 || zjs_is_array(r1) != 0
           || zjs_is_function(r1) != 0 || zjs_is_closure(r1) != 0
           || zjs_is_host_function(r1) != 0 { r1_objy = 1; }
        if r1_objy == 0 { return r1; }
    }
    let m2 = property_get(ctx, v, zjs_cell_from_ptr((void*)second_atom));
    if zjs_is_function(m2) != 0 || zjs_is_closure(m2) != 0 || zjs_is_host_function(m2) != 0 {
        let r2 = zjs_call_value_with_this(ctx, m2, v, argv, 0);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r2_objy: int = 0;
        if zjs_is_object(r2) != 0 || zjs_is_array(r2) != 0
           || zjs_is_function(r2) != 0 || zjs_is_closure(r2) != 0
           || zjs_is_host_function(r2) != 0 { r2_objy = 1; }
        if r2_objy == 0 { return r2; }
    }
    // ECMA-262 §7.1.1 step 8: neither method returned a primitive.
    // Raise a TypeError via the pending-throw bridge; the calling op
    // will promote it before the next instruction.
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"Cannot convert object to primitive value", 40);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value  = err;
    return zjs_undefined();
}

// Like zjs_call_value but explicitly binds `this`. Used by
// Function.prototype.{call, apply} to pass through a caller-chosen
// receiver. Unlike the plain helper, this does NOT clear
// ctx.host_this around host-function dispatch — the explicit
// `this_val` is the receiver the callee should see.
// Host-side equivalent of `new callee(...args)`. Mirrors the bytecode
// Op::NewInvoke path: lazily creates callee.prototype if absent,
// allocates a fresh ZjsObject with that proto, sets host_this +
// new_target_active + new_target_value, calls, then unwraps the result
// (Promise / Date / RegExp constructors hand back a special cell via
// host_this — preserve that even though the call returned undefined).
// Caller checks ctx.pending_throw_active for failure.
fn zjs_construct_value(ctx: ZjsContext*, callee: ZjsValue, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Validate constructable.
    let constructable: bool = false;
    if zjs_is_function(callee) != 0 || zjs_is_closure(callee) != 0 { constructable = true; }
    else if zjs_is_host_function(callee) != 0 {
        let hf_c = zjs_as_host_function(callee);
        constructable = hf_c.is_constructor;
    }
    if !constructable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"value is not a constructor", 26);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }

    // Resolve or lazily create the constructor's .prototype.
    let proto_obj: ZjsObject* = NULL;
    if zjs_is_function(callee) != 0 {
        let fp = zjs_cell_as_ptr(callee);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if f.prototype == NULL {
            let pv = ctx_new_object(ctx);
            f.prototype = zjs_as_object(pv);
            object_define_property_slot(ctx, f.prototype,
                ctx_intern_atom(ctx, (char*)"constructor", 11),
                callee, PROP_WRITABLE | PROP_CONFIGURABLE);
        }
        proto_obj = f.prototype;
    } else if zjs_is_closure(callee) != 0 {
        let cl = zjs_as_closure(callee);
        let fp2 = cl.function;
        let f2: Function* = NULL;
        raw { f2 = (Function*)fp2; }
        if f2.prototype == NULL {
            let pv = ctx_new_object(ctx);
            f2.prototype = zjs_as_object(pv);
            object_define_property_slot(ctx, f2.prototype,
                ctx_intern_atom(ctx, (char*)"constructor", 11),
                callee, PROP_WRITABLE | PROP_CONFIGURABLE);
        }
        proto_obj = f2.prototype;
    } else if zjs_is_host_function(callee) != 0 {
        let hf = zjs_as_host_function(callee);
        if hf.prototype == NULL {
            let pv = ctx_new_object(ctx);
            hf.prototype = zjs_as_object(pv);
            object_define_property_slot(ctx, hf.prototype,
                ctx_intern_atom(ctx, (char*)"constructor", 11),
                callee, PROP_WRITABLE | PROP_CONFIGURABLE);
        }
        proto_obj = hf.prototype;
    }

    let new_obj_v = ctx_new_object(ctx);
    let new_obj = zjs_as_object(new_obj_v);
    new_obj.proto = proto_obj;

    let saved_this = ctx.host_this;
    let saved_nt = ctx.new_target_active;
    let saved_ntv = ctx.new_target_value;
    ctx.host_this = new_obj_v;
    ctx.new_target_active = true;
    ctx.new_target_value = callee;

    let r = zjs_call_value_with_this(ctx, callee, new_obj_v, args, argc);

    let final_this = ctx.host_this;
    ctx.host_this = saved_this;
    ctx.new_target_active = saved_nt;
    ctx.new_target_value = saved_ntv;

    if ctx.pending_throw_active { return zjs_undefined(); }

    // If the constructor handed back an object/cell, use it. Otherwise
    // fall back to whatever host_this got rebound to (super(...) on a
    // Promise/RegExp etc.). Plain user ctors return undefined and
    // host_this is the new_obj we allocated.
    let rt: u8 = zjs_cell_tag(r);
    let result_is_object: bool =
        rt == TAG_OBJECT || rt == TAG_ARRAY || rt == TAG_PROMISE || rt == TAG_REGEXP
        || rt == TAG_FUNCTION || rt == TAG_CLOSURE || rt == TAG_HOST_FUNCTION
        || rt == TAG_MAP || rt == TAG_SET || rt == TAG_DATE || rt == TAG_UINT8_ARRAY
        || rt == TAG_TYPED_ARRAY || rt == TAG_ARRAY_BUFFER || rt == TAG_DATA_VIEW
        || rt == TAG_WEBSOCKET || rt == TAG_PROXY;
    if result_is_object { return r; }
    return final_this;
}

fn zjs_call_value_with_this(ctx: ZjsContext*, callee: ZjsValue, this_val: ZjsValue, args: ZjsValue*, argc: u32) -> ZjsValue {
    let saved = ctx.host_this;
    // Non-strict default: coerce undefined / null `this` to the global
    // object for user functions (matches OrdinaryCallBindThis step 6).
    // Host functions get the explicit this_val unchanged.
    if (zjs_is_undefined(this_val) != 0 || zjs_is_null(this_val) != 0)
       && (zjs_is_function(callee) != 0 || zjs_is_closure(callee) != 0)
       && ctx.global_this_obj != NULL {
        this_val = zjs_cell_from_ptr((void*)ctx.global_this_obj);
    }
    ctx.host_this = this_val;
    let r: ZjsValue = zjs_undefined();
    if zjs_is_function(callee) != 0 {
        let fp = zjs_cell_as_ptr(callee);
        let target: Function* = NULL;
        raw { target = (Function*)fp; }
        // Generator function: building the iterator is the entire
        // call. The body doesn't run until iter.next() — Op::Invoke
        // gates on this same flag.
        if target.is_generator {
            r = make_generator_iter(ctx, target, args, argc);
        } else {
            let rr = interpret(ctx, target, args, argc);
            if rr.is_throw {
                ctx.pending_throw_active = true;
                ctx.pending_throw_value  = rr.value;
            } else {
                r = rr.value;
            }
        }
    } else if zjs_is_closure(callee) != 0 {
        let cl = zjs_as_closure(callee);
        let fp2 = cl.function;
        let target2: Function* = NULL;
        raw { target2 = (Function*)fp2; }
        if target2.is_generator {
            r = make_generator_iter(ctx, target2, args, argc);
            zjs_as_generator(r).saved_current_closure = cl;
        } else {
            let saved_cl = ctx.current_closure;
            ctx.current_closure = cl;
            let rr = interpret(ctx, target2, args, argc);
            ctx.current_closure = saved_cl;
            if rr.is_throw {
                ctx.pending_throw_active = true;
                ctx.pending_throw_value  = rr.value;
            } else {
                r = rr.value;
            }
        }
    } else if zjs_is_host_function(callee) != 0 {
        let hf_ptr = zjs_cell_as_ptr(callee);
        let saved_host_fn = ctx.current_host_fn;
        ctx.current_host_fn = hf_ptr;
        raw {
            ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
            typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
            HostFn fp = (HostFn)hf->fn_ptr;
            r = fp(ctx, args, argc);
        }
        ctx.current_host_fn = saved_host_fn;
    }
    ctx.host_this = saved;
    return r;
}

fn zjs_call_value(ctx: ZjsContext*, callee: ZjsValue, args: ZjsValue*, argc: u32) -> ZjsValue {
    if zjs_is_function(callee) != 0 {
        let fp = zjs_cell_as_ptr(callee);
        let target: Function* = NULL;
        raw { target = (Function*)fp; }
        if target.is_generator {
            return make_generator_iter(ctx, target, args, argc);
        }
        let r = interpret(ctx, target, args, argc);
        if r.is_throw {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = r.value;
            return zjs_undefined();
        }
        return r.value;
    }
    if zjs_is_closure(callee) != 0 {
        let cl = zjs_as_closure(callee);
        let fp2 = cl.function;
        let target2: Function* = NULL;
        raw { target2 = (Function*)fp2; }
        if target2.is_generator {
            let g = make_generator_iter(ctx, target2, args, argc);
            zjs_as_generator(g).saved_current_closure = cl;
            return g;
        }
        let saved_cl = ctx.current_closure;
        ctx.current_closure = cl;
        let r2 = interpret(ctx, target2, args, argc);
        ctx.current_closure = saved_cl;
        if r2.is_throw {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = r2.value;
            return zjs_undefined();
        }
        return r2.value;
    }
    if zjs_is_host_function(callee) != 0 {
        let hf_ptr = zjs_cell_as_ptr(callee);
        let r: ZjsValue = zjs_undefined();
        let saved_this = ctx.host_this;
        ctx.host_this = zjs_undefined();
        raw {
            ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
            typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
            HostFn fp = (HostFn)hf->fn_ptr;
            r = fp(ctx, args, argc);
        }
        ctx.host_this = saved_this;
        return r;
    }
    return zjs_undefined();
}
