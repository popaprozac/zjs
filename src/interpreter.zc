                    // The compiler emits Op::GeneratorStart at the end
                    // of the prologue, which captures state into a
                    // fresh generator and unwinds back here.
                    let gen = zjs_generator_new();
                    ctx_register_cell(ctx, (void*)gen);
                    gen.function = target;
                    gen.reg_count = target.register_count;
                    gen.state = GEN_STARTING;
                    gen.is_async = target.is_async;
                    gen.saved_host_this = new_this;
                    ctx.frames[cur_idx].ip = ip + 1;
                    push_call_frame_inplace(ctx, target, regs_base + (u32)base + 2, argc, dst);
