                let buf: char[16];
                let blen: int = 0;
                raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)(uint32_t)i); }
                let bp: char* = NULL; raw { bp = &buf[0]; }
                let key_atom = ctx_intern_atom(ctx, bp, (u32)blen);
                let slot_p = class_find_slot(arr.props.cls, key_atom);
                if slot_p >= 0 {
