// Interpreter — executes a compiled Function and returns its result.
//
// Phase 3.0a: simple `while` + per-op `if` chain. Hermes-style
// computed-goto dispatch is the eventual target (see design study),
// but the per-op handlers are small and the bottleneck for a non-JIT
// engine isn't the dispatch primitive itself — it's value-rep,
// inline caches, hidden classes. Those are bigger lifts we'll attack
// later. The structure here is intentionally trivial to keep
// debugging the FIRST end-to-end execution path easy.

import "./value.zc";
import "./bytecode.zc";
import "./context.zc";
import "std/mem.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
}

// =====================================================================
// Generic property get/set. Dispatches on the object's cell tag, with
// arrays getting a numeric-index fast path and a special-case "length"
// reader.
// =====================================================================

fn property_get(ctx: ZjsContext*, obj: ZjsValue, key: ZjsValue) -> ZjsValue {
    // Array: integer index OR "length", with prototype-method fallback.
    if zjs_is_array(obj) != 0 {
        let arr = zjs_as_array(obj);
        // Fast int path
        if zjs_is_int32(key) != 0 {
            let i = zjs_as_int32(key);
            if i >= 0 { return array_get(arr, (u32)i); }
            return zjs_undefined();
        }
        // .length
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let is_length: int = 0;
            let kdata = ks.data;
            let klen  = ks.length;
            raw {
                is_length = (klen == 6 && memcmp(kdata, "length", 6) == 0) ? 1 : 0;
            }
            if is_length != 0 { return zjs_int32((i32)arr.length); }
            // String-coerced numeric index
            let idx = zjs_to_array_index(key);
            if idx >= 0 { return array_get(arr, (u32)idx); }
            // Expando bag (e.g. `let a = []; a.foo = 1;`) before
            // falling through to Array.prototype methods.
            if arr.props != NULL {
                let slot_p = class_find_slot(arr.props.cls, ks);
                if slot_p >= 0 {
                    let v = arr.props.slots[(u32)slot_p];
                    if zjs_is_deleted(v) == 0 { return v; }
                }
            }
            // Walk array_proto then its chain (so hasOwnProperty from
            // object_proto is reachable).
            let cur = ctx.array_proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 { return cur.slots[(u32)slot]; }
                cur = cur.proto;
            }
            return zjs_undefined();
        }
        // Anything else: try ToIndex
        let idx2 = zjs_to_array_index(key);
        if idx2 >= 0 { return array_get(arr, (u32)idx2); }
        return zjs_undefined();
    }

    // String primitive: .length + indexed chars + prototype-method intercept.
    if zjs_is_string(obj) != 0 {
        // Integer index → single-char string. Out-of-range → undefined.
        if zjs_is_int32(key) != 0 {
            let s = zjs_as_string(obj);
            let i = zjs_as_int32(key);
            if i >= 0 && (u32)i < s.length {
                let sd = s.data;
                let off = (u32)i;
                return ctx_intern_string(ctx, sd + off, 1);
            }
            return zjs_undefined();
        }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kdata = ks.data;
            let klen  = ks.length;
            let is_length: int = 0;
            raw {
                is_length = (klen == 6 && memcmp(kdata, "length", 6) == 0) ? 1 : 0;
            }
            if is_length != 0 {
                let s = zjs_as_string(obj);
                return zjs_int32((i32)s.length);
            }
            // Walk string_proto + chain (for object_proto methods like
            // hasOwnProperty).
            let cur = ctx.string_proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 { return cur.slots[(u32)slot]; }
                cur = cur.proto;
            }
        }
        return zjs_undefined();
    }

    // Object: ToString key, linear lookup, then walk proto chain.
    if zjs_is_object(obj) != 0 {
        let o = zjs_as_object(obj);
        let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
        let name = zjs_as_string(key_str_val);
        let cur = o;
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let v = cur.slots[(u32)slot];
                // A DELETED-sentinel slot acts like the property
                // doesn't exist — keep walking the proto chain.
                if zjs_is_deleted(v) == 0 {
                    // Accessor (Phase 3.9b)? Invoke get with this=obj.
                    if zjs_is_accessor(v) != 0 {
                        let acc = zjs_as_accessor(v);
                        let g = acc.get;
                        if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
                            let nullp: ZjsValue* = NULL;
                            return zjs_call_value_with_this(ctx, g, obj, nullp, 0);
                        }
                        return zjs_undefined();
                    }
                    return v;
                }
            }
            cur = cur.proto;
        }
        // Primitive-wrapper fallback: if `o` carries a hidden
        // WRAPPER_VALUE_KEY pointing to a wrapped primitive, route
        // indexed reads and "length" to that primitive. Makes
        // `Array.prototype.forEach.call("abc", ...)` see length=3
        // and obj[i] = "a"/"b"/"c" after the implicit ToObject.
        let wclass: ZjsHiddenClass* = o.cls;
        while wclass != NULL {
            let wn = wclass.transition_name;
            if wn != NULL && wn.length == WRAPPER_VALUE_KEY_LEN {
                let wnd = wn.data;
                let weq: int = 0;
                raw { weq = (memcmp(wnd, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN) == 0) ? 1 : 0; }
                if weq != 0 {
                    let prim = o.slots[wclass.transition_slot];
                    if zjs_is_string(prim) != 0 {
                        return property_get(ctx, prim, key);
                    }
                    break;
                }
            }
            wclass = wclass.parent;
        }
        return zjs_undefined();
    }

    // Function: .prototype lazy-creates an object on first read.
    // Also serves .call and .apply via the cached host helpers, plus
    // Object.prototype methods (toString / valueOf / hasOwnProperty).
    if zjs_is_function(obj) != 0 {
        // Numeric / other keys ToString — `fn[0]` reads from the
        // expando bag at key "0" alongside named props.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_proto:  int = 0;
            let is_call:   int = 0;
            let is_apply:  int = 0;
            let is_length: int = 0;
            raw {
                is_proto  = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0;
                is_call   = (kn == 4 && memcmp(kd, "call",      4) == 0) ? 1 : 0;
                is_apply  = (kn == 5 && memcmp(kd, "apply",     5) == 0) ? 1 : 0;
                is_length = (kn == 6 && memcmp(kd, "length",    6) == 0) ? 1 : 0;
            }
            if is_proto != 0 {
                let fp = zjs_cell_as_ptr(obj);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.prototype == NULL {
                    let proto_v = ctx_new_object(ctx);
                    f.prototype = zjs_as_object(proto_v);
                }
                return zjs_cell_from_ptr((void*)f.prototype);
            }
            if is_call   != 0 { return ctx.fn_call_v; }
            if is_apply  != 0 { return ctx.fn_apply_v; }
            if is_length != 0 {
                let fp = zjs_cell_as_ptr(obj);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                return zjs_int32((i32)f.param_count);
            }
            // Expando bag — fires before Object.prototype so user-set
            // properties shadow inherited methods (`fn.toString = ...`
            // wins over Object.prototype.toString). Mirrors how host
            // functions and arrays carry a lazy props object.
            let fp_p = zjs_cell_as_ptr(obj);
            let f_p: Function* = NULL;
            raw { f_p = (Function*)fp_p; }
            if f_p.props != NULL {
                let pv = object_get(f_p.props, ks);
                if zjs_is_undefined(pv) == 0 { return pv; }
            }
            if ctx.object_proto != NULL {
                let cur = ctx.object_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
        }
        return zjs_undefined();
    }
    // Closure: same .call / .apply behavior.
    if zjs_is_closure(obj) != 0 {
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_call:  int = 0;
            let is_apply: int = 0;
            raw {
                is_call  = (kn == 4 && memcmp(kd, "call",  4) == 0) ? 1 : 0;
                is_apply = (kn == 5 && memcmp(kd, "apply", 5) == 0) ? 1 : 0;
            }
            if is_call  != 0 { return ctx.fn_call_v; }
            if is_apply != 0 { return ctx.fn_apply_v; }
            if ctx.object_proto != NULL {
                let cur = ctx.object_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
        }
        return zjs_undefined();
    }

    // Host function: .prototype (lazy), .call / .apply, .length, .name, then .props.
    if zjs_is_host_function(obj) != 0 {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_proto: int = 0;
            let is_call:  int = 0;
            let is_apply: int = 0;
            let is_length: int = 0;
            let is_name:   int = 0;
            raw {
                is_proto  = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0;
                is_call   = (kn == 4 && memcmp(kd, "call",      4) == 0) ? 1 : 0;
                is_apply  = (kn == 5 && memcmp(kd, "apply",     5) == 0) ? 1 : 0;
                is_length = (kn == 6 && memcmp(kd, "length",    6) == 0) ? 1 : 0;
                is_name   = (kn == 4 && memcmp(kd, "name",      4) == 0) ? 1 : 0;
            }
            let hf = zjs_as_host_function(obj);
            if is_proto != 0 {
                if hf.prototype == NULL {
                    let proto_v = ctx_new_object(ctx);
                    hf.prototype = zjs_as_object(proto_v);
                }
                return zjs_cell_from_ptr((void*)hf.prototype);
            }
            if is_call  != 0 { return ctx.fn_call_v; }
            if is_apply != 0 { return ctx.fn_apply_v; }
            // ECMA-262 §10.2.4: every built-in function exposes a
            // `length` (param count). We don't track the C function's
            // arity yet, so report 0 — enough to satisfy "the property
            // exists" tests. `name` echoes the host fn's display name.
            if is_length != 0 { return zjs_int32((i32)hf.arity); }
            if is_name != 0 {
                if hf.name == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
                let n_len: usize = 0;
                raw { n_len = strlen(hf->name); }
                return ctx_intern_string(ctx, hf.name, (u32)n_len);
            }
            if hf.props != NULL {
                let pv = object_get(hf.props, ks);
                if zjs_is_undefined(pv) == 0 { return pv; }
            }
            // Fall back through Object.prototype so methods like
            // hasOwnProperty / toString / valueOf are reachable on a
            // host function the same way they are on a plain object.
            if ctx.object_proto != NULL {
                let cur = ctx.object_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
        }
        return zjs_undefined();
    }

    // Promise cell — read through Promise.prototype (then / catch).
    if zjs_is_promise(obj) != 0 && ctx.promise_ctor_proto != NULL && zjs_is_string(key) != 0 {
        let cur = ctx.promise_ctor_proto;
        let ks = zjs_as_string(key);
        while cur != NULL {
            let slot = class_find_slot(cur.cls, ks);
            if slot >= 0 { return cur.slots[(u32)slot]; }
            cur = cur.proto;
        }
        return zjs_undefined();
    }

    // RegExp cell — `.source`, `.flags`, `.global`, `.ignoreCase`,
    // `.multiline`, `.lastIndex` are read from the cell; everything
    // else (test, exec, ...) flows through RegExp.prototype.
    if zjs_is_regexp(obj) != 0 {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let r = zjs_as_regexp(obj);
        let ks = zjs_as_string(key);
        let kd = ks.data;
        let kn = ks.length;
        let is_source: int = 0;
        let is_flags:  int = 0;
        let is_global: int = 0;
        let is_icase:  int = 0;
        let is_mline:  int = 0;
        let is_sticky: int = 0;
        let is_dotall: int = 0;
        let is_last:   int = 0;
        raw {
            is_source = (kn == 6  && memcmp(kd, "source",     6)  == 0) ? 1 : 0;
            is_flags  = (kn == 5  && memcmp(kd, "flags",      5)  == 0) ? 1 : 0;
            is_global = (kn == 6  && memcmp(kd, "global",     6)  == 0) ? 1 : 0;
            is_icase  = (kn == 10 && memcmp(kd, "ignoreCase", 10) == 0) ? 1 : 0;
            is_mline  = (kn == 9  && memcmp(kd, "multiline",  9)  == 0) ? 1 : 0;
            is_sticky = (kn == 6  && memcmp(kd, "sticky",     6)  == 0) ? 1 : 0;
            is_dotall = (kn == 6  && memcmp(kd, "dotAll",     6)  == 0) ? 1 : 0;
            is_last   = (kn == 9  && memcmp(kd, "lastIndex",  9)  == 0) ? 1 : 0;
        }
        if is_source != 0 {
            if r.source == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
            return zjs_cell_from_ptr((void*)r.source);
        }
        if is_flags != 0 {
            if r.flags_str == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
            return zjs_cell_from_ptr((void*)r.flags_str);
        }
        if is_global != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_GLOBAL)      != 0 { 1 } else { 0 }); }
        if is_icase  != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_IGNORE_CASE) != 0 { 1 } else { 0 }); }
        if is_mline  != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_MULTILINE)   != 0 { 1 } else { 0 }); }
        if is_sticky != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_STICKY)      != 0 { 1 } else { 0 }); }
        if is_dotall != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_DOTALL)      != 0 { 1 } else { 0 }); }
        if is_last   != 0 { return zjs_int32((i32)r.last_index); }
        // Expando bag — user-set keys win over inherited methods.
        if r.props != NULL {
            let pv = object_get(r.props, ks);
            if zjs_is_undefined(pv) == 0 { return pv; }
        }
        // Methods + everything else through the prototype.
        if ctx.regexp_proto != NULL {
            let cur = ctx.regexp_proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 {
                    let v = cur.slots[(u32)slot];
                    if zjs_is_deleted(v) == 0 { return v; }
                }
                cur = cur.proto;
            }
        }
        return zjs_undefined();
    }

    // Primitive proto walks. ECMA-262 ToObject for property access on
    // a primitive yields a wrapper whose prototype carries valueOf /
    // toString / etc. We don't actually wrap; just walk the matching
    // global's prototype directly — same observable result for read.
    if zjs_is_string(key) != 0 {
        let proto: ZjsObject* = NULL;
        if zjs_is_bool(obj) != 0 {
            let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
            if bool_g >= 0 {
                let bv = ctx.globals[bool_g].value;
                if zjs_is_host_function(bv) != 0 { proto = zjs_as_host_function(bv).prototype; }
            }
        } else if zjs_is_int32(obj) != 0 || zjs_is_double(obj) != 0 {
            let num_g = ctx_find_global(ctx, (char*)"Number", 6);
            if num_g >= 0 {
                let nv = ctx.globals[num_g].value;
                if zjs_is_host_function(nv) != 0 { proto = zjs_as_host_function(nv).prototype; }
            }
        }
        if proto != NULL {
            let ks = zjs_as_string(key);
            let cur = proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 {
                    let pv = cur.slots[(u32)slot];
                    if zjs_is_deleted(pv) == 0 { return pv; }
                }
                cur = cur.proto;
            }
        }
    }
    return zjs_undefined();
}

fn property_set(ctx: ZjsContext*, obj: ZjsValue, key: ZjsValue, value: ZjsValue) -> void {
    if zjs_is_array(obj) != 0 {
        let arr = zjs_as_array(obj);
        if zjs_is_int32(key) != 0 {
            let i = zjs_as_int32(key);
            if i >= 0 { array_set(arr, (u32)i, value); }
            return;
        }
        let idx = zjs_to_array_index(key);
        if idx >= 0 { array_set(arr, (u32)idx, value); return; }
        // `arr.length = n` truncates / extends the array. ECMA-262
        // §22.1.4.1: assigning a non-integer or non-finite value throws
        // RangeError; we coerce-to-int and silently accept for MVP. The
        // important behavioral piece is that subsequent reads of length
        // and indexed slots reflect the new length.
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let is_length: int = 0;
            let kdata = ks.data;
            let klen  = ks.length;
            raw { is_length = (klen == 6 && memcmp(kdata, "length", 6) == 0) ? 1 : 0; }
            if is_length != 0 {
                let new_len: u32 = 0;
                if zjs_is_int32(value) != 0 {
                    let n = zjs_as_int32(value);
                    if n >= 0 { new_len = (u32)n; }
                } else if zjs_is_double(value) != 0 {
                    let d = zjs_as_double(value);
                    let ok: int = 0;
                    raw { ok = (isfinite(d) && d >= 0.0) ? 1 : 0; }
                    if ok != 0 { new_len = (u32)d; }
                }
                // Truncation: mark the dropped slots as holes so a
                // later length extension reveals them as absent, not
                // as undefined values.
                let old_len = arr.length;
                if new_len < old_len {
                    let i: u32 = new_len;
                    let hole = zjs_deleted();
                    while i < old_len {
                        arr.elements[i] = hole;
                        i = i + 1;
                    }
                }
                arr.length = new_len;
                return;
            }
        }
        // Other string-keyed properties: stash on the lazy expando bag
        // so `[].foo = 1` is visible to property_get, Object.keys-like
        // walks, and Object.create's descriptor walk.
        if zjs_is_string(key) != 0 {
            if arr.props == NULL {
                let pv = ctx_new_object(ctx);
                arr.props = zjs_as_object(pv);
            }
            object_set(ctx, arr.props, zjs_as_string(key), value);
        }
        return;
    }
    if zjs_is_object(obj) != 0 {
        let o = zjs_as_object(obj);
        let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
        let name = zjs_as_string(key_str_val);
        // Walk the proto chain looking for an accessor whose setter
        // should fire (Phase 3.9b). A data property on the proto means
        // we'll shadow via an own write. A DELETED slot is invisible.
        let cur = o;
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let v = cur.slots[(u32)slot];
                if zjs_is_deleted(v) == 0 {
                    if zjs_is_accessor(v) != 0 {
                        let acc = zjs_as_accessor(v);
                        let s = acc.set;
                        if zjs_is_function(s) != 0 || zjs_is_closure(s) != 0 || zjs_is_host_function(s) != 0 {
                            let arr: ZjsValue[1];
                            arr[0] = value;
                            let argp: ZjsValue* = NULL;
                            raw { argp = &arr[0]; }
                            let _ = zjs_call_value_with_this(ctx, s, obj, argp, 1);
                        }
                        return;
                    }
                    cur = NULL;     // data property — fall through and write our own
                } else {
                    cur = cur.proto;
                }
            } else {
                cur = cur.proto;
            }
        }
        object_set(ctx, o, name, value);
        return;
    }
    // Function: `.prototype` updates the prototype slot (Phase 3.6),
    // anything else lands on the lazy props bag — same shape as host
    // functions and array expandos. Unlocks the standard idiom
    // `fn.cnt = 0; fn.cnt++` and the test262 harness pattern
    // (`assert.sameValue = function (...) { ... }`).
    if zjs_is_function(obj) != 0 {
        // Coerce non-string keys (numeric indices, ToString'd) — these
        // can show up via `fn[0] = true` patterns that the test262
        // generic-array-on-fn tests exercise.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let ks = zjs_as_string(key);
        let is_proto: int = 0;
        let kd = ks.data;
        let kn = ks.length;
        raw { is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0; }
        let fp = zjs_cell_as_ptr(obj);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if is_proto != 0 && zjs_is_object(value) != 0 {
            f.prototype = zjs_as_object(value);
            return;
        }
        // `.prototype = non-object` is a no-op in MVP (spec coerces /
        // ignores per writable=false in some envs); preserve that.
        if is_proto != 0 { return; }
        if f.props == NULL {
            let pv = ctx_new_object(ctx);
            f.props = zjs_as_object(pv);
        }
        object_set(ctx, f.props, ks, value);
        return;
    }
    if zjs_is_host_function(obj) != 0 {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let ks = zjs_as_string(key);
        let is_proto: int = 0;
        let kd = ks.data;
        let kn = ks.length;
        raw { is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0; }
        let hf = zjs_as_host_function(obj);
        if is_proto != 0 && zjs_is_object(value) != 0 {
            hf.prototype = zjs_as_object(value);
            return;
        }
        // Arbitrary property — lazily create the props object.
        if hf.props == NULL {
            let pv = ctx_new_object(ctx);
            hf.props = zjs_as_object(pv);
        }
        object_set(ctx, hf.props, ks, value);
        return;
    }
    if zjs_is_regexp(obj) != 0 {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let r = zjs_as_regexp(obj);
        let ks = zjs_as_string(key);
        let kd = ks.data;
        let kn = ks.length;
        let is_last: int = 0;
        raw { is_last = (kn == 9 && memcmp(kd, "lastIndex", 9) == 0) ? 1 : 0; }
        if is_last != 0 {
            // ToInteger-ish: only int / non-negative-double accepted;
            // anything else clamps to 0 (matches our MVP coercion).
            if zjs_is_int32(value) != 0 {
                let n = zjs_as_int32(value);
                if n < 0 { r.last_index = 0; } else { r.last_index = (u32)n; }
            } else if zjs_is_double(value) != 0 {
                let d = zjs_as_double(value);
                if d >= 0.0 { r.last_index = (u32)d; } else { r.last_index = 0; }
            } else {
                r.last_index = 0;
            }
            return;
        }
        // Other keys (including `source`, `flags`, etc.) land on the
        // expando bag — spec treats those as non-writable own
        // properties, but until we model the read-only attribute on
        // built-in slots, the expando layer hides them.
        if r.props == NULL {
            let pv = ctx_new_object(ctx);
            r.props = zjs_as_object(pv);
        }
        object_set(ctx, r.props, ks, value);
        return;
    }
    // Primitives: silently ignored (real JS throws in strict mode).
}

// Result of an interpret() call. `is_throw=true` means an exception
// escaped this function — the caller (a Phase 3.1c+ try frame in the
// outer function, or zjs_eval) decides whether to catch or propagate.
struct InterpretResult {
    is_throw: bool;
    value:    ZjsValue;
}

impl Copy for InterpretResult {}

struct TryFrame {
    catch_ip:  usize;
    catch_reg: u8;
}

def MAX_TRY_DEPTH: usize = 32;

fn interpret(ctx: ZjsContext*, entry_f: Function*, args: ZjsValue*, arg_count: u32) -> InterpretResult {
    if entry_f == NULL { return InterpretResult{ is_throw: false, value: zjs_undefined() }; }

    // Phase 3.9h: non-recursive JS-to-JS calls. We push an initial
    // CallFrame for the entry function, then the outer loop runs as
    // long as there are frames above the entry depth. Op::Invoke
    // pushes a new frame (instead of recursing into interpret), and
    // Op::Return pops + writes the return value into the caller's
    // register slot.
    //
    // Host functions still call interpret() recursively (via
    // zjs_call_value). Each recursive entry captures its own
    // `entry_frame` so its outer loop only walks the frames it
    // pushed — frames from a host caller's outer interpret() are
    // invisible to this one.
    let entry_frame: u32 = ctx.frame_count;
    push_call_frame(ctx, entry_f, args, arg_count, 0);
    defer pop_call_frames_to(ctx, entry_frame);

    let throwing:    bool     = false;
    let thrown:      ZjsValue = zjs_undefined();
    let final_result: ZjsValue = zjs_undefined();

    // ---------- Outer loop ----------
    while ctx.frame_count > entry_frame {
        // Throw unwinding runs BEFORE we re-enter the inner loop for a
        // frame. If the current top frame has a matching try-handler we
        // jump to its catch site; otherwise we pop the top frame and
        // loop again (eventually returning is_throw to the caller if no
        // frame catches).
        if throwing {
            // Discard try frames that belong to already-popped frames
            // (defensive; pop_call_frame should have done this already
            // via try_depth_at_entry).
            while ctx.ctx_try_depth > 0
                && ctx.ctx_try_stack[ctx.ctx_try_depth - 1].frame_index >= ctx.frame_count {
                ctx.ctx_try_depth = ctx.ctx_try_depth - 1;
            }
            let top_idx: u32 = ctx.frame_count - 1;
            let caught: bool = false;
            if ctx.ctx_try_depth > 0 {
                let td = ctx.ctx_try_depth - 1;
                if ctx.ctx_try_stack[td].frame_index == top_idx {
                    let regs_base_c = ctx.frames[top_idx].regs_base;
                    let catch_reg_c = (u32)ctx.ctx_try_stack[td].catch_reg;
                    ctx.frames[top_idx].ip = ctx.ctx_try_stack[td].catch_ip;
                    ctx.reg_stack[regs_base_c + catch_reg_c] = thrown;
                    ctx.ctx_try_depth = td;
                    throwing = false;
                    caught = true;
                }
            }
            if !caught {
                pop_call_frame(ctx);
                continue;
            }
        }

        // Hoist top-frame fields into locals for the inner loop. After
        // any frame push/pop the cached `regs` / `frame_ptr` would
        // dangle, so we always invalidate by breaking out of the inner
        // loop on Invoke/Return/Throw.
        let cur_idx: u32 = ctx.frame_count - 1;
        let f: Function* = ctx.frames[cur_idx].f;
        let code = f.code;
        let code_len = f.code_len;
        let regs_base = ctx.frames[cur_idx].regs_base;
        let regs: ZjsValue* = NULL;
        raw { regs = &ctx->reg_stack[regs_base]; }
        let ip: usize = ctx.frames[cur_idx].ip;

        // Inner-loop exit reason:
        //   0 = ran off code_len (implicit return undefined)
        //   1 = Op::Return / Op::Halt (frame already popped + return value written)
        //   2 = Invoke pushed a new frame (frame.ip saved before push)
        //   3 = throw raised (throwing/thrown set; outer loop handles)
        let exit_reason: int = 0;

        while ip < code_len {
        // GC safe-points are NOT at every instruction (the load+compare
        // alone costs 15-25% on hot loops). Instead we poll at:
        //   - backward Op::Jmp (loop heads), below
        //   - Op::Invoke / MethodInvoke / Return (call boundaries), inline
        //   - allocation opcodes (NewObject/Array/Closure) — fold the
        //     check into their handlers if/when allocation pressure
        //     dominates GC liveness.
        // Straight-line arithmetic never allocates, so skipping the
        // poll there is safe.

        // Throw unwinding now happens in the OUTER loop, before
        // re-entering this inner loop — see the top of the outer while.

        let inst = code[ip];
        let op = inst.op;

        if op == Op::Return {
            // GC safe-point on the way out — only the return value
            // survives the frame.
            if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
            let rv = regs[inst.a];
            let ret_dst = pop_call_frame(ctx);
            if ctx.frame_count <= entry_frame {
                final_result = rv;
            } else {
                // Write into the caller's reg via index (regs/frame_ptr
                // are now invalidated by the pop).
                let cidx = ctx.frame_count - 1;
                let cb = ctx.frames[cidx].regs_base;
                ctx.reg_stack[cb + (u32)ret_dst] = rv;
            }
            exit_reason = 1;
            break;
        }
        if op == Op::Halt {
            // Halt aborts the entire interpret() entry — pop everything
            // back to entry depth, return undefined.
            pop_call_frames_to(ctx, entry_frame);
            final_result = zjs_undefined();
            exit_reason = 1;
            break;
        }

        if op == Op::LoadInt {
            regs[inst.a] = zjs_int32((i32)inst_bc_i16(inst));
        } else if op == Op::LoadConst {
            regs[inst.a] = f.constants[inst_bc_u16(inst)];
        } else if op == Op::LoadUndefined {
            regs[inst.a] = zjs_undefined();
        } else if op == Op::LoadNull {
            regs[inst.a] = zjs_null();
        } else if op == Op::LoadTrue {
            regs[inst.a] = zjs_bool(1);
        } else if op == Op::LoadFalse {
            regs[inst.a] = zjs_bool(0);
        } else if op == Op::Mov {
            regs[inst.a] = regs[inst.b];

        // --- globals --------------------------------------------
        } else if op == Op::DefineGlobal {
            let slot = inst_bc_u16(inst);
            ctx.globals[slot].value = regs[inst.a];
            ctx.globals[slot].defined = true;
        } else if op == Op::LoadGlobal {
            let slot = inst_bc_u16(inst);
            if !ctx.globals[slot].defined {
                let nm = ctx.globals[slot].name;
                let nl = ctx.globals[slot].name_len;
                let err = build_reference_error(ctx, nm, nl);
                throwing = true; thrown = err; exit_reason = 3; break;
            }
            regs[inst.a] = ctx.globals[slot].value;
        } else if op == Op::LoadGlobalOrUndefined {
            let slot = inst_bc_u16(inst);
            if !ctx.globals[slot].defined {
                regs[inst.a] = zjs_undefined();
            } else {
                regs[inst.a] = ctx.globals[slot].value;
            }
        } else if op == Op::StoreGlobal {
            let slot = inst_bc_u16(inst);
            ctx.globals[slot].value = regs[inst.a];
            ctx.globals[slot].defined = true;

        // --- arithmetic -----------------------------------------
        } else if op == Op::Add {
            // ECMA-262: ToPrimitive both operands with hint "default"
            // (= "number" for non-Date). If either is a string after
            // coercion, concatenate; else numeric add. Skip the
            // ToPrimitive + pending-throw machinery entirely when both
            // operands are primitives (the common case) so the hot path
            // stays branch-light. ToPrimitive(lhs) runs strictly before
            // ToPrimitive(rhs) per spec — check pending after each call
            // so a thrown value from the LHS isn't overwritten by the RHS.
            let av = regs[inst.b];
            let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            if zjs_is_string(av) != 0 || zjs_is_string(bv) != 0 {
                regs[inst.a] = zjs_string_concat(ctx, av, bv);
            } else {
                regs[inst.a] = zjs_arith_add(av, bv);
            }
        } else if op == Op::Sub {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_arith_sub(av, bv);
        } else if op == Op::AddImm {
            // Fused int32 + i8 fast path; falls back to full Add semantics
            // (object → ToPrimitive, string concat) on cold paths.
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                let ai: i64 = (i64)zjs_as_int32(av);
                let sum: i64 = ai + (i64)imm;
                let fits: int = 0;
                raw { fits = (sum >= INT32_MIN && sum <= INT32_MAX) ? 1 : 0; }
                if fits != 0 {
                    regs[inst.a] = zjs_int32((i32)sum);
                } else {
                    regs[inst.a] = zjs_double((f64)sum);
                }
            } else {
                // Slow fallback: re-do as a real Add (handles strings,
                // objects, doubles, etc.).
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_string(av) != 0 {
                    regs[inst.a] = zjs_string_concat(ctx, av, bv);
                } else {
                    regs[inst.a] = zjs_arith_add(av, bv);
                }
            }
        } else if op == Op::SubImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                let ai: i64 = (i64)zjs_as_int32(av);
                let diff: i64 = ai - (i64)imm;
                let fits: int = 0;
                raw { fits = (diff >= INT32_MIN && diff <= INT32_MAX) ? 1 : 0; }
                if fits != 0 {
                    regs[inst.a] = zjs_int32((i32)diff);
                } else {
                    regs[inst.a] = zjs_double((f64)diff);
                }
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                regs[inst.a] = zjs_arith_sub(av, bv);
            }
        } else if op == Op::CmpLtImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) < imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                regs[inst.a] = zjs_bool(zjs_cmp_lt(av, bv));
            }
        } else if op == Op::CmpLeImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) <= imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                regs[inst.a] = zjs_bool(zjs_cmp_le(av, bv));
            }
        } else if op == Op::CmpGtImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) > imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                // a > b is `b < a` (CmpGt's actual semantics — order swap).
                regs[inst.a] = zjs_bool(zjs_cmp_lt(bv, av));
            }
        } else if op == Op::CmpGeImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) >= imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                regs[inst.a] = zjs_bool(zjs_cmp_le(bv, av));
            }
        } else if op == Op::Mul {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_arith_mul(av, bv);
        } else if op == Op::Div {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_arith_div(av, bv);
        } else if op == Op::Mod {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_arith_mod(av, bv);
        } else if op == Op::Pow {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_arith_pow(av, bv);

        // --- bitwise --------------------------------------------
        } else if op == Op::BitAnd {
            regs[inst.a] = zjs_bit_and(regs[inst.b], regs[inst.c]);
        } else if op == Op::BitOr {
            regs[inst.a] = zjs_bit_or(regs[inst.b], regs[inst.c]);
        } else if op == Op::BitXor {
            regs[inst.a] = zjs_bit_xor(regs[inst.b], regs[inst.c]);
        } else if op == Op::Shl {
            regs[inst.a] = zjs_shl(regs[inst.b], regs[inst.c]);
        } else if op == Op::Shr {
            regs[inst.a] = zjs_shr(regs[inst.b], regs[inst.c]);
        } else if op == Op::UShr {
            regs[inst.a] = zjs_ushr(regs[inst.b], regs[inst.c]);

        // --- comparison -----------------------------------------
        } else if op == Op::CmpEq {
            // ECMA-262 §7.2.13 step 13: when one side is an object and
            // the other is a primitive, ToPrimitive(object) is invoked
            // (which calls .valueOf / .toString). zjs_loose_eq alone
            // handles wrapper objects via a hidden-key shortcut but
            // can't invoke user methods — do that here while we still
            // have ctx.
            let cea = regs[inst.b];
            let ceb = regs[inst.c];
            let cea_obj = zjs_is_object(cea) != 0 || zjs_is_array(cea) != 0;
            let ceb_obj = zjs_is_object(ceb) != 0 || zjs_is_array(ceb) != 0;
            if cea_obj && !ceb_obj && !zjs_is_undefined(ceb) && !zjs_is_null(ceb) {
                cea = zjs_to_primitive(ctx, cea, false);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            } else if ceb_obj && !cea_obj && !zjs_is_undefined(cea) && !zjs_is_null(cea) {
                ceb = zjs_to_primitive(ctx, ceb, false);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
            regs[inst.a] = zjs_bool(zjs_loose_eq(cea, ceb));
        } else if op == Op::CmpNe {
            let cea = regs[inst.b];
            let ceb = regs[inst.c];
            let cea_obj = zjs_is_object(cea) != 0 || zjs_is_array(cea) != 0;
            let ceb_obj = zjs_is_object(ceb) != 0 || zjs_is_array(ceb) != 0;
            if cea_obj && !ceb_obj && !zjs_is_undefined(ceb) && !zjs_is_null(ceb) {
                cea = zjs_to_primitive(ctx, cea, false);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            } else if ceb_obj && !cea_obj && !zjs_is_undefined(cea) && !zjs_is_null(cea) {
                ceb = zjs_to_primitive(ctx, ceb, false);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
            let eq = zjs_loose_eq(cea, ceb);
            regs[inst.a] = zjs_bool(if eq != 0 { 0 } else { 1 });
        } else if op == Op::CmpStrictEq {
            regs[inst.a] = zjs_bool(zjs_strict_eq(regs[inst.b], regs[inst.c]));
        } else if op == Op::CmpStrictNe {
            let eq = zjs_strict_eq(regs[inst.b], regs[inst.c]);
            regs[inst.a] = zjs_bool(if eq != 0 { 0 } else { 1 });
        } else if op == Op::CmpLt {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_bool(zjs_cmp_lt(av, bv));
        } else if op == Op::CmpLe {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_bool(zjs_cmp_le(av, bv));
        } else if op == Op::CmpGt {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_bool(zjs_cmp_lt(bv, av));
        } else if op == Op::CmpGe {
            let av = regs[inst.b]; let bv = regs[inst.c];
            if is_object_like(av) != 0 || is_object_like(bv) != 0 {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            regs[inst.a] = zjs_bool(zjs_cmp_le(bv, av));

        // --- unary ----------------------------------------------
        } else if op == Op::Neg {
            let v = regs[inst.b];
            if is_object_like(v) != 0 {
                v = zjs_to_primitive(ctx, v, false);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
            regs[inst.a] = zjs_arith_neg(v);
        } else if op == Op::BitNot {
            regs[inst.a] = zjs_bit_not(regs[inst.b]);
        } else if op == Op::LogicalNot {
            let b = zjs_to_bool_coerce(regs[inst.b]);
            regs[inst.a] = zjs_bool(if b != 0 { 0 } else { 1 });

        // --- control flow ---------------------------------------
        } else if op == Op::Jmp {
            let off = inst_bc_i16(inst);
            ip = (usize)((i32)ip + off);
            // The ip += 1 below would still happen, but we deliberately
            // structured Jmp's offset as "relative to ip + 1", so the
            // normal increment is what we want. Same for the conditional
            // jumps below.
            // Backward jumps are loop heads — only safe-point we need
            // to keep loops responsive to GC pressure.
            if off < 0 {
                if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
            }
        } else if op == Op::JmpIfTrue {
            if zjs_to_bool_coerce(regs[inst.a]) != 0 {
                let off = inst_bc_i16(inst);
                ip = (usize)((i32)ip + off);
                if off < 0 {
                    if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
                }
            }
        } else if op == Op::JmpIfFalse {
            if zjs_to_bool_coerce(regs[inst.a]) == 0 {
                let off = inst_bc_i16(inst);
                ip = (usize)((i32)ip + off);
                if off < 0 {
                    if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
                }
            }
        } else if op == Op::MethodInvoke {
            // Same dispatch as Invoke but regs[base+1] is `this` and
            // explicit args live at regs[base+2..]. JS callees push a
            // new CallFrame; host callees stay synchronous.
            let dst = inst.a;
            let base = inst.b;
            let argc = (u32)inst.c;
            let callee = regs[base];
            let new_this = regs[base + 1];

            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let target: Function* = NULL;
                raw { target = (Function*)fp; }
                // Snapshot args into a C-stack buffer before push (the
                // push may realloc reg_stack, invalidating `regs`).
                // Use the context's reusable arg buffer instead of
                // alloca — alloca inside a loop accumulates across
                // iterations (no per-iteration free).
                if ctx.invoke_arg_buffer == NULL {
                    ctx.invoke_arg_buffer = alloc_n<ZjsValue>((usize)CTX_INVOKE_ARG_CAP);
                    ctx.invoke_arg_buffer_cap = CTX_INVOKE_ARG_CAP;
                }
                let argv_buf: ZjsValue* = ctx.invoke_arg_buffer;
                let ai: u32 = 0;
                while ai < argc { argv_buf[ai] = regs[base + 2 + (u8)ai]; ai = ai + 1; }
                ctx.frames[cur_idx].ip = ip + 1;
                ctx.host_this = new_this;
                push_call_frame(ctx, target, argv_buf, argc, dst);
                exit_reason = 2;
                break;
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                // Use the context's reusable arg buffer instead of
                // alloca — alloca inside a loop accumulates across
                // iterations (no per-iteration free).
                if ctx.invoke_arg_buffer == NULL {
                    ctx.invoke_arg_buffer = alloc_n<ZjsValue>((usize)CTX_INVOKE_ARG_CAP);
                    ctx.invoke_arg_buffer_cap = CTX_INVOKE_ARG_CAP;
                }
                let argv_buf: ZjsValue* = ctx.invoke_arg_buffer;
                let ai: u32 = 0;
                while ai < argc { argv_buf[ai] = regs[base + 2 + (u8)ai]; ai = ai + 1; }
                ctx.frames[cur_idx].ip = ip + 1;
                ctx.host_this = new_this;
                ctx.current_closure = cl;
                push_call_frame(ctx, target2, argv_buf, argc, dst);
                exit_reason = 2;
                break;
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 2]; }
                let saved_this = ctx.host_this;
                ctx.host_this = new_this;
                let saved_host_fn = ctx.current_host_fn;
                ctx.current_host_fn = hf_ptr;
                let r: ZjsValue = zjs_undefined();
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    r = fp(ctx, argv_ptr, argc);
                }
                ctx.current_host_fn = saved_host_fn;
                ctx.host_this = saved_this;
                regs[dst] = r;
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            } else {
                regs[dst] = zjs_undefined();
            }
        } else if op == Op::Invoke {
            // Plain call: this = undefined for the callee. JS callees
            // push a frame; host callees stay synchronous.
            let dst = inst.a;
            let base = inst.b;
            let argc = (u32)inst.c;
            let callee = regs[base];

            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let target: Function* = NULL;
                raw { target = (Function*)fp; }
                // Use the context's reusable arg buffer instead of
                // alloca — alloca inside a loop accumulates across
                // iterations (no per-iteration free).
                if ctx.invoke_arg_buffer == NULL {
                    ctx.invoke_arg_buffer = alloc_n<ZjsValue>((usize)CTX_INVOKE_ARG_CAP);
                    ctx.invoke_arg_buffer_cap = CTX_INVOKE_ARG_CAP;
                }
                let argv_buf: ZjsValue* = ctx.invoke_arg_buffer;
                let ai: u32 = 0;
                while ai < argc { argv_buf[ai] = regs[base + 1 + (u8)ai]; ai = ai + 1; }
                ctx.frames[cur_idx].ip = ip + 1;
                ctx.host_this = zjs_undefined();
                push_call_frame(ctx, target, argv_buf, argc, dst);
                exit_reason = 2;
                break;
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                // Use the context's reusable arg buffer instead of
                // alloca — alloca inside a loop accumulates across
                // iterations (no per-iteration free).
                if ctx.invoke_arg_buffer == NULL {
                    ctx.invoke_arg_buffer = alloc_n<ZjsValue>((usize)CTX_INVOKE_ARG_CAP);
                    ctx.invoke_arg_buffer_cap = CTX_INVOKE_ARG_CAP;
                }
                let argv_buf: ZjsValue* = ctx.invoke_arg_buffer;
                let ai: u32 = 0;
                while ai < argc { argv_buf[ai] = regs[base + 1 + (u8)ai]; ai = ai + 1; }
                ctx.frames[cur_idx].ip = ip + 1;
                ctx.host_this = zjs_undefined();
                ctx.current_closure = cl;
                push_call_frame(ctx, target2, argv_buf, argc, dst);
                exit_reason = 2;
                break;
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                let saved_this = ctx.host_this;
                ctx.host_this = zjs_undefined();
                let saved_host_fn = ctx.current_host_fn;
                ctx.current_host_fn = hf_ptr;
                let r: ZjsValue = zjs_undefined();
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    r = fp(ctx, argv_ptr, argc);
                }
                ctx.current_host_fn = saved_host_fn;
                ctx.host_this = saved_this;
                regs[dst] = r;
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            } else {
                regs[dst] = zjs_undefined();
            }
        } else if op == Op::TailInvoke || op == Op::TailMethodInvoke {
            // Tail call: replace this frame in-place. The new function
            // returns directly to OUR original caller.
            let base = inst.b;
            let argc = (u32)inst.c;
            let callee = regs[base];
            let is_method: bool = op == Op::TailMethodInvoke;
            let new_this: ZjsValue = if is_method {
                regs[base + 1]
            } else {
                zjs_undefined()
            };
            let arg_offset: u8 = if is_method { (u8)2 } else { (u8)1 };

            if zjs_is_function(callee) != 0 || zjs_is_closure(callee) != 0 {
                if ctx.invoke_arg_buffer == NULL {
                    ctx.invoke_arg_buffer = alloc_n<ZjsValue>((usize)CTX_INVOKE_ARG_CAP);
                    ctx.invoke_arg_buffer_cap = CTX_INVOKE_ARG_CAP;
                }
                let argv_buf: ZjsValue* = ctx.invoke_arg_buffer;
                let ai: u32 = 0;
                while ai < argc {
                    argv_buf[ai] = regs[base + arg_offset + (u8)ai];
                    ai = ai + 1;
                }
                let target: Function* = NULL;
                if zjs_is_function(callee) != 0 {
                    let fp = zjs_cell_as_ptr(callee);
                    raw { target = (Function*)fp; }
                    // current_closure stays as the caller's saved value
                    // (which equals the OUTGOING frame's saved_current_closure
                    // — which is what should be live during the tail-callee).
                    // For plain Function calls, set host_this for the duration.
                    ctx.host_this = new_this;
                } else {
                    let cl = zjs_as_closure(callee);
                    let fp2 = cl.function;
                    raw { target = (Function*)fp2; }
                    ctx.host_this = new_this;
                    ctx.current_closure = cl;
                }
                tail_call_frame(ctx, target, argv_buf, argc);
                exit_reason = 2;
                break;
            } else if zjs_is_host_function(callee) != 0 {
                // Synchronous host call, then act like Op::Return with r.
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + arg_offset]; }
                let saved_host = ctx.host_this;
                ctx.host_this = new_this;
                let saved_host_fn = ctx.current_host_fn;
                ctx.current_host_fn = hf_ptr;
                let r: ZjsValue = zjs_undefined();
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    r = fp(ctx, argv_ptr, argc);
                }
                ctx.current_host_fn = saved_host_fn;
                ctx.host_this = saved_host;
                if ctx.pending_throw_active {
                    // Tail callee threw — pop our frame (we're already
                    // semantically "returned") and surface the throw in
                    // the caller.
                    let thrown_v = consume_pending_throw(ctx);
                    if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
                    let _ = pop_call_frame(ctx);
                    throwing = true;
                    thrown = thrown_v;
                    exit_reason = 3;
                    break;
                }
                // Pop and write result like an implicit Return.
                if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
                let ret_dst = pop_call_frame(ctx);
                if ctx.frame_count <= entry_frame {
                    final_result = r;
                } else {
                    let cidx = ctx.frame_count - 1;
                    let cb = ctx.frames[cidx].regs_base;
                    ctx.reg_stack[cb + (u32)ret_dst] = r;
                }
                exit_reason = 1;
                break;
            } else {
                // Not callable — return undefined to caller.
                let ret_dst = pop_call_frame(ctx);
                if ctx.frame_count <= entry_frame {
                    final_result = zjs_undefined();
                } else {
                    let cidx = ctx.frame_count - 1;
                    let cb = ctx.frames[cidx].regs_base;
                    ctx.reg_stack[cb + (u32)ret_dst] = zjs_undefined();
                }
                exit_reason = 1;
                break;
            }
        } else if op == Op::Typeof {
            let v = regs[inst.b];
            let label: char* = (char*)"undefined";
            if zjs_is_undefined(v) != 0 {
                label = (char*)"undefined";
            } else if zjs_is_null(v) != 0 {
                label = (char*)"object";
            } else if zjs_is_bool(v) != 0 {
                label = (char*)"boolean";
            } else if zjs_is_number(v) != 0 {
                label = (char*)"number";
            } else if zjs_is_string(v) != 0 {
                label = (char*)"string";
            } else if zjs_is_function(v) != 0 || zjs_is_host_function(v) != 0 || zjs_is_closure(v) != 0 {
                label = (char*)"function";
            } else {
                label = (char*)"object";
            }
            let llen: u32 = 0;
            raw { llen = (uint32_t)strlen(label); }
            regs[inst.a] = ctx_intern_string(ctx, label, llen);
        } else if op == Op::Throw {
            throwing = true;
            thrown = regs[inst.a];
            exit_reason = 3;
            break;
        } else if op == Op::EnterTry {
            let off = inst_bc_i16(inst);
            let target: usize = (usize)((i32)ip + 1 + off);
            if !ctx_try_push(ctx, target, inst.a) {
                // Out of try slots — surface as an uncaught throw.
                throwing = true;
                thrown = zjs_undefined();
                exit_reason = 3;
                break;
            }
        } else if op == Op::LeaveTry {
            ctx_try_pop(ctx);
        } else if op == Op::DefineGetter || op == Op::DefineSetter {
            // Install (or merge into existing) an accessor slot on
            // `regs[a]` at key `regs[b]` (an atom-string), with the
            // function `regs[c]` as the getter or setter.
            let obj_v = regs[inst.a];
            let key_v = regs[inst.b];
            let fn_v  = regs[inst.c];
            if zjs_is_object(obj_v) != 0 && zjs_is_string(key_v) != 0 {
                let o = zjs_as_object(obj_v);
                let key_s = zjs_as_string(key_v);
                let key_atom = ctx_intern_atom(ctx, key_s.data, key_s.length);
                let existing_slot = class_find_slot(o.cls, key_atom);
                let cur_get: ZjsValue = zjs_undefined();
                let cur_set: ZjsValue = zjs_undefined();
                if existing_slot >= 0 {
                    let cur_v = o.slots[(u32)existing_slot];
                    if zjs_is_accessor(cur_v) != 0 {
                        let acc = zjs_as_accessor(cur_v);
                        cur_get = acc.get;
                        cur_set = acc.set;
                    }
                }
                let new_get = if op == Op::DefineGetter { fn_v } else { cur_get };
                let new_set = if op == Op::DefineSetter { fn_v } else { cur_set };
                let acc = zjs_accessor_new(new_get, new_set);
                ctx_register_cell(ctx, (void*)acc);
                let av = zjs_cell_from_ptr((void*)acc);
                object_set(ctx, o, key_atom, av);
            }
        } else if op == Op::MakeClosure {
            // a = dst, b = function-value reg, c = env-object reg
            let fn_val = regs[inst.b];
            let env_val = regs[inst.c];
            let fp: void* = zjs_cell_as_ptr(fn_val);
            let env_o: ZjsObject* = NULL;
            if zjs_is_object(env_val) != 0 {
                env_o = zjs_as_object(env_val);
            }
            let cl = zjs_closure_new(fp, env_o);
            ctx_register_cell(ctx, (void*)cl);
            regs[inst.a] = zjs_cell_from_ptr((void*)cl);
        } else if op == Op::LoadEnv {
            // a = dst. Read the env of the currently-executing closure
            // (or undefined if we're not inside one).
            if ctx.current_closure != NULL && ctx.current_closure.env != NULL {
                regs[inst.a] = zjs_cell_from_ptr((void*)ctx.current_closure.env);
            } else {
                regs[inst.a] = zjs_undefined();
            }
        } else if op == Op::LoadProp {
            let dst = inst.a;
            let obj_reg = inst.b;
            let ic_slot = inst.c;
            let obj_val = regs[obj_reg];

            let took_fast: bool = false;
            if zjs_is_object(obj_val) != 0 {
                let o = zjs_as_object(obj_val);
                let cls: ZjsHiddenClass* = o.cls;
                // Unrolled polymorphic probe (IC_POLY_SIZE = 4). A loop
                // here costs ~12% on monomorphic-hot sites; the unrolled
                // form keeps the predictor happy and lets clang fold the
                // bounds. Most-frequently-seen shape sits at index 0.
                let hit_slot: i32 = -1;
                let ic_ptr: ICEntry* = NULL;
                raw { ic_ptr = &f->ics[ic_slot]; }
                let n = (u32)ic_ptr.entry_count;
                if n > 0 && ic_ptr.classes[0] == cls { hit_slot = (i32)ic_ptr.slots[0]; }
                else if n > 1 && ic_ptr.classes[1] == cls { hit_slot = (i32)ic_ptr.slots[1]; }
                else if n > 2 && ic_ptr.classes[2] == cls { hit_slot = (i32)ic_ptr.slots[2]; }
                else if n > 3 && ic_ptr.classes[3] == cls { hit_slot = (i32)ic_ptr.slots[3]; }
                if hit_slot >= 0 {
                    let raw_v = o.slots[(u32)hit_slot];
                    if zjs_is_accessor(raw_v) == 0 && zjs_is_deleted(raw_v) == 0 {
                        regs[dst] = raw_v;
                        took_fast = true;
                    }
                }
            }
            if !took_fast {
                let ic_name: ZjsString* = f.ics[ic_slot].name;
                let key_val = zjs_cell_from_ptr((void*)ic_name);
                regs[dst] = property_get(ctx, obj_val, key_val);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                // Patch the IC if obj is an object that has the prop
                // and the cache isn't already full+megamorphic.
                if zjs_is_object(obj_val) != 0 && !f.ics[ic_slot].megamorphic {
                    let o = zjs_as_object(obj_val);
                    let s = class_find_slot(o.cls, ic_name);
                    if s >= 0 {
                        // Already cached? (Reachable when slow-path was
                        // taken due to accessor/deleted, not shape miss.)
                        let already: bool = false;
                        let n2 = (u32)f.ics[ic_slot].entry_count;
                        let k2: u32 = 0;
                        while k2 < n2 {
                            if f.ics[ic_slot].classes[k2] == o.cls { already = true; break; }
                            k2 = k2 + 1;
                        }
                        if !already {
                            if n2 < IC_POLY_SIZE {
                                f.ics[ic_slot].classes[n2] = o.cls;
                                f.ics[ic_slot].slots[n2] = (u32)s;
                                f.ics[ic_slot].entry_count = (u8)(n2 + 1);
                            } else {
                                // Cache full and a new shape appeared —
                                // flip megamorphic. Don't bother evicting:
                                // a true poly site has stabilized within
                                // 4 shapes, and a churny site won't
                                // benefit from LRU either.
                                f.ics[ic_slot].megamorphic = true;
                            }
                        }
                    }
                }
            }
        } else if op == Op::StoreProp {
            let obj_reg = inst.a;
            let ic_slot = inst.b;
            let val_reg = inst.c;
            let obj_val = regs[obj_reg];
            let value   = regs[val_reg];

            let took_fast: bool = false;
            if zjs_is_object(obj_val) != 0 {
                let o = zjs_as_object(obj_val);
                let cls: ZjsHiddenClass* = o.cls;
                let hit_slot: i32 = -1;
                let ic_ptr: ICEntry* = NULL;
                raw { ic_ptr = &f->ics[ic_slot]; }
                let n = (u32)ic_ptr.entry_count;
                if n > 0 && ic_ptr.classes[0] == cls { hit_slot = (i32)ic_ptr.slots[0]; }
                else if n > 1 && ic_ptr.classes[1] == cls { hit_slot = (i32)ic_ptr.slots[1]; }
                else if n > 2 && ic_ptr.classes[2] == cls { hit_slot = (i32)ic_ptr.slots[2]; }
                else if n > 3 && ic_ptr.classes[3] == cls { hit_slot = (i32)ic_ptr.slots[3]; }
                if hit_slot >= 0 {
                    let slot_n = (u32)hit_slot;
                    let raw_v = o.slots[slot_n];
                    if zjs_is_accessor(raw_v) == 0 && zjs_is_deleted(raw_v) == 0 {
                        o.slots[slot_n] = value;
                        took_fast = true;
                    }
                }
            }
            if !took_fast {
                let ic_name: ZjsString* = f.ics[ic_slot].name;
                let key_val = zjs_cell_from_ptr((void*)ic_name);
                property_set(ctx, obj_val, key_val, value);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                if zjs_is_object(obj_val) != 0 && !f.ics[ic_slot].megamorphic {
                    let o = zjs_as_object(obj_val);
                    let s = class_find_slot(o.cls, ic_name);
                    if s >= 0 {
                        let already: bool = false;
                        let n2 = (u32)f.ics[ic_slot].entry_count;
                        let k2: u32 = 0;
                        while k2 < n2 {
                            if f.ics[ic_slot].classes[k2] == o.cls { already = true; break; }
                            k2 = k2 + 1;
                        }
                        if !already {
                            if n2 < IC_POLY_SIZE {
                                f.ics[ic_slot].classes[n2] = o.cls;
                                f.ics[ic_slot].slots[n2] = (u32)s;
                                f.ics[ic_slot].entry_count = (u8)(n2 + 1);
                            } else {
                                f.ics[ic_slot].megamorphic = true;
                            }
                        }
                    }
                }
            }
        } else if op == Op::NewObject {
            regs[inst.a] = ctx_new_object(ctx);
        } else if op == Op::NewRegex {
            // a=dst, b=pattern_const_idx, c=flags_const_idx.
            // Fresh instance per execution so `g`/`y` lastIndex is
            // independent across `for (...) /pat/g.test(x)` iterations.
            let pat_v   = f.constants[(u32)inst.b];
            let flags_v = f.constants[(u32)inst.c];
            regs[inst.a] = ctx_new_regexp(ctx, pat_v, flags_v);
        } else if op == Op::NewArray {
            let dst = inst.a;
            let base = inst.b;
            let count = (u32)inst.c;
            let arr_val = ctx_new_array(ctx, count);
            let arr = zjs_as_array(arr_val);
            let i: u32 = 0;
            while i < count {
                arr.elements[i] = regs[base + (u8)i];
                i = i + 1;
            }
            arr.length = count;
            regs[dst] = arr_val;
        } else if op == Op::LoadElem {
            // Type-guard fast path for `arr[i]` where `arr` is an array
            // and `i` is a small int. Skips the property_get function
            // call, the pending-throw check, and the hole-to-undefined
            // conversion in array_get. Sieve and tight indexed loops
            // sit here; the slow path catches strings, doubles, holes
            // (which fall back to coerce-to-undefined), and accessors.
            let obj_val = regs[inst.b];
            let key_val = regs[inst.c];
            let took_fast: bool = false;
            if zjs_is_array(obj_val) != 0 && zjs_is_int32(key_val) != 0 {
                let i = zjs_as_int32(key_val);
                if i >= 0 {
                    let arr = zjs_as_array(obj_val);
                    let u = (u32)i;
                    if u < arr.length {
                        let v = arr.elements[u];
                        // Hole → undefined inline (avoid one extra branch
                        // in array_get).
                        if zjs_is_deleted(v) == 0 {
                            regs[inst.a] = v;
                        } else {
                            regs[inst.a] = zjs_undefined();
                        }
                        took_fast = true;
                    } else {
                        // Out-of-bounds read is `undefined` — common in
                        // defensive `i < arr.length` patterns where the
                        // compiler can't prove it. No prototype walk on
                        // pure int index path.
                        regs[inst.a] = zjs_undefined();
                        took_fast = true;
                    }
                }
            }
            if !took_fast {
                regs[inst.a] = property_get(ctx, obj_val, key_val);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
        } else if op == Op::StoreElem {
            // Mirror of LoadElem's fast path: dense indexed write with
            // no realloc. Three cases stay fast:
            //   (a) in-bounds: pure slot write, length unchanged
            //   (b) past length but within capacity: write + bump length
            //   (c) past capacity: fall through to array_set (realloc)
            // Case (b) relies on the invariant that slots in [length, cap)
            // are holes (zjs_deleted) — maintained by array_set's grow
            // path and by length-shrink in property_set.
            let obj_val = regs[inst.a];
            let key_val = regs[inst.b];
            let value   = regs[inst.c];
            let took_fast: bool = false;
            if zjs_is_array(obj_val) != 0 && zjs_is_int32(key_val) != 0 {
                let i = zjs_as_int32(key_val);
                if i >= 0 {
                    let arr = zjs_as_array(obj_val);
                    let u = (u32)i;
                    if u < arr.length {
                        arr.elements[u] = value;
                        took_fast = true;
                    } else if u < arr.cap {
                        arr.elements[u] = value;
                        arr.length = u + 1;
                        took_fast = true;
                    }
                }
            }
            if !took_fast {
                property_set(ctx, obj_val, key_val, value);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
        } else if op == Op::LoadThis {
            regs[inst.a] = ctx.host_this;
        } else if op == Op::In {
            // key in obj — ECMA-262 §13.10.1: obj must be an Object,
            // else throw TypeError. Our "Object" notion includes plain
            // objects, arrays, functions, host functions, closures.
            let key = regs[inst.b];
            let obj = regs[inst.c];
            let obj_like: bool =
                zjs_is_object(obj) != 0
                || zjs_is_array(obj) != 0
                || zjs_is_function(obj) != 0
                || zjs_is_closure(obj) != 0
                || zjs_is_host_function(obj) != 0;
            if !obj_like {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Cannot use 'in' on a non-object", 31);
                throwing = true; thrown = err; exit_reason = 3; break;
            }
            let present: int = 0;
            if zjs_is_array(obj) != 0 {
                let a = zjs_as_array(obj);
                let idx = zjs_to_array_index(key);
                if idx >= 0 && (u32)idx < a.length {
                    // Holes are not "in" the array per spec.
                    if array_has_index(a, (u32)idx) != 0 { present = 1; }
                } else if zjs_is_string(key) != 0 {
                    // Falls back through length / array_proto.
                    let pv = property_get(ctx, obj, key);
                    if zjs_is_undefined(pv) == 0 { present = 1; }
                }
            } else if zjs_is_object(obj) != 0 {
                let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name = zjs_as_string(key_str_val);
                let cur = zjs_as_object(obj);
                while cur != NULL {
                    if class_find_slot(cur.cls, name) >= 0 { present = 1; cur = NULL; }
                    else { cur = cur.proto; }
                }
            } else if zjs_is_host_function(obj) != 0 {
                // Host function: probe .props.
                let hf = zjs_as_host_function(obj);
                if hf.props != NULL {
                    let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                    let name = zjs_as_string(key_str_val);
                    if class_find_slot(hf.props.cls, name) >= 0 { present = 1; }
                }
            } else if zjs_is_function(obj) != 0 {
                // Function: probe .props (Function.prototype always
                // exists, but "prototype" in fn returns true only if
                // the user touched it — mirror what V8/JSC do for an
                // unobserved-prototype function: report `true` for the
                // well-known own-slots and the props bag).
                let fp = zjs_cell_as_ptr(obj);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.props != NULL {
                    let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                    let name = zjs_as_string(key_str_val);
                    if class_find_slot(f.props.cls, name) >= 0 { present = 1; }
                }
            }
            // Closure: still no own-props (closures wrap a Function
            // and would alias if they piggybacked on f.props). Leave
            // present=0 for now; revisit if a harness needs it.
            regs[inst.a] = zjs_bool(present);
        } else if op == Op::Instanceof {
            // val instanceof ctor — ctor.prototype must be in val's chain.
            // ECMA-262 §13.10.2: if RHS isn't callable (Function /
            // Closure / HostFunction), throw TypeError.
            let val = regs[inst.b];
            let ctor = regs[inst.c];
            let proto_obj: ZjsObject* = NULL;
            let ctor_callable: bool = false;
            if zjs_is_function(ctor) != 0 {
                ctor_callable = true;
                let fp = zjs_cell_as_ptr(ctor);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                proto_obj = f.prototype;
            } else if zjs_is_closure(ctor) != 0 {
                ctor_callable = true;
                let cl = zjs_as_closure(ctor);
                let fp2 = cl.function;
                let f2: Function* = NULL;
                raw { f2 = (Function*)fp2; }
                proto_obj = f2.prototype;
            } else if zjs_is_host_function(ctor) != 0 {
                ctor_callable = true;
                proto_obj = zjs_as_host_function(ctor).prototype;
            }
            if !ctor_callable {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Right-hand side of instanceof is not callable", 46);
                throwing = true; thrown = err; exit_reason = 3; break;
            }
            let result: int = 0;
            // Special-case host-function constructors `Function` and
            // `Object` against function-like / reference-typed values.
            // We don't have a full Function.prototype → Object.prototype
            // chain wired up yet, so spot-check by ctor name.
            let is_callable_val: bool =
                zjs_is_function(val) != 0
                || zjs_is_closure(val) != 0
                || zjs_is_host_function(val) != 0;
            let is_ref_val: bool =
                is_callable_val
                || zjs_is_object(val) != 0
                || zjs_is_array(val) != 0
                || zjs_is_promise(val) != 0;
            if zjs_is_host_function(ctor) != 0 {
                let hf = zjs_as_host_function(ctor);
                let nm = hf.name;
                if nm != NULL {
                    let is_fn: int = 0;
                    let is_obj: int = 0;
                    raw {
                        is_fn  = (strcmp(nm, "Function") == 0) ? 1 : 0;
                        is_obj = (strcmp(nm, "Object")   == 0) ? 1 : 0;
                    }
                    if is_fn  != 0 && is_callable_val { result = 1; }
                    if is_obj != 0 && is_ref_val      { result = 1; }
                }
            }
            if proto_obj != NULL && result == 0 {
                if zjs_is_object(val) != 0 {
                    let cur = zjs_as_object(val).proto;
                    while cur != NULL {
                        if cur == proto_obj { result = 1; cur = NULL; }
                        else                { cur = cur.proto; }
                    }
                } else if zjs_is_array(val) != 0 {
                    // All arrays implicitly delegate to ctx.array_proto.
                    // Walk from there in case array_proto itself has
                    // been re-prototyped (rare in practice; mostly
                    // matches when proto_obj == ctx.array_proto).
                    let cur = ctx.array_proto;
                    while cur != NULL {
                        if cur == proto_obj { result = 1; cur = NULL; }
                        else                { cur = cur.proto; }
                    }
                } else if zjs_is_promise(val) != 0 {
                    let cur = ctx.promise_ctor_proto;
                    while cur != NULL {
                        if cur == proto_obj { result = 1; cur = NULL; }
                        else                { cur = cur.proto; }
                    }
                }
            }
            regs[inst.a] = zjs_bool(result);
        } else if op == Op::NewInvoke {
            // new Ctor(args): allocate {} with proto = Ctor.prototype,
            // bind `this` to it, call. If callee returns an object,
            // use that; otherwise use the new object.
            let dst = inst.a;
            let base = inst.b;
            let argc = (u32)inst.c;
            let callee = regs[base];

            // Lazy-create the constructor's .prototype as we did in
            // property_get, so even a never-touched ctor.prototype is
            // a real object after `new` runs.
            let proto_obj: ZjsObject* = NULL;
            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.prototype == NULL {
                    let pv = ctx_new_object(ctx);
                    f.prototype = zjs_as_object(pv);
                }
                proto_obj = f.prototype;
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let f: Function* = NULL;
                raw { f = (Function*)fp2; }
                if f.prototype == NULL {
                    let pv = ctx_new_object(ctx);
                    f.prototype = zjs_as_object(pv);
                }
                proto_obj = f.prototype;
            } else if zjs_is_host_function(callee) != 0 {
                let hf = zjs_as_host_function(callee);
                if hf.prototype == NULL {
                    let pv = ctx_new_object(ctx);
                    hf.prototype = zjs_as_object(pv);
                }
                proto_obj = hf.prototype;
            }

            let new_obj_v = ctx_new_object(ctx);
            let new_obj = zjs_as_object(new_obj_v);
            new_obj.proto = proto_obj;

            let saved_this = ctx.host_this;
            ctx.host_this = new_obj_v;

            let call_result: ZjsValue = zjs_undefined();
            let did_throw: bool = false;
            if zjs_is_function(callee) != 0 {
                let fp = zjs_cell_as_ptr(callee);
                let target: Function* = NULL;
                raw { target = (Function*)fp; }
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                let r = interpret(ctx, target, argv_ptr, argc);
                if r.is_throw { did_throw = true; call_result = r.value; }
                else          { call_result = r.value; }
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                let argv_ptr2: ZjsValue* = NULL;
                raw { argv_ptr2 = &regs[base + 1]; }
                let saved_cl = ctx.current_closure;
                ctx.current_closure = cl;
                let r2 = interpret(ctx, target2, argv_ptr2, argc);
                ctx.current_closure = saved_cl;
                if r2.is_throw { did_throw = true; call_result = r2.value; }
                else           { call_result = r2.value; }
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + 1]; }
                let saved_host_fn = ctx.current_host_fn;
                ctx.current_host_fn = hf_ptr;
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    call_result = fp(ctx, argv_ptr, argc);
                }
                ctx.current_host_fn = saved_host_fn;
                if ctx.pending_throw_active {
                    did_throw = true;
                    call_result = consume_pending_throw(ctx);
                }
            }
            ctx.host_this = saved_this;
            if did_throw {
                throwing = true; thrown = call_result; exit_reason = 3; break;
            }
            // Use callee's return if it returned an object; else the new one.
            if zjs_is_object(call_result) != 0
                || zjs_is_array(call_result) != 0
                || zjs_is_promise(call_result) != 0
                || zjs_is_regexp(call_result) != 0 {
                regs[dst] = call_result;
            } else {
                regs[dst] = new_obj_v;
            }
        } else if op == Op::DeleteElem {
            // Mark the property's slot DELETED (sentinel). For arrays:
            // clear the element (set to undefined; the spec calls this
            // an "array hole"). Returns boolean true on success, false
            // when the property exists but is non-configurable.
            let dst = inst.a;
            let obj_v = regs[inst.b];
            let key   = regs[inst.c];
            let ok: bool = true;
            if zjs_is_object(obj_v) != 0 {
                let o = zjs_as_object(obj_v);
                let key_str = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name = zjs_as_string(key_str);
                let slot = class_find_slot(o.cls, name);
                if slot >= 0 {
                    let a = object_get_attrs(o, (u32)slot);
                    if (a & PROP_CONFIGURABLE) == 0 {
                        ok = false;
                    } else {
                        o.slots[(u32)slot] = zjs_deleted();
                    }
                }
                // Property not present → spec returns true.
            } else if zjs_is_array(obj_v) != 0 {
                let a = zjs_as_array(obj_v);
                let idx = zjs_to_array_index(key);
                if idx >= 0 && (u32)idx < a.length {
                    // `delete arr[i]` leaves a hole — the slot is no
                    // longer "in" the array for HasProperty purposes.
                    // Array elements aren't tracked with attrs yet, so
                    // they're always configurable per spec.
                    a.elements[(u32)idx] = zjs_deleted();
                }
            }
            regs[dst] = zjs_bool(ok);
        } else if op == Op::BuildArguments {
            // Build a fresh array from the call's full passed-args list.
            // Args live on the reg_stack at frame.args_base, length
            // frame.argc (covers the case where argc > param_count).
            let frame_argc = ctx.frames[cur_idx].argc;
            let frame_args_base = ctx.frames[cur_idx].args_base;
            let arr_v = ctx_new_array(ctx, frame_argc);
            let arr = zjs_as_array(arr_v);
            let i: u32 = 0;
            while i < frame_argc {
                arr.elements[i] = ctx.reg_stack[frame_args_base + i];
                i = i + 1;
            }
            arr.length = frame_argc;
            regs[inst.a] = arr_v;
        } else if op == Op::IterPrepare {
            regs[inst.a] = iter_prepare(ctx, regs[inst.b], (u32)inst.c);
        } else if op == Op::ArrayLength {
            let src = regs[inst.b];
            if zjs_is_array(src) != 0 {
                let a = zjs_as_array(src);
                regs[inst.a] = zjs_int32((i32)a.length);
            } else {
                regs[inst.a] = zjs_int32(0);
            }
        }
        // else: unknown opcode — ignore (interpreter is permissive
        // during MVP; the compiler shouldn't emit such ops).

        // Pending-throw bridge is no longer per-instruction — each
        // opcode handler that can call a host helper checks
        // ctx.pending_throw_active inline (right after the helper
        // returns) and promotes it to a local throw. Keeping the hot
        // dispatch loop straight-line saves a memory load + branch per
        // instruction. The slow-path checks live in:
        //   - Op::Invoke / MethodInvoke / TailInvoke /
        //     TailMethodInvoke / NewInvoke (host-fn callee branch)
        //   - Op::Add / Sub / Mul / Div / Mod / Pow / AddImm-slow /
        //     SubImm-slow (after zjs_to_primitive)
        //   - Op::CmpEq / CmpNe / CmpLt / CmpLe / CmpGt / CmpGe
        //     and their *Imm slow paths
        //   - Op::Neg
        //   - Op::LoadProp / StoreProp / LoadElem / StoreElem
        //     (property accessors fire callbacks)

        ip = ip + 1;
        }   // end inner while ip < code_len

        // Inner loop exited. Decide why and how to handle.
        if exit_reason == 0 {
            // Ran off end of code — implicit return undefined.
            let ret_dst = pop_call_frame(ctx);
            if ctx.frame_count <= entry_frame {
                final_result = zjs_undefined();
            } else {
                let cidx = ctx.frame_count - 1;
                let cb = ctx.frames[cidx].regs_base;
                ctx.reg_stack[cb + (u32)ret_dst] = zjs_undefined();
            }
        }
        // exit_reason == 1: Return/Halt already popped + wrote return value
        // exit_reason == 2: Invoke pushed a new frame — frame.ip saved before push
        // exit_reason == 3: throwing/thrown set — outer loop unwinds next iter
    }   // end outer while ctx.frame_count > entry_frame

    if throwing {
        return InterpretResult{ is_throw: true, value: thrown };
    }
    return InterpretResult{ is_throw: false, value: final_result };
}

// Invoke a JS-visible callable (Function | Closure | HostFunction) from
// host code. Used by Array.prototype.{map, forEach} to fire the user's
// callback. For MVP, an inner throw is dropped and `undefined` returned
// to the host — proper throw propagation across the host boundary is a
// future-work item (would need a ctx.pending_throw flag and a check in
// Op::MethodInvoke / Op::Invoke after each host call).
// ECMA-262 ToPrimitive(input, hint).
//
//  - `prefer_string = false` (the "number" or "default" hint): call
//    valueOf() first; if it returns a primitive, use it. Else call
//    toString().
//  - `prefer_string = true`: reverse the order.
//
// Returns input unchanged if it's already primitive. If neither
// valueOf nor toString returns a primitive, returns undefined
// (spec says TypeError; MVP falls back).
// True if `v` is any kind of object reference that requires ToPrimitive
// before numeric / string-comparison coercion: plain objects, arrays,
// and callable values (Function / Closure / HostFunction). Primitives
// (numbers, strings, bool, null, undefined) return 0.
fn is_object_like(v: ZjsValue) -> int {
    if zjs_is_object(v) != 0 { return 1; }
    if zjs_is_array(v) != 0 { return 1; }
    if zjs_is_function(v) != 0 { return 1; }
    if zjs_is_closure(v) != 0 { return 1; }
    if zjs_is_host_function(v) != 0 { return 1; }
    return 0;
}

// Read + clear the pending-throw bridge state. Called from each
// opcode handler that just executed a host helper which may have
// raised an exception (zjs_to_primitive, zjs_call_value, accessor
// get/set, etc.). Returns the thrown value; caller is responsible
// for setting throwing/exit_reason and breaking out of the inner
// loop. ctx.pending_throw_active should be checked separately.
fn consume_pending_throw(ctx: ZjsContext*) -> ZjsValue {
    let v = ctx.pending_throw_value;
    ctx.pending_throw_active = false;
    ctx.pending_throw_value  = zjs_undefined();
    return v;
}

fn zjs_to_primitive(ctx: ZjsContext*, v: ZjsValue, prefer_string: bool) -> ZjsValue {
    // Objects, arrays, and callables (Function / Closure / HostFunction)
    // all go through the toString/valueOf coercion dance per spec.
    // Primitives short-circuit.
    let is_objy: int = 0;
    if zjs_is_object(v) != 0 || zjs_is_array(v) != 0
       || zjs_is_function(v) != 0 || zjs_is_closure(v) != 0
       || zjs_is_host_function(v) != 0 {
        is_objy = 1;
    }
    if is_objy == 0 { return v; }

    let valueOf_atom  = ctx_intern_atom(ctx, (char*)"valueOf",  7);
    let toString_atom = ctx_intern_atom(ctx, (char*)"toString", 8);
    let first_atom: ZjsString*  = if prefer_string { toString_atom } else { valueOf_atom };
    let second_atom: ZjsString* = if prefer_string { valueOf_atom  } else { toString_atom };

    let argv: ZjsValue* = NULL;

    let m1 = property_get(ctx, v, zjs_cell_from_ptr((void*)first_atom));
    if zjs_is_function(m1) != 0 || zjs_is_closure(m1) != 0 || zjs_is_host_function(m1) != 0 {
        let r1 = zjs_call_value_with_this(ctx, m1, v, argv, 0);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r1_objy: int = 0;
        if zjs_is_object(r1) != 0 || zjs_is_array(r1) != 0
           || zjs_is_function(r1) != 0 || zjs_is_closure(r1) != 0
           || zjs_is_host_function(r1) != 0 { r1_objy = 1; }
        if r1_objy == 0 { return r1; }
    }
    let m2 = property_get(ctx, v, zjs_cell_from_ptr((void*)second_atom));
    if zjs_is_function(m2) != 0 || zjs_is_closure(m2) != 0 || zjs_is_host_function(m2) != 0 {
        let r2 = zjs_call_value_with_this(ctx, m2, v, argv, 0);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r2_objy: int = 0;
        if zjs_is_object(r2) != 0 || zjs_is_array(r2) != 0
           || zjs_is_function(r2) != 0 || zjs_is_closure(r2) != 0
           || zjs_is_host_function(r2) != 0 { r2_objy = 1; }
        if r2_objy == 0 { return r2; }
    }
    // ECMA-262 §7.1.1 step 8: neither method returned a primitive.
    // Raise a TypeError via the pending-throw bridge; the calling op
    // will promote it before the next instruction.
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"Cannot convert object to primitive value", 40);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value  = err;
    return zjs_undefined();
}

// Like zjs_call_value but explicitly binds `this`. Used by
// Function.prototype.{call, apply} to pass through a caller-chosen
// receiver. Unlike the plain helper, this does NOT clear
// ctx.host_this around host-function dispatch — the explicit
// `this_val` is the receiver the callee should see.
fn zjs_call_value_with_this(ctx: ZjsContext*, callee: ZjsValue, this_val: ZjsValue, args: ZjsValue*, argc: u32) -> ZjsValue {
    let saved = ctx.host_this;
    ctx.host_this = this_val;
    let r: ZjsValue = zjs_undefined();
    if zjs_is_function(callee) != 0 {
        let fp = zjs_cell_as_ptr(callee);
        let target: Function* = NULL;
        raw { target = (Function*)fp; }
        let rr = interpret(ctx, target, args, argc);
        if rr.is_throw {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = rr.value;
        } else {
            r = rr.value;
        }
    } else if zjs_is_closure(callee) != 0 {
        let cl = zjs_as_closure(callee);
        let fp2 = cl.function;
        let target2: Function* = NULL;
        raw { target2 = (Function*)fp2; }
        let saved_cl = ctx.current_closure;
        ctx.current_closure = cl;
        let rr = interpret(ctx, target2, args, argc);
        ctx.current_closure = saved_cl;
        if rr.is_throw {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = rr.value;
        } else {
            r = rr.value;
        }
    } else if zjs_is_host_function(callee) != 0 {
        let hf_ptr = zjs_cell_as_ptr(callee);
        let saved_host_fn = ctx.current_host_fn;
        ctx.current_host_fn = hf_ptr;
        raw {
            ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
            typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
            HostFn fp = (HostFn)hf->fn_ptr;
            r = fp(ctx, args, argc);
        }
        ctx.current_host_fn = saved_host_fn;
    }
    ctx.host_this = saved;
    return r;
}

fn zjs_call_value(ctx: ZjsContext*, callee: ZjsValue, args: ZjsValue*, argc: u32) -> ZjsValue {
    if zjs_is_function(callee) != 0 {
        let fp = zjs_cell_as_ptr(callee);
        let target: Function* = NULL;
        raw { target = (Function*)fp; }
        let r = interpret(ctx, target, args, argc);
        if r.is_throw {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = r.value;
            return zjs_undefined();
        }
        return r.value;
    }
    if zjs_is_closure(callee) != 0 {
        let cl = zjs_as_closure(callee);
        let fp2 = cl.function;
        let target2: Function* = NULL;
        raw { target2 = (Function*)fp2; }
        let saved_cl = ctx.current_closure;
        ctx.current_closure = cl;
        let r2 = interpret(ctx, target2, args, argc);
        ctx.current_closure = saved_cl;
        if r2.is_throw {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = r2.value;
            return zjs_undefined();
        }
        return r2.value;
    }
    if zjs_is_host_function(callee) != 0 {
        let hf_ptr = zjs_cell_as_ptr(callee);
        let r: ZjsValue = zjs_undefined();
        let saved_this = ctx.host_this;
        ctx.host_this = zjs_undefined();
        raw {
            ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
            typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
            HostFn fp = (HostFn)hf->fn_ptr;
            r = fp(ctx, args, argc);
        }
        ctx.host_this = saved_this;
        return r;
    }
    return zjs_undefined();
}
