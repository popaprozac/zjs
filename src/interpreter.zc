    // Function: .prototype lazy-creates an object on first read.
    // Also serves .call and .apply via the cached host helpers, plus
    // Object.prototype methods (toString / valueOf / hasOwnProperty).
    if tag == TAG_FUNCTION {
        // Numeric / other keys ToString — `fn[0]` reads from the
        // expando bag at key "0" alongside named props.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_proto:  int = 0;
            let is_call:   int = 0;
            let is_apply:  int = 0;
            let is_length: int = 0;
            raw {
                is_proto  = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0;
                is_call   = (kn == 4 && memcmp(kd, "call",      4) == 0) ? 1 : 0;
                is_apply  = (kn == 5 && memcmp(kd, "apply",     5) == 0) ? 1 : 0;
                is_length = (kn == 6 && memcmp(kd, "length",    6) == 0) ? 1 : 0;
            }
