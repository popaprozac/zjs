                break;
            } else if zjs_is_closure(callee) != 0 {
                let cl = zjs_as_closure(callee);
                let fp2 = cl.function;
                let target2: Function* = NULL;
                raw { target2 = (Function*)fp2; }
                if !is_method && target2.is_class_constructor {
                    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                                (char*)"Class constructor cannot be invoked without 'new'", 50);
                    throwing = true; thrown = err; exit_reason = 3;
                    ctx.frames[cur_idx].ip = ip + 1; break;
                }
                ctx.frames[cur_idx].ip = ip + 1;
                push_call_frame(ctx, target2, argv_ptr, argc, dst);
                if target2.is_async { wire_async_call(ctx, target2, regs_base, dst); }
                if is_method {
                    ctx.host_this = new_this;
                } else if ctx.realm.global_this_obj != NULL {
                    ctx.host_this = zjs_cell_from_ptr((void*)ctx.realm.global_this_obj);
                } else {
                    ctx.host_this = zjs_undefined();
                }
                ctx.current_closure = cl;
                exit_reason = 2;
                break;
            } else if zjs_is_host_function(callee) != 0 {
                let hf_ptr = zjs_cell_as_ptr(callee);
                let saved_this = ctx.host_this;
                ctx.host_this = new_this;
                let saved_host_fn = ctx.current_host_fn;
                ctx.current_host_fn = hf_ptr;
                let r: ZjsValue = zjs_undefined();
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    ZjsRealm* _sr_realm = ctx->realm;
                    if (hf->realm) ctx->realm = hf->realm;
                    r = fp(ctx, argv_ptr, argc); ctx->realm = _sr_realm;
                }
                ctx.current_host_fn = saved_host_fn;
                ctx.host_this = saved_this;
                regs[dst] = r;
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
