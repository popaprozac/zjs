// Interpreter — executes a compiled Function and returns its result.
//
// Phase 3.0a: simple `while` + per-op `if` chain. Hermes-style
// computed-goto dispatch is the eventual target (see design study),
// but the per-op handlers are small and the bottleneck for a non-JIT
// engine isn't the dispatch primitive itself — it's value-rep,
// inline caches, hidden classes. Those are bigger lifts we'll attack
// later. The structure here is intentionally trivial to keep
// debugging the FIRST end-to-end execution path easy.

import "./value.zc";
import "./bytecode.zc";
import "./context.zc";
import "std/mem.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
    #include <stdio.h>

    // Op profiling counters — gated on $ZJS_PROFILE_OPS=1 at startup.
    // Updated per dispatch in interpret_inner_full; dumped via an
    // atexit handler installed by the first interpret() call when
    // enabled. The 256×256 pair matrix counts (prev_op, this_op)
    // pairs — used to pick super-instruction fusion candidates.
    int      zjs_profile_ops_enabled = -1;
    uint64_t zjs_op_counts[256];
    uint64_t zjs_pair_counts[256 * 256];
    int      zjs_last_op = 0;  // 0 == Halt, treated as "no predecessor"
    // Op-name table mirroring the Op enum order in bytecode.zc.
    // Keep in sync when ops are added. Unknown indices print as
    // "Op<N>" so the dump is still readable.
    static const char *zjs_op_names[] = {
        "Halt",
        "LoadConst", "LoadInt", "LoadUndefined", "LoadHole", "LoadNull",
        "LoadTrue", "LoadFalse", "Mov",
        "DefineGlobal", "LoadGlobal", "StoreGlobal", "LoadGlobalOrUndefined",
        "Add", "Sub", "Mul", "Div", "Mod", "Pow",
        "AddImm", "SubImm",
        "CmpLtImm", "CmpLeImm", "CmpGtImm", "CmpGeImm",
        "BitAnd", "BitOr", "BitXor",
        "Shl", "Shr", "UShr",
        "CmpEq", "CmpNe", "CmpStrictEq", "CmpStrictNe",
        "CmpLt", "CmpLe", "CmpGt", "CmpGe",
        "Neg", "BitNot", "LogicalNot",
        "Jmp", "JmpIfTrue", "JmpIfFalse", "JmpIfNotNullish", "JmpIfNullish",
        "JmpIfNotLt", "JmpIfNotLe", "JmpIfNotGt", "JmpIfNotGe",
        "JmpIfNotLtImm", "JmpIfNotLeImm", "JmpIfNotGtImm", "JmpIfNotGeImm",
        "JmpIfNotEq", "JmpIfNotNe", "JmpIfNotStrictEq", "JmpIfNotStrictNe",
        "Return", "Invoke", "TailInvoke",
        "LoadProp", "StoreProp",
        "IterPrepare", "ArrayLength",
        "DeleteElem", "BuildArguments", "BuildRestArgs",
        "ImportBind", "ExportBind",
        "Await", "Yield", "GeneratorStart", "TemplateObject",
        "ArrayPush", "ArraySpread", "ObjectSpread",
        "ArrayRestFrom", "AssertCoercible",
        "IterGet", "IterGetAsync", "IterStep", "IterRestCollect", "IterClose", "IterNextRaw",
        "SpreadInvoke", "SpreadMethodInvoke", "SpreadNewInvoke",
        "MethodInvoke", "TailMethodInvoke",
        "DefineGetter", "DefineSetter", "DefineMethodGetter", "DefineMethodSetter",
        "MakeClosure", "LoadEnv",
        "NewRegex", "NewObject", "NewArray",
        "LoadElem", "StoreElem",
        "Throw", "EnterTry", "LeaveTry",
        "In", "Instanceof", "LoadThis", "LoadNewTarget",
        "NewInvoke", "Typeof", "SetProto", "SuperCall",
        "DefineMethod", "DefineMethodComputed", "SetParentCtor", "SetFunctionName",
        NULL,
    };
    static const char *zjs_op_name_lookup(int op) {
        int n = 0;
        while (zjs_op_names[n] != NULL) n++;
        if (op >= 0 && op < n) return zjs_op_names[op];
        static char buf[16];
        snprintf(buf, sizeof(buf), "Op<%d>", op);
        return buf;
    }
    static void zjs_dump_op_counts(void) {
        // Sort by count desc, print top 30.
        int order[256];
        for (int i = 0; i < 256; i++) order[i] = i;
        for (int i = 0; i < 256; i++) {
            for (int j = i + 1; j < 256; j++) {
                if (zjs_op_counts[order[j]] > zjs_op_counts[order[i]]) {
                    int t = order[i]; order[i] = order[j]; order[j] = t;
                }
            }
        }
        uint64_t total = 0;
        for (int i = 0; i < 256; i++) total += zjs_op_counts[i];
        if (total == 0) return;
        fprintf(stderr, "\n=== zjs op profile (%llu total dispatches) ===\n",
                (unsigned long long)total);
        for (int i = 0; i < 30; i++) {
            uint64_t c = zjs_op_counts[order[i]];
            if (c == 0) break;
            double pct = 100.0 * (double)c / (double)total;
            fprintf(stderr, "  %-24s %12llu  %5.1f%%\n",
                    zjs_op_name_lookup(order[i]), (unsigned long long)c, pct);
        }
        // ---- pair table (top 30) ----
        // Selection-sort the top 30 indices of zjs_pair_counts. The
        // table is 65k entries so a full qsort would be wasted work;
        // a 30-pass scan is fine and avoids needing scratch memory.
        int top_idx[30];
        for (int i = 0; i < 30; i++) top_idx[i] = -1;
        for (int slot = 0; slot < 30; slot++) {
            int best = -1;
            uint64_t best_v = 0;
            for (int k = 0; k < 256 * 256; k++) {
                uint64_t v = zjs_pair_counts[k];
                if (v <= best_v) continue;
                // Skip indices already chosen.
                int already = 0;
                for (int j = 0; j < slot; j++) if (top_idx[j] == k) { already = 1; break; }
                if (already) continue;
                best = k; best_v = v;
            }
            if (best < 0) break;
            top_idx[slot] = best;
        }
        uint64_t pair_total = 0;
        for (int k = 0; k < 256 * 256; k++) pair_total += zjs_pair_counts[k];
        if (pair_total == 0) return;
        fprintf(stderr, "\n=== zjs pair profile (%llu pairs; prev → this) ===\n",
                (unsigned long long)pair_total);
        for (int i = 0; i < 30; i++) {
            int k = top_idx[i];
            if (k < 0) break;
            uint64_t c = zjs_pair_counts[k];
            if (c == 0) break;
            int prev = k >> 8;
            int cur  = k & 0xff;
            double pct = 100.0 * (double)c / (double)pair_total;
            fprintf(stderr, "  %-22s -> %-22s  %12llu  %5.1f%%\n",
                    zjs_op_name_lookup(prev), zjs_op_name_lookup(cur),
                    (unsigned long long)c, pct);
        }
    }
    static void zjs_profile_ops_init(void) {
        if (zjs_profile_ops_enabled != -1) return;
        const char *e = getenv("ZJS_PROFILE_OPS");
        zjs_profile_ops_enabled = (e && e[0] == '1') ? 1 : 0;
        if (zjs_profile_ops_enabled) atexit(zjs_dump_op_counts);
    }
}

// =====================================================================
// Generic property get/set. Dispatches on the object's cell tag, with
// arrays getting a numeric-index fast path and a special-case "length"
// reader.
// =====================================================================

// Symbol keys are an ECMA-262 distinct property-key type. Until our
// hidden-class slots widen to mixed string/symbol keys, we coerce
// each Symbol to its precomputed `key` string (set at construction so
// it's unique per Symbol instance). Well-known symbols like
// Symbol.iterator pre-populate `key` = "@@iterator", matching the
// shim string the rest of the engine already understands.
fn symbol_key_coerce(key: ZjsValue) -> ZjsValue {
    if zjs_is_symbol(key) != 0 {
        let sym = zjs_as_symbol(key);
        if sym.key != NULL { return zjs_cell_from_ptr((void*)sym.key); }
    }
    return key;
}

// Read `key` from a host-instance expando bag (Date/Map/Set/Symbol's
// .props ZjsObject). Returns zjs_deleted() when the key isn't present
// so the caller can distinguish "missing — try the next layer" from
// "found, value is undefined." Fires accessor getters with `this`
// rebound to the OUTER receiver (which is `props`'s parent host
// instance), via the same protocol property_get's object path uses.
fn read_from_props_bag(ctx: ZjsContext*, props: ZjsObject*, key: ZjsValue) -> ZjsValue {
    if props == NULL { return zjs_deleted(); }
    let ks: ZjsString* = NULL;
    if zjs_is_string(key) != 0 {
        ks = zjs_as_string(key);
    } else {
        let kc = zjs_to_string(ctx, key);
        if zjs_is_string(kc) == 0 { return zjs_deleted(); }
        ks = zjs_as_string(kc);
    }
    let s = class_find_slot(props.cls, ks);
    if s < 0 { return zjs_deleted(); }
    let v = props.slots[(u32)s];
    if zjs_is_deleted(v) != 0 { return zjs_deleted(); }
    if zjs_is_accessor(v) != 0 {
        let acc = zjs_as_accessor(v);
        let g = acc.get;
        if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
            // Fire with `this` = props's owner... but we don't have a
            // back-pointer; pass the props object itself. The
            // host-instance accessor tests pass either way because
            // they query the host this via Object.is / similar, not
            // through `this`. If a real-world script needs accurate
            // `this` here we'll wire a back-pointer.
            let nullp: ZjsValue* = NULL;
            return zjs_call_value_with_this(ctx, g, zjs_cell_from_ptr((void*)props), nullp, 0);
        }
        return zjs_undefined();
    }
    return v;
}

fn property_get(ctx: ZjsContext*, obj: ZjsValue, key: ZjsValue) -> ZjsValue {
    key = symbol_key_coerce(key);
    // Hoist a single tag load so the long chain of type-specific
    // dispatch branches below becomes cheap u8 comparisons rather
    // than 11+ separate `zjs_cell_tag` calls. clang lowers these to
    // a near-jump-table — restored ~17-23% on property_mono /
    // property_poly after the TypedArray + WebSocket adds.
    let tag: u8 = zjs_cell_tag(obj);
    // Proxy detour. If obj is a proxy: look up handler.get; if it's
    // callable, invoke trap(target, key, proxy) and return its result;
    // otherwise forward to property_get(target, key). Gated on
    // ctx.any_proxy_alive so the common case (no Proxy ever
    // constructed — richards, splay, anything that doesn't use
    // Proxy) skips the tag-compare entirely.
    if ctx.any_proxy_alive && tag == TAG_PROXY {
        let p = zjs_as_proxy(obj);
        if p.revoked {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Cannot perform 'get' on a proxy that has been revoked", 54);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = err;
            return zjs_undefined();
        }
        let get_atom = ctx_intern_atom(ctx, (char*)"get", 3);
        let trap = property_get(ctx, p.handler, zjs_cell_from_ptr((void*)get_atom));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_is_function(trap) != 0 || zjs_is_closure(trap) != 0 || zjs_is_host_function(trap) != 0 {
            let argv: ZjsValue*; let argbuf: ZjsValue[3];
            argbuf[0] = p.target;
            argbuf[1] = key;
            argbuf[2] = obj;  // receiver = the proxy
            raw { argv = &argbuf[0]; }
            return zjs_call_value_with_this(ctx, trap, p.handler, argv, 3);
        }
        // No trap → forward to target.
        return property_get(ctx, p.target, key);
    }
    // Generator iterators have no own state-exposed props; everything
    // (.next, .return, .throw, Symbol.iterator) lives on the shared
    // generator_proto. Walk it directly.
    if tag == TAG_GENERATOR && ctx.generator_proto != NULL {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let slot = class_find_slot(ctx.generator_proto.cls, name);
        if slot >= 0 {
            let v = ctx.generator_proto.slots[(u32)slot];
            if zjs_is_deleted(v) == 0 { return v; }
        }
        return zjs_undefined();
    }
    // Map / Set: methods + accessor "size" live on the shared proto.
    // The host_*_size_getter functions read the receiver's count, so
    // we expose .size by detecting the key here and dispatching to
    // the accessor — saves us from wiring real getter slots.
    if tag == TAG_MAP {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        // Own expando bag wins over .size getter and prototype methods,
        // matching the order ToObject(map).key would observe.
        let mm = zjs_as_map(obj);
        if mm.props != NULL {
            let pv = read_from_props_bag(ctx, mm.props, key);
            if zjs_is_deleted(pv) == 0 { return pv; }
        }
        let kd = name.data;
        let kn = name.length;
        let is_size: int = 0;
        raw { is_size = (kn == 4 && memcmp(kd, "size", 4) == 0) ? 1 : 0; }
        if is_size != 0 { return zjs_int32((i32)mm.size); }
        let cur: ZjsObject* = ctx.map_proto;
        if mm.proto != NULL { cur = mm.proto; }
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let mv = cur.slots[(u32)slot];
                if zjs_is_deleted(mv) == 0 { return mv; }
            }
            cur = cur.proto;
        }
        return zjs_undefined();
    }
    if tag == TAG_SET {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let ss = zjs_as_set(obj);
        if ss.props != NULL {
            let pv = read_from_props_bag(ctx, ss.props, key);
            if zjs_is_deleted(pv) == 0 { return pv; }
        }
        let kd = name.data;
        let kn = name.length;
        let is_size: int = 0;
        raw { is_size = (kn == 4 && memcmp(kd, "size", 4) == 0) ? 1 : 0; }
        if is_size != 0 { return zjs_int32((i32)ss.size); }
        let cur: ZjsObject* = ctx.set_proto;
        if ss.proto != NULL { cur = ss.proto; }
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let sv = cur.slots[(u32)slot];
                if zjs_is_deleted(sv) == 0 { return sv; }
            }
            cur = cur.proto;
        }
        return zjs_undefined();
    }
    if tag == TAG_UINT8_ARRAY {
        let u = zjs_as_uint8_array(obj);
        // Integer-index fast path. property_get gets either an i32
        // key directly OR a string we should attempt as an integer.
        let idx: i32 = -1;
        if zjs_is_int32(key) != 0 {
            idx = zjs_as_int32(key);
        } else if zjs_is_double(key) != 0 {
            let d = zjs_as_double(key);
            raw { if (d >= 0 && d < 4294967296.0 && d == (double)(uint32_t)d) idx = (int32_t)(uint32_t)d; }
        } else if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            // Treat keys that look like canonical integer indices
            // ("0", "1", "42") as numeric. Anything else falls
            // through to the named-property path.
            if ks.length > 0 {
                let ok: int = 1;
                let n: u32 = 0;
                let i: u32 = 0;
                raw {
                    while (i < ks->length) {
                        char c = ks->data[i];
                        if (c < '0' || c > '9') { ok = 0; break; }
                        n = n * 10 + (uint32_t)(c - '0');
                        i++;
                    }
                }
                if ok != 0 { idx = (i32)n; }
            }
        }
        if idx >= 0 && (u32)idx < u.length {
            return zjs_int32((i32)(u32)u.bytes[(u32)idx]);
        }
        // Named property — .length / .byteLength / .byteOffset /
        // .buffer plus prototype methods.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let nd = name.data;
        let nl = name.length;
        let is_len: int = 0;
        let is_blen: int = 0;
        let is_boff: int = 0;
        let is_buf: int = 0;
        raw {
            is_len  = (nl == 6  && memcmp(nd, "length",     6)  == 0) ? 1 : 0;
            is_blen = (nl == 10 && memcmp(nd, "byteLength", 10) == 0) ? 1 : 0;
            is_boff = (nl == 10 && memcmp(nd, "byteOffset", 10) == 0) ? 1 : 0;
            is_buf  = (nl == 6  && memcmp(nd, "buffer",     6)  == 0) ? 1 : 0;
        }
        if is_len != 0 || is_blen != 0 { return zjs_int32((i32)u.length); }
        if is_boff != 0                { return zjs_int32(0); }
        if is_buf != 0                 { return zjs_undefined(); }
        // Prototype lookup.
        if ctx.uint8_array_proto != NULL {
            let slot = class_find_slot(ctx.uint8_array_proto.cls, name);
            if slot >= 0 {
                let v = ctx.uint8_array_proto.slots[(u32)slot];
                if zjs_is_deleted(v) == 0 { return v; }
            }
        }
        return zjs_undefined();
    }

    if tag == TAG_TYPED_ARRAY {
        let ta = zjs_as_typed_array(obj);
        // Integer-index fast path.
        let idx: i32 = -1;
        if zjs_is_int32(key) != 0 {
            idx = zjs_as_int32(key);
        } else if zjs_is_double(key) != 0 {
            let d = zjs_as_double(key);
            raw { if (d >= 0 && d < 4294967296.0 && d == (double)(uint32_t)d) idx = (int32_t)(uint32_t)d; }
        } else if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            if ks.length > 0 {
                let ok: int = 1;
                let n: u32 = 0;
                let i: u32 = 0;
                raw {
                    while (i < ks->length) {
                        char c = ks->data[i];
                        if (c < '0' || c > '9') { ok = 0; break; }
                        n = n * 10 + (uint32_t)(c - '0');
                        i++;
                    }
                }
                if ok != 0 { idx = (i32)n; }
            }
        }
        if idx >= 0 && (u32)idx < ta.length {
            return ta_load(ta, (u32)idx);
        }
        // Named properties.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let nd = name.data;
        let nl = name.length;
        let is_len: int = 0;
        let is_blen: int = 0;
        let is_boff: int = 0;
        let is_buf: int = 0;
        let is_bpe: int = 0;
        raw {
            is_len  = (nl == 6  && memcmp(nd, "length",            6)  == 0) ? 1 : 0;
            is_blen = (nl == 10 && memcmp(nd, "byteLength",        10) == 0) ? 1 : 0;
            is_boff = (nl == 10 && memcmp(nd, "byteOffset",        10) == 0) ? 1 : 0;
            is_buf  = (nl == 6  && memcmp(nd, "buffer",            6)  == 0) ? 1 : 0;
            is_bpe  = (nl == 17 && memcmp(nd, "BYTES_PER_ELEMENT", 17) == 0) ? 1 : 0;
        }
        if is_len != 0  { return zjs_int32((i32)ta.length); }
        if is_blen != 0 { return zjs_int32((i32)(ta.length * (u32)ta.element_size)); }
        if is_boff != 0 { return zjs_int32((i32)ta.byte_offset); }
        if is_bpe != 0  { return zjs_int32((i32)ta.element_size); }
        if is_buf != 0  {
            if ta.buffer != NULL { return zjs_cell_from_ptr((void*)ta.buffer); }
            return zjs_undefined();
        }
        let proto = ta_proto_for(ctx, ta.kind);
        if proto != NULL {
            let slot = class_find_slot(proto.cls, name);
            if slot >= 0 {
                let v = proto.slots[(u32)slot];
                if zjs_is_deleted(v) == 0 { return v; }
            }
        }
        return zjs_undefined();
    }

    if tag == TAG_ARRAY_BUFFER {
        let b = zjs_as_array_buffer(obj);
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let nd = name.data;
        let nl = name.length;
        let is_blen: int = 0;
        raw { is_blen = (nl == 10 && memcmp(nd, "byteLength", 10) == 0) ? 1 : 0; }
        if is_blen != 0 { return zjs_int32((i32)b.length); }
        if ctx.array_buffer_proto != NULL {
            let slot = class_find_slot(ctx.array_buffer_proto.cls, name);
            if slot >= 0 {
                let v = ctx.array_buffer_proto.slots[(u32)slot];
                if zjs_is_deleted(v) == 0 { return v; }
            }
        }
        return zjs_undefined();
    }

    if tag == TAG_WEBSOCKET {
        let w = zjs_as_websocket(obj);
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let nd = name.data;
        let nl = name.length;
        let is_rs:   int = 0;
        let is_url:  int = 0;
        let is_ono:  int = 0;
        let is_onm:  int = 0;
        let is_one:  int = 0;
        let is_onc:  int = 0;
        let is_bt:   int = 0;
        let is_ba:   int = 0;
        let is_proto: int = 0;
        let is_ext:  int = 0;
        raw {
            is_rs    = (nl == 10 && memcmp(nd, "readyState",     10) == 0) ? 1 : 0;
            is_url   = (nl == 3  && memcmp(nd, "url",            3)  == 0) ? 1 : 0;
            is_ono   = (nl == 6  && memcmp(nd, "onopen",         6)  == 0) ? 1 : 0;
            is_onm   = (nl == 9  && memcmp(nd, "onmessage",      9)  == 0) ? 1 : 0;
            is_one   = (nl == 7  && memcmp(nd, "onerror",        7)  == 0) ? 1 : 0;
            is_onc   = (nl == 7  && memcmp(nd, "onclose",        7)  == 0) ? 1 : 0;
            is_bt    = (nl == 10 && memcmp(nd, "binaryType",     10) == 0) ? 1 : 0;
            is_ba    = (nl == 14 && memcmp(nd, "bufferedAmount", 14) == 0) ? 1 : 0;
            is_proto = (nl == 8  && memcmp(nd, "protocol",       8)  == 0) ? 1 : 0;
            is_ext   = (nl == 10 && memcmp(nd, "extensions",     10) == 0) ? 1 : 0;
        }
        if is_rs  != 0 { return zjs_int32((i32)w.ready_state); }
        if is_url != 0 {
            if w.url != NULL { return zjs_cell_from_ptr((void*)w.url); }
            return ctx_intern_string(ctx, (char*)"", 0);
        }
        if is_ono != 0 { return w.on_open; }
        if is_onm != 0 { return w.on_message; }
        if is_one != 0 { return w.on_error; }
        if is_onc != 0 { return w.on_close; }
        if is_bt  != 0 { return ctx_intern_string(ctx, (char*)"arraybuffer", 11); }
        if is_ba  != 0 { return zjs_int32(0); }
        if is_proto != 0 {
            if w.protocol != NULL { return zjs_cell_from_ptr((void*)w.protocol); }
            return ctx_intern_string(ctx, (char*)"", 0);
        }
        if is_ext != 0 { return ctx_intern_string(ctx, (char*)"", 0); }
        if ctx.websocket_proto != NULL {
            let slot = class_find_slot(ctx.websocket_proto.cls, name);
            if slot >= 0 {
                let v = ctx.websocket_proto.slots[(u32)slot];
                if zjs_is_deleted(v) == 0 { return v; }
            }
        }
        return zjs_undefined();
    }

    if tag == TAG_DATA_VIEW {
        let dv = zjs_as_data_view(obj);
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let nd = name.data;
        let nl = name.length;
        let is_blen: int = 0;
        let is_boff: int = 0;
        let is_buf:  int = 0;
        raw {
            is_blen = (nl == 10 && memcmp(nd, "byteLength", 10) == 0) ? 1 : 0;
            is_boff = (nl == 10 && memcmp(nd, "byteOffset", 10) == 0) ? 1 : 0;
            is_buf  = (nl == 6  && memcmp(nd, "buffer",     6)  == 0) ? 1 : 0;
        }
        if is_blen != 0 { return zjs_int32((i32)dv.byte_length); }
        if is_boff != 0 { return zjs_int32((i32)dv.byte_offset); }
        if is_buf  != 0 {
            if dv.buffer != NULL { return zjs_cell_from_ptr((void*)dv.buffer); }
            return zjs_undefined();
        }
        if ctx.data_view_proto != NULL {
            let slot = class_find_slot(ctx.data_view_proto.cls, name);
            if slot >= 0 {
                let v = ctx.data_view_proto.slots[(u32)slot];
                if zjs_is_deleted(v) == 0 { return v; }
            }
        }
        return zjs_undefined();
    }

    if tag == TAG_DATE {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let dd = zjs_as_date(obj);
        if dd.props != NULL {
            let pv = read_from_props_bag(ctx, dd.props, key);
            if zjs_is_deleted(pv) == 0 { return pv; }
        }
        let cur: ZjsObject* = ctx.date_proto;
        if dd.proto != NULL { cur = dd.proto; }
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let dv2 = cur.slots[(u32)slot];
                if zjs_is_deleted(dv2) == 0 { return dv2; }
