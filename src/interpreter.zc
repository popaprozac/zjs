                        }
                        if ctx.pending_throw_active {
                            // A call in the loop threw — route to the outer-loop
                            // unwind exactly like the whole-fn hook (J11).
                            throwing = true;
                            thrown = ctx.pending_throw_value;
                            ctx.pending_throw_active = false;
                            ctx.frames[cur_idx].ip = (usize)jdeopt;
                            exit_reason = 3;
                            break;
                        }
                        ip = (usize)jdeopt;
                        // jdeopt inside the region = a fast-path miss (a value-type
                        // miss in a polymorphic loop, or an append/grow StoreElem).
                        // Don't kill OSR for the whole function: skip just this
                        // region and re-arm so a DIFFERENT loop can still compile
                        // (J12f). Bound the retries so a function of all-hostile
                        // loops eventually stops paying compile cost. Outside the
                        // region = the normal loop exit → keep the region.
                        if jdeopt >= (int)header && jdeopt <= (int)prev_ip {
                            f.jit_osr_retries = f.jit_osr_retries + 1;
                            if f.jit_osr_retries >= 3 {
                                f.jit_osr_state = 2;
                            } else {
                                f.jit_osr_skip_hdr = (i32)header;
                                f.jit_osr_code = NULL;
                                f.jit_osr_header = -1;
                                f.jit_osr_burst_hdr = 0;
                                f.jit_osr_calls = 0;
                                f.jit_osr_state = 0;
