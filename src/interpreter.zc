                    if f.jit_osr_state == 1 && f.jit_osr_header == (i32)header {
                        let jdeopt: int = -1;
                        raw {
                            #ifdef ZJS_JIT
                            ((void(*)(ZjsValue*, int*))f->jit_osr_code)(regs, &jdeopt);
                            // A call inside the loop may have realloc'd reg_stack.
                            regs = &ctx->reg_stack[regs_base];
