            if is_call   != 0 { return ctx.realm.fn_call_v; }
            if is_apply  != 0 { return ctx.realm.fn_apply_v; }
            let fp_p = zjs_cell_as_ptr(obj);
            let f_p: Function* = NULL;
            raw { f_p = (Function*)fp_p; }
            // .length short-circuits BEFORE the props lookup. Spec says
            // a function's `.length` is the expected-arg count with
            // attrs (writable:false, enumerable:false, configurable:true);
            // exposing it from the synth path means propertyHelper's
            // `delete fn.length` / `fn.length = x` probes behave
            // correctly without needing an eager slot install. Trade-off:
            // class { static length() {} } can't override .length, but
            // that's a tiny corner.
            if is_length != 0 {
                return zjs_int32((i32)f_p.expected_arg_count);
            }
            // Expando bag — fires before Object.prototype so user-set
            // properties shadow inherited methods (`fn.toString = ...`
            // wins over Object.prototype.toString) AND so a
            // SetFunctionName-installed `name` is returned before
            // falling through to the proto chain.
            if f_p.props != NULL {
                let slot = class_find_slot(f_p.props.cls, ks);
                if slot >= 0 {
                    let raw_v = f_p.props.slots[(u32)slot];
                    if zjs_is_deleted(raw_v) == 0 {
                        if zjs_is_accessor(raw_v) != 0 {
                            let acc = zjs_as_accessor(raw_v);
                            let g = acc.get;
                            if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
                                let nullp: ZjsValue* = NULL;
                                return zjs_call_value_with_this(ctx, g, obj, nullp, 0);
                            }
                            return zjs_undefined();
                        }
                        return raw_v;
                    }
                }
            }
            // Per-Function setPrototypeOf override (#287). Walked before
            // Function.prototype so the user's chosen proto wins. Same
            // accessor-getter dispatch as the closure path.
            if f_p.proto_override != NULL {
                let cur = f_p.proto_override;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 {
                            if zjs_is_accessor(v) != 0 {
                                let acc = zjs_as_accessor(v);
                                let g = acc.get;
                                if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
                                    let nullp: ZjsValue* = NULL;
                                    return zjs_call_value_with_this(ctx, g, obj, nullp, 0);
                                }
                                return zjs_undefined();
                            }
                            return v;
                        }
                    }
                    cur = cur.proto;
                }
            }
            // Walk Function.prototype (which carries the call/apply
            // helpers and the constructor link to the Function global)
            // before Object.prototype.
            if f_p.proto_override == NULL && ctx.realm.function_proto != NULL {
                let cur = ctx.realm.function_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
            if ctx.realm.object_proto != NULL {
                let cur = ctx.realm.object_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
        }
        return zjs_undefined();
    }
    // Closure: same .call / .apply behavior.
    if tag == TAG_CLOSURE {
        // Numeric / other keys ToString — matches the TAG_FUNCTION path so
        // a class-ctor closure's computed-name statics (`static [0] = x`,
        // installed under "0" in Function*.props) read back. Without this
        // an integer key skipped the whole lookup and returned undefined.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_call:  int = 0;
            let is_apply: int = 0;
            raw {
                is_call  = (kn == 4 && memcmp(kd, "call",  4) == 0) ? 1 : 0;
                is_apply = (kn == 5 && memcmp(kd, "apply", 5) == 0) ? 1 : 0;
            }
            if is_call  != 0 { return ctx.realm.fn_call_v; }
            if is_apply != 0 { return ctx.realm.fn_apply_v; }
            // §10.2.4 poison pill on a strict function's caller/arguments.
            let is_caller_c: int = 0;
            let is_args_c: int = 0;
            raw {
                is_caller_c = (kn == 6 && memcmp(kd, "caller",    6) == 0) ? 1 : 0;
                is_args_c   = (kn == 9 && memcmp(kd, "arguments", 9) == 0) ? 1 : 0;
            }
            if is_caller_c != 0 || is_args_c != 0 {
                let clc = zjs_as_closure(obj);
                let fpc2 = clc.function;
                let ffc2: Function* = NULL;
                raw { ffc2 = (Function*)fpc2; }
                // An own static method named caller/arguments shadows the
                // poison pill. Class statics live on Function*.props;
                // generic closures use cl.props.
                let own_pp_c: bool = false;
                if ffc2.props != NULL {
                    let pps2 = class_find_slot(ffc2.props.cls, ks);
                    if pps2 >= 0 && zjs_is_deleted(ffc2.props.slots[(u32)pps2]) == 0 { own_pp_c = true; }
                }
                if !own_pp_c && clc.props != NULL {
                    let pps3 = class_find_slot(clc.props.cls, ks);
                    if pps3 >= 0 && zjs_is_deleted(clc.props.slots[(u32)pps3]) == 0 { own_pp_c = true; }
                }
                if ffc2.strict && !own_pp_c {
                    let e = build_typed_error(ctx, (char*)"TypeError", 9,
                        (char*)"caller and arguments are poison pills on strict functions", 57);
                    ctx.pending_throw_active = true; ctx.pending_throw_value = e;
                    return zjs_undefined();
                }
            }
            // .prototype delegates to the wrapped Function* — same
            // lazy-create behavior as the Function path so a class
            // constructor that's been wrapped in a Closure (because
            // its body references an outer-scope binding) still
            // exposes its .prototype slot. Without this, class
            // bodies that capture outer locals silently lose their
            // method installations because DefineMethod sees an
            // undefined target.
            let is_proto: int = 0;
            raw { is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0; }
            if is_proto != 0 {
                let cl_p = zjs_as_closure(obj);
                let fp_p = cl_p.function;
                let f_p: Function* = NULL;
                raw { f_p = (Function*)fp_p; }
                if ctx.any_exotic_proto {
                    // Per-instance (generic closure) replacement first, then
                    // the shared template (class ctors keep it on f_p.props).
                    if cl_p.props != NULL {
                        let exc = object_get_exotic_proto(ctx, cl_p.props);
                        if zjs_is_undefined(exc) == 0 { return exc; }
                    }
                    if f_p.props != NULL {
                        let ex = object_get_exotic_proto(ctx, f_p.props);
                        if zjs_is_undefined(ex) == 0 { return ex; }
                    }
                }
                if f_p.proto_nonobj_set { return f_p.proto_nonobj; }
                if f_p.is_method { return zjs_undefined(); }
                if f_p.prototype == NULL {
                    let proto_v = ctx_new_object(ctx);
                    f_p.prototype = zjs_as_object(proto_v);
                    object_define_property_slot(ctx, f_p.prototype,
                        ctx_intern_atom(ctx, (char*)"constructor", 11),
                        obj, PROP_WRITABLE | PROP_CONFIGURABLE);
                    // Lazy creation — the wrapped Function* may be old.
                    gc_barrier_cell(ctx, fp_p);
                }
                return zjs_cell_from_ptr((void*)f_p.prototype);
            }
            // Closure .length / .name fall through to the wrapped
            // Function*. (Function.prototype walked below covers the
            // rest of Function.prototype.*.)
            let is_length: int = 0;
            let is_name:   int = 0;
            raw {
                is_length = (kn == 6 && memcmp(kd, "length", 6) == 0) ? 1 : 0;
                is_name   = (kn == 4 && memcmp(kd, "name",   4) == 0) ? 1 : 0;
            }
            // .length / .name short-circuit BEFORE the props lookup,
            // matching the TAG_FUNCTION path. Same trade-off — no
            // `static length()` override on closure-wrapped class
            // ctors, but the synth path is what propertyHelper's
            // descriptor probes assume.
            if is_length != 0 {
                let cl_l = zjs_as_closure(obj);
                let fp_l = cl_l.function;
                let f_l: Function* = NULL;
                raw { f_l = (Function*)fp_l; }
                return zjs_int32((i32)f_l.expected_arg_count);
            }
            if is_name != 0 {
                let cl_n = zjs_as_closure(obj);
                // Per-closure .name wins — zod's $constructor does
                // `Object.defineProperty(_, "name", { value: name })`
                // on each returned closure, and each call should yield
                // its own name. Reading through Function*.props would
                // serve back the LAST closure's name instead.
                if cl_n.props != NULL {
                    let nm_atom = ctx_intern_atom(ctx, (char*)"name", 4);
                    let s_nm = class_find_slot(cl_n.props.cls, nm_atom);
                    if s_nm >= 0 {
                        let nv = cl_n.props.slots[(u32)s_nm];
                        if zjs_is_deleted(nv) == 0 { return nv; }
                    }
                }
                let fp_n = cl_n.function;
                let f_n: Function* = NULL;
                raw { f_n = (Function*)fp_n; }
                if f_n.props != NULL {
                    let nm_atom = ctx_intern_atom(ctx, (char*)"name", 4);
                    let s_nm = class_find_slot(f_n.props.cls, nm_atom);
                    if s_nm >= 0 {
                        let nv = f_n.props.slots[(u32)s_nm];
                        if zjs_is_deleted(nv) == 0 { return nv; }
                    }
                }
                return ctx_intern_string(ctx, (char*)"", 0);
            }
            // Per-instance prototype override (Object.setPrototypeOf).
            // Walked BEFORE Function.prototype because the user explicitly
            // set this chain — they expect their proto's methods to win
            // over the default callable surface. chalk's
            //   const c = (...) => ...;
            //   Object.setPrototypeOf(c, Chalk.prototype);
            //   c.red('hi')          // → Chalk.prototype.red getter fires
            // pattern relies on this order.
            let cl_po = zjs_as_closure(obj);
            if cl_po.proto_override != NULL {
                let cur = cl_po.proto_override;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 {
                            // Accessor descriptor — invoke getter with
                            // `this` = the closure (the receiver of the
                            // original property access).
                            if zjs_is_accessor(v) != 0 {
                                let acc = zjs_as_accessor(v);
                                let g = acc.get;
                                if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
                                    let nullp: ZjsValue* = NULL;
                                    return zjs_call_value_with_this(ctx, g, obj, nullp, 0);
                                }
                                return zjs_undefined();
                            }
                            return v;
                        }
                    }
                    cur = cur.proto;
                }
                // Override is set — don't fall through to Function.prototype
                // (the user said this IS the prototype chain). Skip directly
                // to Object.prototype as the chain-walk terminator.
            }
            // Same proto walk as TAG_FUNCTION — Function.prototype first.
            // Goes before the cl.function.props check below because the
            // vast majority of closure property accesses are Function-
            // prototype methods (`bind`, `toString`, `apply.bind` …)
            // and we want the early-out before paying the load cost of
            // dereferencing cl.function.props. Caveat: a user who
            // installs an OWN property on a closure-wrapped class ctor
            // that *shadows* a Function.prototype name (e.g. setting a
            // static "bind" method) will see the Function.prototype
            // method instead of their own. Spec-strictly own should
            // shadow inherited — but no test262 test that we've seen
            // exercises this corner, and the perf win on hot closure-
            // property access paths is real (~3% richards).
            if cl_po.proto_override == NULL && ctx.realm.function_proto != NULL {
                let cur = ctx.realm.function_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
            if ctx.realm.object_proto != NULL {
                let cur = ctx.realm.object_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
            // Per-closure expando first — only set on non-class
            // closures (class ctors keep cl.props == NULL and go
            // through f.props below).
            let cl_pp = zjs_as_closure(obj);
            if cl_pp.props != NULL {
                let s_cl = class_find_slot(cl_pp.props.cls, ks);
                if s_cl >= 0 {
                    let v_cl = cl_pp.props.slots[(u32)s_cl];
                    if zjs_is_deleted(v_cl) == 0 { return v_cl; }
                }
            }
            // Closure's underlying Function.props — class ctor statics +
            // fallback for anything not on the per-instance bag.
            let fp_pp = cl_pp.function;
            let f_pp: Function* = NULL;
            raw { f_pp = (Function*)fp_pp; }
            if f_pp.props != NULL {
                let s_pp = class_find_slot(f_pp.props.cls, ks);
                if s_pp >= 0 {
                    let v_pp = f_pp.props.slots[(u32)s_pp];
                    if zjs_is_deleted(v_pp) == 0 { return v_pp; }
                }
            }
        }
        return zjs_undefined();
    }

    // Host function: .prototype (lazy), .call / .apply, .length, .name, then .props.
    if tag == TAG_HOST_FUNCTION {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_proto: int = 0;
            let is_call:  int = 0;
            let is_apply: int = 0;
            let is_length: int = 0;
            let is_name:   int = 0;
            raw {
                is_proto  = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0;
                is_call   = (kn == 4 && memcmp(kd, "call",      4) == 0) ? 1 : 0;
                is_apply  = (kn == 5 && memcmp(kd, "apply",     5) == 0) ? 1 : 0;
                is_length = (kn == 6 && memcmp(kd, "length",    6) == 0) ? 1 : 0;
                is_name   = (kn == 4 && memcmp(kd, "name",      4) == 0) ? 1 : 0;
            }
            let hf = zjs_as_host_function(obj);
            if is_proto != 0 {
                if ctx.any_exotic_proto && hf.props != NULL {
                    let ex = object_get_exotic_proto(ctx, hf.props);
                    if zjs_is_undefined(ex) == 0 { return ex; }
                }
                // Built-in (non-constructor) host functions have no
                // .prototype — return undefined rather than lazy-
                // creating one. Constructors that genuinely need it
                // (Promise, Array, Number, ...) set hf.prototype
                // explicitly during init_builtins.
                if hf.prototype == NULL { return zjs_undefined(); }
                return zjs_cell_from_ptr((void*)hf.prototype);
            }
            if is_call  != 0 { return ctx.realm.fn_call_v; }
            if is_apply != 0 { return ctx.realm.fn_apply_v; }
            // ECMA-262 §10.2.4: every built-in function exposes a
            // `length` (param count) and a `name`. Both are
            // [[Configurable]]: true so `delete fn.name` etc. must
            // actually remove them. We use a deleted-sentinel slot
            // on hf.props to record that override — check there
            // first, then synthesize the default if no override
            // exists.
            if is_length != 0 || is_name != 0 {
                if hf.props != NULL {
                    let s_ov = class_find_slot(hf.props.cls, ks);
                    if s_ov >= 0 {
                        let v_ov = hf.props.slots[(u32)s_ov];
                        if zjs_is_deleted(v_ov) != 0 { return zjs_undefined(); }
                        return v_ov;
                    }
                }
                if is_length != 0 { return zjs_int32((i32)hf.arity); }
                if hf.name == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
                let n_len: usize = 0;
                raw { n_len = strlen(hf->name); }
                return ctx_intern_string(ctx, hf.name, (u32)n_len);
            }
            if hf.props != NULL {
                let slot = class_find_slot(hf.props.cls, ks);
                if slot >= 0 {
                    let raw_v = hf.props.slots[(u32)slot];
                    if zjs_is_deleted(raw_v) == 0 {
                        if zjs_is_accessor(raw_v) != 0 {
                            let acc = zjs_as_accessor(raw_v);
                            let g = acc.get;
                            if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
                                let nullp: ZjsValue* = NULL;
                                return zjs_call_value_with_this(ctx, g, obj, nullp, 0);
                            }
                            return zjs_undefined();
                        }
                        return raw_v;
                    }
                }
            }
            // Same Function.prototype → Object.prototype walk as the
            // other callable cases.
            if ctx.realm.function_proto != NULL {
                let cur = ctx.realm.function_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
            // Fall back through Object.prototype so methods like
            // hasOwnProperty / toString / valueOf are reachable on a
            // host function the same way they are on a plain object.
            if ctx.realm.object_proto != NULL {
                let cur = ctx.realm.object_proto;
                while cur != NULL {
                    let s = class_find_slot(cur.cls, ks);
                    if s >= 0 {
                        let v = cur.slots[(u32)s];
                        if zjs_is_deleted(v) == 0 { return v; }
                    }
                    cur = cur.proto;
                }
            }
        }
        return zjs_undefined();
    }

    // Promise cell — read through Promise.prototype (then / catch).
    if tag == TAG_PROMISE && zjs_is_string(key) != 0 {
        let pcell = zjs_as_promise(obj);
        // Own instance props first (e.g. an overridden `p.then = fn`, or
        // library tags `p.foo = 1`). NULL for nearly all promises → the proto
        // walk below is unchanged for the common case.
        if pcell.props != NULL {
            let ownv = read_from_props_bag(ctx, pcell.props, key);
            if zjs_is_deleted(ownv) == 0 { return ownv; }
        }
        let cur = if pcell.proto != NULL { pcell.proto } else { ctx.realm.promise_ctor_proto };
        if cur != NULL {
            let ks = zjs_as_string(key);
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 { return cur.slots[(u32)slot]; }
                cur = cur.proto;
            }
            return zjs_undefined();
        }
    }

    // RegExp cell — `.source`, `.flags`, `.global`, `.ignoreCase`,
    // `.multiline`, `.lastIndex` are read from the cell; everything
    // else (test, exec, ...) flows through RegExp.prototype.
    if tag == TAG_REGEXP {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let r = zjs_as_regexp(obj);
        let ks = zjs_as_string(key);
        let kd = ks.data;
        let kn = ks.length;
        let is_source: int = 0;
        let is_flags:  int = 0;
        let is_global: int = 0;
        let is_icase:  int = 0;
        let is_mline:  int = 0;
        let is_sticky: int = 0;
        let is_dotall: int = 0;
        let is_last:   int = 0;
        raw {
            is_source = (kn == 6  && memcmp(kd, "source",     6)  == 0) ? 1 : 0;
            is_flags  = (kn == 5  && memcmp(kd, "flags",      5)  == 0) ? 1 : 0;
            is_global = (kn == 6  && memcmp(kd, "global",     6)  == 0) ? 1 : 0;
            is_icase  = (kn == 10 && memcmp(kd, "ignoreCase", 10) == 0) ? 1 : 0;
            is_mline  = (kn == 9  && memcmp(kd, "multiline",  9)  == 0) ? 1 : 0;
            is_sticky = (kn == 6  && memcmp(kd, "sticky",     6)  == 0) ? 1 : 0;
            is_dotall = (kn == 6  && memcmp(kd, "dotAll",     6)  == 0) ? 1 : 0;
            is_last   = (kn == 9  && memcmp(kd, "lastIndex",  9)  == 0) ? 1 : 0;
        }
        if is_source != 0 {
            if r.source == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
            return zjs_cell_from_ptr((void*)r.source);
        }
        if is_flags != 0 {
            if r.flags_str == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
            return zjs_cell_from_ptr((void*)r.flags_str);
        }
        if is_global != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_GLOBAL)      != 0 { 1 } else { 0 }); }
        if is_icase  != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_IGNORE_CASE) != 0 { 1 } else { 0 }); }
        if is_mline  != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_MULTILINE)   != 0 { 1 } else { 0 }); }
        if is_sticky != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_STICKY)      != 0 { 1 } else { 0 }); }
        if is_dotall != 0 { return zjs_bool(if (r.flags & REGEX_FLAG_DOTALL)      != 0 { 1 } else { 0 }); }
        if is_last   != 0 { return zjs_int32((i32)r.last_index); }
        // Expando bag — user-set keys win over inherited methods. Fire
        // accessors with `this = regex`.
        if r.props != NULL {
            let slot = class_find_slot(r.props.cls, ks);
            if slot >= 0 {
                let raw_v = r.props.slots[(u32)slot];
                if zjs_is_deleted(raw_v) == 0 {
                    if zjs_is_accessor(raw_v) != 0 {
                        let acc = zjs_as_accessor(raw_v);
                        let g = acc.get;
                        if zjs_is_function(g) != 0 || zjs_is_closure(g) != 0 || zjs_is_host_function(g) != 0 {
                            let nullp: ZjsValue* = NULL;
                            return zjs_call_value_with_this(ctx, g, obj, nullp, 0);
                        }
                        return zjs_undefined();
                    }
                    return raw_v;
                }
            }
        }
        // Methods + everything else through the prototype.
        let cur: ZjsObject* = ctx.realm.regexp_proto;
        if r.proto != NULL { cur = r.proto; }
        while cur != NULL {
            let slot = class_find_slot(cur.cls, ks);
            if slot >= 0 {
                let rv2 = cur.slots[(u32)slot];
                if zjs_is_deleted(rv2) == 0 { return rv2; }
            }
            cur = cur.proto;
        }
        return zjs_undefined();
    }

    // Primitive proto walks. ECMA-262 ToObject for property access on
    // a primitive yields a wrapper whose prototype carries valueOf /
    // toString / etc. We don't actually wrap; just walk the matching
    // global's prototype directly — same observable result for read.
    if zjs_is_string(key) != 0 {
        let proto: ZjsObject* = NULL;
        if zjs_is_bool(obj) != 0 {
            let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
            if bool_g >= 0 {
                let bv = ctx.realm.globals[bool_g].value;
                if zjs_is_host_function(bv) != 0 { proto = zjs_as_host_function(bv).prototype; }
            }
        } else if zjs_is_int32(obj) != 0 || zjs_is_double(obj) != 0 {
            let num_g = ctx_find_global(ctx, (char*)"Number", 6);
            if num_g >= 0 {
                let nv = ctx.realm.globals[num_g].value;
                if zjs_is_host_function(nv) != 0 { proto = zjs_as_host_function(nv).prototype; }
            }
        } else if zjs_is_bigint(obj) != 0 {
            let big_g = ctx_find_global(ctx, (char*)"BigInt", 6);
            if big_g >= 0 {
                let gv = ctx.realm.globals[big_g].value;
                if zjs_is_host_function(gv) != 0 { proto = zjs_as_host_function(gv).prototype; }
            }
        }
        if proto != NULL {
            let ks = zjs_as_string(key);
            let cur = proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, ks);
                if slot >= 0 {
                    let pv = cur.slots[(u32)slot];
                    if zjs_is_deleted(pv) == 0 { return pv; }
                }
                cur = cur.proto;
            }
        }
    }
    return zjs_undefined();
}

// Store to an array integer index, honoring per-element attrs (#343).
// An index defined with non-default attrs / an accessor lives in
// arr.props keyed by its stringified index; route the [[Set]] through
// the ordinary object path there so writable:false / accessor setters
// are respected (and ctx.write_rejected is armed for strict throws).
// Otherwise take the fast dense path.
fn array_index_store(ctx: ZjsContext*, arr: ZjsArray*, i: u32, value: ZjsValue) -> void {
    if arr.props != NULL {
        let buf: char[16];
        let blen: int = 0;
        raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)i); }
        let bp: char* = NULL; raw { bp = &buf[0]; }
        let katom = ctx_intern_atom(ctx, bp, (u32)blen);
        let slot = class_find_slot(arr.props.cls, katom);
        if slot >= 0 && zjs_is_deleted(arr.props.slots[(u32)slot]) == 0 {
            property_set(ctx, zjs_cell_from_ptr((void*)arr.props),
                         zjs_cell_from_ptr((void*)katom), value);
            return;
        }
    }
    array_set(arr, i, value);
}

fn property_set(ctx: ZjsContext*, obj: ZjsValue, key: ZjsValue, value: ZjsValue) -> void {
    key = symbol_key_coerce(key);
    // Same single-tag-load pattern as property_get — see comments there.
    let tag: u8 = zjs_cell_tag(obj);
    // Proxy detour. See property_get's matching block for the trap-lookup
    // pattern. Trap is called as `set(target, key, value, receiver)`.
    // Same any_proxy_alive gate to keep the common case free.
    if ctx.any_proxy_alive && tag == TAG_PROXY {
        let p = zjs_as_proxy(obj);
        if p.revoked {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Cannot perform 'set' on a proxy that has been revoked", 54);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = err;
            return;
        }
        let set_atom = ctx_intern_atom(ctx, (char*)"set", 3);
        let trap = property_get(ctx, p.handler, zjs_cell_from_ptr((void*)set_atom));
        if ctx.pending_throw_active { return; }
        if zjs_is_function(trap) != 0 || zjs_is_closure(trap) != 0 || zjs_is_host_function(trap) != 0 {
            let argv: ZjsValue*; let argbuf: ZjsValue[4];
            argbuf[0] = p.target;
            argbuf[1] = key;
            argbuf[2] = value;
            argbuf[3] = obj;
            raw { argv = &argbuf[0]; }
            let _ = zjs_call_value_with_this(ctx, trap, p.handler, argv, 4);
            return;
        }
        property_set(ctx, p.target, key, value);
        return;
    }
    if tag == TAG_UINT8_ARRAY {
        let u = zjs_as_uint8_array(obj);
        let idx: i32 = -1;
        if zjs_is_int32(key) != 0 {
            idx = zjs_as_int32(key);
        } else if zjs_is_double(key) != 0 {
            let d = zjs_as_double(key);
            raw { if (d >= 0 && d < 4294967296.0 && d == (double)(uint32_t)d) idx = (int32_t)(uint32_t)d; }
        } else if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            // Same canonical-integer probe as the read path.
            if ks.length > 0 {
                let ok: int = 1;
                let n: u32 = 0;
                let i: u32 = 0;
                raw {
                    while (i < ks->length) {
                        char c = ks->data[i];
                        if (c < '0' || c > '9') { ok = 0; break; }
                        n = n * 10 + (uint32_t)(c - '0');
                        i++;
                    }
                }
                if ok != 0 { idx = (i32)n; }
            }
        }
        if idx >= 0 && (u32)idx < u.length {
            // Spec: ToUint8(value) per https://tc39.es/ecma262/
            // #sec-touint8. NaN/Infinity/0/-0 → 0; otherwise modulo
            // 256 of the truncated integer.
            let b: u32 = 0;
            if zjs_is_int32(value) != 0 {
                b = (u32)((i32)zjs_as_int32(value) & 0xff);
            } else if zjs_is_double(value) != 0 {
                let d = zjs_as_double(value);
                let is_finite: int = 0;
                raw { is_finite = (isfinite(d) && !isnan(d)) ? 1 : 0; }
                if is_finite != 0 {
                    let t: i64 = 0;
                    raw { t = (int64_t)d; }
                    b = (u32)((u8)((t % 256 + 256) % 256));
                }
            }
            u.bytes[(u32)idx] = (u8)b;
            return;
        }
        // Out-of-bounds indices silently drop (TypedArray spec: writes
        // past length are no-ops).
        return;
    }
    if tag == TAG_WEBSOCKET {
        let w = zjs_as_websocket(obj);
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let nd = name.data;
        let nl = name.length;
        let is_ono: int = 0;
        let is_onm: int = 0;
        let is_one: int = 0;
        let is_onc: int = 0;
        raw {
            is_ono = (nl == 6 && memcmp(nd, "onopen",    6) == 0) ? 1 : 0;
            is_onm = (nl == 9 && memcmp(nd, "onmessage", 9) == 0) ? 1 : 0;
            is_one = (nl == 7 && memcmp(nd, "onerror",   7) == 0) ? 1 : 0;
            is_onc = (nl == 7 && memcmp(nd, "onclose",   7) == 0) ? 1 : 0;
        }
        if is_ono != 0 { w.on_open    = value; return; }
        if is_onm != 0 { w.on_message = value; return; }
        if is_one != 0 { w.on_error   = value; return; }
        if is_onc != 0 { w.on_close   = value; return; }
        return;
    }
    if tag == TAG_TYPED_ARRAY {
        let ta = zjs_as_typed_array(obj);
        let idx: i32 = -1;
        if zjs_is_int32(key) != 0 {
            idx = zjs_as_int32(key);
        } else if zjs_is_double(key) != 0 {
            let d = zjs_as_double(key);
            raw { if (d >= 0 && d < 4294967296.0 && d == (double)(uint32_t)d) idx = (int32_t)(uint32_t)d; }
        } else if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            if ks.length > 0 {
                let ok: int = 1;
                let n: u32 = 0;
                let i: u32 = 0;
                raw {
                    while (i < ks->length) {
                        char c = ks->data[i];
                        if (c < '0' || c > '9') { ok = 0; break; }
                        n = n * 10 + (uint32_t)(c - '0');
                        i++;
                    }
                }
                if ok != 0 { idx = (i32)n; }
            }
        }
        if idx >= 0 && (u32)idx < ta.length {
            ta_store(ctx, ta, (u32)idx, value);
        }
        return;
    }
    if tag == TAG_ARRAY {
        let arr = zjs_as_array(obj);
        if zjs_is_int32(key) != 0 {
            let i = zjs_as_int32(key);
            if i >= 0 { array_index_store(ctx, arr, (u32)i, value); }
            return;
        }
        let idx = zjs_to_array_index(key);
        if idx >= 0 { array_index_store(ctx, arr, (u32)idx, value); return; }
        // `arr.length = n` truncates / extends the array. ECMA-262
        // §10.4.2.4 ArraySetLength: a value whose ToUint32 differs from
        // its ToNumber throws RangeError; a non-writable length is a
        // [[Set]] rejection (write_rejected → strict TypeError).
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let is_length: int = 0;
            let kdata = ks.data;
            let klen  = ks.length;
            raw { is_length = (klen == 6 && memcmp(kdata, "length", 6) == 0) ? 1 : 0; }
            if is_length != 0 {
                let num = array_len_to_f64(ctx, value);
                if ctx.pending_throw_active { return; }
                let new_len: u32 = 0;
                let valid: int = 0;
                raw {
                    double n = num;
                    if (isfinite(n) && n >= 0.0 && floor(n) == n && n <= 4294967295.0) {
                        new_len = (uint32_t)n; valid = 1;
                    }
                }
                if valid == 0 {
                    let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                                (char*)"Invalid array length", 20);
                    ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                    return;
                }
                // Non-writable length (defineProperty / Object.freeze) —
                // reject the assignment.
                if arr.length_non_writable || arr.frozen {
                    ctx.write_rejected = true;
                    return;
                }
                // ArraySetLength: cap-guarded truncation + prune exotic
                // props indices. A non-configurable index blocks the
                // shrink (partial apply + rejection).
                let okk = array_set_length(ctx, arr, new_len);
                if !okk { ctx.write_rejected = true; }
                return;
            }
        }
        // Other string-keyed properties: stash on the lazy expando bag
        // so `[].foo = 1` is visible to property_get, Object.keys-like
        // walks, and Object.create's descriptor walk.
        if zjs_is_string(key) != 0 {
            if arr.frozen { return; }
            // If the expando bag already holds an ACCESSOR for this key
            // (e.g. Object.defineProperty(arr, "p", {get,set})), invoke
            // its setter — object_set below is a data-slot writer and
            // would silently clobber the accessor cell. Mirrors the
            // TAG_OBJECT [[Set]] accessor path.
            if arr.props != NULL {
                let aname = zjs_as_string(key);
                let aslot = class_find_slot(arr.props.cls, aname);
                if aslot >= 0 {
                    let av = arr.props.slots[(u32)aslot];
                    if zjs_is_deleted(av) == 0 && zjs_is_accessor(av) != 0 {
                        let acc = zjs_as_accessor(av);
                        let s = acc.set;
                        if zjs_is_function(s) != 0 || zjs_is_closure(s) != 0 || zjs_is_host_function(s) != 0 {
                            let setarg: ZjsValue[1];
                            setarg[0] = value;
                            let setargp: ZjsValue* = NULL;
                            raw { setargp = &setarg[0]; }
                            let _ = zjs_call_value_with_this(ctx, s, obj, setargp, 1);
                            ctx.write_rejected = false;
                        } else {
                            // Accessor with no setter — strict mode throws.
                            ctx.write_rejected = true;
                        }
                        return;
                    }
                }
            }
            if arr.props == NULL {
                // Adding a NEW named prop. If the array is sealed /
                // preventExtensions'd, refuse — don't materialize the
                // bag for a no-op write.
                if arr.non_extensible { return; }
                let pv = ctx_new_props_bag(ctx);
                arr.props = zjs_as_object(pv);
            }
            // Propagate the array's non_extensible to the bag so its
            // own add-new path is consistent (object_set blocks new
            // slots when non_extensible). Existing-slot writes still
            // honor PROP_WRITABLE per object_set's existing check.
            if arr.non_extensible { arr.props.non_extensible = true; }
            object_set(ctx, arr.props, zjs_as_string(key), value);
        }
        return;
    }
    if tag == TAG_OBJECT {
        let o = zjs_as_object(obj);
        let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
        // ToPropertyKey can fail (e.g., user toString() throws) — bail
        // before zjs_as_string dereferences undefined.
        if ctx.pending_throw_active { return; }
        let name = zjs_as_string(key_str_val);
        // Walk the proto chain looking for an accessor whose setter
        // should fire (Phase 3.9b). A data property on the proto means
        // we'll shadow via an own write. A DELETED slot is invisible.
        let cur = o;
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 {
                let v = cur.slots[(u32)slot];
                if zjs_is_deleted(v) == 0 {
                    if zjs_is_accessor(v) != 0 {
                        let acc = zjs_as_accessor(v);
                        let s = acc.set;
                        if zjs_is_function(s) != 0 || zjs_is_closure(s) != 0 || zjs_is_host_function(s) != 0 {
                            let arr: ZjsValue[1];
                            arr[0] = value;
                            let argp: ZjsValue* = NULL;
                            raw { argp = &arr[0]; }
                            let _ = zjs_call_value_with_this(ctx, s, obj, argp, 1);
                            // The setter ran (a successful [[Set]]); clear any
                            // rejection the setter's own writes may have left
                            // so the caller's strict-mode check isn't fooled.
                            ctx.write_rejected = false;
                        } else {
                            // Accessor with no setter — strict mode throws.
                            ctx.write_rejected = true;
                        }
                        return;
                    }
                    cur = NULL;     // data property — fall through and write our own
                } else {
                    cur = cur.proto;
                }
            } else {
                cur = cur.proto;
            }
        }
        object_set(ctx, o, name, value);
        return;
    }
    // Function: `.prototype` updates the prototype slot (Phase 3.6),
    // anything else lands on the lazy props bag — same shape as host
    // functions and array expandos. Unlocks the standard idiom
    // `fn.cnt = 0; fn.cnt++` and the test262 harness pattern
    // (`assert.sameValue = function (...) { ... }`).
    if tag == TAG_FUNCTION {
        // Coerce non-string keys (numeric indices, ToString'd) — these
        // can show up via `fn[0] = true` patterns that the test262
        // generic-array-on-fn tests exercise.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let ks = zjs_as_string(key);
        let is_proto: int = 0;
        let kd = ks.data;
        let kn = ks.length;
        raw { is_proto = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0; }
        let fp = zjs_cell_as_ptr(obj);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if is_proto != 0 {
            if zjs_is_object(value) != 0 {
                f.prototype = zjs_as_object(value);
                f.proto_nonobj_set = false;   // back to an object prototype
                gc_barrier_cell(ctx, fp);     // F may be old, value young
                if f.props != NULL { object_clear_exotic_proto(ctx, f.props); }
                return;
            }
            if proto_is_exotic(value) {
                // `foo.prototype = [array]` — instances must inherit from it.
                if f.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    f.props = zjs_as_object(pv);
                }
                object_store_exotic_proto(ctx, f.props, value);
                f.proto_nonobj_set = false;
                return;
            }
            // `.prototype = <non-object>` (undefined/null/primitive): the
            // property is writable, so record the value. The getter returns
            // it and GetPrototypeFromConstructor treats the prototype as
            // "not an object" (ctor_prototype_object returns NULL).
            f.proto_nonobj = value;
            f.proto_nonobj_set = true;
            gc_barrier_cell(ctx, fp);         // value can be a young string/symbol cell
            return;
        }
        if f.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            f.props = zjs_as_object(pv);
        }
        // Route through property_set on the props object so accessors
        // (set via `static set x(v) {}` etc.) fire their setters.
        property_set(ctx, zjs_cell_from_ptr((void*)f.props), key, value);
        return;
    }
    // Closure: class ctors share .prototype + statics through the
    // underlying Function* (one template per class declaration).
    // Generic closures get per-instance props — independent expandos
    // so writes through one don't leak to others sharing the same
    // Function* template.
    if tag == TAG_CLOSURE {
        let cl = zjs_as_closure(obj);
        let fp2 = cl.function;
        let f2: Function* = NULL;
        raw { f2 = (Function*)fp2; }
        if f2.is_class_constructor {
            if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
            let ks2 = zjs_as_string(key);
            let kd2 = ks2.data;
            let kn2 = ks2.length;
            let is_proto2: int = 0;
            raw { is_proto2 = (kn2 == 9 && memcmp(kd2, "prototype", 9) == 0) ? 1 : 0; }
            if is_proto2 != 0 {
                if zjs_is_object(value) != 0 {
                    f2.prototype = zjs_as_object(value);
                    f2.proto_nonobj_set = false;
                    gc_barrier_cell(ctx, fp2);   // shared template may be old
                    if f2.props != NULL { object_clear_exotic_proto(ctx, f2.props); }
                    return;
                }
                if proto_is_exotic(value) {
                    if f2.props == NULL {
                        let pv = ctx_new_props_bag(ctx);
                        f2.props = zjs_as_object(pv);
                    }
                    object_store_exotic_proto(ctx, f2.props, value);
                    f2.proto_nonobj_set = false;
                    return;
                }
                // `.prototype = <non-object>` — record it (see the bare-Function
                // setter for the rationale; the wrapped Function* carries it).
                f2.proto_nonobj = value;
                f2.proto_nonobj_set = true;
                gc_barrier_cell(ctx, fp2);
                return;
            }
            if f2.props == NULL {
                let pv = ctx_new_props_bag(ctx);
                f2.props = zjs_as_object(pv);
            }
            property_set(ctx, zjs_cell_from_ptr((void*)f2.props), key, value);
            return;
        }
        // Generic closure: per-instance bag.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let ks3 = zjs_as_string(key);
        let kd3 = ks3.data;
        let kn3 = ks3.length;
        let is_proto3:  int = 0;
        let is_name3:   int = 0;
        let is_length3: int = 0;
        raw {
            is_proto3  = (kn3 == 9 && memcmp(kd3, "prototype", 9) == 0) ? 1 : 0;
            is_name3   = (kn3 == 4 && memcmp(kd3, "name",      4) == 0) ? 1 : 0;
            is_length3 = (kn3 == 6 && memcmp(kd3, "length",    6) == 0) ? 1 : 0;
        }
        // A wholesale `foo.prototype = obj` replacement on a generic closure
        // can't use the shared template's prototype field (siblings share it),
        // so store it PER-INSTANCE via the exotic-proto mechanism — instances
        // delegate into it on lookup. .name / .length are sloppy-drops.
        if is_proto3 != 0 {
            if value_is_object_type(value) {
                if cl.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    cl.props = zjs_as_object(pv);
                }
                object_store_exotic_proto(ctx, cl.props, value);
            }
            return;
        }
        if is_name3 != 0 || is_length3 != 0 { return; }
        if cl.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            cl.props = zjs_as_object(pv);
        }
        property_set(ctx, zjs_cell_from_ptr((void*)cl.props), key, value);
        return;
    }
    if tag == TAG_HOST_FUNCTION {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let ks = zjs_as_string(key);
        let is_proto: int = 0;
        let is_name: int = 0;
        let is_length: int = 0;
        let kd = ks.data;
        let kn = ks.length;
        raw {
            is_proto  = (kn == 9 && memcmp(kd, "prototype", 9) == 0) ? 1 : 0;
            is_name   = (kn == 4 && memcmp(kd, "name",   4) == 0) ? 1 : 0;
            is_length = (kn == 6 && memcmp(kd, "length", 6) == 0) ? 1 : 0;
        }
        let hf = zjs_as_host_function(obj);
        if is_proto != 0 {
            if zjs_is_object(value) != 0 {
                hf.prototype = zjs_as_object(value);
                gc_barrier_cell(ctx, (void*)hf);   // built-ins are old by construction
                if hf.props != NULL { object_clear_exotic_proto(ctx, hf.props); }
                return;
            }
            if proto_is_exotic(value) {
                if hf.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    hf.props = zjs_as_object(pv);
                }
                object_store_exotic_proto(ctx, hf.props, value);
                return;
            }
            // fall through: name/length handling below for non-prototype keys
        }
        // ECMA-262 §10.2.4: built-in function `name` / `length`
        // descriptors are { writable: false, configurable: true }.
        // Sloppy mode silently ignores writes to non-writable own
        // properties. (Strict-mode TypeError would require strict-
        // tracking on the calling frame; skip for now — Hermes/qjs
        // also no-op in their default config.) If a deleted-sentinel
        // override exists in props, fall through to the normal write
        // path so post-delete reassignment recreates the property.
        if is_name != 0 || is_length != 0 {
            let overridden: bool = false;
            if hf.props != NULL {
                let s_ov = class_find_slot(hf.props.cls, ks);
                if s_ov >= 0 { overridden = true; }
            }
            if !overridden { return; }
        }
        // Arbitrary property — lazily create the props object.
        if hf.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            hf.props = zjs_as_object(pv);
        }
        property_set(ctx, zjs_cell_from_ptr((void*)hf.props), key, value);
        return;
    }
    // Date / Map / Set / Symbol expando bags — same shape as the
    // array/function/regex pattern. Lazily allocate on first set.
    if tag == TAG_DATE {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let d = zjs_as_date(obj);
        if d.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            d.props = zjs_as_object(pv);
        }
        object_set(ctx, d.props, zjs_as_string(key), value);
        return;
    }
    if tag == TAG_MAP {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let m = zjs_as_map(obj);
        if m.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            m.props = zjs_as_object(pv);
        }
        object_set(ctx, m.props, zjs_as_string(key), value);
        return;
    }
    if tag == TAG_SET {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let s = zjs_as_set(obj);
        if s.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            s.props = zjs_as_object(pv);
        }
        object_set(ctx, s.props, zjs_as_string(key), value);
        return;
    }
    if tag == TAG_SYMBOL {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let sym = zjs_as_symbol(obj);
        if sym.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            sym.props = zjs_as_object(pv);
        }
        object_set(ctx, sym.props, zjs_as_string(key), value);
        return;
    }
    if tag == TAG_REGEXP {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let r = zjs_as_regexp(obj);
        let ks = zjs_as_string(key);
        let kd = ks.data;
        let kn = ks.length;
        let is_last: int = 0;
        raw { is_last = (kn == 9 && memcmp(kd, "lastIndex", 9) == 0) ? 1 : 0; }
        if is_last != 0 {
            // ToInteger-ish: only int / non-negative-double accepted;
            // anything else clamps to 0 (matches our MVP coercion).
            if zjs_is_int32(value) != 0 {
                let n = zjs_as_int32(value);
                if n < 0 { r.last_index = 0; } else { r.last_index = (u32)n; }
            } else if zjs_is_double(value) != 0 {
                let d = zjs_as_double(value);
                if d >= 0.0 { r.last_index = (u32)d; } else { r.last_index = 0; }
            } else {
                r.last_index = 0;
            }
            return;
        }
        // Other keys (including `source`, `flags`, etc.) land on the
        // expando bag — spec treats those as non-writable own
        // properties, but until we model the read-only attribute on
        // built-in slots, the expando layer hides them.
        if r.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            r.props = zjs_as_object(pv);
        }
        object_set(ctx, r.props, ks, value);
        return;
    }
    if tag == TAG_PROMISE {
        // Promises are ordinary objects: own-prop writes (incl. an overridden
        // `p.then = fn`) land in the lazy expando bag. property_get checks it
        // before the Promise.prototype chain.
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        if ctx.pending_throw_active { return; }
        let pr = zjs_as_promise(obj);
        if pr.props == NULL {
            let pv = ctx_new_props_bag(ctx);
            pr.props = zjs_as_object(pv);
        }
        object_set(ctx, pr.props, zjs_as_string(key), value);
        return;
    }
    // Primitives: silently ignored (real JS throws in strict mode).
}

// Result of an interpret() call. `is_throw=true` means an exception
// escaped this function — the caller (a Phase 3.1c+ try frame in the
// outer function, or zjs_eval) decides whether to catch or propagate.
struct InterpretResult {
    is_throw: bool;
    value:    ZjsValue;
}

impl Copy for InterpretResult {}

struct TryFrame {
    catch_ip:  usize;
    catch_reg: u8;
}

def MAX_TRY_DEPTH: usize = 32;

// Called right after push_call_frame{_inplace} when the target turned
// out to be an async function. Allocates the outer Promise, parks it
// on the newly-pushed frame, and pre-writes it into the caller's dst
// reg so the caller already has its Promise back even if the callee
// suspends on its very first await.
fn wire_async_call(ctx: ZjsContext*, target: Function*, caller_regs_base: u32, dst: u8) -> void {
    if target == NULL { return; }
    if !target.is_async { return; }
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let p_v = zjs_cell_from_ptr((void*)p);
    ctx.reg_stack[caller_regs_base + (u32)dst] = p_v;
    ctx.frames[ctx.frame_count - 1].outer_promise = p_v;
}

// Build a generator iterator for a generator-function call. Captures
// the arg list into the iterator's reg snapshot at the parameter
// slots (matching push_call_frame's normal arg-copy semantics) so
// .next() can resume from ip=0 with the right param values. Returns
// the iterator cell as a ZjsValue.
fn make_generator_iter(ctx: ZjsContext*, target: Function*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let g = zjs_generator_new();
    ctx_register_cell(ctx, (void*)g);
    g.function = target;
    g.reg_count = target.register_count;
    g.saved_ip = 0;
    g.state = GEN_INITIAL;
    g.saved_host_this = ctx.host_this;
    g.saved_current_closure = ctx.current_closure;
    // Heap-allocate the snapshot buffer and prime it like a freshly
    // pushed frame would: copy min(argc, param_count) args into the
    // first registers; init the rest to undefined.
    g.saved_regs = alloc_n<ZjsValue>((usize)target.register_count);
    let copy_count: u32 = if argc < target.param_count { argc } else { target.param_count };
    let i: u32 = 0;
    while i < copy_count {
        g.saved_regs[i] = args[i];
        i = i + 1;
    }
    let undef = zjs_undefined();
    let j: u32 = i;
    while j < target.register_count {
        g.saved_regs[j] = undef;
        j = j + 1;
    }
    return zjs_cell_from_ptr((void*)g);
}

// Build the iterator-result object `{ value, done }`.
fn build_iter_result(ctx: ZjsContext*, value: ZjsValue, done: bool) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"value", 5), value);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"done", 4), zjs_bool(if done { 1 } else { 0 }));
    return obj_v;
}

// ===================================================================
// Copy-and-patch JIT — engine-side hot-function dispatch (ZJS_JIT only).
//
// A function whose ENTIRE body is in the JIT's faithful op subset (pure
// register arithmetic + loops, single Return, no calls/property/global
// access) is compiled once and cached on the Function*. The dispatch loop
// runs the cached code from the live frame at ip==0; a deopt (a non-number
// reaches arithmetic, or a hole) discards the run and falls back to the
// interpreter — SAFE because the subset is side-effect-free, so nothing was
// committed. Off by default in non-JIT builds; runtime-toggleable via
// ZJS_JIT_OFF / ZJS_JIT_THRESHOLD. Never iOS. See docs/jit-impl-notes.md.
// ===================================================================
struct JitFnDesc { op: char*; ra: i32; rb: i32; rc: i32; imm: i64; target: i32; bc_index: i32; }

raw {
    // Lazy, process-wide. -1 = uninit.
    static int g_jit_enabled = -1;     // 0 = off (ZJS_JIT_OFF set), 1 = on
    static int g_jit_threshold = -1;   // frame-entries before compile
    static int g_jit_osr_work = -1;    // J12f: burst-len × region-span gate
}

// Compile-time gate: 1 only in a ZJS_JIT build. clang folds this to a
// constant, so the hot-dispatch hook below is dead-eliminated in the
// default/iOS build (zero cost).
fn jit_build_enabled() -> int {
    let v: int = 0;
    raw {
        #ifdef ZJS_JIT
        v = 1;
        #endif
    }
    return v;
}

fn jit_runtime_enabled() -> int {
    let on: int = 0;
    raw {
        if (g_jit_enabled < 0) {
            const char* off = getenv("ZJS_JIT_OFF");
            g_jit_enabled = (off && off[0] && off[0] != '0') ? 0 : 1;
        }
        on = g_jit_enabled;
    }
    return on;
}

fn jit_set_runtime_enabled(v: int) -> void {
    raw { g_jit_enabled = v ? 1 : 0; }
}

fn jit_hot_threshold() -> u32 {
    let t: u32 = 8;
    raw {
        if (g_jit_threshold < 0) {
            const char* s = getenv("ZJS_JIT_THRESHOLD");
            g_jit_threshold = (s && s[0]) ? atoi(s) : 8;
            if (g_jit_threshold < 0) g_jit_threshold = 0;
        }
        t = (unsigned)g_jit_threshold;
    }
    return t;
}

// J12f OSR-entry gate: the minimum "work per run" (burst length × region
// instruction span) before a hot loop is OSR-compiled. OSR pays a fixed
// entry/exit spill-fill cost per loop entry; a loop only beats the interpreter
// if it executes enough ops per entry to amortize that. Counting *ops*
// (burst × span) rather than raw iterations is what separates nbody's force
// kernel (≈4 iters but ~90-instruction body → wins) from quicksort's pivot
// scan (≈2 iters, ~4-instruction body → loses on entry overhead). Tunable via
// ZJS_JIT_OSR_WORK; default chosen so quicksort's tiny scans stay under it and
// every measured OSR winner clears it. 0 disables the gate (compile any loop).
fn jit_osr_work_threshold() -> u32 {
    let t: u32 = 160;
    raw {
        if (g_jit_osr_work < 0) {
            const char* s = getenv("ZJS_JIT_OSR_WORK");
            g_jit_osr_work = (s && s[0]) ? atoi(s) : 160;
            if (g_jit_osr_work < 0) g_jit_osr_work = 0;
        }
        t = (unsigned)g_jit_osr_work;
    }
    return t;
}

// Fused 2-slot compare-branch ops: operands live in slot J, the i16
// offset in the carrier slot J+1 (emitted as an Op::Jmp placeholder).
// Keep in sync with compiler.zc is_fused_branch_op.
fn op_is_fused_cmp_branch(op_: Op) -> bool {
    if op_ == Op::JmpIfNotLt  || op_ == Op::JmpIfNotLe
    || op_ == Op::JmpIfNotGt  || op_ == Op::JmpIfNotGe
    || op_ == Op::JmpIfNotLtImm || op_ == Op::JmpIfNotLeImm
    || op_ == Op::JmpIfNotGtImm || op_ == Op::JmpIfNotGeImm
    || op_ == Op::JmpIfNotEq   || op_ == Op::JmpIfNotNe
    || op_ == Op::JmpIfNotStrictEq || op_ == Op::JmpIfNotStrictNe
    || op_ == Op::JmpIfLt  || op_ == Op::JmpIfLe
    || op_ == Op::JmpIfGt  || op_ == Op::JmpIfGe
    || op_ == Op::JmpIfLtImm || op_ == Op::JmpIfLeImm
    || op_ == Op::JmpIfGtImm || op_ == Op::JmpIfGeImm {
        return true;
    }
    return false;
}

// Does f contain a back-edge (a backward branch)? Such a function is a loop:
// its body dominates runtime independent of how often the function is *called*.
// A top-level script with a `for` loop is entered once but iterates millions
// of times, so the call-count hotness gate never trips for it. Compiling loopy
// functions on first entry (instead of after N calls) is what unlocks the
// top-level numeric-loop benches (int_loop/double_loop). Cheap one-pass scan.
fn jit_fn_has_backedge(f: Function*) -> bool {
    let n: u32 = (u32)f.code_len;
    let i: u32 = 0;
    while i < n {
        let inst = f.code[i];
        if inst.op == Op::Jmp || inst.op == Op::JmpIfTrue
           || inst.op == Op::JmpIfFalse || inst.op == Op::JmpIfNotNullish
           || inst.op == Op::JmpIfNullish {
            if inst_bc_i16(inst) < 0 { return true; }
        } else if op_is_fused_cmp_branch(inst.op) {
            // Offset lives in the carrier slot; read it there and skip
            // the carrier so its Jmp placeholder bytes aren't double-
            // read as a separate (phantom) jump.
            if i + 1 < n && inst_bc_i16(f.code[i + 1]) < 0 { return true; }
            i = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// Map one bytecode instruction at index i into descs[i] (op + imm + target),
// the single source of truth shared by the whole-function compile and the OSR
// loop compile. Caller pre-sets descs[i] defaults (ra/rb/rc from the inst,
// imm=0, target=-1, bc_index). Returns 1 if mapped, 0 if unmappable. Jump
// targets are ABSOLUTE bytecode indices (i + offset + 1); for the whole
// function that equals the prog index, for an OSR region the caller rebases
// them. Fused 2-slot compares mark their offset-carrier slot (i+1) as a Nop.
// Return maps to "Return" (the caller decides whether that's allowed).
fn jit_map_insn(f: Function*, i: u32, descs: JitFnDesc*, n: u32) -> i32 {
    let inst = f.code[i];
    if inst.op == Op::LoadInt {
        descs[i].op = (char*)"LoadConst";
        descs[i].imm = (i64)zjs_int32(inst_bc_i16(inst)).bits;
    } else if inst.op == Op::LoadConst {
        descs[i].op = (char*)"LoadConst";
        descs[i].imm = (i64)f.constants[(u32)inst_bc_u16(inst)].bits;
    } else if inst.op == Op::LoadUndefined {
        descs[i].op = (char*)"LoadConst"; descs[i].imm = (i64)zjs_undefined().bits;
    } else if inst.op == Op::LoadNull {
        descs[i].op = (char*)"LoadConst"; descs[i].imm = (i64)zjs_null().bits;
    } else if inst.op == Op::LoadTrue {
        descs[i].op = (char*)"LoadConst"; descs[i].imm = (i64)zjs_bool(1).bits;
    } else if inst.op == Op::LoadFalse {
        descs[i].op = (char*)"LoadConst"; descs[i].imm = (i64)zjs_bool(0).bits;
    } else if inst.op == Op::LoadHole {
        descs[i].op = (char*)"LoadConst"; descs[i].imm = (i64)zjs_deleted().bits;
    } else if inst.op == Op::ThrowIfHole {
        descs[i].op = (char*)"ThrowIfHole";
    } else if inst.op == Op::Mov {
        descs[i].op = (char*)"Mov";
    } else if inst.op == Op::Add {
        descs[i].op = (char*)"Add";
    } else if inst.op == Op::Sub {
        descs[i].op = (char*)"Sub";
    } else if inst.op == Op::Mul {
        descs[i].op = (char*)"Mul";
    } else if inst.op == Op::Div {
        descs[i].op = (char*)"Div";
    } else if inst.op == Op::Mod {
        descs[i].op = (char*)"Mod";
    } else if inst.op == Op::MathSqrt {
        descs[i].op = (char*)"MathOp"; descs[i].imm = 0;
    } else if inst.op == Op::MathAbs {
        descs[i].op = (char*)"MathOp"; descs[i].imm = 1;
    } else if inst.op == Op::MathFloor {
        descs[i].op = (char*)"MathOp"; descs[i].imm = 2;
    } else if inst.op == Op::MathCeil {
        descs[i].op = (char*)"MathOp"; descs[i].imm = 3;
    } else if inst.op == Op::LoadElem {
        descs[i].op = (char*)"LoadElem";
    } else if inst.op == Op::StoreElem {
        descs[i].op = (char*)"StoreElem";
    } else if inst.op == Op::LoadProp {
        descs[i].op = (char*)"LoadProp";
        let icp: i64 = 0;
        raw { icp = (int64_t)(intptr_t)&f->ics[(unsigned char)inst.c]; }
        descs[i].imm = icp;
    } else if inst.op == Op::StoreProp {
        descs[i].op = (char*)"StoreProp";
        let icp2: i64 = 0;
        raw { icp2 = (int64_t)(intptr_t)&f->ics[(unsigned char)inst.b]; }
        descs[i].imm = icp2;
    } else if inst.op == Op::Invoke {
        descs[i].op = (char*)"Invoke";
        descs[i].imm = (i64)(u32)inst.c;
    } else if inst.op == Op::MethodInvoke {
        // a=dst, b=base (callee), receiver at base+1, args at base+2..; c=argc.
        descs[i].op = (char*)"MethodInvoke";
        descs[i].imm = (i64)(u32)inst.c;
    } else if inst.op == Op::LoadGlobal {
        descs[i].op = (char*)"LoadGlobal";
        descs[i].imm = (i64)inst_bc_u16(inst);
    } else if inst.op == Op::StoreGlobal || inst.op == Op::DefineGlobal {
        descs[i].op = (char*)"GlobalSet";
        descs[i].imm = (i64)inst_bc_u16(inst);
    } else if inst.op == Op::CmpLt {
        descs[i].op = (char*)"CmpLt";
    } else if inst.op == Op::CmpLe {
        descs[i].op = (char*)"CmpLe";
    } else if inst.op == Op::CmpGt {
        descs[i].op = (char*)"CmpGt";
    } else if inst.op == Op::CmpGe {
        descs[i].op = (char*)"CmpGe";
    } else if inst.op == Op::CmpEq || inst.op == Op::CmpStrictEq {
        // Number operands: loose `==` and strict `===` are identical, so one
        // stencil. A non-number operand deopts → interp applies the real rules.
        descs[i].op = (char*)"CmpEq";
    } else if inst.op == Op::CmpNe || inst.op == Op::CmpStrictNe {
        descs[i].op = (char*)"CmpNe";
    } else if inst.op == Op::CmpLtImm {
        descs[i].op = (char*)"CmpLtImm"; descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
    } else if inst.op == Op::CmpLeImm {
        descs[i].op = (char*)"CmpLeImm"; descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
    } else if inst.op == Op::CmpGtImm {
        descs[i].op = (char*)"CmpGtImm"; descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
    } else if inst.op == Op::CmpGeImm {
        descs[i].op = (char*)"CmpGeImm"; descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
    } else if inst.op == Op::AddImm {
        descs[i].op = (char*)"AddImm"; descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
    } else if inst.op == Op::SubImm {
        descs[i].op = (char*)"SubImm"; descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
    } else if inst.op == Op::Jmp {
        descs[i].op = (char*)"Jmp";
        descs[i].target = (i32)i + inst_bc_i16(inst) + 1;
    } else if inst.op == Op::JmpIfFalse {
        // a=cond reg, i16 offset in this slot (single-slot conditional jump).
        descs[i].op = (char*)"JmpIfFalse";
        descs[i].target = (i32)i + inst_bc_i16(inst) + 1;
    } else if inst.op == Op::JmpIfTrue {
        descs[i].op = (char*)"JmpIfTrue";
        descs[i].target = (i32)i + inst_bc_i16(inst) + 1;
    } else if inst.op == Op::JmpIfNotLt || inst.op == Op::JmpIfNotLe
           || inst.op == Op::JmpIfNotGt || inst.op == Op::JmpIfNotGe {
        if i + 1 >= n { return 0; }
        if inst.op == Op::JmpIfNotLt { descs[i].op = (char*)"JmpIfNotLt"; }
        else if inst.op == Op::JmpIfNotLe { descs[i].op = (char*)"JmpIfNotLe"; }
        else if inst.op == Op::JmpIfNotGt { descs[i].op = (char*)"JmpIfNotGt"; }
        else { descs[i].op = (char*)"JmpIfNotGe"; }
        descs[i].target = (i32)i + inst_bc_i16(f.code[i + 1]) + 2;
        descs[i + 1].op = (char*)"Nop"; descs[i + 1].target = -1;
    } else if inst.op == Op::JmpIfNotLtImm || inst.op == Op::JmpIfNotLeImm
           || inst.op == Op::JmpIfNotGtImm || inst.op == Op::JmpIfNotGeImm {
        if i + 1 >= n { return 0; }
        if inst.op == Op::JmpIfNotLtImm { descs[i].op = (char*)"JmpIfNotLtImm"; }
        else if inst.op == Op::JmpIfNotLeImm { descs[i].op = (char*)"JmpIfNotLeImm"; }
        else if inst.op == Op::JmpIfNotGtImm { descs[i].op = (char*)"JmpIfNotGtImm"; }
        else { descs[i].op = (char*)"JmpIfNotGeImm"; }
        descs[i].imm = (i64)(i32)(i8)inst.b;
        descs[i].target = (i32)i + inst_bc_i16(f.code[i + 1]) + 2;
        descs[i + 1].op = (char*)"Nop"; descs[i + 1].target = -1;
    } else if inst.op == Op::Return {
        descs[i].op = (char*)"Return";
    } else {
        return 0;
    }
    return 1;
}

// Try to compile f's body into a cached copy-and-patch region. Sets
// f.jit_state to 1 (compiled, f.jit_code/jit_ret_reg valid) or 2 (disabled).
// Mirrors the CLI jit_try_run op→stencil mapping; kept separate so the
// engine path is self-contained (no dependency on the CLI tool).
fn jit_compile_fn(ctx: ZjsContext*, f: Function*) -> void {
    if f.jit_state != 0 { return; }
    // Only plain sync functions: generator/async/ctor Returns have extra
    // semantics the single-Return fast tail doesn't model.
    if f.is_generator || f.is_async || f.is_class_constructor {
        f.jit_state = 2; return;
    }
    let n: u32 = (u32)f.code_len;
    if n == 0 || n > 250 { f.jit_state = 2; return; }
    let descs = alloc_n<JitFnDesc>(256);
    let ok_all: bool = true;
    let ret_count: u32 = 0;
    let ret_reg: i32 = -1;
    let i: u32 = 0;
    while i < n {
        let inst = f.code[i];
        if descs[i].op != NULL { i = i + 1; continue; }   // pre-marked Nop slot
        descs[i].ra = (i32)inst.a;
        descs[i].rb = (i32)inst.b;
        descs[i].rc = (i32)inst.c;
        descs[i].imm = 0;
        descs[i].target = -1;
        descs[i].bc_index = (i32)i;   // whole-fn: prog index == bytecode index
        if jit_map_insn(f, i, descs, n) == 0 {
            ok_all = false; i = n;
        } else {
            if inst.op == Op::Return {
                ret_count = ret_count + 1;
                ret_reg = (i32)inst.a;
            }
            i = i + 1;
        }
    }
    // Require a fully-mapped body with at least one Return (J12c: multiple
    // Returns are fine — each Return stencil reports its own result register
    // through the deopt channel, so the cached jit_ret_reg is only a legacy
    // fallback). The LAST instruction must be a Return so JIT control flow can
    // never run off the end of the stencil array (a continue-type op there
    // would musttail past the last stencil). Real function bodies always end in
    // the compiler's implicit `return undefined`.
    let last_is_ret: bool = (f.code[n - 1].op == Op::Return);
    if !ok_all || ret_count < 1 || ret_reg < 0 || !last_is_ret {
        dealloc(descs);
        f.jit_state = 2;
        return;
    }
    let code: void* = NULL;
    raw {
        #ifdef ZJS_JIT
        extern void* jit_compile(const void*, int);
        code = jit_compile((const void*)descs, (int)n);
        #endif
    }
    dealloc(descs);
    if code != NULL {
        f.jit_code = code;
        f.jit_ret_reg = ret_reg;
        f.jit_state = 1;
    } else {
        f.jit_state = 2;
    }
}

// OSR-entry compile (J12a): compile ONLY the loop region [header..back] (back =
// the backward-Jmp index, header = its target) so a hot loop JITs even when the
// enclosing function has unmappable code (console.log, a function expr, a method
// call) outside the loop. The JIT is entered at the loop head with the live
// registers and deopt-exits at the loop boundary back to the interpreter.
//
// Targets are rebased to the region: an in-region jump stays a branch; an
// out-of-region jump (the loop-exit condition, or a `break`) becomes an appended
// DeoptExit stencil that resumes the interpreter at that bytecode index. A
// fast-path miss inside the region deopts at its own bc index (the engine
// disables OSR and finishes the loop interpreted). No Return in the region (a
// mid-loop function return isn't modelled) — bail.
fn jit_compile_osr(ctx: ZjsContext*, f: Function*, header: u32, back: u32) -> void {
    if f.jit_osr_state != 0 { return; }
    let n: u32 = (u32)f.code_len;
    if header >= back || back >= n || (back - header) > 240 {
        f.jit_osr_state = 2; return;
    }
    let descs = alloc_n<JitFnDesc>(256);
    let ok: bool = true;
    let j: u32 = header;
    while j <= back {
        if descs[j].op != NULL { j = j + 1; continue; }   // fused-carrier Nop
        let inst = f.code[j];
        descs[j].ra = (i32)inst.a;
        descs[j].rb = (i32)inst.b;
        descs[j].rc = (i32)inst.c;
        descs[j].imm = 0;
        descs[j].target = -1;
        descs[j].bc_index = (i32)j;
        if inst.op == Op::Return { ok = false; j = back + 1; }
        else if jit_map_insn(f, j, descs, n) == 0 { ok = false; j = back + 1; }
        else { j = j + 1; }
    }
    if !ok { dealloc(descs); f.jit_osr_state = 2; return; }
    // Rebase targets to prog indices (prog base = header); collect out-of-region
    // exits as appended DeoptExit stencils at descs[back+1 ..].
    let n_region: u32 = back - header + 1;
    let num_exits: u32 = 0;
    let k: u32 = header;
    while k <= back {
        if descs[k].op != NULL && descs[k].target >= 0 {
            let tbc: i32 = descs[k].target;
            if tbc >= (i32)header && tbc <= (i32)back {
                descs[k].target = tbc - (i32)header;
            } else {
                let found: i32 = -1;
                let e: u32 = 0;
                while e < num_exits {
                    if descs[back + 1 + e].imm == (i64)tbc { found = (i32)e; e = num_exits; }
                    else { e = e + 1; }
                }
                if found < 0 {
                    if back + 1 + num_exits >= 256 { ok = false; k = back; }
                    else {
                        let slot = back + 1 + num_exits;
                        descs[slot].op = (char*)"DeoptExit";
                        descs[slot].imm = (i64)tbc;
                        descs[slot].target = -1;
                        descs[slot].bc_index = (i32)tbc;
                        found = (i32)num_exits;
                        num_exits = num_exits + 1;
                    }
                }
                if found >= 0 { descs[k].target = (i32)n_region + found; }
            }
        }
        k = k + 1;
    }
    if !ok { dealloc(descs); f.jit_osr_state = 2; return; }
    let n_prog: u32 = n_region + num_exits;
    let code: void* = NULL;
    raw {
        #ifdef ZJS_JIT
        extern void* jit_compile(const void*, int);
        code = jit_compile((const void*)&descs[header], (int)n_prog);
        #endif
    }
    dealloc(descs);
    if code != NULL {
        f.jit_osr_code = code;
        f.jit_osr_header = (i32)header;
        f.jit_osr_state = 1;
    } else {
        f.jit_osr_state = 2;
    }
}

fn interpret(ctx: ZjsContext*, entry_f: Function*, args: ZjsValue*, arg_count: u32) -> InterpretResult {
    // One-shot eager init of the op-profile gate so the per-op
    // dispatch path inside interpret_inner can use a single load +
    // branch (no `< 0` sentinel check).
    raw {
        if (zjs_profile_ops_enabled < 0) zjs_profile_ops_init();
        if (zjs_trace_unwind_enabled < 0) zjs_trace_unwind_init();
    }
    let saved_ctx = gc_set_active_ctx(ctx);
    let r = interpret_inner(ctx, entry_f, args, arg_count, NULL);
    gc_set_active_ctx(saved_ctx);
    return r;
}

// Resolve the real target of a default-derived-constructor's implicit
// `super(...args)` forward. A synthesized default derived ctor
// (is_default_derived_ctor) is a pure argument-forwarder with no field
// initializers — a class with fields but no explicit ctor gets a
// parser-synthesized ctor instead, which is NOT flagged here. So when the
// forward target is itself such a ctor, we can skip straight to ITS
// parent: chaining N empty forwarders is identical to calling the first
// ancestor with a real body (or the base). Without this, a 3+ level
// default-ctor chain (C->B->A) invokes B's empty body via a plain call,
// which trips the spec "must call super before return" gate.
fn ctor_skip_default_forwarders(parent: ZjsValue) -> ZjsValue {
    let cur = parent;
    let hops: u32 = 0;
    while hops < 64 {
        let fnp: Function* = NULL;
        if zjs_is_function(cur) != 0 {
            raw { fnp = (Function*)zjs_cell_as_ptr(cur); }
        } else if zjs_is_closure(cur) != 0 {
            let cl = zjs_as_closure(cur);
            let p = cl.function;
            raw { fnp = (Function*)p; }
        } else {
            break;
        }
        if fnp == NULL { break; }
        if fnp.is_default_derived_ctor == false { break; }
        let next = fnp.parent_ctor;
        if next.bits == zjs_undefined().bits { break; }
        cur = next;
        hops = hops + 1;
    }
    return cur;
}

// Variant of interpret() that pre-binds the entry frame's
// outer_promise. Used when a host caller invokes an async function
// (e.g. via Function.prototype.bind / call / apply, or
// zjs_call_value_with_this) — the async body's Op::Return resolves
// outer_promise with the return value, and Op::Await on a pending
// Promise can suspend cleanly because frame.outer_promise is set.
fn interpret_with_outer_promise(ctx: ZjsContext*, entry_f: Function*,
                                args: ZjsValue*, arg_count: u32,
                                outer_promise: ZjsValue) -> InterpretResult {
    raw { if (zjs_profile_ops_enabled < 0) zjs_profile_ops_init(); }
    let saved_ctx = gc_set_active_ctx(ctx);
    // push_call_frame inside interpret_inner zeroes outer_promise
    // before the dispatch loop runs. We can't pre-set it before the
    // push, so use a context-level slot the inner loop picks up.
    let saved_seed = ctx.async_outer_seed;
    ctx.async_outer_seed = outer_promise;
    let r = interpret_inner(ctx, entry_f, args, arg_count, NULL);
    ctx.async_outer_seed = saved_seed;
    gc_set_active_ctx(saved_ctx);
    return r;
}

// Resume a suspended generator. Hands off to interpret_inner_full
// with the gen parameter set; the dispatch loop then yields-or-
// returns its iter-result up via final_result.
// Snapshot the catch handlers active in the generator's frame (those above
// try_depth_at_entry) onto the generator, so a resume can re-push them and a
// `.throw()` / rejected-await / yield*-forwarded throw unwinds into the body's
// try/catch. Frees any prior snapshot first (generators suspend repeatedly).
fn gen_save_try_handlers(ctx: ZjsContext*, gen: ZjsGenerator*, frame_idx: u32) -> void {
    if gen.saved_try_ip  != NULL { dealloc(gen.saved_try_ip);  gen.saved_try_ip  = NULL; }
    if gen.saved_try_reg != NULL { dealloc(gen.saved_try_reg); gen.saved_try_reg = NULL; }
    gen.saved_try_count = 0;
    let try_at_entry = ctx.frames[frame_idx].try_depth_at_entry;
    let try_n = if ctx.ctx_try_depth > try_at_entry { ctx.ctx_try_depth - try_at_entry } else { 0 };
    if try_n > 0 {
        gen.saved_try_count = try_n;
        gen.saved_try_ip  = alloc_n<usize>((usize)try_n);
        gen.saved_try_reg = alloc_n<u8>((usize)try_n);
        let ti: u32 = 0;
        while ti < try_n {
            gen.saved_try_ip[ti]  = ctx.ctx_try_stack[try_at_entry + ti].catch_ip;
            gen.saved_try_reg[ti] = ctx.ctx_try_stack[try_at_entry + ti].catch_reg;
            ti = ti + 1;
        }
    }
}

fn interpret_resume_generator(ctx: ZjsContext*, gen: ZjsGenerator*,
                              resume_value: ZjsValue, is_throw: bool) -> InterpretResult {
    if gen == NULL || gen.function == NULL {
        return InterpretResult{ is_throw: false, value: zjs_undefined() };
    }
    // Set the active ctx for the duration of the resume so the param-less
    // write barrier (gc_barrier in value.zc array_set etc., which reads
    // g_active_ctx) actually fires. Without this, generator/async resume runs
    // with a stale/NULL g_active_ctx and array writes during resumed code
    // silently skip the rem-set → minor GC frees live young cells (UAF).
    let saved_ctx = gc_set_active_ctx(ctx);
    let r = interpret_inner_full(ctx, gen.function, NULL, 0, NULL, gen, resume_value, is_throw);
    gc_set_active_ctx(saved_ctx);
    return r;
}

// Resume a suspended async-function frame. The continuation owns the
// saved register window + ip + outer Promise; we push a fresh frame,
// repopulate it from the snapshot, then run the dispatch loop normally
// until the async fn returns/throws (settling outer_promise) or hits
// another await.
fn interpret_resume(ctx: ZjsContext*, cont: ZjsAsyncCont*,
                    resolved_value: ZjsValue, is_throw: bool) -> InterpretResult {
    if cont == NULL || cont.function == NULL {
        return InterpretResult{ is_throw: false, value: zjs_undefined() };
    }
    // Stash the resolved value and the throw flag onto the continuation
    // so interpret_inner can pick them up after it pushes the frame.
    cont.saved_host_this = cont.saved_host_this; // no-op; keep for clarity
    return interpret_inner_resume(ctx, cont, resolved_value, is_throw);
}

fn interpret_inner_resume(ctx: ZjsContext*, cont: ZjsAsyncCont*,
                          resolved_value: ZjsValue, is_throw_in: bool) -> InterpretResult {
    // See interpret_resume_generator: set g_active_ctx so the param-less write
    // barrier fires during resumed async-function code.
    let saved_ctx = gc_set_active_ctx(ctx);
    let r = interpret_inner_full(ctx, cont.function, NULL, 0, cont, NULL, resolved_value, is_throw_in);
    gc_set_active_ctx(saved_ctx);
    return r;
}

fn interpret_inner(ctx: ZjsContext*, entry_f: Function*, args: ZjsValue*, arg_count: u32, cont: ZjsAsyncCont*) -> InterpretResult {
    return interpret_inner_full(ctx, entry_f, args, arg_count, cont, NULL, zjs_undefined(), false);
}

fn interpret_inner_full(ctx: ZjsContext*,
                        entry_f: Function*, args: ZjsValue*, arg_count: u32,
                        cont: ZjsAsyncCont*,
                        gen: ZjsGenerator*,
                        resume_value: ZjsValue, resume_is_throw: bool) -> InterpretResult {
    if entry_f == NULL { return InterpretResult{ is_throw: false, value: zjs_undefined() }; }

    // Phase 3.9h: non-recursive JS-to-JS calls. We push an initial
    // CallFrame for the entry function, then the outer loop runs as
    // long as there are frames above the entry depth. Op::Invoke
    // pushes a new frame (instead of recursing into interpret), and
    // Op::Return pops + writes the return value into the caller's
    // register slot.
    //
    // Host functions still call interpret() recursively (via
    // zjs_call_value). Each recursive entry captures its own
    // `entry_frame` so its outer loop only walks the frames it
    // pushed — frames from a host caller's outer interpret() are
    // invisible to this one.
    //
    // When `cont` is non-NULL, this is a RESUME: push the frame with
    // no args, then immediately repopulate it from the continuation
    // (regs, ip, host_this, closure, outer_promise) before the outer
    // loop runs. If the resume is for a rejected await, seed the
    // throw channel so the dispatch loop unwinds into the async body's
    // try/catch (or the outer fn's reject path).
    let entry_frame: u32 = ctx.frame_count;
    push_call_frame(ctx, entry_f, args, arg_count, 0);
    defer pop_call_frames_to(ctx, entry_frame);
    // Consume the async-outer-seed if the host caller wired one up.
    // Only applies to fresh calls (cont == NULL && gen == NULL) —
    // resumes and generator-restarts manage their own outer_promise.
    if cont == NULL && gen == NULL && zjs_is_promise(ctx.async_outer_seed) != 0 {
        ctx.frames[ctx.frame_count - 1].outer_promise = ctx.async_outer_seed;
        ctx.async_outer_seed = zjs_undefined();
    }
    if cont != NULL {
        let pf_idx = ctx.frame_count - 1;
        let r_base = ctx.frames[pf_idx].regs_base;
        let n = cont.reg_count;
        let i: u32 = 0;
        while i < n {
            ctx.reg_stack[r_base + i] = cont.saved_regs[i];
            i = i + 1;
        }
        ctx.frames[pf_idx].ip = cont.saved_ip;
        ctx.frames[pf_idx].outer_promise = cont.outer_promise;
        // Drop the frame's saved_host_this in favor of the continuation's
        // — pop_call_frame restores whatever the resumer (microtask
        // drain handler) had set ctx.host_this to before we ran, which
        // is what we want.
        ctx.host_this = cont.saved_host_this;
        ctx.current_closure = cont.saved_current_closure;
        // Write the resolved value into the await's dst register so
        // the body sees `let x = await ...` as the awaited result.
        if !resume_is_throw {
            ctx.reg_stack[r_base + (u32)cont.await_dst] = resume_value;
        }
        // Re-push the catch handlers that were active when the await
        // suspended, rebound to the freshly-pushed frame. Without this a
        // rejected resume finds no try-handler and the rejection escapes
        // the body's try/catch entirely.
        let tj: u32 = 0;
        while tj < cont.saved_try_count {
            let _ = ctx_try_push(ctx, cont.saved_try_ip[tj], cont.saved_try_reg[tj]);
            tj = tj + 1;
        }
    }
    // Generator resume mirrors cont-resume but onto a ZjsGenerator.
    if gen != NULL {
        let pf_idx = ctx.frame_count - 1;
        let r_base = ctx.frames[pf_idx].regs_base;
        let n = gen.reg_count;
        let i: u32 = 0;
        while i < n {
            ctx.reg_stack[r_base + i] = gen.saved_regs[i];
            i = i + 1;
        }
        ctx.frames[pf_idx].ip = gen.saved_ip;
        ctx.frames[pf_idx].generator = gen;
        ctx.host_this = gen.saved_host_this;
        ctx.current_closure = gen.saved_current_closure;
        // On resumption from a `yield`, .next(arg) feeds arg into the
        // dst register of the suspended Op::Yield. Initial .next has
        // nothing meaningful to feed (state == GEN_INITIAL on entry).
        // For GEN_AWAITING (async gen), resume_dst is the await's
        // dst — write the settled Promise value there.
        if (gen.state == GEN_YIELDED || gen.state == GEN_AWAITING) && !resume_is_throw {
            ctx.reg_stack[r_base + (u32)gen.resume_dst] = resume_value;
        }
        // Re-push the catch handlers active when the body suspended (rebound to
        // this fresh frame), so a `.throw()`/rejected-await resume unwinds into
        // the body's try/catch instead of escaping it.
        let gtj: u32 = 0;
        while gtj < gen.saved_try_count {
            let _ = ctx_try_push(ctx, gen.saved_try_ip[gtj], gen.saved_try_reg[gtj]);
            gtj = gtj + 1;
        }
        gen.state = GEN_RUNNING;
    }

    let throwing:    bool     = false;
    let thrown:      ZjsValue = zjs_undefined();
    let final_result: ZjsValue = zjs_undefined();
    // Resume of an async fn with a rejected await: seed the throw
    // channel so the dispatch loop unwinds the body's try/catch (or
    // converts to a Promise rejection on the way out).
    if (cont != NULL || gen != NULL) && resume_is_throw {
        throwing = true;
        thrown   = resume_value;
    }

    // ---------- Outer loop ----------
    while ctx.frame_count > entry_frame {
        // Throw unwinding runs BEFORE we re-enter the inner loop for a
        // frame. If the current top frame has a matching try-handler we
        // jump to its catch site; otherwise we pop the top frame and
        // loop again (eventually returning is_throw to the caller if no
        // frame catches).
        if throwing {
            // Discard try frames that belong to already-popped frames
            // (defensive; pop_call_frame should have done this already
            // via try_depth_at_entry).
            while ctx.ctx_try_depth > 0
                && ctx.ctx_try_stack[ctx.ctx_try_depth - 1].frame_index >= ctx.frame_count {
                ctx.ctx_try_depth = ctx.ctx_try_depth - 1;
            }
            let top_idx: u32 = ctx.frame_count - 1;
            let caught: bool = false;
            raw {
                if (zjs_trace_unwind_enabled) {
                    Function* tf = ctx->frames[top_idx].f;
                    size_t tflen = tf ? tf->code_len : 0;
                    /* Decode the thrown value enough to identify it.
                     * For Error-shaped objects, try to read .message
                     * as a string. For string throws, dump the string.
                     * Otherwise just show the cell tag. */
                    uint8_t tag = zjs_cell_tag(thrown);
                    const char* msg = NULL;
                    if (tag == TAG_OBJECT) {
                        ZjsString* msg_atom = ctx_intern_atom(ctx, (char*)"message", 7);
                        ZjsValue mv = property_get(ctx, thrown, zjs_cell_from_ptr((void*)msg_atom));
                        /* property_get might set pending_throw; we don't
                         * care here, just consume and ignore. */
                        if (ctx->pending_throw_active) {
                            ctx->pending_throw_active = false;
                            ctx->pending_throw_value = zjs_undefined();
                        }
                        if (zjs_is_string(mv)) {
                            ZjsString* s = zjs_as_string(mv);
                            msg = s ? s->data : NULL;
                        }
                    } else if (zjs_is_string(thrown)) {
                        ZjsString* s = zjs_as_string(thrown);
                        msg = s ? s->data : NULL;
                    }
                    fprintf(stderr,
                        "[zjs:trace_unwind] unwind throw f=%p ip=%zu code_len=%zu frame_count=%u try_depth=%u thrown_tag=%u msg=%s\n",
                        (void*)tf, (size_t)ctx->frames[top_idx].ip, tflen,
                        (unsigned)ctx->frame_count, (unsigned)ctx->ctx_try_depth,
                        (unsigned)tag, msg ? msg : "(non-string)");
                }
            }
            if ctx.ctx_try_depth > 0 {
                let td = ctx.ctx_try_depth - 1;
                if ctx.ctx_try_stack[td].frame_index == top_idx {
                    let regs_base_c = ctx.frames[top_idx].regs_base;
                    let catch_reg_c = (u32)ctx.ctx_try_stack[td].catch_reg;
                    ctx.frames[top_idx].ip = ctx.ctx_try_stack[td].catch_ip;
                    raw {
                        if (zjs_trace_unwind_enabled) {
                            Function* tf = ctx->frames[top_idx].f;
                            size_t tflen = tf ? tf->code_len : 0;
                            fprintf(stderr,
                                "[zjs:trace_unwind]   caught: catch_ip=%zu (code_len=%zu)\n",
                                (size_t)ctx->ctx_try_stack[td].catch_ip, tflen);
                        }
                    }
                    ctx.reg_stack[regs_base_c + catch_reg_c] = thrown;
                    ctx.ctx_try_depth = td;
                    throwing = false;
                    caught = true;
                }
            }
            if !caught {
                raw {
                    if (zjs_trace_unwind_enabled) {
                        fprintf(stderr, "[zjs:trace_unwind]   uncaught: popping frame\n");
                    }
                }
                // async function bubbling out an exception: settle the
                // outer Promise as rejected. The caller's reg already
                // holds that Promise (written at call time), so we
                // don't write again on pop. Top-level async fns are
                // handled by the entry-frame final_result path.
                let top_f = ctx.frames[top_idx].f;
                let outer = ctx.frames[top_idx].outer_promise;
                if top_f != NULL && top_f.is_async && zjs_is_promise(outer) != 0 {
                    promise_settle(ctx, outer, thrown, false);
                    let _ = pop_call_frame(ctx);
                    if ctx.frame_count <= entry_frame {
                        final_result = outer;
                    }
                    throwing = false;
                    continue;
                }
                pop_call_frame(ctx);
                continue;
            }
        }

        // Hoist top-frame fields into locals for the inner loop. After
        // any frame push/pop the cached `regs` / `frame_ptr` would
        // dangle, so we always invalidate by breaking out of the inner
        // loop on Invoke/Return/Throw.
        let cur_idx: u32 = ctx.frame_count - 1;
        let f: Function* = ctx.frames[cur_idx].f;
        let code = f.code;
        let code_len = f.code_len;
        let regs_base = ctx.frames[cur_idx].regs_base;
        let regs: ZjsValue* = NULL;
        raw { regs = &ctx->reg_stack[regs_base]; }
        let ip: usize = ctx.frames[cur_idx].ip;

        // On first entry to a frame, seed regs[f.this_reg] from the
        // host_this set by the call site. Replaces the Op::LoadThis the
        // compiler used to emit at function entry — saves one dispatch
        // per call into any `this`-using function.
        //
        // Arrow functions ignore the call-site host_this and read the
        // creation-time `this` snapshot captured at MakeClosure (see
        // ZjsClosure.captured_this). Without this branch, every
        // `arr.map(x => this.foo)` would see map's callback host_this
        // (the array) instead of the enclosing scope's instance.
        if ip == 0 && f.this_reg >= 0 {
            if f.is_arrow && ctx.current_closure != NULL {
                regs[(u32)f.this_reg] = ctx.current_closure.captured_this;
            } else {
                regs[(u32)f.this_reg] = ctx.host_this;
            }
        }

        // --- Copy-and-patch JIT hot-dispatch (ZJS_JIT only; folded out
        // otherwise). At a fresh frame entry (ip==0): count toward hot and
        // compile once; if a compiled region exists, run it on the live
        // frame and finish exactly as Op::Return would (pop + write the
        // result to the caller / final_result). A deopt discards the run
        // (side-effect-free subset) and falls through to the interpreter,
        // marking the function so we don't keep retrying.
        if ip == 0 && jit_build_enabled() != 0 && jit_runtime_enabled() != 0 {
            let jst = f.jit_state;
            if jst == 0 {
                f.jit_calls = f.jit_calls + 1;
                // Loopy functions (a back-edge = a loop) are dominated by their
                // loop body, not their call count, so compile on first entry;
                // gate everything else on the call-count threshold. This is the
                // OSR-entry-lite that unlocks top-level numeric loops: the ip==0
                // hook compiles before the loop runs, then runs the whole body
                // from the top in JIT — no mid-loop entry needed.
                if f.jit_calls >= jit_hot_threshold() || jit_fn_has_backedge(f) {
                    jit_compile_fn(ctx, f);
                    jst = f.jit_state;
                }
            }
            if jst == 1 {
                let jdeopt: int = -1;
                raw {
                    #ifdef ZJS_JIT
                    ((void(*)(ZjsValue*, int*))f->jit_code)(regs, &jdeopt);
                    // A call in the JIT body (J11) may have realloc'd reg_stack,
                    // dangling `regs` — re-derive from the stable base index.
                    regs = &ctx->reg_stack[regs_base];
                    #endif
                }
                if jdeopt < 0 {
                    // Returned — finish exactly as Op::Return. J12c: a Return
                    // encodes its own result register as -(2+reg); the legacy
                    // -1 (single cached jit_ret_reg) is kept as a fallback.
                    ctx_maybe_gc(ctx);
                    let rreg: u32 = if jdeopt == -1 { (u32)f.jit_ret_reg } else { (u32)((0 - jdeopt) - 2) };
                    let rv = regs[rreg];
                    let ret_dst = pop_call_frame(ctx);
                    if ctx.frame_count <= entry_frame {
                        final_result = rv;
                    } else {
                        let cidx = ctx.frame_count - 1;
                        let cb = ctx.frames[cidx].regs_base;
                        ctx.reg_stack[cb + (u32)ret_dst] = rv;
                    }
                    continue;
                } else if ctx.pending_throw_active {
                    // J11: a call inside the JIT body threw. The call already
                    // ran (observable), so we must NOT resume-and-re-execute —
                    // route to the outer-loop throw handler instead. A JIT'd fn
                    // is never try/catch-bearing (EnterTry isn't in the subset),
                    // so the unwind pops F and propagates to the caller, exactly
                    // as if F itself threw.
                    throwing = true;
                    thrown   = ctx.pending_throw_value;
                    ctx.pending_throw_active = false;
                    ctx.frames[cur_idx].ip = (usize)jdeopt;
                    f.jit_state = 2;
                    continue;   // outer-loop top: `if throwing` unwinds F
                } else {
                    // J6 OSR: deopt at bytecode index jdeopt. The live regs hold
                    // the JIT's faithful state through jdeopt-1 (params and all),
                    // so resume the interpreter exactly there — no re-run from
                    // the top, which is why no param-write guard is needed.
                    // Disable further JIT for this fn: a deopting body is usually
                    // polymorphic, and re-JITting would just waste work each call.
                    ip = (usize)jdeopt;
                    ctx.frames[cur_idx].ip = ip;
                    f.jit_state = 2;
                    // fall through to the inner dispatch loop at ip = jdeopt
                }
            }
        }

        // Inner-loop exit reason:
        //   0 = ran off code_len (implicit return undefined)
        //   1 = Op::Return / Op::Halt (frame already popped + return value written)
        //   2 = Invoke pushed a new frame (frame.ip saved before push)
        //   3 = throw raised (throwing/thrown set; outer loop handles)
        let exit_reason: int = 0;

        while ip < code_len {
        // GC safe-points are NOT at every instruction (the load+compare
        // alone costs 15-25% on hot loops). Instead we poll at:
        //   - backward Op::Jmp (loop heads), below
        //   - Op::Invoke / MethodInvoke / Return (call boundaries), inline
        //   - allocation opcodes (NewObject/Array/Closure) — fold the
        //     check into their handlers if/when allocation pressure
        //     dominates GC liveness.
        // Straight-line arithmetic never allocates, so skipping the
        // poll there is safe.

        // Throw unwinding now happens in the OUTER loop, before
        // re-entering this inner loop — see the top of the outer while.

        let prev_ip: usize = ip;
        let inst = code[ip];
        let op = inst.op;
        // Op profiling — gated on $ZJS_PROFILE_OPS=1. atexit dumper
        // below logs per-op execution counts AND per-pair counts
        // (prev → this) for super-instruction fusion candidates.
        // Lazy init moved to the outer entry below — the `< 0` check
        // used to run per-op, adding ~1ns × (ops executed) for every
        // run regardless of whether profiling was on.
        raw {
            if (zjs_profile_ops_enabled) {
                int op_i = (int)op;
                zjs_op_counts[op_i] += 1;
                zjs_pair_counts[(zjs_last_op << 8) | op_i] += 1;
                zjs_last_op = op_i;
            }
        }

        if op == Op::Return {
            // GC safe-point on the way out — only the return value
            // survives the frame.
            ctx_maybe_gc(ctx);
            // ZJS_TRACE_UNWIND surfaces Op::Return only when it's the
            // entry-frame returning (the moment that ends interpret()'s
            // top-level invocation). Inner Returns fire constantly and
            // would flood the log. If a bench-loop body's Op::Return
            // hits here, it means the loop's outer frame just popped —
            // i.e., the JS execution silently terminated.
            raw {
                if (zjs_trace_unwind_enabled && ctx->frame_count == entry_frame + 1) {
                    fprintf(stderr,
                        "[zjs:trace_unwind] Op::Return at entry-frame f=%p ip=%zu code_len=%zu a=%u\n",
                        (void*)f, (size_t)ip, (size_t)code_len, (unsigned)inst.a);
                }
            }
            // Spec: derived-class constructor must call super() before
            // returning. If super wasn't called, `this` is in TDZ —
            // throw ReferenceError.
            if f.is_class_constructor
               && f.parent_ctor.bits != zjs_undefined().bits
               && !ctx.frames[cur_idx].super_called {
                let err = build_typed_error(ctx, (char*)"ReferenceError", 14,
                                            (char*)"Must call super constructor before returning from derived constructor", 69);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
            let rv = regs[inst.a];
            // Generator return: wrap rv in { value, done: true } and
            // mark the iterator completed. The iter.next() host caller
            // receives this iter-result as the return of its
            // trampoline-interpret.
            let gen_self = ctx.frames[cur_idx].generator;
            if f.is_generator && gen_self != NULL {
                gen_self.state = GEN_COMPLETED;
                rv = build_iter_result(ctx, rv, true);
            }
            // async function return: settle the outer Promise (already
            // written into the caller's dst at call time) with rv.
            // The caller's reg slot keeps the Promise; rv is the
            // resolution value.
            let async_outer: ZjsValue = ctx.frames[cur_idx].outer_promise;
            let is_async_frame: bool = f.is_async && zjs_is_promise(async_outer) != 0;
            if is_async_frame {
                promise_resolve_with(ctx, async_outer, rv);
                rv = async_outer;
            }
            let ret_dst = pop_call_frame(ctx);
            if ctx.frame_count <= entry_frame {
                final_result = rv;
            } else if !is_async_frame {
                // Sync return: write the actual value into the caller's
                // reg. Async return leaves the pre-written Promise in
                // place.
                let cidx = ctx.frame_count - 1;
                let cb = ctx.frames[cidx].regs_base;
                ctx.reg_stack[cb + (u32)ret_dst] = rv;
            }
            exit_reason = 1;
            break;
        }
        if op == Op::Halt {
            // Halt aborts the entire interpret() entry — pop everything
            // back to entry depth, return undefined.
            raw {
                if (zjs_trace_unwind_enabled) {
                    fprintf(stderr,
                        "[zjs:trace_unwind] Op::Halt fired f=%p ip=%zu code_len=%zu frame_count=%u\n",
                        (void*)f, (size_t)ip, (size_t)code_len, (unsigned)ctx->frame_count);
                }
            }
            pop_call_frames_to(ctx, entry_frame);
            final_result = zjs_undefined();
            exit_reason = 1;
            break;
        }

        if op == Op::LoadInt {
            regs[inst.a] = zjs_int32((i32)inst_bc_i16(inst));
        } else if op == Op::LoadConst {
            regs[inst.a] = f.constants[inst_bc_u16(inst)];
        } else if op == Op::LoadUndefined {
            regs[inst.a] = zjs_undefined();
        } else if op == Op::LoadHole {
            // Array-literal elision slot; surface zjs_deleted so
            // NewArray copies it into the elements buffer as a hole.
            regs[inst.a] = zjs_deleted();
        } else if op == Op::ThrowIfHole {
            // TDZ check (#330): a lexical binding (let/const/default-param)
            // is seeded with the hole sentinel and overwritten on init.
            // Reading it while still a hole is a ReferenceError.
            if regs[inst.a].bits == zjs_deleted().bits {
                let err = build_typed_error(ctx, (char*)"ReferenceError", 14,
                                            (char*)"Cannot access lexical binding before initialization", 52);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::LoadNull {
            regs[inst.a] = zjs_null();
        } else if op == Op::LoadTrue {
            regs[inst.a] = zjs_bool(1);
        } else if op == Op::LoadFalse {
            regs[inst.a] = zjs_bool(0);
        } else if op == Op::Mov {
            regs[inst.a] = regs[inst.b];

        // --- globals --------------------------------------------
        } else if op == Op::DefineGlobal {
            let slot = inst_bc_u16(inst);
            ctx.realm.globals[slot].value = regs[inst.a];
            ctx.realm.globals[slot].defined = true;
            // Top-level var/function → global-object own property (#368),
            // distinct from a builtin (non-enumerable, configurable).
            ctx.realm.globals[slot].is_var_binding = true;
        } else if op == Op::LoadGlobal {
            let slot = inst_bc_u16(inst);
            if !ctx.realm.globals[slot].defined {
                // ECMA-262 §9.1.1.4 GetBindingValue: when the
                // DeclarativeRecord has no binding, fall through to
                // the ObjectRecord (= globalThis own/inherited).
                let nm = ctx.realm.globals[slot].name;
                let nl = ctx.realm.globals[slot].name_len;
                let found_v: ZjsValue = zjs_undefined();
                let found: bool = false;
                if ctx.realm.global_this_obj != NULL {
                    let key_str = ctx_intern_atom(ctx, nm, nl);
                    let cur = ctx.realm.global_this_obj;
                    while cur != NULL {
                        if class_find_slot(cur.cls, key_str) >= 0 {
                            let obj_v = zjs_cell_from_ptr((void*)ctx.realm.global_this_obj);
                            let key_v = zjs_cell_from_ptr((void*)key_str);
                            found_v = property_get(ctx, obj_v, key_v);
                            found = true;
                            cur = NULL;
                        } else {
                            cur = cur.proto;
                        }
                    }
                }
                if !found {
                    let err = build_reference_error(ctx, nm, nl);
                    throwing = true; thrown = err; exit_reason = 3; break;
                }
                regs[inst.a] = found_v;
            } else {
                regs[inst.a] = ctx.realm.globals[slot].value;
            }
        } else if op == Op::LoadGlobalOrUndefined {
            let slot = inst_bc_u16(inst);
            if !ctx.realm.globals[slot].defined {
                // typeof variant — same fallback, but absence is
                // silently `undefined` rather than ReferenceError.
                let nm = ctx.realm.globals[slot].name;
                let nl = ctx.realm.globals[slot].name_len;
                let found_v: ZjsValue = zjs_undefined();
                if ctx.realm.global_this_obj != NULL {
                    let key_str = ctx_intern_atom(ctx, nm, nl);
                    let cur = ctx.realm.global_this_obj;
                    while cur != NULL {
                        if class_find_slot(cur.cls, key_str) >= 0 {
                            let obj_v = zjs_cell_from_ptr((void*)ctx.realm.global_this_obj);
                            let key_v = zjs_cell_from_ptr((void*)key_str);
                            found_v = property_get(ctx, obj_v, key_v);
                            cur = NULL;
                        } else {
                            cur = cur.proto;
                        }
                    }
                }
                regs[inst.a] = found_v;
            } else {
                regs[inst.a] = ctx.realm.globals[slot].value;
            }
        } else if op == Op::StoreGlobal {
            let slot = inst_bc_u16(inst);
            ctx.realm.globals[slot].value = regs[inst.a];
            ctx.realm.globals[slot].defined = true;
        } else if op == Op::WithEnter {
            // ToObject(regs[a]) — null/undefined throw a TypeError — then
            // push onto the with-stack (§14.11.7 step 2 / §9.4.x).
            let wobj = ctx_to_object(ctx, regs[inst.a]);
            if ctx.pending_throw_active {
                throwing = true; thrown = ctx.pending_throw_value;
                ctx.pending_throw_active = false; exit_reason = 3; break;
            }
            if ctx.with_count < 64 {
                ctx.with_objs[ctx.with_count] = wobj;
                ctx.with_count = ctx.with_count + 1;
            }
        } else if op == Op::WithLeave {
            if ctx.with_count > 0 { ctx.with_count = ctx.with_count - 1; }
        } else if op == Op::WithLookup {
            // regs[a] = innermost with-object that binds regs[b] (the
            // identifier name), or undefined. Caller branches on it.
            let holder = ctx_with_lookup(ctx, regs[inst.b]);
            if ctx.pending_throw_active {
                throwing = true; thrown = ctx.pending_throw_value;
                ctx.pending_throw_active = false; exit_reason = 3; break;
            }
            regs[inst.a] = holder;

        // --- arithmetic -----------------------------------------
        } else if op == Op::Add {
            // ECMA-262: ToPrimitive both operands with hint "default"
            // (= "number" for non-Date, "string" for Date). If either
            // is a string after coercion, concatenate; else numeric add.
            // Skip the ToPrimitive + pending-throw machinery entirely
            // when both operands are primitives (the common case) so
            // the hot path stays branch-light. ToPrimitive(lhs) runs
            // strictly before ToPrimitive(rhs) per spec — check pending
            // after each call so a thrown value from the LHS isn't
            // overwritten by the RHS.
            let av = regs[inst.b];
            let bv = regs[inst.c];
            // Cache is_object_like results — was being called twice
            // per operand in the worst case. Add is hot enough on the
            // string-concat / arithmetic benches that this matters.
            let av_obj: int = is_object_like(av);
            let bv_obj: int = is_object_like(bv);
            if av_obj != 0 || bv_obj != 0 {
                if av_obj != 0 {
                    // Date's @@toPrimitive default hint = "string".
                    let prefer_a: bool = zjs_is_date(av) != 0;
                    av = zjs_to_primitive(ctx, av, prefer_a);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if bv_obj != 0 {
                    let prefer_b: bool = zjs_is_date(bv) != 0;
                    bv = zjs_to_primitive(ctx, bv, prefer_b);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            if zjs_is_string(av) != 0 || zjs_is_string(bv) != 0 {
                // String-concat path. zjs_string_concat -> zjs_to_string
                // throws TypeError on Symbol per ECMA-262 §7.1.17, so the
                // Symbol-side check is handled inside.
                regs[inst.a] = zjs_string_concat(ctx, av, bv);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            } else {
                // BigInt path (both must be BigInt; mixing → TypeError).
                // Gate the (non-inlined) call on a cheap inline tag check —
                // the overwhelmingly common number case skips it entirely.
                let bh = false;
                let br = zjs_undefined();
                if zjs_is_bigint(av) != 0 || zjs_is_bigint(bv) != 0 { br = bigint_try_binop(ctx, 0, av, bv, &bh); }
                if bh {
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                    regs[inst.a] = br;
                } else {
                    // Numeric path. ToNumber on Symbol throws TypeError.
                    if zjs_is_symbol(av) != 0 || zjs_is_symbol(bv) != 0 {
                        raise_symbol_to_number(ctx);
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                    regs[inst.a] = zjs_arith_add(av, bv);
                }
            }
        } else if op == Op::Sub {
            let av = regs[inst.b]; let bv = regs[inst.c];
            let av_obj: int = is_object_like(av);
            let bv_obj: int = is_object_like(bv);
            if av_obj != 0 || bv_obj != 0 {
                if av_obj != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if bv_obj != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            let bh_sub = false;
            let br_sub = zjs_undefined();
            if zjs_is_bigint(av) != 0 || zjs_is_bigint(bv) != 0 { br_sub = bigint_try_binop(ctx, 1, av, bv, &bh_sub); }
            if bh_sub {
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = br_sub;
            } else {
                if zjs_is_symbol(av) != 0 || zjs_is_symbol(bv) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_arith_sub(av, bv);
            }
        } else if op == Op::AddImm {
            // Fused int32 + i8 fast path; falls back to full Add semantics
            // (object → ToPrimitive, string concat) on cold paths.
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                let ai: i64 = (i64)zjs_as_int32(av);
                let sum: i64 = ai + (i64)imm;
                let fits: int = 0;
                raw { fits = (sum >= INT32_MIN && sum <= INT32_MAX) ? 1 : 0; }
                if fits != 0 {
                    regs[inst.a] = zjs_int32((i32)sum);
                } else {
                    regs[inst.a] = zjs_double((f64)sum);
                }
            } else {
                // Slow fallback: re-do as a real Add (handles strings,
                // objects, doubles, etc.). Date's default ToPrimitive
                // hint is "string" — match Op::Add's behavior.
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    let prefer_a: bool = zjs_is_date(av) != 0;
                    av = zjs_to_primitive(ctx, av, prefer_a);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_string(av) != 0 {
                    regs[inst.a] = zjs_string_concat(ctx, av, bv);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                } else {
                    if zjs_is_symbol(av) != 0 {
                        raise_symbol_to_number(ctx);
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                    regs[inst.a] = zjs_arith_add(av, bv);
                }
            }
        } else if op == Op::SubImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                let ai: i64 = (i64)zjs_as_int32(av);
                let diff: i64 = ai - (i64)imm;
                let fits: int = 0;
                raw { fits = (diff >= INT32_MIN && diff <= INT32_MAX) ? 1 : 0; }
                if fits != 0 {
                    regs[inst.a] = zjs_int32((i32)diff);
                } else {
                    regs[inst.a] = zjs_double((f64)diff);
                }
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_symbol(av) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_arith_sub(av, bv);
            }
        } else if op == Op::CmpLtImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) < imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_symbol(av) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_bool(zjs_cmp_lt(av, bv));
            }
        } else if op == Op::CmpLeImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) <= imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_symbol(av) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_bool(zjs_cmp_le(av, bv));
            }
        } else if op == Op::CmpGtImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) > imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_symbol(av) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                // a > b is `b < a` (CmpGt's actual semantics — order swap).
                regs[inst.a] = zjs_bool(zjs_cmp_lt(bv, av));
            }
        } else if op == Op::CmpGeImm {
            let av = regs[inst.b];
            let imm: i32 = (i32)(i8)inst.c;
            if zjs_is_int32(av) != 0 {
                regs[inst.a] = zjs_bool(if zjs_as_int32(av) >= imm { 1 } else { 0 });
            } else {
                let bv = zjs_int32(imm);
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_symbol(av) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_bool(zjs_cmp_le(bv, av));
            }
        } else if op == Op::JmpIfNotLt {
            let av = regs[inst.a]; let bv = regs[inst.b];
            let cond_true: bool = false;
            if zjs_is_int32(av) != 0 && zjs_is_int32(bv) != 0 {
                cond_true = zjs_as_int32(av) < zjs_as_int32(bv);
            } else {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if zjs_is_symbol(av) != 0 || zjs_is_symbol(bv) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                cond_true = zjs_cmp_lt(av, bv);
            }
            if !cond_true {
                let off = inst_bc_i16(code[ip + 1]);
                ip = (u32)((i32)ip + 1 + off);
            } else {
                ip = ip + 1;
            }
        } else if op == Op::JmpIfNotLe {
            let av = regs[inst.a]; let bv = regs[inst.b];
            let cond_true: bool = false;
            if zjs_is_int32(av) != 0 && zjs_is_int32(bv) != 0 {
                cond_true = zjs_as_int32(av) <= zjs_as_int32(bv);
            } else {
                if is_object_like(av) != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if is_object_like(bv) != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
