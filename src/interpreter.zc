                let off = inst_bc_i16(code[ip + 1]);
                if off < 0 { ctx_maybe_gc(ctx); }
                ip = (u32)((i32)ip + 1 + off);
            } else {
                ip = ip + 1;
            }
        } else if op == Op::ImportBind {
            // Resolve `b` (specifier atom) against ctx.current_module's
            // abs_path, load that module if not yet cached, then read
            // its exports[name] (`c` atom) into regs[a]. A "*" name
            // means namespace import — return the exports object itself.
            let spec_v = f.constants[inst.b];
            let name_v = f.constants[inst.c];
            if zjs_is_string(spec_v) == 0 || zjs_is_string(name_v) == 0 {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"ImportBind operand not a string", 31);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
            let target_v: ZjsValue = zjs_undefined();
            raw {
                extern ZjsValue ctx_module_import_value(ZjsContext* ctx, ZjsValue spec, ZjsValue name);
                target_v = ctx_module_import_value(ctx, spec_v, name_v);
            }
            if ctx.pending_throw_active {
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
            regs[inst.a] = target_v;
        } else if op == Op::ExportBind {
            // Write regs[a] into ctx.current_module.exports[name].
            let name_v = f.constants[inst.b];
            if zjs_is_string(name_v) == 0 || ctx.current_module == NULL {
                // Silently ignore — defensive. ExportBind is only ever
                // emitted in module-mode top-level, so a missing
                // current_module is a runner bug.
            } else {
                let name = zjs_as_string(name_v);
                let val  = regs[inst.a];
                object_set(ctx, ctx.current_module.exports, name, val);
            }
        } else if op == Op::DynamicImport {
            // import(specifier): regs[b] is the specifier. ctx_dynamic_import
            // resolves+loads and returns a Promise of the namespace; all
            // failures become a rejected promise, so we never throw here.
            let spec_v = regs[inst.b];
            let result_v: ZjsValue = zjs_undefined();
            raw {
                extern ZjsValue ctx_dynamic_import(ZjsContext* ctx, ZjsValue spec);
                result_v = ctx_dynamic_import(ctx, spec_v);
            }
            regs[inst.a] = result_v;
        } else if op == Op::ImportMeta {
            let meta_v: ZjsValue = zjs_undefined();
            raw {
                extern ZjsValue ctx_import_meta(ZjsContext* ctx);
                meta_v = ctx_import_meta(ctx);
            }
            regs[inst.a] = meta_v;
        } else if op == Op::GeneratorStart {
            // End of the generator's prologue. Only the INITIAL call
            // from bytecode-Invoke (state == GEN_STARTING) suspends
            // here; .next()-driven resumes (state == GEN_RUNNING)
            // sail past so the body runs to its first yield.
            let gen = ctx.frames[cur_idx].generator;
            if gen == NULL || gen.state != GEN_STARTING {
                ip = ip + 1;
                continue;
            }
            let n = ctx.frames[cur_idx].reg_count;
            if gen.saved_regs == NULL || gen.reg_count != n {
                if gen.saved_regs != NULL { dealloc(gen.saved_regs); }
                gen.saved_regs = alloc_n<ZjsValue>((usize)n);
                gen.reg_count = n;
            }
            let i: u32 = 0;
            while i < n {
                gen.saved_regs[i] = regs[i];
                i = i + 1;
            }
            gen.saved_ip = ip + 1;
            // Suspend barrier: if this generator was already promoted to old,
            // its saved_regs now hold young values (re-scan it next minor).
            gc_barrier_cell(ctx, (void*)gen);
            // First .next() resumes the body; no value is delivered to
            // a yield's dst register (there is none yet). Mark as
            // GEN_INITIAL so the resume path skips the resume_value
            // write — same convention as a make_generator_iter-built
            // iter that hasn't been stepped yet.
            gen.resume_dst = 0;
            gen.state = GEN_INITIAL;
            let ret_dst = pop_call_frame(ctx);
            let gen_v = zjs_cell_from_ptr((void*)gen);
            if ctx.frame_count <= entry_frame {
                final_result = gen_v;
            } else {
                let cidx = ctx.frame_count - 1;
                let cb = ctx.frames[cidx].regs_base;
                ctx.reg_stack[cb + (u32)ret_dst] = gen_v;
            }
            exit_reason = 1;
            break;
        } else if op == Op::TemplateObject {
            // Tagged-template strings array — cached per call site
            // (ECMA-262 §13.2.8.4 GetTemplateObject). On first reach,
            // build the cooked-strings array from f.template_cooked,
            // build the parallel raw array, attach raw via .raw, and
            // cache. Subsequent reaches return the cached cell.
            let site = inst_bc_u16(inst);
            if site >= f.template_count {
                // Compiler bug — emitted with a stale index. Surface
                // as a TypeError rather than corrupting the heap.
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"invalid template-object index", 30);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
            let cached: ZjsArray* = f.template_cache[site];
            if cached != NULL {
                regs[inst.a] = zjs_cell_from_ptr((void*)cached);
            } else {
                let s_off = f.template_seg_start[site];
                let s_end = f.template_seg_start[site + 1];
                let s_n   = s_end - s_off;
                // Build cooked + raw strings arrays.
                let cooked_v = ctx_new_array(ctx, s_n);
                let cooked = zjs_as_array(cooked_v);
                let raw_v  = ctx_new_array(ctx, s_n);
                let raw_arr = zjs_as_array(raw_v);
                let k: u32 = 0;
                while k < s_n {
                    let ck: ZjsString* = f.template_cooked[s_off + k];
                    if ck == NULL {
                        // Invalid escape — spec says cooked[k] is undefined.
                        cooked.elements[k] = zjs_undefined();
                    } else {
                        cooked.elements[k] = zjs_cell_from_ptr((void*)ck);
                    }
                    raw_arr.elements[k] = zjs_cell_from_ptr((void*)f.template_raw[s_off + k]);
                    k = k + 1;
                }
                cooked.length = s_n;
                raw_arr.length = s_n;
                // cooked.raw = raw — landed in the lazy expando bag.
                if cooked.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    cooked.props = zjs_as_object(pv);
                }
                object_set(ctx, cooked.props,
                           ctx_intern_atom(ctx, (char*)"raw", 3), raw_v);
                // Mark both arrays as immutable so user-tag mutations
                // don't poison the cached state on subsequent reaches.
                cooked.frozen = true;
                raw_arr.frozen = true;
                if cooked.props != NULL { cooked.props.frozen = true; }
                f.template_cache[site] = cooked;
                // Site caches populate lazily — by the time an old function
                // first reaches a tagged template, the cooked array is young.
                gc_barrier_cell(ctx, (void*)f);
                regs[inst.a] = cooked_v;
            }
        } else if op == Op::Yield {
            // `yield expr` inside a generator body. Build the
            // iterator-result object, snapshot the frame state onto
            // the owning generator, then pop the frame and surface
            // the iter-result as the inner-interpret's return value
            // back to the iter.next() host handler.
            let gen = ctx.frames[cur_idx].generator;
            if gen == NULL {
                let err = build_typed_error(ctx, (char*)"SyntaxError", 11,
                                            (char*)"yield outside generator body", 28);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
            // Snapshot regs.
            let n = ctx.frames[cur_idx].reg_count;
            if gen.saved_regs == NULL || gen.reg_count != n {
                if gen.saved_regs != NULL { dealloc(gen.saved_regs); }
                gen.saved_regs = alloc_n<ZjsValue>((usize)n);
                gen.reg_count = n;
            }
            let i: u32 = 0;
            while i < n {
                gen.saved_regs[i] = regs[i];
                i = i + 1;
            }
            gen.saved_ip = ip + 1;
            // Suspend barrier: a promoted (old) generator re-saving young regs.
            gc_barrier_cell(ctx, (void*)gen);
            gen.resume_dst = inst.a;
            gen.saved_host_this = ctx.host_this;
            gen.saved_current_closure = ctx.current_closure;
            gen.state = GEN_YIELDED;
            gen_save_try_handlers(ctx, gen, cur_idx);

            let yielded_value = regs[inst.b];
            let iter_result = build_iter_result(ctx, yielded_value, false);
            // Pop the frame and treat the iter-result as the return
            // value to the caller (the iter.next() host trampoline).
            let ret_dst = pop_call_frame(ctx);
            if ctx.frame_count <= entry_frame {
                final_result = iter_result;
            } else {
                let cidx = ctx.frame_count - 1;
                let cb = ctx.frames[cidx].regs_base;
                ctx.reg_stack[cb + (u32)ret_dst] = iter_result;
            }
            exit_reason = 1;
            break;
        } else if op == Op::Await {
            // Resolve the awaited value:
            //   - non-Promise:       pass through (already resolved)
            //   - fulfilled Promise: extract value
            //   - rejected  Promise: throw the reason
            //   - pending   Promise: SUSPEND. Build a ZjsAsyncCont from
            //     the current frame, register host_async_resume_* as the
            //     Promise's then-reactions, pop the frame, and exit the
            //     dispatch loop. The microtask drain will fire the
            //     resume handler when the Promise settles.
            // Op::Await — two execution shapes depending on what kind
            // of frame the await sits in:
            //
            //   Async function (frame.outer_promise is a Promise):
            //     Spec §27.6.3 — ALWAYS suspend + round-trip through a
            //     microtask, even for already-settled promises. That's
            //     the yield point that lets queueMicrotask callbacks
            //     queued before the await drain first.
            //
            //   Async generator (frame.generator != NULL, no
            //   outer_promise):
            //     Synchronous unwrap. The generator's suspension is
            //     managed by Op::Yield + host_generator_next, not by
            //     an outer Promise; suspending here would lose the
            //     gen-resume path. Wiring a proper AsyncGeneratorAwait
            //     that snapshots the generator state and resumes via
            //     a Promise reaction is its own work-stream (see
            //     `project_await_microtask_roundtrip` memory). Until
            //     then, fulfilled = pass value through, rejected =
            //     synchronous throw. This matches what async-gen test262
            //     tests rely on.
            //
            //   Non-Promise value: pass through (nothing to unwrap).
            let v = regs[inst.b];
            // Spec §27.6.3 Await is `PromiseResolve(%Promise%, v)` for
            // EVERY value: even `await <primitive>` must suspend and resume
            // in a microtask (so code after it runs after already-queued
            // microtasks, not synchronously). In an async FUNCTION, wrap a
            // non-promise operand in a freshly-resolved promise — which also
            // adopts thenables — so the promise-suspend path below handles
            // it uniformly. Async GENERATORS keep the legacy synchronous
            // passthrough (a spec-exact AsyncGeneratorAwait is its own
            // workstream — see project_await_microtask_roundtrip).
            if zjs_is_promise(v) == 0 {
                let fo_a = ctx.frames[cur_idx].outer_promise;
                let is_afn_a: bool = zjs_is_promise(fo_a) != 0;
                let is_agen_a: bool = ctx.frames[cur_idx].generator != NULL && f.is_async;
                // PromiseResolve(v) for BOTH async functions AND async
                // generators — this adopts thenables (a thenable becomes a
                // PENDING promise resolved by its .then, routing through the
                // suspend path below). A primitive / non-thenable object yields
                // an immediately-fulfilled promise (synchronous resume, as the
                // legacy async-gen path did), so only thenables change.
                if is_afn_a || is_agen_a {
                    let np = zjs_promise_new();
                    ctx_register_cell(ctx, (void*)np);
                    let np_v = zjs_cell_from_ptr((void*)np);
                    promise_resolve_with(ctx, np_v, v);
                    v = np_v;
                }
            }
            if zjs_is_promise(v) != 0 {
                let p = zjs_as_promise(v);
                let frame_outer = ctx.frames[cur_idx].outer_promise;
                let in_async_fn: bool = zjs_is_promise(frame_outer) != 0;
                let in_async_gen: bool = ctx.frames[cur_idx].generator != NULL && f.is_async;

                if !in_async_fn && !in_async_gen {
                    let err = build_typed_error(ctx, (char*)"SyntaxError", 11,
                                                (char*)"await is only valid in async functions", 39);
                    throwing = true; thrown = err; exit_reason = 3;
                    ctx.frames[cur_idx].ip = ip; break;
                }

                if in_async_gen {
                    // Async-generator await:
                    //   fulfilled / rejected — synchronous unwrap as
                    //   before. The pre-existing async-gen tests depend
                    //   on this (yield-promise-reject patterns trace
                    //   through it).
                    //   pending — snapshot generator state, attach
                    //   reactions on the awaited promise, suspend the
                    //   generator frame. host_async_gen_resume_* will
                    //   re-resume when the promise settles.
                    let g = ctx.frames[cur_idx].generator;
                    if p.state == PROMISE_FULFILLED {
                        regs[inst.a] = p.value;
                    } else if p.state == PROMISE_REJECTED {
                        throwing = true; thrown = p.value;
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    } else {
                        // Snapshot regs onto the generator (same shape
                        // as Op::Yield).
                        let n = ctx.frames[cur_idx].reg_count;
                        if g.saved_regs == NULL || g.reg_count != n {
                            if g.saved_regs != NULL { dealloc(g.saved_regs); }
                            g.saved_regs = alloc_n<ZjsValue>((usize)n);
                            g.reg_count = n;
                        }
                        let si: u32 = 0;
                        while si < n {
                            g.saved_regs[si] = regs[si];
                            si = si + 1;
                        }
                        g.saved_ip = ip + 1;
                        // Suspend barrier: promoted async generator re-saving young regs.
                        gc_barrier_cell(ctx, (void*)g);
                        // resume_dst doubles as await_dst — they're
                        // never both active (generator either yielded
                        // or awaiting).
                        g.resume_dst = inst.a;
                        g.saved_host_this = ctx.host_this;
                        g.saved_current_closure = ctx.current_closure;
                        g.state = GEN_AWAITING;
                        gen_save_try_handlers(ctx, g, cur_idx);

                        // Build resume host-fns carrying the generator.
                        let on_f_ptr: void* = NULL;
                        let on_r_ptr: void* = NULL;
                        raw {
                            on_f_ptr = (void*)host_async_gen_resume_fulfilled;
                            on_r_ptr = (void*)host_async_gen_resume_rejected;
                        }
                        let on_f = ctx_make_host_function_arity(ctx, (char*)"async_gen_resume_fulfilled", on_f_ptr, 1);
                        let on_r = ctx_make_host_function_arity(ctx, (char*)"async_gen_resume_rejected",  on_r_ptr, 1);
                        let g_v = zjs_cell_from_ptr((void*)g);
                        zjs_as_host_function(on_f).bound = g_v;
                        zjs_as_host_function(on_r).bound = g_v;
                        promise_attach_reaction(ctx, p, on_f, on_r, zjs_undefined());

                        // Pop the frame. host_generator_next is sitting
                        // upstack waiting for our inner-loop result; the
                        // signal "generator is now awaiting" is the
                        // GEN_AWAITING state on g. final_result stays
                        // undefined; host_generator_next sees the state
                        // and returns g.pending_next_promise (still
                        // pending).
                        let ret_dst2 = pop_call_frame(ctx);
                        if ctx.frame_count <= entry_frame {
                            final_result = zjs_undefined();
                        } else {
                            let cidx = ctx.frame_count - 1;
                            let cb = ctx.frames[cidx].regs_base;
                            ctx.reg_stack[cb + (u32)ret_dst2] = zjs_undefined();
                        }
                        exit_reason = 1;
                        break;
                    }
                } else {
                    // Async function: suspend + microtask round-trip.
                    let cont = zjs_async_cont_new();
                    ctx_register_cell(ctx, (void*)cont);
                    cont.function = f;
                    cont.reg_count = ctx.frames[cur_idx].reg_count;
                    cont.saved_regs = alloc_n<ZjsValue>((usize)cont.reg_count);
                    let ri: u32 = 0;
                    while ri < cont.reg_count {
                        cont.saved_regs[ri] = regs[ri];
                        ri = ri + 1;
                    }
                    cont.saved_ip = ip + 1;
                    // Suspend barrier: a promoted (old) async continuation
                    // re-saving young regs (e.g. a freshly-awaited Promise) on a
                    // later await — re-scan it next minor so the awaited value
                    // isn't swept. (The async-pipeline-soak ASan UAF.)
                    gc_barrier_cell(ctx, (void*)cont);
                    cont.await_dst = inst.a;
                    cont.saved_host_this = ctx.host_this;
                    cont.saved_current_closure = ctx.current_closure;
                    cont.outer_promise = frame_outer;
                    // Snapshot the catch handlers active in this frame so a
                    // rejected resume can unwind into the body's try/catch
                    // (pop_call_frame below truncates the ctx try stack).
                    let try_at_entry = ctx.frames[cur_idx].try_depth_at_entry;
                    let try_n = if ctx.ctx_try_depth > try_at_entry { ctx.ctx_try_depth - try_at_entry } else { 0 };
                    if try_n > 0 {
                        cont.saved_try_count = try_n;
                        cont.saved_try_ip = alloc_n<usize>((usize)try_n);
                        cont.saved_try_reg = alloc_n<u8>((usize)try_n);
                        let ti: u32 = 0;
                        while ti < try_n {
                            cont.saved_try_ip[ti] = ctx.ctx_try_stack[try_at_entry + ti].catch_ip;
                            cont.saved_try_reg[ti] = ctx.ctx_try_stack[try_at_entry + ti].catch_reg;
                            ti = ti + 1;
                        }
                    }
                    let cont_v = zjs_cell_from_ptr((void*)cont);

                    let on_f_ptr: void* = NULL;
                    let on_r_ptr: void* = NULL;
                    raw {
                        on_f_ptr = (void*)host_async_resume_fulfilled;
                        on_r_ptr = (void*)host_async_resume_rejected;
                    }
                    let on_f = ctx_make_host_function_arity(ctx, (char*)"async_resume_fulfilled", on_f_ptr, 1);
                    let on_r = ctx_make_host_function_arity(ctx, (char*)"async_resume_rejected",  on_r_ptr, 1);
                    zjs_as_host_function(on_f).bound = cont_v;
                    zjs_as_host_function(on_r).bound = cont_v;

                    if p.state == PROMISE_FULFILLED {
                        microtask_enqueue(ctx, on_f, p.value, zjs_undefined(), true);
                    } else if p.state == PROMISE_REJECTED {
                        microtask_enqueue(ctx, on_r, p.value, zjs_undefined(), false);
                    } else {
                        promise_attach_reaction(ctx, p, on_f, on_r, zjs_undefined());
                    }

                    pop_call_frame(ctx);
                    exit_reason = 1;
                    break;
                }
            } else {
                regs[inst.a] = v;
            }
        } else if op == Op::Mul {
            let av = regs[inst.b]; let bv = regs[inst.c];
            let av_obj: int = is_object_like(av);
            let bv_obj: int = is_object_like(bv);
            if av_obj != 0 || bv_obj != 0 {
                if av_obj != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if bv_obj != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            let bh_mul = false;
            let br_mul = zjs_undefined();
            if zjs_is_bigint(av) != 0 || zjs_is_bigint(bv) != 0 { br_mul = bigint_try_binop(ctx, 2, av, bv, &bh_mul); }
            if bh_mul {
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = br_mul;
            } else {
                if zjs_is_symbol(av) != 0 || zjs_is_symbol(bv) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_arith_mul(av, bv);
            }
        } else if op == Op::Div {
            let av = regs[inst.b]; let bv = regs[inst.c];
            let av_obj: int = is_object_like(av);
            let bv_obj: int = is_object_like(bv);
            if av_obj != 0 || bv_obj != 0 {
                if av_obj != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if bv_obj != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            let bh_div = false;
            let br_div = zjs_undefined();
            if zjs_is_bigint(av) != 0 || zjs_is_bigint(bv) != 0 { br_div = bigint_try_binop(ctx, 3, av, bv, &bh_div); }
            if bh_div {
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = br_div;
            } else {
                if zjs_is_symbol(av) != 0 || zjs_is_symbol(bv) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_arith_div(av, bv);
            }
        } else if op == Op::Mod {
            let av = regs[inst.b]; let bv = regs[inst.c];
            let av_obj: int = is_object_like(av);
            let bv_obj: int = is_object_like(bv);
            if av_obj != 0 || bv_obj != 0 {
                if av_obj != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
                if bv_obj != 0 {
                    bv = zjs_to_primitive(ctx, bv, false);
                    if ctx.pending_throw_active {
                        throwing = true; thrown = consume_pending_throw(ctx);
                        exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                    }
                }
            }
            let bh_mod = false;
            let br_mod = zjs_undefined();
            if zjs_is_bigint(av) != 0 || zjs_is_bigint(bv) != 0 { br_mod = bigint_try_binop(ctx, 4, av, bv, &bh_mod); }
            if bh_mod {
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = br_mod;
            } else {
                if zjs_is_symbol(av) != 0 || zjs_is_symbol(bv) != 0 {
                    raise_symbol_to_number(ctx);
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                regs[inst.a] = zjs_arith_mod(av, bv);
            }
        } else if op == Op::Pow {
            let av = regs[inst.b]; let bv = regs[inst.c];
            let av_obj: int = is_object_like(av);
            let bv_obj: int = is_object_like(bv);
            if av_obj != 0 || bv_obj != 0 {
                if av_obj != 0 {
                    av = zjs_to_primitive(ctx, av, false);
                    if ctx.pending_throw_active {
