                // a poll in that window let a minor free a freshly built
                // host return value (#375: `return arr.values()` tail-
                // called build_array_iterator, then the post-call poll
                // swept the iterator before the store).
                ctx_maybe_gc(ctx);
                let hf_ptr = zjs_cell_as_ptr(callee);
                let argv_ptr: ZjsValue* = NULL;
                raw { argv_ptr = &regs[base + arg_offset]; }
                let saved_host = ctx.host_this;
                ctx.host_this = new_this;
                let saved_host_fn = ctx.current_host_fn;
                ctx.current_host_fn = hf_ptr;
                let r: ZjsValue = zjs_undefined();
                raw {
                    ZjsHostFunction* hf = (ZjsHostFunction*)hf_ptr;
                    typedef ZjsValue (*HostFn)(ZjsContext*, ZjsValue*, uint32_t);
                    HostFn fp = (HostFn)hf->fn_ptr;
                    ZjsRealm* _sr_realm = ctx->realm;
                    if (hf->realm) ctx->realm = hf->realm;
                    r = fp(ctx, argv_ptr, argc); ctx->realm = _sr_realm;
                }
                ctx.current_host_fn = saved_host_fn;
                ctx.host_this = saved_host;
                if ctx.pending_throw_active {
                    // Tail callee threw — pop our frame (we're already
                    // semantically "returned") and surface the throw in
                    // the caller. NO poll here: thrown_v lives only in
                    // this C local until the outer loop roots it.
                    let thrown_v = consume_pending_throw(ctx);
                    let _ = pop_call_frame(ctx);
                    throwing = true;
                    thrown = thrown_v;
                    exit_reason = 3;
                    break;
                }
                // Pop and write result like an implicit Return. NO poll
                // between the call and the store (see above).
                let ret_dst = pop_call_frame(ctx);
                if ctx.frame_count <= entry_frame {
                    final_result = r;
                } else {
                    let cidx = ctx.frame_count - 1;
                    let cb = ctx.frames[cidx].regs_base;
                    ctx.reg_stack[cb + (u32)ret_dst] = r;
                }
                exit_reason = 1;
                break;
            } else {
                // Not callable — return undefined to caller.
                let ret_dst = pop_call_frame(ctx);
                if ctx.frame_count <= entry_frame {
                    final_result = zjs_undefined();
                } else {
                    let cidx = ctx.frame_count - 1;
                    let cb = ctx.frames[cidx].regs_base;
                    ctx.reg_stack[cb + (u32)ret_dst] = zjs_undefined();
                }
                exit_reason = 1;
                break;
            }
        } else if op == Op::Typeof {
            let v = regs[inst.b];
            let label: char* = (char*)"undefined";
            if zjs_is_undefined(v) != 0 {
                label = (char*)"undefined";
            } else if zjs_is_null(v) != 0 {
                label = (char*)"object";
            } else if zjs_is_bool(v) != 0 {
                label = (char*)"boolean";
            } else if zjs_is_number(v) != 0 {
                label = (char*)"number";
            } else if zjs_is_string(v) != 0 {
                label = (char*)"string";
            } else if zjs_is_function(v) != 0 || zjs_is_host_function(v) != 0 || zjs_is_closure(v) != 0 {
                label = (char*)"function";
            } else if zjs_is_symbol(v) != 0 {
                label = (char*)"symbol";
            } else if zjs_is_bigint(v) != 0 {
                label = (char*)"bigint";
            } else {
                label = (char*)"object";
            }
            let llen: u32 = 0;
            raw { llen = (uint32_t)strlen(label); }
            regs[inst.a] = ctx_intern_string(ctx, label, llen);
        } else if op == Op::DefineMethod {
            // Class method definition: install on `obj` with attrs
            // (writable + configurable, NOT enumerable). The ic-slot
            // gives us the method name; the value sits in regs[c].
            let obj_v = regs[inst.a];
            let ic_slot = inst.b;
            let value = regs[inst.c];
            let target_obj: ZjsObject* = NULL;
            if zjs_is_object(obj_v) != 0 {
                target_obj = zjs_as_object(obj_v);
            } else if zjs_is_function(obj_v) != 0 {
                // Static methods on a Function*: install on .props.
                let fp = zjs_cell_as_ptr(obj_v);
                let ff: Function* = NULL;
                raw { ff = (Function*)fp; }
                if ff.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    ff.props = zjs_as_object(pv);
                }
                target_obj = ff.props;
            } else if zjs_is_closure(obj_v) != 0 {
                let cl = zjs_as_closure(obj_v);
                let fp2 = cl.function;
                let f2: Function* = NULL;
                raw { f2 = (Function*)fp2; }
                if f2.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    f2.props = zjs_as_object(pv);
                }
                target_obj = f2.props;
            }
            if target_obj != NULL {
                let ic_name: ZjsString* = f.ics[ic_slot].name;
                let attrs: u8 = PROP_WRITABLE | PROP_CONFIGURABLE;
                object_define_property_slot(ctx, target_obj, ic_name, value, attrs);
            }
        } else if op == Op::DefineMethodComputed {
            // Same as DefineMethod but the key is read from a register
            // (a Symbol or string) instead of an IC slot. Symbol keys
            // coerce to their canonical atom via symbol_key_coerce so
            // the install matches what property_get later expects.
            let obj_v = regs[inst.a];
            let mut_key_v = symbol_key_coerce(regs[inst.b]);
            let value = regs[inst.c];
            if zjs_is_string(mut_key_v) == 0 { mut_key_v = zjs_to_string(ctx, mut_key_v); }
            let name = zjs_as_string(mut_key_v);
            let target_obj: ZjsObject* = NULL;
            if zjs_is_object(obj_v) != 0 {
                target_obj = zjs_as_object(obj_v);
            } else if zjs_is_function(obj_v) != 0 {
                let fp = zjs_cell_as_ptr(obj_v);
                let ff: Function* = NULL;
                raw { ff = (Function*)fp; }
                if ff.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    ff.props = zjs_as_object(pv);
                }
                target_obj = ff.props;
            } else if zjs_is_closure(obj_v) != 0 {
                let cl = zjs_as_closure(obj_v);
                let fp2 = cl.function;
                let f2: Function* = NULL;
                raw { f2 = (Function*)fp2; }
                if f2.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    f2.props = zjs_as_object(pv);
                }
                target_obj = f2.props;
            }
            if target_obj != NULL {
                let attrs: u8 = PROP_WRITABLE | PROP_CONFIGURABLE;
                object_define_property_slot(ctx, target_obj, name, value, attrs);
            }
        } else if op == Op::SetProto {
            // a = proto, b = obj. Wire obj.proto = proto (both must be
            // Objects; non-object args are silently no-ops).
            let proto_v = regs[inst.a];
            let obj_v   = regs[inst.b];
            if zjs_is_object(obj_v) != 0 {
                let o = zjs_as_object(obj_v);
                if zjs_is_object(proto_v) != 0 {
                    o.proto = zjs_as_object(proto_v);
                } else if zjs_is_null(proto_v) != 0 {
                    o.proto = NULL;
                }
            }
        } else if op == Op::SetParentCtor {
            let ctor_v = regs[inst.a];
            let parent_v = regs[inst.b];
            // ECMA-262 14.6.6 step 5: parent must be a constructor
            // (callable with a [[Construct]] internal method) or null.
            // We allow user functions / closures / host fns with a
            // .prototype set (the same gate require_promise_constructor_this
            // uses), and explicit null.
            let parent_ok: bool = false;
            if zjs_is_null(parent_v) != 0 { parent_ok = true; }
            else if zjs_is_function(parent_v) != 0 || zjs_is_closure(parent_v) != 0 {
                parent_ok = true;
            } else if zjs_is_host_function(parent_v) != 0 {
                let phf = zjs_as_host_function(parent_v);
                if phf.prototype != NULL { parent_ok = true; }
            }
            if !parent_ok {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Class extends value is not a constructor", 40);
                throwing = true; thrown = err; exit_reason = 3; break;
            }
            if zjs_is_function(ctor_v) != 0 {
                let fp = zjs_cell_as_ptr(ctor_v);
                let ff: Function* = NULL;
                raw { ff = (Function*)fp; }
                ff.parent_ctor = parent_v;
                // Class templates are shared across re-executions of the
                // declaration — the template can be old, the parent young.
                gc_barrier_cell(ctx, fp);
            } else if zjs_is_closure(ctor_v) != 0 {
                let cl = zjs_as_closure(ctor_v);
                let fp2 = cl.function;
                let ff2: Function* = NULL;
                raw { ff2 = (Function*)fp2; }
                ff2.parent_ctor = parent_v;
                gc_barrier_cell(ctx, fp2);
            }
        } else if op == Op::SetFunctionName {
            // ECMA-262 SetFunctionName: install `name` on the function
            // value with spec attrs (writable=false, enumerable=false,
            // configurable=true). Used by NamedEvaluation when an
            // anonymous function/class is assigned to a binding.
            let fn_v = regs[inst.a];
            let name_v = regs[inst.b];
            if zjs_is_string(name_v) != 0 {
                let target_f: Function* = NULL;
                if zjs_is_function(fn_v) != 0 {
                    let fp = zjs_cell_as_ptr(fn_v);
                    raw { target_f = (Function*)fp; }
                } else if zjs_is_closure(fn_v) != 0 {
                    let cl = zjs_as_closure(fn_v);
                    let fp2 = cl.function;
                    raw { target_f = (Function*)fp2; }
                }
                if target_f != NULL {
                    if target_f.props == NULL {
                        let pv = ctx_new_props_bag(ctx);
                        target_f.props = zjs_as_object(pv);
                    }
                    let name_atom = ctx_intern_atom(ctx, (char*)"name", 4);
                    object_define_property_slot(ctx, target_f.props, name_atom, name_v, PROP_CONFIGURABLE);
                }
            }
        } else if op == Op::SuperCall || op == Op::SpreadSuperCall {
            // super(...): call parent ctor with the in-flight `this`
            // and new_target_active preserved. SpreadSuperCall handles
            // `super(...args)` — the args were materialized into an array
            // at regs[base+1] (esbuild emits this when lowering a subclass
            // with instance fields to `constructor(...e){ super(...e); … }`).
            let dst = inst.a;
            let base = inst.b;
            let parent = regs[base];
            // Spec: a derived-class constructor must call super exactly
            // once. The second call throws ReferenceError ("Super
            // constructor may only be called once").
            if ctx.frame_count > 0 && ctx.frames[cur_idx].super_called {
                let err = build_typed_error(ctx, (char*)"ReferenceError", 14,
                                            (char*)"Super constructor may only be called once", 41);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
            let argc: u32 = 0;
            let argv_ptr: ZjsValue* = NULL;
            if op == Op::SuperCall {
                argc = (u32)inst.c;
                if argc > 0 { raw { argv_ptr = &regs[base + 1]; } }
            } else {
                // SpreadSuperCall: args in the dense array at regs[base+1];
                // its contiguous backing store IS the argv (cap mirrors
                // SpreadNewInvoke's 32-arg limit).
                let arr_v = regs[base + 1];
                if zjs_is_array(arr_v) == 0 {
                    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                                (char*)"Spread arguments must resolve to an array", 41);
                    throwing = true; thrown = err; exit_reason = 3;
                    ctx.frames[cur_idx].ip = ip; break;
                }
                let arr_s = zjs_as_array(arr_v);
                argc = arr_s.length;
                if argc > 0 { raw { argv_ptr = arr_s->elements; } }
            }
            // Some host ctors (Promise, RegExp, ...) allocate a special
            // cell rather than reusing host_this — model this as `new
            // parent(...)` so the result is treated as the freshly
            // constructed instance. For TAG_FUNCTION / TAG_CLOSURE the
            // user ctor mutates host_this in place; we pass that through.
            let parent_is_host = zjs_is_host_function(parent) != 0;
            let r: ZjsValue = zjs_undefined();
            let saved_nt = ctx.new_target_active;
            let saved_ntv = ctx.new_target_value;
            ctx.new_target_active = true;
            // ECMA-262 §13.3.7.1 SuperCall: new.target propagates from
            // the outer (currently running) constructor, NOT the parent
            // we're delegating to. Built-in ctors (Array, Map, …) use
            // new.target.prototype to set the instance's [[Prototype]],
            // so this is what enables `class Sub extends Array {}`
            // to actually produce Sub-typed instances.
            if saved_nt { ctx.new_target_value = saved_ntv; }
            else        { ctx.new_target_value = parent; }
            if parent_is_host {
                let saved_th = ctx.host_this;
                raw { r = zjs_call_value_with_this(ctx, parent, ctx->host_this, argv_ptr, argc); }
                ctx.host_this = saved_th;
            } else {
                raw { r = zjs_call_value_with_this(ctx, parent, ctx->host_this, argv_ptr, argc); }
            }
            ctx.new_target_active = saved_nt;
            ctx.new_target_value = saved_ntv;
            if ctx.pending_throw_active {
                throwing = true;
                thrown = consume_pending_throw(ctx);
                exit_reason = 3; break;
            }
            // If the parent ctor handed us a freshly-allocated cell
            // (Promise / RegExp / etc.) rather than mutating host_this,
            // rebind host_this to it so the rest of the derived ctor +
            // NewInvoke's result-selection see the parent's instance.
            // We also overwrite the current frame's saved_host_this so
            // pop_call_frame on Op::Return propagates the new this back
            // up to the NewInvoke caller (otherwise the pop restores
            // host_this to new_obj_v and we lose the special cell).
            let r_is_special_cell: bool = zjs_is_promise(r) != 0
                                         || zjs_is_regexp(r) != 0;
            if r_is_special_cell {
                ctx.host_this = r;
                if ctx.frame_count > 0 {
                    ctx.frames[ctx.frame_count - 1].saved_host_this = r;
                }
                // Host-initiated constructs can't see the host_this
                // rebind (zjs_call_value_with_this restores it on
                // return) — record the real instance for
                // zjs_construct_value_nt's result selection (#375).
                ctx.last_super_this = r;
            }
            // Mark `this` as initialized for the spec's "must-call-super"
            // check at Op::Return.
            if ctx.frame_count > 0 {
                ctx.frames[ctx.frame_count - 1].super_called = true;
            }
            regs[dst] = r;
        } else if op == Op::Throw {
            throwing = true;
            thrown = regs[inst.a];
            raw {
                if (zjs_trace_unwind_enabled) {
                    fprintf(stderr,
                        "[zjs:trace_unwind] Op::Throw f=%p ip=%zu code_len=%zu try_depth=%u frame_count=%u\n",
                        (void*)f, (size_t)ip, (size_t)code_len,
                        (unsigned)ctx->ctx_try_depth, (unsigned)ctx->frame_count);
                }
            }
            exit_reason = 3;
            break;
        } else if op == Op::EnterTry {
            let off = inst_bc_i16(inst);
            let target: usize = (usize)((i32)ip + 1 + off);
            if !ctx_try_push(ctx, target, inst.a) {
                // Out of try slots — surface as an uncaught throw.
                throwing = true;
                thrown = zjs_undefined();
                exit_reason = 3;
                break;
            }
        } else if op == Op::LeaveTry {
            ctx_try_pop(ctx);
        } else if op == Op::DefineGetter || op == Op::DefineSetter
                  || op == Op::DefineMethodGetter || op == Op::DefineMethodSetter {
            // Install (or merge into existing) an accessor slot on
            // `regs[a]` at key `regs[b]` (an atom-string), with the
            // function `regs[c]` as the getter or setter.
            let obj_v = regs[inst.a];
            let key_v = regs[inst.b];
            let fn_v  = regs[inst.c];
            // Route static class accessors (where the target is the
            // constructor function itself) onto its .props expando.
            let target_o: ZjsObject* = NULL;
            if zjs_is_object(obj_v) != 0 {
                target_o = zjs_as_object(obj_v);
            } else if zjs_is_function(obj_v) != 0 {
                let fp_dg = zjs_cell_as_ptr(obj_v);
                let ff_dg: Function* = NULL;
                raw { ff_dg = (Function*)fp_dg; }
                if ff_dg.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    ff_dg.props = zjs_as_object(pv);
                }
                target_o = ff_dg.props;
            } else if zjs_is_closure(obj_v) != 0 {
                let cl_dg = zjs_as_closure(obj_v);
                let fp2_dg = cl_dg.function;
                let ff2_dg: Function* = NULL;
                raw { ff2_dg = (Function*)fp2_dg; }
                if ff2_dg.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    ff2_dg.props = zjs_as_object(pv);
                }
                target_o = ff2_dg.props;
            } else if zjs_is_host_function(obj_v) != 0 {
                let hf_dg = zjs_as_host_function(obj_v);
                if hf_dg.props == NULL {
                    let pv = ctx_new_props_bag(ctx);
                    hf_dg.props = zjs_as_object(pv);
                }
                target_o = hf_dg.props;
            }
            if target_o != NULL {
                // Symbol → use its internal `key` string so the slot
                // matches subsequent `obj[Symbol.iterator]` reads. Other
                // non-string keys (`get [1+1]()`) ToString-coerce.
                key_v = symbol_key_coerce(key_v);
                if zjs_is_string(key_v) == 0 { key_v = zjs_to_string(ctx, key_v); }
            }
            if target_o != NULL && zjs_is_string(key_v) != 0 {
                let o = target_o;
                let key_s = zjs_as_string(key_v);
                let key_atom = ctx_intern_atom(ctx, key_s.data, key_s.length);
                let existing_slot = class_find_slot(o.cls, key_atom);
                let cur_get: ZjsValue = zjs_undefined();
                let cur_set: ZjsValue = zjs_undefined();
                if existing_slot >= 0 {
                    let cur_v = o.slots[(u32)existing_slot];
                    if zjs_is_accessor(cur_v) != 0 {
                        let acc = zjs_as_accessor(cur_v);
                        cur_get = acc.get;
                        cur_set = acc.set;
                    }
                }
                let is_getter = (op == Op::DefineGetter || op == Op::DefineMethodGetter);
                let new_get = if is_getter { fn_v } else { cur_get };
                let new_set = if is_getter { cur_set } else { fn_v };
                let acc = zjs_accessor_new(new_get, new_set);
                ctx_register_cell(ctx, (void*)acc);
                let av = zjs_cell_from_ptr((void*)acc);
                // Class accessors are non-enumerable; object-literal
                // accessors keep the default enumerable attrs.
                let is_method = (op == Op::DefineMethodGetter || op == Op::DefineMethodSetter);
                if is_method {
                    object_define_property_slot(ctx, o, key_atom, av,
                                                PROP_CONFIGURABLE);
                } else {
                    object_set(ctx, o, key_atom, av);
                }
            }
        } else if op == Op::MakeClosure {
            // a = dst, b = function-value reg, c = env-object reg
            let fn_val = regs[inst.b];
            let env_val = regs[inst.c];
            let fp: void* = zjs_cell_as_ptr(fn_val);
            let env_o: ZjsObject* = NULL;
            if zjs_is_object(env_val) != 0 {
                env_o = zjs_as_object(env_val);
            }
            let cl = zjs_closure_new(fp, env_o);
            // Snapshot the creation-time `this` so arrow bodies see
            // the enclosing scope's this instead of whatever callback
            // dispatcher set ctx.host_this to (Array.map, Promise.then
            // etc.). For arrows defined inside another arrow, the
            // chain unwinds via the parent closure's captured_this.
            let mc_f: Function* = NULL;
            raw { mc_f = (Function*)fp; }
            if mc_f.is_arrow {
                // If we're inside another arrow already, inherit its
                // captured_this; otherwise take the current frame's
                // host_this.
                if ctx.current_closure != NULL {
                    let outer_f: Function* = NULL;
                    raw { outer_f = (Function*)ctx->current_closure->function; }
                    if outer_f.is_arrow {
                        cl.captured_this = ctx.current_closure.captured_this;
                    } else {
                        cl.captured_this = ctx.host_this;
                    }
                } else {
                    cl.captured_this = ctx.host_this;
                }
            }
            ctx_register_cell(ctx, (void*)cl);
            regs[inst.a] = zjs_cell_from_ptr((void*)cl);
        } else if op == Op::LoadEnv {
            // a = dst. Read the env of the currently-executing closure
            // (or undefined if we're not inside one).
            if ctx.current_closure != NULL && ctx.current_closure.env != NULL {
                regs[inst.a] = zjs_cell_from_ptr((void*)ctx.current_closure.env);
            } else {
                regs[inst.a] = zjs_undefined();
            }
        } else if op == Op::LoadCallee {
            // a = dst. The function value currently invoking this
            // frame — a Closure if one was created, otherwise the
            // bare Function* cell. Used by named function expressions
            // to bind `name` inside their own body.
            if ctx.current_closure != NULL {
                regs[inst.a] = zjs_cell_from_ptr((void*)ctx.current_closure);
            } else if ctx.frames[cur_idx].f != NULL {
                regs[inst.a] = zjs_cell_from_ptr((void*)ctx.frames[cur_idx].f);
            } else {
                regs[inst.a] = zjs_undefined();
            }
        } else if op == Op::LoadProp {
            let dst = inst.a;
            let obj_reg = inst.b;
            let ic_slot = inst.c;
            let obj_val = regs[obj_reg];

            // ECMA-262 RequireObjectCoercible: property access on
            // undefined / null throws TypeError.
            if zjs_is_undefined(obj_val) != 0 || zjs_is_null(obj_val) != 0 {
                let ic_name: ZjsString* = f.ics[ic_slot].name;
                let buf: char[128];
                let n: int = 0;
                let ic_d = ic_name.data;
                let ic_l = ic_name.length;
                raw {
                    n = snprintf(&buf[0], 128, "Cannot read properties of %s (reading '%.*s')",
                                 zjs_is_undefined(obj_val) ? "undefined" : "null",
                                 (int)(ic_l > 64 ? 64 : ic_l), ic_d);
                }
                let bp: char* = NULL; raw { bp = &buf[0]; }
                let err = build_typed_error(ctx, (char*)"TypeError", 9, bp, (u32)n);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }

            let took_fast: bool = false;
            if zjs_is_object(obj_val) != 0 {
                let o = zjs_as_object(obj_val);
                let cls: ZjsHiddenClass* = o.cls;
                // Unrolled polymorphic probe (IC_POLY_SIZE = 4). The
                // most-frequently-seen shape sits at index 0.
                //
                // We do this entire dispatch inside a raw block to
                // bypass zen-c's auto-bounds-check on the constant
                // `[0]`/`[1]`/`[2]`/`[3]` indices — `sample` showed
                // _z_check_bounds at ~4% of richards body time, and
                // those checks are provably-safe constants against
                // a fixed-size IC_POLY_SIZE array.
                let hit_idx: i32 = -1;
                let ic_ptr: ICEntry* = NULL;
                let n: u32 = 0;
                raw {
                    ic_ptr = &f->ics[ic_slot];
                    n = (uint32_t)ic_ptr->entry_count;
                    if      (n > 0 && ic_ptr->classes[0] == cls) hit_idx = 0;
                    else if (n > 1 && ic_ptr->classes[1] == cls) hit_idx = 1;
                    else if (n > 2 && ic_ptr->classes[2] == cls) hit_idx = 2;
                    else if (n > 3 && ic_ptr->classes[3] == cls) hit_idx = 3;
                }
                if hit_idx >= 0 {
                    let idx = (u32)hit_idx;
                    // Slot index encodes "proto-chain hit" in the top
                    // bit. Own-slot hits use the low 31 bits directly
                    // and never touch the side proto-cls table — that
                    // keeps numerical own-slot loops (nbody) hot in L1.
                    let slot_raw: u32 = 0;
                    let is_proto: u32 = 0;
                    raw {
                        slot_raw = ic_ptr->slots[idx];
                        is_proto = (slot_raw & 0x80000000u) ? 1u : 0u;
                    }
                    if is_proto == 0 {
                        // Own-slot hit.
                        let raw_v = o.slots[slot_raw];
                        if zjs_is_accessor(raw_v) == 0 && zjs_is_deleted(raw_v) == 0 {
                            regs[dst] = raw_v;
                            took_fast = true;
                        }
                    } else if f.ic_proto_cls != NULL {
                        // Direct-proto hit. Validate the receiver hangs
                        // from a prototype with the cached shape — the
                        // cls check alone is insufficient because two
                        // constructors that install the same own
                        // properties produce instances sharing hidden
                        // classes but pointing to different prototypes.
                        let pc: ZjsHiddenClass* = f.ic_proto_cls[(u32)ic_slot * IC_POLY_SIZE + idx];
                        let p = o.proto;
                        if p != NULL && p.cls == pc {
                            let slot_n: u32 = 0;
                            raw { slot_n = slot_raw & 0x7fffffffu; }
                            let raw_v = p.slots[slot_n];
                            if zjs_is_accessor(raw_v) == 0 && zjs_is_deleted(raw_v) == 0 {
                                regs[dst] = raw_v;
                                took_fast = true;
                            }
                        }
                    }
                }
            }
            if !took_fast {
                let ic_name: ZjsString* = f.ics[ic_slot].name;
                let key_val = zjs_cell_from_ptr((void*)ic_name);
                regs[dst] = property_get(ctx, obj_val, key_val);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                // Patch the IC if obj is an object and the cache isn't
                // already megamorphic. Walk the proto chain (starting at
                // the receiver) to find where the property actually
                // lives; cache (receiver-cls, holder, holder-cls, slot)
                // so future hits can take the fast path even when the
                // property is on a prototype.
                if zjs_is_object(obj_val) != 0 && !f.ics[ic_slot].megamorphic {
                    let o = zjs_as_object(obj_val);
                    let recv_cls = o.cls;
                    // Try the receiver's OWN slot first; fall back to
                    // the direct prototype. Deeper proto chains aren't
                    // cached (the fast path's o.proto == src_obj check
                    // would reject them anyway) and route to the slow
                    // path every time.
                    let found_slot: i32 = -1;
                    let holder: ZjsObject* = NULL;
                    let s_own = class_find_slot(o.cls, ic_name);
                    if s_own >= 0 {
                        let pv = o.slots[(u32)s_own];
                        if zjs_is_accessor(pv) == 0 && zjs_is_deleted(pv) == 0 {
                            found_slot = s_own;
                            holder = o;
                        }
                    } else if o.proto != NULL {
                        let p = o.proto;
                        let s_p = class_find_slot(p.cls, ic_name);
                        if s_p >= 0 {
                            let pv = p.slots[(u32)s_p];
                            if zjs_is_accessor(pv) == 0 && zjs_is_deleted(pv) == 0 {
                                found_slot = s_p;
                                holder = p;
                            }
                        }
                    }
                    if found_slot >= 0 {
                        let already: bool = false;
                        let n2 = (u32)f.ics[ic_slot].entry_count;
                        let k2: u32 = 0;
                        while k2 < n2 {
                            if f.ics[ic_slot].classes[k2] == recv_cls { already = true; break; }
                            k2 = k2 + 1;
                        }
                        if !already {
                            if n2 < IC_POLY_SIZE {
                                f.ics[ic_slot].classes[n2] = recv_cls;
                                if holder == o {
                                    f.ics[ic_slot].slots[n2] = (u32)found_slot;
                                } else {
                                    // Proto-chain hit: tag the slot
                                    // index and lazily allocate the side
                                    // proto-cls table.
                                    let tagged: u32 = 0;
                                    raw { tagged = ((uint32_t)found_slot) | 0x80000000u; }
                                    f.ics[ic_slot].slots[n2] = tagged;
                                    if f.ic_proto_cls == NULL {
                                        let total: usize = (usize)(f.ic_count * IC_POLY_SIZE);
                                        f.ic_proto_cls = alloc_n<ZjsHiddenClass*>(total);
                                        let zi: usize = 0;
                                        while zi < total {
                                            f.ic_proto_cls[zi] = NULL;
                                            zi = zi + 1;
                                        }
                                    }
                                    f.ic_proto_cls[(u32)ic_slot * IC_POLY_SIZE + n2] = holder.cls;
                                }
                                f.ics[ic_slot].entry_count = (u8)(n2 + 1);
                            } else {
                                // Cache full and a new shape appeared —
                                // flip megamorphic. Don't bother evicting:
                                // a true poly site has stabilized within
                                // 4 shapes, and a churny site won't
                                // benefit from LRU either.
                                f.ics[ic_slot].megamorphic = true;
                            }
                        }
                    }
                }
            }
        } else if op == Op::StoreProp {
            let obj_reg = inst.a;
            let ic_slot = inst.b;
            let val_reg = inst.c;
            let obj_val = regs[obj_reg];
            let value   = regs[val_reg];

            let took_fast: bool = false;
            if zjs_is_object(obj_val) != 0 {
                let o = zjs_as_object(obj_val);
                let cls: ZjsHiddenClass* = o.cls;
                // Same raw-block dispatch as LoadProp — bypass zen-c
                // bounds checks on the constant [0..3] IC indices.
                let hit_slot: i32 = -1;
                let ic_ptr: ICEntry* = NULL;
                let n: u32 = 0;
                raw {
                    ic_ptr = &f->ics[ic_slot];
                    n = (uint32_t)ic_ptr->entry_count;
                    if      (n > 0 && ic_ptr->classes[0] == cls) hit_slot = (int32_t)ic_ptr->slots[0];
                    else if (n > 1 && ic_ptr->classes[1] == cls) hit_slot = (int32_t)ic_ptr->slots[1];
                    else if (n > 2 && ic_ptr->classes[2] == cls) hit_slot = (int32_t)ic_ptr->slots[2];
                    else if (n > 3 && ic_ptr->classes[3] == cls) hit_slot = (int32_t)ic_ptr->slots[3];
                }
                if hit_slot >= 0 {
                    let slot_n = (u32)hit_slot;
                    let raw_v = o.slots[slot_n];
                    if zjs_is_accessor(raw_v) == 0 && zjs_is_deleted(raw_v) == 0 {
                        o.slots[slot_n] = value;
                        // Generational write barrier: old object ← young value
                        // (see docs/gc-barrier-audit.md).
                        gc_write_barrier(ctx, (void*)o, value);
                        took_fast = true;
                    }
                }
            }
            if !took_fast {
                let ic_name: ZjsString* = f.ics[ic_slot].name;
                let key_val = zjs_cell_from_ptr((void*)ic_name);
                ctx.write_rejected = false;
                property_set(ctx, obj_val, key_val, value);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                // Strict mode: a write that the object silently rejected
                // (frozen / non-writable / non-extensible) is a TypeError.
                if f.strict && ctx.write_rejected {
                    let e = build_typed_error(ctx, (char*)"TypeError", 9,
                                              (char*)"Cannot assign to read only property", 35);
                    ctx.pending_throw_active = true; ctx.pending_throw_value = e;
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                if zjs_is_object(obj_val) != 0 && !f.ics[ic_slot].megamorphic {
                    let o = zjs_as_object(obj_val);
                    let s = class_find_slot(o.cls, ic_name);
                    // Only cache writable data slots: the fast path writes
                    // the slot directly without re-checking PROP_WRITABLE,
                    // so caching a non-writable slot would let later writes
                    // bypass the read-only guard.
                    if s >= 0 && (object_get_attrs(o, (u32)s) & PROP_WRITABLE) != 0 {
                        let already: bool = false;
                        let n2 = (u32)f.ics[ic_slot].entry_count;
                        let k2: u32 = 0;
                        while k2 < n2 {
                            if f.ics[ic_slot].classes[k2] == o.cls { already = true; break; }
                            k2 = k2 + 1;
                        }
                        if !already {
                            if n2 < IC_POLY_SIZE {
                                f.ics[ic_slot].classes[n2] = o.cls;
                                f.ics[ic_slot].slots[n2] = (u32)s;
                                f.ics[ic_slot].entry_count = (u8)(n2 + 1);
                            } else {
                                f.ics[ic_slot].megamorphic = true;
                            }
                        }
                    }
                }
            }
        } else if op == Op::MathSqrt || op == Op::MathAbs
               || op == Op::MathFloor || op == Op::MathCeil {
            // Specialized 1-arg Math.X(x). Compiler emits these when `Math`
            // statically resolves to the global object and the method name
            // matches. Skips LoadGlobal + LoadProp + the MethodInvoke
            // host-function dispatch — straight ToNumber + libm call.
            let v = regs[inst.b];
            let d: f64 = 0.0;
            if zjs_is_int32(v) != 0 {
                d = (f64)zjs_as_int32(v);
            } else if zjs_is_double(v) != 0 {
                d = zjs_as_double(v);
            } else {
                d = zjs_to_double(v);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
            let r: f64 = 0.0;
            if op == Op::MathSqrt {
                raw { r = sqrt(d); }
            } else if op == Op::MathAbs {
                raw { r = fabs(d); }
            } else if op == Op::MathFloor {
                raw { r = floor(d); }
            } else {
                raw { r = ceil(d); }
            }
            // Math.abs/floor/ceil of an int32 stays representable as int32
            // for non-negative results. Boxing as int32 keeps it on the
            // arithmetic fast path for subsequent ops; doubles would slow
            // down a downstream Add/Sub.
            if op != Op::MathSqrt && zjs_is_int32(v) != 0 {
                let i: i32 = (i32)r;
                if (f64)i == r {
                    regs[inst.a] = zjs_int32(i);
                } else {
                    regs[inst.a] = zjs_double(r);
                }
            } else {
                regs[inst.a] = zjs_double(r);
            }
        } else if op == Op::NewObject {
            regs[inst.a] = ctx_new_object(ctx);
        } else if op == Op::NewRegex {
            // a=dst, b=pattern_const_idx, c=flags_const_idx.
            // Fresh instance per execution so `g`/`y` lastIndex is
            // independent across `for (...) /pat/g.test(x)` iterations.
            let pat_v   = f.constants[(u32)inst.b];
            let flags_v = f.constants[(u32)inst.c];
            regs[inst.a] = ctx_new_regexp(ctx, pat_v, flags_v);
        } else if op == Op::NewRegexR {
            // a=dst, b=pat_reg, c=flag_reg. Slow path used when the
            // function's const pool grew past 255 entries and a u8
            // const-idx no longer fits — compiler stages the strings
            // into regs via LoadConst first.
            regs[inst.a] = ctx_new_regexp(ctx, regs[inst.b], regs[inst.c]);
        } else if op == Op::NewArray {
            let dst = inst.a;
            let base = inst.b;
            let count = (u32)inst.c;
            let arr_val = ctx_new_array(ctx, count);
            let arr = zjs_as_array(arr_val);
            let i: u32 = 0;
            while i < count {
                arr.elements[i] = regs[base + (u8)i];
                i = i + 1;
            }
            arr.length = count;
            regs[dst] = arr_val;
        } else if op == Op::LoadElem {
            // Type-guard fast path for `arr[i]` where `arr` is an array
            // and `i` is a small int. Skips the property_get function
            // call, the pending-throw check, and the hole-to-undefined
            // conversion in array_get. Sieve and tight indexed loops
            // sit here; the slow path catches strings, doubles, holes
            // (which fall back to coerce-to-undefined), and accessors.
            let obj_val = regs[inst.b];
            let key_val = regs[inst.c];
            let took_fast: bool = false;
            if zjs_is_array(obj_val) != 0 && zjs_is_int32(key_val) != 0 {
                let i = zjs_as_int32(key_val);
                if i >= 0 {
                    let arr = zjs_as_array(obj_val);
                    // Bail to property_get if the array carries an
                    // expando bag — defineProperty on a numeric key
                    // installs there with possibly an accessor that
                    // must fire. The check is a single NULL compare;
                    // the slow path handles the rare case.
                    if arr.props == NULL {
                        let u = (u32)i;
                        if u < arr.length {
                            // A sparse array can have length > cap (e.g.
                            // `a.length = 6` or a concat that left trailing
                            // holes). Those slots aren't backed by the
                            // elements buffer — reading them raw is an OOB.
                            // Treat in-range-but-past-cap as a hole.
                            if u >= arr.cap {
                                regs[inst.a] = zjs_undefined();
                                took_fast = true;
                            } else {
                            let v = arr.elements[u];
                            // Hole → undefined inline (avoid one extra
                            // branch in array_get).
                            if zjs_is_deleted(v) == 0 {
                                regs[inst.a] = v;
                            } else {
                                regs[inst.a] = zjs_undefined();
                            }
                            took_fast = true;
                            }
                        } else {
                            // Out-of-bounds read is `undefined` —
                            // common in defensive `i < arr.length`
                            // patterns where the compiler can't prove
                            // it. No prototype walk on pure int index
                            // path.
                            regs[inst.a] = zjs_undefined();
                            took_fast = true;
                        }
                    }
                }
            }
            if !took_fast {
                regs[inst.a] = property_get(ctx, obj_val, key_val);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
        } else if op == Op::StoreElem {
            // Mirror of LoadElem's fast path: dense indexed write with
            // no realloc. Three cases stay fast:
            //   (a) in-bounds: pure slot write, length unchanged
            //   (b) past length but within capacity: write + bump length
            //   (c) past capacity: fall through to array_set (realloc)
            // Case (b) relies on the invariant that slots in [length, cap)
            // are holes (zjs_deleted) — maintained by array_set's grow
            // path and by length-shrink in property_set.
            let obj_val = regs[inst.a];
            let key_val = regs[inst.b];
            let value   = regs[inst.c];
            let took_fast: bool = false;
            ctx.write_rejected = false;
            if zjs_is_array(obj_val) != 0 && zjs_is_int32(key_val) != 0
               && zjs_as_array(obj_val).props == NULL {
                // props == NULL guard: when the array carries any named /
                // defineProperty'd entries (incl. per-element-attr indices,
                // #343), fall through to property_set, which routes the
                // index through arr.props and honors writable / accessors.
                let i = zjs_as_int32(key_val);
                if i >= 0 {
                    let arr = zjs_as_array(obj_val);
                    if arr.frozen {
                        // Frozen array — sloppy-mode silent no-op; strict
                        // mode turns it into a TypeError (checked below).
                        ctx.write_rejected = true;
                        took_fast = true;
                    } else {
                        let u = (u32)i;
                        if u < arr.length {
                            arr.elements[u] = value;
                            // Generational write barrier: old array ← young value.
                            gc_write_barrier(ctx, (void*)arr, value);
                            took_fast = true;
                        } else if u < arr.cap {
                            arr.elements[u] = value;
                            arr.length = u + 1;
                            gc_write_barrier(ctx, (void*)arr, value);
                            took_fast = true;
                        }
                    }
                }
            }
            if !took_fast {
                property_set(ctx, obj_val, key_val, value);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
            if f.strict && ctx.write_rejected {
                let e = build_typed_error(ctx, (char*)"TypeError", 9,
                                          (char*)"Cannot assign to read only property", 35);
                ctx.pending_throw_active = true; ctx.pending_throw_value = e;
                throwing = true; thrown = consume_pending_throw(ctx);
                exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
            }
        } else if op == Op::InitObjData {
            // Object-literal data-property init (CreateDataPropertyOrThrow):
            // define an OWN enumerable/writable/configurable data property,
            // bypassing any inherited setter — notably the Object.prototype
            // `__proto__` accessor, which would otherwise mutate the
            // prototype instead of creating an own "__proto__" property for
            // `{ ['__proto__']: x }` / `{ __proto__ }` (shorthand). a=obj,
            // b=key, c=value.
            let obj_val = regs[inst.a];
            let key_val = regs[inst.b];
            let value   = regs[inst.c];
            if zjs_is_object(obj_val) != 0 {
                let o = zjs_as_object(obj_val);
                key_val = symbol_key_coerce(key_val);
                if zjs_is_string(key_val) == 0 { key_val = zjs_to_string(ctx, key_val); }
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
                let ks = zjs_as_string(key_val);
                // Static object-literal keys are interned once at compile
                // time (emit_load_name_string), so the loaded string already
                // IS the canonical atom — skip the per-construction
                // hash+memcmp re-intern. Only a non-interned key (a computed
                // key whose ToString produced a fresh string) needs the
                // atom-table lookup. Mirrors the object_set fast path.
                let katom: ZjsString* = ks;
                if !ks.interned { katom = ctx_intern_atom(ctx, ks.data, ks.length); }
                object_define_property_slot(ctx, o, katom, value, PROP_DEFAULT);
            } else {
                // Non-object receiver shouldn't occur for object literals;
                // fall back to ordinary set for safety.
                property_set(ctx, obj_val, key_val, value);
                if ctx.pending_throw_active {
                    throwing = true; thrown = consume_pending_throw(ctx);
                    exit_reason = 3; ctx.frames[cur_idx].ip = ip; break;
                }
            }
        } else if op == Op::LoadThis {
            // Spec: in a derived-class constructor `this` is in the
            // TDZ until super() runs. Reading it before then is a
            // ReferenceError.
            if f.is_class_constructor
               && f.parent_ctor.bits != zjs_undefined().bits
               && !ctx.frames[cur_idx].super_called {
                let err = build_typed_error(ctx, (char*)"ReferenceError", 14,
                                            (char*)"Must call super constructor before using 'this' in derived constructor", 70);
                throwing = true; thrown = err; exit_reason = 3;
                ctx.frames[cur_idx].ip = ip; break;
            }
            // Arrow functions inherit `this` lexically — read the
            // creation-time snapshot stashed in the closure. Without
            // this branch, every `arr.map(x => this.foo)` sees
            // map's host_this (typically the array) instead of the
            // enclosing scope.
            if f.is_arrow && ctx.current_closure != NULL {
                regs[inst.a] = ctx.current_closure.captured_this;
            } else {
                regs[inst.a] = ctx.host_this;
            }
        } else if op == Op::LoadNewTarget {
            if ctx.new_target_active {
                regs[inst.a] = ctx.new_target_value;
            } else {
                regs[inst.a] = zjs_undefined();
            }
        } else if op == Op::In {
            // key in obj — ECMA-262 §13.10.1: obj must be an Object,
            // else throw TypeError. Our "Object" notion includes plain
            // objects, arrays, functions, host functions, closures.
            let key = regs[inst.b];
            let obj = regs[inst.c];
            // Symbol keys: route through the same coercion property_get
            // uses (Symbol → its internal `key` string). Without this,
            // the zjs_to_string(symbol) below would throw per spec and
            // leave key_str_val as undefined; the subsequent
            // zjs_as_string(undef) would read random memory and SIGSEGV.
            // (#291 — surfaced by lodash-es's `Symbol.toStringTag in
            // Object(value)` runtime check.)
            key = symbol_key_coerce(key);
            let obj_like: bool =
                zjs_is_object(obj) != 0
                || zjs_is_array(obj) != 0
                || zjs_is_function(obj) != 0
                || zjs_is_closure(obj) != 0
                || zjs_is_host_function(obj) != 0;
            if !obj_like {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Cannot use 'in' on a non-object", 31);
                throwing = true; thrown = err; exit_reason = 3; break;
            }
            let present: int = 0;
            if zjs_is_array(obj) != 0 {
                let a = zjs_as_array(obj);
                let idx = zjs_to_array_index(key);
                if idx >= 0 {
                    // Holes are not "in" the array per spec. A
                    // defineProperty'd index lives in arr.props, not the
                    // dense store — check it when the dense slot is absent.
                    if (u32)idx < a.length && array_has_index(a, (u32)idx) != 0 {
                        present = 1;
                    } else if a.props != NULL {
                        let buf: char[16]; let blen: int = 0;
                        raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)(uint32_t)idx); }
                        let bp: char* = NULL; raw { bp = &buf[0]; }
                        let katom = ctx_intern_atom(ctx, bp, (u32)blen);
                        let sp = class_find_slot(a.props.cls, katom);
                        if sp >= 0 && zjs_is_deleted(a.props.slots[(u32)sp]) == 0 { present = 1; }
                    }
                } else if zjs_is_string(key) != 0 {
                    // Falls back through length / array_proto.
                    let pv = property_get(ctx, obj, key);
                    if zjs_is_undefined(pv) == 0 { present = 1; }
                }
            } else if zjs_is_object(obj) != 0 {
                let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name = zjs_as_string(key_str_val);
                let cur = zjs_as_object(obj);
                while cur != NULL {
                    let sl = class_find_slot(cur.cls, name);
                    // A DELETED own slot is not present at this level — keep
                    // walking the prototype chain (an inherited prop counts).
                    if sl >= 0 && zjs_is_deleted(cur.slots[(u32)sl]) == 0 { present = 1; cur = NULL; }
                    else { cur = cur.proto; }
                }
            } else if zjs_is_host_function(obj) != 0 {
                // Host function: probe .props.
                let hf = zjs_as_host_function(obj);
                if hf.props != NULL {
                    let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                    let name = zjs_as_string(key_str_val);
                    let sl = class_find_slot(hf.props.cls, name);
                    if sl >= 0 && zjs_is_deleted(hf.props.slots[(u32)sl]) == 0 { present = 1; }
                }
            } else if zjs_is_function(obj) != 0 {
                // Function: probe .props (Function.prototype always
                // exists, but "prototype" in fn returns true only if
                // the user touched it — mirror what V8/JSC do for an
                // unobserved-prototype function: report `true` for the
                // well-known own-slots and the props bag).
                let fp = zjs_cell_as_ptr(obj);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.props != NULL {
                    let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                    let name = zjs_as_string(key_str_val);
                    let sl = class_find_slot(f.props.cls, name);
                    if sl >= 0 && zjs_is_deleted(f.props.slots[(u32)sl]) == 0 { present = 1; }
                }
            }
            // Closure: probe per-instance props first, then the
            // underlying Function*.props (class statics).
            if present == 0 && zjs_is_closure(obj) != 0 {
                let cl_in = zjs_as_closure(obj);
                let key_str_val = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
                let name_in = zjs_as_string(key_str_val);
                if cl_in.props != NULL {
                    let sl = class_find_slot(cl_in.props.cls, name_in);
                    if sl >= 0 && zjs_is_deleted(cl_in.props.slots[(u32)sl]) == 0 { present = 1; }
                }
                if present == 0 {
                    let fp_in = cl_in.function;
                    let f_in: Function* = NULL;
                    raw { f_in = (Function*)fp_in; }
