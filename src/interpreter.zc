            cur = cur.proto;
        }
        return zjs_undefined();
    }
    if tag == TAG_SYMBOL && ctx.symbol_proto != NULL {
        if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
        let name = zjs_as_string(key);
        let kd = name.data;
        let kn = name.length;
        // .description exposes the original description string.
        let is_desc: int = 0;
        raw { is_desc = (kn == 11 && memcmp(kd, "description", 11) == 0) ? 1 : 0; }
        if is_desc != 0 {
