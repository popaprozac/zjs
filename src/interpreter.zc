                    let proto_v = ctx_new_object(ctx);
                    f.prototype = zjs_as_object(proto_v);
                    // Spec: F.prototype.constructor === F (writable +
                    // configurable, NOT enumerable).
                    object_define_property_slot(ctx, f.prototype,
                        ctx_intern_atom(ctx, (char*)"constructor", 11),
                        obj, PROP_WRITABLE | PROP_CONFIGURABLE);
                }
                return zjs_cell_from_ptr((void*)f.prototype);
