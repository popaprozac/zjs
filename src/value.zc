// NaN-boxed value representation (JSC layout).
//
// 64-bit immediate values packed into one struct field. The struct
// layout MUST match the typedef in include/zjs.h byte-for-byte — it's
// part of the public C ABI.

import "std/mem.zc"
//
// Layout summary (see docs/phases/phase-2-1-value-representation.md
// for the bit-level reference):
//
//   int32          NumberTag | (uint32_t)i
//   double         u64_bits(d) + DoubleEncodeOffset
//   cell (ptr)     low 48 bits, high 16 zero
//   null           0x...0002
//   undefined      0x...000a
//   false          0x...0006
//   true           0x...0007

struct ZjsValue {
    bits: u64;
}

// ZjsValue is a pure value type. Opt into Copy so it flows freely
// across the C ABI (and across opcode handlers later) without tripping
// move semantics.
impl Copy for ZjsValue {}

// --- NaN-box constants -----------------------------------------------
//
// Zen-c's `int` is 32-bit (per docs §2 "Primitive Types"), so a literal
// like `0xfffe000000000000` is parsed as int32 and silently truncates
// before any `: u64` annotation on the `def` takes effect. We construct
// the wide constants via shift-from-small-value so every intermediate
// fits comfortably in 32 bits and the `(u64)` cast widens *before* the
// shift.

def NUMBER_TAG: u64           = (u64)0xfffe << 48;
def OTHER_TAG: u64            = 2;
def BOOL_TAG: u64             = 4;
def UNDEFINED_TAG: u64        = 8;
def NOT_CELL_MASK: u64        = ((u64)0xfffe << 48) | (u64)2;
def DOUBLE_ENCODE_OFFSET: u64 = (u64)1 << 49;

def VALUE_NULL: u64           = 2;   // OTHER_TAG
def VALUE_UNDEFINED: u64      = 10;  // OTHER_TAG | UNDEFINED_TAG (2 | 8)
def VALUE_FALSE: u64          = 6;   // OTHER_TAG | BOOL_TAG     (2 | 4)
def VALUE_TRUE: u64           = 7;   // OTHER_TAG | BOOL_TAG | 1 (2 | 4 | 1)
// Sentinel for "this slot was deleted" — distinguishable from
// undefined/null/bool. Same OTHER_TAG bit but uses bit 16 (above the
// boolean payload bits) as the marker. Stored in object slots after
// `delete obj.prop`; class_find_slot returns -1 when it lands on one.
def VALUE_DELETED: u64        = 0x10002;   // OTHER_TAG | (1 << 16)

// --- Bit-reinterpret between f64 and u64 -----------------------------
//
// Zen-c has no language-level type-pun intrinsic; `(u64)d` would be a
// value-preserving cast (truncation/rounding), not a bit reinterpret.
// memcpy is the standard portable type-pun in C and the right tool
// here. This is the legitimate raw{} case.

fn double_to_bits(d: f64) -> u64 {
    let bits: u64 = 0;
    raw {
        // Inside raw{}, Zen-c type names aren't visible — use C types.
        libc_memcpy(&bits, &d, sizeof(double));
    }
    return bits;
}

fn bits_to_double(b: u64) -> f64 {
    let d: f64 = 0.0;
    raw {
        libc_memcpy(&d, &b, sizeof(double));
    }
    return d;
}

// Bridge the `libc::memcpy` symbol into the raw-block scope above.
// (Inside `raw {}` we can't name Zen-c imports; we resolve it through
// a tiny wrapper that the C compiler will inline.)
raw {
    #include <string.h>
    static inline void libc_memcpy(void* dst, const void* src, unsigned long n) {
        memcpy(dst, src, n);
    }
    // Forward-declare the WebSocket platform shim so finalizer code
    // in value.zc can tear down lingering native handles. Full
    // declarations live in src/platform/ws_native.h (mirrored as
    // raw externs in context.zc).
    typedef struct ZjsWsHandle ZjsWsHandle;
    void zjs_ws_destroy(ZjsWsHandle* h);
}

// --- Constructors -----------------------------------------------------

fn zjs_int32(i: i32) -> ZjsValue {
    // Sign-extend then mask to 32 bits before OR-ing with NumberTag.
    // `(u32)i` is well-defined modulo 2^32; cast widens to u64 with
    // zero extension.
    return ZjsValue{ bits: NUMBER_TAG | (u64)(u32)i };
}

fn zjs_double(d: f64) -> ZjsValue {
    return ZjsValue{ bits: double_to_bits(d) + DOUBLE_ENCODE_OFFSET };
}

fn zjs_bool(b: int) -> ZjsValue {
    if b != 0 {
        return ZjsValue{ bits: VALUE_TRUE };
    }
    return ZjsValue{ bits: VALUE_FALSE };
}

fn zjs_null() -> ZjsValue {
    return ZjsValue{ bits: VALUE_NULL };
}

fn zjs_undefined() -> ZjsValue {
    return ZjsValue{ bits: VALUE_UNDEFINED };
}

fn zjs_deleted() -> ZjsValue {
    return ZjsValue{ bits: VALUE_DELETED };
}

fn zjs_is_deleted(v: ZjsValue) -> int {
    if v.bits == VALUE_DELETED { return 1; }
    return 0;
}

// --- Type predicates --------------------------------------------------

fn zjs_is_int32(v: ZjsValue) -> int {
    if (v.bits & NUMBER_TAG) == NUMBER_TAG { return 1; }
    return 0;
}

fn zjs_is_number(v: ZjsValue) -> int {
    if (v.bits & NUMBER_TAG) != 0 { return 1; }
    return 0;
}

fn zjs_is_double(v: ZjsValue) -> int {
    // Number AND NOT int32. Equivalent to: the high 16 bits are in
    // 0x0002…0xfffd inclusive, but we route through the cheaper
    // two-test form so the compiler keeps NUMBER_TAG in a register.
    if zjs_is_number(v) == 0 { return 0; }
    if zjs_is_int32(v) != 0  { return 0; }
    return 1;
}

fn zjs_is_bool(v: ZjsValue) -> int {
    // ValueFalse = 0x6, ValueTrue = 0x7 — clearing the low bit yields 0x6
    // for both. One mask, one compare.
    if (v.bits & ~(u64)1) == VALUE_FALSE { return 1; }
    return 0;
}

fn zjs_is_null(v: ZjsValue) -> int {
    if v.bits == VALUE_NULL { return 1; }
    return 0;
}

fn zjs_is_undefined(v: ZjsValue) -> int {
    if v.bits == VALUE_UNDEFINED { return 1; }
    return 0;
}

fn zjs_is_cell(v: ZjsValue) -> int {
    // Pointers have high 16 = 0 and the OTHER_TAG bit clear. The
    // ValueEmpty sentinel (0) would technically pass this test, but
    // the engine never hands out an Empty to consumers.
    if (v.bits & NOT_CELL_MASK) == 0 { return 1; }
    return 0;
}

// --- Unboxers — UB if the matching predicate is false ----------------

fn zjs_as_int32(v: ZjsValue) -> i32 {
    return (i32)(u32)v.bits;
}

fn zjs_as_double(v: ZjsValue) -> f64 {
    return bits_to_double(v.bits - DOUBLE_ENCODE_OFFSET);
}

fn zjs_as_bool(v: ZjsValue) -> int {
    // Low bit of ValueFalse/ValueTrue is the boolean payload.
    return (int)(v.bits & 1);
}

// =====================================================================
// Arithmetic + ToBoolean helpers. Used by the interpreter (Phase 3+).
// Number ops follow ECMA-262 semantics: int32 fast path with promotion
// to double on overflow; doubles propagate. Non-number operands map to
// NaN (with the exception of bool, which we treat as 0/1 numerically).
// =====================================================================

raw {
    #include <math.h>
    #include <stdint.h>
    #include <limits.h>
    #include <stdlib.h>
}

fn zjs_to_double(v: ZjsValue) -> f64 {
    if zjs_is_int32(v) != 0     { return (f64)zjs_as_int32(v); }
    if zjs_is_double(v) != 0    { return zjs_as_double(v); }
    if zjs_is_bool(v) != 0      { return (f64)zjs_as_bool(v); }
    if zjs_is_null(v) != 0      { return 0.0; }
    if zjs_is_undefined(v) != 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return nan;
    }
    if zjs_is_string(v) != 0 {
        // String → number via strtod, skipping whitespace. Empty / all-
        // whitespace strings coerce to 0 per ECMA-262, not NaN.
        //
        // strtod also accepts case-insensitive "inf" / "infinity" /
        // "nan" forms — but the spec's StringNumericLiteral grammar
        // only accepts exactly "Infinity" (optionally signed). If
        // strtod produced infinity, verify the consumed substring
        // matches the spec form; if not, return NaN.
        let s = zjs_as_string(v);
        let sd = s.data;
        let sn = s.length;
        let parsed: f64 = 0.0;
        let ok: int = 0;
        raw {
            const char* p = sd;
            const char* end = sd + sn;
            while (p < end && (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' || *p == '\v' || *p == '\f')) p++;
            if (p == end) { parsed = 0.0; ok = 1; }
            else {
                char* ep = NULL;
                parsed = strtod(p, &ep);
                // Skip trailing whitespace.
                while (ep < end && (*ep == ' ' || *ep == '\t' || *ep == '\n' || *ep == '\r' || *ep == '\v' || *ep == '\f')) ep++;
                ok = (ep == end && ep != p) ? 1 : 0;
                if (ok && isinf(parsed)) {
                    // The consumed substring is [p, last_non_ws). The
                    // accepted spec forms are "Infinity", "+Infinity",
                    // "-Infinity" — case-sensitive, no surrounding chars.
                    const char* q = p;
                    if (q < end && (*q == '+' || *q == '-')) q++;
                    if (!(end - q >= 8 &&
                          q[0] == 'I' && q[1] == 'n' && q[2] == 'f' &&
                          q[3] == 'i' && q[4] == 'n' && q[5] == 'i' &&
                          q[6] == 't' && q[7] == 'y' &&
                          (q + 8 == end || (q[8] == ' ' || q[8] == '\t' || q[8] == '\n' ||
                                            q[8] == '\r' || q[8] == '\v' || q[8] == '\f')))) {
                        ok = 0;
                    }
                }
            }
        }
        if ok != 0 { return parsed; }
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return nan;
    }
    let nan: f64 = 0.0;
    raw { nan = (double)NAN; }
    return nan;
}

// ECMA-262 ToBoolean.
fn zjs_to_bool_coerce(v: ZjsValue) -> int {
    if zjs_is_bool(v) != 0      { return zjs_as_bool(v); }
    if zjs_is_int32(v) != 0     { if zjs_as_int32(v) != 0 { return 1; } return 0; }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        let is_nan: int = 0;
        raw { is_nan = isnan(d) ? 1 : 0; }
        if is_nan != 0 { return 0; }
        if d != 0.0 { return 1; }
        return 0;
    }
    if zjs_is_null(v) != 0      { return 0; }
    if zjs_is_undefined(v) != 0 { return 0; }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        if s.length > 0 { return 1; }
        return 0;
    }
    // ToBoolean(BigInt): 0n is false, every other BigInt is true.
    if zjs_is_bigint(v) != 0 {
        if bigint_is_zero(zjs_as_bigint(v)) { return 0; }
        return 1;
    }
    if zjs_is_cell(v) != 0      { return 1; }   // non-string objects are truthy
    return 0;
}

// Inline-convert a known-number ZjsValue to f64. Caller MUST have
// proved zjs_is_number(v) != 0 — skips the function-call overhead and
// branch cascade of zjs_to_double for non-Symbol arithmetic.
fn number_to_double(v: ZjsValue) -> f64 {
    if zjs_is_int32(v) != 0 { return (f64)zjs_as_int32(v); }
    return zjs_as_double(v);
}

fn zjs_arith_add(a: ZjsValue, b: ZjsValue) -> ZjsValue {
    if zjs_is_int32(a) != 0 && zjs_is_int32(b) != 0 {
        let ai: i64 = (i64)zjs_as_int32(a);
        let bi: i64 = (i64)zjs_as_int32(b);
        let sum: i64 = ai + bi;
        let fits: int = 0;
        raw { fits = (sum >= INT32_MIN && sum <= INT32_MAX) ? 1 : 0; }
        if fits != 0 { return zjs_int32((i32)sum); }
        return zjs_double((f64)sum);
    }
    // Number+number fast path covers int+double, double+int, double+double
    // without the zjs_to_double dispatch. nbody/mandelbrot/int_loop_big-
    // overflow paths all live here.
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        return zjs_double(number_to_double(a) + number_to_double(b));
    }
    return zjs_double(zjs_to_double(a) + zjs_to_double(b));
}

fn zjs_arith_sub(a: ZjsValue, b: ZjsValue) -> ZjsValue {
    if zjs_is_int32(a) != 0 && zjs_is_int32(b) != 0 {
        let ai: i64 = (i64)zjs_as_int32(a);
        let bi: i64 = (i64)zjs_as_int32(b);
        let diff: i64 = ai - bi;
        let fits: int = 0;
        raw { fits = (diff >= INT32_MIN && diff <= INT32_MAX) ? 1 : 0; }
        if fits != 0 { return zjs_int32((i32)diff); }
        return zjs_double((f64)diff);
    }
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        return zjs_double(number_to_double(a) - number_to_double(b));
    }
    return zjs_double(zjs_to_double(a) - zjs_to_double(b));
}

fn zjs_arith_mul(a: ZjsValue, b: ZjsValue) -> ZjsValue {
    if zjs_is_int32(a) != 0 && zjs_is_int32(b) != 0 {
        let ai: i64 = (i64)zjs_as_int32(a);
        let bi: i64 = (i64)zjs_as_int32(b);
        let prod: i64 = ai * bi;
        let fits: int = 0;
        raw { fits = (prod >= INT32_MIN && prod <= INT32_MAX) ? 1 : 0; }
        if fits != 0 { return zjs_int32((i32)prod); }
        return zjs_double((f64)prod);
    }
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        return zjs_double(number_to_double(a) * number_to_double(b));
    }
    return zjs_double(zjs_to_double(a) * zjs_to_double(b));
}

fn zjs_arith_div(a: ZjsValue, b: ZjsValue) -> ZjsValue {
    // JS division always yields a double — never int32 (e.g. 5/2 = 2.5).
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        return zjs_double(number_to_double(a) / number_to_double(b));
    }
    return zjs_double(zjs_to_double(a) / zjs_to_double(b));
}

fn zjs_arith_mod(a: ZjsValue, b: ZjsValue) -> ZjsValue {
    // ECMA-262 % uses fmod semantics: result takes the sign of the
    // dividend. C's integer `%` matches when both operands are int32
    // and the divisor is non-zero (INT_MIN % -1 is UB in C, so route
    // that through fmod too).
    if zjs_is_int32(a) != 0 && zjs_is_int32(b) != 0 {
        let ai = zjs_as_int32(a);
        let bi = zjs_as_int32(b);
        let safe: int = 0;
        raw { safe = (bi != 0 && !(ai == INT32_MIN && bi == -1)) ? 1 : 0; }
        if safe != 0 {
            let r = ai % bi;
            // JS %: -0 if dividend is negative and result is 0.
            if r == 0 && ai < 0 { return zjs_double(-0.0); }
            return zjs_int32(r);
        }
    }
    let af = zjs_to_double(a);
    let bf = zjs_to_double(b);
    let r: f64 = 0.0;
    raw { r = fmod(af, bf); }
    return zjs_double(r);
}

fn zjs_arith_pow(a: ZjsValue, b: ZjsValue) -> ZjsValue {
    let af = zjs_to_double(a);
    let bf = zjs_to_double(b);
    let r: f64 = 0.0;
    raw { r = pow(af, bf); }
    return zjs_double(r);
}

fn zjs_arith_neg(a: ZjsValue) -> ZjsValue {
    if zjs_is_int32(a) != 0 {
        let i = zjs_as_int32(a);
        // ECMA-262: -0 is observable. int32 can't represent -0, so
        // negating 0 must produce double(-0).
        if i == 0 { return zjs_double(-0.0); }
        let is_min: int = 0;
        raw { is_min = (i == INT32_MIN) ? 1 : 0; }
        if is_min == 0 { return zjs_int32(-i); }
        return zjs_double(-(f64)i);
    }
    return zjs_double(-zjs_to_double(a));
}

// ECMA-262 §7.1.6 ToInt32 / §7.1.7 ToUint32. The naive C cast from
// double to int32 saturates on values past INT_MAX — uuid's parse()
// does `parseInt("c8a3ad77d818", 16) >>> 24` and expects mod-2^32
// truncation, but a cast-based path gave back 0x7FFFFFFF (saturated)
// instead of 0xad. Implement the spec's "floor toward zero, modulo
// 2^32, fold into the signed range" steps directly so >>> / | / &
// against parseInt() results behave per spec.
fn zjs_to_int32(v: ZjsValue) -> i32 {
    if zjs_is_int32(v) != 0 { return zjs_as_int32(v); }
    let d = zjs_to_double(v);
    let r: i32 = 0;
    raw {
        /* Fast path: for finite d in (-2^63, 2^63), double→int64
         * truncates toward zero (matches spec's floor-toward-zero) and
         * casting that to int32_t takes the low 32 bits (matches the
         * spec's mod-2^32 + signed-fold). NaN compares false against
         * the bound so it falls through to the slow path; same for
         * ±Inf. Eliminates fabs/floor/fmod from the inner loop of any
         * workload doing `seed & MASK` or `x | 0`. */
        if (d > -9.2233720368547758e18 && d < 9.2233720368547758e18) {
            r = (int32_t)(int64_t)d;
        } else if (isnan(d) || isinf(d) || d == 0.0) {
            r = 0;
        } else {
            double sign = d < 0 ? -1.0 : 1.0;
            double absd = fabs(d);
            double posInt = sign * floor(absd);
            double m = fmod(posInt, 4294967296.0);
            if (m < 0) m += 4294967296.0;
            /* Fold [0, 2^32) into [-2^31, 2^31). */
            if (m >= 2147483648.0) m -= 4294967296.0;
            r = (int32_t)m;
        }
    }
    return r;
}

fn zjs_to_uint32(v: ZjsValue) -> u32 {
    if zjs_is_int32(v) != 0 { return (u32)zjs_as_int32(v); }
    let d = zjs_to_double(v);
    let r: u32 = 0;
    raw {
        /* Same fast path as zjs_to_int32 — the low-32 bits of the
         * int64 truncation are what spec ToUint32 demands. */
        if (d > -9.2233720368547758e18 && d < 9.2233720368547758e18) {
            r = (uint32_t)(int64_t)d;
        } else if (isnan(d) || isinf(d) || d == 0.0) {
            r = 0;
        } else {
            double sign = d < 0 ? -1.0 : 1.0;
            double absd = fabs(d);
            double posInt = sign * floor(absd);
            double m = fmod(posInt, 4294967296.0);
            if (m < 0) m += 4294967296.0;
            r = (uint32_t)m;
        }
    }
    return r;
}

fn zjs_bit_and(a: ZjsValue, b: ZjsValue) -> ZjsValue { return zjs_int32(zjs_to_int32(a) & zjs_to_int32(b)); }
fn zjs_bit_or (a: ZjsValue, b: ZjsValue) -> ZjsValue { return zjs_int32(zjs_to_int32(a) | zjs_to_int32(b)); }
fn zjs_bit_xor(a: ZjsValue, b: ZjsValue) -> ZjsValue { return zjs_int32(zjs_to_int32(a) ^ zjs_to_int32(b)); }
fn zjs_bit_not(a: ZjsValue) -> ZjsValue { return zjs_int32(~zjs_to_int32(a)); }

fn zjs_shl (a: ZjsValue, b: ZjsValue) -> ZjsValue { return zjs_int32(zjs_to_int32(a) << (zjs_to_uint32(b) & 31)); }
fn zjs_shr (a: ZjsValue, b: ZjsValue) -> ZjsValue { return zjs_int32(zjs_to_int32(a) >> (zjs_to_uint32(b) & 31)); }
fn zjs_ushr(a: ZjsValue, b: ZjsValue) -> ZjsValue {
    // Spec: result of `>>>` is a uint32 value, returned as a Number.
    // When the high bit is set (≥ 2^31) the int32 encoding would
    // surface as negative on display and on subsequent loose
    // comparisons, so promote to a double in that case.
    let u: u32 = zjs_to_uint32(a) >> (zjs_to_uint32(b) & 31);
    if u >= 0x80000000 { return zjs_double((f64)u); }
    return zjs_int32((i32)u);
}

// Strict equality — same type + same value (NaN != NaN).
fn zjs_strict_eq(a: ZjsValue, b: ZjsValue) -> int {
    if zjs_is_int32(a) != 0 && zjs_is_int32(b) != 0 {
        if zjs_as_int32(a) == zjs_as_int32(b) { return 1; }
        return 0;
    }
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        let af = zjs_to_double(a);
        let bf = zjs_to_double(b);
        if af == bf { return 1; }   // NaN != NaN by IEEE, correct
        return 0;
    }
    if zjs_is_string(a) != 0 && zjs_is_string(b) != 0 {
        return zjs_string_equals(zjs_as_string(a), zjs_as_string(b));
    }
    // BigInt === BigInt: value compare (distinct cells, so the bit
    // fallback below would wrongly say unequal). BigInt === non-BigInt
    // is always false (different type) — handled by the bits fallback.
    if zjs_is_bigint(a) != 0 && zjs_is_bigint(b) != 0 {
        return if bigint_cmp(zjs_as_bigint(a), zjs_as_bigint(b)) == 0 { 1 } else { 0 };
    }
    // Different categories — equal only if bit-equal AND not a NaN double.
    if a.bits == b.bits { return 1; }
    return 0;
}

// SameValueZero (ECMA-262 §7.2.11) — used by Map / Set key comparison
// and Array.prototype.includes. Differs from strict equality only in
// that NaN matches NaN. (SameValue also differentiates +0 / -0; we
// don't need that variant yet.)
fn zjs_same_value_zero(a: ZjsValue, b: ZjsValue) -> int {
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        let af = zjs_to_double(a);
        let bf = zjs_to_double(b);
        // NaN === NaN under SameValueZero. IEEE comparison says false;
        // detect via self-inequality.
        if af != af && bf != bf { return 1; }
        if af == bf { return 1; }
        return 0;
    }
    return zjs_strict_eq(a, b);
}

fn zjs_loose_eq(a: ZjsValue, b: ZjsValue) -> int {
    // Hot fast path: both numeric (int32 or double). For loose-eq
    // between numbers there's no coercion needed — same-type just
    // means strict equality. Loop counters / property values that
    // hit this path skip the full type-classification dance below.
    // Profile of richards showed zjs_loose_eq at ~6% of body time
    // pre-optimization; this fast path dominates real-world `==`.
    let a_int = zjs_is_int32(a);
    let b_int = zjs_is_int32(b);
    if a_int != 0 && b_int != 0 {
        return if zjs_as_int32(a) == zjs_as_int32(b) { 1 } else { 0 };
    }
    let a_dbl = zjs_is_double(a);
    let b_dbl = zjs_is_double(b);
    if (a_int != 0 || a_dbl != 0) && (b_int != 0 || b_dbl != 0) {
        let af = zjs_to_double(a);
        let bf = zjs_to_double(b);
        return if af == bf { 1 } else { 0 };  // NaN != NaN — correct
    }
    // ECMA-262 §7.2.13 IsLooselyEqual. The bracket sequence here mirrors
    // the spec steps: same-type strict-eq, null-undefined, cross-type
    // numeric/string coercion, boolean→number on either side, primitive
    // ↔ object via ToPrimitive (object-to-primitive coercion is the
    // remaining gap — we treat object operands as not-equal for now;
    // covered separately when we add ToPrimitive in this path).

    // Same-type: defer to strict.
    let a_num = (zjs_is_int32(a) != 0 || zjs_is_double(a) != 0);
    let b_num = (zjs_is_int32(b) != 0 || zjs_is_double(b) != 0);
    let a_str = zjs_is_string(a) != 0;
    let b_str = zjs_is_string(b) != 0;
    let a_bool = zjs_is_bool(a) != 0;
    let b_bool = zjs_is_bool(b) != 0;

    // BigInt loose-equality (ECMA-262 §7.2.13). BigInt==BigInt value
    // compare; BigInt==Number exact math compare; BigInt==String parses
    // the string (invalid → not equal). BigInt==Boolean falls through to
    // the bool→number recursion below, then re-enters as BigInt==Number.
    let a_big = zjs_is_bigint(a) != 0;
    let b_big = zjs_is_bigint(b) != 0;
    if a_big && b_big {
        return if bigint_cmp(zjs_as_bigint(a), zjs_as_bigint(b)) == 0 { 1 } else { 0 };
    }
    if a_big && b_num {
        let c = bigint_cmp_f64(zjs_as_bigint(a), zjs_to_double(b));
        return if c == 0 { 1 } else { 0 };
    }
    if b_big && a_num {
        let c = bigint_cmp_f64(zjs_as_bigint(b), zjs_to_double(a));
        return if c == 0 { 1 } else { 0 };
    }
    if a_big && b_str {
        let sb = zjs_as_string(b);
        let ok: int = 1;
        let tmp = zjs_bigint_from_string(sb.data, sb.length, &ok);
        let res: int = if ok != 0 { if bigint_cmp(zjs_as_bigint(a), tmp) == 0 { 1 } else { 0 } } else { 0 };
        bigint_free_void((void*)tmp);
        return res;
    }
    if b_big && a_str {
        let sa = zjs_as_string(a);
        let ok: int = 1;
        let tmp = zjs_bigint_from_string(sa.data, sa.length, &ok);
        let res: int = if ok != 0 { if bigint_cmp(zjs_as_bigint(b), tmp) == 0 { 1 } else { 0 } } else { 0 };
        bigint_free_void((void*)tmp);
        return res;
    }

    if a_num && b_num { return zjs_strict_eq(a, b); }
    if a_str && b_str { return zjs_strict_eq(a, b); }
    if a_bool && b_bool { return zjs_strict_eq(a, b); }
    if zjs_is_undefined(a) != 0 && zjs_is_undefined(b) != 0 { return 1; }
    if zjs_is_null(a) != 0 && zjs_is_null(b) != 0 { return 1; }

    // null == undefined.
    if zjs_is_null(a) != 0 && zjs_is_undefined(b) != 0 { return 1; }
    if zjs_is_undefined(a) != 0 && zjs_is_null(b) != 0 { return 1; }

    // Number ↔ String: convert string to number, retry.
    if a_num && b_str { return zjs_strict_eq(a, zjs_double(zjs_to_double(b))); }
    if a_str && b_num { return zjs_strict_eq(zjs_double(zjs_to_double(a)), b); }

    // Boolean on either side: convert boolean to number, retry.
    if a_bool {
        let an = if zjs_as_bool(a) != 0 { zjs_int32(1) } else { zjs_int32(0) };
        return zjs_loose_eq(an, b);
    }
    if b_bool {
        let bn = if zjs_as_bool(b) != 0 { zjs_int32(1) } else { zjs_int32(0) };
        return zjs_loose_eq(a, bn);
    }

    // Object ↔ primitive: ToPrimitive(object) and retry. Only fires
    // when ONE side is an object and the other is a number / string /
    // boolean. Calling zjs_to_primitive on a non-object returns the
    // value unchanged so a tail-recursive call would loop — gate
    // carefully.
    let a_obj = zjs_is_object(a) != 0 || zjs_is_array(a) != 0;
    let b_obj = zjs_is_object(b) != 0 || zjs_is_array(b) != 0;
    if a_obj && (b_num || b_str) {
        let coerced = zjs_to_primitive_for_eq(a);
        // Guard against infinite recursion: only recurse if we
        // actually got a primitive. Plain objects (no wrapper hidden
        // key) come back unchanged — fall through to strict-eq, which
        // returns false (object != primitive).
        if zjs_is_object(coerced) == 0 && zjs_is_array(coerced) == 0 {
            return zjs_loose_eq(coerced, b);
        }
        return 0;
    }
    if b_obj && (a_num || a_str) {
        let coerced = zjs_to_primitive_for_eq(b);
        if zjs_is_object(coerced) == 0 && zjs_is_array(coerced) == 0 {
            return zjs_loose_eq(a, coerced);
        }
        return 0;
    }
    return zjs_strict_eq(a, b);
}

// Lightweight ToPrimitive used by loose-eq. Real ToPrimitive lives
// in interpreter.zc (it has ctx access for invoking valueOf/toString
// hooks). Here we can only handle the wrapper objects — Number /
// Boolean / String wrappers carry their primitive at the
// `__zjs_primitive__` hidden key. For plain objects we return them
// unchanged; the caller will fall through to strict-eq → false.
fn zjs_to_primitive_for_eq(v: ZjsValue) -> ZjsValue {
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        // Walk the hidden-class transition chain looking for the
        // wrapper's hidden key. Each non-root class records one
        // transition (a name added going parent->this). If we find
        // it, we know the corresponding slot index.
        let cur: ZjsHiddenClass* = o.cls;
        while cur != NULL {
            let n = cur.transition_name;
            if n != NULL && n.length == WRAPPER_VALUE_KEY_LEN {
                let nd = n.data;
                let eq: int = 0;
                raw { eq = (memcmp(nd, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN) == 0) ? 1 : 0; }
                if eq != 0 { return o.slots[cur.transition_slot]; }
            }
            cur = cur.parent;
        }
    }
    return v;
}

// ECMA-262 §7.2.14 Abstract Relational Comparison. If both operands
// are strings, lexicographic UTF-16 (we use byte order — close enough
// for ASCII tests; full Unicode collation is deferred). Otherwise
// numeric comparison via ToNumber.
// Relational compare for operands where at least one is a BigInt.
// Returns -1/0/1 for a<,=,>b, or -2 when incomparable (NaN / unparseable
// string). Used by both zjs_cmp_lt and zjs_cmp_le.
fn bigint_relational(a: ZjsValue, b: ZjsValue) -> int {
    let ab = zjs_is_bigint(a) != 0;
    let bb = zjs_is_bigint(b) != 0;
    if ab && bb { return bigint_cmp(zjs_as_bigint(a), zjs_as_bigint(b)); }
    if ab {
        if zjs_is_string(b) != 0 {
            let sb = zjs_as_string(b);
            let ok: int = 1;
            let tmp = zjs_bigint_from_string(sb.data, sb.length, &ok);
            let r: int = if ok != 0 { bigint_cmp(zjs_as_bigint(a), tmp) } else { -2 };
            bigint_free_void((void*)tmp);
            return r;
        }
        return bigint_cmp_f64(zjs_as_bigint(a), zjs_to_double(b));
    }
    // b is BigInt, a is not — flip the comparison.
    if zjs_is_string(a) != 0 {
        let sa = zjs_as_string(a);
        let ok: int = 1;
        let tmp = zjs_bigint_from_string(sa.data, sa.length, &ok);
        let r: int = if ok != 0 { -bigint_cmp(zjs_as_bigint(b), tmp) } else { -2 };
        bigint_free_void((void*)tmp);
        return r;
    }
    let c = bigint_cmp_f64(zjs_as_bigint(b), zjs_to_double(a));
    if c == -2 { return -2; }
    return -c;
}

fn zjs_cmp_lt(a: ZjsValue, b: ZjsValue) -> int {
    if zjs_is_bigint(a) != 0 || zjs_is_bigint(b) != 0 {
        let c = bigint_relational(a, b);
        return if c == -1 { 1 } else { 0 };
    }
    if zjs_is_string(a) != 0 && zjs_is_string(b) != 0 {
        let sa = zjs_as_string(a);
        let sb = zjs_as_string(b);
        let n = if sa.length < sb.length { sa.length } else { sb.length };
        let sa_d = sa.data;
        let sb_d = sb.data;
        let cmp: int = 0;
        raw { cmp = memcmp(sa_d, sb_d, n); }
        if cmp < 0 { return 1; }
        if cmp > 0 { return 0; }
        // Equal prefixes — shorter string is less.
        if sa.length < sb.length { return 1; }
        return 0;
    }
    let af = zjs_to_double(a);
    let bf = zjs_to_double(b);
    let is_nan: int = 0;
    raw { is_nan = (isnan(af) || isnan(bf)) ? 1 : 0; }
    if is_nan != 0 { return 0; }
    if af < bf { return 1; }
    return 0;
}

fn zjs_cmp_le(a: ZjsValue, b: ZjsValue) -> int {
    if zjs_is_bigint(a) != 0 || zjs_is_bigint(b) != 0 {
        let c = bigint_relational(a, b);
        return if c == -1 || c == 0 { 1 } else { 0 };
    }
    if zjs_is_string(a) != 0 && zjs_is_string(b) != 0 {
        let sa = zjs_as_string(a);
        let sb = zjs_as_string(b);
        let n = if sa.length < sb.length { sa.length } else { sb.length };
        let sa_d = sa.data;
        let sb_d = sb.data;
        let cmp: int = 0;
        raw { cmp = memcmp(sa_d, sb_d, n); }
        if cmp < 0 { return 1; }
        if cmp > 0 { return 0; }
        if sa.length <= sb.length { return 1; }
        return 0;
    }
    let af = zjs_to_double(a);
    let bf = zjs_to_double(b);
    let is_nan: int = 0;
    raw { is_nan = (isnan(af) || isnan(bf)) ? 1 : 0; }
    if is_nan != 0 { return 0; }
    if af <= bf { return 1; }
    return 0;
}

// =====================================================================
// Heap cells — every heap-allocated value starts with a CellHeader.
// The NaN-box "cell" predicate (is_cell) checks the bit pattern; the
// header's type_tag then distinguishes Function / String / (later)
// Object / Array.
// =====================================================================

def TAG_FUNCTION:      u8 = 0;
def TAG_STRING:        u8 = 1;
def TAG_OBJECT:        u8 = 2;
def TAG_ARRAY:         u8 = 3;
def TAG_HOST_FUNCTION: u8 = 4;
def TAG_HIDDEN_CLASS:  u8 = 5;
def TAG_CLOSURE:       u8 = 6;
def TAG_ACCESSOR:      u8 = 7;   // Phase 3.9b: { get, set } pair stored in an object slot
def TAG_PROMISE:       u8 = 8;   // Phase 3.10: ECMA-262 Promise
def TAG_REGEXP:        u8 = 9;   // Phase 3.11: ECMA-262 RegExp (delegated to Zen-c std/regex)
def TAG_ASYNC_CONT:    u8 = 10;  // 2026-05-15: suspended async-function frame
                                 //   (saved regs + ip + outer Promise; resumed
                                 //   from a microtask when the awaited
                                 //   Promise settles).
def TAG_GENERATOR:     u8 = 11;  // 2026-05-15: generator iterator. Wraps a
                                 //   suspended frame the same way as
                                 //   TAG_ASYNC_CONT but resumed
                                 //   synchronously via .next() / .return()
                                 //   / .throw() rather than from a
                                 //   microtask.
def TAG_MAP:           u8 = 12;  // 2026-05-16: ECMA-262 Map. Linear
                                 //   insertion-ordered entries with
                                 //   tombstone-on-delete; SameValueZero
                                 //   keys. Iterators view live entries.
def TAG_SET:           u8 = 13;  // 2026-05-16: ECMA-262 Set. Same shape as
                                 //   ZjsMap minus the value slot.
def TAG_DATE:          u8 = 14;  // 2026-05-16: ECMA-262 Date. Internal slot
                                 //   is a single f64 ms-since-epoch (NaN for
                                 //   "invalid date").
def TAG_ARRAY_ITER:    u8 = 16;  // 2026-05-16: pristine-Array iterator
                                 //   fast path. Skips the generic
                                 //   @@iterator/next host-call cycle when
                                 //   for-of sees an Array (or String) with
                                 //   the standard prototype iterator.
def TAG_UINT8_ARRAY:   u8 = 17;  // 2026-05-18: WHATWG TypedArray foundation.
                                 //   Byte buffer (u8*) + length. Indexed
                                 //   access (read/write) clamps to 0..255.
                                 //   Other widths (Int8/Uint16/...) layer
                                 //   on this representation when added.
def TAG_TYPED_ARRAY:   u8 = 18;  // 2026-05-18: all non-Uint8 typed arrays —
                                 //   Int8 / Uint8Clamped / Int16 / Uint16 /
                                 //   Int32 / Uint32 / Float32 / Float64.
                                 //   View over a ZjsArrayBuffer with a
                                 //   `kind` byte selecting the element
                                 //   representation.
def TAG_ARRAY_BUFFER:  u8 = 19;  // 2026-05-18: WHATWG ArrayBuffer — owns
                                 //   the bytes; typed arrays + DataView
                                 //   are views over an ArrayBuffer.
def TAG_DATA_VIEW:     u8 = 20;  // 2026-05-18: WHATWG DataView — un-typed
                                 //   view onto an ArrayBuffer with per-call
                                 //   get/set methods (little/big endian).
def TAG_STRING_ROPE:   u8 = 22;  // 2026-05-19: lazy string concatenation —
                                 //   pairs two strings (or sub-ropes)
                                 //   with a cached `flat` ZjsString*
                                 //   that gets populated on first flatten.
                                 //   zjs_as_string transparently flattens
                                 //   so existing callers don't change.

def TAG_PROXY:         u8 = 23;  // 2026-05-20: ECMA-262 Proxy. Wraps a
                                 //   target object + handler. Property ops
                                 //   (property_get / _set / _has / _delete)
                                 //   detour through the handler's trap when
                                 //   present, otherwise forward to target.

def TAG_WEBSOCKET:     u8 = 21;  // 2026-05-18: WHATWG WebSocket. Wraps an
                                 //   opaque platform handle and four event
                                 //   handler slots.

// TypedArray element kinds. Used by ZjsTypedArray.kind to discriminate
// at load/store time. Kept separate from TAG_TYPED_ARRAY so the tag
// alone fits in CellHeader's u8 type_tag.
def TA_INT8:          u8 = 0;
def TA_UINT8:         u8 = 1;
def TA_UINT8_CLAMPED: u8 = 2;
def TA_INT16:         u8 = 3;
def TA_UINT16:        u8 = 4;
def TA_INT32:         u8 = 5;
def TA_UINT32:        u8 = 6;
def TA_FLOAT32:       u8 = 7;
def TA_FLOAT64:       u8 = 8;

fn ta_element_size(kind: u8) -> u8 {
    if kind == TA_INT8 || kind == TA_UINT8 || kind == TA_UINT8_CLAMPED { return 1; }
    if kind == TA_INT16 || kind == TA_UINT16 { return 2; }
    if kind == TA_INT32 || kind == TA_UINT32 || kind == TA_FLOAT32 { return 4; }
    if kind == TA_FLOAT64 { return 8; }
    return 1;
}
def TAG_SYMBOL:        u8 = 15;  // 2026-05-16: ECMA-262 Symbol. Each Symbol
                                 //   carries a description (for toString) and a
                                 //   unique underlying property-key string used
                                 //   internally when the symbol is used to
                                 //   key an object property.
def TAG_BIGINT:        u8 = 24;  // 2026-05-30: ECMA-262 BigInt. Arbitrary-
                                 //   precision integer, sign-magnitude with a
                                 //   little-endian base-2^32 limb array. See
                                 //   ZjsBigInt + the bigint_* helpers below.
def TAG_TEMPORAL:      u8 = 25;  // 2026-05-30: Temporal types. One cell type
                                 //   with a `kind` discriminator (TMP_*) for
                                 //   Duration / PlainDate / PlainTime /
                                 //   PlainDateTime / PlainYearMonth /
                                 //   PlainMonthDay / Instant / ZonedDateTime.

// Temporal cell kinds (ZjsTemporal.kind).
def TMP_DURATION:       u8 = 0;
def TMP_PLAIN_DATE:     u8 = 1;
def TMP_PLAIN_TIME:     u8 = 2;
def TMP_PLAIN_DATETIME: u8 = 3;
def TMP_PLAIN_YEARMONTH:u8 = 4;
def TMP_PLAIN_MONTHDAY: u8 = 5;
def TMP_INSTANT:        u8 = 6;
def TMP_ZONED_DATETIME: u8 = 7;

// Promise states.
def PROMISE_PENDING:   u8 = 0;
def PROMISE_FULFILLED: u8 = 1;
def PROMISE_REJECTED:  u8 = 2;

struct CellHeader {
    type_tag: u8;
    mark:     u8;       // GC mark bit; 0 = white (unreachable), 1 = grey/black (reachable)
    age:      u8;       // 0 = young (nursery), 1 = old (promoted). Set to 1 by
                        // ctx_register_cell_old at promotion time. The write
                        // barrier (gc_write_barrier) checks age==1 to decide
                        // whether a store needs a remembered-set entry.
    _pad:     u8;       // explicit padding so the header stays a clean 4 bytes
                        // and existing memcpy-of-cells (none today, but possible
                        // for stop-and-copy nursery later) stays predictable.
}

struct ZjsString {
    header: CellHeader;
    length: u32;
    interned: bool;    // true once inserted into the atom table — lets hot
                       // paths (object_set) skip a redundant re-intern.
    data:   char*;     // null-terminated, owned (freed in string_free_void)
}

// Hidden class — the transition-tree shape model from the design
// study (Phase 1 Decision 6). Every object holds a HiddenClass*; two
// objects with the same property-add sequence share the same class.
//
// Self-referential through parent and trans_children — Zen-c handles
// struct self-references for pointer-typed fields, so this works
// without a separate forward declaration.
struct ZjsHiddenClass {
    header:          CellHeader;         // { type_tag = TAG_HIDDEN_CLASS }
    parent:          ZjsHiddenClass*;    // NULL for the root empty class
    transition_name: ZjsString*;         // atom added going parent->this; NULL for root
    transition_slot: u32;                // slot index for transition_name; 0 for root
    prop_count:      u32;                // = parent.prop_count + 1 (or 0 for root)

    // Outgoing transition edges. Parallel arrays for cache locality
    // on the name-search hot path. trans_count <= trans_cap; both
    // start at 0/0 (no allocation until first transition).
    trans_names:     ZjsString**;
    trans_children:  ZjsHiddenClass**;
    trans_count:     u32;
    trans_cap:       u32;
}

struct ZjsObject {
    header:   CellHeader;       // { type_tag = TAG_OBJECT }
    cls:      ZjsHiddenClass*;
    slots:    ZjsValue*;         // heap-allocated, sized to slot_cap >= cls.prop_count
    // Per-slot property attribute byte (writable / enumerable /
    // configurable bits — see PROP_* constants). Parallel to `slots`,
    // same capacity. NULL until the first property is added (matches
    // `slots`'s lazy allocation). Stored off-shape because attributes
    // can differ per object while sharing a hidden class — a
    // defineProperty with enumerable=false should not fragment the
    // shape graph for objects that otherwise have the same keys.
    attrs:    u8*;
    slot_cap: u32;
    // Prototype object (Phase 3.6). NULL = no proto / top of chain.
    // Property lookups that miss the own-property table walk obj.proto
    // recursively. Set by `new`, Object.create, or Object.setPrototypeOf.
    proto:    ZjsObject*;
    // Object.freeze / template-object mutability gate. When set,
    // property writes silently no-op in sloppy mode (would throw
    // TypeError in strict — not yet wired through the assignment ops).
    frozen:   bool;
    // Object.preventExtensions / seal / freeze all clear this.
    // When false, object_set's add-new-slot path rejects (existing
    // writable slots can still be mutated unless `frozen` is also set
    // OR the per-slot PROP_WRITABLE bit is cleared by `freeze`).
    // Note: default state is "extensible = true". To avoid having to
    // touch every allocator (ctx_new_object, host paths, etc.), the
    // field name encodes the FALSE state: `non_extensible: bool` so
    // zalloc'd zero-init = extensible.
    non_extensible: bool;
}

// Property attribute bits — fit in one byte per slot. Default for
// plain assignment (`o.x = 1`) is PROP_DEFAULT (all three on); the
// ECMA-262 defineProperty defaults are stricter — see
// host_object_define_property.
def PROP_WRITABLE:     u8 = 0x01;
def PROP_ENUMERABLE:   u8 = 0x02;
def PROP_CONFIGURABLE: u8 = 0x04;
def PROP_DEFAULT:      u8 = 0x07;

struct ZjsArray {
    header:   CellHeader;       // { type_tag = TAG_ARRAY }
    elements: ZjsValue*;         // heap-allocated, owned; holes = undefined
    length:   u32;
    cap:      u32;
    // Lazy expando bag — `[].foo = 1` lands here so Object.keys / for-in
    // / Object.create's property descriptors find named keys alongside
    // the integer-indexed entries. NULL until the first non-index store.
    props:    ZjsObject*;
    // Per-instance [[Prototype]] — non-NULL when the array was
    // constructed via `class Sub extends Array {}` (or via
    // Reflect.construct with a non-Array newTarget). Lookups walk
    // this chain first; NULL falls back to ctx.realm.array_proto.
    proto:    ZjsObject*;
    // Object.freeze / template-object mutability gate. When set, any
    // property assignment / indexed write is silently dropped in
    // sloppy mode (would throw TypeError in strict — not yet wired).
    frozen:   bool;
    // Object.preventExtensions / seal / freeze on an array sets this.
    // When set, array_set rejects growth beyond the current `length`
    // and named-prop additions to `arr.props`. Existing in-range
    // writable slots remain mutable unless `frozen` is also set.
    non_extensible: bool;
    // `length` property's [[Writable]] flag. ECMA-262 makes Array
    // `length` writable by default; defineProperty(arr,"length",
    // {writable:false}) and Object.freeze clear it. When set, `arr.length
    // = n` is rejected and ArraySetLength via defineProperty throws when
    // it would change the value. Tracked here since `length` is not a
    // real slot. (#343)
    length_non_writable: bool;
}

// Host (C) function exposed to JavaScript code. The fn_ptr is opaque
// to Zen-c — it's cast back to a function pointer of the canonical
// signature inside the interpreter's raw{} block.
struct ZjsHostFunction {
    header: CellHeader;     // { type_tag = TAG_HOST_FUNCTION }
    fn_ptr: void*;          // ZjsValue (*)(ZjsContext*, ZjsValue*, uint32_t)
    name:   char*;          // for debugging — duplicated, owned
    // Phase 3.10 — per-instance binding. Used by Promise resolve/reject
    // closures to remember which promise they target. Read inside the
    // host fn body via ctx.current_host_fn.bound. Default undefined.
    bound:  ZjsValue;
    // Phase 3.6: `.prototype` for instanceof + constructor-style use.
    // Lazy — first read auto-creates an empty object.
    prototype: ZjsObject*;
    // Phase 3.8c: arbitrary properties (e.g. `Array.isArray`). Lazy.
    // property_get/set on a host function falls through to this object.
    props:     ZjsObject*;
    // Spec-mandated `.length` (formal-parameter count). Defaults to 0
    // for the no-explicit-arity registrations; callers can update via
    // hf->arity = N. Read by property_get when the user asks for
    // host_fn.length.
    arity:     u32;
    // 2026-05-15 — explicit [[Prototype]] override. NULL means default
    // to ctx.realm.function_proto. Used for the error-subclass constructors
    // (EvalError, TypeError, ...) whose [[Prototype]] is Error itself,
    // matching the spec's `class EvalError extends Error`.
    proto_override: ZjsValue;
    // 2026-05-16 — IsConstructor for built-ins. Default true (matches
    // legacy behavior for constructors like Array, Number, ...).
    // Prototype methods and other non-constructable built-ins flip
    // this to false; Op::NewInvoke / Op::SpreadNewInvoke / Reflect.construct
    // / etc throw TypeError when constructed.
    is_constructor: bool;
    // [[Realm]] — the realm this builtin was installed in. The call
    // boundary switches ctx.realm to this for the duration of the C body
    // so e.g. `realmB.Array(...)` builds with realmB's %Array.prototype%
    // and errors use realmB's constructors. NULL ⇒ don't switch (caller's
    // realm stands). Weak ref into ctx.realms (not GC-marked).
    realm:  ZjsRealm*;
}

// Closure: a function template paired with a captured environment.
// `env` is a plain ZjsObject whose properties are the captured locals.
// Multiple closures from the same outer call share the same env object,
// preserving JS reference semantics for captured variables.
// Accessor property cell — stored as the slot value when a property
// was installed via `Object.defineProperty(o, k, {get, set})`. The
// fast IC slot read detects this tag and falls through to the slow
// path which invokes get/set with `this = receiver_obj`.
struct ZjsAccessor {
    header: CellHeader;          // { type_tag = TAG_ACCESSOR }
    get:    ZjsValue;            // callable or undefined
    set:    ZjsValue;            // callable or undefined
}

fn zjs_is_accessor(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_ACCESSOR { return 1; }
    return 0;
}

fn zjs_as_accessor(v: ZjsValue) -> ZjsAccessor* {
    let p = zjs_cell_as_ptr(v);
    let a: ZjsAccessor* = NULL;
    raw { a = (ZjsAccessor*)p; }
    return a;
}

fn zjs_accessor_new(get_v: ZjsValue, set_v: ZjsValue) -> ZjsAccessor* {
    let a = alloc<ZjsAccessor>();
    a.header.type_tag = TAG_ACCESSOR;
    a.get = get_v;
    a.set = set_v;
    return a;
}

fn accessor_free_void(p: void*) -> void {
    let a: ZjsAccessor* = NULL;
    raw { a = (ZjsAccessor*)p; }
    dealloc(a);
}

// Phase 3.10 — Promise. State machine with attached reactions.
// Each reaction is 3 contiguous slots: on_fulfilled, on_rejected,
// result_promise. On settlement, every reaction enqueues a microtask
// to be drained at the next safe point.
struct ZjsPromise {
    header:        CellHeader;       // { type_tag = TAG_PROMISE }
    state:         u8;               // PROMISE_PENDING / FULFILLED / REJECTED
    value:         ZjsValue;         // resolution value or rejection reason
    reactions:     ZjsValue*;        // 3-tuples: [onFulfilled, onRejected, resultPromise]
    reaction_count: u32;
    reaction_cap:  u32;
    // Per-instance [[Prototype]] — non-NULL when constructed via
    // `class Sub extends Promise {}`. NULL falls back to
    // ctx.realm.promise_ctor_proto.
    proto:         ZjsObject*;
    // Own-property expando bag (lazy). Promises are ordinary objects that can
    // hold own props (`p.foo = 1`, or an overridden `p.then = fn` — which
    // Promise combinators must observe per spec). NULL until first write.
    props:         ZjsObject*;
}

fn zjs_is_promise(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_PROMISE { return 1; }
    return 0;
}

fn zjs_as_promise(v: ZjsValue) -> ZjsPromise* {
    let p = zjs_cell_as_ptr(v);
    let pr: ZjsPromise* = NULL;
    raw { pr = (ZjsPromise*)p; }
    return pr;
}

// Suspended async-function frame. Created at Op::Await when the
// awaited Promise is pending; resumed when it settles, via a host
// function whose .bound points back at the continuation.
//
// `saved_regs` is a heap-allocated copy of the function's register
// window — the actual reg_stack slots are released when the frame
// pops at suspension time, so we have to own a stable copy. On
// resume, the contents are copied back into a freshly-pushed frame.
struct ZjsAsyncCont {
    header:                 CellHeader;     // { type_tag = TAG_ASYNC_CONT }
    function:               Function*;      // the bytecode to resume
    saved_regs:             ZjsValue*;      // owned, length = reg_count
    reg_count:              u32;
    saved_ip:               usize;          // instruction right after Op::Await
    await_dst:              u8;             // dst reg for the resolved value
    saved_host_this:        ZjsValue;
    saved_current_closure:  ZjsClosure*;
    outer_promise:          ZjsValue;       // Promise to settle on resumed-frame return
    // Try-frame snapshot. When Op::Await suspends inside a `try`, the
    // frame's active catch handlers (ctx_try_stack entries above the
    // frame's try_depth_at_entry) would be lost when the call frame is
    // popped. Save catch_ip/catch_reg here and re-push them on resume so
    // a rejected await unwinds into the body's try/catch. owned arrays.
    saved_try_ip:           usize*;
    saved_try_reg:          u8*;
    saved_try_count:        u32;
}

fn zjs_is_async_cont(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_ASYNC_CONT { return 1; }
    return 0;
}

fn zjs_as_async_cont(v: ZjsValue) -> ZjsAsyncCont* {
    let p = zjs_cell_as_ptr(v);
    let r: ZjsAsyncCont* = NULL;
    raw { r = (ZjsAsyncCont*)p; }
    return r;
}

fn zjs_async_cont_new() -> ZjsAsyncCont* {
    let c = alloc<ZjsAsyncCont>();
    c.header.type_tag = TAG_ASYNC_CONT;
    c.function = NULL;
    c.saved_regs = NULL;
    c.reg_count = 0;
    c.saved_ip = 0;
    c.await_dst = 0;
    c.saved_host_this = zjs_undefined();
    c.saved_current_closure = NULL;
    c.outer_promise = zjs_undefined();
    c.saved_try_ip = NULL;
    c.saved_try_reg = NULL;
    c.saved_try_count = 0;
    return c;
}

// Generator iterator. State machine:
//   GEN_INITIAL   — created but never run; .next() starts the body
//   GEN_YIELDED   — paused at a `yield`; .next() resumes with the arg
//                   value written into resume_dst
//   GEN_RUNNING   — body is currently executing (re-entrant .next()
//                   while running is a TypeError per spec)
//   GEN_COMPLETED — body returned; .next() returns
//                   { value: undefined, done: true } forever after
def GEN_INITIAL:   u8 = 0;
def GEN_YIELDED:   u8 = 1;
def GEN_RUNNING:   u8 = 2;
def GEN_COMPLETED: u8 = 3;
// Async generator awaiting a pending Promise. State entered when
// Op::Await suspends in an async-gen frame; resume happens when the
// awaited Promise settles (via host_async_gen_resume_*).
def GEN_AWAITING:  u8 = 4;
// Transient state used during the initial bytecode-Invoke of a
// generator function: the prologue is running, Op::GeneratorStart will
// fire at its end to capture state + unwind. Distinguished from
// GEN_RUNNING so the GeneratorStart handler can tell "initial call"
// from "subsequent .next() resume that's running past the prologue".
def GEN_STARTING:  u8 = 4;

struct ZjsGenerator {
    header:                 CellHeader;     // type_tag = TAG_GENERATOR
    function:               Function*;      // generator body
    saved_regs:             ZjsValue*;      // heap-owned reg snapshot
    reg_count:              u32;
    saved_ip:               usize;          // resume point (right after Op::Yield)
    resume_dst:             u8;             // reg that receives .next(arg)'s arg
    saved_host_this:        ZjsValue;
    saved_current_closure:  ZjsClosure*;
    state:                  u8;
    // Cached object instance returned by iter[Symbol.iterator]() — most
    // tests just call iter.next() on the iterator itself, so this stays
    // NULL until something asks for the iterable view.
    self_iter_obj:          ZjsObject*;
    // True when this generator came from `async function*` — .next()
    // wraps the iter-result in Promise.resolve(...) before returning,
    // matching async-iterator semantics. Set by the Op::Invoke is-gen
    // branch when target.is_async is true.
    is_async:               bool;
    // Async-gen await suspension: the Promise that the current .next()
    // call returned. When the awaited Promise settles, the resume path
    // either runs more body and settles this with the next iter-result,
    // or the body awaits again and leaves this pending.
    pending_next_promise:   ZjsValue;
}

fn zjs_is_generator(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_GENERATOR { return 1; }
    return 0;
}

fn zjs_as_generator(v: ZjsValue) -> ZjsGenerator* {
    let p = zjs_cell_as_ptr(v);
    let g: ZjsGenerator* = NULL;
    raw { g = (ZjsGenerator*)p; }
    return g;
}

fn zjs_generator_new() -> ZjsGenerator* {
    let g = alloc<ZjsGenerator>();
    g.header.type_tag = TAG_GENERATOR;
    g.function = NULL;
    g.saved_regs = NULL;
    g.reg_count = 0;
    g.saved_ip = 0;
    g.resume_dst = 0;
    g.saved_host_this = zjs_undefined();
    g.saved_current_closure = NULL;
    g.state = GEN_INITIAL;
    g.self_iter_obj = NULL;
    g.pending_next_promise = zjs_undefined();
    return g;
}

// =====================================================================
// Map / Set (2026-05-16). Spec semantics:
//   * Iteration order = insertion order.
//   * Keys compared via SameValueZero (NaN equals NaN; +0 equals -0).
//   * `delete` tombstones rather than shifting so live iterators keep
//     their cursor stable; `size` tracks live entries.
// =====================================================================

struct ZjsMapEntry {
    key:     ZjsValue;
    value:   ZjsValue;
    deleted: bool;          // tombstone — skipped by iterators / .size
}

struct ZjsMap {
    header:  CellHeader;    // type_tag = TAG_MAP
    entries: ZjsMapEntry*;
    count:   u32;           // entries.len (incl. tombstones)
    cap:     u32;
    size:    u32;           // live (non-tombstone) entry count
    // Lazy expando bag — for own properties set via assignment or
    // defineProperty. Matches Array's pattern. NULL until first set.
    props:   ZjsObject*;
    // Per-instance [[Prototype]] — non-NULL when constructed via
    // `class Sub extends Map {}`. NULL falls back to ctx.realm.map_proto.
    proto:   ZjsObject*;
    // WeakMap instances reuse the ZjsMap cell but carry [[WeakMapData]],
    // not [[MapData]] — so the strong Map.prototype iteration methods
    // (forEach/keys/values/entries/clear/size) must reject them. (Weak GC
    // semantics are still a follow-up; entries are held strongly.)
    is_weak: bool;
}

fn zjs_is_map(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_MAP { return 1; }
    return 0;
}

fn zjs_as_map(v: ZjsValue) -> ZjsMap* {
    let p = zjs_cell_as_ptr(v);
    let m: ZjsMap* = NULL;
    raw { m = (ZjsMap*)p; }
    return m;
}

fn zjs_map_new() -> ZjsMap* {
    let m = alloc<ZjsMap>();
    m.header.type_tag = TAG_MAP;
    m.entries = NULL;
    m.count = 0;
    m.cap = 0;
    m.size = 0;
    m.props = NULL;
    m.proto = NULL;
    return m;
}

struct ZjsSetEntry {
    value:   ZjsValue;
    deleted: bool;
}

struct ZjsSet {
    header:  CellHeader;    // type_tag = TAG_SET
    entries: ZjsSetEntry*;
    count:   u32;
    cap:     u32;
    size:    u32;
    // Lazy expando bag — same as Map's. NULL until first own prop set.
    props:   ZjsObject*;
    // Per-instance [[Prototype]] — non-NULL when constructed via
    // `class Sub extends Set {}`. NULL falls back to ctx.realm.set_proto.
    proto:   ZjsObject*;
    // WeakSet instances carry [[WeakSetData]] — strong Set.prototype
    // iteration methods reject them. See ZjsMap.is_weak.
    is_weak: bool;
}

fn zjs_is_set(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_SET { return 1; }
    return 0;
}

fn zjs_as_set(v: ZjsValue) -> ZjsSet* {
    let p = zjs_cell_as_ptr(v);
    let s: ZjsSet* = NULL;
    raw { s = (ZjsSet*)p; }
    return s;
}

fn zjs_set_new() -> ZjsSet* {
    let s = alloc<ZjsSet>();
    s.header.type_tag = TAG_SET;
    s.entries = NULL;
    s.count = 0;
    s.cap = 0;
    s.size = 0;
    s.props = NULL;
    s.proto = NULL;
    return s;
}

// =====================================================================
// Date (2026-05-16). One internal slot: time_ms (UTC milliseconds since
// 1970-01-01). NaN means "Invalid Date" — propagated through all
// getters / formatters.
// =====================================================================

struct ZjsDate {
    header:  CellHeader;        // type_tag = TAG_DATE
    time_ms: f64;
    // Lazy expando bag for own properties (\`d.foo = 1\`, defineProperty).
    props:   ZjsObject*;
    // Per-instance [[Prototype]] — set when constructed via
    // `class Sub extends Date {}`. NULL falls back to ctx.realm.date_proto.
    proto:   ZjsObject*;
}

fn zjs_is_date(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_DATE { return 1; }
    return 0;
}

fn zjs_as_date(v: ZjsValue) -> ZjsDate* {
    let p = zjs_cell_as_ptr(v);
    let d: ZjsDate* = NULL;
    raw { d = (ZjsDate*)p; }
    return d;
}

fn zjs_date_new(time_ms: f64) -> ZjsDate* {
    let d = alloc<ZjsDate>();
    d.header.type_tag = TAG_DATE;
    d.time_ms = time_ms;
    d.props = NULL;
    d.proto = NULL;
    return d;
}

// =====================================================================
// Temporal (ECMA-262 Temporal proposal). One cell type, discriminated
// by `kind` (TMP_*). A value type — all fields are plain integers plus
// optional BigInt epochNanoseconds (Instant / ZonedDateTime) and
// calendar / timezone identifier strings. Built behind ZJS_NO_TEMPORAL
// (default on). See the temporal_* helpers + host_temporal_* in
// context.zc.
//
// Field meaning depends on kind:
//   PlainDate      : year, month, day (+ calendar)
//   PlainTime      : hour..nanosecond
//   PlainDateTime  : year..nanosecond (+ calendar)
//   PlainYearMonth : year, month (+ calendar; day = reference day)
//   PlainMonthDay  : month, day (+ calendar; year = reference year)
//   Duration       : the ten d_* fields (signed, can be large)
//   Instant        : epoch_ns (BigInt)
//   ZonedDateTime  : epoch_ns (BigInt) + timezone (+ calendar)
// =====================================================================
struct ZjsTemporal {
    header:      CellHeader;     // type_tag = TAG_TEMPORAL
    kind:        u8;             // TMP_*

    // Wall-clock / calendar components (PlainDate/Time/DateTime/YM/MD).
    year:        i32;
    month:       i32;
    day:         i32;
    hour:        i32;
    minute:      i32;
    second:      i32;
    millisecond: i32;
    microsecond: i32;
    nanosecond:  i32;

    // Duration components (signed; ToIntegerIfIntegral, fit i64 for any
    // realistic range). All zero for non-Duration kinds.
    d_years:   i64;
    d_months:  i64;
    d_weeks:   i64;
    d_days:    i64;
    d_hours:   i64;
    d_minutes: i64;
    d_seconds: i64;
    d_ms:      i64;
    d_us:      i64;
    d_ns:      i64;

    // Instant / ZonedDateTime epoch nanoseconds (a TAG_BIGINT value),
    // or undefined for the wall-clock kinds.
    epoch_ns:  ZjsValue;
    // Calendar identifier ("iso8601") — interned string or NULL.
    calendar:  ZjsString*;
    // IANA timezone identifier (ZonedDateTime) — interned string or NULL.
    timezone:  ZjsString*;

    props:     ZjsObject*;       // lazy expando bag
    proto:     ZjsObject*;       // per-instance [[Prototype]]
}

fn zjs_is_temporal(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_TEMPORAL { return 1; }
    return 0;
}

fn zjs_as_temporal(v: ZjsValue) -> ZjsTemporal* {
    let p = zjs_cell_as_ptr(v);
    let t: ZjsTemporal* = NULL;
    raw { t = (ZjsTemporal*)p; }
    return t;
}

// True if v is a Temporal cell of the given kind.
fn zjs_is_temporal_kind(v: ZjsValue, kind: u8) -> int {
    if zjs_cell_tag(v) != TAG_TEMPORAL { return 0; }
    if zjs_as_temporal(v).kind != kind { return 0; }
    return 1;
}

// Allocate a zero-initialized Temporal cell of the given kind. Caller
// fills the relevant fields + ctx_register_cell's it.
fn zjs_temporal_new(kind: u8) -> ZjsTemporal* {
    let t = alloc<ZjsTemporal>();
    t.header.type_tag = TAG_TEMPORAL;
    t.kind = kind;
    t.year = 0; t.month = 0; t.day = 0;
    t.hour = 0; t.minute = 0; t.second = 0;
    t.millisecond = 0; t.microsecond = 0; t.nanosecond = 0;
    t.d_years = 0; t.d_months = 0; t.d_weeks = 0; t.d_days = 0;
    t.d_hours = 0; t.d_minutes = 0; t.d_seconds = 0;
    t.d_ms = 0; t.d_us = 0; t.d_ns = 0;
    t.epoch_ns = zjs_undefined();
    t.calendar = NULL;
    t.timezone = NULL;
    t.props = NULL;
    t.proto = NULL;
    return t;
}

fn temporal_free_void(p: void*) -> void {
    let t: ZjsTemporal* = NULL;
    raw { t = (ZjsTemporal*)p; }
    if t == NULL { return; }
    dealloc(t);
}

// Fast-path iterator for arrays / strings. Bypasses the
// @@iterator host-call dance when the source is a pristine array
// (the common case). iter_step inspects this tag and walks src by
// index inline. Falls back to the wrapper-object path the moment
// user code overrides Array.prototype[@@iterator].
struct ZjsArrayIter {
    header: CellHeader;     // type_tag = TAG_ARRAY_ITER
    src:    ZjsValue;        // TAG_ARRAY or TAG_STRING
    index:  u32;
    done:   bool;
}

struct ZjsUint8Array {
    header:   CellHeader;   // type_tag = TAG_UINT8_ARRAY
    bytes:    u8*;          // owned heap buffer (freed in uint8_array_free)
    length:   u32;          // number of bytes
    capacity: u32;          // backing-buffer capacity
    // Per-instance [[Prototype]] override. NULL = use ctx.realm.uint8_array_proto.
    // Set by Object.setPrototypeOf so `node:buffer`'s Buffer (whose
    // prototype chains to Uint8Array.prototype) can give instances its
    // own methods. property_get walks this chain first; GC marks it.
    proto:    ZjsObject*;
}

fn zjs_is_uint8_array(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_UINT8_ARRAY { return 1; }
    return 0;
}

fn zjs_as_uint8_array(v: ZjsValue) -> ZjsUint8Array* {
    let p = zjs_cell_as_ptr(v);
    let u: ZjsUint8Array* = NULL;
    raw { u = (ZjsUint8Array*)p; }
    return u;
}

fn zjs_uint8_array_new(length: u32) -> ZjsUint8Array* {
    let a = alloc<ZjsUint8Array>();
    a.header.type_tag = TAG_UINT8_ARRAY;
    a.length = length;
    a.capacity = length;
    a.proto = NULL;
    if length > 0 {
        a.bytes = alloc_n<u8>((usize)length);
        // alloc_n is calloc-backed on the standard path; bytes are
        // already zero. Be explicit anyway for clarity.
        let i: u32 = 0;
        while i < length { a.bytes[i] = (u8)0; i = i + 1; }
    } else {
        a.bytes = NULL;
    }
    return a;
}

fn uint8_array_free_void(p: void*) -> void {
    let a: ZjsUint8Array* = NULL;
    raw { a = (ZjsUint8Array*)p; }
    if a.bytes != NULL { dealloc(a.bytes); }
    dealloc(a);
}

// =====================================================================
// ArrayBuffer / TypedArray / DataView — full TypedArray family.
//
// ArrayBuffer owns the bytes; TypedArray + DataView are views with
// a byte offset and a length. Multiple views can reference the same
// buffer (proper spec semantics). Lifetime: views hold the buffer
// alive via GC marking (handled in context.zc's mark phase).
// =====================================================================

struct ZjsArrayBuffer {
    header: CellHeader;       // type_tag = TAG_ARRAY_BUFFER
    bytes:  u8*;              // owned; freed in array_buffer_free
    length: u32;              // bytes (current byteLength)
    // Resizable ArrayBuffer (§25.1): max_byte_length is the resize cap and
    // `resizable` is set when constructed with { maxByteLength }. `detached`
    // is set by transfer / DetachArrayBuffer — a detached buffer has length 0
    // and bytes == NULL. alloc<> zeroes, so plain buffers default to
    // non-resizable / non-detached.
    max_byte_length: u32;
    resizable: bool;
    detached:  bool;
}

struct ZjsTypedArray {
    header:       CellHeader;       // type_tag = TAG_TYPED_ARRAY
    kind:         u8;               // TA_INT8 ... TA_FLOAT64
    element_size: u8;               // 1 / 2 / 4 / 8 — derivable but cached
    length:       u32;              // element count
    byte_offset:  u32;              // start byte in buffer
    buffer:       ZjsArrayBuffer*;  // backing storage
}

struct ZjsDataView {
    header:      CellHeader;        // type_tag = TAG_DATA_VIEW
    byte_offset: u32;
    byte_length: u32;
    buffer:      ZjsArrayBuffer*;
}

fn zjs_is_array_buffer(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_ARRAY_BUFFER { return 1; }
    return 0;
}

fn zjs_as_array_buffer(v: ZjsValue) -> ZjsArrayBuffer* {
    let p = zjs_cell_as_ptr(v);
    let b: ZjsArrayBuffer* = NULL;
    raw { b = (ZjsArrayBuffer*)p; }
    return b;
}

fn zjs_array_buffer_new(length: u32) -> ZjsArrayBuffer* {
    let b = alloc<ZjsArrayBuffer>();
    b.header.type_tag = TAG_ARRAY_BUFFER;
    b.length = length;
    if length > 0 {
        b.bytes = alloc_n<u8>((usize)length);
        let i: u32 = 0;
        while i < length { b.bytes[i] = (u8)0; i = i + 1; }
    } else {
        b.bytes = NULL;
    }
    return b;
}

// Resizable variant: current byteLength = `length`, resize cap = `maxlen`.
// The full `maxlen` block is allocated up front (and zeroed) so resize never
// moves `bytes` — any TypedArray / DataView / view holding a pointer into the
// store stays valid across a resize (resize only adjusts `.length`).
fn zjs_array_buffer_new_max(length: u32, maxlen: u32) -> ZjsArrayBuffer* {
    let b = alloc<ZjsArrayBuffer>();
    b.header.type_tag = TAG_ARRAY_BUFFER;
    b.length = length;
    b.max_byte_length = maxlen;
    b.resizable = true;
    if maxlen > 0 {
        b.bytes = alloc_n<u8>((usize)maxlen);
        let i: u32 = 0;
        while i < maxlen { b.bytes[i] = (u8)0; i = i + 1; }
    } else {
        b.bytes = NULL;
    }
    return b;
}

fn array_buffer_free_void(p: void*) -> void {
    let b: ZjsArrayBuffer* = NULL;
    raw { b = (ZjsArrayBuffer*)p; }
    if b.bytes != NULL { dealloc(b.bytes); }
    dealloc(b);
}

fn zjs_is_typed_array(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_TYPED_ARRAY { return 1; }
    return 0;
}

fn zjs_as_typed_array(v: ZjsValue) -> ZjsTypedArray* {
    let p = zjs_cell_as_ptr(v);
    let t: ZjsTypedArray* = NULL;
    raw { t = (ZjsTypedArray*)p; }
    return t;
}

// Construct a fresh TypedArray with its own backing buffer.
// `element_count` is the JS-facing length; the buffer is allocated
// to fit `element_count * element_size` bytes.
fn zjs_typed_array_new(kind: u8, element_count: u32) -> ZjsTypedArray* {
    let es = ta_element_size(kind);
    let t = alloc<ZjsTypedArray>();
    t.header.type_tag = TAG_TYPED_ARRAY;
    t.kind = kind;
    t.element_size = es;
    t.length = element_count;
    t.byte_offset = 0;
    t.buffer = zjs_array_buffer_new(element_count * (u32)es);
    return t;
}

// View an existing buffer with explicit offset/length. Offset is in
// bytes; length is in elements.
fn zjs_typed_array_view(kind: u8, buf: ZjsArrayBuffer*, byte_offset: u32, element_count: u32) -> ZjsTypedArray* {
    let t = alloc<ZjsTypedArray>();
    t.header.type_tag = TAG_TYPED_ARRAY;
    t.kind = kind;
    t.element_size = ta_element_size(kind);
    t.length = element_count;
    t.byte_offset = byte_offset;
    t.buffer = buf;
    return t;
}

fn typed_array_free_void(p: void*) -> void {
    // View — does NOT own its buffer. The buffer is GC-owned and freed
    // separately when no view references it.
    let t: ZjsTypedArray* = NULL;
    raw { t = (ZjsTypedArray*)p; }
    dealloc(t);
}

fn zjs_is_data_view(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_DATA_VIEW { return 1; }
    return 0;
}

fn zjs_as_data_view(v: ZjsValue) -> ZjsDataView* {
    let p = zjs_cell_as_ptr(v);
    let d: ZjsDataView* = NULL;
    raw { d = (ZjsDataView*)p; }
    return d;
}

fn zjs_data_view_new(buf: ZjsArrayBuffer*, byte_offset: u32, byte_length: u32) -> ZjsDataView* {
    let d = alloc<ZjsDataView>();
    d.header.type_tag = TAG_DATA_VIEW;
    d.byte_offset = byte_offset;
    d.byte_length = byte_length;
    d.buffer = buf;
    return d;
}

fn data_view_free_void(p: void*) -> void {
    let d: ZjsDataView* = NULL;
    raw { d = (ZjsDataView*)p; }
    dealloc(d);
}

// =====================================================================
// WebSocket — wraps the platform's native ws handle. Event handlers
// live in slots on the struct (assignable via .onopen/.onmessage/...
// in JS). The platform's pending events are drained by
// zjs_run_pending_work on each event-loop tick.
// =====================================================================

struct ZjsWebSocket {
    header:      CellHeader;       // type_tag = TAG_WEBSOCKET
    ready_state: u8;               // 0=CONNECTING 1=OPEN 2=CLOSING 3=CLOSED
    native:      void*;            // ZjsWsHandle* (opaque, ws_native.h)
    url:         ZjsString*;
    protocol:    ZjsString*;       // server-selected subprotocol (or NULL)
    on_open:     ZjsValue;
    on_message:  ZjsValue;
    on_error:    ZjsValue;
    on_close:    ZjsValue;
    // EventTarget listener pool — flat [type_v, callback_v, ...]
    // pairs. v0.1: type stored as a ZjsString cell, callback as any
    // callable value. options arg of addEventListener is ignored.
    listeners:        ZjsValue*;
    listener_count:   u32;          // number of (type, callback) pairs
    listener_cap:     u32;          // capacity in pairs (array length = 2*cap)
}

fn zjs_is_websocket(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_WEBSOCKET { return 1; }
    return 0;
}

fn zjs_as_websocket(v: ZjsValue) -> ZjsWebSocket* {
    let p = zjs_cell_as_ptr(v);
    let w: ZjsWebSocket* = NULL;
    raw { w = (ZjsWebSocket*)p; }
    return w;
}

fn zjs_websocket_new(url: ZjsString*) -> ZjsWebSocket* {
    let w = alloc<ZjsWebSocket>();
    w.header.type_tag = TAG_WEBSOCKET;
    w.ready_state = 0;
    w.native = NULL;
    w.url = url;
    w.protocol = NULL;
    w.on_open    = zjs_undefined();
    w.on_message = zjs_undefined();
    w.on_error   = zjs_undefined();
    w.on_close   = zjs_undefined();
    w.listeners = NULL;
    w.listener_count = 0;
    w.listener_cap = 0;
    return w;
}

fn websocket_free_void(p: void*) -> void {
    let w: ZjsWebSocket* = NULL;
    raw { w = (ZjsWebSocket*)p; }
    // Finalizer: tear down the platform handle if it's still alive.
    // Reached when GC frees a cell that's no longer reachable —
    // either after CLOSE removed it from the polling list, or when a
    // user dropped all references without calling .close() (a
    // dangling-handle leak in v0.1 prior to this fix).
    raw {
        if (w->native != NULL) {
            zjs_ws_destroy((ZjsWsHandle*)w->native);
            w->native = NULL;
        }
    }
    if w.listeners != NULL { dealloc(w.listeners); }
    dealloc(w);
}

fn zjs_is_array_iter(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_ARRAY_ITER { return 1; }
    return 0;
}

fn zjs_as_array_iter(v: ZjsValue) -> ZjsArrayIter* {
    let p = zjs_cell_as_ptr(v);
    let ai: ZjsArrayIter* = NULL;
    raw { ai = (ZjsArrayIter*)p; }
    return ai;
}

fn zjs_array_iter_new(src: ZjsValue) -> ZjsArrayIter* {
    let a = alloc<ZjsArrayIter>();
    a.header.type_tag = TAG_ARRAY_ITER;
    a.src = src;
    a.index = 0;
    a.done = false;
    return a;
}

// =====================================================================
// Symbol (2026-05-16). Identity-typed primitive: each Symbol carries a
// `description` for diagnostic output (Symbol.prototype.toString /
// .description) and a `key` string used when a Symbol is used as a
// property key — keeps the rest of the engine on string-keyed
// hidden classes for now. Well-known symbols (Symbol.iterator etc)
// pre-populate `key` with the "@@iterator"-style sentinel that the
// engine already understands, so existing for-of / destructuring
// paths keep working.
// =====================================================================

struct ZjsSymbol {
    header:      CellHeader;     // type_tag = TAG_SYMBOL
    description: ZjsString*;     // may be NULL (anonymous Symbol())
    key:         ZjsString*;     // canonical lookup string for prop access
    // Lazy expando bag — Symbols can carry own properties via
    // defineProperty (rare in practice, but spec-permitted).
    props:       ZjsObject*;
}

fn zjs_is_symbol(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_SYMBOL { return 1; }
    return 0;
}

fn zjs_as_symbol(v: ZjsValue) -> ZjsSymbol* {
    let p = zjs_cell_as_ptr(v);
    let s: ZjsSymbol* = NULL;
    raw { s = (ZjsSymbol*)p; }
    return s;
}

fn zjs_symbol_new(description: ZjsString*, key: ZjsString*) -> ZjsSymbol* {
    let s = alloc<ZjsSymbol>();
    s.header.type_tag = TAG_SYMBOL;
    s.description = description;
    s.key = key;
    s.props = NULL;
    return s;
}

// =====================================================================
// BigInt — arbitrary-precision integer (ECMA-262 §6.1.6.2).
//
// Representation: sign-magnitude. `limbs` holds the magnitude as a
// little-endian array of base-2^32 digits (limb[0] is least
// significant). Invariants maintained by bigint_normalize:
//   - No leading zero limbs: limbs[len-1] != 0 when len > 0.
//   - Zero is the canonical { sign = 0, len = 0, limbs = NULL }.
//   - sign is -1 or +1 for nonzero values, 0 only for zero.
//
// `limbs` is a raw malloc'd buffer (not a GC cell), freed in
// bigint_free_void. Nothing inside a BigInt is a traceable reference,
// so the GC mark walk treats it as a leaf.
// =====================================================================

struct ZjsBigInt {
    header: CellHeader;   // type_tag = TAG_BIGINT
    sign:   i32;          // -1, 0, +1
    len:    u32;          // significant limb count (0 ⟺ value is zero)
    cap:    u32;          // allocated limb capacity
    limbs:  u32*;         // little-endian base-2^32 magnitude; NULL when len==0
}

fn zjs_is_bigint(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_BIGINT { return 1; }
    return 0;
}

fn zjs_as_bigint(v: ZjsValue) -> ZjsBigInt* {
    let p = zjs_cell_as_ptr(v);
    let b: ZjsBigInt* = NULL;
    raw { b = (ZjsBigInt*)p; }
    return b;
}

// Allocate a BigInt cell with room for `cap` limbs (cap may be 0 for a
// value that will be set to zero). The limb buffer is zero-filled so
// callers can write only the limbs they need. Caller must
// ctx_register_cell the result and call bigint_normalize once the
// magnitude + sign are written.
fn zjs_bigint_new_cap(cap: u32) -> ZjsBigInt* {
    let b = alloc<ZjsBigInt>();
    b.header.type_tag = TAG_BIGINT;
    b.sign = 0;
    b.len  = 0;
    b.cap  = cap;
    if cap > 0 {
        b.limbs = alloc_n<u32>((usize)cap);
        let i: u32 = 0;
        while i < cap { b.limbs[i] = 0; i = i + 1; }
    } else {
        b.limbs = NULL;
    }
    return b;
}

// Trim leading zero limbs and canonicalize the zero value. Call after
// writing the magnitude into limbs[0..len) and setting sign.
fn bigint_normalize(b: ZjsBigInt*) -> void {
    let n = b.len;
    while n > 0 && b.limbs[n - 1] == 0 { n = n - 1; }
    b.len = n;
    if n == 0 { b.sign = 0; }
    else if b.sign == 0 { b.sign = 1; }   // defensive: nonzero must have a sign
}

// Construct a BigInt from a signed 64-bit integer. Magnitude fits in
// at most two 32-bit limbs.
fn zjs_bigint_from_i64(v: i64) -> ZjsBigInt* {
    let b = zjs_bigint_new_cap(2);
    if v == 0 { return b; }
    let neg: int = 0;
    let mag: u64 = 0;
    raw {
        if (v < 0) { neg = 1; mag = (uint64_t)(-(v + 1)) + 1ULL; }  /* avoid INT64_MIN UB */
        else       { mag = (uint64_t)v; }
    }
    b.limbs[0] = (u32)(mag & 0xffffffff);
    b.limbs[1] = (u32)((mag >> 32) & 0xffffffff);
    b.len = 2;
    b.sign = if neg != 0 { -1 } else { 1 };
    bigint_normalize(b);
    return b;
}

// Construct a BigInt from an unsigned 64-bit integer (always >= 0).
fn zjs_bigint_from_u64(v: u64) -> ZjsBigInt* {
    let b = zjs_bigint_new_cap(2);
    if v == 0 { return b; }
    b.limbs[0] = (u32)(v & 0xffffffff);
    b.limbs[1] = (u32)((v >> 32) & 0xffffffff);
    b.len = 2;
    b.sign = 1;
    bigint_normalize(b);
    return b;
}

// True if the value is exactly zero.
fn bigint_is_zero(b: ZjsBigInt*) -> bool {
    return b.len == 0;
}

// Free the limb buffer + the cell. Wired into the GC free dispatch.
fn bigint_free_void(p: void*) -> void {
    let b: ZjsBigInt* = NULL;
    raw { b = (ZjsBigInt*)p; }
    if b == NULL { return; }
    if b.limbs != NULL { dealloc(b.limbs); b.limbs = NULL; }
    dealloc(b);
}

// --- BigInt arithmetic primitives (B4) ------------------------------
//
// Magnitude helpers operate on the unsigned limb arrays; the signed
// wrappers (bigint_add/sub/mul/div/mod/pow/neg) layer sign rules on
// top and return a fresh, normalized cell the caller must register.

// Deep-copy a BigInt (sign + magnitude).
fn bigint_clone(a: ZjsBigInt*) -> ZjsBigInt* {
    let r = zjs_bigint_new_cap(if a.len > 0 { a.len } else { 0 });
    let i: u32 = 0;
    while i < a.len { r.limbs[i] = a.limbs[i]; i = i + 1; }
    r.len = a.len;
    r.sign = a.sign;
    return r;
}

// Compare magnitudes: -1 if |a|<|b|, 0 if equal, 1 if |a|>|b|.
fn bigint_cmp_mag(a: ZjsBigInt*, b: ZjsBigInt*) -> int {
    if a.len != b.len { if a.len < b.len { return -1; } return 1; }
    let i = a.len;
    while i > 0 {
        i = i - 1;
        if a.limbs[i] != b.limbs[i] {
            if a.limbs[i] < b.limbs[i] { return -1; }
            return 1;
        }
    }
    return 0;
}

// |a| + |b| into a fresh cell (len set, sign left 0 — caller sets).
fn bigint_addmag_new(a: ZjsBigInt*, b: ZjsBigInt*) -> ZjsBigInt* {
    let n = if a.len > b.len { a.len } else { b.len };
    let r = zjs_bigint_new_cap(n + 1);
    let carry: u64 = 0;
    let i: u32 = 0;
    while i < n {
        let av: u64 = if i < a.len { (u64)a.limbs[i] } else { 0 };
        let bv: u64 = if i < b.len { (u64)b.limbs[i] } else { 0 };
        let s = av + bv + carry;
        r.limbs[i] = (u32)(s & 0xffffffff);
        carry = s >> 32;
        i = i + 1;
    }
    if carry > 0 { r.limbs[n] = (u32)carry; r.len = n + 1; }
    else { r.len = n; }
    return r;
}

// |a| - |b| into a fresh cell, REQUIRES |a| >= |b|. Caller normalizes.
fn bigint_submag_new(a: ZjsBigInt*, b: ZjsBigInt*) -> ZjsBigInt* {
    let r = zjs_bigint_new_cap(a.len);
    let borrow: i64 = 0;
    let i: u32 = 0;
    while i < a.len {
        let av: i64 = (i64)a.limbs[i];
        let bv: i64 = if i < b.len { (i64)b.limbs[i] } else { 0 };
        let d = av - bv - borrow;
        if d < 0 { d = d + 4294967296; borrow = 1; } else { borrow = 0; }
        r.limbs[i] = (u32)d;
        i = i + 1;
    }
    r.len = a.len;
    return r;
}

// In-place |r| -= |b|, REQUIRES |r| >= |b|. Does not normalize.
fn bigint_submag_inplace(r: ZjsBigInt*, b: ZjsBigInt*) -> void {
    let borrow: i64 = 0;
    let i: u32 = 0;
    while i < r.len {
        let rv: i64 = (i64)r.limbs[i];
        let bv: i64 = if i < b.len { (i64)b.limbs[i] } else { 0 };
        let d = rv - bv - borrow;
        if d < 0 { d = d + 4294967296; borrow = 1; } else { borrow = 0; }
        r.limbs[i] = (u32)d;
        i = i + 1;
    }
}

// In-place |r| <<= 1 (one bit), growing len within cap.
fn bigint_shl1_mag(r: ZjsBigInt*) -> void {
    let carry: u32 = 0;
    let i: u32 = 0;
    while i < r.len {
        let v = r.limbs[i];
        r.limbs[i] = (v << 1) | carry;
        carry = v >> 31;
        i = i + 1;
    }
    if carry != 0 && r.len < r.cap {
        r.limbs[r.len] = carry;
        r.len = r.len + 1;
    }
}

// Signed add / sub. Both return a fresh normalized cell.
fn bigint_add(a: ZjsBigInt*, b: ZjsBigInt*) -> ZjsBigInt* {
    if a.len == 0 { return bigint_clone(b); }
    if b.len == 0 { return bigint_clone(a); }
    if a.sign == b.sign {
        let r = bigint_addmag_new(a, b);
        r.sign = a.sign;
        bigint_normalize(r);
        return r;
    }
    let c = bigint_cmp_mag(a, b);
    if c == 0 { return zjs_bigint_new_cap(0); }
    if c > 0 {
        let r = bigint_submag_new(a, b); r.sign = a.sign; bigint_normalize(r); return r;
    }
    let r = bigint_submag_new(b, a); r.sign = b.sign; bigint_normalize(r); return r;
}

fn bigint_sub(a: ZjsBigInt*, b: ZjsBigInt*) -> ZjsBigInt* {
    if b.len == 0 { return bigint_clone(a); }
    if a.len == 0 {
        let r = bigint_clone(b);
        if r.len > 0 { r.sign = -r.sign; }
        return r;
    }
    let bneg = -b.sign;
    if a.sign == bneg {
        let r = bigint_addmag_new(a, b); r.sign = a.sign; bigint_normalize(r); return r;
    }
    let c = bigint_cmp_mag(a, b);
    if c == 0 { return zjs_bigint_new_cap(0); }
    if c > 0 {
        let r = bigint_submag_new(a, b); r.sign = a.sign; bigint_normalize(r); return r;
    }
    let r = bigint_submag_new(b, a); r.sign = bneg; bigint_normalize(r); return r;
}

fn bigint_neg(a: ZjsBigInt*) -> ZjsBigInt* {
    let r = bigint_clone(a);
    if r.len > 0 { r.sign = -r.sign; }
    return r;
}

fn bigint_mul(a: ZjsBigInt*, b: ZjsBigInt*) -> ZjsBigInt* {
    if a.len == 0 || b.len == 0 { return zjs_bigint_new_cap(0); }
    let r = zjs_bigint_new_cap(a.len + b.len);
    let i: u32 = 0;
    while i < a.len {
        let carry: u64 = 0;
        let av: u64 = (u64)a.limbs[i];
        let j: u32 = 0;
        while j < b.len {
            let cur: u64 = (u64)r.limbs[i + j] + av * (u64)b.limbs[j] + carry;
            r.limbs[i + j] = (u32)(cur & 0xffffffff);
            carry = cur >> 32;
            j = j + 1;
        }
        // r[i+b.len] is untouched (still 0) at this point — see proof in
        // the schoolbook-multiply commentary: prior iterations write at
        // most index i'+b.len-1 < i+b.len.
        r.limbs[i + b.len] = (u32)carry;
        i = i + 1;
    }
    r.len = a.len + b.len;
    r.sign = a.sign * b.sign;
    bigint_normalize(r);
    return r;
}

// Magnitude long division (bit-by-bit). Returns quotient if want_quot,
// else remainder. REQUIRES |b| != 0. Caller sets signs + normalizes.
fn bigint_divmod_mag(a: ZjsBigInt*, b: ZjsBigInt*, want_quot: bool) -> ZjsBigInt* {
    if bigint_cmp_mag(a, b) < 0 {
        // |a| < |b|: quotient 0, remainder a.
        if want_quot { return zjs_bigint_new_cap(0); }
        let rr = bigint_clone(a); rr.sign = 1; bigint_normalize(rr); return rr;
    }
    let nbits = a.len * 32;
    let q = zjs_bigint_new_cap(a.len);
    q.len = a.len;   // zero-filled; normalized at the end
    let r = zjs_bigint_new_cap(b.len + 1);
    r.len = 0;
    let i = nbits;
    while i > 0 {
        i = i - 1;
        bigint_shl1_mag(r);
        let limb = i / 32;
        let bit = i % 32;
        let abit = (a.limbs[limb] >> bit) & 1;
        if abit != 0 {
            if r.len == 0 { r.len = 1; }
            r.limbs[0] = r.limbs[0] | 1;
        }
        if bigint_cmp_mag(r, b) >= 0 {
            bigint_submag_inplace(r, b);
            // trim r's leading zeros so cmp stays correct
            while r.len > 0 && r.limbs[r.len - 1] == 0 { r.len = r.len - 1; }
            q.limbs[limb] = q.limbs[limb] | (1 << bit);
        }
    }
    if want_quot { q.sign = 1; bigint_normalize(q); return q; }
    r.sign = 1; bigint_normalize(r); return r;
}

// Signed truncated division (toward zero) and remainder (sign of
// dividend), per ECMA-262 BigInt::divide / BigInt::remainder. Caller
// must ensure b != 0.
fn bigint_div(a: ZjsBigInt*, b: ZjsBigInt*) -> ZjsBigInt* {
    let q = bigint_divmod_mag(a, b, true);
    if q.len > 0 { q.sign = a.sign * b.sign; }
    return q;
}

fn bigint_mod(a: ZjsBigInt*, b: ZjsBigInt*) -> ZjsBigInt* {
    let r = bigint_divmod_mag(a, b, false);
    if r.len > 0 { r.sign = a.sign; }   // remainder takes the dividend's sign
    return r;
}

// base ** exp. REQUIRES exp >= 0 (caller checks). Exponentiation by
// squaring over the exponent's bits. Exponents beyond u64 are
// astronomically large; caller rejects those as RangeError.
fn bigint_pow_u64(base: ZjsBigInt*, exp: u64) -> ZjsBigInt* {
    let result = zjs_bigint_from_i64(1);
    let b = bigint_clone(base);
    let e = exp;
    while e > 0 {
        if (e & 1) != 0 {
            let nr = bigint_mul(result, b);
            bigint_free_void((void*)result);
            result = nr;
        }
        e = e >> 1;
        if e > 0 {
            let nb = bigint_mul(b, b);
            bigint_free_void((void*)b);
            b = nb;
        }
    }
    bigint_free_void((void*)b);
    return result;
}

// Does the BigInt fit in a u64 magnitude? (used to bound `**` exponent)
fn bigint_fits_u64(a: ZjsBigInt*) -> bool {
    return a.len <= 2;
}

fn bigint_to_u64(a: ZjsBigInt*) -> u64 {
    let lo: u64 = if a.len > 0 { (u64)a.limbs[0] } else { 0 };
    let hi: u64 = if a.len > 1 { (u64)a.limbs[1] } else { 0 };
    return (hi << 32) | lo;
}

// Signed i64 from a BigInt (low 64 bits of the magnitude, signed).
// Exact when the value fits in i64 (len <= 2); callers that care about
// overflow should range-check separately.
fn bigint_to_i64(a: ZjsBigInt*) -> i64 {
    let mag = (i64)bigint_to_u64(a);
    if a.sign < 0 { return -mag; }
    return mag;
}

// Full signed compare of two BigInts: -1 if a<b, 0 if a==b, 1 if a>b.
fn bigint_cmp(a: ZjsBigInt*, b: ZjsBigInt*) -> int {
    if a.sign != b.sign {
        if a.sign < b.sign { return -1; }
        return 1;
    }
    // Same sign (incl. both zero → both sign 0 → equal mags).
    let m = bigint_cmp_mag(a, b);
    if a.sign < 0 { return -m; }   // both negative: larger magnitude is smaller
    return m;
}

// Compare a BigInt to a double exactly. Returns -1/0/1 for a <,=,> x,
// or -2 when incomparable (x is NaN). Builds the floor of x as an exact
// BigInt (integral doubles are exactly representable) and tiebreaks on
// the fractional part — so 2n**60n vs the same value as a double
// compares correctly even past 2^53.
fn bigint_cmp_f64(a: ZjsBigInt*, x: f64) -> int {
    let nan: int = 0;
    let inf: int = 0;   // 1 = +inf, -1 = -inf
    raw {
        if (isnan(x)) nan = 1;
        else if (isinf(x)) inf = (x > 0) ? 1 : -1;
    }
    if nan != 0 { return -2; }
    if inf == 1 { return -1; }    // a < +Infinity
    if inf == -1 { return 1; }    // a > -Infinity
    let xf: f64 = 0.0;
    raw { xf = floor(x); }
    let xb = zjs_bigint_from_f64(xf);
    let c = bigint_cmp(a, xb);
    bigint_free_void((void*)xb);
    if c != 0 { return c; }
    // a == floor(x). If x had a positive fractional part, a < x.
    if x > xf { return -1; }
    return 0;
}

// --- BigInt bitwise + shift primitives (B5b) ------------------------
//
// Bitwise ops follow ECMA-262's two's-complement-over-infinite-sign-
// extension model. A non-negative BigInt's bits are its magnitude with
// infinite leading 0s; a negative -m is the two's complement
// NOT(m-1) with infinite leading 1s. We materialize a fixed working
// width W (max operand length + 1 guard limb) and rely on the fill /
// rebuild helpers to handle the sign extension.

// Fill out[0..W) with the two's-complement limbs of `a` at width W.
fn bigint_fill_twos(a: ZjsBigInt*, W: u32, out: u32*) -> void {
    if a.sign >= 0 {
        let i: u32 = 0;
        while i < W { out[i] = if i < a.len { a.limbs[i] } else { 0 }; i = i + 1; }
    } else {
        // value = -m → two's complement is NOT(m-1).
        let borrow: i64 = 1;
        let i: u32 = 0;
        while i < W {
            let mi: i64 = if i < a.len { (i64)a.limbs[i] } else { 0 };
            let d = mi - borrow;
            if d < 0 { d = d + 4294967296; borrow = 1; } else { borrow = 0; }
            raw { out[i] = ~((uint32_t)d); }
            i = i + 1;
        }
    }
}

// Rebuild a BigInt from two's-complement limbs tc[0..W). `negative`
// says whether the (infinite) value is negative.
fn bigint_from_twos(tc: u32*, W: u32, negative: bool) -> ZjsBigInt* {
    let r = zjs_bigint_new_cap(W);
    if !negative {
        let i: u32 = 0;
        while i < W { r.limbs[i] = tc[i]; i = i + 1; }
        r.len = W; r.sign = 1; bigint_normalize(r); return r;
    }
    // negative: magnitude = NOT(tc) + 1 over width W.
    let carry: u64 = 1;
    let i: u32 = 0;
    while i < W {
        let inv: u64 = 0;
        raw { inv = (uint64_t)(uint32_t)(~tc[i]); }
        let s = inv + carry;
        r.limbs[i] = (u32)(s & 0xffffffff);
        carry = s >> 32;
        i = i + 1;
    }
    r.len = W; r.sign = -1; bigint_normalize(r); return r;
}

// a OP b, op: 0=AND 1=OR 2=XOR.
fn bigint_bitop(a: ZjsBigInt*, b: ZjsBigInt*, op: u32) -> ZjsBigInt* {
    let W = (if a.len > b.len { a.len } else { b.len }) + 1;
    let ta = alloc_n<u32>((usize)W);
    let tb = alloc_n<u32>((usize)W);
    let tc = alloc_n<u32>((usize)W);
    bigint_fill_twos(a, W, ta);
    bigint_fill_twos(b, W, tb);
    let i: u32 = 0;
    while i < W {
        if op == 0 { tc[i] = ta[i] & tb[i]; }
        else if op == 1 { tc[i] = ta[i] | tb[i]; }
        else { tc[i] = ta[i] ^ tb[i]; }
        i = i + 1;
    }
    let sa: u32 = if a.sign < 0 { 1 } else { 0 };
    let sb: u32 = if b.sign < 0 { 1 } else { 0 };
    let sr: u32 = if op == 0 { sa & sb } else if op == 1 { sa | sb } else { sa ^ sb };
    let r = bigint_from_twos(tc, W, sr != 0);
    dealloc(ta); dealloc(tb); dealloc(tc);
    return r;
}

// ~a = -(a + 1) (two's-complement identity).
fn bigint_not(a: ZjsBigInt*) -> ZjsBigInt* {
    let one = zjs_bigint_from_i64(1);
    let ap1 = bigint_add(a, one);
    bigint_free_void((void*)one);
    let r = bigint_neg(ap1);
    bigint_free_void((void*)ap1);
    return r;
}

// |a| << nbits → fresh positive-magnitude BigInt.
fn bigint_shl_mag(a: ZjsBigInt*, nbits: u64) -> ZjsBigInt* {
    if a.len == 0 { return zjs_bigint_new_cap(0); }
    let limb_shift: u32 = (u32)(nbits / 32);
    let bit_shift: u32 = (u32)(nbits % 32);
    let W = a.len + limb_shift + 1;
    let r = zjs_bigint_new_cap(W);
    let i: u32 = 0;
    while i < a.len {
        let v: u64 = (u64)a.limbs[i] << bit_shift;
        let dst = i + limb_shift;
        r.limbs[dst] = r.limbs[dst] | (u32)(v & 0xffffffff);
        r.limbs[dst + 1] = r.limbs[dst + 1] | (u32)(v >> 32);
        i = i + 1;
    }
    r.len = W; r.sign = 1; bigint_normalize(r); return r;
}

// |a| >> nbits → fresh positive-magnitude BigInt. Sets lost[0] if any
// 1-bit was shifted out (needed for floor semantics on negatives).
fn bigint_shr_mag(a: ZjsBigInt*, nbits: u64, lost: bool*) -> ZjsBigInt* {
    lost[0] = false;
    let limb_shift: u32 = (u32)(nbits / 32);
    let bit_shift: u32 = (u32)(nbits % 32);
    if limb_shift >= a.len {
        if a.len > 0 { lost[0] = true; }
        return zjs_bigint_new_cap(0);
    }
    let k: u32 = 0;
    while k < limb_shift { if a.limbs[k] != 0 { lost[0] = true; } k = k + 1; }
    if bit_shift > 0 {
        if (a.limbs[limb_shift] & ((1 << bit_shift) - 1)) != 0 { lost[0] = true; }
    }
    let outlen = a.len - limb_shift;
    let r = zjs_bigint_new_cap(outlen);
    let i: u32 = 0;
    while i < outlen {
        let cur: u64 = (u64)a.limbs[i + limb_shift] >> bit_shift;
        if bit_shift > 0 && (i + limb_shift + 1) < a.len {
            cur = cur | ((u64)a.limbs[i + limb_shift + 1] << (32 - bit_shift));
        }
        r.limbs[i] = (u32)(cur & 0xffffffff);
        i = i + 1;
    }
    r.len = outlen; r.sign = 1; bigint_normalize(r); return r;
}

// Signed `a << nbits` (nbits >= 0). Sign is preserved (multiply by 2^n).
fn bigint_shl(a: ZjsBigInt*, nbits: u64) -> ZjsBigInt* {
    let r = bigint_shl_mag(a, nbits);
    if r.len > 0 { r.sign = a.sign; }
    return r;
}

// Signed `a >> nbits` (nbits >= 0) = floor(a / 2^nbits). For negatives
// the floor rounds toward -Infinity (add 1 to the magnitude if any bit
// was lost).
fn bigint_shr(a: ZjsBigInt*, nbits: u64) -> ZjsBigInt* {
    let lost: bool = false;
    let mag = bigint_shr_mag(a, nbits, &lost);
    if a.sign < 0 {
        if lost {
            let one = zjs_bigint_from_i64(1);
            let m2 = bigint_add(mag, one);   // both positive magnitudes
            bigint_free_void((void*)one);
            bigint_free_void((void*)mag);
            mag = m2;
        }
        if mag.len > 0 { mag.sign = -1; }
    }
    return mag;
}

// 2^bits as a fresh BigInt.
fn bigint_pow2(bits: u64) -> ZjsBigInt* {
    let one = zjs_bigint_from_i64(1);
    let r = bigint_shl_mag(one, bits);
    bigint_free_void((void*)one);
    return r;
}

// asUintN(bits, a): a mod 2^bits as a non-negative BigInt (the low
// `bits` bits of the two's-complement representation).
fn bigint_asuintn(bits: u64, a: ZjsBigInt*) -> ZjsBigInt* {
    if bits == 0 { return zjs_bigint_new_cap(0); }
    let W: u32 = (u32)((bits + 31) / 32);
    let tc = alloc_n<u32>((usize)W);
    bigint_fill_twos(a, W, tc);
    let top_bits: u32 = (u32)(bits % 32);
    if top_bits != 0 {
        tc[W - 1] = tc[W - 1] & ((1 << top_bits) - 1);
    }
    let r = zjs_bigint_new_cap(W);
    let i: u32 = 0;
    while i < W { r.limbs[i] = tc[i]; i = i + 1; }
    r.len = W; r.sign = 1; bigint_normalize(r);
    dealloc(tc);
    return r;
}

// asIntN(bits, a): interpret asUintN's result as a two's-complement
// signed value of `bits` bits.
fn bigint_asintn(bits: u64, a: ZjsBigInt*) -> ZjsBigInt* {
    let u = bigint_asuintn(bits, a);
    if bits == 0 { return u; }
    // If the top (sign) bit is set, subtract 2^bits to make it negative.
    let sign_limb: u32 = (u32)((bits - 1) / 32);
    let sign_bit: u32 = (u32)((bits - 1) % 32);
    let is_neg: bool = false;
    if sign_limb < u.len {
        if (u.limbs[sign_limb] & (1 << sign_bit)) != 0 { is_neg = true; }
    }
    if !is_neg { return u; }
    let p2 = bigint_pow2(bits);
    let r = bigint_sub(u, p2);   // u - 2^bits  → negative
    bigint_free_void((void*)u);
    bigint_free_void((void*)p2);
    return r;
}

// hex digit → value, or 99 for non-hex (used to skip separators etc).
fn bigint_digit_val(c: u8) -> u32 {
    if c >= (u8)'0' && c <= (u8)'9' { return (u32)(c - (u8)'0'); }
    if c >= (u8)'a' && c <= (u8)'f' { return (u32)(c - (u8)'a') + 10; }
    if c >= (u8)'A' && c <= (u8)'F' { return (u32)(c - (u8)'A') + 10; }
    return 99;
}

// Accumulate `digits[0..dlen)` in the given radix into b (which must
// start at zero and have enough limb capacity). `_` separators are
// skipped. b = Σ digit * radix^position. Sets sign + normalizes.
fn bigint_parse_into(b: ZjsBigInt*, digits: char*, dlen: u32, radix: u32) -> void {
    let i: u32 = 0;
    while i < dlen {
        let c = (u8)digits[i];
        i = i + 1;
        if c == (u8)'_' { continue; }
        let dv = bigint_digit_val(c);
        if dv >= radix { continue; }   // defensive: ignore stray chars
        // b = b * radix + dv  (schoolbook, in place, carry past len)
        let carry: u64 = (u64)dv;
        let j: u32 = 0;
        while j < b.len {
            let cur: u64 = (u64)b.limbs[j] * (u64)radix + carry;
            b.limbs[j] = (u32)(cur & 0xffffffff);
            carry = cur >> 32;
            j = j + 1;
        }
        while carry > 0 && b.len < b.cap {
            b.limbs[b.len] = (u32)(carry & 0xffffffff);
            b.len = b.len + 1;
            carry = carry >> 32;
        }
    }
    if b.len > 0 { b.sign = 1; }
    bigint_normalize(b);
}

// Parse a BigInt literal slice (`123n`, `0xFFn`, `0o17n`, `0b101n`).
// The trailing `n` and any radix prefix are part of src[start..start+length).
fn zjs_bigint_from_literal(src: char*, start: u32, length: u32) -> ZjsBigInt* {
    // Drop the trailing `n`.
    let len = if length > 0 { length - 1 } else { 0 };
    let off: u32 = 0;
    let radix: u32 = 10;
    if len >= 2 {
        let c0 = (u8)src[start];
        let c1 = (u8)src[start + 1];
        if c0 == (u8)'0' && (c1 == (u8)'x' || c1 == (u8)'X') { radix = 16; off = 2; }
        else if c0 == (u8)'0' && (c1 == (u8)'o' || c1 == (u8)'O') { radix = 8; off = 2; }
        else if c0 == (u8)'0' && (c1 == (u8)'b' || c1 == (u8)'B') { radix = 2; off = 2; }
    }
    let dlen = if len > off { len - off } else { 0 };
    // Cap: digit count / 8 + 2 limbs is safe for any radix ≤ 16
    // (each digit contributes ≤ 4 bits, a limb holds 32).
    let cap = dlen / 8 + 2;
    let b = zjs_bigint_new_cap(cap);
    let dptr: char* = NULL;
    raw { dptr = (char*)(src + start + off); }
    bigint_parse_into(b, dptr, dlen, radix);
    return b;
}

// Number → BigInt (ECMA-262 §7.1.13 / NumberToBigInt). The caller
// must have verified d is finite and integral; this builds the exact
// magnitude limb-by-limb via fmod (exact for integral doubles since
// every integer ≤ 2^1024 is representable and fmod by 2^32 is lossless
// for those). Returns the cell (caller registers it).
fn zjs_bigint_from_f64(d: f64) -> ZjsBigInt* {
    let b = zjs_bigint_new_cap(40);   // up to ~33 limbs for max double exponent
    if d == 0.0 { return b; }
    let neg: int = 0;
    let m: f64 = d;
    raw { if (m < 0) { neg = 1; m = -m; } }
    let i: u32 = 0;
    raw {
        double mm = m;
        while (mm >= 1.0 && i < b->cap) {
            double limb = fmod(mm, 4294967296.0);
            b->limbs[i] = (uint32_t)limb;
            mm = floor(mm / 4294967296.0);
            i++;
        }
    }
    b.len = i;
    b.sign = if neg != 0 { -1 } else { 1 };
    bigint_normalize(b);
    return b;
}

// BigInt → f64 (ECMA-262 §7.1.x BigInt::toNumber, used by Number()).
// Loses precision above 2^53 — that's spec (rounds to nearest double).
fn bigint_to_f64(b: ZjsBigInt*) -> f64 {
    let acc: f64 = 0.0;
    let i = b.len;
    while i > 0 {
        i = i - 1;
        acc = acc * 4294967296.0 + (f64)b.limbs[i];
    }
    if b.sign < 0 { acc = -acc; }
    return acc;
}

// String → BigInt (ECMA-262 §7.1.14 StringToBigInt). Trims whitespace,
// accepts an optional +/- sign on a decimal literal or a 0x/0o/0b
// radix prefix (no sign with a prefix). Empty/whitespace-only → 0n.
// Sets ok[0]=1 on success, 0 on a malformed string (caller throws
// SyntaxError). Always returns a valid (possibly zero) cell.
fn zjs_bigint_from_string(src: char*, len: u32, ok: int*) -> ZjsBigInt* {
    ok[0] = 1;
    // Trim ASCII + common JS whitespace.
    let s: u32 = 0;
    let e: u32 = len;
    while s < e {
        let c = (u8)src[s];
        if c == (u8)' ' || c == (u8)'\t' || c == (u8)'\n' || c == (u8)'\r'
           || c == 0x0B || c == 0x0C { s = s + 1; } else { break; }
    }
    while e > s {
        let c = (u8)src[e - 1];
        if c == (u8)' ' || c == (u8)'\t' || c == (u8)'\n' || c == (u8)'\r'
           || c == 0x0B || c == 0x0C { e = e - 1; } else { break; }
    }
    if s >= e { return zjs_bigint_new_cap(0); }   // empty → 0n

    let neg: int = 0;
    let radix: u32 = 10;
    // Radix prefix (no sign permitted alongside).
    if e - s >= 2 && (u8)src[s] == (u8)'0' {
        let c1 = (u8)src[s + 1];
        if c1 == (u8)'x' || c1 == (u8)'X' { radix = 16; s = s + 2; }
        else if c1 == (u8)'o' || c1 == (u8)'O' { radix = 8; s = s + 2; }
        else if c1 == (u8)'b' || c1 == (u8)'B' { radix = 2; s = s + 2; }
    }
    // Sign only on the decimal form.
    if radix == 10 && s < e {
        let c0 = (u8)src[s];
        if c0 == (u8)'+' { s = s + 1; }
        else if c0 == (u8)'-' { neg = 1; s = s + 1; }
    }
    if s >= e { ok[0] = 0; return zjs_bigint_new_cap(0); }   // sign/prefix only

    // Validate every remaining char is a digit in-radix (no separators
    // allowed in StringToBigInt, unlike numeric literals).
    let j: u32 = s;
    while j < e {
        let dv = bigint_digit_val((u8)src[j]);
        if dv >= radix { ok[0] = 0; return zjs_bigint_new_cap(0); }
        j = j + 1;
    }
    let dlen = e - s;
    let cap = dlen / 8 + 2;
    let b = zjs_bigint_new_cap(cap);
    let dptr: char* = NULL;
    raw { dptr = (char*)(src + s); }
    bigint_parse_into(b, dptr, dlen, radix);
    if neg != 0 && b.len > 0 { b.sign = -1; }
    return b;
}

// Render a BigInt in an arbitrary radix (2..36), lowercase digits, no
// `n` suffix. radix 10 delegates to the fast decimal path. Returns a
// freshly malloc'd NUL-terminated buffer; caller owns it.
fn bigint_to_radix_cstring(b: ZjsBigInt*, radix: u32, out_len: u32*) -> char* {
    if radix == 10 { return bigint_to_decimal_cstring(b, out_len); }
    if b.len == 0 {
        let z = alloc_n<char>((usize)2);
        z[0] = (char)'0'; z[1] = (char)0;
        out_len[0] = 1;
        return z;
    }
    let n = b.len;
    let scratch = alloc_n<u32>((usize)n);
    let i: u32 = 0;
    while i < n { scratch[i] = b.limbs[i]; i = i + 1; }
    let slen = n;
    let dcap = n * 32 + 4;            // radix 2 worst case: 32 digits/limb
    let digits = alloc_n<char>((usize)dcap);
    let dpos: u32 = 0;
    while slen > 0 {
        // divmod scratch by radix
        let rem: u64 = 0;
        let k = slen;
        while k > 0 {
            k = k - 1;
            let cur: u64 = (rem << 32) | (u64)scratch[k];
            scratch[k] = (u32)(cur / (u64)radix);
            rem = cur % (u64)radix;
        }
        while slen > 0 && scratch[slen - 1] == 0 { slen = slen - 1; }
        let dv = (u32)rem;
        let ch: u8 = if dv < 10 { (u8)'0' + (u8)dv } else { (u8)'a' + (u8)(dv - 10) };
        digits[dpos] = (char)ch;
        dpos = dpos + 1;
    }
    let neg = b.sign < 0;
    let total = dpos + (if neg { 1u32 } else { 0u32 });
    let out = alloc_n<char>((usize)(total + 1));
    let oi: u32 = 0;
    if neg { out[0] = (char)'-'; oi = 1; }
    let p = dpos;
    while p > 0 { p = p - 1; out[oi] = digits[p]; oi = oi + 1; }
    out[total] = (char)0;
    dealloc(scratch);
    dealloc(digits);
    out_len[0] = total;
    return out;
}

// Render a BigInt as a decimal string (no `n` suffix — matches
// BigInt.prototype.toString() / String(bigint)). Returns a freshly
// malloc'd, NUL-terminated buffer; caller owns it (intern + free).
// `out_len` receives the string length (excluding the NUL).
fn bigint_to_decimal_cstring(b: ZjsBigInt*, out_len: u32*) -> char* {
    if b.len == 0 {
        let z = alloc_n<char>((usize)2);
        z[0] = (char)'0'; z[1] = (char)0;
        out_len[0] = 1;
        return z;
    }
    // Work on a scratch copy of the magnitude — divmod is destructive.
    let n = b.len;
    let scratch = alloc_n<u32>((usize)n);
    let i: u32 = 0;
    while i < n { scratch[i] = b.limbs[i]; i = i + 1; }
    let slen = n;
    // Each base-10^9 chunk emits up to 9 digits; total decimal digits
    // ≤ ceil(limbs * 32 / log2(10)) ≈ limbs * 10. Plenty: limbs*10 + 2
    // plus room for a sign.
    let dcap = n * 10 + 4;
    let digits = alloc_n<char>((usize)dcap);
    let dpos: u32 = 0;
    // Repeatedly divide the scratch magnitude by 1e9, emitting 9 digits
    // per step (or fewer on the final, most-significant chunk).
    let any_more: bool = true;
    while any_more {
        // divmod by 1_000_000_000
        let rem: u64 = 0;
        let k = slen;
        while k > 0 {
            k = k - 1;
            let cur: u64 = (rem << 32) | (u64)scratch[k];
            scratch[k] = (u32)(cur / 1000000000);
            rem = cur % 1000000000;
        }
        while slen > 0 && scratch[slen - 1] == 0 { slen = slen - 1; }
        any_more = slen > 0;
        // Emit the 9-digit chunk (least-significant first, into digits[]
        // in reverse). On the last chunk drop leading zeros.
        let chunk: u32 = (u32)rem;
        let cnt: u32 = 0;
        while cnt < 9 {
            digits[dpos] = (char)((u8)'0' + (u8)(chunk % 10));
            dpos = dpos + 1;
            chunk = chunk / 10;
            cnt = cnt + 1;
            if !any_more && chunk == 0 { break; }
        }
    }
    // Now digits[0..dpos) holds the decimal digits least-significant
    // first. Reverse into the output, prepending '-' for negatives.
    let neg = b.sign < 0;
    let total = dpos + (if neg { 1u32 } else { 0u32 });
    let out = alloc_n<char>((usize)(total + 1));
    let oi: u32 = 0;
    if neg { out[0] = (char)'-'; oi = 1; }
    let p = dpos;
    while p > 0 {
        p = p - 1;
        out[oi] = digits[p];
        oi = oi + 1;
    }
    out[total] = (char)0;
    dealloc(scratch);
    dealloc(digits);
    out_len[0] = total;
    return out;
}

fn zjs_promise_new() -> ZjsPromise* {
    let p = alloc<ZjsPromise>();
    p.header.type_tag = TAG_PROMISE;
    p.state = PROMISE_PENDING;
    p.value = zjs_undefined();
    p.proto = NULL;
    p.props = NULL;
    return p;
}

// =====================================================================
// Proxy — wraps a target value + handler object. Spec semantics live in
// property_get / property_set / property_has / property_delete: each
// checks `zjs_is_proxy(target)` at entry and, when so, looks up the
// matching trap on the handler. Trap-missing → forward to target.
// =====================================================================

struct ZjsProxy {
    header:  CellHeader;     // type_tag = TAG_PROXY
    target:  ZjsValue;       // the wrapped object (must be object-like at construction)
    handler: ZjsValue;       // the trap-dispatch object (also object-like)
    // Reset to undefined by Proxy.revocable's revoke(). Once revoked,
    // every trap throws TypeError; we just check whether target is
    // undefined to detect the revoked state.
    revoked: bool;
}

fn zjs_is_proxy(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_PROXY { return 1; }
    return 0;
}

fn zjs_as_proxy(v: ZjsValue) -> ZjsProxy* {
    let p = zjs_cell_as_ptr(v);
    let pr: ZjsProxy* = NULL;
    raw { pr = (ZjsProxy*)p; }
    return pr;
}

fn zjs_proxy_new(target: ZjsValue, handler: ZjsValue) -> ZjsProxy* {
    let p = alloc<ZjsProxy>();
    p.header.type_tag = TAG_PROXY;
    p.target  = target;
    p.handler = handler;
    p.revoked = false;
    return p;
}

// JS regex flag bits. `g` and `y` are stateful (lastIndex tracking),
// the others only affect compilation. Matches the convention used by
// most engines so byte ordering is recognisable in dumps.
def REGEX_FLAG_GLOBAL:      u8 = 0x01;     // g
def REGEX_FLAG_IGNORE_CASE: u8 = 0x02;     // i
def REGEX_FLAG_MULTILINE:   u8 = 0x04;     // m
def REGEX_FLAG_DOTALL:      u8 = 0x08;     // s
def REGEX_FLAG_UNICODE:     u8 = 0x10;     // u (parsed but not honored — POSIX has no Unicode-aware mode)
def REGEX_FLAG_STICKY:      u8 = 0x20;     // y
def REGEX_FLAG_HAS_INDICES: u8 = 0x40;     // d (parsed only)

// Runtime RegExp object. Compilation is lazy — `preg` stays NULL
// until the first match call, then regex_ensure_compiled calls
// lre_compile (libregexp / QuickJS-NG) and caches the bytecode
// buffer. `source` and `flags_str` are JS-visible via .source /
// .flags; they're interned strings owned by the atom table.
struct ZjsRegExp {
    header:     CellHeader;     // { type_tag = TAG_REGEXP }
    source:     ZjsString*;     // pattern between the slashes (JS syntax)
    flags_str:  ZjsString*;     // raw flag letters in source order
    flags:      u8;             // bitset of REGEX_FLAG_*
    preg:       void*;          // libregexp bytecode buffer (NULL = not yet compiled, or compile failed)
    compiled:   bool;           // true once we've attempted compile (regardless of success)
    last_index: u32;            // lastIndex — used by g and y flags
    // Expando bag — JS allows arbitrary properties on a RegExp
    // instance (`re.foo = 1`). Some test262 tests use this to carry
    // descriptor values on a RegExp passed to Object.create. Same
    // lazy-alloc shape as ZjsArray.props / ZjsHostFunction.props.
    props:      ZjsObject*;
    // Per-instance [[Prototype]] — set when constructed via
    // `class Sub extends RegExp {}`. NULL falls back to ctx.realm.regexp_proto.
    proto:      ZjsObject*;
}

fn zjs_is_regexp(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_REGEXP { return 1; }
    return 0;
}

fn zjs_as_regexp(v: ZjsValue) -> ZjsRegExp* {
    let p = zjs_cell_as_ptr(v);
    let r: ZjsRegExp* = NULL;
    raw { r = (ZjsRegExp*)p; }
    return r;
}

fn zjs_regexp_new() -> ZjsRegExp* {
    let r = zalloc<ZjsRegExp>();
    r.header.type_tag = TAG_REGEXP;
    return r;
}

fn promise_free_void(p: void*) -> void {
    let pr: ZjsPromise* = NULL;
    raw { pr = (ZjsPromise*)p; }
    dealloc(pr.reactions);
    dealloc(pr);
}

struct ZjsClosure {
    header:   CellHeader;        // { type_tag = TAG_CLOSURE }
    function: void*;              // Function* — opaque to value.zc (defined in bytecode.zc)
    env:      ZjsObject*;        // captured environment; may be NULL for arity-0 captures
    props:    ZjsObject*;        // per-instance expando bag (NULL until first write)
    // Per-instance [[Prototype]] override, set by Object.setPrototypeOf(closure, X).
    // NULL means "default lookup chain — walk ctx.realm.function_proto then ctx.realm.object_proto"
    // (the path before this field existed). When set, property_get walks
    // proto_override first, BEFORE Function.prototype — this is what lets
    // chalk's `(...) => ...; Object.setPrototypeOf(it, Chalk.prototype)`
    // pattern resolve `.red`, `.bold`, etc. from Chalk.prototype.
    proto_override: ZjsObject*;
    // Arrow-function lexical-this capture. Arrows don't have their own
    // `this` — they inherit from the enclosing scope. We snapshot
    // ctx.host_this at MakeClosure time when the wrapped Function is
    // is_arrow=true, and Op::LoadThis inside the arrow body returns
    // this snapshot instead of the current frame's host_this. Critical
    // for `class Foo { constructor() { arr.map(x => this.bar(x)) } }`
    // and any callback-style code (test262 §10.2.1.3).
    captured_this:  ZjsValue;
}

fn zjs_cell_from_ptr(p: void*) -> ZjsValue {
    let bits: u64 = 0;
    raw { bits = (uint64_t)(uintptr_t)p; }
    return ZjsValue{ bits: bits };
}

fn zjs_cell_as_ptr(v: ZjsValue) -> void* {
    let p: void* = NULL;
    let bits = v.bits;
    raw { p = (void*)(uintptr_t)bits; }
    return p;
}

// --- Tag-aware predicates -------------------------------------------

fn zjs_cell_tag(v: ZjsValue) -> u8 {
    if zjs_is_cell(v) == 0 { return 255; }
    let p = zjs_cell_as_ptr(v);
    let tag: u8 = 0;
    raw { tag = ((CellHeader*)p)->type_tag; }
    return tag;
}

fn zjs_is_function(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_FUNCTION { return 1; }
    return 0;
}

fn zjs_is_string(v: ZjsValue) -> int {
    // Both flat strings and ropes count as "string" at the JS level —
    // callers shouldn't have to care which physical representation
    // they're holding. zjs_as_string transparently flattens ropes.
    let t = zjs_cell_tag(v);
    if t == TAG_STRING { return 1; }
    if t == TAG_STRING_ROPE { return 1; }
    return 0;
}

fn zjs_is_string_rope(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_STRING_ROPE { return 1; }
    return 0;
}

// Rope cell — pairs two strings (or sub-ropes) without materializing
// the concatenation. `flat` is NULL until the first read, at which
// point we walk the tree, allocate a flat buffer, and cache the
// resulting ZjsString* here so subsequent reads are O(1).
struct ZjsStringRope {
    header: CellHeader;        // type_tag = TAG_STRING_ROPE
    length: u32;               // total combined length (cached)
    flat:   ZjsString*;        // NULL until flattened
    left:   ZjsValue;          // ZjsString or ZjsStringRope value
    right:  ZjsValue;          // same
}

fn zjs_as_string_rope(v: ZjsValue) -> ZjsStringRope* {
    let p = zjs_cell_as_ptr(v);
    let r: ZjsStringRope* = NULL;
    raw { r = (ZjsStringRope*)p; }
    return r;
}

// Combined length of a string-or-rope value — O(1) since ropes
// cache their length.
fn zjs_string_length(v: ZjsValue) -> u32 {
    let t = zjs_cell_tag(v);
    if t == TAG_STRING {
        let p = zjs_cell_as_ptr(v);
        let s: ZjsString* = NULL;
        raw { s = (ZjsString*)p; }
        return s.length;
    }
    if t == TAG_STRING_ROPE { return zjs_as_string_rope(v).length; }
    return 0;
}

// Walk the rope tree, materialize a flat ZjsString, cache it on the
// rope, return the flat result. Idempotent — the cached `flat` is
// returned on subsequent calls.
//
// Uses g_active_ctx (set by interpret()) to register the new flat
// cell with the GC. If g_active_ctx is NULL (outside the
// interpreter) we still allocate; the cell will leak until ctx
// cleanup, which is acceptable since the only path here off-
// interpreter is during bootstrap (no concat happens then anyway).
raw {
    // ZjsContext is defined in context.zc which imports this file —
    // forward-declare as an opaque struct so the extern signatures
    // match. clang-merge at C-emit time resolves to the real type.
    typedef struct ZjsContext ZjsContext;
    extern ZjsContext* g_active_ctx;
    extern void ctx_register_cell(ZjsContext* ctx, void* p);
}

fn zjs_string_rope_flatten(r: ZjsStringRope*) -> ZjsString* {
    if r.flat != NULL { return r.flat; }
    let total = r.length;
    let buf: char* = NULL;
    raw { buf = (char*)malloc((size_t)(total + 1)); }
    let written = rope_copy_bytes(r.left, buf, 0);
    written = rope_copy_bytes(r.right, buf, written);
    buf[total] = (char)0;
    let s = zjs_string_new_take(buf, total);
    raw {
        if (g_active_ctx != NULL) {
            ctx_register_cell(g_active_ctx, (void*)s);
        }
    }
    r.flat = s;
    return s;
}

fn rope_free_void(p: void*) -> void {
    let r: ZjsStringRope* = NULL;
    raw { r = (ZjsStringRope*)p; }
    dealloc(r);
}

// Build a rope cell. Caller must ctx_register_cell. left + right
// are ZjsValues (string or rope). length is the combined length.
fn zjs_string_rope_new(left: ZjsValue, right: ZjsValue, length: u32) -> ZjsStringRope* {
    let r = alloc<ZjsStringRope>();
    r.header.type_tag = TAG_STRING_ROPE;
    r.length = length;
    r.flat = NULL;
    r.left = left;
    r.right = right;
    return r;
}

// Copy the bytes of `node` into `dst` starting at `offset`, returning
// the new offset after the copy. Recurses through rope children.
fn rope_copy_bytes(node: ZjsValue, dst: char*, offset: usize) -> usize {
    let t = zjs_cell_tag(node);
    if t == TAG_STRING {
        let p = zjs_cell_as_ptr(node);
        let s: ZjsString* = NULL;
        raw { s = (ZjsString*)p; }
        if s.length > 0 {
            raw {
                memcpy(dst + offset, s->data, s->length);
            }
        }
        return offset + (usize)s.length;
    }
    if t == TAG_STRING_ROPE {
        let r = zjs_as_string_rope(node);
        if r.flat != NULL {
            // Already flattened — just memcpy the cached bytes.
            if r.flat.length > 0 {
                raw {
                    memcpy(dst + offset, r->flat->data, r->flat->length);
                }
            }
            return offset + (usize)r.flat.length;
        }
        offset = rope_copy_bytes(r.left, dst, offset);
        offset = rope_copy_bytes(r.right, dst, offset);
        return offset;
    }
    return offset;
}

fn zjs_is_object(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_OBJECT { return 1; }
    return 0;
}

fn zjs_is_array(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_ARRAY { return 1; }
    return 0;
}

fn zjs_is_host_function(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_HOST_FUNCTION { return 1; }
    return 0;
}

fn zjs_is_closure(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_CLOSURE { return 1; }
    return 0;
}

fn zjs_as_closure(v: ZjsValue) -> ZjsClosure* {
    let p = zjs_cell_as_ptr(v);
    let cl: ZjsClosure* = NULL;
    raw { cl = (ZjsClosure*)p; }
    return cl;
}

fn zjs_is_callable(v: ZjsValue) -> int {
    let t = zjs_cell_tag(v);
    if t == TAG_FUNCTION { return 1; }
    if t == TAG_HOST_FUNCTION { return 1; }
    if t == TAG_CLOSURE { return 1; }
    return 0;
}

fn zjs_as_string(v: ZjsValue) -> ZjsString* {
    let p = zjs_cell_as_ptr(v);
    // Fast path: cell tag is TAG_STRING (the common case). Branch
    // here to avoid the rope dispatch when no rope is in play.
    let tag: u8 = 0;
    raw { tag = ((CellHeader*)p)->type_tag; }
    if tag == TAG_STRING {
        let s: ZjsString* = NULL;
        raw { s = (ZjsString*)p; }
        return s;
    }
    // Rope: return the cached flat if available, else flatten.
    let r: ZjsStringRope* = NULL;
    raw { r = (ZjsStringRope*)p; }
    if r.flat != NULL { return r.flat; }
    return zjs_string_rope_flatten(r);
}

fn zjs_as_object(v: ZjsValue) -> ZjsObject* {
    let p = zjs_cell_as_ptr(v);
    let o: ZjsObject* = NULL;
    raw { o = (ZjsObject*)p; }
    return o;
}

fn zjs_is_hidden_class(v: ZjsValue) -> int {
    if zjs_cell_tag(v) == TAG_HIDDEN_CLASS { return 1; }
    return 0;
}

fn zjs_as_array(v: ZjsValue) -> ZjsArray* {
    let p = zjs_cell_as_ptr(v);
    let a: ZjsArray* = NULL;
    raw { a = (ZjsArray*)p; }
    return a;
}

fn zjs_as_host_function(v: ZjsValue) -> ZjsHostFunction* {
    let p = zjs_cell_as_ptr(v);
    let h: ZjsHostFunction* = NULL;
    raw { h = (ZjsHostFunction*)p; }
    return h;
}

// --- String allocation ----------------------------------------------
//
// `zjs_string_new` copies the input bytes; `zjs_string_new_take` takes
// ownership of an already-malloc'd, null-terminated buffer. Both
// produce a cell that must be registered on a ZjsContext for cleanup
// (the caller in context.zc handles that).

fn zjs_string_new_take(data: char*, length: u32) -> ZjsString* {
    let s = alloc<ZjsString>();
    s.header.type_tag = TAG_STRING;
    s.length = length;
    s.interned = false;
    s.data = data;
    return s;
}

fn zjs_string_new(data: char*, length: u32) -> ZjsString* {
    let copy = alloc_n<char>((usize)(length + 1));
    mem_copy<char>(copy, data, (usize)length);
    copy[length] = (char)0;
    return zjs_string_new_take(copy, length);
}

fn string_free_void(p: void*) -> void {
    let s: ZjsString* = NULL;
    raw { s = (ZjsString*)p; }
    if s == NULL { return; }
    dealloc(s.data);
    dealloc(s);
}

// Allocate a new empty object cell. The caller is responsible for
// setting `cls` to a valid HiddenClass (typically the context's root
// empty class) and registering the cell on the context.
fn zjs_object_new() -> ZjsObject* {
    // zalloc so cls / slots / attrs / proto start zero. Several lookups
    // gate on NULL pointers; uninitialized garbage was working by luck
    // (same fix as function_new took earlier).
    let o = zalloc<ZjsObject>();
    o.header.type_tag = TAG_OBJECT;
    return o;
}

fn object_free_void(p: void*) -> void {
    let o: ZjsObject* = NULL;
    raw { o = (ZjsObject*)p; }
    if o == NULL { return; }
    dealloc(o.slots);
    dealloc(o.attrs);
    dealloc(o);
}

// Allocate a new HiddenClass cell. Parent / transition_name are set
// by the caller. The transitions arrays start empty.
fn zjs_hidden_class_new(parent: ZjsHiddenClass*, transition_name: ZjsString*, slot: u32, prop_count: u32) -> ZjsHiddenClass* {
    let c = alloc<ZjsHiddenClass>();
    c.header.type_tag = TAG_HIDDEN_CLASS;
    c.parent = parent;
    c.transition_name = transition_name;
    c.transition_slot = slot;
    c.prop_count = prop_count;
    return c;
}

fn hidden_class_free_void(p: void*) -> void {
    let c: ZjsHiddenClass* = NULL;
    raw { c = (ZjsHiddenClass*)p; }
    if c == NULL { return; }
    dealloc(c.trans_names);
    dealloc(c.trans_children);
    dealloc(c);
}

// Allocate a new array with `length` slots, all initialized to HOLE
// (zjs_deleted()). ECMA-262 distinguishes "the slot is not present"
// (a hole) from "the slot contains undefined" — `new Array(3)` has
// three holes; `[undefined, undefined, undefined]` has three undefined
// values. forEach / map / etc. skip holes; reads through array_get
// coerce holes to undefined transparently.
fn zjs_array_new(length: u32) -> ZjsArray* {
    let a = alloc<ZjsArray>();
    a.header.type_tag = TAG_ARRAY;
    a.length = length;
    a.proto = NULL;
    let cap: u32 = if length < 4 { 4 } else { length };
    a.cap = cap;
    let buf = alloc_n<ZjsValue>((usize)cap);
    let hole: ZjsValue = zjs_deleted();
    let i: u32 = 0;
    while i < cap {
        buf[i] = hole;
        i = i + 1;
    }
    a.elements = buf;
    return a;
}

fn array_free_void(p: void*) -> void {
    let a: ZjsArray* = NULL;
    raw { a = (ZjsArray*)p; }
    if a == NULL { return; }
    dealloc(a.elements);
    dealloc(a);
}

fn host_function_free_void(p: void*) -> void {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)p; }
    if hf == NULL { return; }
    dealloc(hf.name);
    dealloc(hf);
}

// Allocate a fresh closure. Caller fills function + env and registers
// it on a context for cleanup.
fn zjs_closure_new(function: void*, env: ZjsObject*) -> ZjsClosure* {
    let cl = alloc<ZjsClosure>();
    cl.header.type_tag = TAG_CLOSURE;
    cl.function = function;
    cl.env = env;
    cl.props = NULL;
    cl.proto_override = NULL;
    cl.captured_this = zjs_undefined();
    return cl;
}

fn closure_free_void(p: void*) -> void {
    let cl: ZjsClosure* = NULL;
    raw { cl = (ZjsClosure*)p; }
    if cl == NULL { return; }
    dealloc(cl);
}

// =====================================================================
// Property + element helpers. Live here (not context.zc) because they
// don't need ZjsContext — pure operations on the cells.
// =====================================================================

// Walk the parent chain looking for `name`. Returns -1 if not found.
// Atom-pointer compare is the hot path; if both names are atoms (the
// usual case for property names), this is one pointer compare per
// link in the chain.
fn class_find_slot(cls: ZjsHiddenClass*, name: ZjsString*) -> i32 {
    let c = cls;
    while c != NULL && c.parent != NULL {
        if zjs_string_equals(c.transition_name, name) != 0 {
            return (i32)c.transition_slot;
        }
        c = c.parent;
    }
    return -1;
}

// Find an existing transition from `cls` on `name`. Returns NULL if
// no such edge exists yet.
fn class_find_transition(cls: ZjsHiddenClass*, name: ZjsString*) -> ZjsHiddenClass* {
    // Move-to-front on hit. Empty_class accumulates dozens of
    // transitions during bootstrap (every distinct property name ever
    // installed on a fresh {}), and the bridge bench's `{i:1}` literal
    // pays a linear scan over all of them per iteration. With MTF the
    // hot transitions converge to index 0, so the steady-state scan
    // is a single pointer-compare.
    let i: u32 = 0;
    while i < cls.trans_count {
        if zjs_string_equals(cls.trans_names[i], name) != 0 {
            let child = cls.trans_children[i];
            if i != 0 {
                cls.trans_names[i]    = cls.trans_names[0];
                cls.trans_children[i] = cls.trans_children[0];
                cls.trans_names[0]    = name;
                cls.trans_children[0] = child;
            }
            return child;
        }
        i = i + 1;
    }
    return NULL;
}

// Append a transition edge to `parent`. Caller is responsible for
// allocating + linking the child class.
fn class_add_transition(parent: ZjsHiddenClass*, name: ZjsString*, child: ZjsHiddenClass*) -> void {
    if parent.trans_count >= parent.trans_cap {
        let new_cap: u32 = if parent.trans_cap == 0 { 4 } else { parent.trans_cap * 2 };
        let old_cap = parent.trans_cap;
        parent.trans_names    = realloc_n<ZjsString*>(parent.trans_names,    (usize)old_cap, (usize)new_cap);
        parent.trans_children = realloc_n<ZjsHiddenClass*>(parent.trans_children, (usize)old_cap, (usize)new_cap);
        parent.trans_cap = new_cap;
    }
    parent.trans_names[parent.trans_count] = name;
    parent.trans_children[parent.trans_count] = child;
    parent.trans_count = parent.trans_count + 1;
}

// Get a property by name. Returns undefined if not found.
fn object_get(obj: ZjsObject*, name: ZjsString*) -> ZjsValue {
    let slot = class_find_slot(obj.cls, name);
    if slot < 0 { return zjs_undefined(); }
    return obj.slots[(u32)slot];
}

// Write to an EXISTING property only. Returns 1 if the property
// existed and was updated; 0 if not (caller must take the new-transition
// path via object_set_full in context.zc).
fn object_set_existing(obj: ZjsObject*, name: ZjsString*, value: ZjsValue) -> int {
    let existing = class_find_slot(obj.cls, name);
    if existing >= 0 {
        obj.slots[(u32)existing] = value;
        return 1;
    }
    return 0;
}

fn array_get(arr: ZjsArray*, idx: u32) -> ZjsValue {
    if idx >= arr.length { return zjs_undefined(); }
    // length may temporarily exceed cap when a sparse defineProperty
    // bumps the array's length without writing into elements (the
    // value lives on the .props expando). Reading those slots returns
    // undefined safely.
    if idx >= arr.cap { return zjs_undefined(); }
    let v = arr.elements[idx];
    // Hole sentinel reads as undefined to JS code.
    if zjs_is_deleted(v) != 0 { return zjs_undefined(); }
    return v;
}

// JIT fast path for `arr[i]` (Op::LoadElem). Mirrors the interpreter's
// inline fast path: plain array, no expando bag (a numeric-key accessor
// would have to fire), int32 index in [0, length) and within the dense
// backing buffer, non-hole slot. On a hit, sets *ok=1 and returns the
// element bits; on anything else (non-array, OOB, sparse, hole, expando)
// sets *ok=0 so the JIT deopts to the interpreter — which is read-only and
// allocation-free, so it never triggers GC or needs a write barrier. ctx-free
// by design: the JIT calls it through a GOT-held address (see stencils.c).
fn jit_array_get_fast(arr_bits: u64, idx: i32, ok: int*) -> u64 {
    *ok = 0;
    let av = ZjsValue{ bits: arr_bits };
    if zjs_is_array(av) == 0 { return 0; }
    if idx < 0 { return 0; }
    let arr = zjs_as_array(av);
    if arr.props != NULL { return 0; }
    let u = (u32)idx;
    if u >= arr.length { return 0; }
    if u >= arr.cap { return 0; }
    let v = arr.elements[u];
    if zjs_is_deleted(v) != 0 { return 0; }
    *ok = 1;
    return v.bits;
}

// JIT fast path for `arr[i] = v` (Op::StoreElem). The barrier-free, alloc-free
// subset of the interpreter's fast path: plain array, no expando, not frozen,
// int32 index strictly in-bounds of the dense buffer (`i < length` and within
// `cap`, so no length bump / realloc), and — critically — a NON-CELL value
// (number / bool / null / undefined). A cell store would need a generational
// write barrier, so it deopts to the interpreter. Everything else (append,
// grow, frozen, expando, cell value) sets *ok=0 → OSR deopt. ctx-free.
fn jit_array_set_fast(arr_bits: u64, idx: i32, val_bits: u64, ok: int*) -> void {
    *ok = 0;
    let av = ZjsValue{ bits: arr_bits };
    if zjs_is_array(av) == 0 { return; }
    if idx < 0 { return; }
    let vv = ZjsValue{ bits: val_bits };
    if zjs_is_cell(vv) != 0 { return; }   // cell store needs a write barrier
    let arr = zjs_as_array(av);
    if arr.props != NULL { return; }
    if arr.frozen { return; }
    let u = (u32)idx;
    if u >= arr.length { return; }        // append / grow / OOB → interpreter
    if u >= arr.cap { return; }           // sparse (length>cap) slot → interpreter
    arr.elements[u] = vv;
    *ok = 1;
}

// JIT fast path for `obj.name` (Op::LoadProp). The own-slot monomorphic/
// polymorphic IC hit only: probe the cached hidden classes in the inline-cache
// entry (passed by address — the interpreter warms it) against the receiver's
// shape; on a hit whose slot is an OWN slot (top bit clear), return that slot's
// value. Proto-chain hits, accessors, deleted slots, IC misses, and non-objects
// set *ok=0 → OSR deopt to the interpreter (which also updates the IC). Mirrors
// the interpreter's Op::LoadProp fast path; read-only, ctx-free.
fn jit_prop_get_fast(ic_bits: u64, obj_bits: u64, ok: int*) -> u64 {
    *ok = 0;
    let ov = ZjsValue{ bits: obj_bits };
    if zjs_is_object(ov) == 0 { return 0; }
    let o = zjs_as_object(ov);
    let hit: i32 = -1;
    let slot_raw: u32 = 0;
    let is_proto: int = 0;
    raw {
        ICEntry* ic = (ICEntry*)(uintptr_t)ic_bits;
        ZjsHiddenClass* cls = o->cls;
        uint32_t cnt = (uint32_t)ic->entry_count;
        int h = -1;
        if      (cnt > 0 && ic->classes[0] == cls) h = 0;
        else if (cnt > 1 && ic->classes[1] == cls) h = 1;
        else if (cnt > 2 && ic->classes[2] == cls) h = 2;
        else if (cnt > 3 && ic->classes[3] == cls) h = 3;
        hit = h;
        if (h >= 0) {
            slot_raw = ic->slots[h];
            is_proto = (slot_raw & 0x80000000u) ? 1 : 0;
        }
    }
    if hit < 0 { return 0; }
    if is_proto != 0 { return 0; }        // direct-proto hit → interpreter
    let v = o.slots[slot_raw];
    if zjs_is_accessor(v) != 0 { return 0; }
    if zjs_is_deleted(v) != 0 { return 0; }
    *ok = 1;
    return v.bits;
}

// JIT fast path for `obj.name = v` (Op::StoreProp). The own-slot IC hit of a
// writable data slot (the interpreter only caches those, so a hit ⇒ writable)
// whose current value is neither an accessor nor a hole, AND — like StoreElem
// — a NON-CELL value (a cell store would need a generational write barrier →
// deopt). Probe the IC against the receiver's shape; on a hit, overwrite the
// slot. Anything else (cell value, accessor, IC miss, non-object) → OSR deopt.
// ctx-free.
fn jit_prop_set_fast(ic_bits: u64, obj_bits: u64, val_bits: u64, ok: int*) -> void {
    *ok = 0;
    let ov = ZjsValue{ bits: obj_bits };
    if zjs_is_object(ov) == 0 { return; }
    let vv = ZjsValue{ bits: val_bits };
    if zjs_is_cell(vv) != 0 { return; }   // cell store needs a write barrier
    let o = zjs_as_object(ov);
    let hit_slot: i32 = -1;
    raw {
        ICEntry* ic = (ICEntry*)(uintptr_t)ic_bits;
        ZjsHiddenClass* cls = o->cls;
        uint32_t cnt = (uint32_t)ic->entry_count;
        if      (cnt > 0 && ic->classes[0] == cls) hit_slot = (int32_t)ic->slots[0];
        else if (cnt > 1 && ic->classes[1] == cls) hit_slot = (int32_t)ic->slots[1];
        else if (cnt > 2 && ic->classes[2] == cls) hit_slot = (int32_t)ic->slots[2];
        else if (cnt > 3 && ic->classes[3] == cls) hit_slot = (int32_t)ic->slots[3];
    }
    if hit_slot < 0 { return; }            // miss, or top-bit (proto) slot
    let slot_n = (u32)hit_slot;
    let cur = o.slots[slot_n];
    if zjs_is_accessor(cur) != 0 { return; }
    if zjs_is_deleted(cur) != 0 { return; }
    o.slots[slot_n] = vv;
    *ok = 1;
}

// JIT fast path for a top-level `let`/`var` read (Op::LoadGlobal). Top-level
// bindings live in ctx.realm.globals[slot]; the JIT reaches the active ctx via
// the g_active_ctx global (set by interpret()) — no ctx in the ABI. A defined
// slot returns its value; an undefined slot (would fall through to the
// globalThis ObjectRecord, or throw ReferenceError) → *ok=0 → OSR deopt.
fn jit_global_get(slot: u64, ok: int*) -> u64 {
    *ok = 0;
    let v: u64 = 0;
    raw {
        extern ZjsContext* g_active_ctx;
        if (g_active_ctx != NULL) {
            ZjsRealm* rm = g_active_ctx->realm;
            if (rm != NULL && (uint32_t)slot < rm->global_count
                && rm->globals[slot].defined) {
                v = rm->globals[slot].value.bits;
                *ok = 1;
            }
        }
    }
    return v;
}

// JIT fast path for a top-level binding write (Op::StoreGlobal / DefineGlobal —
// identical: value = src, defined = true). NON-CELL values only (a cell store
// into the globals root could need a generational write barrier → deopt).
fn jit_global_set(slot: u64, val_bits: u64, ok: int*) -> void {
    *ok = 0;
    let vv = ZjsValue{ bits: val_bits };
    if zjs_is_cell(vv) != 0 { return; }
    raw {
        extern ZjsContext* g_active_ctx;
        if (g_active_ctx != NULL) {
            ZjsRealm* rm = g_active_ctx->realm;
            if (rm != NULL && (uint32_t)slot < rm->global_count) {
                rm->globals[slot].value.bits = val_bits;
                rm->globals[slot].defined = true;
                *ok = 1;
            }
        }
    }
}

// JIT Div / Mod fast paths (J12d). Both operands must be plain JS numbers
// (int32 or double) — then the engine's own zjs_arith_div/_mod gives the exact
// result (incl. /0 → ±Infinity, 0/0 → NaN, fmod semantics). Any non-number
// operand (object / string / bigint / symbol / bool) → *ok=0 deopt, so the
// interpreter performs the ToPrimitive / coercion / throw.
fn jit_arith_div_fast(a_bits: u64, b_bits: u64, ok: int*) -> u64 {
    *ok = 0;
    let a = ZjsValue{ bits: a_bits };
    let b = ZjsValue{ bits: b_bits };
    if (zjs_is_int32(a) == 0 && zjs_is_double(a) == 0) { return 0; }
    if (zjs_is_int32(b) == 0 && zjs_is_double(b) == 0) { return 0; }
    *ok = 1;
    return zjs_arith_div(a, b).bits;
}
fn jit_arith_mod_fast(a_bits: u64, b_bits: u64, ok: int*) -> u64 {
    *ok = 0;
    let a = ZjsValue{ bits: a_bits };
    let b = ZjsValue{ bits: b_bits };
    if (zjs_is_int32(a) == 0 && zjs_is_double(a) == 0) { return 0; }
    if (zjs_is_int32(b) == 0 && zjs_is_double(b) == 0) { return 0; }
    *ok = 1;
    return zjs_arith_mod(a, b).bits;
}
// JIT Math.sqrt/abs/floor/ceil fast path (J12d). which: 0=sqrt,1=abs,2=floor,
// 3=ceil. Mirrors the interpreter's specialized op EXACTLY: ToNumber on a plain
// number only (else deopt), libm call, and the same result boxing — abs/floor/
// ceil of an int32 stays int32 when representable; sqrt is always a double.
fn jit_math_op_fast(v_bits: u64, which: u32, ok: int*) -> u64 {
    *ok = 0;
    let v = ZjsValue{ bits: v_bits };
    let is_i: int = if zjs_is_int32(v) != 0 { 1 } else { 0 };
    let d: f64 = 0.0;
    if is_i != 0 {
        d = (f64)zjs_as_int32(v);
    } else if zjs_is_double(v) != 0 {
        d = zjs_as_double(v);
    } else {
        return 0;
    }
    let r: f64 = 0.0;
    raw {
        if (which == 0) r = sqrt(d);
        else if (which == 1) r = fabs(d);
        else if (which == 2) r = floor(d);
        else r = ceil(d);
    }
    *ok = 1;
    if which != 0 && is_i != 0 {
        let iv: i32 = (i32)r;
        if (f64)iv == r { return zjs_int32(iv).bits; }
        return zjs_double(r).bits;
    }
    return zjs_double(r).bits;
}

// True if `idx` is in range and the slot is not a hole. Used by
// Array.prototype methods that follow the spec's HasProperty step
// (forEach / map / indexOf / etc. skip absent indices entirely).
fn array_has_index(arr: ZjsArray*, idx: u32) -> int {
    if idx >= arr.length { return 0; }
    if idx >= arr.cap { return 0; }
    if zjs_is_deleted(arr.elements[idx]) != 0 { return 0; }
    return 1;
}

fn array_set(arr: ZjsArray*, idx: u32, value: ZjsValue) -> void {
    // Object.freeze'd arrays are immutable. Silently no-op in sloppy
    // mode (spec throws TypeError in strict — not wired yet).
    if arr.frozen { return; }
    // Sealed / preventExtensions: in-bounds writes still work (writable
    // remains true under seal); growth is blocked because both length
    // and new indices would require extending the slot space.
    if arr.non_extensible && idx >= arr.length { return; }
    // Reject growths into unreasonable territory (spec says push at
    // length=2^32-1 throws RangeError; we silently drop). The 64 Mi
    // ceiling is chosen so the dense backing never demands a
    // multi-GB realloc that would either OOM or hang clearing slots.
    if idx >= 67108864 { return; }
    if idx >= arr.cap {
        let new_cap: u32 = if arr.cap == 0 { 4 } else { arr.cap };
        while new_cap <= idx { new_cap = new_cap * 2; }
        let old = arr.elements;
        let new_buf: ZjsValue* = NULL;
        raw { new_buf = (ZjsValue*)realloc(old, new_cap * sizeof(ZjsValue)); }
        // New slots are holes (zjs_deleted()) — not undefined. Sparse
        // arrays (`a[100] = 1`) leave 0..99 as holes, which forEach
        // and friends must skip.
        let hole: ZjsValue = zjs_deleted();
        let i = arr.cap;
        while i < new_cap {
            new_buf[i] = hole;
            i = i + 1;
        }
        arr.elements = new_buf;
        arr.cap = new_cap;
    }
    arr.elements[idx] = value;
    if idx >= arr.length { arr.length = idx + 1; }
    // GC write barrier — record old→young edges for the next minor.
    // Bridged through C since value.zc doesn't import context.zc;
    // gc_barrier is a no-op when there's no active context (bootstrap).
    raw { extern void gc_barrier(void* holder, ZjsValue value); gc_barrier((void*)arr, value); }
}

// Convert a key value to a non-negative index. Returns -1 if the key
// isn't a valid array index for this array (number/integer-string).
// Note: this does NOT clamp to length — array_get does that.
fn zjs_to_array_index(v: ZjsValue) -> i32 {
    if zjs_is_int32(v) != 0 {
        let i = zjs_as_int32(v);
        if i >= 0 { return i; }
        return -1;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        let i = (i32)d;
        if (f64)i == d && i >= 0 { return i; }
        return -1;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let data = s.data;
        let len  = s.length;
        let out:   i32 = -1;
        raw {
            char* end = NULL;
            long parsed = strtol(data, &end, 10);
            // Must consume the whole string and be non-negative.
            if (end != data && (size_t)(end - data) == len && parsed >= 0 && parsed <= 2147483647L) {
                out = (int32_t)parsed;
            }
        }
        return out;
    }
    return -1;
}

// Byte-equality for strings. Hot path on property lookup.
// Atoms (interned strings) hit the pointer-identity fast path.
fn zjs_string_equals(a: ZjsString*, b: ZjsString*) -> int {
    if a == b { return 1; }                // atom or aliased fast path
    if a.length != b.length { return 0; }
    let len = a.length;
    let ad = a.data;
    let bd = b.data;
    let eq: int = 0;
    raw { eq = (memcmp(ad, bd, len) == 0) ? 1 : 0; }
    return eq;
}

// --- ToBoolean extension --------------------------------------------
//
// String ToBoolean: empty string is falsy, non-empty is truthy.
// (Already covered by the existing is_cell branch returning 1 for
// any cell, which is wrong for empty strings — patched here.)
