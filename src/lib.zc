// libzjs entry point.
//
// Imports all engine modules so they're visible to `zc build` and exposes
// the public API surface. Public symbols are exactly the ones declared in
// include/zjs.h. Their C-level names match the Zen-c function names.

// --- Platform-native networking ---
// fetch() routes through src/platform/http_native.h's zjs_http_get_sync.
// Each platform ships its own native backend:
//   - Apple:   NSURLSession (.m), Foundation framework
//   - Windows: WinHTTP (HTTP + WebSocket) — Win 8+
//   - Linux:   libcurl (HTTP) + libwebsockets (WebSocket)
//   - Other:   http_stub.c + ws_stub.c
//
// winhttp.lib pulls in via a `#pragma comment(lib, ...)` inside
// http_windows.c (MSVC / clang-cl / zig cc); mingw/gcc honors the
// `-lwinhttp` from the windows link directive below.
//> macos: framework: Foundation
//> macos: cflags:    -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m src/platform/socket_posix.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c
//> ios:   framework: Foundation
//> ios:   cflags:    -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m src/platform/socket_posix.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c
//> linux: cflags:    -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE src/platform/http_linux.c src/platform/ws_linux.c src/platform/http_async.c src/platform/socket_posix.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c
//> linux: link:      -lcurl -lwebsockets
//> windows: cflags:  -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE src/platform/http_windows.c src/platform/ws_windows.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c

// --- Windows portability links ---
// src/platform/portability.h uses BCryptGenRandom (bcrypt.dll) for
// CSPRNG and GetProcessMemoryInfo (psapi.dll) for peak RSS. http_windows.c
// uses WinHTTP (winhttp.dll). These must be linked into every binary that
// compiles the engine.
//> windows: link: -lbcrypt -lpsapi -lwinhttp

import "./context.zc";
import "./value.zc";
import "./token.zc";
import "./lexer.zc";
import "./ast.zc";
import "./parser.zc";
import "./eval.zc";
import "./interpreter.zc";
import "./aot.zc";

// --- Standard library (task #190, docs/stdlib-design.md) ---
import "./stdlib/node_path.zc";
import "./stdlib/node_fs.zc";
import "./stdlib/node_process.zc";
import "./stdlib/node_os.zc";
import "./stdlib/node_tty.zc";
import "./stdlib/node_dx.zc";
import "./stdlib/node_child_process.zc";
import "./stdlib/node_net.zc";
import "./stdlib/node_http.zc";
import "./stdlib/web_events.zc";
import "./stdlib/web_abort.zc";
import "./stdlib/web_clone.zc";
import "./stdlib/web_blob.zc";
import "./stdlib/web_streams.zc";

raw {
    #include <string.h>
}

fn zjs_version() -> string {
    return "0.0.1-phase0";
}

// =====================================================================
// Public embed C ABI — thin wrappers around the internal helpers.
//
// Everything declared in include/zjs.h that isn't already a direct
// internal symbol lives here, so the header surface and its
// implementation sit side-by-side and the embed contract stays
// reviewable in one place.
// =====================================================================

// --- Value constructors ------------------------------------------------

fn zjs_new_string(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    let bytes: char* = data;
    if bytes == NULL && length == 0 { bytes = (char*)""; }
    if bytes == NULL { return zjs_undefined(); }
    // Route through the atom table so two calls with the same bytes
    // get the same underlying cell — matches how source-level string
    // literals dedup, and makes \`===\` over embed-built strings work
    // through the pointer fast path.
    let atom = ctx_intern_atom(ctx, bytes, length);
    return zjs_cell_from_ptr((void*)atom);
}

fn zjs_new_object(ctx: ZjsContext*) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    return ctx_new_object(ctx);
}

fn zjs_new_array(ctx: ZjsContext*, length: u32) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    return ctx_new_array(ctx, length);
}

// --- String inspection -------------------------------------------------

fn zjs_string_bytes(v: ZjsValue, out_length: u32*) -> char* {
    if zjs_is_string(v) == 0 {
        if out_length != NULL { out_length[0] = 0; }
        return NULL;
    }
    let s = zjs_as_string(v);
    if out_length != NULL { out_length[0] = s.length; }
    return s.data;
}

// --- Property access ---------------------------------------------------

fn zjs_get_property(ctx: ZjsContext*, obj: ZjsValue, name: char*) -> ZjsValue {
    if ctx == NULL || name == NULL { return zjs_undefined(); }
    let nlen: usize = 0;
    raw { nlen = strlen(name); }
    // Atom-intern the key. property_set on a fresh non-atom ZjsString
    // stores that string as the hidden class's transition_name; the
    // class walker assumes transition_names are atoms (pinned via the
    // atom-table root), so a non-atom key gets swept on the next GC
    // and leaves cls.transition_name dangling.
    let key_atom = ctx_intern_atom(ctx, name, (u32)nlen);
    let key = zjs_cell_from_ptr((void*)key_atom);
    let r = property_get(ctx, obj, key);
    if ctx.pending_throw_active {
        // Surface the pending throw through the same had_error path
        // as zjs_eval — embedders inspect zjs_had_error after the
        // call to find out.
        ctx.had_error = true;
        ctx.last_error = consume_pending_throw(ctx);
        return zjs_undefined();
    }
    return r;
}

fn zjs_set_property(ctx: ZjsContext*, obj: ZjsValue, name: char*, value: ZjsValue) -> void {
    if ctx == NULL || name == NULL { return; }
    let nlen: usize = 0;
    raw { nlen = strlen(name); }
    // Atom-intern the key — the property store will hand this string
    // to the hidden-class transition, and gc_mark_hidden_class assumes
    // transition_names are atoms (already pinned by the atom-table
    // root walk). A fresh non-atom ZjsString would otherwise get
    // swept on the next GC, leaving cls.transition_name dangling.
    let key_atom = ctx_intern_atom(ctx, name, (u32)nlen);
    let key = zjs_cell_from_ptr((void*)key_atom);
    property_set(ctx, obj, key, value);
    if ctx.pending_throw_active {
        ctx.had_error = true;
        ctx.last_error = consume_pending_throw(ctx);
    }
}

fn zjs_get_element(ctx: ZjsContext*, obj: ZjsValue, index: u32) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    let key = zjs_int32((i32)index);
    let r = property_get(ctx, obj, key);
    if ctx.pending_throw_active {
        ctx.had_error = true;
        ctx.last_error = consume_pending_throw(ctx);
        return zjs_undefined();
    }
    return r;
}

fn zjs_set_element(ctx: ZjsContext*, obj: ZjsValue, index: u32, value: ZjsValue) -> void {
    if ctx == NULL { return; }
    let key = zjs_int32((i32)index);
    property_set(ctx, obj, key, value);
    if ctx.pending_throw_active {
        ctx.had_error = true;
        ctx.last_error = consume_pending_throw(ctx);
    }
}

fn zjs_array_length(v: ZjsValue) -> u32 {
    if zjs_is_array(v) == 0 { return 0; }
    return zjs_as_array(v).length;
}

// --- Globals -----------------------------------------------------------

fn zjs_get_global(ctx: ZjsContext*, name: char*) -> ZjsValue {
    if ctx == NULL || name == NULL { return zjs_undefined(); }
    let nlen: usize = 0;
    raw { nlen = strlen(name); }
    let slot = ctx_find_global(ctx, name, (u32)nlen);
    if slot < 0 { return zjs_undefined(); }
    if !ctx.globals[(u32)slot].defined { return zjs_undefined(); }
    return ctx.globals[(u32)slot].value;
}

fn zjs_set_global(ctx: ZjsContext*, name: char*, value: ZjsValue) -> void {
    if ctx == NULL || name == NULL { return; }
    let nlen: usize = 0;
    raw { nlen = strlen(name); }
    let slot = ctx_intern_global(ctx, name, (u32)nlen);
    ctx.globals[slot].value = value;
    ctx.globals[slot].defined = true;
}

// --- Host functions ----------------------------------------------------

// The C ABI typedef is `ZjsValue (*)(ZjsContext*, ZjsValue*, uint32_t)`.
// We accept it as void* (Zen-c → C the trampoline already casts) and
// route through the internal registrar, which installs the result as a
// global named `name`.
fn zjs_register_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    if ctx == NULL || name == NULL || fn_ptr == NULL { return zjs_undefined(); }
    return ctx_register_host_function(ctx, name, fn_ptr);
}

fn zjs_get_this(ctx: ZjsContext*) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    return ctx.host_this;
}

fn zjs_throw(ctx: ZjsContext*, value: ZjsValue) -> void {
    if ctx == NULL { return; }
    ctx.pending_throw_active = true;
    ctx.pending_throw_value  = value;
}

// --- Call JS from C ----------------------------------------------------

fn zjs_call(ctx: ZjsContext*, callee: ZjsValue, this_val: ZjsValue, argv: ZjsValue*, argc: u32) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    // Mirror zjs_eval's had_error housekeeping so embedders can check
    // zjs_had_error after every call (not just eval).
    ctx.had_error = false;
    ctx.last_error = zjs_undefined();
    let r = zjs_call_value_with_this(ctx, callee, this_val, argv, argc);
    // Pin r across drain_microtasks: each pending .then callback fires
    // an interpret() that may ctx_maybe_gc, and r is otherwise only
    // reachable from this C frame. Without the pin, a microtask drain
    // can reclaim freshly-returned cells before they reach the
    // embedder (manifests as silent dangling-ZjsValue corruption).
    ctx_push_temp_root(ctx, r);
    drain_microtasks(ctx);
    ctx_pop_temp_root(ctx);
    if ctx.pending_throw_active {
        ctx.had_error = true;
        ctx.last_error = consume_pending_throw(ctx);
        return zjs_undefined();
    }
    return r;
}

// --- AOT bytecode --------------------------------------------------

fn zjs_eval_bytecode(ctx: ZjsContext*, data: u8*, len: usize) -> ZjsValue {
    if ctx == NULL || data == NULL || len < 8 { return zjs_undefined(); }
    let f = aot_deserialize_program(ctx, data, len);
    if f == NULL { return zjs_undefined(); }
    return zjs_run_function(ctx, f);
}

fn zjs_compile_to_bytecode(ctx: ZjsContext*, source: char*, out_len: usize*) -> u8* {
    if out_len != NULL { out_len[0] = 0; }
    // Embedders that only load pre-compiled .zbc (the common case —
    // bytecode is produced once at build time by a developer-side
    // tool, then shipped to devices) can opt out of the writer half
    // with -DZJS_NO_AOT_WRITER. The symbol stays in the ABI for
    // backwards-compat; it just returns NULL. Drops ~8-12 KB by
    // letting dead-strip remove aot_write_function + aot_w_* +
    // aot_serialize_program.
    raw {
    #ifdef ZJS_NO_AOT_WRITER
        return NULL;
    #endif
    }
    if ctx == NULL || source == NULL { return NULL; }
    let f = zjs_compile(ctx, source);
    if f == NULL { return NULL; }
    let w = aot_serialize_program(ctx, f);
    function_free(f);
    if w == NULL { return NULL; }
    // Hand the buffer off to the caller. Use plain malloc here so the
    // caller's free() works — the writer's internal buffer was
    // alloc_n<u8>'d via the engine's allocator, which is calloc-backed
    // on the non-MISRA path, so it lines up with free(). Copy to a
    // fresh malloc'd block to keep the contract explicit.
    let n = w.len;
    let out: u8* = NULL;
    raw { out = (uint8_t*)malloc(n); }
    if out == NULL { aot_writer_free(w); return NULL; }
    raw { memcpy(out, w->buf, n); }
    aot_writer_free(w);
    if out_len != NULL { out_len[0] = n; }
    return out;
}
