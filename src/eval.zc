// Top-level evaluation entry — Phase 3.0a.
//
// Lex → parse → compile → interpret → return result. The compiled
// Function is freed after execution; globals live on the context and
// persist across calls.

import "./context.zc";
import "./value.zc";
import "./parser.zc";
import "./bytecode.zc";
import "./compiler.zc";
import "./interpreter.zc";

raw {
    #include <string.h>
}

// Build a synthetic { name: "SyntaxError", message } error object — used
// to surface parse / compile failures as JS-visible throws. test262's
// negative parse tests look for this type.
fn build_syntax_error(ctx: ZjsContext*, msg: char*) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    let name_atom = ctx_intern_atom(ctx, (char*)"name", 4);
    let msg_atom  = ctx_intern_atom(ctx, (char*)"message", 7);
    let name_val_str = ctx_intern_atom(ctx, (char*)"SyntaxError", 11);
    object_set(ctx, obj, name_atom, zjs_cell_from_ptr((void*)name_val_str));
    let msg_len: u32 = 0;
    raw { msg_len = (uint32_t)strlen(msg); }
    let msg_str = ctx_intern_string(ctx, msg, msg_len);
    object_set(ctx, obj, msg_atom, msg_str);
    return obj_v;
}

fn zjs_eval(ctx: ZjsContext*, source: char*) -> ZjsValue {
    if ctx == NULL || source == NULL { return zjs_undefined(); }

    let len: usize = 0;
    raw { len = strlen(source); }

    let parse = parse_program(source, len);
    defer parser_free_result(parse);
    if parse.had_error {
        let err = build_syntax_error(ctx, (char*)"parse error");
        ctx.had_error = true;
        ctx.last_error = err;
        return err;
    }

    let f = compile_program(ctx, source, parse.root);
    if f == NULL {
        let err = build_syntax_error(ctx, (char*)"compile error");
        ctx.had_error = true;
        ctx.last_error = err;
        return err;
    }
    defer function_free(f);

    let r = interpret(ctx, f, NULL, 0);
    if r.is_throw {
        ctx.had_error = true;
        ctx.last_error = r.value;
        return r.value;
    }
    ctx.had_error = false;
    ctx.last_error = zjs_undefined();
    return r.value;
}
