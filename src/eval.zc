// Top-level evaluation entry — Phase 3.0a.
//
// Lex → parse → compile → interpret → return result. The compiled
// Function is freed after execution; globals live on the context and
// persist across calls.

import "./context.zc";
import "./value.zc";
import "./parser.zc";
import "./bytecode.zc";
import "./compiler.zc";
import "./interpreter.zc";

raw {
    #include <string.h>
}

// build_typed_error / build_syntax_error / build_reference_error
// live in context.zc so the interpreter can use them too.

fn zjs_eval(ctx: ZjsContext*, source: char*) -> ZjsValue {
    if ctx == NULL || source == NULL { return zjs_undefined(); }

    let len: usize = 0;
    raw { len = strlen(source); }

    let parse = parse_program(source, len);
    defer parser_free_result(parse);
    if parse.had_error {
        let err = build_syntax_error(ctx, (char*)"parse error");
        ctx.had_error = true;
        ctx.last_error = err;
        return err;
    }

    let f = compile_program(ctx, source, parse.root);
    if f == NULL {
        let err = build_syntax_error(ctx, (char*)"compile error");
        ctx.had_error = true;
        ctx.last_error = err;
        return err;
    }
    defer function_free(f);

    // Bind top-level `this` to the global-object placeholder so
    // tests like `var g = this; g.foo` see globals. interpret()'s
    // call-frame mechanism saves/restores host_this around inner
    // calls; we only need to set it at the top.
    let saved_this = ctx.host_this;
    if ctx.global_this_obj != NULL {
        ctx.host_this = zjs_cell_from_ptr((void*)ctx.global_this_obj);
    }
    let r = interpret(ctx, f, NULL, 0);
    ctx.host_this = saved_this;
    // Phase 3.10 — drain queued microtasks after the script body. Tests
    // that use Promise.resolve(...).then(...) without an explicit
    // async-test harness rely on the next sync turn observing the
    // settled value.
    drain_microtasks(ctx);
    if r.is_throw {
        ctx.had_error = true;
        ctx.last_error = r.value;
        return r.value;
    }
    ctx.had_error = false;
    ctx.last_error = zjs_undefined();
    return r.value;
}

// Compile-only — exposed for the AOT CLI. Returns a fully-initialized
// Function* (caller takes ownership / registers it for GC). Surface
// SyntaxError / had_error on parse or compile failure, same as
// zjs_eval. Does NOT run the function.
fn zjs_compile(ctx: ZjsContext*, source: char*) -> Function* {
    if ctx == NULL || source == NULL { return NULL; }
    let len: usize = 0;
    raw { len = strlen(source); }
    let parse = parse_program(source, len);
    defer parser_free_result(parse);
    if parse.had_error {
        let err = build_syntax_error(ctx, (char*)"parse error");
        ctx.had_error = true;
        ctx.last_error = err;
        return NULL;
    }
    let f = compile_program(ctx, source, parse.root);
    if f == NULL {
        let err = build_syntax_error(ctx, (char*)"compile error");
        ctx.had_error = true;
        ctx.last_error = err;
        return NULL;
    }
    return f;
}

// Run an already-compiled Function* as if it were the top-level
// program. Used by the AOT loader to share zjs_eval's setup (top-level
// `this` rebinding, microtask drain, error reporting).
fn zjs_run_function(ctx: ZjsContext*, f: Function*) -> ZjsValue {
    if ctx == NULL || f == NULL { return zjs_undefined(); }
    let saved_this = ctx.host_this;
    if ctx.global_this_obj != NULL {
        ctx.host_this = zjs_cell_from_ptr((void*)ctx.global_this_obj);
    }
    let r = interpret(ctx, f, NULL, 0);
    ctx.host_this = saved_this;
    drain_microtasks(ctx);
    if r.is_throw {
        ctx.had_error = true;
        ctx.last_error = r.value;
        return r.value;
    }
    ctx.had_error = false;
    ctx.last_error = zjs_undefined();
    return r.value;
}

// Evaluate a file as an ES module. `abs_path` should be an absolute
// filesystem path; the loader caches by it. Returns the module's
// exports object on success; sets ctx.had_error on failure.
fn zjs_eval_module(ctx: ZjsContext*, abs_path: char*) -> ZjsValue {
    if ctx == NULL || abs_path == NULL { return zjs_undefined(); }
    let len: u32 = 0;
    raw { len = (uint32_t)strlen(abs_path); }
    let path_atom = ctx_intern_atom(ctx, abs_path, len);
    let m = ctx_load_module(ctx, path_atom);
    drain_microtasks(ctx);
    if ctx.pending_throw_active {
        ctx.had_error = true;
        ctx.last_error = consume_pending_throw(ctx);
        return ctx.last_error;
    }
    if m == NULL {
        ctx.had_error = true;
        return zjs_undefined();
    }
    if m.state == MODULE_STATE_ERRORED {
        ctx.had_error  = true;
        ctx.last_error = m.error;
        return m.error;
    }
    ctx.had_error = false;
    ctx.last_error = zjs_undefined();
    return zjs_cell_from_ptr((void*)m.exports);
}

// Evaluate an in-memory source buffer as an ES module — useful for
// embedders that bundle worker code (Vite / Rolldown / esbuild) and
// want to skip the disk hop, or for any host generating module
// source on the fly. `virtual_path` is the cache key + base path for
// relative imports inside the source (`import "./sibling"` resolves
// against the directory of `virtual_path`). It does NOT need to point
// at a real file — `/virtual/main.mjs` works fine for a single
// self-contained bundle.
//
// `source_len` is the byte length of `source`; the buffer does NOT
// need to be NUL-terminated. A second call with the same
// `virtual_path` returns the cached exports without re-parsing.
//
// Returns the module's exports object on success. On parse / compile /
// evaluation failure, sets ctx.had_error and returns the thrown value
// (or undefined on truly fatal failures).
fn zjs_eval_module_source(ctx: ZjsContext*, source: char*, source_len: usize, virtual_path: char*) -> ZjsValue {
    if ctx == NULL || source == NULL || virtual_path == NULL { return zjs_undefined(); }
    let path_len: u32 = 0;
    raw { path_len = (uint32_t)strlen(virtual_path); }
    let path_atom = ctx_intern_atom(ctx, virtual_path, path_len);

    // Cache hit on virtual_path: behave like zjs_eval_module — return
    // the cached exports without re-parsing the supplied buffer.
    let cached = module_cache_find(ctx, path_atom);
    if cached != NULL && cached.state == MODULE_STATE_EVALUATED {
        ctx.had_error  = false;
        ctx.last_error = zjs_undefined();
        return zjs_cell_from_ptr((void*)cached.exports);
    }

    // Copy the caller's source into a freshly-allocated NUL-terminated
    // buffer that we retain — Functions hold offsets into the bytes.
    // Calling code with `const char*` doesn't need to keep its copy
    // around after this call returns.
    let src_owned: char* = NULL;
    raw {
        src_owned = (char*)malloc(source_len + 1);
        if (src_owned) {
            memcpy(src_owned, source, source_len);
            src_owned[source_len] = 0;
        }
    }
    if src_owned == NULL {
        ctx.had_error = true;
        return zjs_undefined();
    }

    let m = ctx_eval_module_with_source(ctx, path_atom, src_owned);
    drain_microtasks(ctx);
    if ctx.pending_throw_active {
        ctx.had_error = true;
        ctx.last_error = consume_pending_throw(ctx);
        return ctx.last_error;
    }
    if m == NULL {
        ctx.had_error = true;
        return zjs_undefined();
    }
    if m.state == MODULE_STATE_ERRORED {
        ctx.had_error  = true;
        ctx.last_error = m.error;
        return m.error;
    }
    ctx.had_error  = false;
    ctx.last_error = zjs_undefined();
    return zjs_cell_from_ptr((void*)m.exports);
}
