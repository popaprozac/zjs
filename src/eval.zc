// Top-level evaluation entry — Phase 3.0a.
//
// Lex → parse → compile → interpret → return result. The compiled
// Function is freed after execution; globals live on the context and
// persist across calls.

import "./context.zc";
import "./value.zc";
import "./parser.zc";
import "./bytecode.zc";
import "./compiler.zc";
import "./interpreter.zc";

raw {
    #include <string.h>
}

// build_typed_error / build_syntax_error / build_reference_error
// live in context.zc so the interpreter can use them too.

fn zjs_eval(ctx: ZjsContext*, source: char*) -> ZjsValue {
    if ctx == NULL || source == NULL { return zjs_undefined(); }

    let len: usize = 0;
    raw { len = strlen(source); }

    let parse = parse_program(source, len);
    defer parser_free_result(parse);
    if parse.had_error {
        let err = build_syntax_error(ctx, (char*)"parse error");
        ctx.had_error = true;
        ctx.last_error = err;
        return err;
    }

    let f = compile_program(ctx, source, parse.root);
    if f == NULL {
        let err = build_syntax_error(ctx, (char*)"compile error");
        ctx.had_error = true;
        ctx.last_error = err;
        return err;
    }
    defer function_free(f);

    // Bind top-level `this` to the global-object placeholder so
    // tests like `var g = this; g.foo` see globals. interpret()'s
    // call-frame mechanism saves/restores host_this around inner
    // calls; we only need to set it at the top.
    let saved_this = ctx.host_this;
    if ctx.global_this_obj != NULL {
        ctx.host_this = zjs_cell_from_ptr((void*)ctx.global_this_obj);
    }
    let r = interpret(ctx, f, NULL, 0);
    ctx.host_this = saved_this;
    // Phase 3.10 — drain queued microtasks after the script body. Tests
    // that use Promise.resolve(...).then(...) without an explicit
    // async-test harness rely on the next sync turn observing the
    // settled value.
    drain_microtasks(ctx);
    if r.is_throw {
        ctx.had_error = true;
        ctx.last_error = r.value;
        return r.value;
    }
    ctx.had_error = false;
    ctx.last_error = zjs_undefined();
    return r.value;
}
