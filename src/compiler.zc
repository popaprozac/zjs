// Compiler — walks the AST and emits bytecode into a Function.
//
// Single-function compiler for Phase 3.0a: every program is compiled
// as one top-level "main" function. All declarations land in globals
// on the context. Phase 3.0b will extend this with first-class user
// functions, locals, and a scope chain.

import "./token.zc";
import "./ast.zc";
import "./value.zc";
import "./bytecode.zc";
import "./context.zc";
import "std/mem.zc"
import "std/utf8.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
}

struct Local {
    name_start:  u32;
    name_length: u32;
    reg:         u8;
    captured:    bool;       // true if a nested function captures this local
    // ECMA-262 §13.3 lexical-scoping. `var` declarations hoist to the
    // enclosing function (scope_id 0); `let`/`const`/`class` bind to
    // the block they're declared in. find_local_index filters by the
    // compiler's active scope stack so `{ let e = … }` doesn't shadow
    // an outer `var e` once the block exits.
    scope_id:    u32;
    // Canonical interned name. Stored so identifier lookups in
    // find_local_index reduce to a pointer compare AND so source-text
    // variants of the same identifier (`\u{79}` vs `y`) match — the
    // atom table decodes escapes before deduping.
    name_atom:   ZjsString*;
    // #288: depth of the per-iter env this local lives ON. Loop-locals
    // declared inside a for-of body's `let`/`const` get stored on that
    // body's per-iter env at run-time; their lookup chain from a
    // closure inside the same body needs ZERO extra __outer__ hops
    // (depth=1 lands directly on the per-iter env). Locals declared
    // OUTSIDE the per-iter env get the full set of hops. 0 = lives on
    // the parent's normal env (default for ordinary locals).
    per_iter_depth: u32;
    // #330 TDZ. is_tdz: this is a let/const/default-param binding that
    // must throw ReferenceError if read before its initializer runs.
    // initialized: set true once the binding's initializer has been
    // compiled in straight-line order — reads after that point in the
    // same linear flow skip the ThrowIfHole check (keeps the common
    // `let x = …; use x` path free of overhead).
    is_tdz:        bool;
    initialized:   bool;
}

struct Compiler {
    ctx:           ZjsContext*;
    source:        char*;
    function:      Function*;

    // bytecode buffer (heap-grown)
    code:          Inst*;
    code_count:    usize;
    code_cap:      usize;

    // constant pool (heap-grown)
    constants:     ZjsValue*;
    const_count:   u32;
    const_cap:     u32;

    // simple high-water-mark register allocator
    next_reg:      u8;
    max_reg:       u8;
    fixed_regs:    u8;   // count of regs reserved for params + locals;
                          // expression temps live above this watermark

    // locals (function-scoped — empty at top level)
    locals:        Local*;
    local_count:   u32;
    local_cap:     u32;
    is_function:   bool;
    // 2026-05-16 — true on the program-level compiler when running a
    // *script* (not a module). Forces is_function=true so top-level
    // let/const/class bind to a script-scope lexical environment
    // (registers), but special-cases `var` and FunctionDecl back to
    // the global table so script-mode globalThis semantics survive.
    is_script:     bool;
    // Set by compile_function before walking the body so yield* / await
    // / await-on-implicit-pieces know which protocol to emit. Top-level
    // script/module compilation leaves both at false.
    is_async:      bool;
    is_generator:  bool;

    // 2026-05-16 — perf opt. When set, compile_expr's IdentExpr path
    // may return a local's reg DIRECTLY instead of emitting a
    // defensive `Mov dst, local_reg`. Callers set this only at sites
    // where they can prove the expression's other operands have no
    // side effects that mutate the read local (mostly: NumberExpr /
    // pure-Ident / IdentExpr-local-read on the RHS of an op). Reset
    // by the caller before nested compile_expr calls that might be
    // unsafe.
    borrow_local_ok: bool;

    // 2026-05-16 — hoisted `this` for hot method bodies. When the
    // function body actually references `this`, compile_function
    // emits a single LoadThis at entry into this register and
    // compile_expr's ThisExpr returns it directly afterward. Saves
    // N-1 LoadThis dispatches per call (LoadThis was 15% of
    // method_call's profile). -1 = not allocated.
    this_reg: i32;

    // Hoisted current_closure.env. When this function references outer
    // captures but has no own env (passthrough), each outer-capture
    // access emits a fresh LoadEnv into a temp via emit_env_chain_walk.
    // For closure bodies that read the same outer var multiple times
    // (e.g. `count = count + 1; return count`) that's N LoadEnvs per
    // call. compile_function emits one LoadEnv at prologue into this
    // stable reg; emit_env_chain_walk returns it directly for depth==1.
    // -1 = not allocated.
    cached_outer_env_reg: i32;

    // 2026-05-16 — "preferred destination" hint for compile_expr.
    // When a caller knows where an expression's result should land
    // (e.g. assignment to a local: `i = i + 1`), it sets this to the
    // target reg before the call. The first op in the compiled
    // expression that allocates a dst consumes the hint and writes
    // directly, sparing the trailing Mov. compile_expr clears the
    // hint as it reads it, so nested sub-expressions allocate fresh.
    // -1 = no preference.
    preferred_dst: i32;

    // Closure support (Phase 3.3). `parent` points to the enclosing
    // function's compiler — NULL for the top-level program. The
    // capture pre-scan flips `needs_env` on if any nested function
    // references this function's locals.
    parent:        Compiler*;
    needs_env:     bool;
    env_reg:       u8;
    // Lexical nesting depth of enclosing `with` statements in THIS
    // function. When > 0, IdentExpr reads and assignment targets emit a
    // WithLookup-guarded branch so the with-object(s) shadow normal
    // scope resolution. Zero everywhere else, so non-with code is
    // byte-identical.
    with_depth:    u32;
    // The Call AST node a ReturnStmt is about to tail-rewrite (#394).
    // The tail-call optimizer matches `last emitted op == Op::Invoke`
    // and flips it to TailInvoke IN PLACE — a fused InvokeGlobal there
    // would silently lose TCO (stack overflow on deep tail recursion).
    // ReturnStmt points this at the candidate Call node before
    // compiling it; compile_call skips fusion when `node` matches.
    // Nested calls inside the return expression compare unequal and
    // still fuse.
    tail_call_node: AstNode*;
    // `has_outer_refs` is set on the inner compiler whenever its body
    // references a name resolved in a parent scope. Drives whether
    // the outer needs to wrap the resulting function in MakeClosure.
    has_outer_refs: bool;

    // Count of per-iteration envs currently open inside THIS compiler.
    // compile_for_of_live increments this around the loop body when it
    // emits a per-iter env (need_per_iter_env), then decrements on
    // exit. A closure emitted inside that body inherits the count via
    // the inner compiler's extra_env_hops below — every per-iter env
    // adds one __outer__ hop the closure's chain-walk must traverse.
    per_iter_envs_open: u32;

    // Inherited from `parent.per_iter_envs_open` at closure birth.
    // outer_capture_depth adds this to the computed depth so the
    // chain-walk inside the closure walks past the per-iter env(s) to
    // reach the real outer env. Closes #288 — chalk's for-of-body
    // getter referencing module-scope const was reading undefined
    // because depth-1 lookups landed at the per-iter env instead of
    // the parent's normal env.
    extra_env_hops: u32;

    // result tracking — the register holding the last evaluated
    // expression-statement value (so we can emit Return at the end).
    last_expr_reg: i32;     // -1 if no expression yet

    // Inline-cache slots reserved at compile time (one per LoadProp /
    // StoreProp site). Transferred to Function.ics at the end of
    // compile_program / compile_function.
    ics:           ICEntry*;
    ic_count:      u32;
    ic_cap:        u32;

    had_error:     bool;

    // Phase 3.8g — pending label set by LabeledStmt that hasn't yet
    // been claimed by the next loop's loop_push. 0/0 = none.
    pending_label_start:  u32;
    pending_label_length: u32;

    // Phase 3.9d — stack of finally bodies currently "active" (we're
    // compiling the matching try / catch). A ReturnStmt encountered
    // inside walks this list top-down and inlines each finally body
    // before emitting the actual Return.
    active_finallies:        AstNode**;
    active_finally_count:    u32;
    active_finally_cap:      u32;

    // #326 — depth of enclosing try blocks whose *body* we're currently
    // compiling AND which have a catch handler that would catch a local
    // throw. A `return f()` inside such a body is NOT in tail position
    // (the catch must stay active while f() runs), so the tail-call
    // rewrite must be suppressed. Bumped only around the try-body; the
    // catch body itself runs at the outer level. (finally-bearing trys
    // are already covered by active_finally_count.)
    active_try_count:        u32;

    // Phase 3.8e — implicit `arguments` binding. -1 if the function
    // doesn't reference `arguments` (or it's shadowed by a real
    // local of the same name). Otherwise: the reg holding the
    // arguments array, populated by Op::BuildArguments at fn entry.
    arguments_reg: i32;

    // 2026-05-15 — enclosing class context for super references.
    // Set by compile_class_value before recursing into a method
    // compile (via compile_function's `parent` chain). super() in
    // the method body re-uses this expression to resolve the parent
    // constructor at runtime.
    enclosing_class_parent: AstNode*;
    // 2026-05-20 — enclosing class id for private-name (`#x`) mangling.
    // Set to a fresh integer when entering a class body; copied to
    // child compilers (methods, nested functions) so `this.#x` inside
    // a method sees the lexically enclosing class's id. -1 outside any
    // class body — emitting a `#x` access there is a SyntaxError per
    // spec, enforced via the c.had_error gate.
    enclosing_class_id: i32;

    // 2026-06-01 — true while compiling a class STATIC element (static
    // field initializer or static initialization block) inline in
    // compile_class. In this context `super.x` resolves against the
    // parent CONSTRUCTOR directly (not parent.prototype), per ECMA-262
    // §13.3.7 (GetSuperBase uses the [[HomeObject]], which for static
    // elements is the class constructor whose proto is the superclass).
    in_static_element: bool;

    // ECMA-262 strict mode for the function/program being compiled.
    // Inherited from the parent compiler (lexical nesting), forced on
    // for class elements (MethodDef) and modules, or set by a "use
    // strict" prologue. Copied to Function.strict for runtime use.
    strict: bool;

    // Previous head of ctx.active_compiler when this Compiler was
    // pushed via compiler_new — restored on compiler_free. Forms a
    // singly-linked stack that GC walks during mark so mid-compile
    // constants / IC names survive a sweep triggered by allocations
    // in a later sibling's compile. void* to keep the cycle between
    // Compiler and ZjsContext loose.
    outer_compiler: void*;

    // 2026-05-16 — destructure_pattern mode flag. False = binding
    // (let/const/var/param/catch); true = assignment (`[a, b] = src`).
    // Binding mode assigns to a freshly-declared local/global; assign
    // mode goes through the normal assignment-target lookup chain so
    // arbitrary LHSExpressions (Member, Computed) work.
    in_dstr_assign: bool;

    // Tagged-template sites (ECMA-262 §13.2.8.4 GetTemplateObject).
    // Collected during compile; flushed into the Function struct at
    // function-end so each site can lazy-cache its strings array.
    // Flat layout: cooked[0..tmpl_seg_count) holds the cooked strings
    // for every site concatenated; raw[] is parallel. seg_start[i]
    // tells where site i's segments begin; site i has segments
    // [seg_start[i], seg_start[i+1]).
    tmpl_cooked:        ZjsString**;
    tmpl_raw:           ZjsString**;
    tmpl_seg_count:     u32;
    tmpl_seg_cap:       u32;
    tmpl_seg_start:     u32*;
    tmpl_site_count:    u32;
    tmpl_site_cap:      u32;

    // Phase 3.8a — loop context stack for break / continue.
    // Pushed on entry to a loop, popped on exit. `continue_target` is
    // the bytecode offset to jump to on `continue` (loop test for
    // while; update step for for; loop top for for-in/of). Pending
    // `break` sites stay in break_patches[] until the loop body ends.
    loop_depth:    u32;
    loop_stack:    LoopFrame*;
    loop_cap:      u32;

    // ECMA-262 lexical scope tracker. scope_stack holds the IDs of all
    // currently-active scopes (innermost on top). cur_scope_id mirrors
    // the top of stack so the common path (add_local) is one field
    // load instead of an indirection. next_scope_id is monotonically
    // incremented as new blocks are entered; both the collect_locals
    // pre-pass and compile_stmt walk the AST in the same order so the
    // IDs they assign to each block match. scope 0 is the function-top
    // scope (always present on the stack); `var` declarations always
    // bind here regardless of where they're textually written.
    scope_stack:   u32*;
    scope_top:     u32;
    scope_cap:     u32;
    cur_scope_id:  u32;
    next_scope_id: u32;
}

struct LoopFrame {
    continue_target: u32;        // bytecode offset for `continue` to jump to
    have_continue:   bool;       // false until set; if false, continue emits a placeholder + patch
    break_patches:   u32*;
    break_count:     u32;
    break_cap:       u32;
    continue_patches: u32*;      // placeholders awaiting target resolution
    continue_count:  u32;
    continue_cap:    u32;
    // Phase 3.8g — optional label name (start/length point into c.source).
    // Set by LabeledStmt → loop_push pickup. break/continue with a
    // matching label walk the stack to find this frame.
    label_start:     u32;
    label_length:    u32;
    // Phase 3.9d — depth of c.active_finallies when this loop was
    // pushed. Break/continue targeting this frame must inline every
    // finally body above this depth before jumping.
    finally_depth_at_entry: u32;
    // Phase 4.8 — distinguishes real iteration loops from switch frames
    // (which only push to receive `break` patches). `continue` walks
    // past non-iter frames so `continue` inside a switch jumps to the
    // enclosing for/while update, not into nothing. Default true; set
    // to false when pushing a switch frame.
    is_iter: bool;
}

// --- Lifecycle ------------------------------------------------------

fn compiler_new(ctx: ZjsContext*, source: char*) -> Compiler* {
    let c = alloc<Compiler>();
    c.ctx = ctx;
    c.source = source;
    c.last_expr_reg = -1;
    c.active_try_count = 0;
    c.with_depth = 0;
    c.tail_call_node = NULL;
    c.arguments_reg = -1;
    c.this_reg = -1;
    c.cached_outer_env_reg = -1;
    c.preferred_dst = -1;
    c.enclosing_class_id = -1;
    c.in_static_element = false;
    c.strict = false;
    // Scope tracker — start with the function-top scope (id 0) on the
    // stack. New scopes get unique ids from next_scope_id; the field is
    // reset between the collect_locals and compile_stmt passes so both
    // assign the same ids to the same syntactic blocks.
    c.scope_stack = alloc_n<u32>(8);
    c.scope_cap = 8;
    c.scope_top = 1;
    c.scope_stack[0] = 0;
    c.cur_scope_id = 0;
    c.next_scope_id = 1;
    // Push onto the ctx-wide active-compiler stack so GC sees this
    // compiler's mid-flight constants + ICs as roots.
    c.outer_compiler = ctx.active_compiler;
    raw { ctx->active_compiler = (void*)c; }
    return c;
}

// Walk the active compiler chain and mark every ZjsValue still
// holding inner-Function / interned-string references that haven't
// been handed off to a finalized Function*'s constants array yet.
// Called from gc_mark_roots.
fn compiler_mark_chain(ctx: ZjsContext*) -> void {
    let cur: Compiler* = NULL;
    raw { cur = (Compiler*)ctx->active_compiler; }
    while cur != NULL {
        let i: u32 = 0;
        while i < cur.const_count {
            gc_mark_value(cur.constants[i]);
            i = i + 1;
        }
        let j: u32 = 0;
        while j < cur.ic_count {
            if cur.ics[j].name != NULL {
                gc_mark_value(zjs_cell_from_ptr((void*)cur.ics[j].name));
            }
            j = j + 1;
        }
        // Template-literal cooked / raw segments collected mid-compile
        // also need to survive until the parent Function adopts them.
        let t: u32 = 0;
        while t < cur.tmpl_seg_count {
            if cur.tmpl_cooked != NULL && cur.tmpl_cooked[t] != NULL {
                gc_mark_value(zjs_cell_from_ptr((void*)cur.tmpl_cooked[t]));
            }
            if cur.tmpl_raw != NULL && cur.tmpl_raw[t] != NULL {
                gc_mark_value(zjs_cell_from_ptr((void*)cur.tmpl_raw[t]));
            }
            t = t + 1;
        }
        raw { cur = (Compiler*)cur->outer_compiler; }
    }
}

fn finally_push(c: Compiler*, body: AstNode*) -> void {
    if c.active_finally_count >= c.active_finally_cap {
        let new_cap: u32 = if c.active_finally_cap == 0 { 4 } else { c.active_finally_cap * 2 };
        c.active_finallies = realloc_n<AstNode*>(c.active_finallies, (usize)c.active_finally_cap, (usize)new_cap);
        c.active_finally_cap = new_cap;
    }
    c.active_finallies[c.active_finally_count] = body;
    c.active_finally_count = c.active_finally_count + 1;
}

fn finally_pop(c: Compiler*) -> void {
    if c.active_finally_count > 0 {
        c.active_finally_count = c.active_finally_count - 1;
    }
}

fn loop_push(c: Compiler*) -> void {
    if c.loop_depth >= c.loop_cap {
        let new_cap: u32 = if c.loop_cap == 0 { 4 } else { c.loop_cap * 2 };
        c.loop_stack = realloc_n<LoopFrame>(c.loop_stack, (usize)c.loop_cap, (usize)new_cap);
        c.loop_cap = new_cap;
    }
    c.loop_stack[c.loop_depth].continue_target = 0;
    c.loop_stack[c.loop_depth].have_continue   = false;
    c.loop_stack[c.loop_depth].break_patches   = NULL;
    c.loop_stack[c.loop_depth].break_count     = 0;
    c.loop_stack[c.loop_depth].break_cap       = 0;
    c.loop_stack[c.loop_depth].continue_patches = NULL;
    c.loop_stack[c.loop_depth].continue_count   = 0;
    c.loop_stack[c.loop_depth].continue_cap     = 0;
    // Pick up a pending label from a preceding LabeledStmt, then clear it
    // so the next loop in the same scope starts unlabeled.
    c.loop_stack[c.loop_depth].label_start  = c.pending_label_start;
    c.loop_stack[c.loop_depth].label_length = c.pending_label_length;
    c.pending_label_start  = 0;
    c.pending_label_length = 0;
    // Phase 3.9d — snapshot the active-finally depth so break/continue
    // can inline only the finallies above this point.
    c.loop_stack[c.loop_depth].finally_depth_at_entry = c.active_finally_count;
    // Default to "real iteration loop" so existing call sites (for/
    // while/do/for-of/for-in) work unchanged; switch flips to false
    // right after loop_push.
    c.loop_stack[c.loop_depth].is_iter = true;
    c.loop_depth = c.loop_depth + 1;
}

// Inline every finally body whose nesting is above `min_depth`,
// top-down. Used by break/continue to run finallies that sit between
// the current compile point and the target loop frame, and by Return
// when exiting the whole function. Caller is responsible for any
// reg-protection bookkeeping around the call.
fn inline_finallies_above(c: Compiler*, min_depth: u32) -> void {
    if c.active_finally_count <= min_depth { return; }
    let saved_stack = c.active_finallies;
    let saved_count = c.active_finally_count;
    // Temporarily empty the stack so a Return inside a finally body
    // doesn't try to re-inline it.
    c.active_finally_count = min_depth;
    let i = saved_count;
    while i > min_depth {
        i = i - 1;
        if saved_stack[i] != NULL {
            // KNOWN IMPRECISION: the body compiles under the inline
            // SITE's scope stack, so a name the finally uses that a
            // block between the try and the site shadows resolves to
            // the shadow, not the finally's lexical binding. Fixing
            // this needs a lexical-stack snapshot here PLUS shadow-
            // aware capture marking in scan_inner_for_captures (its
            // name-based gate misses outer captures once any same-
            // named local exists in the function) — see task #382.
            compile_stmt(c, saved_stack[i]);
        }
    }
    c.active_finallies = saved_stack;
    c.active_finally_count = saved_count;
}

// Walk the loop stack top-down looking for a frame whose label
// matches the given (name, length). Returns the frame index, or -1.
fn find_labeled_loop(c: Compiler*, name: char*, name_len: u32) -> i32 {
    if c.loop_depth == 0 { return -1; }
    let i: i32 = (i32)c.loop_depth - 1;
    while i >= 0 {
        let fr = c.loop_stack[(u32)i];
        if fr.label_length == name_len && name_len > 0 {
            let lp = c.source + fr.label_start;
            let eq: int = 0;
            raw { eq = (memcmp(lp, name, name_len) == 0) ? 1 : 0; }
            if eq != 0 { return i; }
        }
        i = i - 1;
    }
    return -1;
}

// Set / publish the continue target. Once called any further
// ContinueStmt can emit a direct back-edge; previously-queued
// placeholders are patched immediately.
fn loop_set_continue(c: Compiler*, target: u32) -> void {
    if c.loop_depth == 0 { return; }
    let lp = &c.loop_stack[c.loop_depth - 1];
    lp.continue_target = target;
    lp.have_continue = true;
    // Patch any continue placeholders that were emitted before the
    // target was known (typical for ForStmt: continue jumps target the
    // update step which is positioned AFTER the body).
    let i: u32 = 0;
    while i < lp.continue_count {
        patch_jump(c, lp.continue_patches[i]);
        i = i + 1;
    }
}

fn loop_add_break_to(c: Compiler*, frame_idx: u32, jmp_idx: u32) -> void {
    let lp = &c.loop_stack[frame_idx];
    if lp.break_count >= lp.break_cap {
        let new_cap: u32 = if lp.break_cap == 0 { 4 } else { lp.break_cap * 2 };
        lp.break_patches = realloc_n<u32>(lp.break_patches, (usize)lp.break_cap, (usize)new_cap);
        lp.break_cap = new_cap;
    }
    lp.break_patches[lp.break_count] = jmp_idx;
    lp.break_count = lp.break_count + 1;
}

fn loop_add_break(c: Compiler*, jmp_idx: u32) -> void {
    if c.loop_depth == 0 { return; }
    loop_add_break_to(c, c.loop_depth - 1, jmp_idx);
}

fn loop_add_continue_patch_to(c: Compiler*, frame_idx: u32, jmp_idx: u32) -> void {
    let lp = &c.loop_stack[frame_idx];
    if lp.continue_count >= lp.continue_cap {
        let new_cap: u32 = if lp.continue_cap == 0 { 4 } else { lp.continue_cap * 2 };
        lp.continue_patches = realloc_n<u32>(lp.continue_patches, (usize)lp.continue_cap, (usize)new_cap);
        lp.continue_cap = new_cap;
    }
    lp.continue_patches[lp.continue_count] = jmp_idx;
    lp.continue_count = lp.continue_count + 1;
}

fn loop_add_continue_patch(c: Compiler*, jmp_idx: u32) -> void {
    if c.loop_depth == 0 { return; }
    loop_add_continue_patch_to(c, c.loop_depth - 1, jmp_idx);
}

fn loop_pop(c: Compiler*) -> void {
    if c.loop_depth == 0 { return; }
    c.loop_depth = c.loop_depth - 1;
    dealloc(c.loop_stack[c.loop_depth].break_patches);
    dealloc(c.loop_stack[c.loop_depth].continue_patches);
}

fn compiler_free(c: Compiler*) -> void {
    if c == NULL { return; }
    // Pop ourselves off the ctx active-compiler stack. We can only
    // be at the head — compile_function is recursive, not interleaved —
    // but we tolerate not-at-head by walking and unlinking to keep
    // teardown ordering issues from cascading.
    let head: Compiler* = NULL;
    raw { head = (Compiler*)c->ctx->active_compiler; }
    if head == c {
        raw { c->ctx->active_compiler = c->outer_compiler; }
    } else if head != NULL {
        // Defensive: splice c out of the chain.
        let prev = head;
        let cur: Compiler* = NULL;
        raw { cur = (Compiler*)prev->outer_compiler; }
        while cur != NULL && cur != c {
            prev = cur;
            raw { cur = (Compiler*)prev->outer_compiler; }
        }
        if cur == c {
            raw { prev->outer_compiler = c->outer_compiler; }
        }
    }
    dealloc(c.code);
    dealloc(c.constants);
    dealloc(c.loop_stack);
    dealloc(c.active_finallies);
    dealloc(c.locals);
    dealloc(c.ics);
    dealloc(c.scope_stack);
    dealloc(c);
}

// Allocate a fresh IC slot for the current function. Initializes name
// and leaves class_/slot at zero (cold cache; first execution warms it).
fn alloc_ic_slot(c: Compiler*, name: ZjsString*) -> u32 {
    // Dedupe by atom-pointer: multiple call sites that look up the same
    // name share an IC entry. Each entry is already polymorphic up to
    // IC_POLY_SIZE=4 classes (megamorphic past that), so collapsing
    // unrelated sites onto one slot is a no-op for correctness and a
    // big win for slot count — large Vite bundles routinely look up
    // names like "prototype" / "exports" / "length" dozens of times
    // and previously chewed through the 256-slot u8 encoding budget.
    let i: u32 = 0;
    while i < c.ic_count {
        if c.ics[i].name == name { return i; }
        i = i + 1;
    }
    if c.ic_count >= c.ic_cap {
        let new_cap: u32 = if c.ic_cap == 0 { 8 } else { c.ic_cap * 2 };
        c.ics = realloc_n<ICEntry>(c.ics, (usize)c.ic_cap, (usize)new_cap);
        c.ic_cap = new_cap;
    }
    let idx = c.ic_count;
    c.ics[idx].name = name;
    // Cold cache: all polymorphic slots empty. entry_count == 0 makes
    // the fast path skip the probe loop on first execution.
    let k: u32 = 0;
    while k < IC_POLY_SIZE {
        c.ics[idx].classes[k] = NULL;
        c.ics[idx].slots[k] = 0;
        k = k + 1;
    }
    c.ics[idx].entry_count = 0;
    c.ics[idx].megamorphic = false;
    c.ic_count = c.ic_count + 1;
    return idx;
}

// --- Locals ---------------------------------------------------------

// When the count of declared locals would push c.next_reg past this
// watermark, additional locals env-spill: they go on the closure env
// (captured=true) instead of consuming a register slot. Leaves
// headroom (255 - threshold) above the spill point for expression
// temps inside the body. Triggers in practice on lodash's UMD IIFE
// (237 fixed-locals); ordinary code never reaches it.
//
// Reads/writes of spilled locals go through emit_load_prop_atom /
// emit_store_prop_atom on c.env_reg — the same path captured locals
// use, so the rest of the compiler doesn't need to know about the
// spill mechanism. The cost is one map lookup per access, paid only
// for the function bodies that exceed the watermark.
def LOCAL_SPILL_THRESHOLD: u32 = 192;

// Combined alloc-and-register helper. If we'd cross the spill
// watermark, mark the local as env-captured instead of consuming a
// register. Returns the register (0 when spilled — meaningless to
// the caller since spilled access goes through env).
fn alloc_and_add_local_scoped(c: Compiler*, name_start: u32, name_length: u32, scope_id: u32) -> u8 {
    let spilled = (u32)c.next_reg >= LOCAL_SPILL_THRESHOLD;
    let reg: u8 = 0;
    if !spilled {
        reg = alloc_reg(c);
    } else {
        c.needs_env = true;
    }
    add_local_scoped(c, name_start, name_length, reg, scope_id);
    if spilled {
        c.locals[c.local_count - 1].captured = true;
    }
    return reg;
}

fn alloc_and_add_local(c: Compiler*, name_start: u32, name_length: u32) -> u8 {
    return alloc_and_add_local_scoped(c, name_start, name_length, c.cur_scope_id);
}

fn add_local_scoped(c: Compiler*, name_start: u32, name_length: u32, reg: u8, scope_id: u32) -> void {
    if c.local_count >= c.local_cap {
        let new_cap: u32 = if c.local_cap == 0 { 8 } else { c.local_cap * 2 };
        c.locals = realloc_n<Local>(c.locals, (usize)c.local_cap, (usize)new_cap);
        c.local_cap = new_cap;
    }
    let atom: ZjsString* = NULL;
    if name_length > 0 {
        atom = ctx_intern_atom(c.ctx, c.source + name_start, name_length);
    }
    c.locals[c.local_count] = Local{
        name_start:  name_start,
        name_length: name_length,
        reg:         reg,
        captured:    false,
        scope_id:    scope_id,
        name_atom:   atom,
        // #288: snapshot the count of per-iter envs that are currently
        // open. If this local ends up captured, the per-iter env it
        // lives on is exactly per_iter_depth levels deep from the
        // function's natural env; outer_capture_depth uses this to
        // skip the hop-correction for loop-vars.
        per_iter_depth: c.per_iter_envs_open,
    };
    c.local_count = c.local_count + 1;
}

fn add_local(c: Compiler*, name_start: u32, name_length: u32, reg: u8) -> void {
    add_local_scoped(c, name_start, name_length, reg, c.cur_scope_id);
}

// Enter a new lexical block. Pushes a fresh scope id onto the stack;
// subsequent `let`/`const`/`class` declarations bind here. `var` and
// function-hoisted declarations bypass this and bind at scope 0.
fn enter_scope(c: Compiler*) -> void {
    if c.scope_top >= c.scope_cap {
        let new_cap: u32 = if c.scope_cap == 0 { 8 } else { c.scope_cap * 2 };
        c.scope_stack = realloc_n<u32>(c.scope_stack, (usize)c.scope_cap, (usize)new_cap);
        c.scope_cap = new_cap;
    }
    let new_id = c.next_scope_id;
    c.next_scope_id = c.next_scope_id + 1;
    c.scope_stack[c.scope_top] = new_id;
    c.scope_top = c.scope_top + 1;
    c.cur_scope_id = new_id;
}

fn exit_scope(c: Compiler*) -> void {
    if c.scope_top > 1 {
        c.scope_top = c.scope_top - 1;
        c.cur_scope_id = c.scope_stack[c.scope_top - 1];
    }
}

// Collect-pass scope entry: issue a fresh id AND record it on the AST
// node. Later walks (analyze_captures, compile_stmt) — and every
// RE-compile of the same node (finally bodies inlined at break /
// continue / return sites) — re-enter via enter_scope_reuse, so all
// walks see identical ids by construction instead of relying on
// fragile lockstep counter re-issue (which silently diverged when one
// pass skipped a construct the other visited, or when a body compiled
// more than once: tasks #380/#381).
fn enter_scope_assign(c: Compiler*, node: AstNode*) -> void {
    enter_scope(c);
    if node != NULL { node.scope_id = c.cur_scope_id; }
}

// Re-enter the scope id assigned at collect time. Falls back to a
// fresh id for nodes the collect pass never reached — next_scope_id
// stays monotonic across passes (see reset_scope_walk), so a fallback
// id can never collide with a stored one.
fn enter_scope_reuse(c: Compiler*, node: AstNode*) -> void {
    if node == NULL || node.scope_id == 0 { enter_scope(c); return; }
    if c.scope_top >= c.scope_cap {
        let new_cap: u32 = if c.scope_cap == 0 { 8 } else { c.scope_cap * 2 };
        c.scope_stack = realloc_n<u32>(c.scope_stack, (usize)c.scope_cap, (usize)new_cap);
        c.scope_cap = new_cap;
    }
    c.scope_stack[c.scope_top] = node.scope_id;
    c.scope_top = c.scope_top + 1;
    c.cur_scope_id = node.scope_id;
}

// Reset the scope STACK before re-walking the AST. Ids themselves are
// assigned once by collect_locals (stored on the nodes) and re-entered
// by id in later walks; next_scope_id deliberately stays monotonic so
// any fresh id issued after the reset (enter_scope_reuse fallback)
// can't collide with a collect-assigned id.
fn reset_scope_walk(c: Compiler*) -> void {
    c.scope_top = 1;
    c.scope_stack[0] = 0;
    c.cur_scope_id = 0;
}

// True if `scope_id` is currently visible — i.e. somewhere on the active
// scope stack. O(depth); typically 1-3.
fn scope_id_is_active(c: Compiler*, scope_id: u32) -> bool {
    let i: u32 = 0;
    while i < c.scope_top {
        if c.scope_stack[i] == scope_id { return true; }
        i = i + 1;
    }
    return false;
}

// Returns the index in c.locals (so callers can flip the captured flag).
// -1 if not found. Walks top-down so a more recently added binding
// (e.g. a nested catch parameter) wins over an earlier one with the
// same name. Skips entries whose scope is no longer active — that's
// how block-scoped `let` stops shadowing the enclosing `var` once the
// block exits. Compares by canonical atom pointer (set at add_local
// time via the escape-decoding atom table) so `let \u{79} = 1; y`
// resolves correctly.
fn find_local_index(c: Compiler*, name: char*, name_len: u32) -> i32 {
    if c.local_count == 0 { return -1; }
    let lookup_atom = ctx_intern_atom(c.ctx, name, name_len);
    let i: i32 = (i32)c.local_count - 1;
    while i >= 0 {
        let idx = (u32)i;
        if c.locals[idx].name_atom == lookup_atom
           && scope_id_is_active(c, c.locals[idx].scope_id) {
            return (i32)idx;
        }
        i = i - 1;
    }
    return -1;
}

fn local_is_captured_index(c: Compiler*, idx: i32) -> bool {
    if idx < 0 { return false; }
    return c.locals[(u32)idx].captured;
}

// Returns the local's register, or -1 if not found. Walks top-down
// so a more recently added binding (e.g. a nested catch parameter)
// shadows an outer one with the same name. Out-of-scope entries are
// skipped (same rationale as find_local_index).
fn lookup_local(c: Compiler*, name: char*, name_len: u32) -> i32 {
    if c.local_count == 0 { return -1; }
    let lookup_atom = ctx_intern_atom(c.ctx, name, name_len);
    let i: i32 = (i32)c.local_count - 1;
    while i >= 0 {
        let idx = (u32)i;
        if c.locals[idx].name_atom == lookup_atom
           && scope_id_is_active(c, c.locals[idx].scope_id) {
            return (i32)c.locals[idx].reg;
        }
        i = i - 1;
    }
    return -1;
}

// --- Emission helpers -----------------------------------------------

fn emit(c: Compiler*, inst: Inst) -> u32 {
    if c.code_count >= c.code_cap {
        let new_cap: usize = if c.code_cap == 0 { 64 } else { c.code_cap * 2 };
        c.code = realloc_n<Inst>(c.code, c.code_cap, new_cap);
        c.code_cap = new_cap;
    }
    c.code[c.code_count] = inst;
    let idx = (u32)c.code_count;
    c.code_count = c.code_count + 1;
    return idx;
}

// Add a value to the constant pool; returns its index. No deduping yet.
fn add_const(c: Compiler*, v: ZjsValue) -> u16 {
    if c.const_count >= c.const_cap {
        let new_cap: u32 = if c.const_cap == 0 { 8 } else { c.const_cap * 2 };
        c.constants = realloc_n<ZjsValue>(c.constants, (usize)c.const_cap, (usize)new_cap);
        c.const_cap = new_cap;
    }
    let idx = c.const_count;
    c.constants[idx] = v;
    c.const_count = c.const_count + 1;
    return (u16)idx;
}

// --- Register allocator (high-water-mark) ---------------------------

fn alloc_reg(c: Compiler*) -> u8 {
    let r = c.next_reg;
    if c.next_reg == 255 {
        // Bytecode instruction format addresses registers as u8 (Inst
        // { op, a, b, c }). 256 wraps silently and corrupts everything
        // downstream — we'd emit ops reading/writing the wrong slots.
        // Surface as a hard compile error so the runtime sees NULL
        // Function and reports cleanly. Triggered today by lodash's
        // IIFE (237 fixed-locals + temps blow the limit). Real fix is
        // widening regs to u16 or spilling overflowing locals into the
        // closure env; both are non-trivial.
        if !c.had_error {
            raw { fprintf(stderr, "[zjs] compile error: function exceeds 255-register limit (locals=%u, max=%u). The bytecode instruction format uses u8 register operands — widen-to-u16 or env-spill is required to handle this source.\n", (unsigned)c->fixed_regs, (unsigned)c->max_reg); }
        }
        c.had_error = true;
    }
    c.next_reg = c.next_reg + 1;
    if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
    return r;
}

// Returns the caller-preferred dst register if one is queued, else
// a freshly-allocated temp. Always clears the hint so nested
// sub-expressions allocate their own scratch space.
fn alloc_dst(c: Compiler*) -> u8 {
    if c.preferred_dst >= 0 {
        let r = (u8)c.preferred_dst;
        c.preferred_dst = -1;
        return r;
    }
    return alloc_reg(c);
}

// Quick predicate for "this subtree has no observable writes /
// calls / coercions that could mutate a sibling local". Conservative
// — used to gate borrow_local_ok in compile_expr.
fn expr_is_simple_pure(n: AstNode*) -> bool {
    if n == NULL { return true; }
    let k = n.kind;
    if k == NodeKind::NumberExpr    { return true; }
    if k == NodeKind::StringExpr    { return true; }
    if k == NodeKind::BoolExpr      { return true; }
    if k == NodeKind::NullExpr      { return true; }
    if k == NodeKind::UndefinedExpr { return true; }
    if k == NodeKind::ThisExpr      { return true; }
    if k == NodeKind::IdentExpr     { return true; }
    if k == NodeKind::Member        { return expr_is_simple_pure(n.left); }
    return false;
}

// Walk the leftmost spine of a member/call expression looking for a
// `?.` operation. Paren / Identifier / anything else terminates the
// chain. Returns true iff at least one Optional* node is present, in
// which case the WHOLE expression must compile as a short-circuit
// unit (per ECMA-262 §13.3.9 ChainExpression).
fn expr_chain_has_optional(n: AstNode*) -> bool {
    let cur = n;
    while cur != NULL {
        let k = cur.kind;
        if k == NodeKind::OptionalMember
           || k == NodeKind::OptionalComputed
           || k == NodeKind::OptionalCall {
            return true;
        }
        if k == NodeKind::Member
           || k == NodeKind::Computed
           || k == NodeKind::Call {
            cur = cur.left;
            continue;
        }
        return false;
    }
    return false;
}

fn release_reg(c: Compiler*, r: u8) -> void {
    // High-water-mark allocator: only release if it's the top register
    // AND it's a temp (above fixed_regs). The second guard matters for
    // the Mov-elision fast path — compile_expr may hand back a local's
    // reg directly; releasing that reg would shrink next_reg into the
    // locals area and let the next alloc clobber the local.
    if r + 1 == c.next_reg && r >= c.fixed_regs { c.next_reg = c.next_reg - 1; }
}

fn reset_temps(c: Compiler*) -> void {
    c.next_reg = c.fixed_regs;
}

// --- Patching jumps -------------------------------------------------
//
// Forward jumps emit a placeholder offset (0) and remember the
// instruction index so we can fix the offset once the target is known.

fn is_fused_branch_op(op: Op) -> bool {
    if op == Op::JmpIfNotLt  || op == Op::JmpIfNotLe
    || op == Op::JmpIfNotGt  || op == Op::JmpIfNotGe
    || op == Op::JmpIfNotLtImm || op == Op::JmpIfNotLeImm
    || op == Op::JmpIfNotGtImm || op == Op::JmpIfNotGeImm
    || op == Op::JmpIfNotEq   || op == Op::JmpIfNotNe
    || op == Op::JmpIfNotStrictEq || op == Op::JmpIfNotStrictNe
    || op == Op::JmpIfLt  || op == Op::JmpIfLe
    || op == Op::JmpIfGt  || op == Op::JmpIfGe
    || op == Op::JmpIfLtImm || op == Op::JmpIfLeImm
    || op == Op::JmpIfGtImm || op == Op::JmpIfGeImm {
        return true;
    }
    return false;
}

fn patch_jump(c: Compiler*, jmp_idx: u32) -> void {
    // Offset is target - (jmp_idx + 1) — we set the offset relative to
    // the instruction *after* the jump, since the interpreter increments
    // ip after each instruction and *then* adds the offset.
    let here: i32 = (i32)c.code_count;
    let inst = c.code[jmp_idx];
    if is_fused_branch_op(inst.op) {
        // 2-inst sequence: operands in inst[J], offset in inst[J+1].bc.
        // The runtime applies the offset relative to inst[J+2].
        let off2: i32 = here - ((i32)jmp_idx + 2);
        let p = c.code[jmp_idx + 1];
        c.code[jmp_idx + 1] = make_inst_i16(p.op, off2);
        return;
    }
    let from: i32 = (i32)jmp_idx + 1;
    let off: i32 = here - from;
    let patched: Inst = make_inst_a_i16(inst.op, inst.a, off);
    c.code[jmp_idx] = patched;
}

// Try to fuse a comparison condition into a single compare-and-branch
// dispatch (Cmp + JmpIfFalse → JmpIfNot*). Two-inst encoding: emits
// the fused op followed by a placeholder for the offset (patch_jump
// fills it in later). Returns the index of the fused op so the caller
// can patch via patch_jump(c, idx). Returns -1 when the cond isn't a
// simple <, <=, >, >= comparison; caller falls back to the normal
// compile_expr + Op::JmpIfFalse path.
fn try_emit_cmp_branch_if_false(c: Compiler*, cond: AstNode*) -> i32 {
    if cond == NULL || cond.kind != NodeKind::Binary { return -1; }
    let op_kind = binary_op(cond.op);
    let is_relational: bool = op_kind == Op::CmpLt || op_kind == Op::CmpLe
                            || op_kind == Op::CmpGt || op_kind == Op::CmpGe;
    let is_equality:   bool = op_kind == Op::CmpEq || op_kind == Op::CmpNe
                            || op_kind == Op::CmpStrictEq || op_kind == Op::CmpStrictNe;
    if !is_relational && !is_equality {
        return -1;
    }
    // Nullish peephole: `x == null`, `x != null`, `x == undefined`,
    // `x != undefined` (and operand-swapped variants). Loose-equality
    // against null literally checks nullishness (§7.2.13: null == undefined).
    // Emits JmpIfNullish / JmpIfNotNullish on the non-literal operand —
    // eliminates the LoadNull/LoadUndefined dispatch from the pair.
    if op_kind == Op::CmpEq || op_kind == Op::CmpNe {
        let l_is_nullish_lit: bool = cond.left != NULL
            && (cond.left.kind == NodeKind::NullExpr
             || cond.left.kind == NodeKind::UndefinedExpr);
        let r_is_nullish_lit: bool = cond.right != NULL
            && (cond.right.kind == NodeKind::NullExpr
             || cond.right.kind == NodeKind::UndefinedExpr);
        if l_is_nullish_lit || r_is_nullish_lit {
            let target = if r_is_nullish_lit { cond.left } else { cond.right };
            // Borrow safe — the target is the only thing read.
            let saved_borrow = c.borrow_local_ok;
            c.borrow_local_ok = true;
            let src = compile_expr(c, target);
            c.borrow_local_ok = saved_borrow;
            // For `x == null` / `null == x` we want to run the body
            // when x IS nullish, so JmpIfNotNullish jumps to else when
            // x is NOT nullish.
            let fused_op = if op_kind == Op::CmpEq { Op::JmpIfNotNullish }
                                                  else { Op::JmpIfNullish };
            let idx = emit(c, make_inst_a_i16(fused_op, src, 0));
            release_reg(c, src);
            return (i32)idx;
        }
    }
    // RHS small-int literal fast path: fused JmpIfNot*Imm. Only the
    // relational variants have *Imm encodings — equality with a small
    // int still goes through the reg-reg form.
    if is_relational && cond.right != NULL && cond.right.kind == NodeKind::NumberExpr {
        let v = cond.right.num;
        let iv = (i32)v;
        let is_int: bool = false;
        raw { is_int = ((double)iv == v) ? true : false; }
        if is_int && iv >= -128 && iv <= 127 {
            // RHS is a literal — LHS is safe to borrow.
            let saved_borrow_a = c.borrow_local_ok;
            c.borrow_local_ok = true;
            let src = compile_expr(c, cond.left);
            c.borrow_local_ok = saved_borrow_a;
            let imm_byte: u8 = (u8)(i8)iv;
            let fused_op = Op::Halt;
            if      op_kind == Op::CmpLt { fused_op = Op::JmpIfNotLtImm; }
            else if op_kind == Op::CmpLe { fused_op = Op::JmpIfNotLeImm; }
            else if op_kind == Op::CmpGt { fused_op = Op::JmpIfNotGtImm; }
            else                         { fused_op = Op::JmpIfNotGeImm; }
            let idx = emit(c, make_inst_abc(fused_op, src, imm_byte, 0));
            // Placeholder for the 16-bit offset; patch_jump fills it.
            emit(c, make_inst_i16(Op::Jmp, 0));
            release_reg(c, src);
            return (i32)idx;
        }
    }
    // JmpIfNotXx reads both operands before branching — borrow is
    // always safe.
    let saved_borrow_b = c.borrow_local_ok;
    c.borrow_local_ok = true;
    let l = compile_expr(c, cond.left);
    let r = compile_expr(c, cond.right);
    c.borrow_local_ok = saved_borrow_b;
    let fused_op = Op::Halt;
    if      op_kind == Op::CmpLt        { fused_op = Op::JmpIfNotLt; }
    else if op_kind == Op::CmpLe        { fused_op = Op::JmpIfNotLe; }
    else if op_kind == Op::CmpGt        { fused_op = Op::JmpIfNotGt; }
    else if op_kind == Op::CmpGe        { fused_op = Op::JmpIfNotGe; }
    else if op_kind == Op::CmpEq        { fused_op = Op::JmpIfNotEq; }
    else if op_kind == Op::CmpNe        { fused_op = Op::JmpIfNotNe; }
    else if op_kind == Op::CmpStrictEq  { fused_op = Op::JmpIfNotStrictEq; }
    else                                { fused_op = Op::JmpIfNotStrictNe; }
    let idx = emit(c, make_inst_abc(fused_op, l, r, 0));
    emit(c, make_inst_i16(Op::Jmp, 0));
    release_reg(c, r);
    release_reg(c, l);
    return (i32)idx;
}

// --- Loop rotation (test-at-bottom) ----------------------------------
//
// Tight loops compiled head-test-style spend 1 of 4 dispatches per
// iteration on the unconditional back-edge Jmp (~25% of loop dispatch,
// measured via ZJS_PROFILE_OPS on int_loop/func_loop). Rotating the
// loop — entry Jmp to a bottom test that branches *back* when true —
// removes it. Only relational conditions rotate (the JmpIf* family has
// branch-if-TRUE encodings only for <, <=, >, >=); everything else
// keeps the proven head-test shape.

// Compile-time gate mirroring interpreter.zc jit_build_enabled():
// rotation is OFF in ZJS_JIT builds because OSR-entry keys off the
// backward Op::Jmp handler and the JIT doesn't map the JmpIf* family.
// clang folds this to a constant, so the rotated emitters are dead-
// eliminated in JIT builds.
fn loop_rotation_enabled() -> bool {
    let v: bool = true;
    raw {
        #ifdef ZJS_JIT
        v = false;
        #endif
    }
    return v;
}

// --- InvokeGlobal fusion (#394) ---------------------------------------
//
// A plain call whose callee is a global (`fib(n - 1)`, `f(x)`) compiled
// to LoadGlobal + Invoke — the callee re-resolved from the globals
// table on EVERY call, 18.2% of all dispatches in call-heavy code.
// compile_call pops the just-emitted callee LoadGlobal and emits the
// 2-slot Op::InvokeGlobal (+ u16-slot carrier) after the args instead,
// folding the resolve into the call dispatch.
//
// Moving the load AFTER argument evaluation reorders it against the
// spec (EvaluateCall: GetValue(ref) precedes ArgumentListEvaluation),
// so fusion is gated on every argument being side-effect-free — the
// reorder is then unobservable. fusion_arg_is_pure is a strict
// whitelist. Residual (accepted, documented): an OBJECT value flowing
// through a pure-shaped arg (`f(o - 1)` where o's valueOf mutates f's
// binding, or a TDZ-arg throw racing a globalThis-accessor callee)
// still observes the deferred load. No known test262 coverage; the
// zero-regression gauntlet is the arbiter.

// Compile-time gate mirroring loop_rotation_enabled(): OFF in ZJS_JIT
// builds — the JIT's desc mapper doesn't map InvokeGlobal, and the
// stencil set keys off plain Invoke.
fn invoke_fusion_enabled() -> bool {
    let v: bool = true;
    raw {
        #ifdef ZJS_JIT
        v = false;
        #endif
    }
    return v;
}

// Whitelist: literals, `this`, idents that resolve to a local /
// captured / outer-env binding (env slots are data properties — no
// user code; a GLOBAL ident arg is excluded because its ObjectRecord
// fallback can invoke a globalThis accessor), and Paren / sign-not
// Unary / arithmetic-comparison-bitwise Binary over pure operands.
// Everything else — calls, member reads (getters), assignments,
// updates, templates, spreads — is impure. Unknown kinds default to
// impure.
fn fusion_arg_is_pure(c: Compiler*, node: AstNode*) -> bool {
    if node == NULL { return false; }
    let k = node.kind;
    if k == NodeKind::NumberExpr || k == NodeKind::StringExpr
    || k == NodeKind::BigIntExpr || k == NodeKind::BoolExpr
    || k == NodeKind::NullExpr   || k == NodeKind::UndefinedExpr
    || k == NodeKind::ThisExpr {
        return true;
    }
    if k == NodeKind::IdentExpr {
        // Inside `with`, ident resolution is dynamic (with-object
        // lookups can hit user code via Proxy/getter) — but fusion is
        // unreachable there anyway: the callee compiles through
        // compile_ident_read_with, never a bare terminal LoadGlobal.
        if c.with_depth > 0 { return false; }
        let name = c.source + node.start;
        let name_len = node.end - node.start;
        if find_local_index(c, name, name_len) >= 0 { return true; }
        if outer_capture_depth(c, name, name_len) > 0 { return true; }
        return false;
    }
    if k == NodeKind::Paren { return fusion_arg_is_pure(c, node.left); }
    if k == NodeKind::Unary {
        if node.op == TokenKind::Minus || node.op == TokenKind::Plus
        || node.op == TokenKind::Bang  || node.op == TokenKind::Tilde {
            return fusion_arg_is_pure(c, node.left);
        }
        return false;
    }
    if k == NodeKind::Binary {
        // binary_op maps arithmetic/comparison/bitwise tokens only;
        // `in` / `instanceof` (which can run @@hasInstance / Proxy
        // traps) return the Op::Halt sentinel and are rejected.
        if binary_op(node.op) == Op::Halt { return false; }
        return fusion_arg_is_pure(c, node.left)
            && fusion_arg_is_pure(c, node.right);
    }
    return false;
}

fn call_args_fusion_pure(c: Compiler*, node: AstNode*, arg_count: u8) -> bool {
    let i: u8 = 0;
    while i < arg_count {
        if !fusion_arg_is_pure(c, node.children[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// Pure predicate: would the rotated bottom test fuse? Mirrors the
// relational arm of try_emit_cmp_branch_if_false (which decides-AND-
// emits, so it can't be probed). Equality/nullish deliberately
// excluded — no branch-if-true encodings for those (rare in loop
// conditions; documented deferral).
fn cond_is_relational_fusible(cond: AstNode*) -> bool {
    if cond == NULL || cond.kind != NodeKind::Binary { return false; }
    let op_kind = binary_op(cond.op);
    if op_kind == Op::CmpLt || op_kind == Op::CmpLe
    || op_kind == Op::CmpGt || op_kind == Op::CmpGe {
        return true;
    }
    return false;
}

// Emit the rotated loop's bottom test: a fused compare that branches
// BACK to body_head when true. Mirrors try_emit_cmp_branch_if_false's
// operand/imm selection with inverted polarity. The offset is known at
// emit time and is baked into the carrier directly — base is J+2 (the
// instruction after the carrier), NOT emit_jump_back's J+1: the
// interpreter dispatches the fused op at J, reads the offset from
// J+1's bc bytes, and the bottom-of-loop increment lands ip at
// J + 2 + off. Caller guarantees cond_is_relational_fusible(cond).
fn emit_cmp_branch_back_if_true(c: Compiler*, cond: AstNode*, body_head: u32) -> void {
    let op_kind = binary_op(cond.op);
    // RHS small-int literal → JmpIf*Imm.
    if cond.right != NULL && cond.right.kind == NodeKind::NumberExpr {
        let v = cond.right.num;
        let iv = (i32)v;
        let is_int: bool = false;
        raw { is_int = ((double)iv == v) ? true : false; }
        if is_int && iv >= -128 && iv <= 127 {
            // RHS is a literal — LHS is safe to borrow.
            let saved_borrow_a = c.borrow_local_ok;
            c.borrow_local_ok = true;
            let src = compile_expr(c, cond.left);
            c.borrow_local_ok = saved_borrow_a;
            let imm_byte: u8 = (u8)(i8)iv;
            let fused_op = Op::Halt;
            if      op_kind == Op::CmpLt { fused_op = Op::JmpIfLtImm; }
            else if op_kind == Op::CmpLe { fused_op = Op::JmpIfLeImm; }
            else if op_kind == Op::CmpGt { fused_op = Op::JmpIfGtImm; }
            else                         { fused_op = Op::JmpIfGeImm; }
            let j = emit(c, make_inst_abc(fused_op, src, imm_byte, 0));
            let off: i32 = (i32)body_head - ((i32)j + 2);
            emit(c, make_inst_i16(Op::Jmp, off));
            release_reg(c, src);
            return;
        }
    }
    // Reg-reg form — both operands read before branching, borrow safe.
    let saved_borrow_b = c.borrow_local_ok;
    c.borrow_local_ok = true;
    let l = compile_expr(c, cond.left);
    let r = compile_expr(c, cond.right);
    c.borrow_local_ok = saved_borrow_b;
    let fused_op = Op::Halt;
    if      op_kind == Op::CmpLt { fused_op = Op::JmpIfLt; }
    else if op_kind == Op::CmpLe { fused_op = Op::JmpIfLe; }
    else if op_kind == Op::CmpGt { fused_op = Op::JmpIfGt; }
    else                         { fused_op = Op::JmpIfGe; }
    let j = emit(c, make_inst_abc(fused_op, l, r, 0));
    let off: i32 = (i32)body_head - ((i32)j + 2);
    emit(c, make_inst_i16(Op::Jmp, off));
    release_reg(c, r);
    release_reg(c, l);
}

// --- &&-compound rotation (increment 2) ------------------------------
//
// `while (A && B && C<D)` rotates when the LAST conjunct is relational:
// leading conjuncts emit branch-if-FALSE → exit (the existing JmpIfNot*
// family fuses relational leads; anything else compiles to a register +
// JmpIfFalse), only the tail needs a branch-if-true back-edge. Short-
// circuit order and ToBoolean coercions are identical to the head-test
// shape. Leading-exit jump indices accumulate in a caller-provided
// array, patched to the loop exit right after the fused pair.

// Total conjunct leaves of an && chain (both associativity shapes).
fn cond_and_leaf_count(cond: AstNode*) -> u32 {
    if cond != NULL && cond.kind == NodeKind::Logical && cond.op == TokenKind::AmpAmp {
        return cond_and_leaf_count(cond.left) + cond_and_leaf_count(cond.right);
    }
    return 1;
}

// Would the rotated bottom test work for this condition? Either a bare
// relational, or an && chain whose right-spine tail is relational
// (leading conjuncts can be ANY expression). Bounded at 8 leaves so
// the emitters' exit-patch array stays fixed-size.
fn cond_is_rotatable(cond: AstNode*) -> bool {
    if cond_is_relational_fusible(cond) { return true; }
    if cond == NULL || cond.kind != NodeKind::Logical || cond.op != TokenKind::AmpAmp {
        return false;
    }
    if cond_and_leaf_count(cond) > 8 { return false; }
    return cond_is_rotatable(cond.right);
}

// Emit branch-if-false → exit for every leaf of a leading-conjunct
// subtree, in evaluation order. Returns the new patch count.
fn emit_rotated_leading_tests(c: Compiler*, cond: AstNode*, patches: u32*, count: u32) -> u32 {
    if cond.kind == NodeKind::Logical && cond.op == TokenKind::AmpAmp {
        count = emit_rotated_leading_tests(c, cond.left, patches, count);
        count = emit_rotated_leading_tests(c, cond.right, patches, count);
        return count;
    }
    let idx = try_emit_cmp_branch_if_false(c, cond);
    if idx < 0 {
        // JmpIfFalse only reads the register — borrow is safe.
        let saved_borrow = c.borrow_local_ok;
        c.borrow_local_ok = true;
        let r = compile_expr(c, cond);
        c.borrow_local_ok = saved_borrow;
        idx = (i32)emit(c, make_inst_a_i16(Op::JmpIfFalse, r, 0));
        release_reg(c, r);
    }
    patches[count] = (u32)idx;
    return count + 1;
}

// Rotated bottom test driver: leading conjuncts exit forward, the
// relational tail branches back to body_head. Caller guarantees
// cond_is_rotatable(cond); patches must hold ≥ 8 entries. Returns the
// number of exit patches to patch_jump AFTER the fused pair.
fn emit_rotated_bottom_test(c: Compiler*, cond: AstNode*, body_head: u32, patches: u32*) -> u32 {
    let count: u32 = 0;
    let tail = cond;
    while tail.kind == NodeKind::Logical && tail.op == TokenKind::AmpAmp {
        count = emit_rotated_leading_tests(c, tail.left, patches, count);
        tail = tail.right;
    }
    emit_cmp_branch_back_if_true(c, tail, body_head);
    return count;
}

fn emit_jump_back(c: Compiler*, op_: Op, target_idx: u32) -> void {
    // Backward jump to a known target. Offset = target - (here + 1).
    let here: i32 = (i32)c.code_count;
    let off: i32 = (i32)target_idx - (here + 1);
    emit(c, make_inst_i16(op_, off));
}

fn emit_jump_back_if(c: Compiler*, op_: Op, src: u8, target_idx: u32) -> void {
    let here: i32 = (i32)c.code_count;
    let off: i32 = (i32)target_idx - (here + 1);
    emit(c, make_inst_a_i16(op_, src, off));
}

// =====================================================================
// Expression compilation. Each function returns the register holding
// the result (in the function-relative register file).
// =====================================================================

// `yield* iterable` — delegate iteration to `iterable`'s iterator,
// yielding each step's value out of the enclosing generator. Returns
// the iterator's final `.value` (the `return` value of the inner
// generator) as the yield* expression's result. Simplified vs. spec:
// the resumed value sent to outer.next(v) is NOT forwarded into the
// inner iterator's .next(v) — most tests don't exercise that path,
// and full support requires generator-resume plumbing that's not in
// place yet.
fn compile_yield_star(c: Compiler*, operand: AstNode*) -> u8 {
    let src_r = compile_expr(c, operand);
    let iter_r = alloc_reg(c);
    // In an async generator, `yield* x` delegates via the ASYNC iterator
    // protocol (GetIterator(x, async): @@asyncIterator, sync fallback wrapped
    // by iter_get_async) — it must NOT touch x's @@iterator. Plain generators
    // use the sync protocol.
    if c.is_async {
        emit(c, make_inst_ab(Op::IterGetAsync, iter_r, src_r));
    } else {
        emit(c, make_inst_ab(Op::IterGet, iter_r, src_r));
    }
    if src_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }

    if c.is_async {
        // Async yield* (§27.6.3.8 / §15.5.5). IterGetAsync wraps a sync inner
        // in an async-from-sync iterator (ee3ec97), so the iterator always has
        // a real property `.next`. Cache nextMethod ONCE, then loop:
        // Call(nextMethod, iter, received) -> await -> read done/value -> yield,
        // forwarding the value sent to outer.next(v) into inner.next(v).
        // (Throw/return completion forwarding is a follow-up.)
        //
        // Register hygiene (the trap from the earlier reverted attempts):
        // a DEDICATED result reg holds the awaited iter-result, distinct from
        // the transient MethodInvoke call frame, and the call frame is freed
        // after the loop so it doesn't bloat the saved-register window across
        // the in-loop Await/Yield suspends.
        let next_m_r   = alloc_reg(c);
        let next_atom  = ctx_intern_atom(c.ctx, (char*)"next", 4);
        emit_load_prop_atom(c, next_m_r, iter_r, next_atom);
        let received_r = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadUndefined, received_r));
        let result_r   = alloc_reg(c);
        let done_r     = alloc_reg(c);
        let value_r    = alloc_reg(c);
        let dst        = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadUndefined, dst));
        let done_atom  = ctx_intern_atom(c.ctx, (char*)"done", 4);
        let value_atom = ctx_intern_atom(c.ctx, (char*)"value", 5);
        let call_base  = c.next_reg;
        alloc_reg(c); alloc_reg(c); alloc_reg(c);

        let loop_top_a = (u32)c.code_count;
        emit(c, make_inst_ab(Op::Mov, call_base,     next_m_r));
        emit(c, make_inst_ab(Op::Mov, call_base + 1, iter_r));
        emit(c, make_inst_ab(Op::Mov, call_base + 2, received_r));
        emit(c, make_inst_abc(Op::MethodInvoke, result_r, call_base, 1));
        emit(c, make_inst_ab(Op::Await, result_r, result_r));
        emit_load_prop_atom(c, done_r,  result_r, done_atom);
        emit_load_prop_atom(c, value_r, result_r, value_atom);
        let jmp_exit_a = emit(c, make_inst_a_i16(Op::JmpIfTrue, done_r, 0));
        // AsyncGeneratorYield (§27.6.3.5 step 5) awaits the value before
        // yielding it out — so a rejecting yielded value surfaces. (The done
        // path below returns innerResult.value un-awaited, per spec.)
        emit(c, make_inst_ab(Op::Await, value_r, value_r));
        emit(c, make_inst_ab(Op::Yield, received_r, value_r));
        emit_jump_back(c, Op::Jmp, loop_top_a);
        patch_jump(c, jmp_exit_a);
        emit(c, make_inst_ab(Op::Mov, dst, value_r));   // yield* result = inner return value
        c.next_reg = call_base;                          // free the transient call frame
        return dst;
    }

    // ---- sync yield* (simplified loop; resume value not yet forwarded) ----
    let value_r = alloc_reg(c);
    let done_r  = alloc_reg(c);
    let dst     = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadUndefined, dst));

    let loop_top = (u32)c.code_count;
    emit(c, make_inst_abc(Op::IterStep, value_r, iter_r, done_r));
    let jmp_exit = emit(c, make_inst_a_i16(Op::JmpIfTrue, done_r, 0));
    emit(c, make_inst_ab(Op::Yield, dst, value_r));
    emit_jump_back(c, Op::Jmp, loop_top);

    patch_jump(c, jmp_exit);
    release_reg(c, done_r);
    release_reg(c, value_r);
    release_reg(c, iter_r);
    return dst;
}

fn compile_expr(c: Compiler*, node: AstNode*) -> u8 {
    if node == NULL { return 0; }
    let k = node.kind;

    if k == NodeKind::NumberExpr {
        let dst = alloc_reg(c);
        let v = node.num;
        let i = (i32)v;
        if (f64)i == v && i >= -32768 && i <= 32767 {
            emit(c, make_inst_a_i16(Op::LoadInt, dst, i));
        } else if (f64)i == v {
            let idx = add_const(c, zjs_int32(i));
            emit(c, make_inst_a_u16(Op::LoadConst, dst, idx));
        } else {
            let idx = add_const(c, zjs_double(v));
            emit(c, make_inst_a_u16(Op::LoadConst, dst, idx));
        }
        return dst;
    }
    if k == NodeKind::BigIntExpr {
        // Parse the literal slice into a TAG_BIGINT cell at compile
        // time, register it for GC, and stash it in the const pool.
        let len = node.end - node.start;
        let b = zjs_bigint_from_literal(c.source, node.start, len);
        ctx_register_cell(c.ctx, (void*)b);
        let v = zjs_cell_from_ptr((void*)b);
        let idx = add_const(c, v);
        let dst = alloc_reg(c);
        emit(c, make_inst_a_u16(Op::LoadConst, dst, idx));
        return dst;
    }
    if k == NodeKind::BoolExpr {
        let dst = alloc_reg(c);
        if node.bool_value { emit(c, make_inst_a(Op::LoadTrue, dst)); }
        else                { emit(c, make_inst_a(Op::LoadFalse, dst)); }
        return dst;
    }
    if k == NodeKind::NullExpr {
        let dst = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadNull, dst));
        return dst;
    }
    if k == NodeKind::UndefinedExpr {
        let dst = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadUndefined, dst));
        return dst;
    }
    if k == NodeKind::HoleExpr {
        let dst = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadHole, dst));
        return dst;
    }
    if k == NodeKind::StringExpr {
        return compile_string_literal(c, node);
    }
    if k == NodeKind::TemplatePartExpr {
        return compile_template_part(c, node);
    }
    if k == NodeKind::TemplateExpr {
        return compile_template_lit(c, node);
    }
    if k == NodeKind::TaggedTemplate {
        return compile_tagged_template(c, node);
    }
    if k == NodeKind::RegexExpr {
        return compile_regex_literal(c, node);
    }
    if k == NodeKind::IdentExpr {
        let name = c.source + node.start;
        let name_len = node.end - node.start;

        // Inside a `with` body, an IdentifierReference is resolved against
        // the with-object(s) first (WithLookup), falling back to normal
        // scope resolution only when none bind the name.
        if c.with_depth > 0 {
            return compile_ident_read_with(c, node);
        }

        // 1. Try our own locals first.
        let local_idx = find_local_index(c, name, name_len);
        if local_idx >= 0 {
            if c.locals[(u32)local_idx].captured {
                // Captured local — read through env via an IC.
                let dst = alloc_reg(c);
                let name_atom = ctx_intern_atom(c.ctx, name, name_len);
                emit_load_prop_atom(c, dst, c.env_reg, name_atom);
                return dst;
            }
            // #330 TDZ: a let/const/default-param read that we can't
            // prove is post-initialization gets a runtime hole check.
            // Reads after the binding's initializer (in straight-line
            // order, `initialized` set) skip it — common path stays free.
            if c.locals[(u32)local_idx].is_tdz && !c.locals[(u32)local_idx].initialized {
                emit(c, make_inst_a(Op::ThrowIfHole, c.locals[(u32)local_idx].reg));
            }
            // Non-captured local — hand back the local's reg directly
            // when c.borrow_local_ok is set (the caller has proven the
            // surrounding expression won't mutate this local before
            // its result is consumed). Otherwise emit a defensive Mov.
            if c.borrow_local_ok {
                return c.locals[(u32)local_idx].reg;
            }
            let dst = alloc_reg(c);
            emit(c, make_inst_ab(Op::Mov, dst, c.locals[(u32)local_idx].reg));
            return dst;
        }

        // 2a. Implicit `arguments` — only inside a function that uses
        //     it AND where no real local of the same name was hoisted.
        //     compile_function set c.arguments_reg in that case.
        if c.arguments_reg >= 0 && name_len == 9 {
            let is_arg: int = 0;
            raw { is_arg = (memcmp(name, "arguments", 9) == 0) ? 1 : 0; }
            if is_arg != 0 {
                let dst = alloc_reg(c);
                emit(c, make_inst_ab(Op::Mov, dst, (u8)c.arguments_reg));
                return dst;
            }
        }

        // 2. Walk the lexical compiler chain. Depth=1 is c.parent.
        let depth = outer_capture_depth(c, name, name_len);
        if depth > 0 {
            c.has_outer_refs = true;
            let env_r = emit_env_chain_walk(c, depth);
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            let dst = alloc_reg(c);
            emit_load_prop_atom(c, dst, env_r, name_atom);
            release_reg(c, env_r);
            if c.next_reg <= dst { c.next_reg = dst + 1; }
            return dst;
        }

        // 3. Fall through to globals.
        let dst = alloc_dst(c);
        let slot = ctx_intern_global(c.ctx, name, name_len);
        emit(c, make_inst_a_u16(Op::LoadGlobal, dst, (u16)slot));
        if c.next_reg <= dst { c.next_reg = dst + 1; }
        return dst;
    }
    if k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc {
        return compile_function_value(c, node);
    }
    if k == NodeKind::OptionalMember
       || k == NodeKind::OptionalComputed
       || k == NodeKind::OptionalCall {
        return compile_optional_chain(c, node);
    }
    if k == NodeKind::Call {
        if expr_chain_has_optional(node) {
            return compile_optional_chain(c, node);
        }
        return compile_call(c, node);
    }
    if k == NodeKind::New {
        // Outer's preferred_dst (if any) refers to the new-expression's
        // RESULT register — not where the callee/args should land. Clear
        // it across the body so an inner LoadGlobal alloc_dst doesn't
        // clobber a destination local that's also referenced by an arg
        // (e.g. `queue = new Packet(queue, ...)`).
        let new_outer_pd = c.preferred_dst;
        c.preferred_dst = -1;

        // Detect `new Foo(...args)` spread in `new` argument list and
        // route to the variadic path. Args go into a single array,
        // SpreadNewInvoke reads argc from it at runtime.
        let n_has_spread: bool = false;
        let n_si: u32 = 0;
        while n_si < node.children_count {
            if node.children[n_si].kind == NodeKind::Spread { n_has_spread = true; break; }
            n_si = n_si + 1;
        }
        if n_has_spread {
            let n_base = c.next_reg;
            alloc_reg(c); alloc_reg(c); // callee, args_array
            let cr = compile_expr(c, node.left);
            if cr != n_base {
                emit(c, make_inst_ab(Op::Mov, n_base, cr));
                if cr + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            emit(c, make_inst_abc(Op::NewArray, n_base + 1, 0, 0));
            let nj: u32 = 0;
            while nj < node.children_count {
                let ch = node.children[nj];
                if ch.kind == NodeKind::Spread {
                    let src_r = compile_expr(c, ch.left);
                    emit(c, make_inst_ab(Op::ArraySpread, n_base + 1, src_r));
                    if src_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                } else {
                    let val_r = compile_expr(c, ch);
                    emit(c, make_inst_ab(Op::ArrayPush, n_base + 1, val_r));
                    if val_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                }
                nj = nj + 1;
            }
            emit(c, make_inst_abc(Op::SpreadNewInvoke, n_base, n_base, 0));
            c.next_reg = n_base + 1;
            if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
            c.preferred_dst = new_outer_pd;
            return n_base;
        }
        // `new Foo(args)`: reserve a contiguous slot for callee + args,
        // then emit Op::NewInvoke (sets up { proto, this } and calls).
        let arg_count: u8 = (u8)node.children_count;
        let base = c.next_reg;
        let i: u8 = 0;
        while i <= arg_count { alloc_reg(c); i = i + 1; }
        // Callee — may be a Member (e.g. `new x.y()`); compile_expr
        // handles both shapes.
        let r = compile_expr(c, node.left);
        if r != base {
            emit(c, make_inst_ab(Op::Mov, base, r));
            if r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        }
        let j: u8 = 0;
        while j < arg_count {
            let arg_r = compile_expr(c, node.children[j]);
            let target = base + 1 + j;
            if arg_r != target {
                emit(c, make_inst_ab(Op::Mov, target, arg_r));
                if arg_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            j = j + 1;
        }
        emit(c, make_inst_abc(Op::NewInvoke, base, base, arg_count));
        c.next_reg = base + 1;
        if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
        c.preferred_dst = new_outer_pd;
        return base;
    }
    if k == NodeKind::Member {
        if expr_chain_has_optional(node) {
            return compile_optional_chain(c, node);
        }
        return compile_member(c, node);
    }
    if k == NodeKind::Computed {
        if expr_chain_has_optional(node) {
            return compile_optional_chain(c, node);
        }
        return compile_computed(c, node);
    }
    if k == NodeKind::Array {
        return compile_array_literal(c, node);
    }
    if k == NodeKind::Object {
        return compile_object_literal(c, node);
    }
    if k == NodeKind::Paren {
        return compile_expr(c, node.left);
    }
    if k == NodeKind::Sequence {
        let i: u32 = 0;
        let last: u8 = 0;
        while i < node.children_count {
            // Release the previous result before evaluating the next.
            if i > 0 { release_reg(c, last); }
            last = compile_expr(c, node.children[i]);
            i = i + 1;
        }
        return last;
    }
    if k == NodeKind::AwaitExpr {
        let src = compile_expr(c, node.left);
        let dst = alloc_reg(c);
        emit(c, make_inst_ab(Op::Await, dst, src));
        if src + 1 == c.next_reg && src != dst { c.next_reg = c.next_reg - 1; }
        return dst;
    }
    if k == NodeKind::ImportCall {
        // Dynamic import(specifier): evaluate the specifier, then resolve +
        // load the module and produce a Promise of its namespace.
        let src = compile_expr(c, node.left);
        let dst = alloc_reg(c);
        emit(c, make_inst_ab(Op::DynamicImport, dst, src));
        if src + 1 == c.next_reg && src != dst { c.next_reg = c.next_reg - 1; }
        return dst;
    }
    if k == NodeKind::ImportMetaExpr {
        let dst = alloc_reg(c);
        emit(c, make_inst_a(Op::ImportMeta, dst));
        return dst;
    }
    if k == NodeKind::YieldExpr {
        // `yield*` — delegating yield. Spec (§14.4.14) gets/uses the
        // operand's iterator and forwards each step out as a yield from
        // this generator, returning the iterator's final .value at the
        // end. We implement the simplified value-forwarding form (no
        // resumed-value passthrough into the inner iterator) which is
        // enough for the common patterns test262 exercises.
        if node.bool_value && node.left != NULL {
            return compile_yield_star(c, node.left);
        }
        // Plain `yield` (with or without operand).
        let src: u8 = 0;
        if node.left != NULL {
            src = compile_expr(c, node.left);
        } else {
            src = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadUndefined, src));
        }
        let dst = alloc_reg(c);
        emit(c, make_inst_ab(Op::Yield, dst, src));
        if src + 1 == c.next_reg && src != dst { c.next_reg = c.next_reg - 1; }
        return dst;
    }
    if k == NodeKind::Unary {
        // `delete` needs the receiver + key broken out (not the
        // loaded property value). Special-case BEFORE the normal
        // compile_expr of the operand.
        if node.op == TokenKind::KwDelete {
            let operand = node.left;
            // Spec: `delete obj.#x` is an early SyntaxError. Private
            // class members can't be removed once installed. The
            // covered-parenthesis variants are SyntaxError too, so
            // walk through Paren wrappers before the check.
            let probe = operand;
            while probe != NULL && probe.kind == NodeKind::Paren {
                probe = probe.left;
            }
            if probe != NULL
               && (probe.kind == NodeKind::Member)
               && is_private_name(c, probe.name_start, probe.name_length) {
                c.had_error = true;
                return alloc_reg(c);
            }
            if operand != NULL && operand.kind == NodeKind::Member {
                let obj_r = compile_expr(c, operand.left);
                let key_r = emit_load_name_string(c, c.source + operand.name_start, operand.name_length);
                let dst = alloc_reg(c);
                emit(c, make_inst_abc(Op::DeleteElem, dst, obj_r, key_r));
                if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                if obj_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                if c.next_reg <= dst { c.next_reg = dst + 1; }
                return dst;
            }
            if operand != NULL && operand.kind == NodeKind::Computed {
                let obj_r = compile_expr(c, operand.left);
                let key_r = compile_expr(c, operand.right);
                let dst = alloc_reg(c);
                emit(c, make_inst_abc(Op::DeleteElem, dst, obj_r, key_r));
                if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                if obj_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                if c.next_reg <= dst { c.next_reg = dst + 1; }
                return dst;
            }
            // `delete bareIdent`: in sloppy mode this returns false for
            // any non-configurable lexical binding (catch param, let,
            // const, function param, hoisted var) and true otherwise.
            // We don't know configurability of arbitrary globals, but a
            // local/catch param resolving here is always non-deletable —
            // emit false in that case. Anything else (unresolved name,
            // non-reference expression) still gets the old "true".
            if operand != NULL && operand.kind == NodeKind::IdentExpr {
                let nm = c.source + operand.start;
                let nl = operand.end - operand.start;
                if find_local_index(c, nm, nl) >= 0 {
                    let dst = alloc_reg(c);
                    emit(c, make_inst_a(Op::LoadFalse, dst));
                    return dst;
                }
            }
            let dst = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadTrue, dst));
            return dst;
        }
        // typeof must NOT throw ReferenceError for an undeclared
        // identifier. Detect this case BEFORE compiling the operand
        // (which would emit a throwing LoadGlobal) and substitute
        // LoadGlobalOrUndefined.
        if node.op == TokenKind::KwTypeof && node.left != NULL {
            // Unwrap parens — `typeof(x)` should behave like `typeof x`
            // for the unresolved-reference fallback.
            let operand = node.left;
            while operand != NULL && operand.kind == NodeKind::Paren {
                operand = operand.left;
            }
            if operand != NULL && operand.kind == NodeKind::IdentExpr {
            let nm = c.source + operand.start;
            let nl = operand.end - operand.start;
            let local_idx = find_local_index(c, nm, nl);
            let outer_idx: i32 = -1;
            if local_idx < 0 && c.parent != NULL {
                let oi = find_local_index(c.parent, nm, nl);
                if oi >= 0 && c.parent.locals[(u32)oi].captured { outer_idx = oi; }
            }
            if local_idx < 0 && outer_idx < 0 {
                let slot = ctx_intern_global(c.ctx, nm, nl);
                let src_g = alloc_reg(c);
                emit(c, make_inst_a_u16(Op::LoadGlobalOrUndefined, src_g, (u16)slot));
                let dst_g = alloc_reg(c);
                emit(c, make_inst_ab(Op::Typeof, dst_g, src_g));
                release_reg(c, src_g);
                return dst_g;
            }
            }
        }
        let src = compile_expr(c, node.left);
        let op = node.op;
        if op == TokenKind::Minus {
            let dst = alloc_reg(c);
            emit(c, make_inst_ab(Op::Neg, dst, src));
            release_reg(c, src);
            // dst is now top — but alloc_reg already bumped next_reg past it.
            return dst;
        }
        if op == TokenKind::Plus {
            // Unary plus: ToNumber(x). Emit `x - 0` via SubImm, which
            // already has the right int32 fast path AND falls through
            // to zjs_arith_sub for general coercion (true → 1, "5" → 5,
            // ToPrimitive on objects, etc.).
            let dst = alloc_reg(c);
            emit(c, make_inst_abc(Op::SubImm, dst, src, (u8)0));
            release_reg(c, src);
            if c.next_reg <= dst { c.next_reg = dst + 1; }
            return dst;
        }
        if op == TokenKind::Bang {
            let dst = alloc_reg(c);
            emit(c, make_inst_ab(Op::LogicalNot, dst, src));
            release_reg(c, src);
            return dst;
        }
        if op == TokenKind::Tilde {
            let dst = alloc_reg(c);
            emit(c, make_inst_ab(Op::BitNot, dst, src));
            release_reg(c, src);
            return dst;
        }
        if op == TokenKind::KwTypeof {
            // IdentExpr globals were handled above (no-throw path).
            // This handles non-Ident operands (typeof expr).
            let dst = alloc_reg(c);
            emit(c, make_inst_ab(Op::Typeof, dst, src));
            release_reg(c, src);
            return dst;
        }
        if op == TokenKind::KwVoid {
            // void <expr> evaluates expr (already done) and returns undefined.
            release_reg(c, src);
            let dst = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadUndefined, dst));
            return dst;
        }
        if op == TokenKind::PlusPlus || op == TokenKind::MinusMinus {
            // Prefix ++/--. We compiled `src` above eagerly but didn't
            // use it — release it and re-compile via compile_inc_dec
            // (which needs the LHS as an AstNode, not a register).
            release_reg(c, src);
            return compile_inc_dec(c, node.left, false, op == TokenKind::PlusPlus);
        }
        // delete — defer
        c.had_error = true;
        return src;
    }
    if k == NodeKind::Postfix {
        return compile_inc_dec(c, node.left, true, node.op == TokenKind::PlusPlus);
    }
    if k == NodeKind::Binary {
        // Special-case `in` and `instanceof` — they're keyword tokens, not
        // arithmetic ops, but the parser routes them through Binary.
        if node.op == TokenKind::KwIn || node.op == TokenKind::KwInstanceof {
            // Brand check: `#x in obj`. The parser synthesizes a Member
            // node with left=NULL holding the `#x` slice — compile the
            // mangled key as the LHS so Op::In tests existence of that
            // hidden key on the receiver.
            if node.op == TokenKind::KwIn
               && node.left != NULL
               && node.left.kind == NodeKind::Member
               && node.left.left == NULL
               && is_private_name(c, node.left.name_start, node.left.name_length) {
                let mangled = mangle_private_name(c, node.left.name_start, node.left.name_length);
                if mangled == NULL { return 0; }
                let l = emit_load_atom(c, mangled);
                let r = compile_expr(c, node.right);
                let dst = alloc_reg(c);
                emit(c, make_inst_abc(Op::In, dst, l, r));
                release_reg(c, r);
                release_reg(c, l);
                if c.next_reg <= dst { c.next_reg = dst + 1; }
                return dst;
            }
            let l = compile_expr(c, node.left);
            let r = compile_expr(c, node.right);
            let dst = alloc_reg(c);
            let op_ = if node.op == TokenKind::KwIn { Op::In } else { Op::Instanceof };
            emit(c, make_inst_abc(op_, dst, l, r));
            release_reg(c, r);
            release_reg(c, l);
            if c.next_reg <= dst { c.next_reg = dst + 1; }
            return dst;
        }
        let op_kind = binary_op(node.op);
        if op_kind == Op::Halt {
            c.had_error = true;
            return alloc_reg(c);
        }
        // Fused-immediate fast path for `x + N` / `x - N` / `N + x` when
        // N is a small integer literal that fits in an i8. Saves a
        // LoadInt + a dispatch per occurrence. Most tight numeric loops
        // and recursive arithmetic (fib, sieve, int_loop) benefit.
        let fusable: bool =
            op_kind == Op::Add || op_kind == Op::Sub ||
            op_kind == Op::CmpLt || op_kind == Op::CmpLe ||
            op_kind == Op::CmpGt || op_kind == Op::CmpGe;
        if fusable {
            // Only fuse when the immediate is on the RHS — Add looks
            // commutative for numerics but `1 + 'b'` vs `'b' + 1`
            // produce different strings (ECMA-262 §13.15: concat is
            // order-sensitive), and we can't prove LHS is non-string
            // at compile time. Comparisons also have order-sensitive
            // ToPrimitive (LHS first), so RHS-imm-only stays safe.
            if node.right != NULL && node.right.kind == NodeKind::NumberExpr {
                let v = node.right.num;
                let iv = (i32)v;
                let is_int: bool = false;
                raw { is_int = ((double)iv == v) ? true : false; }
                if is_int && iv >= -128 && iv <= 127 {
                    let imm_byte: u8 = (u8)(i8)iv;
                    let fused_op = Op::Halt;
                    if      op_kind == Op::Add   { fused_op = Op::AddImm; }
                    else if op_kind == Op::Sub   { fused_op = Op::SubImm; }
                    else if op_kind == Op::CmpLt { fused_op = Op::CmpLtImm; }
                    else if op_kind == Op::CmpLe { fused_op = Op::CmpLeImm; }
                    else if op_kind == Op::CmpGt { fused_op = Op::CmpGtImm; }
                    else if op_kind == Op::CmpGe { fused_op = Op::CmpGeImm; }
                    // Honor caller's preferred dst BEFORE recursing,
                    // because compile_expr(node.left) might also see a
                    // preferred_dst hint we'd otherwise leak inwards.
                    let saved_pd = c.preferred_dst;
                    c.preferred_dst = -1;
                    let saved_borrow = c.borrow_local_ok;
                    c.borrow_local_ok = true;
                    let src = compile_expr(c, node.left);
                    c.borrow_local_ok = saved_borrow;
                    c.preferred_dst = saved_pd;
                    let dst = alloc_dst(c);
                    emit(c, make_inst_abc(fused_op, dst, src, imm_byte));
                    release_reg(c, src);
                    if c.next_reg <= dst { c.next_reg = dst + 1; }
                    return dst;
                }
            }
        }
        // Borrow optimization: if the RHS is side-effect-free we can
        // hand back LHS's local reg directly. Then the LHS read may
        // also borrow if its operands are pure, so set the flag
        // around both compile_expr calls.
        let rhs_pure = expr_is_simple_pure(node.right);
        let lhs_pure = expr_is_simple_pure(node.left);
        let saved_pd = c.preferred_dst;
        c.preferred_dst = -1;
        let saved_borrow = c.borrow_local_ok;
        if rhs_pure { c.borrow_local_ok = true; }
        let l = compile_expr(c, node.left);
        if !rhs_pure { c.borrow_local_ok = saved_borrow; }
        if lhs_pure { c.borrow_local_ok = true; }
        let r = compile_expr(c, node.right);
        c.borrow_local_ok = saved_borrow;
        c.preferred_dst = saved_pd;
        let dst = alloc_dst(c);
        emit(c, make_inst_abc(op_kind, dst, l, r));
        // Clean up temps once we've emitted; conservative dst placement.
        release_reg(c, r);
        release_reg(c, l);
        // dst was just allocated above release calls; bump back up to it.
        if c.next_reg <= dst { c.next_reg = dst + 1; }
        return dst;
    }
    if k == NodeKind::ThisExpr {
        if node.bool_value {
            // `new.target` — read fresh; not hoistable because the
            // ctor-call flag can flip across nested calls.
            let dst = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadNewTarget, dst));
            return dst;
        }
        // Plain `this` — return the function-entry hoisted register
        // when available (most method bodies). Otherwise fall back to
        // a fresh LoadThis.
        if c.this_reg >= 0 {
            if c.borrow_local_ok { return (u8)c.this_reg; }
            let dst = alloc_reg(c);
            emit(c, make_inst_ab(Op::Mov, dst, (u8)c.this_reg));
            return dst;
        }
        let dst = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadThis, dst));
        return dst;
    }
    if k == NodeKind::ClassExpr {
        return compile_class_value(c, node);
    }
    if k == NodeKind::Logical {
        return compile_logical(c, node);
    }
    if k == NodeKind::Conditional {
        // test ? consequent : alternate.
        // Materialize both branches into the SAME register; JmpIfFalse
        // skips the consequent.
        //
        // The outer caller (e.g. `result = result === x ? a : result + b`)
        // may have set c.preferred_dst to the LHS local's reg. If we
        // leave it set, the FIRST inner alloc_dst — typically the test
        // expression's binop — would write into that local's slot,
        // clobbering `result` before the alt branch (`result + b`) ever
        // reads it. Save + clear here; the Conditional itself uses
        // alloc_reg (not the hint), so nothing in this layer needs it.
        let saved_pd = c.preferred_dst;
        c.preferred_dst = -1;
        let dst = alloc_reg(c);
        let test_r = compile_expr(c, node.left);
        let jmp_else = emit(c, make_inst_a_i16(Op::JmpIfFalse, test_r, 0));
        release_reg(c, test_r);

        // Consequent into dst.
        let saved_next = c.next_reg;
        let cons_r = compile_expr(c, node.right);
        if cons_r != dst { emit(c, make_inst_ab(Op::Mov, dst, cons_r)); }
        c.next_reg = saved_next;
        let jmp_end = emit(c, make_inst_i16(Op::Jmp, 0));

        // Alternate target — patch JmpIfFalse here.
        patch_jump(c, (u32)jmp_else);
        let alt_r = compile_expr(c, node.third);
        if alt_r != dst { emit(c, make_inst_ab(Op::Mov, dst, alt_r)); }
        c.next_reg = saved_next;
        patch_jump(c, (u32)jmp_end);

        if c.next_reg <= dst { c.next_reg = dst + 1; }
        c.preferred_dst = saved_pd;
        return dst;
    }
    if k == NodeKind::Assignment {
        return compile_assignment(c, node);
    }

    // Unsupported in 3.0a.
    c.had_error = true;
    let dst = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadUndefined, dst));
    return dst;
}

fn binary_op(tk: TokenKind) -> Op {
    if tk == TokenKind::Plus      { return Op::Add; }
    if tk == TokenKind::Minus     { return Op::Sub; }
    if tk == TokenKind::Star      { return Op::Mul; }
    if tk == TokenKind::Slash     { return Op::Div; }
    if tk == TokenKind::Percent   { return Op::Mod; }
    if tk == TokenKind::StarStar  { return Op::Pow; }
    if tk == TokenKind::EqEq      { return Op::CmpEq; }
    if tk == TokenKind::BangEq    { return Op::CmpNe; }
    if tk == TokenKind::EqEqEq    { return Op::CmpStrictEq; }
    if tk == TokenKind::BangEqEq  { return Op::CmpStrictNe; }
    if tk == TokenKind::Lt        { return Op::CmpLt; }
    if tk == TokenKind::LtEq      { return Op::CmpLe; }
    if tk == TokenKind::Gt        { return Op::CmpGt; }
    if tk == TokenKind::GtEq      { return Op::CmpGe; }
    if tk == TokenKind::Amp       { return Op::BitAnd; }
    if tk == TokenKind::Pipe      { return Op::BitOr; }
    if tk == TokenKind::Caret     { return Op::BitXor; }
    if tk == TokenKind::LtLt      { return Op::Shl; }
    if tk == TokenKind::GtGt      { return Op::Shr; }
    if tk == TokenKind::GtGtGt    { return Op::UShr; }
    return Op::Halt;     // sentinel "unsupported"
}

fn compile_logical(c: Compiler*, node: AstNode*) -> u8 {
    // Short-circuiting: compute left into dst. For && jump past right if
    // dst is falsy; for || jump past right if dst is truthy; for ??
    // jump past right if dst is non-null-or-undefined (we approximate
    // as truthy for MVP — Strictly should be neither null nor undef).
    //
    // We Mov the RHS back into dst at the end (line below), so dst MUST
    // be a writable temp — not a borrowed local register. Clear
    // borrow_local_ok before compiling left so IdentExpr emits a
    // defensive Mov into a fresh reg instead of handing us the local's
    // reg directly. Same reasoning for preferred_dst: an outer
    // assignment's hint refers to a destination, not a slot we may
    // safely scribble through as scratch. Without this, `arr && f(arr)`
    // clobbers `arr` with `arr.length` before f sees it. Restored at
    // the end so peer expressions still benefit from the hints.
    let saved_borrow = c.borrow_local_ok;
    let saved_pd     = c.preferred_dst;
    c.borrow_local_ok = false;
    c.preferred_dst   = -1;
    let dst = compile_expr(c, node.left);
    let op_tok = node.op;

    // Emit a placeholder jump that we'll patch.
    let jmp_op = Op::JmpIfFalse;
    if op_tok == TokenKind::PipePipe       { jmp_op = Op::JmpIfTrue; }
    else if op_tok == TokenKind::AmpAmp    { jmp_op = Op::JmpIfFalse; }
    else if op_tok == TokenKind::QuestionQuestion {
        // ?? coalesces only null/undefined to RHS. Anything else
        // (including 0, "", false) keeps the LHS. Uses a dedicated
        // op that jumps past the RHS only when src is not null and
        // not undefined.
        jmp_op = Op::JmpIfNotNullish;
    }
    let jmp_idx = emit(c, make_inst_a_i16(jmp_op, dst, 0));

    // Compile RHS into the same dst register (overwrite).
    // Save next_reg, evaluate RHS into a fresh reg, Mov into dst.
    let saved_next = c.next_reg;
    let rhs = compile_expr(c, node.right);
    emit(c, make_inst_ab(Op::Mov, dst, rhs));
    c.next_reg = saved_next;

    patch_jump(c, jmp_idx);
    c.borrow_local_ok = saved_borrow;
    c.preferred_dst   = saved_pd;
    return dst;
}

// Normal-scope GetValue for a bare name into `dst` (local / captured /
// outer-env / global) — the same chain compile_assignment uses, factored
// so the with-fallback path can reuse it.
fn emit_load_name_normal(c: Compiler*, name: char*, name_len: u32, dst: u8) -> void {
    let local_idx = find_local_index(c, name, name_len);
    if local_idx >= 0 {
        if c.locals[(u32)local_idx].captured {
            let na = ctx_intern_atom(c.ctx, name, name_len);
            emit_load_prop_atom(c, dst, c.env_reg, na);
        } else {
            emit(c, make_inst_ab(Op::Mov, dst, c.locals[(u32)local_idx].reg));
        }
        return;
    }
    let depth = outer_capture_depth(c, name, name_len);
    if depth > 0 {
        c.has_outer_refs = true;
        let env_r = emit_env_chain_walk(c, depth);
        let na = ctx_intern_atom(c.ctx, name, name_len);
        emit_load_prop_atom(c, dst, env_r, na);
        release_reg(c, env_r);
        return;
    }
    let slot = ctx_intern_global(c.ctx, name, name_len);
    emit(c, make_inst_a_u16(Op::LoadGlobal, dst, (u16)slot));
}

// Normal-scope PutValue of `val` to a bare name (mirrors the store half
// of compile_assignment). Used by the with-fallback path.
fn emit_store_name_normal(c: Compiler*, name: char*, name_len: u32, val: u8) -> void {
    let local_idx = find_local_index(c, name, name_len);
    if local_idx >= 0 {
        if c.locals[(u32)local_idx].captured {
            let na = ctx_intern_atom(c.ctx, name, name_len);
            emit_store_prop_atom(c, c.env_reg, na, val);
        } else {
            emit(c, make_inst_ab(Op::Mov, c.locals[(u32)local_idx].reg, val));
        }
        return;
    }
    let depth = outer_capture_depth(c, name, name_len);
    if depth > 0 {
        c.has_outer_refs = true;
        let env_r = emit_env_chain_walk(c, depth);
        let na = ctx_intern_atom(c.ctx, name, name_len);
        emit_store_prop_atom(c, env_r, na, val);
        release_reg(c, env_r);
        return;
    }
    let slot = ctx_intern_global(c.ctx, name, name_len);
    emit(c, make_inst_a_u16(Op::StoreGlobal, val, (u16)slot));
}

// op= token -> arithmetic/bitwise Op, or Halt for `=`/logical/unknown.
fn compound_assign_op(op_tok: TokenKind) -> Op {
    if      op_tok == TokenKind::PlusEq    { return Op::Add; }
    else if op_tok == TokenKind::MinusEq   { return Op::Sub; }
    else if op_tok == TokenKind::StarEq    { return Op::Mul; }
    else if op_tok == TokenKind::SlashEq   { return Op::Div; }
    else if op_tok == TokenKind::PercentEq { return Op::Mod; }
    else if op_tok == TokenKind::StarStarEq{ return Op::Pow; }
    else if op_tok == TokenKind::AmpEq     { return Op::BitAnd; }
    else if op_tok == TokenKind::PipeEq    { return Op::BitOr; }
    else if op_tok == TokenKind::CaretEq   { return Op::BitXor; }
    else if op_tok == TokenKind::LtLtEq    { return Op::Shl; }
    else if op_tok == TokenKind::GtGtEq    { return Op::Shr; }
    else if op_tok == TokenKind::GtGtGtEq  { return Op::UShr; }
    return Op::Halt;
}

// Assignment to a bare IdentExpr target inside a `with` body. WithLookup
// resolves the binding object (or undefined) ONCE; the RHS is compiled
// ONCE with with_depth intact (so nested with-references resolve), and
// only the GetValue / PutValue steps branch on whether a with-object owns
// the name. Handles `=`, arithmetic/bitwise compound, and logical-assign.
fn compile_assignment_with(c: Compiler*, node: AstNode*) -> u8 {
    let target = node.left;
    let op_tok = node.op;
    let name = c.source + target.start;
    let name_len = target.end - target.start;
    let name_atom = ctx_intern_atom(c.ctx, name, name_len);

    let name_r = emit_load_atom(c, name_atom);
    let holder = alloc_reg(c);
    emit(c, make_inst_ab(Op::WithLookup, holder, name_r));
    release_reg(c, name_r);
    let result = alloc_reg(c);

    if op_tok == TokenKind::Eq {
        // §13.15.2: resolve ref (WithLookup, done) then evaluate RHS.
        let rhs = compile_expr(c, node.right);
        emit(c, make_inst_ab(Op::Mov, result, rhs));
        release_reg(c, rhs);
        // PutValue: holder ? holder[name]=result : normal store.
        let jfb = emit(c, make_inst_a_i16(Op::JmpIfNullish, holder, 0));
        emit_store_prop_atom(c, holder, name_atom, result);
        let jdn = emit(c, make_inst_i16(Op::Jmp, 0));
        patch_jump(c, jfb);
        emit_store_name_normal(c, name, name_len, result);
        patch_jump(c, jdn);
        release_reg(c, holder);
        return result;
    }

    // Compound: GetValue (branch on holder), evaluate RHS, combine, store.
    let cur = alloc_reg(c);
    let jl = emit(c, make_inst_a_i16(Op::JmpIfNullish, holder, 0));
    emit_load_prop_atom(c, cur, holder, name_atom);
    let jl_done = emit(c, make_inst_i16(Op::Jmp, 0));
    patch_jump(c, jl);
    emit_load_name_normal(c, name, name_len, cur);
    patch_jump(c, jl_done);

    let is_logical: bool =
        op_tok == TokenKind::AmpAmpEq
        || op_tok == TokenKind::PipePipeEq
        || op_tok == TokenKind::QuestionQuestionEq;
    if is_logical {
        emit(c, make_inst_ab(Op::Mov, result, cur));
        let jop = Op::JmpIfFalse;
        if      op_tok == TokenKind::PipePipeEq         { jop = Op::JmpIfTrue; }
        else if op_tok == TokenKind::QuestionQuestionEq { jop = Op::JmpIfNotNullish; }
        let skip = emit(c, make_inst_a_i16(jop, result, 0));
        let rhs = compile_expr(c, node.right);
        emit(c, make_inst_ab(Op::Mov, result, rhs));
        release_reg(c, rhs);
        // store result (branch)
        let js = emit(c, make_inst_a_i16(Op::JmpIfNullish, holder, 0));
        emit_store_prop_atom(c, holder, name_atom, result);
        let js_done = emit(c, make_inst_i16(Op::Jmp, 0));
        patch_jump(c, js);
        emit_store_name_normal(c, name, name_len, result);
        patch_jump(c, js_done);
        patch_jump(c, skip);
    } else {
        let rhs = compile_expr(c, node.right);
        let op = compound_assign_op(op_tok);
        if op == Op::Halt { c.had_error = true; }
        emit(c, make_inst_abc(op, result, cur, rhs));
        release_reg(c, rhs);
        let js = emit(c, make_inst_a_i16(Op::JmpIfNullish, holder, 0));
        emit_store_prop_atom(c, holder, name_atom, result);
        let js_done = emit(c, make_inst_i16(Op::Jmp, 0));
        patch_jump(c, js);
        emit_store_name_normal(c, name, name_len, result);
        patch_jump(c, js_done);
    }
    release_reg(c, cur);
    release_reg(c, holder);
    return result;
}

fn compile_assignment(c: Compiler*, node: AstNode*) -> u8 {
    let target = node.left;
    let op_tok = node.op;
    if target == NULL {
        c.had_error = true;
        return alloc_reg(c);
    }
    // Destructuring assignment: `[a, b] = src` / `{ a } = src`. Only
    // plain `=` permits patterns per spec. The RHS evaluates once;
    // destructure_pattern in assignment mode dispatches each target
    // through the normal LHS-expression lookup chain.
    if target.kind == NodeKind::ArrayPattern || target.kind == NodeKind::ObjectPattern {
        let r = compile_expr(c, node.right);
        let saved = c.in_dstr_assign;
        c.in_dstr_assign = true;
        destructure_pattern(c, target, r);
        c.in_dstr_assign = saved;
        return r;
    }
    if target.kind == NodeKind::Member || target.kind == NodeKind::Computed {
        return compile_assignment_to_property(c, target, op_tok, node.right);
    }
    if target.kind != NodeKind::IdentExpr {
        c.had_error = true;
        return alloc_reg(c);
    }

    // Inside a `with` body: a with-object that binds the target name owns
    // the assignment (PutValue on its property); otherwise fall through
    // to normal resolution. (Member/destructuring targets resolve their
    // base through the read path, which is already with-aware.)
    if c.with_depth > 0 {
        return compile_assignment_with(c, node);
    }

    let name = c.source + target.start;
    let name_len = target.end - target.start;
    let local_idx = find_local_index(c, name, name_len);
    let captured_local = local_idx >= 0 && c.locals[(u32)local_idx].captured;
    let local_reg: u8 = if local_idx >= 0 { c.locals[(u32)local_idx].reg } else { 0 };

    // Resolve to outer-scope captured local via multi-level walk.
    let outer_depth: u32 = 0;
    if local_idx < 0 {
        outer_depth = outer_capture_depth(c, name, name_len);
        if outer_depth > 0 { c.has_outer_refs = true; }
    }

    if op_tok == TokenKind::Eq {
        // For local target, hand the RHS a preferred-dst hint so the
        // final ALU op writes straight into local_reg — skips the
        // tail Mov on `local = expr` patterns (the assignment loop's
        // dominant Mov source).
        let saved_pd = c.preferred_dst;
        if local_idx >= 0 && !captured_local {
            c.preferred_dst = (i32)local_reg;
        } else {
            c.preferred_dst = -1;
        }
        let r = compile_expr(c, node.right);
        c.preferred_dst = saved_pd;
        if local_idx >= 0 {
            if captured_local {
                let name_atom = ctx_intern_atom(c.ctx, name, name_len);
                emit_store_prop_atom(c, c.env_reg, name_atom, r);
            } else if r != local_reg {
                // RHS didn't take our hint (e.g. it was a bare ident
                // returning a borrowed reg) — fall back to Mov.
                emit(c, make_inst_ab(Op::Mov, local_reg, r));
            }
        } else if outer_depth > 0 {
            let env_r = emit_env_chain_walk(c, outer_depth);
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            emit_store_prop_atom(c, env_r, name_atom, r);
            release_reg(c, env_r);
        } else {
            let slot = ctx_intern_global(c.ctx, name, name_len);
            emit(c, make_inst_a_u16(Op::StoreGlobal, r, (u16)slot));
        }
        return r;
    }

    // Compound assignment: load, op, store. Same shape, just emits
    // both a LoadProp and a StoreProp pair.
    let cur = alloc_reg(c);
    if local_idx >= 0 {
        if captured_local {
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            emit_load_prop_atom(c, cur, c.env_reg, name_atom);
        } else {
            emit(c, make_inst_ab(Op::Mov, cur, local_reg));
        }
    } else if outer_depth > 0 {
        let env_r = emit_env_chain_walk(c, outer_depth);
        let name_atom = ctx_intern_atom(c.ctx, name, name_len);
        emit_load_prop_atom(c, cur, env_r, name_atom);
        release_reg(c, env_r);
    } else {
        let slot = ctx_intern_global(c.ctx, name, name_len);
        emit(c, make_inst_a_u16(Op::LoadGlobal, cur, (u16)slot));
    }
    // Logical-assignment operators (ECMA-262 §13.15.2): short-circuit on
    // the LHS before evaluating RHS. `&&=` skips the assign when LHS is
    // falsy, `||=` when truthy, `??=` when neither null nor undefined.
    // We borrow dst's tentative value from `cur`, branch past RHS+store
    // on short-circuit, otherwise overwrite dst with RHS and store back.
    let is_logical_assign: bool =
        op_tok == TokenKind::AmpAmpEq
        || op_tok == TokenKind::PipePipeEq
        || op_tok == TokenKind::QuestionQuestionEq;
    if is_logical_assign {
        let dst = alloc_reg(c);
        emit(c, make_inst_ab(Op::Mov, dst, cur));
        let jmp_op = Op::JmpIfFalse;
        if      op_tok == TokenKind::PipePipeEq          { jmp_op = Op::JmpIfTrue; }
        else if op_tok == TokenKind::QuestionQuestionEq  { jmp_op = Op::JmpIfNotNullish; }
        let skip_idx = emit(c, make_inst_a_i16(jmp_op, dst, 0));
        let rhs_r = compile_expr(c, node.right);
        emit(c, make_inst_ab(Op::Mov, dst, rhs_r));
        if local_idx >= 0 {
            if captured_local {
                let name_atom = ctx_intern_atom(c.ctx, name, name_len);
                emit_store_prop_atom(c, c.env_reg, name_atom, dst);
            } else {
                emit(c, make_inst_ab(Op::Mov, local_reg, dst));
            }
        } else if outer_depth > 0 {
            let env_r = emit_env_chain_walk(c, outer_depth);
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            emit_store_prop_atom(c, env_r, name_atom, dst);
            release_reg(c, env_r);
        } else {
            let slot = ctx_intern_global(c.ctx, name, name_len);
            emit(c, make_inst_a_u16(Op::StoreGlobal, dst, (u16)slot));
        }
        patch_jump(c, skip_idx);
        release_reg(c, rhs_r);
        release_reg(c, cur);
        if c.next_reg <= dst { c.next_reg = dst + 1; }
        return dst;
    }

    let rhs = compile_expr(c, node.right);

    let op = Op::Halt;
    if      op_tok == TokenKind::PlusEq    { op = Op::Add; }
    else if op_tok == TokenKind::MinusEq   { op = Op::Sub; }
    else if op_tok == TokenKind::StarEq    { op = Op::Mul; }
    else if op_tok == TokenKind::SlashEq   { op = Op::Div; }
    else if op_tok == TokenKind::PercentEq { op = Op::Mod; }
    else if op_tok == TokenKind::StarStarEq{ op = Op::Pow; }
    else if op_tok == TokenKind::AmpEq     { op = Op::BitAnd; }
    else if op_tok == TokenKind::PipeEq    { op = Op::BitOr; }
    else if op_tok == TokenKind::CaretEq   { op = Op::BitXor; }
    else if op_tok == TokenKind::LtLtEq    { op = Op::Shl; }
    else if op_tok == TokenKind::GtGtEq    { op = Op::Shr; }
    else if op_tok == TokenKind::GtGtGtEq  { op = Op::UShr; }
    else {
        c.had_error = true;
        return cur;
    }
    let dst = alloc_reg(c);
    emit(c, make_inst_abc(op, dst, cur, rhs));
    if local_idx >= 0 {
        if captured_local {
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            emit_store_prop_atom(c, c.env_reg, name_atom, dst);
        } else {
            emit(c, make_inst_ab(Op::Mov, local_reg, dst));
        }
    } else if outer_depth > 0 {
        let env_r = emit_env_chain_walk(c, outer_depth);
        let name_atom = ctx_intern_atom(c.ctx, name, name_len);
        emit_store_prop_atom(c, env_r, name_atom, dst);
        release_reg(c, env_r);
    } else {
        let slot = ctx_intern_global(c.ctx, name, name_len);
        emit(c, make_inst_a_u16(Op::StoreGlobal, dst, (u16)slot));
    }
    release_reg(c, rhs);
    release_reg(c, cur);
    if c.next_reg <= dst { c.next_reg = dst + 1; }
    return dst;
}

// =====================================================================
// Property access (Phase 3.1b). Member and Computed lower to
// LoadElem/StoreElem with the key in a register. For `obj.name` the
// key is a string constant we intern at compile time; for `obj[expr]`
// it's the result of compiling `expr`.
// =====================================================================

// Emit a LoadConst that loads `name` as an *atom* into a fresh
// register. Property names are deduplicated through the context's
// atom table — two `obj.foo` accesses in different functions share
// the same `ZjsString*`, so eventual hidden-class/IC lookups can use
// pointer-compare.
fn emit_load_name_string(c: Compiler*, name: char*, name_len: u32) -> u8 {
    let s = ctx_intern_atom(c.ctx, name, name_len);
    let val = zjs_cell_from_ptr((void*)s);
    let idx = add_const(c, val);
    let r = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, r, idx));
    return r;
}

// Like emit_load_name_string but takes an already-interned atom.
fn emit_load_atom(c: Compiler*, atom: ZjsString*) -> u8 {
    let val = zjs_cell_from_ptr((void*)atom);
    let idx = add_const(c, val);
    let r = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, r, idx));
    return r;
}

// IdentifierReference read inside a `with` body. Emits:
//   holder = WithLookup(name)              ; with-object binding name, or undefined
//   if (holder == undefined) goto fallback
//   dst = holder[name]                     ; found in a with-object
//   goto done
// fallback:
//   dst = <normal scope resolution>        ; local / env / global
// done:
// The fallback re-runs compile_expr with with_depth temporarily 0.
fn compile_ident_read_with(c: Compiler*, node: AstNode*) -> u8 {
    let name = c.source + node.start;
    let name_len = node.end - node.start;
    let name_atom = ctx_intern_atom(c.ctx, name, name_len);
    let name_r = emit_load_atom(c, name_atom);
    let holder = alloc_reg(c);
    emit(c, make_inst_ab(Op::WithLookup, holder, name_r));
    release_reg(c, name_r);
    let dst = alloc_reg(c);
    let jmp_fb = emit(c, make_inst_a_i16(Op::JmpIfNullish, holder, 0));
    // Found: dst = holder[name].
    emit_load_prop_atom(c, dst, holder, name_atom);
    let jmp_done = emit(c, make_inst_i16(Op::Jmp, 0));
    patch_jump(c, jmp_fb);
    // Fallback: normal resolution (with_depth = 0 so we don't recurse).
    let saved_wd = c.with_depth;
    let saved_borrow = c.borrow_local_ok;
    c.with_depth = 0;
    c.borrow_local_ok = false;
    let normal = compile_expr(c, node);
    c.borrow_local_ok = saved_borrow;
    c.with_depth = saved_wd;
    emit(c, make_inst_ab(Op::Mov, dst, normal));
    release_reg(c, normal);
    release_reg(c, holder);
    patch_jump(c, jmp_done);
    return dst;
}

// Property LOAD by atom name. Uses the ic-cached LoadProp opcode when
// the slot fits in the 8-bit operand field, otherwise falls back to a
// LoadElem with the atom materialized into a fresh key register. The
// fallback is uncached (slower) but spec-correct — without it, a
// function whose enclosing compiler accumulates >255 distinct IC names
// silently truncates the slot index and reads/writes the wrong slot
// on its env / object.
fn emit_load_prop_atom(c: Compiler*, dst: u8, obj_r: u8, name_atom: ZjsString*) -> void {
    let ic = alloc_ic_slot(c, name_atom);
    if ic <= 255 {
        emit(c, make_inst_abc(Op::LoadProp, dst, obj_r, (u8)ic));
        return;
    }
    let key_r = emit_load_atom(c, name_atom);
    emit(c, make_inst_abc(Op::LoadElem, dst, obj_r, key_r));
    release_reg(c, key_r);
}

fn emit_store_prop_atom(c: Compiler*, obj_r: u8, name_atom: ZjsString*, val_r: u8) -> void {
    let ic = alloc_ic_slot(c, name_atom);
    if ic <= 255 {
        emit(c, make_inst_abc(Op::StoreProp, obj_r, (u8)ic, val_r));
        return;
    }
    let key_r = emit_load_atom(c, name_atom);
    emit(c, make_inst_abc(Op::StoreElem, obj_r, key_r, val_r));
    release_reg(c, key_r);
}

fn compile_member(c: Compiler*, node: AstNode*) -> u8 {
    // `super.x` (without call) — read the property from the enclosing
    // class's parent.prototype rather than dispatching to compile_expr
    // on the SuperExpr leaf (which has no standalone value). compile_call
    // already handles super.x(...) via is_super_member; this is the
    // bare-property-access variant.
    if node.left != NULL && node.left.kind == NodeKind::SuperExpr {
        if c.enclosing_class_parent == NULL {
            c.had_error = true;
            return alloc_reg(c);
        }
        let parent_r = compile_expr(c, c.enclosing_class_parent);
        // Instance context: super.x reads parent.prototype.x. Static
        // context (static field init / static block): super.x reads
        // parent.x directly (the home object is the class constructor).
        let holder_r: u8 = parent_r;
        if !c.in_static_element {
            let proto_key = emit_load_name_string(c, (char*)"prototype", 9);
            holder_r = alloc_reg(c);
            emit(c, make_inst_abc(Op::LoadElem, holder_r, parent_r, proto_key));
            if proto_key + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            if parent_r != holder_r && parent_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        }
        let key_r = emit_load_name_string(c, c.source + node.name_start, node.name_length);
        let dst = alloc_dst(c);
        emit(c, make_inst_abc(Op::LoadElem, dst, holder_r, key_r));
        if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        if holder_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        if c.next_reg <= dst { c.next_reg = dst + 1; }
        return dst;
    }

    // LoadProp / LoadElem read obj before writing dst, so the object
    // expression can always borrow (we'd never mutate the receiver
    // before using it). The dst honors the caller's preferred_dst
    // hint — if the surrounding op already chose where the value
    // should land, write straight there.
    let saved_pd = c.preferred_dst;
    c.preferred_dst = -1;
    let saved_borrow = c.borrow_local_ok;
    c.borrow_local_ok = true;
    let name_atom: ZjsString* = NULL;
    if is_private_name(c, node.name_start, node.name_length) {
        name_atom = mangle_private_name(c, node.name_start, node.name_length);
        if name_atom == NULL { return 0; }  // SyntaxError already armed
    } else {
        name_atom = ctx_intern_atom(c.ctx, c.source + node.name_start, node.name_length);
    }
    let ic = alloc_ic_slot(c, name_atom);
    if ic > 255 {
        let obj_r = compile_expr(c, node.left);
        c.borrow_local_ok = saved_borrow;
        // Use the already-interned (possibly mangled) atom so the
        // fallback honors private-name mangling too.
        let key_r = emit_load_atom(c, name_atom);
        c.preferred_dst = saved_pd;
        let dst = alloc_dst(c);
        emit(c, make_inst_abc(Op::LoadElem, dst, obj_r, key_r));
        release_reg(c, key_r);
        release_reg(c, obj_r);
        if c.next_reg <= dst { c.next_reg = dst + 1; }
        return dst;
    }

    let obj_r = compile_expr(c, node.left);
    c.borrow_local_ok = saved_borrow;
    c.preferred_dst = saved_pd;
    let dst = alloc_dst(c);
    emit(c, make_inst_abc(Op::LoadProp, dst, obj_r, (u8)ic));
    release_reg(c, obj_r);
    if c.next_reg <= dst { c.next_reg = dst + 1; }
    return dst;
}

fn compile_computed(c: Compiler*, node: AstNode*) -> u8 {
    let obj_r = compile_expr(c, node.left);
    let key_r = compile_expr(c, node.right);
    let dst = alloc_reg(c);
    emit(c, make_inst_abc(Op::LoadElem, dst, obj_r, key_r));
    release_reg(c, key_r);
    release_reg(c, obj_r);
    if c.next_reg <= dst { c.next_reg = dst + 1; }
    return dst;
}

// Compile an optional-chain expression (a Member/Computed/Call tree
// whose leftmost spine contains at least one Optional* node) as a
// single short-circuit unit. Per ECMA-262 §13.3.9, once any `?.` in
// the chain sees a nullish LHS, every subsequent access in the same
// chain is skipped and the chain evaluates to `undefined`.
//
// Strategy: walk the leftmost spine top-down collecting operations,
// then compile them in source order. Each Optional* op emits a
// JmpIfNullish on the running value, targeting a shared "end-handler"
// that loads `undefined` into the result register. Non-optional ops
// in the chain compile normally — they only short-circuit because a
// PREVIOUS `?.` already jumped past them.
//
// Calls in the chain need receiver tracking: a Member/Computed
// produces a value AND remembers the object it was read from, so
// that a following Call/OptionalCall can pass it as `this`. We keep
// the most recent receiver in a dedicated register.
fn compile_optional_chain(c: Compiler*, node: AstNode*) -> u8 {
    let CHAIN_CAP: u32 = 32;
    let ops: AstNode*[32];
    let op_count: u32 = 0;
    let cur = node;
    while cur != NULL {
        let k = cur.kind;
        let is_chain_op: bool =
            k == NodeKind::Member
            || k == NodeKind::Computed
            || k == NodeKind::Call
            || k == NodeKind::OptionalMember
            || k == NodeKind::OptionalComputed
            || k == NodeKind::OptionalCall;
        if !is_chain_op { break; }
        if op_count >= CHAIN_CAP {
            // Pathological chain length — emit a no-op and bail.
            c.had_error = true;
            return alloc_reg(c);
        }
        ops[op_count] = cur;
        op_count = op_count + 1;
        cur = cur.left;
    }
    // `cur` is the chain's base expression (Identifier, Paren, literal, etc.).
    // op_count must be >= 1 because the caller only routes here when
    // at least one Optional* is in the spine.

    // Reserve dst + receiver scratch up front so all chain steps share
    // a stable layout. recv starts as undefined; Member/Computed update
    // it to the prior object, Call consumes + resets it.
    let dst  = alloc_reg(c);
    let recv = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadUndefined, recv));

    let base_r = compile_expr(c, cur);
    if base_r != dst { emit(c, make_inst_ab(Op::Mov, dst, base_r)); }
    release_reg(c, base_r);
    if c.next_reg <= recv + 1 { c.next_reg = recv + 1; }

    // Indices into c.code of the JmpIfNullish placeholders to patch
    // to the end-handler. Sized in lock-step with chain ops.
    let end_jumps: u32[32];
    let end_jump_count: u32 = 0;

    let i = op_count;
    while i > 0 {
        i = i - 1;
        let op = ops[i];
        let k = op.kind;
        let is_optional: bool =
            k == NodeKind::OptionalMember
            || k == NodeKind::OptionalComputed
            || k == NodeKind::OptionalCall;
        if is_optional {
            let jmp_idx = emit(c, make_inst_a_i16(Op::JmpIfNullish, dst, 0));
            end_jumps[end_jump_count] = jmp_idx;
            end_jump_count = end_jump_count + 1;
        }

        if k == NodeKind::Member || k == NodeKind::OptionalMember {
            // Save current dst as receiver for any subsequent Call.
            emit(c, make_inst_ab(Op::Mov, recv, dst));
            let name_atom = ctx_intern_atom(c.ctx, c.source + op.name_start, op.name_length);
            let ic = alloc_ic_slot(c, name_atom);
            if ic <= 255 {
                emit(c, make_inst_abc(Op::LoadProp, dst, dst, (u8)ic));
            } else {
                let key_r = emit_load_atom(c, name_atom);
                emit(c, make_inst_abc(Op::LoadElem, dst, dst, key_r));
                release_reg(c, key_r);
            }
        } else if k == NodeKind::Computed || k == NodeKind::OptionalComputed {
            emit(c, make_inst_ab(Op::Mov, recv, dst));
            let key_r = compile_expr(c, op.right);
            emit(c, make_inst_abc(Op::LoadElem, dst, dst, key_r));
            release_reg(c, key_r);
        } else if k == NodeKind::Call || k == NodeKind::OptionalCall {
            // MethodInvoke layout: regs[base] = callee, regs[base+1] =
            // receiver, regs[base+2..] = args. We currently have callee
            // in dst and receiver in recv. Reserve a fresh contiguous
            // frame and stage them.
            //
            // Spread-args in optional calls aren't supported yet — fall
            // out as a compile error rather than miscompile silently.
            let has_spread: bool = false;
            let sj: u32 = 0;
            while sj < op.children_count {
                if op.children[sj].kind == NodeKind::Spread { has_spread = true; break; }
                sj = sj + 1;
            }
            if has_spread {
                c.had_error = true;
                return dst;
            }
            let arg_count: u8 = (u8)op.children_count;
            let call_base = c.next_reg;
            let slots_needed: u8 = 2 + arg_count;
            let r: u8 = 0;
            while r < slots_needed { alloc_reg(c); r = r + 1; }
            emit(c, make_inst_ab(Op::Mov, call_base,     dst));
            emit(c, make_inst_ab(Op::Mov, call_base + 1, recv));
            let j: u32 = 0;
            while j < op.children_count {
                let target = call_base + 2 + (u8)j;
                let saved_pd = c.preferred_dst;
                c.preferred_dst = (i32)target;
                let arg_r = compile_expr(c, op.children[j]);
                c.preferred_dst = saved_pd;
                if arg_r != target {
                    emit(c, make_inst_ab(Op::Mov, target, arg_r));
                    if arg_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                }
                j = j + 1;
            }
            emit(c, make_inst_abc(Op::MethodInvoke, call_base, call_base, arg_count));
            if call_base != dst {
                emit(c, make_inst_ab(Op::Mov, dst, call_base));
            }
            c.next_reg = recv + 1;
            // After a call, the receiver chain restarts at undefined.
            emit(c, make_inst_a(Op::LoadUndefined, recv));
        }
    }

    // Chain finished successfully — skip past the end-handler.
    let past_idx = emit(c, make_inst_i16(Op::Jmp, 0));
    // End-handler entry — patch all JmpIfNullish placeholders to land here.
    let pj: u32 = 0;
    while pj < end_jump_count {
        patch_jump(c, end_jumps[pj]);
        pj = pj + 1;
    }
    emit(c, make_inst_a(Op::LoadUndefined, dst));
    // Patch the unconditional jump to fall through here.
    patch_jump(c, past_idx);

    // Receiver scratch isn't observable past the chain — release.
    release_reg(c, recv);
    if c.next_reg <= dst { c.next_reg = dst + 1; }
    return dst;
}

// Build the obj_reg + key_reg pair for a property-target assignment.
// Stores the registers via out-pointers (passed as registers below
// because Zen-c structs are the cleanest way to return two values).
struct PropTarget {
    obj_reg: u8;
    key_reg: u8;
}

fn compile_property_target(c: Compiler*, target: AstNode*) -> PropTarget {
    let obj_r = compile_expr(c, target.left);
    let key_r: u8 = 0;
    if target.kind == NodeKind::Member {
        if is_private_name(c, target.name_start, target.name_length) {
            let atom = mangle_private_name(c, target.name_start, target.name_length);
            if atom == NULL {
                // SyntaxError armed. Return dummy regs; outer error gate
                // handles the early exit.
                return PropTarget{ obj_reg: obj_r, key_reg: 0 };
            }
            key_r = emit_load_atom(c, atom);
        } else {
            key_r = emit_load_name_string(c, c.source + target.name_start, target.name_length);
        }
    } else {
        key_r = compile_expr(c, target.right);
    }
    return PropTarget{ obj_reg: obj_r, key_reg: key_r };
}

fn compile_assignment_to_property(c: Compiler*, target: AstNode*, op_tok: TokenKind, rhs: AstNode*) -> u8 {
    // Fast path for Member-target simple assignment (`obj.name = rhs`):
    // emit StoreProp with an IC slot. Computed targets and compound
    // operators (`+=` etc.) still go through the LoadElem/StoreElem
    // path.
    if target.kind == NodeKind::Member && op_tok == TokenKind::Eq {
        let name_atom: ZjsString* = NULL;
        if is_private_name(c, target.name_start, target.name_length) {
            name_atom = mangle_private_name(c, target.name_start, target.name_length);
            if name_atom == NULL { return 0; }
        } else {
            name_atom = ctx_intern_atom(c.ctx,
                                        c.source + target.name_start,
                                        target.name_length);
        }
        let ic = alloc_ic_slot(c, name_atom);
        if ic <= 255 {
            // StoreProp reads obj+value before writing — borrow is
            // always safe for obj_r, and safe for v when the LHS
            // (obj_r's compile_expr) is itself pure.
            let saved_borrow = c.borrow_local_ok;
            let rhs_pure = expr_is_simple_pure(rhs);
            let lhs_pure = expr_is_simple_pure(target.left);
            if rhs_pure { c.borrow_local_ok = true; }
            let obj_r = compile_expr(c, target.left);
            if lhs_pure { c.borrow_local_ok = true; }
            else        { c.borrow_local_ok = saved_borrow; }
            let v = compile_expr(c, rhs);
            c.borrow_local_ok = saved_borrow;
            emit(c, make_inst_abc(Op::StoreProp, obj_r, (u8)ic, v));
            return v;
        }
        // Out of IC slots — fall through to the generic path.
    }

    let pair = compile_property_target(c, target);
    let obj_r = pair.obj_reg;
    let key_r = pair.key_reg;

    if op_tok == TokenKind::Eq {
        let v = compile_expr(c, rhs);
        emit(c, make_inst_abc(Op::StoreElem, obj_r, key_r, v));
        return v;
    }

    // Compound (o.x += rhs): load current, op, store, return new value.
    let cur = alloc_reg(c);
    emit(c, make_inst_abc(Op::LoadElem, cur, obj_r, key_r));

    // Logical-assignment shape — see compile_assignment for the matching
    // ident-target case. Short-circuits before RHS evaluation; the store
    // is skipped entirely when the LHS already satisfies the predicate.
    let is_logical_assign: bool =
        op_tok == TokenKind::AmpAmpEq
        || op_tok == TokenKind::PipePipeEq
        || op_tok == TokenKind::QuestionQuestionEq;
    if is_logical_assign {
        let dst = alloc_reg(c);
        emit(c, make_inst_ab(Op::Mov, dst, cur));
        let jmp_op = Op::JmpIfFalse;
        if      op_tok == TokenKind::PipePipeEq          { jmp_op = Op::JmpIfTrue; }
        else if op_tok == TokenKind::QuestionQuestionEq  { jmp_op = Op::JmpIfNotNullish; }
        let skip_idx = emit(c, make_inst_a_i16(jmp_op, dst, 0));
        let rhs_r = compile_expr(c, rhs);
        emit(c, make_inst_ab(Op::Mov, dst, rhs_r));
        emit(c, make_inst_abc(Op::StoreElem, obj_r, key_r, dst));
        patch_jump(c, skip_idx);
        release_reg(c, rhs_r);
        release_reg(c, cur);
        if c.next_reg <= dst { c.next_reg = dst + 1; }
        return dst;
    }

    let rhs_r = compile_expr(c, rhs);

    let op = Op::Halt;
    if      op_tok == TokenKind::PlusEq    { op = Op::Add; }
    else if op_tok == TokenKind::MinusEq   { op = Op::Sub; }
    else if op_tok == TokenKind::StarEq    { op = Op::Mul; }
    else if op_tok == TokenKind::SlashEq   { op = Op::Div; }
    else if op_tok == TokenKind::PercentEq { op = Op::Mod; }
    else if op_tok == TokenKind::StarStarEq{ op = Op::Pow; }
    else if op_tok == TokenKind::AmpEq     { op = Op::BitAnd; }
    else if op_tok == TokenKind::PipeEq    { op = Op::BitOr; }
    else if op_tok == TokenKind::CaretEq   { op = Op::BitXor; }
    else if op_tok == TokenKind::LtLtEq    { op = Op::Shl; }
    else if op_tok == TokenKind::GtGtEq    { op = Op::Shr; }
    else if op_tok == TokenKind::GtGtGtEq  { op = Op::UShr; }
    else {
        c.had_error = true;
        return cur;
    }
    let dst = alloc_reg(c);
    emit(c, make_inst_abc(op, dst, cur, rhs_r));
    emit(c, make_inst_abc(Op::StoreElem, obj_r, key_r, dst));
    release_reg(c, rhs_r);
    release_reg(c, cur);
    if c.next_reg <= dst { c.next_reg = dst + 1; }
    return dst;
}

// --- Object & array literals ----------------------------------------

fn compile_object_literal(c: Compiler*, node: AstNode*) -> u8 {
    let dst = alloc_reg(c);
    emit(c, make_inst_a(Op::NewObject, dst));

    let i: u32 = 0;
    while i < node.children_count {
        let prop = node.children[i];
        // `{ ...src }` — copy own enumerable string-keyed props from src.
        if prop.kind == NodeKind::Spread {
            let src_r = compile_expr(c, prop.left);
            emit(c, make_inst_ab(Op::ObjectSpread, dst, src_r));
            if src_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            i = i + 1;
            continue;
        }
        if prop.kind != NodeKind::ObjectProp {
            c.had_error = true;
            i = i + 1;
            continue;
        }

        // Computed-key form: `{ [expr]: value }`. name_length == 0 is
        // the sentinel; the expression to evaluate at runtime is on
        // prop.third. StoreElem coerces the key to a string at runtime.
        if prop.name_length == 0 && prop.third != NULL {
            let key_r = compile_expr(c, prop.third);
            let val_r = compile_expr(c, prop.left);
            if prop.op == TokenKind::KwGet {
                emit(c, make_inst_abc(Op::DefineGetter, dst, key_r, val_r));
            } else if prop.op == TokenKind::KwSet {
                emit(c, make_inst_abc(Op::DefineSetter, dst, key_r, val_r));
            } else {
                // Computed keys are never the B.3.1 `__proto__` proto-setter
                // — `{ ['__proto__']: x }` creates an own property. Use
                // CreateDataProperty (define-own), not [[Set]].
                emit(c, make_inst_abc(Op::InitObjData, dst, key_r, val_r));
            }
            release_reg(c, val_r);
            release_reg(c, key_r);
            i = i + 1;
            continue;
        }

        // Key: identifier bytes, OR a quoted-string-literal slice with
        // the quotes stripped. (Real escape decoding is still TODO — we
        // handle only the common no-escape case.)
        let first_byte = c.source[prop.name_start];
        let name_start = prop.name_start;
        let name_len   = prop.name_length;
        if first_byte == 34 || first_byte == 39 {
            // Strip the leading + trailing quote. Assumes no embedded
            // escapes; tests using `\"` etc. still error.
            if name_len < 2 {
                c.had_error = true; i = i + 1; continue;
            }
            name_start = name_start + 1;
            name_len   = name_len - 2;
        }

        // ECMA-262 B.3.1: the colon form `__proto__: AssignmentExpression`
        // (non-computed, not a method/accessor) sets the object's
        // [[Prototype]] instead of creating an own property. Shorthand
        // `{ __proto__ }` and methods `{ __proto__() {} }` are excluded
        // (prop.bool_value marks the colon form). The function value, if
        // anonymous, is NOT named "__proto__" (isProtoSetter skips
        // NamedEvaluation), so we bypass maybe_infer_anon_name here too.
        let is_proto_setter: int = 0;
        if prop.bool_value && prop.op != TokenKind::KwGet && prop.op != TokenKind::KwSet {
            raw {
                is_proto_setter = (name_len == 9
                    && memcmp(c->source + name_start, "__proto__", 9) == 0) ? 1 : 0;
            }
        }
        if is_proto_setter != 0 {
            let val_r = compile_expr(c, prop.left);
            // SetProto: a=proto(value), b=obj. Non-Object/Null values are
            // a no-op (matches B.3.1's "Type(V) is Object or Null" guard).
            emit(c, make_inst_ab(Op::SetProto, val_r, dst));
            release_reg(c, val_r);
            i = i + 1;
            continue;
        }

        let key_r = emit_load_name_string(c,
                                          c.source + name_start,
                                          name_len);
        let val_r = compile_expr(c, prop.left);
        // Anonymous function/arrow/class on the RHS of `{ key: <init> }`
        // gets a synthetic `.name = key`. Getters/setters are skipped —
        // they have their own NamedEvaluation rules (`"get key"` /
        // `"set key"`), not implemented yet.
        if prop.op != TokenKind::KwGet && prop.op != TokenKind::KwSet {
            maybe_infer_anon_name(c, prop.left, val_r,
                                  c.source + name_start, name_len);
        }
        if prop.op == TokenKind::KwGet {
            emit(c, make_inst_abc(Op::DefineGetter, dst, key_r, val_r));
        } else if prop.op == TokenKind::KwSet {
            emit(c, make_inst_abc(Op::DefineSetter, dst, key_r, val_r));
        } else {
            // Data property — CreateDataProperty (define-own), NOT [[Set]],
            // so an inherited setter (e.g. Object.prototype `__proto__`)
            // is never invoked. Covers shorthand `{ __proto__ }` too.
            emit(c, make_inst_abc(Op::InitObjData, dst, key_r, val_r));
        }
        release_reg(c, val_r);
        release_reg(c, key_r);
        i = i + 1;
    }

    if c.next_reg <= dst { c.next_reg = dst + 1; }
    return dst;
}

fn compile_array_literal(c: Compiler*, node: AstNode*) -> u8 {
    let count: u32 = node.children_count;

    if count == 0 {
        let dst = alloc_reg(c);
        emit(c, make_inst_abc(Op::NewArray, dst, 0, 0));
        return dst;
    }

    // Spread element check: if any child is Spread, switch to the
    // dynamic-build path (NewArray + ArrayPush / ArraySpread). The
    // fixed-shape path below packs elements into consecutive regs
    // and lets NewArray slurp them in one shot — faster, but only
    // works when the element count is known at compile time.
    let has_spread: bool = false;
    let s_i: u32 = 0;
    while s_i < count {
        if node.children[s_i].kind == NodeKind::Spread { has_spread = true; break; }
        s_i = s_i + 1;
    }

    if has_spread {
        let dst = alloc_reg(c);
        emit(c, make_inst_abc(Op::NewArray, dst, 0, 0));
        let j: u32 = 0;
        while j < count {
            let ch = node.children[j];
            if ch.kind == NodeKind::Spread {
                let src_r = compile_expr(c, ch.left);
                emit(c, make_inst_ab(Op::ArraySpread, dst, src_r));
                if src_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            } else {
                let val_r = compile_expr(c, ch);
                emit(c, make_inst_ab(Op::ArrayPush, dst, val_r));
                if val_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            j = j + 1;
        }
        return dst;
    }

    // Reserve consecutive slots for elements. Result reuses base (the
    // interpreter copies elements out before writing dst).
    let cnt: u8 = (u8)count;
    let base = c.next_reg;
    let i: u8 = 0;
    while i < cnt {
        alloc_reg(c);
        i = i + 1;
    }

    let j2: u8 = 0;
    while j2 < cnt {
        let elem_r = compile_expr(c, node.children[j2]);
        let target = base + j2;
        if elem_r != target {
            emit(c, make_inst_ab(Op::Mov, target, elem_r));
            if elem_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        }
        j2 = j2 + 1;
    }

    emit(c, make_inst_abc(Op::NewArray, base, base, cnt));
    c.next_reg = base + 1;
    if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
    return base;
}

// =====================================================================
// String literals. Resolve escape sequences at compile time, intern
// the resulting bytes as a heap string on the context, push the cell
// pointer into this function's constant pool.
// =====================================================================

// Lex(`/pattern/flags`) → two interned strings: the pattern (between
// the slashes) and the flag letters (after the closing slash). The
// node's source range covers the whole literal including both slashes
// and flags. Emit `Op::NewRegex dst, src_idx, flags_idx`; the
// interpreter allocates a fresh ZjsRegExp at each execution so the
// `g`/`y` lastIndex state is per-instance.
fn compile_regex_literal(c: Compiler*, node: AstNode*) -> u8 {
    // Walk backward from end to find the closing slash. After it lies
    // the flag letters; before it the pattern body. The opening slash
    // is at node.start.
    let src = c.source;
    let last_slash: u32 = node.start;
    let i = node.end;
    while i > node.start + 1 {
        if src[i - 1] == (char)'/' { last_slash = i - 1; break; }
        i = i - 1;
    }
    let pat_start = node.start + 1;
    let pat_len   = if last_slash > pat_start { last_slash - pat_start } else { 0 };
    let flag_start = last_slash + 1;
    let flag_len   = if node.end > flag_start { node.end - flag_start } else { 0 };

    let pat_str   = ctx_intern_string(c.ctx, src + pat_start,  pat_len);
    let flag_str  = ctx_intern_string(c.ctx, src + flag_start, flag_len);
    let pat_idx   = add_const(c, pat_str);
    let flag_idx  = add_const(c, flag_str);

    // NewRegex packs both const indices into the b/c u8 operands.
    // When either grows past 255 (moment ships ~30 regex literals
    // plus hundreds of string constants and tips the pool over the
    // edge) fall back to LoadConst-into-temp + NewRegexR. The fast
    // path emits a single op; the slow path emits three.
    let dst = alloc_reg(c);
    if pat_idx <= 255 && flag_idx <= 255 {
        emit(c, make_inst_abc(Op::NewRegex, dst, (u8)pat_idx, (u8)flag_idx));
        return dst;
    }
    let pat_reg = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, pat_reg, (u16)pat_idx));
    let flag_reg = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, flag_reg, (u16)flag_idx));
    emit(c, make_inst_abc(Op::NewRegexR, dst, pat_reg, flag_reg));
    release_reg(c, flag_reg);
    release_reg(c, pat_reg);
    return dst;
}

// Decode a JS string-literal body (excluding the surrounding quotes)
// from src[raw_start..raw_start+raw_len] into buf. Returns the number
// of bytes written to buf. Handles \xXX, \uXXXX, \u{...}, \n, \t, \r,
// \b, \f, \v, \0, line-continuations, and the trivial \" \' \\ cases.
// buf must have room for raw_len + 1 bytes (escapes can only shrink).
fn decode_string_body(src: char*, raw_start: u32, raw_len: u32, buf: char*) -> u32 {
    let out: u32 = 0;
    let i: u32 = 0;
    while i < raw_len {
        let ch = src[raw_start + i];
        if ch == 92 && i + 1 < raw_len {        // backslash
            let nx = src[raw_start + i + 1];
            // \<LineTerminator> — line continuation: produces nothing.
            if nx == 10 {                         // LF
                i = i + 2;
                continue;
            }
            if nx == 13 {                         // CR or CR-LF
                if i + 2 < raw_len && src[raw_start + i + 2] == 10 { i = i + 3; }
                else                                                { i = i + 2; }
                continue;
            }
            // \xXX — 2-hex-digit byte.
            if nx == 120 && i + 3 < raw_len {    // 'x'
                let h1: int = 0;
                let h2: int = 0;
                let c1 = src[raw_start + i + 2];
                let c2 = src[raw_start + i + 3];
                raw {
                    h1 = (c1 >= '0' && c1 <= '9') ? c1 - '0'
                       : (c1 >= 'a' && c1 <= 'f') ? c1 - 'a' + 10
                       : (c1 >= 'A' && c1 <= 'F') ? c1 - 'A' + 10 : -1;
                    h2 = (c2 >= '0' && c2 <= '9') ? c2 - '0'
                       : (c2 >= 'a' && c2 <= 'f') ? c2 - 'a' + 10
                       : (c2 >= 'A' && c2 <= 'F') ? c2 - 'A' + 10 : -1;
                }
                if h1 >= 0 && h2 >= 0 {
                    buf[out] = (char)((h1 << 4) | h2);
                    out = out + 1;
                    i = i + 4;
                    continue;
                }
            }
            // \uXXXX / \u{...} — UTF-8 encode into buf.
            if nx == 117 {
                let cp: u32 = 0;
                let consumed: u32 = 0;
                if i + 2 < raw_len && src[raw_start + i + 2] == 123 {
                    let p: u32 = i + 3;
                    let valid: bool = true;
                    while p < raw_len {
                        let cc = src[raw_start + p];
                        if cc == 125 { break; }
                        let d: int = -1;
                        raw {
                            d = (cc >= '0' && cc <= '9') ? cc - '0'
                              : (cc >= 'a' && cc <= 'f') ? cc - 'a' + 10
                              : (cc >= 'A' && cc <= 'F') ? cc - 'A' + 10 : -1;
                        }
                        if d < 0 { valid = false; break; }
                        cp = cp * 16 + (u32)d;
                        p = p + 1;
                    }
                    if valid && p < raw_len && src[raw_start + p] == 125 {
                        consumed = p - i + 1;
                    }
                } else if i + 5 < raw_len {
                    let h1: int = -1; let h2: int = -1;
                    let h3: int = -1; let h4: int = -1;
                    let c1 = src[raw_start + i + 2];
                    let c2 = src[raw_start + i + 3];
                    let c3 = src[raw_start + i + 4];
                    let c4 = src[raw_start + i + 5];
                    raw {
                        h1 = (c1 >= '0' && c1 <= '9') ? c1 - '0' : (c1 >= 'a' && c1 <= 'f') ? c1 - 'a' + 10 : (c1 >= 'A' && c1 <= 'F') ? c1 - 'A' + 10 : -1;
                        h2 = (c2 >= '0' && c2 <= '9') ? c2 - '0' : (c2 >= 'a' && c2 <= 'f') ? c2 - 'a' + 10 : (c2 >= 'A' && c2 <= 'F') ? c2 - 'A' + 10 : -1;
                        h3 = (c3 >= '0' && c3 <= '9') ? c3 - '0' : (c3 >= 'a' && c3 <= 'f') ? c3 - 'a' + 10 : (c3 >= 'A' && c3 <= 'F') ? c3 - 'A' + 10 : -1;
                        h4 = (c4 >= '0' && c4 <= '9') ? c4 - '0' : (c4 >= 'a' && c4 <= 'f') ? c4 - 'a' + 10 : (c4 >= 'A' && c4 <= 'F') ? c4 - 'A' + 10 : -1;
                    }
                    if h1 >= 0 && h2 >= 0 && h3 >= 0 && h4 >= 0 {
                        cp = (u32)((h1 << 12) | (h2 << 8) | (h3 << 4) | h4);
                        consumed = 6;
                    }
                }
                if consumed > 0 {
                    let bp: char* = NULL;
                    let out_off = out;
                    raw { bp = &buf[out_off]; }
                    let n = Utf8::encode((rune)cp, bp);
                    out = out + (u32)n;
                    i = i + consumed;
                    continue;
                }
            }
            let mapped: char = 0;
            if      nx == 110 { mapped = 10; }   // \n
            else if nx == 116 { mapped = 9; }    // \t
            else if nx == 114 { mapped = 13; }   // \r
            else if nx == 98  { mapped = 8; }    // \b
            else if nx == 102 { mapped = 12; }   // \f
            else if nx == 118 { mapped = 11; }   // \v
            else if nx == 48  { mapped = 0; }    // \0
            else              { mapped = nx; }   // \\ \" \' and anything else: literal
            buf[out] = mapped;
            out = out + 1;
            i = i + 2;
        } else {
            buf[out] = ch;
            out = out + 1;
            i = i + 1;
        }
    }
    return out;
}

fn compile_string_literal(c: Compiler*, node: AstNode*) -> u8 {
    // node.start/end include the surrounding quotes.
    let raw_start = node.start + 1;
    let raw_end   = if node.end > 0 { node.end - 1 } else { node.start + 1 };
    let raw_len   = if raw_end > raw_start { raw_end - raw_start } else { 0 };

    let buf = alloc_n<char>((usize)(raw_len + 1));
    let out = decode_string_body(c.source, raw_start, raw_len, buf);
    buf[out] = (char)0;
    let s = ctx_intern_atom_take(c.ctx, buf, out);
    let val = zjs_cell_from_ptr((void*)s);
    let idx = add_const(c, val);
    let dst = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, dst, idx));
    return dst;
}

// Template-literal building blocks. A TemplatePart is a raw literal
// segment (no surrounding backticks, may be empty). A TemplateLit has
// `N+1` parts interleaved with `N` expressions. We compile it as a
// left-fold of string concats; the runtime Add op promotes non-string
// operands via ToString (which throws TypeError on Symbol — that's how
// `\`${sym}\`` reports the spec-required error).
fn compile_template_part(c: Compiler*, node: AstNode*) -> u8 {
    let raw_start = node.start;
    let raw_end   = node.end;
    let raw_len   = if raw_end > raw_start { raw_end - raw_start } else { 0 };
    // Untagged-template escape rules are strict — invalid \x / \u / legacy
    // octal etc. are a SyntaxError per ECMA-262 §12.8.6.1. Tagged templates
    // get the looser cooked=undefined treatment via tmpl_intern_cooked;
    // here we're on the untagged path and any invalid escape kills the
    // compile.
    if !template_escapes_are_valid(c.source, raw_start, raw_len) {
        c.had_error = true;
        return alloc_reg(c);
    }
    let buf = alloc_n<char>((usize)(raw_len + 1));
    let out = decode_string_body(c.source, raw_start, raw_len, buf);
    buf[out] = (char)0;
    let s = ctx_intern_atom_take(c.ctx, buf, out);
    let val = zjs_cell_from_ptr((void*)s);
    let idx = add_const(c, val);
    let dst = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, dst, idx));
    return dst;
}

// Compile-time helpers for tagged-template caching.

// Tagged-template cooked decode. Returns NULL if the segment carries
// an invalid escape (`\u00g`, `\u{g`, `\u{10FFFFF}`, truncated `\x`,
// etc.) — per ECMA-262 §12.8.6.1, that index in the cooked array is
// `undefined` and only raw[i] sees the source text. For untagged
// templates the same form is a SyntaxError; the compiler only routes
// here for tagged-template construction.
fn tmpl_intern_cooked(c: Compiler*, node: AstNode*) -> ZjsString* {
    let raw_start = node.start;
    let raw_end   = node.end;
    let raw_len   = if raw_end > raw_start { raw_end - raw_start } else { 0 };
    if !template_escapes_are_valid(c.source, raw_start, raw_len) { return NULL; }
    let buf = alloc_n<char>((usize)(raw_len + 1));
    let out = decode_string_body(c.source, raw_start, raw_len, buf);
    buf[out] = (char)0;
    return ctx_intern_atom_take(c.ctx, buf, out);
}

// Scan a template segment's source bytes for an invalid escape. Mirrors
// the well-formed-escape paths in decode_string_body — if any `\x` /
// `\uXXXX` / `\u{...}` form fails to parse cleanly OR a `\u{...}`
// codepoint exceeds U+10FFFF, returns false.
fn template_escapes_are_valid(src: char*, start: u32, len: u32) -> bool {
    let i: u32 = 0;
    while i < len {
        let ch = (u8)src[start + i];
        if ch != (u8)'\\' { i = i + 1; continue; }
        if i + 1 >= len { return false; }
        let nx = (u8)src[start + i + 1];
        if nx == (u8)'x' {
            // Need exactly two hex digits.
            if i + 3 >= len { return false; }
            let c1 = (u8)src[start + i + 2];
            let c2 = (u8)src[start + i + 3];
            if !is_hex_digit_byte(c1) || !is_hex_digit_byte(c2) { return false; }
            i = i + 4;
            continue;
        }
        // Octal / decimal numeric escapes — \1..\9, plus \0 followed
        // by another digit. Spec: templates forbid these even though
        // string literals (in non-strict) allow \0 → NUL. Allow plain
        // `\0` (next char is not a digit).
        if nx >= (u8)'1' && nx <= (u8)'9' { return false; }
        if nx == (u8)'0' && i + 2 < len {
            let look = (u8)src[start + i + 2];
            if look >= (u8)'0' && look <= (u8)'9' { return false; }
        }
        if nx == (u8)'u' {
            if i + 2 >= len { return false; }
            let after = (u8)src[start + i + 2];
            if after == (u8)'{' {
                // `\u{ HexDigits }` — at least one digit, terminated.
                let p: u32 = i + 3;
                let cp: u32 = 0;
                let saw_digit: bool = false;
                while p < len {
                    let cc = (u8)src[start + p];
                    if cc == (u8)'}' { break; }
                    if !is_hex_digit_byte(cc) { return false; }
                    let d: u32 = hex_digit_value(cc);
                    cp = cp * 16 + d;
                    if cp > 1114111 { return false; }   // > U+10FFFF
                    saw_digit = true;
                    p = p + 1;
                }
                if p >= len || (u8)src[start + p] != (u8)'}' { return false; }
                if !saw_digit { return false; }
                i = p + 1;
                continue;
            }
            // `\uXXXX` — exactly four hex digits.
            if i + 5 >= len { return false; }
            let c1 = (u8)src[start + i + 2];
            let c2 = (u8)src[start + i + 3];
            let c3 = (u8)src[start + i + 4];
            let c4 = (u8)src[start + i + 5];
            if !is_hex_digit_byte(c1) || !is_hex_digit_byte(c2)
               || !is_hex_digit_byte(c3) || !is_hex_digit_byte(c4) { return false; }
            i = i + 6;
            continue;
        }
        // Other backslash sequences are always legal (single-char escapes,
        // line continuations, octal `\0`, identity escapes).
        i = i + 2;
    }
    return true;
}

fn is_hex_digit_byte(c: u8) -> bool {
    if c >= (u8)'0' && c <= (u8)'9' { return true; }
    if c >= (u8)'a' && c <= (u8)'f' { return true; }
    if c >= (u8)'A' && c <= (u8)'F' { return true; }
    return false;
}

fn hex_digit_value(c: u8) -> u32 {
    if c >= (u8)'0' && c <= (u8)'9' { return (u32)(c - (u8)'0'); }
    if c >= (u8)'a' && c <= (u8)'f' { return (u32)(c - (u8)'a') + 10; }
    if c >= (u8)'A' && c <= (u8)'F' { return (u32)(c - (u8)'A') + 10; }
    return 0;
}

fn tmpl_intern_raw(c: Compiler*, node: AstNode*) -> ZjsString* {
    let raw_start = node.start;
    let raw_end   = node.end;
    let raw_len   = if raw_end > raw_start { raw_end - raw_start } else { 0 };
    return ctx_intern_atom(c.ctx, c.source + raw_start, raw_len);
}

fn tmpl_grow_segments(c: Compiler*, need: u32) -> void {
    if c.tmpl_seg_count + need <= c.tmpl_seg_cap { return; }
    let old_cap = c.tmpl_seg_cap;
    let new_cap: u32 = if c.tmpl_seg_cap == 0 { 8 } else { c.tmpl_seg_cap * 2 };
    while new_cap < c.tmpl_seg_count + need { new_cap = new_cap * 2; }
    c.tmpl_cooked = realloc_n<ZjsString*>(c.tmpl_cooked, (usize)old_cap, (usize)new_cap);
    c.tmpl_raw    = realloc_n<ZjsString*>(c.tmpl_raw,    (usize)old_cap, (usize)new_cap);
    c.tmpl_seg_cap = new_cap;
}

fn tmpl_grow_sites(c: Compiler*, need: u32) -> void {
    if c.tmpl_site_count + need <= c.tmpl_site_cap { return; }
    let old_cap = c.tmpl_site_cap;
    let new_cap: u32 = if c.tmpl_site_cap == 0 { 4 } else { c.tmpl_site_cap * 2 };
    while new_cap < c.tmpl_site_count + need { new_cap = new_cap * 2; }
    // +1 for the trailing terminator entry written at function-end.
    c.tmpl_seg_start = realloc_n<u32>(c.tmpl_seg_start, (usize)(old_cap + 1), (usize)(new_cap + 1));
    c.tmpl_site_cap = new_cap;
}

// Register a tagged-template site at compile time. Returns the site
// index; the caller emits Op::TemplateObject with bc = idx. At function
// finalization the compiler hands its flat segment arrays to the
// resulting Function* so the interpreter can lazy-build + cache the
// strings array on first reach.
fn tmpl_register_site(c: Compiler*, tmpl: AstNode*) -> u32 {
    tmpl_grow_sites(c, 1);
    let idx = c.tmpl_site_count;
    c.tmpl_seg_start[idx] = c.tmpl_seg_count;
    let i: u32 = 0;
    while i < tmpl.children_count {
        let ch = tmpl.children[i];
        if ch.kind == NodeKind::TemplatePartExpr {
            tmpl_grow_segments(c, 1);
            c.tmpl_cooked[c.tmpl_seg_count] = tmpl_intern_cooked(c, ch);
            c.tmpl_raw[c.tmpl_seg_count]    = tmpl_intern_raw(c, ch);
            c.tmpl_seg_count = c.tmpl_seg_count + 1;
        }
        i = i + 1;
    }
    c.tmpl_site_count = c.tmpl_site_count + 1;
    return idx;
}

// `tag`literal``  →  Op::TemplateObject + per-sub compile + Invoke.
// The strings array is built lazily by Op::TemplateObject and cached
// per call site, so subsequent reaches pass the SAME array (spec
// §13.2.8.4 GetTemplateObject) — required by tests that key Maps /
// WeakMaps on strings identity.
fn compile_tagged_template(c: Compiler*, node: AstNode*) -> u8 {
    let tmpl = node.right;     // TemplateExpr
    if tmpl == NULL || tmpl.children_count == 0 { c.had_error = true; return alloc_reg(c); }

    let n_subs: u32 = 0;
    let i0: u32 = 0;
    while i0 < tmpl.children_count {
        if tmpl.children[i0].kind != NodeKind::TemplatePartExpr { n_subs = n_subs + 1; }
        i0 = i0 + 1;
    }

    // Register at compile time so the Function gets the cooked/raw
    // segment arrays it'll need on first runtime reach.
    let site_idx = tmpl_register_site(c, tmpl);
    if site_idx > 65535 { c.had_error = true; return alloc_reg(c); }

    // Reserve regs for: callee, strings, sub1..subN.
    let base = c.next_reg;
    let slots_needed: u8 = 2 + (u8)n_subs;
    let rr: u8 = 0;
    while rr < slots_needed { alloc_reg(c); rr = rr + 1; }

    // Compile the tag expression into regs[base].
    c.preferred_dst = (i32)base;
    let tag_r = compile_expr(c, node.left);
    c.preferred_dst = -1;
    if tag_r != base {
        emit(c, make_inst_ab(Op::Mov, base, tag_r));
        if tag_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
    }

    // Strings array at base+1 via the cached-or-build TemplateObject op.
    let strings_r = base + 1;
    emit(c, make_inst_a_u16(Op::TemplateObject, strings_r, (u16)site_idx));

    // Compile each substitution into its arg slot.
    let si: u32 = 0;
    let arg_idx: u32 = 0;
    while si < tmpl.children_count {
        let ch = tmpl.children[si];
        if ch.kind != NodeKind::TemplatePartExpr {
            let target_slot = base + 2 + (u8)arg_idx;
            c.preferred_dst = (i32)target_slot;
            let sub_r = compile_expr(c, ch);
            c.preferred_dst = -1;
            if sub_r != target_slot {
                emit(c, make_inst_ab(Op::Mov, target_slot, sub_r));
                if sub_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            arg_idx = arg_idx + 1;
        }
        si = si + 1;
    }

    // Plain Invoke: regs[base] = callee, args at base+1..base+1+argc.
    // argc = 1 (strings) + n_subs.
    emit(c, make_inst_abc(Op::Invoke, base, base, 1 + (u8)n_subs));
    c.next_reg = base + 1;
    if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
    return base;
}

fn compile_template_lit(c: Compiler*, node: AstNode*) -> u8 {
    if node.children_count == 0 {
        let dst = alloc_reg(c);
        let empty = ctx_intern_atom(c.ctx, c.source + node.start, 0);
        let val = zjs_cell_from_ptr((void*)empty);
        let idx = add_const(c, val);
        emit(c, make_inst_a_u16(Op::LoadConst, dst, idx));
        return dst;
    }
    // Compile the first part (always a TemplatePart). Then for each
    // remaining child, emit Op::Add on the running accumulator. The
    // children layout is: part, expr, part, expr, ..., part — both
    // ends are parts (one beyond the number of expressions). For a
    // template with no interpolations there's exactly one child.
    let acc = compile_expr(c, node.children[0]);
    let i: u32 = 1;
    while i < node.children_count {
        let next = compile_expr(c, node.children[i]);
        let dst = alloc_reg(c);
        emit(c, make_inst_abc(Op::Add, dst, acc, next));
        if next + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        if acc + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        acc = dst;
        i = i + 1;
    }
    return acc;
}

// =====================================================================
// Function compilation. A FunctionDecl/FunctionExpr/ArrowFunc creates
// a fresh child Compiler with its own register file and constants.
// The resulting Function* is registered with the context (for cleanup)
// and its address becomes a NaN-boxed cell in the parent's constant
// pool.
// =====================================================================

fn compile_function(parent_ctx: ZjsContext*, source: char*, node: AstNode*, parent: Compiler*) -> Function* {
    let c = compiler_new(parent_ctx, source);
    c.is_function = true;
    c.parent = parent;
    // Inherit any open per-iter envs from the parent's current scope —
    // they're an extra runtime __outer__ hop the closure must traverse
    // (#288). NULL parent (top-level) has none.
    if parent != NULL {
        c.extra_env_hops = parent.per_iter_envs_open;
    }
    // Inherit the enclosing class context so super() inside a class
    // method can find its parent expression at compile time.
    if parent != NULL {
        c.enclosing_class_parent = parent.enclosing_class_parent;
        c.enclosing_class_id     = parent.enclosing_class_id;
    } else {
        c.enclosing_class_id = -1;
    }

    // ECMA-262 strict-mode determination. Computed BEFORE the body
    // compiles so nested functions inherit it through `parent.strict`.
    // Strict when: lexically nested in strict code, a class element
    // (MethodDef — class bodies are always strict; object methods use
    // ObjectProp/FunctionExpr instead), or a "use strict" prologue.
    if parent != NULL && parent.strict { c.strict = true; }
    if node.kind == NodeKind::MethodDef { c.strict = true; }
    // A class static initialization block is compiled as its own
    // function (own scope/locals); class bodies are strict and the body
    // runs with `this` = constructor and static `super` semantics.
    if node.kind == NodeKind::StaticBlock {
        c.strict = true;
        c.in_static_element = true;
    }
    if !c.strict && node.left != NULL && body_has_use_strict_directive(node.left, source) {
        c.strict = true;
    }

    // 1. Allocate registers for parameters. They sit at the bottom of
    //    the register file so callers can place args contiguously.
    //    Rest param (always last if present) gets a register too but
    //    is initialized via Op::BuildRestArgs in the prologue rather
    //    than receiving an arg from the caller — `param_count` reflects
    //    only the regular params for arg-distribution purposes.
    let total_children = node.children_count;
    let has_rest: bool = false;
    let rest_binding: AstNode* = NULL;
    let regular_param_count: u32 = 0;
    let rest_reg: u8 = 0;
    // Pass 1: allocate the parameter registers contiguously at the
    // bottom of the register file. Destructuring params record a
    // zero-length-name *placeholder* local so the default-init /
    // env-mirroring loops below can keep their param-order indexing.
    let i: u32 = 0;
    while i < total_children {
        let p = node.children[i];
        if p.kind == NodeKind::RestParam {
            // Spec: rest must be last and unique. Parser enforces both.
            rest_binding = p.left;
            has_rest = true;
        } else {
            let reg = alloc_reg(c);
            if p.name_length == 0 && p.third != NULL {
                add_local(c, p.start, 0, reg);
            } else {
                add_local(c, p.start, p.end - p.start, reg);
            }
            regular_param_count = regular_param_count + 1;
        }
        i = i + 1;
    }
    if has_rest && rest_binding != NULL {
        rest_reg = alloc_reg(c);
        if rest_binding.kind == NodeKind::IdentExpr
           && rest_binding.name_length == 0
           && rest_binding.third != NULL {
            add_local(c, rest_binding.start, 0, rest_reg);
        } else {
            add_local(c, rest_binding.start, rest_binding.end - rest_binding.start, rest_reg);
        }
    }
    // Pass 2: inner pattern-binding locals come after all param
    // registers so the caller's arg-passing layout (args_base[0..N))
    // stays contiguous. analyze_captures (below) walks these and
    // marks the captured ones; destructure_pattern fans the param
    // value into them after default-init.
    let pi: u32 = 0;
    while pi < total_children {
        let pp = node.children[pi];
        if pp.kind != NodeKind::RestParam
           && pp.name_length == 0
           && pp.third != NULL {
            collect_pattern_locals(c, pp.third);
        }
        pi = pi + 1;
    }
    if has_rest && rest_binding != NULL
       && rest_binding.kind == NodeKind::IdentExpr
       && rest_binding.name_length == 0
       && rest_binding.third != NULL {
        collect_pattern_locals(c, rest_binding.third);
    }
    let param_count = regular_param_count;

    // Named function expression — bind the function's own name as a
    // const-like local visible inside the body (§15.7.1). Allocate
    // BEFORE collect_locals + analyze_captures so the body's
    // references to NAME resolve to this local. Initialized via
    // Op::LoadCallee in the prologue. FunctionDecl handles its own
    // name via the outer scope, so skip there.
    let bind_callee_local: bool = node.kind == NodeKind::FunctionExpr
                               && node.name_length > 0;
    let callee_reg: u8 = 0;
    if bind_callee_local {
        callee_reg = alloc_reg(c);
        add_local(c, node.name_start, node.name_length, callee_reg);
        if callee_reg + 1 > c.fixed_regs { c.fixed_regs = callee_reg + 1; }
    }
    // env_binding_count includes the rest binding (one local past the
    // regular params), since the env-mirror loop below also needs to
    // mirror a captured rest-binding into the env object. param_count
    // itself stays arity-only — it backs Function.length, the register
    // floor, and the param-distribution loop.
    let env_binding_count = regular_param_count;
    if has_rest && rest_binding != NULL { env_binding_count = env_binding_count + 1; }

    // 2. Hoist var/let/const declarations from the body into fixed
    //    locals, plus nested-FunctionDecl name bindings. The body's
    //    outer { … } IS the function-scope lexical environment — we
    //    must walk INTO its children rather than the wrapper BlockStmt
    //    itself, otherwise top-level `let` inside the function body
    //    would land in a nested block scope and be invisible to
    //    sibling closures that capture it.
    if node.left != NULL {
        if node.left.kind == NodeKind::BlockStmt {
            let bi: u32 = 0;
            while bi < node.left.children_count {
                collect_locals(c, node.left.children[bi]);
                bi = bi + 1;
            }
        } else {
            collect_locals(c, node.left);
        }
    }

    // 2b. Capture analysis — walk the body looking for nested
    //     functions that reference our locals. Sets c.needs_env and
    //     marks specific locals as captured. Reset the scope tracker
    //     first so the ids assigned to inner blocks line up with the
    //     ones collect_locals just assigned (both walks must produce
    //     the same scope_id at the same syntactic point).
    reset_scope_walk(c);
    if node.left != NULL {
        if node.left.kind == NodeKind::BlockStmt {
            let bi: u32 = 0;
            while bi < node.left.children_count {
                analyze_captures(c, node.left.children[bi]);
                bi = bi + 1;
            }
        } else {
            analyze_captures(c, node.left);
        }
    }

    // 2c. Reset again so compile_stmt below re-issues matching ids.
    reset_scope_walk(c);

    // 2b'. Phase 3.9j — detect "transitive outer refs": references
    //      inside this function's body (including nested closures)
    //      that reach past us to ancestor scope. `has_outer_refs`
    //      means we need to either receive an env from our caller
    //      (we're a Closure) AND/OR forward one to our inner
    //      closures. It does NOT mean we allocate our own env — only
    //      `needs_env` (own-captured locals) does.
    if node.left != NULL && c.parent != NULL && detect_outer_refs(c, node.left, source) {
        c.has_outer_refs = true;
    }

    // 2c. If we'll need an env object for OWN captures, reserve a
    //     register for it. Pass-through functions (has_outer_refs but
    //     no own captures) just forward current_closure.env to their
    //     inner closures at MakeClosure time — no allocation.
    if c.needs_env {
        c.env_reg = alloc_reg(c);
    }

    // 2d. `arguments` — if the body references it and no local of
    //     that name was hoisted, reserve a register. The actual array
    //     is built by Op::BuildArguments at function entry below.
    let need_args = node.left != NULL && body_uses_arguments(c, node.left) && !has_arguments_local(c);
    if need_args {
        c.arguments_reg = (i32)alloc_reg(c);
    }

    // 2e. Hoist `this` if the body references it. One LoadThis at
    //     entry instead of one per occurrence.
    let need_this = node.left != NULL && body_uses_this(node.left);
    if need_this {
        c.this_reg = (i32)alloc_reg(c);
    }

    // 2f. Hoist current_closure.env when the body reads outer captures
    //     but has no own env (passthrough). emit_env_chain_walk's
    //     depth==1 path then returns this stable reg, skipping the
    //     fresh LoadEnv emit per access. Big win for closure bodies
    //     that touch the same captured var multiple times.
    if c.has_outer_refs && !c.needs_env {
        c.cached_outer_env_reg = (i32)alloc_reg(c);
    }

    // 3. Locals are now fixed; temps live above this watermark.
    c.fixed_regs = c.next_reg;

    // 4a. If captures exist, emit env-construction at the start of the
    //     function: NewObject env_reg, then store each captured param
    //     into env with its name as key. Locals declared later in the
    //     body get stored when their VarDecl executes.
    if c.arguments_reg >= 0 {
        emit(c, make_inst_a(Op::BuildArguments, (u8)c.arguments_reg));
    }
    // Seed the cached outer-env reg once. emit_env_chain_walk's
    // depth==1 reads return this reg directly afterward.
    if c.cached_outer_env_reg >= 0 {
        emit(c, make_inst_a(Op::LoadEnv, (u8)c.cached_outer_env_reg));
    }
    // No prologue Op::LoadThis emit — the interpreter seeds
    // regs[f.this_reg] from ctx.host_this on frame entry, saving the
    // dispatch (~3.9% of richards dispatches).
    if has_rest {
        // Build rest array from args_base[regular_param_count..argc].
        emit(c, make_inst_ab(Op::BuildRestArgs, rest_reg, (u8)regular_param_count));
    }
    // Named function expression — load the current callee into the
    // self-binding local. If captured by a nested function, store
    // into env too (mirrors how params are env-mirrored below).
    if bind_callee_local {
        emit(c, make_inst_a(Op::LoadCallee, callee_reg));
        let lidx = find_local_index(c, c.source + node.name_start, node.name_length);
        if lidx >= 0 && c.locals[(u32)lidx].captured && c.needs_env {
            // env_reg may not be allocated yet — defer to the env-init
            // loop below by leaving the local set. The env-mirror walk
            // (j < env_binding_count) doesn't reach this local since
            // it lives past the rest binding; emit the env store here
            // after the env object is built. We can't, because env
            // isn't created yet at this point. Instead, mark for the
            // env-init block to pick up.
        }
    }
    // Default initializers for regular params: `param === undefined
    // ? init : param`. Run in declaration order.
    let dp_i: u32 = 0;
    let local_idx: u32 = 0;
    while dp_i < total_children {
        let p = node.children[dp_i];
        if p.kind == NodeKind::RestParam {
            dp_i = dp_i + 1;
            continue;
        }
        if p.right != NULL {
            let param_reg = c.locals[local_idx].reg;
            let tmp = alloc_reg(c);
            let undef_r = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadUndefined, undef_r));
            emit(c, make_inst_abc(Op::CmpStrictEq, tmp, param_reg, undef_r));
            release_reg(c, undef_r);
            let skip_idx = emit(c, make_inst_a_i16(Op::JmpIfFalse, tmp, 0));
            release_reg(c, tmp);
            // #330 TDZ ref-self: a parameter is in its own TDZ while its
            // default initializer runs, so `function f(x = x)` must throw
            // ReferenceError. The CmpStrictEq above already read the arg
            // value; now (only on the default-taken branch) seed the reg
            // with the hole and mark the binding uninitialized so a
            // self-reference inside the default hits ThrowIfHole. The
            // arg-provided path skips this via JmpIfFalse and keeps the
            // argument. (ref-LATER — `(a = b, b)` — needs arg staging and
            // is a separate follow-up.)
            let is_simple_param = p.name_length > 0 && !c.locals[local_idx].captured;
            if is_simple_param {
                c.locals[local_idx].is_tdz = true;
                c.locals[local_idx].initialized = false;
                emit(c, make_inst_a(Op::LoadHole, param_reg));
            }
            let init_r = compile_expr(c, p.right);
            if init_r != param_reg {
                emit(c, make_inst_ab(Op::Mov, param_reg, init_r));
            }
            // NamedEvaluation for `function(x = function(){}) {}` —
            // applies only to simple-ident params, not destructuring.
            if p.name_length > 0 {
                maybe_infer_anon_name(c, p.right, param_reg,
                                      c.source + p.start, p.end - p.start);
            }
            if init_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            reset_temps(c);
            patch_jump(c, skip_idx);
            // Both paths converge here initialized — body reads skip the check.
            if is_simple_param { c.locals[local_idx].initialized = true; }
        }
        local_idx = local_idx + 1;
        dp_i = dp_i + 1;
    }
    if c.needs_env {
        emit(c, make_inst_a(Op::NewObject, c.env_reg));
        // Phase 3.9j: if our nested closures reach past us into the
        // enclosing scope, chain via __outer__ to the parent's env.
        // current_closure.env (LoadEnv) is that env.
        if c.has_outer_refs {
            let outer_r = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadEnv, outer_r));
            let outer_atom = ctx_intern_atom(c.ctx, OUTER_ENV_KEY, OUTER_ENV_KEY_LEN);
            emit_store_prop_atom(c, c.env_reg, outer_atom, outer_r);
            release_reg(c, outer_r);
        }
        let j: u32 = 0;
        while j < c.local_count {
            // Params first — they all have indices < env_binding_count
            // (regular params + optional rest binding). We mirror
            // captured-param values into env at entry. Skip
            // destructuring-param placeholders (name_length=0): their
            // inner-binding locals get mirrored by destructure_pattern
            // below via bind_destructure_target.
            if j < env_binding_count && c.locals[j].captured && c.locals[j].name_length > 0 {
                let name_atom = ctx_intern_atom(c.ctx,
                                                c.source + c.locals[j].name_start,
                                                c.locals[j].name_length);
                emit_store_prop_atom(c, c.env_reg, name_atom, c.locals[j].reg);
            }
            j = j + 1;
        }
        // Mirror the named-FunctionExpr self-binding into env when it's
        // captured by an inner closure. The env walk above skipped it
        // because its local index sits past env_binding_count (after
        // the rest binding); handle it here.
        if bind_callee_local {
            let cli = find_local_index(c, c.source + node.name_start, node.name_length);
            if cli >= 0 && c.locals[(u32)cli].captured {
                let n_atom = ctx_intern_atom(c.ctx,
                                             c.source + node.name_start,
                                             node.name_length);
                emit_store_prop_atom(c, c.env_reg, n_atom, callee_reg);
            }
        }
    }

    // Pattern-param fan-out. Runs AFTER env init so bind_destructure_target
    // can StoreProp into env_reg for captured inner-bindings.
    let dpat_i: u32 = 0;
    let dpat_local: u32 = 0;
    while dpat_i < total_children {
        let pp2 = node.children[dpat_i];
        if pp2.kind != NodeKind::RestParam {
            if pp2.name_length == 0 && pp2.third != NULL {
                let param_r = c.locals[dpat_local].reg;
                destructure_pattern(c, pp2.third, param_r);
            }
            dpat_local = dpat_local + 1;
        }
        dpat_i = dpat_i + 1;
    }
    if has_rest && rest_binding != NULL
       && rest_binding.kind == NodeKind::IdentExpr
       && rest_binding.name_length == 0
       && rest_binding.third != NULL {
        destructure_pattern(c, rest_binding.third, rest_reg);
    }

    // 3z. Generator prologue terminator. ECMA-262 calls
    // FunctionDeclarationInstantiation (= the prologue above) at the
    // INITIAL call to a generator, then returns the iterator suspended
    // at GeneratorStart. The body only runs on first .next().
    // Emit a marker the interpreter's initial-call path catches.
    let kind_is_generator: bool = false;
    let kind_is_async:     bool = false;
    if node.kind == NodeKind::MethodDef {
        // MethodDef.num encodes: 0=plain, 1=async, 4=generator, 5=async generator.
        kind_is_generator = node.num == 4.0 || node.num == 5.0;
        kind_is_async     = node.num == 1.0 || node.num == 5.0;
    } else {
        kind_is_generator = node.num == 3.0;
        kind_is_async     = node.bool_value;
    }
    c.is_async     = kind_is_async;
    c.is_generator = kind_is_generator;
    if kind_is_generator {
        emit(c, make_inst_a(Op::GeneratorStart, 0));
    }

    // 4. Compile body. Arrow concise body is an expression; everything
    //    else is a BlockStmt. The outer braces of a function body are
    //    the function scope itself — iterate children directly so we
    //    don't double-enter a block scope (which would put body-level
    //    `let` inside a nested scope, mismatching what collect_locals
    //    did at the same syntactic point).
    //
    // ECMA-262 §10.2.11 FunctionDeclarationInstantiation: function
    // declarations at the top level of a function body are hoisted +
    // initialized to their closure value BEFORE any user statement
    // runs. Without this, lodash's UMD bundle (and any code with a
    // `var x = foo(); function foo(){}` pattern) hits TypeError
    // because `foo` is still undefined when called. We emit
    // FunctionDecl children in a first pass, then skip them on the
    // normal body walk so they're not emitted twice. (Nested
    // FunctionDecls inside BlockStmts / IfStmts / etc. still go
    // through the regular per-block recursion in compile_stmt and
    // are NOT hoisted — matches ECMA-262 lexical scoping.)
    // #330 TDZ: the function body's own braces ARE the function scope and
    // are walked directly (not via the BlockStmt handler), so seed the
    // hole for function-top `let`/`const` here. Nested blocks/loop bodies
    // re-hole their own bindings in the BlockStmt handler. Params are
    // never is_tdz, so this never touches argument registers.
    // Skip params (locals 0..param_count-1) — their TDZ (default ref-self)
    // is handled in the default-param prologue above; re-holing them here
    // would clobber their initialized argument/default values.
    let tz: u32 = param_count;
    while tz < c.local_count {
        if c.locals[tz].is_tdz && !c.locals[tz].captured {
            emit(c, make_inst_a(Op::LoadHole, c.locals[tz].reg));
            c.locals[tz].initialized = false;
        }
        tz = tz + 1;
    }
    if node.left != NULL {
        if node.left.kind == NodeKind::BlockStmt {
            let bi: u32 = 0;
            while bi < node.left.children_count {
                let cn = node.left.children[bi];
                if cn != NULL && cn.kind == NodeKind::FunctionDecl {
                    compile_stmt(c, cn);
                }
                bi = bi + 1;
            }
            let bj: u32 = 0;
            while bj < node.left.children_count {
                let cn2 = node.left.children[bj];
                if cn2 == NULL || cn2.kind != NodeKind::FunctionDecl {
                    compile_stmt(c, cn2);
                }
                bj = bj + 1;
            }
        } else {
            let r = compile_expr(c, node.left);
            emit(c, make_inst_a(Op::Return, r));
        }
    }

    // 5. Ensure the last instruction is a Return.
    let need_return: bool = true;
    if c.code_count > 0 {
        if c.code[c.code_count - 1].op == Op::Return { need_return = false; }
    }
    if need_return {
        let r = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadUndefined, r));
        emit(c, make_inst_a(Op::Return, r));
    }

    let had_error = c.had_error;

    // 6. Move ownership into a fresh Function.
    let f = function_new();
    f.realm = c.ctx.realm;   // [[Realm]] — the realm this code compiled in
    f.code = c.code;
    f.code_len = c.code_count;
    f.constants = c.constants;
    f.const_count = c.const_count;
    f.register_count = (u32)(c.max_reg + 1);
    if f.register_count < param_count { f.register_count = param_count; }
    // fixed_regs: params + locals + bumps for persistent temps. The
    // frame-setup code initializes only `[copy_count, fixed_regs)` to
    // undefined — scratch temps above this watermark are written
    // before read by the compiler-emitted ops. Clamp to register_count
    // for safety (a bump beyond max_reg would otherwise read past the
    // frame's allocation).
    f.fixed_regs = (u32)c.fixed_regs;
    if f.fixed_regs > f.register_count { f.fixed_regs = f.register_count; }
    f.this_reg = c.this_reg;  // -1 if body doesn't use `this`
    f.param_count = param_count;
    // ExpectedArgumentCount — walk params left-to-right, stop at the
    // first with a default initializer or the rest binding.
    let eac: u32 = 0;
    let eac_i: u32 = 0;
    while eac_i < total_children {
        let pp = node.children[eac_i];
        if pp.kind == NodeKind::RestParam { break; }
        if pp.right != NULL { break; }
        eac = eac + 1;
        eac_i = eac_i + 1;
    }
    f.expected_arg_count = eac;
    f.ics = c.ics;
    f.ic_count = c.ic_count;
    // Tagged-template site cache — flush the per-compiler flat arrays
    // onto the Function so each site can lazy-build + cache its
    // strings array on first reach. Write the terminator entry so
    // site i's segments are [seg_start[i], seg_start[i+1]).
    if c.tmpl_site_count > 0 {
        c.tmpl_seg_start[c.tmpl_site_count] = c.tmpl_seg_count;
        f.template_count     = c.tmpl_site_count;
        f.template_cooked    = c.tmpl_cooked;
        f.template_raw       = c.tmpl_raw;
        f.template_seg_start = c.tmpl_seg_start;
        f.template_cache     = alloc_n<ZjsArray*>((usize)c.tmpl_site_count);
        let ti: u32 = 0;
        while ti < c.tmpl_site_count { f.template_cache[ti] = NULL; ti = ti + 1; }
        // Buffers handed off — don't double-free in compiler_free.
        c.tmpl_cooked    = NULL;
        c.tmpl_raw       = NULL;
        c.tmpl_seg_start = NULL;
    }
    f.uses_arguments = c.arguments_reg >= 0;
    f.has_rest_param = has_rest;
    // (#389: the gen-GC frame-init widening that used to live here is
    // gone — stale reg slots are filtered by the validated root scan.)
    // Repurposing the otherwise-unset Function.needs_env to mean "this
    // function body references at least one outer-scope name." Drives
    // the wrap-or-not decision at the FunctionDecl/FunctionExpr emit
    // site — see the `inner_has_captures_from` callers in this file.
    // The conservative `inner_has_captures_from(c)` check used to
    // over-wrap top-level FunctionDecls (e.g. `function assert(){}`)
    // into closures whenever any sibling captured a script-scope let,
    // even when the wrapped function didn't read outer scope itself.
    // That broke property writes on the over-wrapped function (TAG_
    // CLOSURE non-class writes silently drop). See #265.
    f.needs_env = c.has_outer_refs;
    // Mark arrow functions so MakeClosure can capture the creation-
    // time `this` (and Op::LoadThis can route through it). Without
    // this, every `class C { constructor() { arr.map(x => this.f(x)) } }`
    // mis-binds `this` to the map callback's host_this (globalThis).
    f.is_arrow = node.kind == NodeKind::ArrowFunc;
    f.strict = c.strict;
    // For ordinary functions / arrow funcs the parser stashes the
    // async flag in bool_value. For MethodDef, bool_value already
    // carries is_static — so we keep the async flag in `num` instead
    // and merge here.
    // Generator flag rides on `num == 3.0` for FunctionDecl/Expr
    // (MethodDef num is overloaded with the async / synth-ctor
    // sentinels; generator methods aren't supported yet).
    if node.kind == NodeKind::MethodDef {
        // num: 0 = plain, 1 = async, 4 = generator, 5 = async generator.
        f.is_async = node.num == 1.0 || node.num == 5.0;
        f.is_generator = node.num == 4.0 || node.num == 5.0;
    } else {
        f.is_async = node.bool_value;
        f.is_generator = node.num == 3.0;
    }

    // ECMA-262 SetFunctionName step. If the source has a declared
    // identifier (function f(){}, function f(){...} as expr, class
    // method shorthand pre-name from MethodDef would set name via the
    // class path), install a `name` data property on the function's
    // expando bag so property_get and Object.getOwnPropertyDescriptor
    // see it. Anonymous function/arrow-func get name via
    // maybe_infer_anon_name at the assignment site.
    if node.name_length > 0
       && node.kind != NodeKind::MethodDef
       && node.kind != NodeKind::ClassDecl
       && node.kind != NodeKind::ClassExpr {
        if f.props == NULL {
            let pv2 = ctx_new_object(parent_ctx);
            f.props = zjs_as_object(pv2);
        }
        let name_atom2 = ctx_intern_atom(parent_ctx, (char*)"name", 4);
        let name_v2 = ctx_intern_string(parent_ctx,
                                        source + node.name_start,
                                        node.name_length);
        // ECMA-262 §10.2.10 SetFunctionName: { writable: false,
        // enumerable: false, configurable: true }.
        object_define_property_slot(parent_ctx, f.props, name_atom2, name_v2,
                                    PROP_CONFIGURABLE);
    }

    c.code = NULL;
    c.constants = NULL;
    c.ics = NULL;
    compiler_free(c);

    if had_error {
        function_free(f);
        return NULL;
    }
    return f;
}

// Compile a FunctionExpr/ArrowFunc in expression context. Returns the
// register holding the function (or closure) value.
fn compile_function_value(c: Compiler*, node: AstNode*) -> u8 {
    let f = compile_function(c.ctx, c.source, node, c);
    if f == NULL { c.had_error = true; return alloc_reg(c); }
    let fp: void* = NULL;
    raw { fp = (void*)f; }
    ctx_register_cell(c.ctx, fp);

    let val = zjs_cell_from_ptr(fp);
    let idx = add_const(c, val);
    let dst = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, dst, idx));

    // If the inner function referenced any outer-scope name, wrap it
    // in a closure with the current env. f.needs_env carries the
    // inner's has_outer_refs flag (set in compile_function). Precise
    // — wrap exactly when the inner reads outer scope.
    //
    // Arrows always wrap, even when they don't capture an env binding:
    // MakeClosure is also where the creation-time `this` snapshot lands
    // (cl.captured_this). A bare `() => this.x` reads `this` lexically
    // but doesn't pull anything from the env chain, so without this
    // override it would skip MakeClosure and lose the snapshot.
    if f.needs_env || f.is_arrow {
        let cls_reg = alloc_reg(c);
        let env = closure_env_reg(c);
        emit(c, make_inst_abc(Op::MakeClosure, cls_reg, dst, env.reg));
        if env.is_temp { release_reg(c, env.reg); }
        release_reg(c, dst);
        if c.next_reg <= cls_reg { c.next_reg = cls_reg + 1; }
        return cls_reg;
    }
    return dst;
}

// Did the inner compile note that it accessed any of our locals?
// The inner compiler is no longer accessible here (it's been freed),
// so this is approximated via the function's needs_env flag. A
// non-needs_env inner that nevertheless captured ONLY through its
// own ancestors is not currently distinguished — that's a pending
// multi-level case we don't support yet.
fn inner_has_captures_from(c: Compiler*) -> bool {
    // If WE (c) have any captured local, inner functions can read it
    // through our env. If we ourselves forward an env (has_outer_refs),
    // inner functions need to be wrapped as Closures too so they
    // receive the env we're chaining through.
    if c.has_outer_refs { return true; }
    let i: u32 = 0;
    while i < c.local_count {
        if c.locals[i].captured { return true; }
        i = i + 1;
    }
    return false;
}

// Compute the env_reg to use when emitting MakeClosure inside `c`.
// - If c has its own env (own captured locals), use c.env_reg.
// - Else if c is a passthrough (has_outer_refs), emit LoadEnv into a
//   fresh temp reg so c's inner closure receives c's enclosing env.
// - Else return 0 (the inner doesn't actually capture anything, so
//   the env value won't be used).
// Returns (env_reg, is_temp). Caller must release_reg if is_temp.
struct ClosureEnvReg {
    reg:     u8;
    is_temp: bool;
}

fn closure_env_reg(c: Compiler*) -> ClosureEnvReg {
    if c.needs_env {
        return ClosureEnvReg{ reg: c.env_reg, is_temp: false };
    }
    if c.has_outer_refs {
        if c.cached_outer_env_reg >= 0 {
            return ClosureEnvReg{ reg: (u8)c.cached_outer_env_reg, is_temp: false };
        }
        let temp = alloc_reg(c);
        emit(c, make_inst_a(Op::LoadEnv, temp));
        return ClosureEnvReg{ reg: temp, is_temp: true };
    }
    return ClosureEnvReg{ reg: 0, is_temp: false };
}

// Class compilation (Phase 3.7) — desugar to:
//   function Class(<ctor params>) { <ctor body> }
//   Class.prototype.m1 = function(<params>) { <body> };
//   ...
//
// Canonicalize a method name from its source slice. Supports
// identifiers (returned as-is), NumberLit (parsed and ToString'd —
// `0x10` → `"16"`, `1e2` → `"100"`), and StringLit (content between
// quotes, with the same escape-decoding compile_string_literal uses).
fn intern_method_name_atom(c: Compiler*, name_start: u32, name_length: u32) -> ZjsString* {
    let mn = c.source + name_start;
    let ml = name_length;
    if ml == 0 { return ctx_intern_atom(c.ctx, mn, ml); }
    // PrivateName: mangle to the per-class hidden key.
    if mn[0] == '#' {
        return mangle_private_name(c, name_start, ml);
    }
    let first = mn[0];
    // NumberLit: starts with a digit or `.` followed by digit.
    let is_numeric: int = 0;
    raw {
        is_numeric = (first >= '0' && first <= '9') ? 1
                   : (first == '.' && ml > 1 && mn[1] >= '0' && mn[1] <= '9') ? 1
                   : 0;
    }
    if is_numeric != 0 {
        let d = parse_number_literal(c.source, name_start, ml);
        let buf: char[48];
        let len: int = 0;
        raw {
            // Match the spec's ToString for finite doubles: integral
            // values print without a decimal point.
            if (d == (double)(long long)d && d >= -1e15 && d <= 1e15) {
                len = snprintf(&buf[0], 48, "%lld", (long long)d);
            } else {
                int found = 0;
                for (int prec = 1; prec <= 17 && !found; prec++) {
                    char tmp[48];
                    int n = snprintf(tmp, 48, "%.*g", prec, d);
                    char* end = NULL;
                    double rt = strtod(tmp, &end);
                    if (rt == d) { memcpy(&buf[0], tmp, n + 1); len = n; found = 1; }
                }
                if (!found) len = snprintf(&buf[0], 48, "%.17g", d);
            }
        }
        let bp: char* = NULL; raw { bp = &buf[0]; }
        return ctx_intern_atom(c.ctx, bp, (u32)len);
    }
    // StringLit: surrounded by quotes. Strip them and run the full
    // string-literal escape decoder (same path as compile_string_literal).
    if first == 34 || first == 39 {     // '"' or '\''
        if ml < 2 { return ctx_intern_atom(c.ctx, (char*)"", 0); }
        let inner_start = name_start + 1;
        let inner_len   = ml - 2;
        let buf = alloc_n<char>((usize)(inner_len + 1));
        let out = decode_string_body(c.source, inner_start, inner_len, buf);
        buf[out] = (char)0;
        return ctx_intern_atom_take(c.ctx, buf, out);
    }
    // Identifier / keyword — source slice is the canonical name.
    return intern_ident_atom(c.ctx, mn, ml);
}

// Intern an identifier-name source slice as an atom. ctx_intern_atom
// already detects `\uXXXX` / `\u{...}` escapes in its input and
// decodes them to UTF-8, so we forward directly. (Earlier in the
// project this function did its own decode, but it ASCII-truncated
// non-BMP code points — `℘` lost the high bytes.)
fn intern_ident_atom(ctx: ZjsContext*, src: char*, len: u32) -> ZjsString* {
    return ctx_intern_atom(ctx, src, len);
}

// `cls_node` is a ClassDecl or ClassExpr. Returns the register holding
// the resulting constructor function value. Caller decides what to do
// with it (bind to a local / global for ClassDecl, return as expression
// value for ClassExpr).
// ES module top-level. Emits Op::ImportBind / Op::ExportBind for each
// clause. The atoms live in the function's const pool; b/c bytes
// index that pool (u8 — overflows fail-soft via had_error).
fn add_atom_const(c: Compiler*, atom: ZjsString*) -> u32 {
    let v = zjs_cell_from_ptr((void*)atom);
    return add_const(c, v);
}

fn intern_string_literal_text(c: Compiler*, start: u32, len: u32) -> ZjsString* {
    // Strip the surrounding quotes from a StringLit slice.
    if len < 2 { return ctx_intern_atom(c.ctx, (char*)"", 0); }
    let inner_start = start + 1;
    let inner_len   = len - 2;
    let buf = alloc_n<char>((usize)(inner_len + 1));
    let out = decode_string_body(c.source, inner_start, inner_len, buf);
    buf[out] = (char)0;
    return ctx_intern_atom_take(c.ctx, buf, out);
}

fn compile_import_decl(c: Compiler*, node: AstNode*) -> void {
    // Specifier slice includes the quote characters.
    let spec = intern_string_literal_text(c, node.name_start, node.name_length);
    let spec_idx = add_atom_const(c, spec);
    if spec_idx > 255 { c.had_error = true; return; }

    // Side-effect-only import (`import 'foo';`) — no bindings to wire,
    // but the module must still load (executing its body has the side
    // effect the program wanted). Emit one ImportBind with "*" so the
    // resolver runs; the resulting namespace is discarded.
    if node.children_count == 0 {
        let star_atom = ctx_intern_atom(c.ctx, (char*)"*", 1);
        let name_idx = add_atom_const(c, star_atom);
        if name_idx > 255 { c.had_error = true; return; }
        let tmp = alloc_reg(c);
        emit(c, make_inst_abc(Op::ImportBind, tmp, (u8)spec_idx, (u8)name_idx));
        release_reg(c, tmp);
        return;
    }

    let i: u32 = 0;
    while i < node.children_count {
        let cl = node.children[i];
        // Local binding name from the clause:
        let local_atom = ctx_intern_atom(c.ctx, c.source + cl.name_start, cl.name_length);
        // The binding was pre-registered by collect_locals (module
        // mode); look up its register and captured-ness. Falls back to
        // a fresh alloc for the rare non-module caller.
        let lidx = find_local_index(c, c.source + cl.name_start, cl.name_length);
        let reg: u8 = 0;
        let captured: bool = false;
        if lidx >= 0 {
            reg = c.locals[(u32)lidx].reg;
            captured = c.locals[(u32)lidx].captured;
        } else {
            reg = alloc_reg(c);
            add_local(c, cl.name_start, cl.name_length, reg);
            if reg + 1 > c.fixed_regs { c.fixed_regs = reg + 1; }
        }
        // Source export name: KwDefault → "default"; Star → "*";
        // Eq (named) → cl.third->name_*; bare default already covered.
        let source_atom: ZjsString* = NULL;
        if cl.op == TokenKind::KwDefault {
            source_atom = ctx_intern_atom(c.ctx, (char*)"default", 7);
        } else if cl.op == TokenKind::Star {
            source_atom = ctx_intern_atom(c.ctx, (char*)"*", 1);
        } else if cl.third != NULL {
            source_atom = ctx_intern_atom(c.ctx, c.source + cl.third.name_start, cl.third.name_length);
        } else {
            source_atom = local_atom;
        }
        let name_idx = add_atom_const(c, source_atom);
        if name_idx > 255 { c.had_error = true; return; }
        if captured {
            // Imported binding is captured by a nested closure — its
            // canonical home is env.<name>, not the bare reg. Emit
            // ImportBind into a temp, then store into env.
            let tmp = alloc_reg(c);
            emit(c, make_inst_abc(Op::ImportBind, tmp, (u8)spec_idx, (u8)name_idx));
            emit_store_prop_atom(c, c.env_reg, local_atom, tmp);
            release_reg(c, tmp);
        } else {
            emit(c, make_inst_abc(Op::ImportBind, reg, (u8)spec_idx, (u8)name_idx));
        }
        i = i + 1;
    }
}

fn emit_export_one(c: Compiler*, local_reg: u8, name_atom: ZjsString*) -> void {
    let name_idx = add_atom_const(c, name_atom);
    if name_idx > 255 { c.had_error = true; return; }
    emit(c, make_inst_ab(Op::ExportBind, local_reg, (u8)name_idx));
}

// Like emit_export_one but takes a local index. If the local is
// captured (its canonical home is env.<name>, not the bare reg —
// see FunctionDecl emit at line ~5293), load from env into a temp
// first. Otherwise just use the bare reg.
fn emit_export_local(c: Compiler*, local_idx: u32, name_atom: ZjsString*) -> void {
    let local = c.locals[local_idx];
    let reg = local.reg;
    if local.captured && local.name_length > 0 {
        let n_atom = ctx_intern_atom(c.ctx,
                                     c.source + local.name_start,
                                     local.name_length);
        let tmp = alloc_reg(c);
        emit_load_prop_atom(c, tmp, c.env_reg, n_atom);
        emit_export_one(c, tmp, name_atom);
        release_reg(c, tmp);
        return;
    }
    emit_export_one(c, reg, name_atom);
}

fn find_local_reg(c: Compiler*, name_start: u32, name_length: u32) -> i32 {
    let src = c.source;
    let i: u32 = 0;
    while i < c.local_count {
        let l = c.locals[i];
        if l.name_length == name_length {
            let same: bool = true;
            let k: u32 = 0;
            while k < name_length {
                if src[l.name_start + k] != src[name_start + k] { same = false; break; }
                k = k + 1;
            }
            if same { return (i32)l.reg; }
        }
        i = i + 1;
    }
    return -1;
}

fn compile_export_decl(c: Compiler*, node: AstNode*) -> void {
    // `export default expr`
    if node.bool_value {
        let r = compile_expr(c, node.left);
        let dflt = ctx_intern_atom(c.ctx, (char*)"default", 7);
        emit_export_one(c, r, dflt);
        if r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        return;
    }

    // `export <decl>` — compile the decl first, then mark every name
    // it introduced as exported. The exporting clauses sit in the
    // decl's body via name_start/length (VarDecl declarators, function
    // / class .name_*).
    if node.left != NULL {
        compile_stmt(c, node.left);
        let d = node.left;
        if d.kind == NodeKind::VarDecl {
            let i: u32 = 0;
            while i < d.children_count {
                let dl = d.children[i];
                let li = find_local_index(c, c.source + dl.name_start, dl.name_length);
                if li < 0 { c.had_error = true; return; }
                let nm = ctx_intern_atom(c.ctx, c.source + dl.name_start, dl.name_length);
                emit_export_local(c, (u32)li, nm);
                i = i + 1;
            }
        } else if d.kind == NodeKind::FunctionDecl || d.kind == NodeKind::ClassDecl {
            let li = find_local_index(c, c.source + d.name_start, d.name_length);
            if li < 0 { c.had_error = true; return; }
            let nm = ctx_intern_atom(c.ctx, c.source + d.name_start, d.name_length);
            emit_export_local(c, (u32)li, nm);
        }
        return;
    }

    // `export { a as b, c }` — re-export from another module if name_start/length is set
    let is_re_export = node.name_length > 0;
    let spec_idx: u32 = 0;
    if is_re_export {
        let spec = intern_string_literal_text(c, node.name_start, node.name_length);
        spec_idx = add_atom_const(c, spec);
        if spec_idx > 255 { c.had_error = true; return; }
    }
    let i: u32 = 0;
    while i < node.children_count {
        let cl = node.children[i];
        let export_name_node = cl.third;
        let export_name_atom = ctx_intern_atom(c.ctx,
                                                c.source + export_name_node.name_start,
                                                export_name_node.name_length);
        if is_re_export {
            // Pull from source module into a temp reg, then re-export.
            let src_atom = ctx_intern_atom(c.ctx, c.source + cl.name_start, cl.name_length);
            let src_idx  = add_atom_const(c, src_atom);
            if src_idx > 255 { c.had_error = true; return; }
            let tmp = alloc_reg(c);
            emit(c, make_inst_abc(Op::ImportBind, tmp, (u8)spec_idx, (u8)src_idx));
            emit_export_one(c, tmp, export_name_atom);
            if tmp + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        } else {
            let li = find_local_index(c, c.source + cl.name_start, cl.name_length);
            if li < 0 { c.had_error = true; return; }
            emit_export_local(c, (u32)li, export_name_atom);
        }
        i = i + 1;
    }
}

// Detect `#name` private-name slices. The lexer's PrivateName token
// keeps the leading `#` so the slice's first byte is the sigil.
fn is_private_name(c: Compiler*, name_start: u32, name_length: u32) -> bool {
    if name_length == 0 { return false; }
    return c.source[name_start] == '#';
}

// Mangle a `#name` slice into a per-class hidden key:
//   __zjs_priv_<class_id>_<name-after-hash>
// The `__zjs_` prefix is already filtered out of Object.keys /
// getOwnPropertyNames / for-in / JSON.stringify via
// string_is_hidden_key, so private fields stay invisible to reflection.
// Returns NULL with `c.had_error = true` if we're not inside a class
// body (ECMA-262 SyntaxError: "Unexpected private name").
fn mangle_private_name(c: Compiler*, name_start: u32, name_length: u32) -> ZjsString* {
    if c.enclosing_class_id < 0 {
        c.had_error = true;
        return NULL;
    }
    // name_length includes the leading `#`; skip it for the body.
    let body_ptr: char* = NULL;
    raw { body_ptr = c->source + name_start + 1; }
    let body_len: u32 = name_length - 1;
    let buf: char[64];
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let n: int = 0;
    raw {
        n = snprintf(bp, 64, "__zjs_priv_%u_%.*s",
                     (unsigned)c->enclosing_class_id,
                     (int)body_len, body_ptr);
    }
    if n < 0 || n >= 64 {
        // Overflow: name too long for our 64-byte buffer. Truncate
        // safely — collisions only matter across same-class same-id
        // and a 64-byte mangle is plenty for typical names.
        n = 63;
    }
    return ctx_intern_atom(c.ctx, bp, (u32)n);
}

fn compile_class_value(c: Compiler*, cls_node: AstNode*) -> u8 {
    // Find the constructor MethodDef among the children. The parser
    // may have synthesized one (num == 2.0) when fields exist without
    // an explicit constructor.
    let ctor_node: AstNode* = NULL;
    let i: u32 = 0;
    while i < cls_node.children_count {
        let m = cls_node.children[i];
        let mn = c.source + m.name_start;
        let ml = m.name_length;
        let is_ctor: int = 0;
        raw { is_ctor = (ml == 11 && memcmp(mn, "constructor", 11) == 0) ? 1 : 0; }
        // A STATIC method named "constructor" is an ordinary static member,
        // not the class constructor.
        if m.bool_value { is_ctor = 0; }
        if m.num == 2.0 { is_ctor = 1; }
        if is_ctor != 0 { ctor_node = m; }
        i = i + 1;
    }

    // Compile the constructor function. MethodDef shares the FunctionExpr
    // shape (children=params, left=body, name=name) so compile_function
    // accepts it directly. If absent, synthesize an empty node.
    let saved_class_parent = c.enclosing_class_parent;
    let saved_class_id     = c.enclosing_class_id;
    c.enclosing_class_parent = cls_node.right;
    // Allocate a fresh class id so `#x` in this class gets a hidden
    // key distinct from `#x` in any other class. Counter is on ctx
    // so it stays monotonic across nested compiles (compile_function
    // recursion for methods).
    c.ctx.class_id_counter = c.ctx.class_id_counter + 1;
    c.enclosing_class_id = (i32)c.ctx.class_id_counter;
    let ctor_fn: Function* = NULL;
    if ctor_node != NULL {
        ctor_fn = compile_function(c.ctx, c.source, ctor_node, c);
    } else {
        let empty: AstNode;
        let ep: AstNode* = NULL;
        raw { ep = &empty; }
        mem_zero<AstNode>(ep, 1);
        empty.kind = NodeKind::FunctionExpr;
        empty.name_start  = cls_node.name_start;
        empty.name_length = cls_node.name_length;
        empty.left = NULL;
        empty.children = NULL;
        empty.children_count = 0;
        let empty_ptr: AstNode* = NULL;
        raw { empty_ptr = &empty; }
        ctor_fn = compile_function(c.ctx, c.source, empty_ptr, c);
    }
    if ctor_fn == NULL { c.had_error = true; return alloc_reg(c); }
    ctor_fn.is_class_constructor = true;
    // Default derived ctor (no explicit constructor + extends): mark
    // so NewInvoke forwards args to the parent ctor.
    if ctor_node == NULL && cls_node.right != NULL
       && cls_node.right.kind != NodeKind::NullExpr {
        ctor_fn.is_default_derived_ctor = true;
    }
    // ECMA-262: classes have a `.name` data property set from the
    // class binding (or "" for anonymous class expressions). Install
    // it on the constructor's expando bag now. Spec attrs are
    // { writable: false, enumerable: false, configurable: true }.
    if cls_node.name_length > 0 {
        if ctor_fn.props == NULL {
            let pv = ctx_new_object(c.ctx);
            ctor_fn.props = zjs_as_object(pv);
        }
        let name_atom = ctx_intern_atom(c.ctx, (char*)"name", 4);
        let cls_name_v = ctx_intern_string(c.ctx,
                                           c.source + cls_node.name_start,
                                           cls_node.name_length);
        object_define_property_slot(c.ctx, ctor_fn.props, name_atom, cls_name_v,
                                    PROP_CONFIGURABLE);
    }

    // Spec: PrivateBoundNames of ClassBody must not contain duplicates,
    // EXCEPT a name shared by exactly one getter + one setter is OK.
    // Walk all class elements, intern their (mangled) private keys,
    // and reject duplicates inline. The accessor-pair exception is
    // tracked via two parallel bitmaps keyed by atom-pointer hash.
    let pname_atoms: ZjsString*[32];
    let pname_attrs: u8[32];  // bit 0 = saw plain, bit 1 = get, bit 2 = set
    let pname_count: u32 = 0;
    let pn_i: u32 = 0;
    while pn_i < cls_node.children_count {
        let pe = cls_node.children[pn_i];
        if pe != NULL && is_private_name(c, pe.name_start, pe.name_length) {
            let atom = mangle_private_name(c, pe.name_start, pe.name_length);
            if atom != NULL {
                let this_attr: u8 = 1;  // plain
                if pe.kind == NodeKind::MethodDef {
                    if pe.op == TokenKind::KwGet { this_attr = 2; }
                    else if pe.op == TokenKind::KwSet { this_attr = 4; }
                }
                let found: i32 = -1;
                let ai: u32 = 0;
                while ai < pname_count {
                    if pname_atoms[ai] == atom { found = (i32)ai; break; }
                    ai = ai + 1;
                }
                if found >= 0 {
                    let prev = pname_attrs[(u32)found];
                    // Only allowed combo: one get + one set (== 6).
                    // Anything else is a duplicate.
                    let combined: u8 = prev | this_attr;
                    let only_accessors: bool = (prev == 2 && this_attr == 4) || (prev == 4 && this_attr == 2);
                    if !only_accessors {
                        c.had_error = true;
                        return alloc_reg(c);
                    }
                    pname_attrs[(u32)found] = combined;
                } else if pname_count < 32 {
                    pname_atoms[pname_count] = atom;
                    pname_attrs[pname_count] = this_attr;
                    pname_count = pname_count + 1;
                }
            }
        }
        pn_i = pn_i + 1;
    }

    let ctor_ptr: void* = NULL;
    raw { ctor_ptr = (void*)ctor_fn; }
    ctx_register_cell(c.ctx, ctor_ptr);
    let ctor_val = zjs_cell_from_ptr(ctor_ptr);
    let ctor_idx = add_const(c, ctor_val);
    let ctor_reg = alloc_reg(c);
    emit(c, make_inst_a_u16(Op::LoadConst, ctor_reg, ctor_idx));

    // Closure wrap if the inner captures from us (matches FunctionDecl).
    if ctor_fn.needs_env {
        let cls_reg = alloc_reg(c);
        let env_reg: u8 = 0;
        if c.needs_env { env_reg = c.env_reg; }
        emit(c, make_inst_abc(Op::MakeClosure, cls_reg, ctor_reg, env_reg));
        release_reg(c, ctor_reg);
        ctor_reg = cls_reg;
    }

    // Load `<ctor>.prototype` into a register once for all methods.
    let proto_atom = ctx_intern_atom(c.ctx, (char*)"prototype", 9);
    let proto_ic = alloc_ic_slot(c, proto_atom);
    let proto_reg = alloc_reg(c);
    if proto_ic > 255 {
        c.had_error = true; return ctor_reg;
    }
    emit(c, make_inst_abc(Op::LoadProp, proto_reg, ctor_reg, (u8)proto_ic));

    // Attach each non-constructor method onto the prototype.
    let mi: u32 = 0;
    while mi < cls_node.children_count {
        let m = cls_node.children[mi];
        // Class fields are handled in their own pass below; skip here.
        if m.kind == NodeKind::ClassField { mi = mi + 1; continue; }
        let mn = c.source + m.name_start;
        let ml = m.name_length;
        // Computed-name methods are never the constructor (the
        // constructor is matched by the literal name "constructor").
        let is_computed_name = m.name_length == 0 && m.third != NULL;
        let is_ctor: int = 0;
        if !is_computed_name {
            raw { is_ctor = (ml == 11 && memcmp(mn, "constructor", 11) == 0) ? 1 : 0; }
        }
        // A STATIC method named "constructor" is an ordinary static member
        // (attaches to the constructor object), not the class constructor.
        if m.bool_value { is_ctor = 0; }
        // Parser sentinel for an auto-synthesized constructor (used
        // when the body has instance fields but no explicit ctor).
        if m.num == 2.0 { is_ctor = 1; }
        if is_ctor == 0 {
            // Compile method body as a function.
            let mfn = compile_function(c.ctx, c.source, m, c);
            if mfn == NULL {
                // Inner compile failed (e.g. SyntaxError inside the
                // method body). Propagate to the outer compiler so
                // the whole class declaration is treated as bad.
                c.had_error = true;
                return ctor_reg;
            }
            if mfn != NULL {
                mfn.is_method = true;
                // Set Function.name from the method name slice (matches
                // ECMA-262 §15.4.4: each MethodDefinition's function
                // value has .name = PropName). Skipped for computed-
                // name methods — those need runtime evaluation. Get/set
                // accessors get "get name" / "set name" prefix per spec.
                if !is_computed_name && m.name_length > 0 {
                    if mfn.props == NULL {
                        let pv = ctx_new_object(c.ctx);
                        mfn.props = zjs_as_object(pv);
                    }
                    let name_str: ZjsValue = zjs_undefined();
                    if m.op == TokenKind::KwGet || m.op == TokenKind::KwSet {
                        let prefix: char* = NULL;
                        raw { prefix = (m->op == 36 /* placeholder */) ? "set " : "get "; }
                        // Build "get <name>" / "set <name>". Use the
                        // m.op == KwGet vs KwSet to choose. Zen-c
                        // const-string concat at compile time would be
                        // overkill — snprintf into a stack buf.
                        let buf: char[128];
                        let bp: char* = NULL; raw { bp = &buf[0]; }
                        let nl: int = 0;
                        let name_d = c.source + m.name_start;
                        let name_l = m.name_length;
                        let is_get_kw: int = if m.op == TokenKind::KwGet { 1 } else { 0 };
                        raw {
                            nl = snprintf(bp, 128, "%s%.*s",
                                          is_get_kw ? "get " : "set ",
                                          (int)name_l, name_d);
                            if (nl < 0) nl = 0;
                            if (nl >= 128) nl = 127;
                        }
                        name_str = ctx_intern_string(c.ctx, bp, (u32)nl);
                    } else {
                        name_str = ctx_intern_string(c.ctx,
                                                     c.source + m.name_start,
                                                     m.name_length);
                    }
                    let name_atom_m = ctx_intern_atom(c.ctx, (char*)"name", 4);
                    object_define_property_slot(c.ctx, mfn.props, name_atom_m, name_str,
                                                PROP_CONFIGURABLE);
                }
                let mptr: void* = NULL;
                raw { mptr = (void*)mfn; }
                ctx_register_cell(c.ctx, mptr);
                let mval = zjs_cell_from_ptr(mptr);
                let midx = add_const(c, mval);
                let mreg = alloc_reg(c);
                emit(c, make_inst_a_u16(Op::LoadConst, mreg, midx));
                if mfn.needs_env {
                    let mcls = alloc_reg(c);
                    let env_reg2: u8 = 0;
                    if c.needs_env { env_reg2 = c.env_reg; }
                    emit(c, make_inst_abc(Op::MakeClosure, mcls, mreg, env_reg2));
                    release_reg(c, mreg);
                    mreg = mcls;
                }
                let target = if m.bool_value { ctor_reg } else { proto_reg };
                if is_computed_name {
                    // Computed key — evaluate at runtime. Accessor
                    // variants land in DefineMethodGetter/Setter; plain
                    // methods use DefineMethodComputed so the install
                    // attrs match the non-computed path (writable +
                    // configurable, non-enumerable, overwrites in
                    // place).
                    let key_r = compile_expr(c, m.third);
                    if m.op == TokenKind::KwGet {
                        emit(c, make_inst_abc(Op::DefineMethodGetter, target, key_r, mreg));
                    } else if m.op == TokenKind::KwSet {
                        emit(c, make_inst_abc(Op::DefineMethodSetter, target, key_r, mreg));
                    } else {
                        emit(c, make_inst_abc(Op::DefineMethodComputed, target, key_r, mreg));
                    }
                    release_reg(c, key_r);
                    release_reg(c, mreg);
                    mi = mi + 1;
                    continue;
                }
                // Canonicalize the method name — handles NumberLit and
                // StringLit name forms (`get 0x10()` / `set "foo"()`).
                let m_atom = intern_method_name_atom(c, m.name_start, ml);
                if m.op == TokenKind::KwGet {
                    let key_r = emit_load_atom(c, m_atom);
                    emit(c, make_inst_abc(Op::DefineMethodGetter, target, key_r, mreg));
                    release_reg(c, key_r);
                } else if m.op == TokenKind::KwSet {
                    let key_r = emit_load_atom(c, m_atom);
                    emit(c, make_inst_abc(Op::DefineMethodSetter, target, key_r, mreg));
                    release_reg(c, key_r);
                } else {
                    let m_ic = alloc_ic_slot(c, m_atom);
                    if m_ic <= 255 {
                        // static methods attach to the constructor itself
                        // (so `Foo.method(...)` works); instance methods go
                        // on the prototype as before. DefineMethod installs
                        // with non-enumerable attrs per spec.
                        emit(c, make_inst_abc(Op::DefineMethod, target, (u8)m_ic, mreg));
                    }
                }
                release_reg(c, mreg);
            }
        }
        mi = mi + 1;
    }

    // `extends Parent`: chain Child.prototype.[[Prototype]] = Parent.prototype
    // AND record the parent constructor on the Function* so
    // Object.getPrototypeOf(Child) === Parent. Evaluated AFTER methods
    // are attached so the methods land on the child's own prototype.
    if cls_node.right != NULL {
        // Special-case `extends null`: Foo.prototype.[[Prototype]] is
        // null (no parent_proto load); Foo.[[Prototype]] stays the
        // default Function.prototype (we don't SetParentCtor).
        if cls_node.right.kind == NodeKind::NullExpr {
            let null_reg = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadNull, null_reg));
            emit(c, make_inst_ab(Op::SetProto, null_reg, proto_reg));
            release_reg(c, null_reg);
        } else {
            let parent_reg = compile_expr(c, cls_node.right);
            let parent_proto_ic = alloc_ic_slot(c, ctx_intern_atom(c.ctx, (char*)"prototype", 9));
            let parent_proto_reg = alloc_reg(c);
            if parent_proto_ic <= 255 {
                emit(c, make_inst_abc(Op::LoadProp, parent_proto_reg, parent_reg, (u8)parent_proto_ic));
                emit(c, make_inst_ab(Op::SetProto, parent_proto_reg, proto_reg));
            }
            emit(c, make_inst_ab(Op::SetParentCtor, ctor_reg, parent_reg));
            release_reg(c, parent_proto_reg);
            if parent_reg + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        }
    }

    // Class STATIC elements — static field initializers and static
    // initialization blocks, run at class-definition time in SOURCE
    // ORDER (interleaved). Each evaluates with `this` bound to the
    // constructor; `super.x` resolves against the parent constructor.
    // We compile them inline here, temporarily routing `this` to
    // ctor_reg and flagging the static-super context. (Instance fields
    // are injected into the constructor body by the parser; here we
    // only handle the static half.)
    let saved_this_reg = c.this_reg;
    let saved_static_el = c.in_static_element;
    let saved_borrow = c.borrow_local_ok;
    c.this_reg = (i32)ctor_reg;
    c.in_static_element = true;
    c.borrow_local_ok = false;   // never hand out ctor_reg as a scratch dst
    let fi: u32 = 0;
    while fi < cls_node.children_count {
        let f = cls_node.children[fi];
        if f.kind == NodeKind::StaticBlock {
            // `static { ... }` — compile the block as its own function
            // (own var/lexical environment, per ECMA-262 ClassStaticBlock-
            // Body) and invoke it immediately with `this` = constructor.
            // compile_function reads f.left as the body, f.children (none)
            // as params, and flags the child compiler in_static_element so
            // `super.x` resolves against the parent constructor.
            let clos_reg = compile_function_value(c, f);
            let base = alloc_reg(c);    // callee slot
            let recv = alloc_reg(c);    // base+1 — the `this` receiver
            emit(c, make_inst_ab(Op::Mov, base, clos_reg));
            emit(c, make_inst_ab(Op::Mov, recv, ctor_reg));
            emit(c, make_inst_abc(Op::MethodInvoke, base, base, 0));
            release_reg(c, recv);
            release_reg(c, base);
            release_reg(c, clos_reg);
        } else if f.kind == NodeKind::ClassField && f.bool_value {
            let val_r: u8 = 0;
            if f.left != NULL {
                val_r = compile_expr(c, f.left);
            } else {
                val_r = alloc_reg(c);
                emit(c, make_inst_a(Op::LoadUndefined, val_r));
            }
            if f.name_length == 0 && f.third != NULL {
                // Computed static-field name.
                let key_r = compile_expr(c, f.third);
                emit(c, make_inst_abc(Op::StoreElem, ctor_reg, key_r, val_r));
                release_reg(c, key_r);
            } else {
                let name_atom: ZjsString* = NULL;
                if is_private_name(c, f.name_start, f.name_length) {
                    name_atom = mangle_private_name(c, f.name_start, f.name_length);
                }
                if name_atom == NULL {
                    name_atom = ctx_intern_atom(c.ctx, c.source + f.name_start, f.name_length);
                }
                emit_store_prop_atom(c, ctor_reg, name_atom, val_r);
            }
            release_reg(c, val_r);
        }
        fi = fi + 1;
    }
    c.this_reg = saved_this_reg;
    c.in_static_element = saved_static_el;
    c.borrow_local_ok = saved_borrow;

    release_reg(c, proto_reg);
    c.enclosing_class_parent = saved_class_parent;
    c.enclosing_class_id     = saved_class_id;
    return ctor_reg;
}

// Does any IdentExpr in this function's body reference `arguments`,
// not counting nested functions (which have their own arguments)?
// Scan a function body for any non-new.target `this` reference. Skips
// nested non-arrow functions (those have their own `this`). Arrow
// functions inherit lexically — they're scanned through.
fn body_uses_this(node: AstNode*) -> bool {
    if node == NULL { return false; }
    let k = node.kind;
    if k == NodeKind::FunctionDecl || k == NodeKind::FunctionExpr {
        return false;
    }
    if k == NodeKind::ThisExpr {
        return !node.bool_value;   // bool_value = new.target, not this
    }
    if node.left  != NULL && body_uses_this(node.left)  { return true; }
    if node.right != NULL && body_uses_this(node.right) { return true; }
    if node.third != NULL && body_uses_this(node.third) { return true; }
    let i: u32 = 0;
    while i < node.children_count {
        if body_uses_this(node.children[i]) { return true; }
        i = i + 1;
    }
    return false;
}

fn body_uses_arguments(c: Compiler*, node: AstNode*) -> bool {
    if node == NULL { return false; }
    let k = node.kind;
    if k == NodeKind::FunctionDecl || k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc {
        return false;   // nested fn — has its own arguments
    }
    if k == NodeKind::IdentExpr {
        let n = c.source + node.start;
        let nl = node.end - node.start;
        if nl == 9 {
            let is_arg: int = 0;
            raw { is_arg = (memcmp(n, "arguments", 9) == 0) ? 1 : 0; }
            if is_arg != 0 { return true; }
        }
        return false;
    }
    if node.left  != NULL && body_uses_arguments(c, node.left)  { return true; }
    if node.right != NULL && body_uses_arguments(c, node.right) { return true; }
    if node.third != NULL && body_uses_arguments(c, node.third) { return true; }
    let i: u32 = 0;
    while i < node.children_count {
        if body_uses_arguments(c, node.children[i]) { return true; }
        i = i + 1;
    }
    return false;
}

// Does the locals table already have a binding named "arguments"?
// (User-declared via var/let/const/function/class shadows our implicit one.)
fn has_arguments_local(c: Compiler*) -> bool {
    let i: u32 = 0;
    while i < c.local_count {
        if c.locals[i].name_length == 9 {
            let p = c.source + c.locals[i].name_start;
            let is_arg: int = 0;
            raw { is_arg = (memcmp(p, "arguments", 9) == 0) ? 1 : 0; }
            if is_arg != 0 { return true; }
        }
        i = i + 1;
    }
    return false;
}

// Postfix / prefix ++/-- on an identifier target. MVP — only IdentExpr;
// `obj.x++` and `arr[i]++` are future work.
// `x++` / `--x` on a bare identifier inside a `with` block: resolve `x`
// through the runtime with-object first (WithLookup), else normal scope —
// mirroring compile_assignment_with's GetValue/PutValue branch pattern.
fn compile_inc_dec_with(c: Compiler*, target: AstNode*, is_postfix: bool, is_inc: bool) -> u8 {
    let name = c.source + target.start;
    let name_len = target.end - target.start;
    let name_atom = ctx_intern_atom(c.ctx, name, name_len);

    let name_r = emit_load_atom(c, name_atom);
    let holder = alloc_reg(c);
    emit(c, make_inst_ab(Op::WithLookup, holder, name_r));
    release_reg(c, name_r);

    // GetValue: cur = holder ? holder[name] : normal-resolve(name).
    let cur = alloc_reg(c);
    let jl = emit(c, make_inst_a_i16(Op::JmpIfNullish, holder, 0));
    emit_load_prop_atom(c, cur, holder, name_atom);
    let jl_done = emit(c, make_inst_i16(Op::Jmp, 0));
    patch_jump(c, jl);
    emit_load_name_normal(c, name, name_len, cur);
    patch_jump(c, jl_done);

    // new = cur ± 1.
    let new_reg = alloc_reg(c);
    let op_ = if is_inc { Op::AddImm } else { Op::SubImm };
    emit(c, make_inst_abc(op_, new_reg, cur, (u8)1));

    // PutValue: holder ? holder[name]=new : normal-store(name, new).
    let js = emit(c, make_inst_a_i16(Op::JmpIfNullish, holder, 0));
    emit_store_prop_atom(c, holder, name_atom, new_reg);
    let js_done = emit(c, make_inst_i16(Op::Jmp, 0));
    patch_jump(c, js);
    emit_store_name_normal(c, name, name_len, new_reg);
    patch_jump(c, js_done);

    release_reg(c, holder);
    if is_postfix {
        release_reg(c, new_reg);
        return cur;
    }
    release_reg(c, cur);
    return new_reg;
}

fn compile_inc_dec(c: Compiler*, target: AstNode*, is_postfix: bool, is_inc: bool) -> u8 {
    if target == NULL {
        c.had_error = true;
        return alloc_reg(c);
    }
    // Member access target: `obj.prop++` / `obj.prop--`.
    if target.kind == NodeKind::Member {
        let obj_r = compile_expr(c, target.left);
        let name_atom = ctx_intern_atom(c.ctx, c.source + target.name_start, target.name_length);
        let cur = alloc_reg(c);
        emit_load_prop_atom(c, cur, obj_r, name_atom);
        let new_reg = alloc_reg(c);
        let op_ = if is_inc { Op::AddImm } else { Op::SubImm };
        emit(c, make_inst_abc(op_, new_reg, cur, (u8)1));
        emit_store_prop_atom(c, obj_r, name_atom, new_reg);
        if obj_r + 1 == c.next_reg
           || (target.left.kind != NodeKind::IdentExpr && obj_r + 2 == c.next_reg) {
            // Best-effort temp recovery — only release if obj_r was a
            // freshly-allocated temp adjacent to our cursor.
        }
        if is_postfix {
            release_reg(c, new_reg);
            return cur;
        }
        release_reg(c, cur);
        return new_reg;
    }
    // Computed access target: `obj[key]++`.
    if target.kind == NodeKind::Computed {
        let obj_r = compile_expr(c, target.left);
        let key_r = compile_expr(c, target.right);
        let cur = alloc_reg(c);
        emit(c, make_inst_abc(Op::LoadElem, cur, obj_r, key_r));
        let new_reg = alloc_reg(c);
        let op_ = if is_inc { Op::AddImm } else { Op::SubImm };
        emit(c, make_inst_abc(op_, new_reg, cur, (u8)1));
        emit(c, make_inst_abc(Op::StoreElem, obj_r, key_r, new_reg));
        if is_postfix {
            release_reg(c, new_reg);
            return cur;
        }
        release_reg(c, cur);
        return new_reg;
    }
    if target.kind != NodeKind::IdentExpr {
        c.had_error = true;
        return alloc_reg(c);
    }
    // Inside a `with`, a bare-identifier `x++` must resolve `x` through the
    // with-object first (same as `x += 1` does via compile_assignment_with).
    if c.with_depth > 0 {
        return compile_inc_dec_with(c, target, is_postfix, is_inc);
    }
    let name = c.source + target.start;
    let name_len = target.end - target.start;
    let local_idx = find_local_index(c, name, name_len);
    let captured_local = local_idx >= 0 && c.locals[(u32)local_idx].captured;
    let local_reg: u8 = if local_idx >= 0 { c.locals[(u32)local_idx].reg } else { 0 };

    let outer_depth: u32 = 0;
    if local_idx < 0 {
        outer_depth = outer_capture_depth(c, name, name_len);
        if outer_depth > 0 { c.has_outer_refs = true; }
    }

    let cur = alloc_reg(c);
    if local_idx >= 0 {
        if captured_local {
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            emit_load_prop_atom(c, cur, c.env_reg, name_atom);
        } else {
            emit(c, make_inst_ab(Op::Mov, cur, local_reg));
        }
    } else if outer_depth > 0 {
        let env_r = emit_env_chain_walk(c, outer_depth);
        let name_atom = ctx_intern_atom(c.ctx, name, name_len);
        emit_load_prop_atom(c, cur, env_r, name_atom);
        release_reg(c, env_r);
    } else {
        let slot = ctx_intern_global(c.ctx, name, name_len);
        emit(c, make_inst_a_u16(Op::LoadGlobal, cur, (u16)slot));
    }

    // Fused: `cur ± 1` collapses to AddImm/SubImm — saves a LoadInt
    // and a dispatch per ++/--.
    let new_reg = alloc_reg(c);
    let op_ = if is_inc { Op::AddImm } else { Op::SubImm };
    emit(c, make_inst_abc(op_, new_reg, cur, (u8)1));

    if local_idx >= 0 {
        if captured_local {
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            emit_store_prop_atom(c, c.env_reg, name_atom, new_reg);
        } else {
            emit(c, make_inst_ab(Op::Mov, local_reg, new_reg));
        }
    } else if outer_depth > 0 {
        let env_r = emit_env_chain_walk(c, outer_depth);
        let name_atom = ctx_intern_atom(c.ctx, name, name_len);
        emit_store_prop_atom(c, env_r, name_atom, new_reg);
        release_reg(c, env_r);
    } else {
        let slot = ctx_intern_global(c.ctx, name, name_len);
        emit(c, make_inst_a_u16(Op::StoreGlobal, new_reg, (u16)slot));
    }

    if is_postfix {
        release_reg(c, new_reg);
        return cur;
    }
    release_reg(c, cur);
    return new_reg;
}

fn compile_call_inner(c: Compiler*, node: AstNode*) -> u8;

fn compile_call(c: Compiler*, node: AstNode*) -> u8 {
    // Outer's preferred_dst (if any) refers to the call's RESULT
    // register — not where any internal slot (callee/recv/args)
    // should go. Save + clear at the boundary so inner compile_expr
    // calls don't see a stale hint via LoadGlobal alloc_dst.
    let outer_pd = c.preferred_dst;
    c.preferred_dst = -1;
    let r = compile_call_inner(c, node);
    c.preferred_dst = outer_pd;
    return r;
}

fn compile_call_inner(c: Compiler*, node: AstNode*) -> u8 {
    let callee = node.left;
    let is_method = callee != NULL && (callee.kind == NodeKind::Member || callee.kind == NodeKind::Computed);

    let arg_count: u8 = (u8)node.children_count;

    // Spread detection: any `...expr` arg switches the whole call to
    // the variadic SpreadInvoke / SpreadMethodInvoke path. Args get
    // materialized into a single array (using ArrayPush/ArraySpread),
    // then the variadic op reads argc from the array at runtime.
    let has_spread_arg: bool = false;
    let sa_i: u32 = 0;
    while sa_i < node.children_count {
        if node.children[sa_i].kind == NodeKind::Spread {
            has_spread_arg = true; break;
        }
        sa_i = sa_i + 1;
    }
    if has_spread_arg && callee != NULL && callee.kind != NodeKind::SuperExpr {
        let slots_needed: u8 = if is_method { 3 } else { 2 };
        let base = c.next_reg;
        let r: u8 = 0;
        while r < slots_needed { alloc_reg(c); r = r + 1; }

        // Place callee + receiver in the standard layout.
        let spread_is_super: bool = is_method && callee.left != NULL
                                    && callee.left.kind == NodeKind::SuperExpr;
        if spread_is_super {
            // `super.m(...args)` with a spread: receiver is the current
            // `this`, method comes off enclosing-class parent.prototype —
            // mirrors the non-spread super-member path. (#334 warm-up.)
            if c.enclosing_class_parent == NULL { c.had_error = true; return base; }
            emit(c, make_inst_a(Op::LoadThis, base + 1));
            let parent_r = compile_expr(c, c.enclosing_class_parent);
            let proto_key = emit_load_name_string(c, (char*)"prototype", 9);
            let holder_r = alloc_reg(c);
            emit(c, make_inst_abc(Op::LoadElem, holder_r, parent_r, proto_key));
            if proto_key + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            if parent_r != holder_r && parent_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            if callee.kind == NodeKind::Member {
                let k2 = emit_load_name_string(c, c.source + callee.name_start, callee.name_length);
                emit(c, make_inst_abc(Op::LoadElem, base, holder_r, k2));
                if k2 + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            } else {
                let k3 = compile_expr(c, callee.right);
                emit(c, make_inst_abc(Op::LoadElem, base, holder_r, k3));
                if k3 + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            if holder_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        } else if is_method {
            let recv_r = compile_expr(c, callee.left);
            if recv_r != base + 1 {
                emit(c, make_inst_ab(Op::Mov, base + 1, recv_r));
                if recv_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            if callee.kind == NodeKind::Member {
                let name_atom = ctx_intern_atom(c.ctx, c.source + callee.name_start, callee.name_length);
                let ic = alloc_ic_slot(c, name_atom);
                if ic > 255 {
                    let key_r = emit_load_name_string(c, c.source + callee.name_start, callee.name_length);
                    emit(c, make_inst_abc(Op::LoadElem, base, base + 1, key_r));
                    if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                } else {
                    emit(c, make_inst_abc(Op::LoadProp, base, base + 1, (u8)ic));
                }
            } else {
                let key_r = compile_expr(c, callee.right);
                emit(c, make_inst_abc(Op::LoadElem, base, base + 1, key_r));
                if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
        } else {
            let r2 = compile_expr(c, callee);
            if r2 != base {
                emit(c, make_inst_ab(Op::Mov, base, r2));
                if r2 + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
        }

        // Build args array dynamically — ArrayPush for plain args,
        // ArraySpread for `...expr`.
        let args_slot: u8 = if is_method { base + 2 } else { base + 1 };
        emit(c, make_inst_abc(Op::NewArray, args_slot, 0, 0));
        let j: u32 = 0;
        while j < node.children_count {
            let ch = node.children[j];
            if ch.kind == NodeKind::Spread {
                let src_r = compile_expr(c, ch.left);
                emit(c, make_inst_ab(Op::ArraySpread, args_slot, src_r));
                if src_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            } else {
                let val_r = compile_expr(c, ch);
                emit(c, make_inst_ab(Op::ArrayPush, args_slot, val_r));
                if val_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            j = j + 1;
        }

        let dispatch_op = if is_method { Op::SpreadMethodInvoke } else { Op::SpreadInvoke };
        emit(c, make_inst_abc(dispatch_op, base, base, 0));
        c.next_reg = base + 1;
        if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
        return base;
    }

    // super(...) in a derived-class constructor: emit Op::SuperCall
    // which preserves the current `this` and new-target. Resolves the
    // parent expression through the enclosing-class context.
    if callee != NULL && callee.kind == NodeKind::SuperExpr {
        if c.enclosing_class_parent == NULL {
            c.had_error = true;
            return alloc_reg(c);
        }
        // super(...args): materialize the args into an array (like the
        // SpreadInvoke path) and emit SpreadSuperCall — esbuild produces
        // this when lowering a subclass with instance fields.
        if has_spread_arg {
            let s_base = c.next_reg;
            alloc_reg(c);                 // base   = parent ctor
            let args_slot = alloc_reg(c); // base+1 = args array
            let saved_pd_ss = c.preferred_dst;
            c.preferred_dst = (i32)s_base;
            let parent_rs = compile_expr(c, c.enclosing_class_parent);
            c.preferred_dst = saved_pd_ss;
            if parent_rs != s_base {
                emit(c, make_inst_ab(Op::Mov, s_base, parent_rs));
                if parent_rs + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            emit(c, make_inst_abc(Op::NewArray, args_slot, 0, 0));
            let sj: u32 = 0;
            while sj < node.children_count {
                let sch = node.children[sj];
                if sch.kind == NodeKind::Spread {
                    let src_rs = compile_expr(c, sch.left);
                    emit(c, make_inst_ab(Op::ArraySpread, args_slot, src_rs));
                    if src_rs + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                } else {
                    let val_rs = compile_expr(c, sch);
                    emit(c, make_inst_ab(Op::ArrayPush, args_slot, val_rs));
                    if val_rs + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                }
                sj = sj + 1;
            }
            emit(c, make_inst_abc(Op::SpreadSuperCall, s_base, s_base, 0));
            c.next_reg = s_base + 1;
            if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
            return s_base;
        }
        let base = c.next_reg;
        let slots_needed: u8 = 1 + arg_count;
        let r: u8 = 0;
        while r < slots_needed { alloc_reg(c); r = r + 1; }
        // Parent ctor into regs[base].
        let saved_pd_sp = c.preferred_dst;
        c.preferred_dst = (i32)base;
        let parent_r = compile_expr(c, c.enclosing_class_parent);
        c.preferred_dst = saved_pd_sp;
        if parent_r != base {
            emit(c, make_inst_ab(Op::Mov, base, parent_r));
            if parent_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        }
        // Args into regs[base+1..].
        let j: u8 = 0;
        while j < arg_count {
            let target_slot = base + 1 + j;
            let saved_pd_sa = c.preferred_dst;
            c.preferred_dst = (i32)target_slot;
            let arg_r = compile_expr(c, node.children[j]);
            c.preferred_dst = saved_pd_sa;
            if arg_r != target_slot {
                emit(c, make_inst_ab(Op::Mov, target_slot, arg_r));
                if arg_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            j = j + 1;
        }
        emit(c, make_inst_abc(Op::SuperCall, base, base, arg_count));
        c.next_reg = base + 1;
        if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
        return base;
    }

    // Specialized built-in dispatch. Pattern: `Math.sqrt(x)` where `Math`
    // is the global Math (not a local / not a captured outer). Folds
    // LoadGlobal(Math) + LoadProp(sqrt) + MethodInvoke into a single op.
    // Doesn't honor user-installed overrides on Math — same compromise
    // as Hermes/V8 take for known intrinsics.
    if is_method && !has_spread_arg
       && callee.kind == NodeKind::Member
       && callee.left != NULL && callee.left.kind == NodeKind::IdentExpr
       && callee.left.end - callee.left.start == 4
       && arg_count == 1 {
        let obj_name = c.source + callee.left.start;
        let is_math: int = 0;
        raw { is_math = (memcmp(obj_name, "Math", 4) == 0) ? 1 : 0; }
        if is_math != 0 {
            // `Math` must resolve to global — no local or captured outer
            // shadow.
            let math_local = find_local_index(c, obj_name, 4);
            let math_outer: u32 = 0;
            if math_local < 0 { math_outer = outer_capture_depth(c, obj_name, 4); }
            if math_local < 0 && math_outer == 0 {
                let method_name = c.source + callee.name_start;
                let method_len  = callee.name_length;
                let is_sqrt:  int = 0;
                let is_abs:   int = 0;
                let is_floor: int = 0;
                let is_ceil:  int = 0;
                raw {
                    is_sqrt  = (method_len == 4 && memcmp(method_name, "sqrt",  4) == 0) ? 1 : 0;
                    is_abs   = (method_len == 3 && memcmp(method_name, "abs",   3) == 0) ? 1 : 0;
                    is_floor = (method_len == 5 && memcmp(method_name, "floor", 5) == 0) ? 1 : 0;
                    is_ceil  = (method_len == 4 && memcmp(method_name, "ceil",  4) == 0) ? 1 : 0;
                }
                if is_sqrt != 0 || is_abs != 0 || is_floor != 0 || is_ceil != 0 {
                    let spec_op: Op = Op::MathSqrt;
                    if      is_abs   != 0 { spec_op = Op::MathAbs; }
                    else if is_floor != 0 { spec_op = Op::MathFloor; }
                    else if is_ceil  != 0 { spec_op = Op::MathCeil; }
                    let dst = alloc_reg(c);
                    let arg_r = compile_expr(c, node.children[0]);
                    emit(c, make_inst_ab(spec_op, dst, arg_r));
                    if arg_r + 1 == c.next_reg && arg_r != dst { c.next_reg = c.next_reg - 1; }
                    if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
                    return dst;
                }
            }
        }
    }

    if is_method {
        // Method call: regs[base]=method, regs[base+1]=receiver,
        // regs[base+2..]=args. Receiver is the member's object; LoadProp
        // (or LoadElem for computed) reads the method off it.
        //
        // Super-rooted member call: `super.m(...)` / `super[expr](...)`.
        // Spec: receiver is the CURRENT `this`, but the method is
        // looked up on the enclosing class's parent prototype — we
        // resolve `enclosing_class_parent.prototype` and read the
        // method off that.
        let is_super_member: bool = callee.left != NULL && callee.left.kind == NodeKind::SuperExpr;
        let slots_needed: u8 = 2 + arg_count;
        let base = c.next_reg;
        let r: u8 = 0;
        while r < slots_needed { alloc_reg(c); r = r + 1; }

        if is_super_member {
            if c.enclosing_class_parent == NULL {
                c.had_error = true;
                return base;
            }
            // Receiver = current `this`. In a static element `this` is
            // the constructor (routed through this_reg); otherwise read
            // it from the frame's host_this.
            if c.in_static_element && c.this_reg >= 0 {
                emit(c, make_inst_ab(Op::Mov, base + 1, (u8)c.this_reg));
            } else {
                emit(c, make_inst_a(Op::LoadThis, base + 1));
            }
            // Method holder: instance context → parent.prototype; static
            // context → the parent constructor itself. A regular LoadElem
            // reads the `.prototype` slot when needed.
            let parent_r = compile_expr(c, c.enclosing_class_parent);
            let holder_r: u8 = parent_r;
            if !c.in_static_element {
                let proto_key = emit_load_name_string(c, (char*)"prototype", 9);
                holder_r = alloc_reg(c);
                emit(c, make_inst_abc(Op::LoadElem, holder_r, parent_r, proto_key));
                if proto_key + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                if parent_r != holder_r && parent_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            if callee.kind == NodeKind::Member {
                let key2 = emit_load_name_string(c, c.source + callee.name_start, callee.name_length);
                emit(c, make_inst_abc(Op::LoadElem, base, holder_r, key2));
                if key2 + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            } else {
                let key3 = compile_expr(c, callee.right);
                emit(c, make_inst_abc(Op::LoadElem, base, holder_r, key3));
                if key3 + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            if holder_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        } else {
            // Compile receiver into regs[base+1] using preferred_dst so
            // the recv expression's terminal op writes there directly.
            c.preferred_dst = (i32)(base + 1);
            let recv_r = compile_expr(c, callee.left);
            c.preferred_dst = -1;
            if recv_r != base + 1 {
                emit(c, make_inst_ab(Op::Mov, base + 1, recv_r));
                if recv_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }

            // Load the method into regs[base].
            if callee.kind == NodeKind::Member {
                let name_atom: ZjsString* = NULL;
                if is_private_name(c, callee.name_start, callee.name_length) {
                    name_atom = mangle_private_name(c, callee.name_start, callee.name_length);
                    if name_atom == NULL { return 0; }
                } else {
                    name_atom = ctx_intern_atom(c.ctx, c.source + callee.name_start, callee.name_length);
                }
                let ic = alloc_ic_slot(c, name_atom);
                if ic > 255 {
                    // Out of IC slots: fall back to LoadElem with the
                    // already-interned (possibly mangled) atom.
                    let key_r = emit_load_atom(c, name_atom);
                    emit(c, make_inst_abc(Op::LoadElem, base, base + 1, key_r));
                    if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
                } else {
                    emit(c, make_inst_abc(Op::LoadProp, base, base + 1, (u8)ic));
                }
            } else {
                // Computed: LoadElem regs[base], recv, key.
                let key_r = compile_expr(c, callee.right);
                emit(c, make_inst_abc(Op::LoadElem, base, base + 1, key_r));
                if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
        }

        // Args into regs[base+2..]. Use preferred_dst so the
        // expression's final op lands directly in the call slot.
        let j: u8 = 0;
        while j < arg_count {
            let target_slot = base + 2 + j;
            c.preferred_dst = (i32)target_slot;
            let arg_r = compile_expr(c, node.children[j]);
            c.preferred_dst = -1;
            if arg_r != target_slot {
                emit(c, make_inst_ab(Op::Mov, target_slot, arg_r));
                if arg_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            }
            j = j + 1;
        }

        emit(c, make_inst_abc(Op::MethodInvoke, base, base, arg_count));

        c.next_reg = base + 1;
        if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
        return base;
    }

    // Plain call: regs[base] = callee, regs[base+1..] = args.
    let base = c.next_reg;
    let i: u8 = 0;
    while i <= arg_count {
        alloc_reg(c);
        i = i + 1;
    }

    // Pass preferred_dst = base so a LoadGlobal/LoadProp/etc callee
    // writes directly into the call slot. compile_expr clears the
    // hint on first dst alloc.
    c.preferred_dst = (i32)base;
    let r = compile_expr(c, node.left);
    c.preferred_dst = -1;

    // #394 InvokeGlobal fusion. The callee just compiled to a single
    // terminal `LoadGlobal base, slot` — exactly the global-function
    // call shape. Pop it (pure append buffer, nothing can reference
    // the slot yet; a loop-head label at this index now points at the
    // first arg op, which is still the start of the call) and remember
    // the slot; the fused pair is emitted after the args below. Gated
    // on pure args (evaluation-order, see fusion_arg_is_pure) and on
    // NOT being the ReturnStmt tail-rewrite candidate (the TCO
    // rewriter matches `last op == Op::Invoke` in place — fusing there
    // would silently drop TCO).
    let fuse_slot: i32 = -1;
    if invoke_fusion_enabled()
       && node != c.tail_call_node
       && r == base
       && c.code_count > 0
       && c.code[c.code_count - 1].op == Op::LoadGlobal
       && c.code[c.code_count - 1].a == base
       && call_args_fusion_pure(c, node, arg_count) {
        fuse_slot = (i32)inst_bc_u16(c.code[c.code_count - 1]);
        c.code_count = c.code_count - 1;
    }

    if r != base {
        emit(c, make_inst_ab(Op::Mov, base, r));
        if r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
    }

    let j: u8 = 0;
    while j < arg_count {
        let target_slot = base + 1 + j;
        c.preferred_dst = (i32)target_slot;
        let arg_r = compile_expr(c, node.children[j]);
        c.preferred_dst = -1;
        if arg_r != target_slot {
            emit(c, make_inst_ab(Op::Mov, target_slot, arg_r));
            if arg_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        }
        j = j + 1;
    }

    if fuse_slot >= 0 {
        emit(c, make_inst_abc(Op::InvokeGlobal, base, base, arg_count));
        // Carrier: u16 global slot in an Op::Jmp placeholder (the
        // JmpIf* convention). Never dispatched — the handler
        // pre-increments ip past it.
        emit(c, make_inst_u16(Op::Jmp, (u16)fuse_slot));
    } else {
        emit(c, make_inst_abc(Op::Invoke, base, base, arg_count));
    }

    c.next_reg = base + 1;
    if c.next_reg > c.max_reg { c.max_reg = c.next_reg; }
    return base;
}

// =====================================================================
// Capture analysis. Walks nested function bodies in this function's
// body and marks the current function's locals as `captured` whenever
// any nested function references them.
//
// MVP scope: only one level of nesting. Names referenced by a nested
// function that aren't in its own locals are checked against the
// CURRENT compiler's locals (not the chain) — so a deeply-nested
// function only captures from its immediate parent. Multi-level
// capture is deferred.
// =====================================================================

// Does the nested function `fn_node` (FunctionDecl/Expr/ArrowFunc)
// declare `name` as one of its own locals (param or var)?
// AST pre-pass. Returns true if `body` contains any IdentExpr that
// (a) isn't local to `c` and (b) is local to some ancestor compiler.
// Used at the start of compile_function to decide whether `c` needs
// to allocate an env to forward via __outer__ to its nested closures.
//
// Walks across nested function/arrow boundaries — references inside
// deeply-nested functions also count as outer refs for THIS function
// if they target our parent or further up. Shadowing inside the inner
// scope is approximated: we treat any reference to a name as "needs
// outer" if NEITHER c nor any ancestor between c and the reference
// declares it (the reference might still be a global, which we handle
// by checking it's local in some ancestor).
fn detect_outer_refs(c: Compiler*, body: AstNode*, source: char*) -> bool {
    if body == NULL { return false; }
    let k = body.kind;
    if k == NodeKind::IdentExpr {
        let nm = source + body.start;
        let nl = body.end - body.start;
        if find_local_index(c, nm, nl) >= 0 { return false; }
        let anc: Compiler* = c.parent;
        while anc != NULL {
            if find_local_index(anc, nm, nl) >= 0 { return true; }
            anc = anc.parent;
        }
        return false;
    }
    if k == NodeKind::FunctionDecl || k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc {
        if body.left != NULL && detect_outer_refs(c, body.left, source) { return true; }
        return false;
    }
    if body.left  != NULL && detect_outer_refs(c, body.left,  source) { return true; }
    if body.right != NULL && detect_outer_refs(c, body.right, source) { return true; }
    if body.third != NULL && detect_outer_refs(c, body.third, source) { return true; }
    let i: u32 = 0;
    while i < body.children_count {
        if detect_outer_refs(c, body.children[i], source) { return true; }
        i = i + 1;
    }
    return false;
}

// True if `c` has at least one own local marked captured (i.e., it
// will allocate its own env at function entry).
fn compiler_has_own_env(c: Compiler*) -> bool {
    let i: u32 = 0;
    while i < c.local_count {
        if c.locals[i].captured { return true; }
        i = i + 1;
    }
    return false;
}

// Walk the lexical compiler chain looking for a captured local. Returns
// the ENV-CHAIN depth (counting only ancestors that have their own env)
// from our current_closure.env to the env that holds the name. Returns
// 0 if not found. Side effect: every PASS-THROUGH intermediate (no own
// env yet flagged as outer-ref) gets has_outer_refs=true.
//
// depth=1 means current_closure.env IS the target env (just LoadEnv +
// final LoadProp). Each additional own-env ancestor between us and the
// target adds one __outer__ walk.
fn outer_capture_depth(c: Compiler*, name: char*, name_len: u32) -> u32 {
    let anc: Compiler* = c.parent;
    let env_depth: u32 = 0;
    while anc != NULL {
        let oi = find_local_index(anc, name, name_len);
        if oi >= 0 && anc.locals[(u32)oi].captured {
            // Mark every passthrough intermediate from c.parent up
            // to (but not including) anc as has_outer_refs so their
            // MakeClosure emit forwards env via LoadEnv.
            let mark: Compiler* = c.parent;
            while mark != anc {
                mark.has_outer_refs = true;
                mark = mark.parent;
            }
            // #288: per-iter env hop correction. Closures emitted
            // inside a for-of body capture the per-iter env, NOT the
            // surrounding function's normal env. extra_env_hops is
            // the count of per-iter envs the closure must walk past
            // (via __outer__) to reach the parent's natural chain.
            //
            // But a local DECLARED on one of those per-iter envs
            // lives directly on it — no extra hop needed for that
            // one. local.per_iter_depth records which per-iter env
            // the local sits on; we subtract from extra_env_hops
            // so loop-var lookups stay at depth=1.
            let extra: u32 = c.extra_env_hops;
            let lp = anc.locals[(u32)oi].per_iter_depth;
            if lp > extra { extra = 0; } else { extra = extra - lp; }
            return env_depth + 1 + extra;
        }
        // Skipping anc — only counts toward env depth if it has its
        // own env. has_outer_refs alone (passthrough) doesn't add.
        if compiler_has_own_env(anc) { env_depth = env_depth + 1; }
        anc = anc.parent;
    }
    return 0;
}

// Emit a register holding the env at `depth` levels up the chain.
// Allocates a fresh temp register OR returns the cached prologue reg
// when depth==1 and one is set up. release_reg on the returned value
// is a no-op for the cached (sub-fixed_regs) reg, so callers don't
// need to special-case the borrow.
// depth must be >= 1.
fn emit_env_chain_walk(c: Compiler*, depth: u32) -> u8 {
    if depth == 1 && c.cached_outer_env_reg >= 0 {
        return (u8)c.cached_outer_env_reg;
    }
    let env_r = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadEnv, env_r));
    let outer_atom = ctx_intern_atom(c.ctx, OUTER_ENV_KEY, OUTER_ENV_KEY_LEN);
    let w: u32 = 1;
    while w < depth {
        let ic_outer = alloc_ic_slot(c, outer_atom);
        emit(c, make_inst_abc(Op::LoadProp, env_r, env_r, (u8)ic_outer));
        w = w + 1;
    }
    return env_r;
}

fn name_is_local_of_function(fn_node: AstNode*, source: char*, name: char*, name_len: u32) -> bool {
    // Params
    let i: u32 = 0;
    while i < fn_node.children_count {
        let p = fn_node.children[i];
        if p.kind == NodeKind::IdentExpr {
            let p_len = p.end - p.start;
            if p_len == name_len {
                let p_name = source + p.start;
                let eq: int = 0;
                raw { eq = (memcmp(p_name, name, name_len) == 0) ? 1 : 0; }
                if eq != 0 { return true; }
            }
        }
        i = i + 1;
    }
    // Walk body for var/let/const declarations + the function name itself
    return body_declares_name(fn_node.left, source, name, name_len);
}

fn body_declares_name(node: AstNode*, source: char*, name: char*, name_len: u32) -> bool {
    if node == NULL { return false; }
    let k = node.kind;

    if k == NodeKind::VarDecl {
        let i: u32 = 0;
        while i < node.children_count {
            let decl = node.children[i];
            if decl.name_length == name_len {
                let d_name = source + decl.name_start;
                let eq: int = 0;
                raw { eq = (memcmp(d_name, name, name_len) == 0) ? 1 : 0; }
                if eq != 0 { return true; }
            }
            i = i + 1;
        }
        return false;
    }
    if k == NodeKind::FunctionDecl {
        if node.name_length == name_len {
            let n_name = source + node.name_start;
            let eq: int = 0;
            raw { eq = (memcmp(n_name, name, name_len) == 0) ? 1 : 0; }
            if eq != 0 { return true; }
        }
        return false;  // don't descend
    }
    if k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc {
        return false;
    }

    if node.left  != NULL { if body_declares_name(node.left,  source, name, name_len) { return true; } }
    if node.right != NULL { if body_declares_name(node.right, source, name, name_len) { return true; } }
    if node.third != NULL { if body_declares_name(node.third, source, name, name_len) { return true; } }
    let i: u32 = 0;
    while i < node.children_count {
        if body_declares_name(node.children[i], source, name, name_len) { return true; }
        i = i + 1;
    }
    return false;
}

// Walk a nested function's body. For every IdentExpr / Assignment-target
// IdentExpr whose name isn't local to the nested function, check
// whether it matches one of `c`'s locals. If so, mark that local as
// captured.
fn scan_inner_for_captures(c: Compiler*, fn_node: AstNode*, body: AstNode*) -> void {
    if body == NULL { return; }
    let k = body.kind;

    if k == NodeKind::IdentExpr {
        let name = c.source + body.start;
        let name_len = body.end - body.start;
        if !name_is_local_of_function(fn_node, c.source, name, name_len) {
            let idx = find_local_index(c, name, name_len);
            if idx >= 0 {
                c.locals[(u32)idx].captured = true;
                c.needs_env = true;
            }
        }
        return;
    }

    if k == NodeKind::Assignment {
        // Target might be IdentExpr — same logic
        let target = body.left;
        if target != NULL && target.kind == NodeKind::IdentExpr {
            let name = c.source + target.start;
            let name_len = target.end - target.start;
            if !name_is_local_of_function(fn_node, c.source, name, name_len) {
                let idx = find_local_index(c, name, name_len);
                if idx >= 0 {
                    c.locals[(u32)idx].captured = true;
                    c.needs_env = true;
                }
            }
        } else if target != NULL {
            scan_inner_for_captures(c, fn_node, target);
        }
        if body.right != NULL { scan_inner_for_captures(c, fn_node, body.right); }
        return;
    }

    if k == NodeKind::FunctionDecl || k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc {
        // Descend into nested function bodies so transitive captures
        // are discovered. `fn_node` stays the IMMEDIATE inner function
        // we're scanning *for* (used to gate "is this name a local of
        // the inner?"); when we recurse into a doubly-nested function,
        // we conservatively keep fn_node — works for the common case
        // where the deeply-nested code doesn't shadow the
        // outer-function name we're looking for. (TODO: precise scope
        // tracking for shadow cases.)
        if body.left != NULL {
            scan_inner_for_captures(c, body, body.left);
        }
        return;
    }

    if body.left  != NULL { scan_inner_for_captures(c, fn_node, body.left); }
    if body.right != NULL { scan_inner_for_captures(c, fn_node, body.right); }
    if body.third != NULL { scan_inner_for_captures(c, fn_node, body.third); }
    let i: u32 = 0;
    while i < body.children_count {
        scan_inner_for_captures(c, fn_node, body.children[i]);
        i = i + 1;
    }
}

// Walk the outer function's body looking for nested functions. For
// each one, scan it for captures of `c`'s locals.
fn analyze_captures(c: Compiler*, node: AstNode*) -> void {
    if node == NULL { return; }
    let k = node.kind;

    if k == NodeKind::BlockStmt {
        // Walk into the block with its scope active so scan_inner_for_captures
        // (which calls find_local_index against our locals) sees the block's
        // own let/const bindings as in-scope at the inner function's
        // definition site. Without this, a closure declared inside a block
        // that captures a block-scoped local would miss the binding and
        // get an unrooted/empty reference.
        enter_scope_reuse(c, node);
        let i: u32 = 0;
        while i < node.children_count {
            analyze_captures(c, node.children[i]);
            i = i + 1;
        }
        exit_scope(c);
        return;
    }

    if k == NodeKind::ForStmt {
        // collect_locals opens a scope for the for-statement (its
        // let/const init bindings live there); mirror it (#381 — this
        // walk previously fell through to the generic descent WITHOUT
        // entering the scope, so before node-stored ids every for-loop
        // desynced this pass's ids from collect's and every later
        // block's captures were checked against the wrong scope).
        enter_scope_reuse(c, node);
        if node.left  != NULL { analyze_captures(c, node.left); }
        if node.right != NULL { analyze_captures(c, node.right); }
        if node.third != NULL { analyze_captures(c, node.third); }
        let fi: u32 = 0;
        while fi < node.children_count {
            analyze_captures(c, node.children[fi]);
            fi = fi + 1;
        }
        exit_scope(c);
        return;
    }

    if k == NodeKind::FunctionDecl || k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc {
        // Found a nested function. Scan its body for outer-name refs.
        if node.left != NULL {
            scan_inner_for_captures(c, node, node.left);
        }
        return;
    }
    if k == NodeKind::ClassDecl || k == NodeKind::ClassExpr {
        // Each MethodDef child is its own nested function. Scan their
        // bodies for outer-name refs. Also scan the parent (extends)
        // expression as if each method referenced it — methods access
        // it implicitly via `super.X` / `super.X(...)`, and there's no
        // explicit IdentExpr for analyze_captures to spot.
        let parent_expr = node.right;
        let i: u32 = 0;
        while i < node.children_count {
            let m = node.children[i];
            if m.left != NULL { scan_inner_for_captures(c, m, m.left); }
            if parent_expr != NULL { scan_inner_for_captures(c, m, parent_expr); }
            i = i + 1;
        }
        // Also walk the parent expr in our own scope — class
        // declarations evaluate the parent expression at class
        // creation time, so any names used there are referenced by
        // the enclosing scope as well (the class itself, not its
        // methods). The general-fallback recursion below covers this
        // because the ClassDecl branch returns early; recurse
        // explicitly to compensate.
        if parent_expr != NULL { analyze_captures(c, parent_expr); }
        return;
    }

    if node.left  != NULL { analyze_captures(c, node.left); }
    if node.right != NULL { analyze_captures(c, node.right); }
    if node.third != NULL { analyze_captures(c, node.third); }
    let i: u32 = 0;
    while i < node.children_count {
        analyze_captures(c, node.children[i]);
        i = i + 1;
    }
}

// Hoist var/let/const and nested FunctionDecl name bindings into the
// current compiler's locals. Does NOT descend into nested function
// bodies (each has its own compile_function pass).
// Walk a binding pattern and register each contained name as a
// module/function-scope local. Used by collect_locals' VarDecl
// branch + function-param entry. Nested patterns recurse.
fn collect_pattern_locals(c: Compiler*, pat: AstNode*) -> void {
    if pat == NULL { return; }
    let k = pat.kind;
    if k == NodeKind::IdentExpr {
        alloc_and_add_local(c, pat.name_start, pat.name_length);
        return;
    }
    if k == NodeKind::ObjectPattern || k == NodeKind::ArrayPattern {
        let i: u32 = 0;
        while i < pat.children_count {
            let entry = pat.children[i];
            if entry.left != NULL {
                collect_pattern_locals(c, entry.left);
            }
            i = i + 1;
        }
        return;
    }
}

// Forward decls: the destructure helpers are mutually recursive with
// bind_destructure_target (which recurses back through nested patterns).
fn destructure_pattern(c: Compiler*, pat: AstNode*, src_reg: u8) -> void;
fn destructure_object(c: Compiler*, pat: AstNode*, src_reg: u8) -> void;
fn destructure_array(c: Compiler*, pat: AstNode*, src_reg: u8) -> void;

// Bind a value (in val_reg) to a destructuring target. The target is
// either an IdentExpr (resolve as a function-local or module global)
// or a nested pattern (recurse). Mirrors the assign-to-ident path in
// compile_assignment, minus support for outer-scope captures (let/
// const declarators are always introduced in our own scope).
fn bind_destructure_target(c: Compiler*, target: AstNode*, val_reg: u8) -> void {
    if target == NULL { return; }
    let k = target.kind;
    if k == NodeKind::ObjectPattern || k == NodeKind::ArrayPattern {
        destructure_pattern(c, target, val_reg);
        return;
    }
    // Assignment mode: target can be any LHSExpression (Member /
    // Computed / Ident). Binding mode requires Ident — patterns are
    // recursive, but the leaf targets land in fresh locals/globals.
    if c.in_dstr_assign {
        if k == NodeKind::Member {
            let obj_r = compile_expr(c, target.left);
            let name = c.source + target.name_start;
            let name_atom = ctx_intern_atom(c.ctx, name, target.name_length);
            emit_store_prop_atom(c, obj_r, name_atom, val_reg);
            if obj_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            return;
        }
        if k == NodeKind::Computed {
            let obj_r = compile_expr(c, target.left);
            let key_r = compile_expr(c, target.right);
            emit(c, make_inst_abc(Op::StoreElem, obj_r, key_r, val_reg));
            if key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            if obj_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            return;
        }
        // Plain ident in assign-mode: existing binding lookup chain
        // mirrors compile_assignment's Eq path.
        if k != NodeKind::IdentExpr {
            c.had_error = true;
            return;
        }
        let nm = c.source + target.name_start;
        let nl = target.name_length;
        let lidx = find_local_index(c, nm, nl);
        if lidx >= 0 {
            if c.locals[(u32)lidx].captured {
                let name_atom = ctx_intern_atom(c.ctx, nm, nl);
                emit_store_prop_atom(c, c.env_reg, name_atom, val_reg);
            } else {
                emit(c, make_inst_ab(Op::Mov, c.locals[(u32)lidx].reg, val_reg));
            }
            return;
        }
        let outer_depth = outer_capture_depth(c, nm, nl);
        if outer_depth > 0 {
            c.has_outer_refs = true;
            let env_r = emit_env_chain_walk(c, outer_depth);
            let name_atom = ctx_intern_atom(c.ctx, nm, nl);
            emit_store_prop_atom(c, env_r, name_atom, val_reg);
            release_reg(c, env_r);
            return;
        }
        let slot = ctx_intern_global(c.ctx, nm, nl);
        emit(c, make_inst_a_u16(Op::StoreGlobal, val_reg, (u16)slot));
        return;
    }
    if k != NodeKind::IdentExpr {
        c.had_error = true;
        return;
    }
    let name = c.source + target.name_start;
    let name_len = target.name_length;
    if c.is_function {
        let lidx = find_local_index(c, name, name_len);
        if lidx < 0 {
            // Script-scope `var [x] of ...` (and similar): collect_locals
            // skips top-level var, so x has no pre-registered local. The
            // spec puts the binding on globalThis — emit DefineGlobal,
            // matching what NodeKind::VarDecl does at the same scope.
            if c.is_script {
                let slot = ctx_intern_global(c.ctx, name, name_len);
                emit(c, make_inst_a_u16(Op::DefineGlobal, val_reg, (u16)slot));
                return;
            }
            c.had_error = true; return;
        }
        if c.locals[(u32)lidx].captured {
            let name_atom = ctx_intern_atom(c.ctx, name, name_len);
            emit_store_prop_atom(c, c.env_reg, name_atom, val_reg);
        } else {
            emit(c, make_inst_ab(Op::Mov, c.locals[(u32)lidx].reg, val_reg));
        }
        // #330 TDZ: this pattern binding is now initialized, so later
        // targets' defaults referencing it (`let [a, b = a]`) read its
        // value, while earlier ones (`let [a = b, b]`) already threw via
        // ThrowIfHole because b was still the hole when a's default ran.
        if c.locals[(u32)lidx].is_tdz { c.locals[(u32)lidx].initialized = true; }
    } else {
        let slot = ctx_intern_global(c.ctx, name, name_len);
        emit(c, make_inst_a_u16(Op::DefineGlobal, val_reg, (u16)slot));
    }
}

// If the initializer expression is an anonymous function / arrow /
// class, set the result's `name` property to `target_name`. Implements
// the parts of NamedEvaluation that apply when binding an anonymous
// callable to a single-name target (declarators, destructuring
// entries, default params, ObjectProp values). Skips when the target
// is itself a pattern or has no source name.
fn maybe_infer_anon_name(c: Compiler*, init_expr: AstNode*, val_reg: u8,
                         target_name: char*, target_name_len: u32) -> void {
    if init_expr == NULL { return; }
    if target_name_len == 0 { return; }
    // Spec NamedEvaluation peels through ParenthesizedExpression but
    // not through Sequence / Assignment / anything that yields a
    // *value* rather than the function/class itself. `(function(){})`
    // names; `(0, function(){})` doesn't.
    let expr = init_expr;
    while expr != NULL && expr.kind == NodeKind::Paren {
        expr = expr.left;
    }
    if expr == NULL { return; }
    let k = expr.kind;
    let is_anon: bool = false;
    if k == NodeKind::FunctionExpr && expr.name_length == 0 { is_anon = true; }
    else if k == NodeKind::ArrowFunc { is_anon = true; }
    else if k == NodeKind::ClassExpr && expr.name_length == 0 { is_anon = true; }
    if !is_anon { return; }
    // ClassExpr with an explicit static "name" member already has the
    // own .name property; spec says NamedEvaluation must NOT override it.
    if k == NodeKind::ClassExpr {
        let ci: u32 = 0;
        while ci < expr.children_count {
            let m = expr.children[ci];
            if m != NULL && m.bool_value && m.name_length == 4 {
                let mn = c.source + m.name_start;
                let is_name: int = 0;
                raw { is_name = (memcmp(mn, "name", 4) == 0) ? 1 : 0; }
                if is_name != 0 { return; }
            }
            ci = ci + 1;
        }
    }
    let name_str_reg = emit_load_name_string(c, target_name, target_name_len);
    emit(c, make_inst_ab(Op::SetFunctionName, val_reg, name_str_reg));
    release_reg(c, name_str_reg);
}

// If the entry carries `= default`, emit:
//   if (v_r === undefined) v_r = default;
// in place. v_r is already a temp owned by the caller. When target
// is a simple ident, NamedEvaluation infers a `name` for anonymous
// function-ish defaults.
fn apply_destructure_default(c: Compiler*, v_r: u8, default_expr: AstNode*,
                              target: AstNode*) -> void {
    if default_expr == NULL { return; }
    let tmp = alloc_reg(c);
    let undef_r = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadUndefined, undef_r));
    emit(c, make_inst_abc(Op::CmpStrictEq, tmp, v_r, undef_r));
    release_reg(c, undef_r);
    let skip = emit(c, make_inst_a_i16(Op::JmpIfFalse, tmp, 0));
    release_reg(c, tmp);
    let init = compile_expr(c, default_expr);
    if init != v_r { emit(c, make_inst_ab(Op::Mov, v_r, init)); }
    if target != NULL && target.kind == NodeKind::IdentExpr && target.name_length > 0 {
        maybe_infer_anon_name(c, default_expr, v_r,
                              c.source + target.name_start, target.name_length);
    }
    patch_jump(c, skip);
}

fn destructure_pattern(c: Compiler*, pat: AstNode*, src_reg: u8) -> void {
    if pat == NULL { return; }
    // Spec: at the head of every destructuring step the value must be
    // RequireObjectCoercible — null/undefined throw TypeError before
    // any property extraction.
    emit(c, make_inst_a(Op::AssertCoercible, src_reg));
    if pat.kind == NodeKind::ObjectPattern {
        destructure_object(c, pat, src_reg);
        return;
    }
    if pat.kind == NodeKind::ArrayPattern {
        destructure_array(c, pat, src_reg);
        return;
    }
    c.had_error = true;
}

fn destructure_object(c: Compiler*, pat: AstNode*, src_reg: u8) -> void {
    let i: u32 = 0;
    while i < pat.children_count {
        let entry = pat.children[i];
        if entry.bool_value {
            // Object-rest `...name`: copy own enumerable props of src,
            // then delete each statically-named key declared before
            // this rest binding. Computed-key omissions aren't tracked.
            let saved = c.next_reg;
            let dst_r = alloc_reg(c);
            emit(c, make_inst_a(Op::NewObject, dst_r));
            emit(c, make_inst_ab(Op::ObjectSpread, dst_r, src_reg));
            let j: u32 = 0;
            while j < i {
                let prev = pat.children[j];
                if prev.bool_value == false && prev.name_length > 0 {
                    let key_r = emit_load_name_string(c,
                                                     c.source + prev.name_start,
                                                     prev.name_length);
                    let trash = alloc_reg(c);
                    emit(c, make_inst_abc(Op::DeleteElem, trash, dst_r, key_r));
                    release_reg(c, trash);
                    release_reg(c, key_r);
                }
                j = j + 1;
            }
            bind_destructure_target(c, entry.left, dst_r);
            c.next_reg = saved;
            i = i + 1;
            continue;
        }

        let v_r = alloc_reg(c);
        if entry.name_length > 0 {
            let name_atom = ctx_intern_atom(c.ctx,
                                            c.source + entry.name_start,
                                            entry.name_length);
            emit_load_prop_atom(c, v_r, src_reg, name_atom);
        } else if entry.third != NULL {
            let key_r = compile_expr(c, entry.third);
            emit(c, make_inst_abc(Op::LoadElem, v_r, src_reg, key_r));
            release_reg(c, key_r);
        } else {
            c.had_error = true;
            release_reg(c, v_r);
            i = i + 1;
            continue;
        }
        apply_destructure_default(c, v_r, entry.right, entry.left);
        bind_destructure_target(c, entry.left, v_r);
        release_reg(c, v_r);
        i = i + 1;
    }
}

fn destructure_array(c: Compiler*, pat: AstNode*, src_reg: u8) -> void {
    // Spec: ArrayBindingPattern runs GetIterator(src) and then
    // IteratorStep / IteratorClose per element. Live iteration matters
    // for spec correctness (iter.next call counts, iter.return on
    // early exit) and for infinite-generator support.
    let iter_r = alloc_reg(c);
    emit(c, make_inst_ab(Op::IterGet, iter_r, src_reg));
    let done_r = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadFalse, done_r));

    let i: u32 = 0;
    let saw_rest: bool = false;
    while i < pat.children_count {
        let entry = pat.children[i];
        if entry.bool_value {
            // ...rest: drain remaining elements into a fresh array.
            let saved_next = c.next_reg;
            let dst_r = alloc_reg(c);
            emit(c, make_inst_abc(Op::IterRestCollect, dst_r, iter_r, done_r));
            bind_destructure_target(c, entry.left, dst_r);
            c.next_reg = saved_next;
            saw_rest = true;
            i = i + 1;
            continue;
        }
        // Pull the next value from the iterator. IterStep sets v_r to
        // the value (or undefined when done) and done_r accordingly.
        let v_r = alloc_reg(c);
        emit(c, make_inst_abc(Op::IterStep, v_r, iter_r, done_r));
        if entry.left == NULL {
            // Elision — drop the value, still consumed the slot.
            release_reg(c, v_r);
            i = i + 1;
            continue;
        }
        apply_destructure_default(c, v_r, entry.right, entry.left);
        bind_destructure_target(c, entry.left, v_r);
        release_reg(c, v_r);
        i = i + 1;
    }

    // Spec IteratorClose with NormalCompletion: when destructuring
    // finishes without consuming the whole iterator, call iter.return().
    // A rest binding always drains, so IterClose is a no-op there;
    // skipping it also keeps the bytecode tighter.
    if !saw_rest {
        emit(c, make_inst_ab(Op::IterClose, iter_r, done_r));
    }
    release_reg(c, done_r);
    release_reg(c, iter_r);
}

fn collect_locals(c: Compiler*, node: AstNode*) -> void {
    if node == NULL { return; }
    let k = node.kind;

    if k == NodeKind::FunctionDecl {
        // Script-mode top-level FunctionDecl creates a property on
        // globalThis per spec, NOT a script-scope lexical binding.
        // Module/function bodies register the function-name local.
        if c.is_function && !c.is_script {
            alloc_and_add_local(c, node.name_start, node.name_length);
        }
        return;
    }
    if k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc {
        return;
    }
    if k == NodeKind::ClassDecl {
        // ClassDecl is always lexical, even at script-top.
        if c.is_function {
            alloc_and_add_local(c, node.name_start, node.name_length);
        }
        return;
    }
    if k == NodeKind::ClassExpr {
        return;
    }

    if k == NodeKind::VarDecl {
        // Script-top `var x` stays on globalThis; let/const become
        // script-scope locals. Inside a function, the declaration's
        // kind doesn't matter — all three are function-scope locals,
        // but `var` hoists to the function-top scope while let/const
        // stay block-scoped (see add_local vs add_local_scoped).
        let is_var_kind = node.op == TokenKind::KwVar;
        if c.is_script && is_var_kind { return; }
        let scope_id = if is_var_kind { 0u32 } else { c.cur_scope_id };
        let i: u32 = 0;
        while i < node.children_count {
            let decl = node.children[i];
            if decl.name_length > 0 {
                alloc_and_add_local_scoped(c, decl.name_start, decl.name_length, scope_id);
                // #330 — let/const are TDZ bindings; var is not.
                if !is_var_kind { c.locals[c.local_count - 1].is_tdz = true; }
            } else if decl.third != NULL {
                // #330 — mark every binding the pattern introduces as TDZ
                // for let/const (a destructuring `let [a=b, b]` must throw
                // when a's default reads the not-yet-bound b). Snapshot the
                // locals range collect_pattern_locals adds.
                let before = c.local_count;
                collect_pattern_locals(c, decl.third);
                if !is_var_kind {
                    let pli = before;
                    while pli < c.local_count {
                        c.locals[pli].is_tdz = true;
                        pli = pli + 1;
                    }
                }
            }
            i = i + 1;
        }
        return;
    }

    // ES module top-level. Import bindings and export-decl-wrapped
    // var/let/const/function/class all introduce module-scoped locals
    // that nested closures may capture; pre-register them here so
    // analyze_captures (which runs immediately after collect_locals)
    // sees them.
    if k == NodeKind::ImportDecl {
        let i: u32 = 0;
        while i < node.children_count {
            let cl = node.children[i];
            if cl.name_length > 0 {
                alloc_and_add_local(c, cl.name_start, cl.name_length);
            }
            i = i + 1;
        }
        return;
    }
    if k == NodeKind::ExportDecl {
        if node.left != NULL { collect_locals(c, node.left); }
        return;
    }

    if k == NodeKind::BlockStmt {
        // Block introduces a fresh lexical scope; let/const inside this
        // body bind to the block, var still hoists. The id is recorded
        // on the node — analyze_captures and compile_stmt re-enter it
        // by id (enter_scope_reuse).
        enter_scope_assign(c, node);
        let i: u32 = 0;
        while i < node.children_count {
            collect_locals(c, node.children[i]);
            i = i + 1;
        }
        exit_scope(c);
        return;
    }

    if k == NodeKind::TryStmt {
        // Try/catch: the catch parameter binds as a local. We still
        // descend into both blocks to pick up nested var/let declarations.
        if c.is_function && node.name_length > 0 {
            // Only allocate if not already present (loops can re-enter
            // try blocks but the name is fixed).
            let existing = lookup_local(c, c.source + node.name_start, node.name_length);
            if existing < 0 {
                alloc_and_add_local(c, node.name_start, node.name_length);
            }
        }
        // Destructuring catch param (children[0]): each contained name
        // is a local in the function's scope. Allocate them now so
        // analyze_captures can see them.
        if c.is_function && node.children_count == 1 && node.children[0] != NULL {
            collect_pattern_locals(c, node.children[0]);
        }
        if node.left  != NULL { collect_locals(c, node.left); }
        if node.right != NULL { collect_locals(c, node.right); }
        // The finally block (#380): compile_stmt compiles it (once
        // straight-line + once per break/continue/return inline site),
        // so its locals must be registered and its block must carry a
        // collect-assigned scope id like any other.
        if node.third != NULL { collect_locals(c, node.third); }
        return;
    }

    if k == NodeKind::ForStmt {
        // ECMA-262 §13.7.4: a for-statement with a LexicalDeclaration
        // init runs in a fresh declarative environment. We don't
        // distinguish let/const vs var here — var-decls hoist to
        // scope_id=0 explicitly inside the VarDecl branch, so wrapping
        // a fresh scope around the for-statement is a no-op for var
        // bindings while correctly isolating let/const inits and any
        // let/const declared in the body block.
        enter_scope_assign(c, node);
        if node.left  != NULL { collect_locals(c, node.left); }
        if node.right != NULL { collect_locals(c, node.right); }
        if node.third != NULL { collect_locals(c, node.third); }
        let i: u32 = 0;
        while i < node.children_count {
            collect_locals(c, node.children[i]);
            i = i + 1;
        }
        exit_scope(c);
        return;
    }

    if node.left  != NULL { collect_locals(c, node.left); }
    if node.right != NULL { collect_locals(c, node.right); }
    if node.third != NULL { collect_locals(c, node.third); }
    let i: u32 = 0;
    while i < node.children_count {
        collect_locals(c, node.children[i]);
        i = i + 1;
    }
}

// =====================================================================
// Statement compilation. Statements have no result register; they
// update `last_expr_reg` when they're expression-statements.
// =====================================================================

// Forward decl for the live-iter for-of emitter.
fn compile_for_of_live(c: Compiler*, node: AstNode*) -> void;

// --- Lexical-redeclaration early errors (ECMA-262 §14.2.1 / §14.12.1) --
// A block / switch CaseBlock StatementList must have no duplicate
// LexicallyDeclaredNames, and no LexicallyDeclaredName may also appear in
// VarDeclaredNames. We conservatively scan only the TOP-LEVEL statements
// of the StatementList: LEX = let/const/class names, VAR = var +
// function-declaration names. Flagging requires a LEX name to collide
// (with another LEX name or a VAR name), which is unconditionally illegal
// in every mode — so this never false-positives on valid code (var+var,
// function+function, and hoisted-from-nested var are intentionally not
// flagged; those are either legal or a safe miss).
fn redecl_name_eq(c: Compiler*, a_s: u32, a_l: u32, b_s: u32, b_l: u32) -> bool {
    if a_l != b_l { return false; }
    let eq: int = 0;
    raw { eq = (memcmp(c->source + a_s, c->source + b_s, a_l) == 0) ? 1 : 0; }
    return eq != 0;
}

fn redecl_add_lex(c: Compiler*, starts: u32*, lens: u32*, count: u32, cap: u32, s: u32, l: u32) -> u32 {
    let i: u32 = 0;
    while i < count {
        if redecl_name_eq(c, starts[i], lens[i], s, l) { c.had_error = true; return count; }
        i = i + 1;
    }
    if count < cap { starts[count] = s; lens[count] = l; return count + 1; }
    return count;
}

fn redecl_name_in_lex(c: Compiler*, starts: u32*, lens: u32*, count: u32, s: u32, l: u32) -> bool {
    let i: u32 = 0;
    while i < count {
        if redecl_name_eq(c, starts[i], lens[i], s, l) { return true; }
        i = i + 1;
    }
    return false;
}

// Pass 1: record a statement's top-level lexically-declared names.
fn redecl_scan_lex(c: Compiler*, stmt: AstNode*, starts: u32*, lens: u32*, count: u32, cap: u32) -> u32 {
    if stmt == NULL { return count; }
    let k = stmt.kind;
    if k == NodeKind::VarDecl && (stmt.op == TokenKind::KwLet || stmt.op == TokenKind::KwConst) {
        let i: u32 = 0;
        while i < stmt.children_count {
            let d = stmt.children[i];
            if d.name_length > 0 {
                count = redecl_add_lex(c, starts, lens, count, cap, d.name_start, d.name_length);
            }
            i = i + 1;
        }
    } else if k == NodeKind::ClassDecl && stmt.name_length > 0 {
        count = redecl_add_lex(c, starts, lens, count, cap, stmt.name_start, stmt.name_length);
    }
    return count;
}

// Pass 2: flag a top-level var / function-declaration name that collides
// with a lexically-declared name in the same StatementList.
fn redecl_check_var(c: Compiler*, stmt: AstNode*, starts: u32*, lens: u32*, count: u32) -> void {
    if stmt == NULL { return; }
    let k = stmt.kind;
    if k == NodeKind::VarDecl && stmt.op == TokenKind::KwVar {
        let i: u32 = 0;
        while i < stmt.children_count {
            let d = stmt.children[i];
            if d.name_length > 0 && redecl_name_in_lex(c, starts, lens, count, d.name_start, d.name_length) {
                c.had_error = true;
            }
            i = i + 1;
        }
    } else if k == NodeKind::FunctionDecl && stmt.name_length > 0 {
        if redecl_name_in_lex(c, starts, lens, count, stmt.name_start, stmt.name_length) {
            c.had_error = true;
        }
    }
}

// #387 — does any node in this subtree mention the identifier `name`?
// Conservative: ANY IdentExpr with matching source bytes counts (a
// shadowed inner binding of the same name is a false positive, which
// just keeps the entry hole — safe). Descends nested function bodies
// too: harmless over-approximation (a real closure read would have
// marked the local captured, excluding it from the caller's path
// anyway).
fn subtree_mentions_ident(c: Compiler*, n: AstNode*, name_start: u32, name_len: u32) -> bool {
    if n == NULL { return false; }
    if n.kind == NodeKind::IdentExpr {
        return redecl_name_eq(c, n.start, n.end - n.start, name_start, name_len);
    }
    // Named nodes (function/class decls, members) can also resolve the
    // name — method names `obj.x` are NOT ident reads, but property
    // shorthand `{ x }` parses as IdentExpr values and IS. Walking
    // children covers both without special-casing.
    if subtree_mentions_ident(c, n.left, name_start, name_len)  { return true; }
    if subtree_mentions_ident(c, n.right, name_start, name_len) { return true; }
    if subtree_mentions_ident(c, n.third, name_start, name_len) { return true; }
    let i: u32 = 0;
    while i < n.children_count {
        if subtree_mentions_ident(c, n.children[i], name_start, name_len) { return true; }
        i = i + 1;
    }
    return false;
}

// #387 — must this block's entry seed the TDZ hole for `name`?
// Source-order scan of the block's DIRECT children (a block's own
// let/const declarations are always direct children):
//   - hit the simple named declarator first → the decl always executes
//     before any read → hole is dead → false;
//   - hit any mention of the name first (in a statement, an earlier
//     declarator's initializer `let a = x, x = 1`, or a destructuring
//     pattern) → a pre-decl read may observe the slot → true;
//   - declarator not found as a simple name (destructuring binding,
//     or anything surprising) → true (conservative).
fn block_needs_entry_hole(c: Compiler*, block: AstNode*, name_start: u32, name_len: u32) -> bool {
    let i: u32 = 0;
    while i < block.children_count {
        let stmt = block.children[i];
        if stmt != NULL && stmt.kind == NodeKind::VarDecl
           && (stmt.op == TokenKind::KwLet || stmt.op == TokenKind::KwConst) {
            let di: u32 = 0;
            while di < stmt.children_count {
                let d = stmt.children[di];
                if d.name_length > 0
                   && redecl_name_eq(c, d.name_start, d.name_length, name_start, name_len) {
                    return false;   // declaration reached before any read
                }
                // Earlier declarator's initializer / pattern may read it.
                if subtree_mentions_ident(c, d, name_start, name_len) { return true; }
                di = di + 1;
            }
        } else if subtree_mentions_ident(c, stmt, name_start, name_len) {
            return true;
        }
        i = i + 1;
    }
    return true;   // decl not found as a simple declarator — keep the hole
}

fn check_scope_redeclaration(c: Compiler*, node: AstNode*) -> void {
    if c.had_error { return; }
    let cap: u32 = 128;
    let starts = alloc_n<u32>((usize)cap);
    let lens = alloc_n<u32>((usize)cap);
    let count: u32 = 0;
    if node.kind == NodeKind::SwitchStmt {
        // The whole CaseBlock (all clauses) is one lexical scope.
        let ci: u32 = 0;
        while ci < node.children_count {
            let cl = node.children[ci];
            let si: u32 = 0;
            while si < cl.children_count {
                count = redecl_scan_lex(c, cl.children[si], starts, lens, count, cap);
                si = si + 1;
            }
            ci = ci + 1;
        }
        let ci2: u32 = 0;
        while ci2 < node.children_count {
            let cl = node.children[ci2];
            let si: u32 = 0;
            while si < cl.children_count {
                redecl_check_var(c, cl.children[si], starts, lens, count);
                si = si + 1;
            }
            ci2 = ci2 + 1;
        }
    } else {
        let si: u32 = 0;
        while si < node.children_count {
            count = redecl_scan_lex(c, node.children[si], starts, lens, count, cap);
            si = si + 1;
        }
        let si2: u32 = 0;
        while si2 < node.children_count {
            redecl_check_var(c, node.children[si2], starts, lens, count);
            si2 = si2 + 1;
        }
    }
    dealloc(starts);
    dealloc(lens);
}

fn compile_stmt(c: Compiler*, node: AstNode*) -> void {
    if node == NULL { return; }
    let k = node.kind;

    if k == NodeKind::ImportDecl {
        compile_import_decl(c, node);
        return;
    }
    if k == NodeKind::ExportDecl {
        compile_export_decl(c, node);
        return;
    }

    if k == NodeKind::BlockStmt {
        // Early error: no duplicate lexically-declared names in this block.
        check_scope_redeclaration(c, node);
        // Re-enter the scope id collect_locals assigned to this block
        // (stable across re-compiles — inlined finally bodies).
        enter_scope_reuse(c, node);
        // #330 TDZ: seed this block's let/const regs with the hole so a
        // read BEFORE the declaration throws ReferenceError. Re-holed on
        // every block entry (correct per-iteration semantics for a block
        // that is a loop body). `initialized` is reset so reads compiled
        // before the decl get the check; the decl sets it true again.
        //
        // #387: the entry hole is DEAD for the common `let t = expr;`
        // shape — when the declaration is reached before any possible
        // read, nothing ever observes the hole, and for a loop-body
        // block the re-hole is a per-iteration dispatch (LoadHole was
        // 11% of mandelbrot's dispatches). block_needs_entry_hole does
        // a conservative source-order scan; closure reads don't need
        // it (a captured TDZ local is excluded from this path
        // entirely — stage-3 #333 owns env-slot TDZ).
        let hi: u32 = 0;
        while hi < c.local_count {
            if c.locals[hi].scope_id == c.cur_scope_id
               && c.locals[hi].is_tdz && !c.locals[hi].captured {
                if block_needs_entry_hole(c, node, c.locals[hi].name_start, c.locals[hi].name_length) {
                    emit(c, make_inst_a(Op::LoadHole, c.locals[hi].reg));
                }
                c.locals[hi].initialized = false;
            }
            hi = hi + 1;
        }
        let i: u32 = 0;
        while i < node.children_count {
            compile_stmt(c, node.children[i]);
            i = i + 1;
        }
        exit_scope(c);
        return;
    }
    if k == NodeKind::VarDecl {
        let i: u32 = 0;
        while i < node.children_count {
            let decl = node.children[i];
            // Destructuring declarator: name_length==0 + decl.third is
            // the pattern, decl.left is the initializer.
            if decl.name_length == 0 && decl.third != NULL {
                if decl.left != NULL {
                    let r = compile_expr(c, decl.left);
                    destructure_pattern(c, decl.third, r);
                    release_reg(c, r);
                }
                // `let { a } = undefined` would throw at runtime; for
                // initializer-less pattern declarators (`let { a };`
                // — invalid in spec) we silently no-op.
                i = i + 1;
                continue;
            }
            let name = c.source + decl.name_start;
            let name_len = decl.name_length;
            // Script-top `var x` keeps global semantics; collect_locals
            // skipped it, so falling into the local path would crash
            // with "local not found". Treat it like the bare-program
            // path used to.
            let is_script_var = c.is_script && node.op == TokenKind::KwVar;
            if c.is_function && !is_script_var {
                // Local — register was pre-allocated by collect_locals.
                let lidx = find_local_index(c, name, name_len);
                if lidx < 0 { c.had_error = true; return; }
                let cap = c.locals[(u32)lidx].captured;
                let lreg = c.locals[(u32)lidx].reg;
                let is_tdz = c.locals[(u32)lidx].is_tdz;
                if decl.left != NULL {
                    // #330 TDZ: seed the reg with the hole BEFORE the
                    // initializer so a self-reference (`let x = x`,
                    // `const c = c`) reads the hole and throws. Only for
                    // non-captured register locals (captured = stage 3).
                    // #387: dead unless the initializer can actually
                    // mention the name (closure reads ⇒ captured ⇒
                    // excluded path) — `let t = a*b` was paying a
                    // LoadHole dispatch per loop iteration for nothing.
                    if is_tdz && !cap
                       && subtree_mentions_ident(c, decl.left, decl.name_start, decl.name_length) {
                        emit(c, make_inst_a(Op::LoadHole, lreg));
                    }
                    let r = compile_expr(c, decl.left);
                    maybe_infer_anon_name(c, decl.left, r, name, name_len);
                    if cap {
                        // Captured locals live as properties on the env
                        // object — outer's reg slot is unused.
                        let name_atom = ctx_intern_atom(c.ctx, name, name_len);
                        emit_store_prop_atom(c, c.env_reg, name_atom, r);
                    } else {
                        emit(c, make_inst_ab(Op::Mov, lreg, r));
                    }
                    release_reg(c, r);
                } else if is_tdz && !cap {
                    // `let x;` — initialized to undefined at the decl, and
                    // the TDZ ends here. If the reg was holed at scope
                    // entry, replace the hole with undefined now.
                    emit(c, make_inst_a(Op::LoadUndefined, lreg));
                }
                // After the declarator, the binding is initialized — later
                // straight-line reads skip the TDZ check.
                if is_tdz && !cap { c.locals[(u32)lidx].initialized = true; }
                // No initializer (var): env stays without the prop / reg
                // stays undefined. Captured-local first reads before any
                // init are observably undefined either way.
            } else {
                let slot = ctx_intern_global(c.ctx, name, name_len);
                if decl.left != NULL {
                    let r = compile_expr(c, decl.left);
                    maybe_infer_anon_name(c, decl.left, r, name, name_len);
                    emit(c, make_inst_a_u16(Op::DefineGlobal, r, (u16)slot));
                    release_reg(c, r);
                }
            }
            i = i + 1;
        }
        reset_temps(c);
        return;
    }
    if k == NodeKind::ClassDecl {
        let r = compile_class_value(c, node);
        if c.is_function {
            let lidx = find_local_index(c, c.source + node.name_start, node.name_length);
            if lidx >= 0 {
                if c.locals[(u32)lidx].captured {
                    let n_atom = ctx_intern_atom(c.ctx, c.source + node.name_start, node.name_length);
                    emit_store_prop_atom(c, c.env_reg, n_atom, r);
                } else {
                    emit(c, make_inst_ab(Op::Mov, c.locals[(u32)lidx].reg, r));
                }
            }
        } else {
            let slot = ctx_intern_global(c.ctx, c.source + node.name_start, node.name_length);
            emit(c, make_inst_a_u16(Op::DefineGlobal, r, (u16)slot));
        }
        release_reg(c, r);
        reset_temps(c);
        return;
    }
    if k == NodeKind::FunctionDecl {
        let f = compile_function(c.ctx, c.source, node, c);
        if f == NULL { c.had_error = true; return; }
        let fp: void* = NULL;
        raw { fp = (void*)f; }
        ctx_register_cell(c.ctx, fp);
        let val = zjs_cell_from_ptr(fp);
        let idx = add_const(c, val);
        let r = alloc_reg(c);
        emit(c, make_inst_a_u16(Op::LoadConst, r, idx));

        // Always wrap nested function-decls in MakeClosure so each
        // outer-function invocation yields a distinct function value
        // (spec). zod's $constructor relies on per-call identity to
        // attach .init / .name uniquely; without the wrap two calls
        // would share TAG_FUNCTION expando state. For the no-captures
        // case we emit MakeClosure in-place — dst doubles as fn-src
        // AND env-src (non-object env → NULL), so zero extra
        // register pressure vs. the old LoadConst-only path.
        if !f.needs_env {
            emit(c, make_inst_abc(Op::MakeClosure, r, r, r));
        } else {
            let cls_reg = alloc_reg(c);
            let env = closure_env_reg(c);
            emit(c, make_inst_abc(Op::MakeClosure, cls_reg, r, env.reg));
            if env.is_temp { release_reg(c, env.reg); }
            release_reg(c, r);
            r = cls_reg;
        }

        // Script-top FunctionDecl creates a property on globalThis,
        // not a script-scope lexical binding. collect_locals skipped
        // it for c.is_script, so there's no local to find — fall
        // through to the global-emit path.
        if c.is_function && !c.is_script {
            // Bind to the pre-allocated local register (or its env entry).
            let lidx = find_local_index(c, c.source + node.name_start, node.name_length);
            if lidx >= 0 {
                if c.locals[(u32)lidx].captured {
                    let n_atom = ctx_intern_atom(c.ctx,
                                                 c.source + node.name_start,
                                                 node.name_length);
                    emit_store_prop_atom(c, c.env_reg, n_atom, r);
                } else {
                    emit(c, make_inst_ab(Op::Mov, c.locals[(u32)lidx].reg, r));
                }
            }
        } else {
            let slot = ctx_intern_global(c.ctx,
                                          c.source + node.name_start,
                                          node.name_length);
            emit(c, make_inst_a_u16(Op::DefineGlobal, r, (u16)slot));
        }
        release_reg(c, r);
        reset_temps(c);
        return;
    }
    if k == NodeKind::IfStmt {
        // ECMA-262 14.6.7 step 7: Return UpdateEmpty(stmtCompletion, undefined).
        // At top level we reset the result register before the branch
        // so an empty-body if produces undefined (not the prior value).
        // Expression statements inside the branch will overwrite.
        if c.parent == NULL && c.last_expr_reg >= 0 {
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
        }
        let fused = try_emit_cmp_branch_if_false(c, node.left);
        let jmp_else: u32 = 0;
        if fused >= 0 {
            jmp_else = (u32)fused;
        } else {
            let cond_reg = compile_expr(c, node.left);
            jmp_else = emit(c, make_inst_a_i16(Op::JmpIfFalse, cond_reg, 0));
            release_reg(c, cond_reg);
        }
        reset_temps(c);

        compile_stmt(c, node.right);   // then branch

        if node.third != NULL {
            let jmp_end = emit(c, make_inst_i16(Op::Jmp, 0));
            patch_jump(c, jmp_else);
            compile_stmt(c, node.third);
            patch_jump(c, jmp_end);
        } else {
            patch_jump(c, jmp_else);
        }
        return;
    }
    if k == NodeKind::SwitchStmt {
        // Early error: the CaseBlock is one lexical scope — no duplicate
        // lexically-declared names across all its clauses.
        check_scope_redeclaration(c, node);
        // switch (disc) { ... }
        //   tmp = disc
        //   for each non-default case i: if (tmp === case_i_test) goto Li
        //   if default exists:       goto Ldefault
        //   else:                    goto Lend
        //   L0: <body0> (falls through to L1 unless `break` jumps to Lend)
        //   L1: <body1>
        //   ...
        //   Ldefault: <default body>
        //   Lend:
        //
        // `break` inside the body jumps to Lend; we reuse the loop_stack
        // mechanism. `continue` inside switch isn't legal targeting the
        // switch itself, but labeled continues to an outer loop still
        // work via the loop_stack walk — switch doesn't claim a
        // continue target.
        if c.parent == NULL && c.last_expr_reg >= 0 {
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
        }
        let disc_r = compile_expr(c, node.left);
        // Eval all case tests up front and emit jumps. We record the
        // patch index for each case-body label plus the default's.
        let n = node.children_count;
        let case_label_patches = alloc_n<u32>((usize)(n + 1));
        let cj: u32 = 0;
        let default_idx: i32 = -1;
        while cj < n {
            let cnode = node.children[cj];
            if cnode.bool_value {
                if default_idx < 0 { default_idx = (i32)cj; }
                case_label_patches[cj] = 0xffffffff;     // placeholder; default jump emitted last
            } else {
                let test_r = compile_expr(c, cnode.left);
                let cmp_r  = alloc_reg(c);
                emit(c, make_inst_abc(Op::CmpStrictEq, cmp_r, disc_r, test_r));
                release_reg(c, test_r);
                let idx = emit(c, make_inst_a_i16(Op::JmpIfTrue, cmp_r, 0));
                release_reg(c, cmp_r);
                case_label_patches[cj] = idx;
            }
            cj = cj + 1;
        }
        release_reg(c, disc_r);
        reset_temps(c);
        // After all case tests, jump to default (or end if no default).
        let to_default_or_end = emit(c, make_inst_i16(Op::Jmp, 0));

        // Push a loop frame so `break` patches end up here. Mark it
        // non-iter so `continue` walks past this frame to the enclosing
        // for/while update (closes #261).
        loop_push(c);
        c.loop_stack[c.loop_depth - 1].is_iter = false;

        // Emit each case body, capturing the label position so we can
        // patch the test-jumps to it.
        let body_starts = alloc_n<u32>((usize)n);
        let bi: u32 = 0;
        while bi < n {
            body_starts[bi] = (u32)c.code_count;
            let cnode = node.children[bi];
            let si: u32 = 0;
            while si < cnode.children_count {
                compile_stmt(c, cnode.children[si]);
                si = si + 1;
            }
            bi = bi + 1;
        }
        let end_label = (u32)c.code_count;

        // Patch jumps:
        //   - each non-default case's JmpIfTrue → body_starts[that case]
        //   - the to_default_or_end Jmp → default body or end_label
        let pi: u32 = 0;
        while pi < n {
            let cnode2 = node.children[pi];
            if !cnode2.bool_value {
                let here_save = c.code_count;
                c.code_count = body_starts[pi];
                // patch_jump computes offset using c.code_count as
                // the "here". Reset it temporarily so the math is
                // correct.
                c.code_count = here_save;
                // Manually compute + write the offset.
                let inst = c.code[case_label_patches[pi]];
                let off: i32 = (i32)body_starts[pi] - ((i32)case_label_patches[pi] + 1);
                c.code[case_label_patches[pi]] = make_inst_a_i16(inst.op, inst.a, off);
            }
            pi = pi + 1;
        }
        let inst2 = c.code[to_default_or_end];
        let dest = if default_idx >= 0 { body_starts[(u32)default_idx] } else { end_label };
        let off2: i32 = (i32)dest - ((i32)to_default_or_end + 1);
        c.code[to_default_or_end] = make_inst_i16(inst2.op, off2);

        // Patch break jumps to end_label.
        let frame = c.loop_stack[c.loop_depth - 1];
        let bp: u32 = 0;
        while bp < frame.break_count {
            patch_jump(c, frame.break_patches[bp]);
            bp = bp + 1;
        }
        loop_pop(c);
        dealloc(case_label_patches);
        dealloc(body_starts);
        return;
    }
    if k == NodeKind::WithStmt {
        // Evaluate the object expression, ToObject + push it onto the
        // runtime with-stack, compile the body with with_depth raised
        // (so IdentExpr reads / assignment targets route through
        // WithLookup), then pop. WithEnter copies the object onto the
        // ctx.with_objs stack (GC-rooted there), so the source register
        // can be released immediately.
        let obj_r = compile_expr(c, node.left);
        emit(c, make_inst_a(Op::WithEnter, obj_r));
        release_reg(c, obj_r);
        c.with_depth = c.with_depth + 1;
        compile_stmt(c, node.right);
        c.with_depth = c.with_depth - 1;
        emit(c, make_inst_a(Op::WithLeave, 0));
        return;
    }
    if k == NodeKind::WhileStmt {
        if c.parent == NULL && c.last_expr_reg >= 0 {
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
        }
        if loop_rotation_enabled() && cond_is_rotatable(node.left) {
            // Rotated (test-at-bottom) shape — kills the unconditional
            // back-edge Jmp:
            //     Jmp →test
            //   body_head:
            //     <body>
            //   test:                 ; entry + continue target
            //     <leading && conjuncts: branch-if-false →exit>
            //     <tail cond operand evaluation>
            //     JmpIf* →body_head   ; fused; fall-through = exit
            let entry_jmp = emit(c, make_inst_i16(Op::Jmp, 0));
            let body_head = (u32)c.code_count;
            loop_push(c);
            // No loop_set_continue yet: `continue` must run the bottom
            // test, whose position isn't known until after the body.
            // Continues queue placeholders (the ForStmt deferred
            // pattern); publishing body_head here would skip the test
            // → infinite loop.
            compile_stmt(c, node.right);    // body
            // test: = start of cond OPERAND EVALUATION (per-iteration
            // property loads / calls in the condition re-run here).
            patch_jump(c, entry_jmp);
            loop_set_continue(c, (u32)c.code_count);
            let exit_patches_w: u32[8];
            let exit_count_w = emit_rotated_bottom_test(c, node.left, body_head, &exit_patches_w[0]);
            reset_temps(c);
            // Leading-conjunct exits + breaks patched after the fused
            // pair → true exit.
            let pi_w: u32 = 0;
            while pi_w < exit_count_w {
                patch_jump(c, exit_patches_w[pi_w]);
                pi_w = pi_w + 1;
            }
            let frame_r = c.loop_stack[c.loop_depth - 1];
            let bi_r: u32 = 0;
            while bi_r < frame_r.break_count {
                patch_jump(c, frame_r.break_patches[bi_r]);
                bi_r = bi_r + 1;
            }
            loop_pop(c);
            return;
        }
        let loop_top = (u32)c.code_count;
        loop_push(c);
        loop_set_continue(c, loop_top);
        let fused_w = try_emit_cmp_branch_if_false(c, node.left);
        let jmp_exit: u32 = 0;
        if fused_w >= 0 {
            jmp_exit = (u32)fused_w;
        } else {
            let cond_reg = compile_expr(c, node.left);
            jmp_exit = emit(c, make_inst_a_i16(Op::JmpIfFalse, cond_reg, 0));
            release_reg(c, cond_reg);
        }
        reset_temps(c);

        compile_stmt(c, node.right);    // body
        emit_jump_back(c, Op::Jmp, loop_top);
        patch_jump(c, jmp_exit);
        let frame_w = c.loop_stack[c.loop_depth - 1];
        let bi: u32 = 0;
        while bi < frame_w.break_count {
            patch_jump(c, frame_w.break_patches[bi]);
            bi = bi + 1;
        }
        loop_pop(c);
        return;
    }
    if k == NodeKind::DoWhileStmt {
        if c.parent == NULL && c.last_expr_reg >= 0 {
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
        }
        let loop_top = (u32)c.code_count;
        // continue jumps target the test, only known after body.
        loop_push(c);
        compile_stmt(c, node.left);     // body
        let test_at = (u32)c.code_count;
        loop_set_continue(c, test_at);
        let cond_reg = compile_expr(c, node.right);
        emit_jump_back_if(c, Op::JmpIfTrue, cond_reg, loop_top);
        release_reg(c, cond_reg);
        reset_temps(c);
        let frame_d = c.loop_stack[c.loop_depth - 1];
        let bi: u32 = 0;
        while bi < frame_d.break_count {
            patch_jump(c, frame_d.break_patches[bi]);
            bi = bi + 1;
        }
        loop_pop(c);
        return;
    }
    if k == NodeKind::ForOfStmt {
        compile_for_of_live(c, node);
        return;
    }
    if k == NodeKind::ForInStmt {
        if c.parent == NULL && c.last_expr_reg >= 0 {
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
        }
        // for-in: collect keys snapshot via iter_prepare(kind=0), walk
        // by index. (Spec semantics preserve key-list-snapshot anyway,
        // so the eager collection is fine for for-in.)
        let kind: u8 = 0;

        // src
        let src_r = compile_expr(c, node.right);
        let iter_r = alloc_reg(c);
        emit(c, make_inst_abc(Op::IterPrepare, iter_r, src_r, kind));
        if src_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        let len_r = alloc_reg(c);
        let one_r = alloc_reg(c);
        emit(c, make_inst_a_i16(Op::LoadInt, one_r, 1));
        let i_r = alloc_reg(c);
        emit(c, make_inst_a_i16(Op::LoadInt, i_r, 0));

        // Bump fixed_regs so reset_temps between body statements doesn't
        // re-allocate over the loop-state slots.
        let saved_fixed = c.fixed_regs;
        if i_r + 1 > c.fixed_regs { c.fixed_regs = i_r + 1; }

        // Per-iter env (mirror of compile_for_of_live; closes #250 for
        // for-in too). Same trigger: `let`/`const` binding + an env is
        // already in use by this function.
        let need_per_iter_env_i: bool = false;
        if c.needs_env {
            let bi_look = node.left;
            while bi_look != NULL && bi_look.kind == NodeKind::Paren {
                bi_look = bi_look.left;
            }
            if bi_look != NULL
               && bi_look.kind == NodeKind::VarDecl
               && bi_look.op != TokenKind::KwVar {
                need_per_iter_env_i = true;
            }
        }
        let saved_env_ri: u8 = 0;
        if need_per_iter_env_i {
            saved_env_ri = alloc_reg(c);
            emit(c, make_inst_ab(Op::Mov, saved_env_ri, c.env_reg));
            if saved_env_ri + 1 > c.fixed_regs { c.fixed_regs = saved_env_ri + 1; }
        }

        let loop_top = (u32)c.code_count;
        // `continue` goes to the increment step; set after body.
        loop_push(c);

        if need_per_iter_env_i {
            emit(c, make_inst_a(Op::NewObject, c.env_reg));
            let outer_atom = ctx_intern_atom(c.ctx, OUTER_ENV_KEY, OUTER_ENV_KEY_LEN);
            emit_store_prop_atom(c, c.env_reg, outer_atom, saved_env_ri);
        }
        emit(c, make_inst_ab(Op::ArrayLength, len_r, iter_r));
        let cond_r = alloc_reg(c);
        emit(c, make_inst_abc(Op::CmpLt, cond_r, i_r, len_r));
        let jmp_exit_idx = emit(c, make_inst_a_i16(Op::JmpIfFalse, cond_r, 0));
        release_reg(c, cond_r);

        let elem_r = alloc_reg(c);
        emit(c, make_inst_abc(Op::LoadElem, elem_r, iter_r, i_r));

        // Write `elem_r` into the binding. Supported binding shapes:
        //   VarDecl with one declarator (`let k`)
        //   IdentExpr (bare `k`, possibly inside Paren — `for ((x) of [...])`)
        //   Member / Computed (e.g. `x.y` or `x[y]`) — re-evaluated
        //     each iteration per the for-in/of LHS spec.
        let binding = node.left;
        while binding != NULL && binding.kind == NodeKind::Paren {
            binding = binding.left;
        }
        if binding == NULL {
            c.had_error = true; return;
        }
        if binding.kind == NodeKind::Member || binding.kind == NodeKind::Computed {
            let m_obj_r = compile_expr(c, binding.left);
            let m_key_r: u8 = 0;
            if binding.kind == NodeKind::Member {
                m_key_r = emit_load_name_string(c, c.source + binding.name_start, binding.name_length);
            } else {
                m_key_r = compile_expr(c, binding.right);
            }
            emit(c, make_inst_abc(Op::StoreElem, m_obj_r, m_key_r, elem_r));
            if m_key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            if m_obj_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
            release_reg(c, elem_r);
            // body
            if node.children_count > 0 {
                compile_stmt(c, node.children[0]);
            }
            let inc_at_m = (u32)c.code_count;
            loop_set_continue(c, inc_at_m);
            emit(c, make_inst_abc(Op::Add, i_r, i_r, one_r));
            emit_jump_back(c, Op::Jmp, loop_top);
            patch_jump(c, (u32)jmp_exit_idx);
            let frame_m = c.loop_stack[c.loop_depth - 1];
            let bi_m: u32 = 0;
            while bi_m < frame_m.break_count {
                patch_jump(c, frame_m.break_patches[bi_m]);
                bi_m = bi_m + 1;
            }
            if need_per_iter_env_i {
                emit(c, make_inst_ab(Op::Mov, c.env_reg, saved_env_ri));
            }
            loop_pop(c);
            c.fixed_regs = saved_fixed;
            release_reg(c, i_r);
            release_reg(c, one_r);
            release_reg(c, len_r);
            release_reg(c, iter_r);
            return;
        }
        if binding.kind != NodeKind::VarDecl
           && binding.kind != NodeKind::IdentExpr
           && binding.kind != NodeKind::ArrayPattern
           && binding.kind != NodeKind::ObjectPattern {
            c.had_error = true; return;
        }
        let bname_start: u32 = 0;
        let bname_len:   u32 = 0;
        let bpattern:    AstNode* = NULL;
        let bpattern_assign: bool = false;
        if binding.kind == NodeKind::VarDecl {
            if binding.children_count != 1 { c.had_error = true; return; }
            let decl = binding.children[0];
            if decl.name_length == 0 && decl.third != NULL {
                bpattern = decl.third;
            } else {
                bname_start = decl.name_start;
                bname_len   = decl.name_length;
            }
        } else if binding.kind == NodeKind::ArrayPattern || binding.kind == NodeKind::ObjectPattern {
            // Bare-LHS pattern in a for-of/for-in head ⇒ assignment
            // mode: each entry's target is an already-bound LHSExpr.
            bpattern = binding;
            bpattern_assign = true;
        } else {
            bname_start = binding.start;
            bname_len   = binding.end - binding.start;
        }

        if bpattern != NULL {
            // for (let/const <pattern> of/in src) — fan elem out via
            // destructure_pattern. Binding-mode locals were already
            // allocated by collect_locals; assignment-mode targets
            // resolve through the existing lookup chain.
            let saved_assign = c.in_dstr_assign;
            if bpattern_assign { c.in_dstr_assign = true; }
            destructure_pattern(c, bpattern, elem_r);
            c.in_dstr_assign = saved_assign;
            release_reg(c, elem_r);
            if node.children_count > 0 {
                compile_stmt(c, node.children[0]);
            }
            let inc_at_p = (u32)c.code_count;
            loop_set_continue(c, inc_at_p);
            emit(c, make_inst_abc(Op::Add, i_r, i_r, one_r));
            emit_jump_back(c, Op::Jmp, loop_top);
            patch_jump(c, (u32)jmp_exit_idx);
            let frame_p = c.loop_stack[c.loop_depth - 1];
            let bi_p: u32 = 0;
            while bi_p < frame_p.break_count {
                patch_jump(c, frame_p.break_patches[bi_p]);
                bi_p = bi_p + 1;
            }
            if need_per_iter_env_i {
                emit(c, make_inst_ab(Op::Mov, c.env_reg, saved_env_ri));
            }
            loop_pop(c);
            c.fixed_regs = saved_fixed;
            c.next_reg = saved_fixed;
            reset_temps(c);
            return;
        }
        let bname = c.source + bname_start;

        // Resolve and store. Mirror Assignment's lookup chain.
        if c.is_function {
            let lidx = find_local_index(c, bname, bname_len);
            if lidx >= 0 {
                if c.locals[(u32)lidx].captured {
                    let name_atom = ctx_intern_atom(c.ctx, bname, bname_len);
                    emit_store_prop_atom(c, c.env_reg, name_atom, elem_r);
                } else {
                    emit(c, make_inst_ab(Op::Mov, c.locals[(u32)lidx].reg, elem_r));
                }
            } else {
                // Bare identifier referencing a captured outer local, or
                // a global. Match Assignment.
                let outer_idx: i32 = -1;
                if c.parent != NULL {
                    let oi = find_local_index(c.parent, bname, bname_len);
                    if oi >= 0 && c.parent.locals[(u32)oi].captured {
                        outer_idx = oi;
                        c.has_outer_refs = true;
                    }
                }
                if outer_idx >= 0 {
                    let env_r = alloc_reg(c);
                    emit(c, make_inst_a(Op::LoadEnv, env_r));
                    let name_atom = ctx_intern_atom(c.ctx, bname, bname_len);
                    emit_store_prop_atom(c, env_r, name_atom, elem_r);
                    release_reg(c, env_r);
                } else {
                    let slot = ctx_intern_global(c.ctx, bname, bname_len);
                    emit(c, make_inst_a_u16(Op::StoreGlobal, elem_r, (u16)slot));
                }
            }
        } else {
            let slot = ctx_intern_global(c.ctx, bname, bname_len);
            emit(c, make_inst_a_u16(Op::DefineGlobal, elem_r, (u16)slot));
        }
        release_reg(c, elem_r);

        // body
        if node.children_count > 0 {
            compile_stmt(c, node.children[0]);
        }

        // i = i + 1  — also the `continue` landing pad.
        let inc_at = (u32)c.code_count;
        loop_set_continue(c, inc_at);
        emit(c, make_inst_abc(Op::Add, i_r, i_r, one_r));

        emit_jump_back(c, Op::Jmp, loop_top);
        patch_jump(c, (u32)jmp_exit_idx);
        let frame_o = c.loop_stack[c.loop_depth - 1];
        let bi: u32 = 0;
        while bi < frame_o.break_count {
            patch_jump(c, frame_o.break_patches[bi]);
            bi = bi + 1;
        }
        if need_per_iter_env_i {
            emit(c, make_inst_ab(Op::Mov, c.env_reg, saved_env_ri));
        }
        loop_pop(c);

        // Release the loop-scoped temps + restore fixed_regs.
        c.fixed_regs = saved_fixed;
        c.next_reg = saved_fixed;
        reset_temps(c);
        return;
    }
    if k == NodeKind::ForStmt {
        // Re-enter the for-statement's collect-assigned scope so the
        // init's let/const (and any let/const inside the body) doesn't
        // leak past the loop. See collect_locals's matching
        // enter_scope_assign for the rationale.
        enter_scope_reuse(c, node);
        // init
        if node.left != NULL { compile_stmt_or_expr(c, node.left); }
        // Reset AFTER init: ECMA-262 ForBodyEvaluation step 1 sets
        // V to undefined; the init's expression value doesn't leak
        // into the loop's completion.
        if c.parent == NULL && c.last_expr_reg >= 0 {
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
        }
        if node.right != NULL && loop_rotation_enabled()
           && cond_is_rotatable(node.right) {
            // Rotated (test-at-bottom) for-loop — see the WhileStmt
            // rotated emitter for the shape rationale. Entry Jmp skips
            // body AND update on the first iteration:
            //     init
            //     Jmp →test
            //   body_head:
            //     <body>
            //   update_at:            ; continue target
            //     <update>
            //   test:
            //     <cond operand evaluation>
            //     JmpIf* →body_head   ; fused; fall-through = exit
            let entry_jmp_f = emit(c, make_inst_i16(Op::Jmp, 0));
            let body_head_f = (u32)c.code_count;
            loop_push(c);
            // body (continues queue placeholders until update_at)
            if node.children_count > 0 {
                compile_stmt(c, node.children[0]);
            }
            // update step — `continue` jumps here
            let update_at_f = (u32)c.code_count;
            loop_set_continue(c, update_at_f);
            if node.third != NULL {
                let r_f = compile_expr(c, node.third);
                release_reg(c, r_f);
                reset_temps(c);
            }
            // test:
            patch_jump(c, entry_jmp_f);
            let exit_patches_f: u32[8];
            let exit_count_f = emit_rotated_bottom_test(c, node.right, body_head_f, &exit_patches_f[0]);
            reset_temps(c);
            let pi_f: u32 = 0;
            while pi_f < exit_count_f {
                patch_jump(c, exit_patches_f[pi_f]);
                pi_f = pi_f + 1;
            }
            let frame_rf = c.loop_stack[c.loop_depth - 1];
            let bi_rf: u32 = 0;
            while bi_rf < frame_rf.break_count {
                patch_jump(c, frame_rf.break_patches[bi_rf]);
                bi_rf = bi_rf + 1;
            }
            loop_pop(c);
            exit_scope(c);
            return;
        }
        let loop_top = (u32)c.code_count;
        // Pushed with continue_target = loop_top; we update to the
        // update-step offset below so `continue` runs the increment.
        loop_push(c);
        // test
        let jmp_exit_idx: i32 = -1;
        if node.right != NULL {
            let fused_f = try_emit_cmp_branch_if_false(c, node.right);
            if fused_f >= 0 {
                jmp_exit_idx = fused_f;
            } else {
                let cond_reg = compile_expr(c, node.right);
                jmp_exit_idx = (i32)emit(c, make_inst_a_i16(Op::JmpIfFalse, cond_reg, 0));
                release_reg(c, cond_reg);
            }
            reset_temps(c);
        }
        // body
        if node.children_count > 0 {
            compile_stmt(c, node.children[0]);
        }
        // update step — `continue` jumps here
        let update_at = (u32)c.code_count;
        loop_set_continue(c, update_at);
        if node.third != NULL {
            let r = compile_expr(c, node.third);
            release_reg(c, r);
            reset_temps(c);
        }
        emit_jump_back(c, Op::Jmp, loop_top);
        if jmp_exit_idx >= 0 { patch_jump(c, (u32)jmp_exit_idx); }
        let frame_f = c.loop_stack[c.loop_depth - 1];
        let bi: u32 = 0;
        while bi < frame_f.break_count {
            patch_jump(c, frame_f.break_patches[bi]);
            bi = bi + 1;
        }
        loop_pop(c);
        exit_scope(c);
        return;
    }
    if k == NodeKind::ReturnStmt {
        // Compute the return value first so we have it in hand.
        // Borrow the source register directly for IdentExpr — Return
        // consumes the value immediately, so the defensive Mov that
        // IdentExpr otherwise emits is dead weight. (Profile showed
        // Mov→Return = 2.1% of dispatches on richards.)
        let r: u8 = 0;
        if node.left != NULL {
            // #394: if this return is a tail-call rewrite candidate
            // (the gate below), flag the Call node so compile_call
            // skips InvokeGlobal fusion for it — the TCO rewriter
            // matches `last op == Op::Invoke` in place, and a fused
            // call there would silently lose TCO. Nested calls inside
            // the return expression compare unequal and still fuse.
            if c.is_function && c.active_finally_count == 0
               && c.active_try_count == 0
               && node.left.kind == NodeKind::Call {
                c.tail_call_node = node.left;
            }
            let saved_borrow = c.borrow_local_ok;
            c.borrow_local_ok = true;
            r = compile_expr(c, node.left);
            c.borrow_local_ok = saved_borrow;
            c.tail_call_node = NULL;
        } else {
            r = alloc_reg(c);
            emit(c, make_inst_a(Op::LoadUndefined, r));
        }
        // Phase 3.9h-C — tail-call optimization. If `return` is
        // returning the result of a direct call (`return f(...)`), and
        // there are no pending finallies, rewrite the call to its Tail
        // variant and skip Op::Return. The Tail callee returns directly
        // to *our* caller.
        //
        // Gate on (a) node.left being a Call AST node — `return x` after
        // an expression statement `console.log()` would otherwise see
        // the prior statement's MethodInvoke as "last emitted" and
        // incorrectly rewrite it; (b) the last emitted op matching, so
        // we don't rewrite an Invoke that's no longer the tail (e.g.
        // some peephole emitted a Mov after it).
        if c.is_function && c.active_finally_count == 0 && c.active_try_count == 0
           && c.code_count > 0
           && node.left != NULL && node.left.kind == NodeKind::Call {
            let last_op = c.code[c.code_count - 1].op;
            // Rewrite the call to its Tail variant, but STILL emit the
            // trailing Op::Return. For ordinary callees the Tail op
            // replaces the frame and breaks before the Return executes
            // (it's dead — one extra instruction). But async functions and
            // generators can't be frame-replaced (they must yield a
            // Promise / iterator, not run their body to completion), so the
            // interpreter's Tail handler falls back to a normal call for
            // those and lands on this Return to hand back the result.
            if last_op == Op::Invoke {
                c.code[c.code_count - 1].op = Op::TailInvoke;
                emit(c, make_inst_a(Op::Return, r));
                c.last_expr_reg = (i32)r;
                reset_temps(c);
                return;
            }
            if last_op == Op::MethodInvoke {
                c.code[c.code_count - 1].op = Op::TailMethodInvoke;
                emit(c, make_inst_a(Op::Return, r));
                c.last_expr_reg = (i32)r;
                reset_temps(c);
                return;
            }
        }
        // Phase 3.9d: run any pending finally bodies before returning.
        // r must survive finally execution — bump fixed_regs over it so
        // reset_temps inside finally can't recycle the slot.
        if c.active_finally_count > 0 {
            let saved_fixed = c.fixed_regs;
            if r + 1 > c.fixed_regs { c.fixed_regs = r + 1; }
            inline_finallies_above(c, 0);     // run ALL — we're leaving the function
            c.fixed_regs = saved_fixed;
        }
        emit(c, make_inst_a(Op::Return, r));
        c.last_expr_reg = (i32)r;
        reset_temps(c);
        return;
    }
    if k == NodeKind::EmptyStmt   { return; }
    if k == NodeKind::BreakStmt {
        if c.loop_depth == 0 { c.had_error = true; return; }
        let frame_idx: i32 = (i32)c.loop_depth - 1;
        if node.name_length > 0 {
            frame_idx = find_labeled_loop(c, c.source + node.name_start, node.name_length);
            if frame_idx < 0 { c.had_error = true; return; }
        }
        // Phase 3.9d: run any finallies that sit between us and the
        // target loop frame before we jump.
        let target_depth = c.loop_stack[(u32)frame_idx].finally_depth_at_entry;
        if c.active_finally_count > target_depth {
            inline_finallies_above(c, target_depth);
        }
        let jmp_idx = emit(c, make_inst_i16(Op::Jmp, 0));
        loop_add_break_to(c, (u32)frame_idx, (u32)jmp_idx);
        return;
    }
    if k == NodeKind::ContinueStmt {
        if c.loop_depth == 0 { c.had_error = true; return; }
        let frame_idx: i32 = -1;
        if node.name_length > 0 {
            frame_idx = find_labeled_loop(c, c.source + node.name_start, node.name_length);
            if frame_idx < 0 { c.had_error = true; return; }
        } else {
            // Unlabeled continue targets the innermost iteration loop;
            // walk past switch frames (#261).
            let walk: i32 = (i32)c.loop_depth - 1;
            while walk >= 0 {
                if c.loop_stack[(u32)walk].is_iter { frame_idx = walk; break; }
                walk = walk - 1;
            }
            if frame_idx < 0 { c.had_error = true; return; }
        }
        // Same finally unwind as break.
        let target_depth = c.loop_stack[(u32)frame_idx].finally_depth_at_entry;
        if c.active_finally_count > target_depth {
            inline_finallies_above(c, target_depth);
        }
        let lp = c.loop_stack[(u32)frame_idx];
        if lp.have_continue {
            emit_jump_back(c, Op::Jmp, lp.continue_target);
        } else {
            // Target not yet known (for-style loops where `continue`
            // means "run the update step"). Emit placeholder, patch
            // at loop_set_continue time.
            let jmp_idx = emit(c, make_inst_i16(Op::Jmp, 0));
            loop_add_continue_patch_to(c, (u32)frame_idx, (u32)jmp_idx);
        }
        return;
    }
    if k == NodeKind::LabeledStmt {
        let inner = node.left;
        let ik = if inner != NULL { inner.kind } else { NodeKind::EmptyStmt };
        let is_loop_target =
               ik == NodeKind::WhileStmt
            || ik == NodeKind::DoWhileStmt
            || ik == NodeKind::ForStmt
            || ik == NodeKind::ForInStmt
            || ik == NodeKind::ForOfStmt;
        if is_loop_target {
            // Stash the label so the loop's loop_push() picks it up.
            c.pending_label_start  = node.name_start;
            c.pending_label_length = node.name_length;
            compile_stmt(c, inner);
            c.pending_label_start  = 0;
            c.pending_label_length = 0;
            return;
        }
        // Labeled non-loop (block, if, try, plain statement). Push a
        // synthetic loop frame so a `break <label>` inside the body can
        // patch out to the position immediately after the inner
        // statement. `continue` against a labeled non-loop is a
        // SyntaxError, but we don't enforce that yet — a stray
        // `continue` would just have nowhere to land.
        loop_push(c);
        let frame_idx = c.loop_depth - 1;
        c.loop_stack[frame_idx].label_start  = node.name_start;
        c.loop_stack[frame_idx].label_length = node.name_length;
        // Clear pending so an inner loop doesn't accidentally inherit
        // this label too (the LabeledStmt → inner-loop case is already
        // handled by the branch above).
        c.pending_label_start  = 0;
        c.pending_label_length = 0;
        compile_stmt(c, inner);
        // Patch every break that targeted this frame to here (after
        // the body).
        let frame = c.loop_stack[frame_idx];
        let bi: u32 = 0;
        while bi < frame.break_count {
            patch_jump(c, frame.break_patches[bi]);
            bi = bi + 1;
        }
        loop_pop(c);
        return;
    }

    if k == NodeKind::ThrowStmt {
        let r = compile_expr(c, node.left);
        emit(c, make_inst_a(Op::Throw, r));
        release_reg(c, r);
        reset_temps(c);
        return;
    }

    if k == NodeKind::TryStmt {
        // ECMA-262 14.15.8 step 6: TryStatement returns UpdateEmpty
        // with undefined when the try block produced an empty
        // completion. Mirror the if / while heads.
        if c.parent == NULL && c.last_expr_reg >= 0 {
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
        }
        // Catch parameter is a local register. At function scope it's
        // already allocated by collect_locals; at program (top-level)
        // scope we allocate it on the spot. Either way we bump
        // fixed_regs so reset_temps between statements doesn't clobber
        // the binding.
        let has_catch   = node.right != NULL;
        let has_finally = node.third != NULL;

        // Catch parameter is scoped to the catch block per ECMA-262
        // §14.15.3. We allocate a register up front (needed by EnterTry)
        // but only register it as a name-resolvable local while
        // compiling the catch body — snapshot/restore c.local_count so
        // outer code can't see it.
        let catch_reg: u8 = 0;
        let added_catch_local: bool = false;
        let saved_local_count: u32 = c.local_count;
        // Pattern catch param lives on children[0]; the inner bindings
        // are already allocated as locals by collect_pattern_locals.
        let catch_pattern: AstNode* = NULL;
        if has_catch && node.children_count == 1 { catch_pattern = node.children[0]; }
        if has_catch && (node.name_length > 0 || catch_pattern != NULL) {
            // Catch parameter is a fresh binding (ECMA-262 §14.15) that
            // shadows any outer same-named local. Always allocate a new
            // register — never reuse an existing local — so nested
            // try/catch (e.g. `catch(e){ try{}catch(e){} ...e... }`)
            // doesn't clobber the outer binding through register aliasing.
            catch_reg = alloc_reg(c);
            if node.name_length > 0 { added_catch_local = true; }
            if catch_reg + 1 > c.fixed_regs { c.fixed_regs = catch_reg + 1; }
        } else if has_catch {
            // Optional catch binding (`catch { … }`) — still need a sink
            // register for EnterTry to deposit the thrown value into so
            // we don't clobber reg 0 (which may hold an unrelated local).
            catch_reg = alloc_reg(c);
            if catch_reg + 1 > c.fixed_regs { c.fixed_regs = catch_reg + 1; }
        }

        if !has_finally {
            // Phase 3.1c shape: try { ... } catch (e) { ... } — no finally.
            let enter_idx = emit(c, make_inst_a_i16(Op::EnterTry, catch_reg, 0));
            // #326 — a throw from the try body is caught here, so a
            // `return f()` inside it is not in tail position; suppress
            // the tail-call rewrite while compiling the body.
            c.active_try_count = c.active_try_count + 1;
            compile_stmt(c, node.left);
            c.active_try_count = c.active_try_count - 1;
            emit(c, make_inst_a(Op::LeaveTry, 0));
            let skip_idx = emit(c, make_inst_i16(Op::Jmp, 0));
            patch_jump(c, enter_idx);
            // Catch entry: reset the result register so an empty
            // catch body produces undefined (UpdateEmpty per spec).
            if c.parent == NULL && c.last_expr_reg >= 0 {
                emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
            }
            // Bind the catch parameter for the catch body only.
            if added_catch_local {
                add_local(c, node.name_start, node.name_length, catch_reg);
            } else if catch_pattern != NULL {
                destructure_pattern(c, catch_pattern, catch_reg);
            }
            compile_stmt(c, node.right);
            if added_catch_local { c.local_count = saved_local_count; }
            patch_jump(c, skip_idx);
            return;
        }

        // Phase 3.8f: finally clause. Wrap (try [+ catch]) in an outer
        // try whose catch target stashes the thrown value + flag and
        // falls into the finally block. After finally, if the flag is
        // set, re-throw.
        let pending_reg = alloc_reg(c);
        let flag_reg    = alloc_reg(c);
        if flag_reg + 1 > c.fixed_regs { c.fixed_regs = flag_reg + 1; }
        // Initialize flag = false (covers the no-exception path).
        emit(c, make_inst_a(Op::LoadFalse, flag_reg));

        // Outer try: any uncaught throw from the try/catch body lands
        // at outer_handler with `thrown` placed in pending_reg.
        let outer_enter = emit(c, make_inst_a_i16(Op::EnterTry, pending_reg, 0));

        // Push the finally body so that a `return` in either the try
        // or catch arms runs the finally before exiting. (Phase 3.9d.)
        finally_push(c, node.third);

        if has_catch {
            // Inner try: throws from the try-body land in catch_reg.
            let inner_enter = emit(c, make_inst_a_i16(Op::EnterTry, catch_reg, 0));
            compile_stmt(c, node.left);
            emit(c, make_inst_a(Op::LeaveTry, 0));
            let skip_catch = emit(c, make_inst_i16(Op::Jmp, 0));
            patch_jump(c, inner_enter);
            // Reset result register on catch entry per UpdateEmpty.
            if c.parent == NULL && c.last_expr_reg >= 0 {
                emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
            }
            // Catch parameter bound for the catch body only.
            if added_catch_local {
                add_local(c, node.name_start, node.name_length, catch_reg);
            } else if catch_pattern != NULL {
                destructure_pattern(c, catch_pattern, catch_reg);
            }
            compile_stmt(c, node.right);
            if added_catch_local { c.local_count = saved_local_count; }
            patch_jump(c, skip_catch);
        } else {
            // No catch — outer try catches throws from the try body
            // directly and routes them to the finally re-throw path.
            compile_stmt(c, node.left);
        }

        finally_pop(c);

        emit(c, make_inst_a(Op::LeaveTry, 0));   // pop outer

        // Normal (or post-catch) exit: skip the handler entry.
        let skip_outer = emit(c, make_inst_i16(Op::Jmp, 0));
        patch_jump(c, outer_enter);
        // Outer handler entry — pending_reg holds the thrown value.
        // Mark the flag so we re-throw after finally.
        emit(c, make_inst_a(Op::LoadTrue, flag_reg));
        patch_jump(c, skip_outer);

        // Save the try/catch body's result so the spec semantics for
        // try-finally apply: if finally completes normally, the body's
        // completion wins (with empty → undefined). Reset result_reg
        // before the finally so an empty finally itself doesn't
        // contribute a value.
        let body_save: i32 = -1;
        if c.parent == NULL && c.last_expr_reg >= 0 {
            let save_reg = alloc_reg(c);
            if save_reg + 1 > c.fixed_regs { c.fixed_regs = save_reg + 1; }
            emit(c, make_inst_ab(Op::Mov, save_reg, (u8)c.last_expr_reg));
            emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
            body_save = (i32)save_reg;
        }

        // Finally body runs on both paths.
        compile_stmt(c, node.third);

        // After finally completes normally, restore the body's value
        // (UpdateEmpty(B, undefined) per spec). Abrupt finally
        // completions (return/throw inside finally) take a different
        // path and never reach this Mov.
        if body_save >= 0 {
            emit(c, make_inst_ab(Op::Mov, (u8)c.last_expr_reg, (u8)body_save));
            release_reg(c, (u8)body_save);
        }

        // If we got here via the outer handler, re-throw pending_reg.
        let after_finally = emit(c, make_inst_a_i16(Op::JmpIfFalse, flag_reg, 0));
        emit(c, make_inst_a(Op::Throw, pending_reg));
        patch_jump(c, after_finally);
        return;
    }

    // Default: an expression statement.
    //
    // At top level, the program needs a stable register to return at
    // the end — but try/catch makes the runtime flow non-static (the
    // catch body's expression might not actually execute). So we
    // reserve a `result_reg` in compile_program, and every top-level
    // expression statement Movs into that fixed register. Whichever
    // path runs, the final Return reads from the same slot.
    //
    // In a function, an explicit `return` statement is what produces
    // the call's result, so we just remember the last register for
    // diagnostic purposes.
    let r = compile_expr(c, node);
    // At the program top-level (script or module) we Mov each
    // expression-statement's result into the reserved result_reg so
    // the final Return picks up the LAST one. c.parent == NULL
    // marks "this IS the program compile" — inside any nested
    // function, c.parent points to its enclosing compiler.
    let is_program_top = c.parent == NULL;
    if is_program_top && c.last_expr_reg >= 0 {
        let dst = (u8)c.last_expr_reg;
        if r != dst { emit(c, make_inst_ab(Op::Mov, dst, r)); }
    } else {
        c.last_expr_reg = (i32)r;
    }
    reset_temps(c);
}

// Walks a for-of binding pattern and patches each contained local's
// per_iter_depth = `depth`. Called once per for-of iteration setup so
// closures emitted inside the body can tell loop-vars (stored ON the
// per-iter env) apart from outer-scope vars (above the per-iter env)
// when computing capture depth. See outer_capture_depth + #288.
fn mark_pattern_per_iter(c: Compiler*, pat: AstNode*, depth: u32) -> void {
    if pat == NULL { return; }
    let p = pat;
    while p.kind == NodeKind::Paren { p = p.left; }
    if p.kind == NodeKind::VarDecl {
        let i: u32 = 0;
        while i < p.children_count {
            mark_pattern_per_iter(c, p.children[i], depth);
            i = i + 1;
        }
        return;
    }
    if p.kind == NodeKind::Declarator {
        // Simple binding: name lives directly on the Declarator (see
        // parser.zc parse_var_decl). Pattern binding: name_length is 0
        // and the pattern AST lives on p.third.
        if p.name_length > 0 {
            let idx = find_local_index(c, c.source + p.name_start, p.name_length);
            if idx >= 0 { c.locals[(u32)idx].per_iter_depth = depth; }
        } else if p.third != NULL {
            mark_pattern_per_iter(c, p.third, depth);
        }
        return;
    }
    if p.kind == NodeKind::IdentExpr {
        if p.name_length > 0 {
            let idx = find_local_index(c, c.source + p.name_start, p.name_length);
            if idx >= 0 { c.locals[(u32)idx].per_iter_depth = depth; }
        }
        return;
    }
    // Destructuring patterns — walk children, picking up identifiers.
    let i: u32 = 0;
    while i < p.children_count {
        mark_pattern_per_iter(c, p.children[i], depth);
        i = i + 1;
    }
    if p.left  != NULL { mark_pattern_per_iter(c, p.left,  depth); }
    if p.right != NULL { mark_pattern_per_iter(c, p.right, depth); }
    if p.third != NULL { mark_pattern_per_iter(c, p.third, depth); }
}

// Helper for ForStmt's init slot, which can be either a VarDecl
// (statement-shaped) or an expression. compile_stmt handles both.
// for-of with live iterator semantics (2026-05-16). Uses IterGet +
// IterStep + IterClose so:
//   * Infinite iterables drive only as many .next() calls as the body
//     actually consumes (no eager pre-collect → no hangs on break).
//   * break / abrupt completion call iter.return() per spec.
//   * Spec-mandated iter.next() call count matches.
fn compile_for_of_live(c: Compiler*, node: AstNode*) -> void {
    if c.parent == NULL && c.last_expr_reg >= 0 {
        emit(c, make_inst_a(Op::LoadUndefined, (u8)c.last_expr_reg));
    }

    let src_r = compile_expr(c, node.right);
    let iter_r = alloc_reg(c);
    // for-await needs the spec's async GetIterator (look up
    // @@asyncIterator first, fall back to @@iterator). Plain for-of
    // uses the sync path.
    if node.bool_value {
        emit(c, make_inst_ab(Op::IterGetAsync, iter_r, src_r));
    } else {
        emit(c, make_inst_ab(Op::IterGet, iter_r, src_r));
    }
    if src_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
    let done_r = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadFalse, done_r));

    let saved_fixed = c.fixed_regs;
    if done_r + 1 > c.fixed_regs { c.fixed_regs = done_r + 1; }

    // Per-iteration env (closes #250). `for (let|const ... of ...)`
    // should create a fresh binding each iteration so closures captured
    // in iteration N see iteration-N's value. We allocate a fresh env
    // object at the top of each iter and chain __outer__ to the saved
    // outer env. MakeClosure inside the body reads c.env_reg, which now
    // points at the per-iter env, so closures close over the right one.
    // Skip for `var` (function-scoped) or when c.needs_env is false
    // (no captures in this function at all).
    let need_per_iter_env: bool = false;
    if c.needs_env {
        let binding_lookahead = node.left;
        while binding_lookahead != NULL && binding_lookahead.kind == NodeKind::Paren {
            binding_lookahead = binding_lookahead.left;
        }
        if binding_lookahead != NULL
           && binding_lookahead.kind == NodeKind::VarDecl
           && binding_lookahead.op != TokenKind::KwVar {
            need_per_iter_env = true;
        }
    }
    let saved_env_r: u8 = 0;
    if need_per_iter_env {
        saved_env_r = alloc_reg(c);
        emit(c, make_inst_ab(Op::Mov, saved_env_r, c.env_reg));
        if saved_env_r + 1 > c.fixed_regs { c.fixed_regs = saved_env_r + 1; }
        // Track the per-iter env so nested closures know to walk one
        // extra __outer__ hop (#288).
        c.per_iter_envs_open = c.per_iter_envs_open + 1;
        // Patch the loop binding(s) so their per_iter_depth reflects
        // that they live ON this per-iter env, not above it. collect_locals
        // ran in a separate pre-pass that didn't know about the bump.
        // Without this, closures inside the body would over-correct and
        // walk past the per-iter env to find the loop var on the parent's
        // normal env (and find undefined there).
        mark_pattern_per_iter(c, node.left, c.per_iter_envs_open);
    }

    let loop_top = (u32)c.code_count;
    loop_push(c);
    loop_set_continue(c, loop_top);

    // Fresh env per iteration — runs BEFORE IterStep so the env exists
    // even if the body's binding writeback uses c.env_reg directly.
    if need_per_iter_env {
        emit(c, make_inst_a(Op::NewObject, c.env_reg));
        let outer_atom = ctx_intern_atom(c.ctx, OUTER_ENV_KEY, OUTER_ENV_KEY_LEN);
        emit_store_prop_atom(c, c.env_reg, outer_atom, saved_env_r);
    }

    let value_r = alloc_reg(c);
    let jmp_exit_idx: u32 = 0;
    if node.bool_value {
        // `for await (x of expr)` per ECMA-262 §14.7.5.3 step k.ii:
        // call iter.next() then AWAIT the raw result before reading
        // .done / .value (async iterators wrap the result in a Promise;
        // sync iterables return the result object and Await is a
        // pass-through). The IterStep fast path can't be reused here —
        // it splits .value/.done eagerly, which loops forever on
        // Promise results.
        emit(c, make_inst_ab(Op::IterNextRaw, value_r, iter_r));
        emit(c, make_inst_ab(Op::Await, value_r, value_r));
        let done_atom  = ctx_intern_atom(c.ctx, (char*)"done", 4);
        let value_atom = ctx_intern_atom(c.ctx, (char*)"value", 5);
        emit_load_prop_atom(c, done_r, value_r, done_atom);
        jmp_exit_idx = emit(c, make_inst_a_i16(Op::JmpIfTrue, done_r, 0));
        // Replace the raw result with .value for binding consumption.
        emit_load_prop_atom(c, value_r, value_r, value_atom);
        // Spec only awaits the next() result; in practice, when the
        // iterable is sync but yields Promises (the classic
        // `[Promise.reject(...)]` pattern), tests expect the rejected
        // value to surface here. Awaiting again is harmless for plain
        // values and matches what Node/V8 do in this corner.
        emit(c, make_inst_ab(Op::Await, value_r, value_r));
    } else {
        emit(c, make_inst_abc(Op::IterStep, value_r, iter_r, done_r));
        jmp_exit_idx = emit(c, make_inst_a_i16(Op::JmpIfTrue, done_r, 0));
    }

    // Write `value_r` into the binding. Reuses the binding logic from
    // the original for-of/in path: Member / Computed targets, plain
    // ident, VarDecl, and pattern (both binding and assignment mode).
    let binding = node.left;
    while binding != NULL && binding.kind == NodeKind::Paren {
        binding = binding.left;
    }
    if binding == NULL { c.had_error = true; return; }

    if binding.kind == NodeKind::Member || binding.kind == NodeKind::Computed {
        let m_obj_r = compile_expr(c, binding.left);
        let m_key_r: u8 = 0;
        if binding.kind == NodeKind::Member {
            m_key_r = emit_load_name_string(c, c.source + binding.name_start, binding.name_length);
        } else {
            m_key_r = compile_expr(c, binding.right);
        }
        emit(c, make_inst_abc(Op::StoreElem, m_obj_r, m_key_r, value_r));
        if m_key_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        if m_obj_r + 1 == c.next_reg { c.next_reg = c.next_reg - 1; }
        release_reg(c, value_r);
    } else if binding.kind == NodeKind::ArrayPattern || binding.kind == NodeKind::ObjectPattern {
        let saved_assign = c.in_dstr_assign;
        c.in_dstr_assign = true;
        destructure_pattern(c, binding, value_r);
        c.in_dstr_assign = saved_assign;
        release_reg(c, value_r);
    } else if binding.kind == NodeKind::VarDecl {
        if binding.children_count != 1 { c.had_error = true; return; }
        let decl = binding.children[0];
        if decl.name_length == 0 && decl.third != NULL {
            destructure_pattern(c, decl.third, value_r);
            release_reg(c, value_r);
        } else {
            let bname = c.source + decl.name_start;
            let bname_len = decl.name_length;
            if c.is_function {
                let lidx = find_local_index(c, bname, bname_len);
                if lidx >= 0 {
                    if c.locals[(u32)lidx].captured {
                        let name_atom = ctx_intern_atom(c.ctx, bname, bname_len);
                        emit_store_prop_atom(c, c.env_reg, name_atom, value_r);
                    } else {
                        emit(c, make_inst_ab(Op::Mov, c.locals[(u32)lidx].reg, value_r));
                    }
                } else {
                    let slot = ctx_intern_global(c.ctx, bname, bname_len);
                    emit(c, make_inst_a_u16(Op::StoreGlobal, value_r, (u16)slot));
                }
            } else {
                let slot = ctx_intern_global(c.ctx, bname, bname_len);
                emit(c, make_inst_a_u16(Op::DefineGlobal, value_r, (u16)slot));
            }
            release_reg(c, value_r);
        }
    } else if binding.kind == NodeKind::IdentExpr {
        let bname = c.source + binding.start;
        let bname_len = binding.end - binding.start;
        if c.is_function {
            let lidx = find_local_index(c, bname, bname_len);
            if lidx >= 0 {
                if c.locals[(u32)lidx].captured {
                    let name_atom = ctx_intern_atom(c.ctx, bname, bname_len);
                    emit_store_prop_atom(c, c.env_reg, name_atom, value_r);
                } else {
                    emit(c, make_inst_ab(Op::Mov, c.locals[(u32)lidx].reg, value_r));
                }
            } else {
                let slot = ctx_intern_global(c.ctx, bname, bname_len);
                emit(c, make_inst_a_u16(Op::StoreGlobal, value_r, (u16)slot));
            }
        } else {
            let slot = ctx_intern_global(c.ctx, bname, bname_len);
            emit(c, make_inst_a_u16(Op::DefineGlobal, value_r, (u16)slot));
        }
        release_reg(c, value_r);
    } else {
        c.had_error = true; return;
    }

    if node.children_count > 0 {
        compile_stmt(c, node.children[0]);
    }

    emit_jump_back(c, Op::Jmp, loop_top);

    // Patch the natural exit AND any `break` patches to land at the
    // IterClose. break inside the body needs the close to run before
    // jumping further out.
    let close_at = (u32)c.code_count;
    patch_jump(c, (u32)jmp_exit_idx);
    let frame_o = c.loop_stack[c.loop_depth - 1];
    let bi: u32 = 0;
    while bi < frame_o.break_count {
        patch_jump(c, frame_o.break_patches[bi]);
        bi = bi + 1;
    }
    emit(c, make_inst_ab(Op::IterClose, iter_r, done_r));
    // Restore the outer env so code after the loop reads the right
    // env (matters when the body left c.env_reg pointing at a
    // per-iter env).
    if need_per_iter_env {
        emit(c, make_inst_ab(Op::Mov, c.env_reg, saved_env_r));
        // Pop the per-iter env tracking so closures emitted after this
        // loop don't get a spurious extra hop (#288).
        if c.per_iter_envs_open > 0 {
            c.per_iter_envs_open = c.per_iter_envs_open - 1;
        }
    }

    loop_pop(c);
    c.fixed_regs = saved_fixed;
    c.next_reg = saved_fixed;
    reset_temps(c);
}

fn compile_stmt_or_expr(c: Compiler*, node: AstNode*) -> void {
    compile_stmt(c, node);
}

// =====================================================================
// Top-level compile entry. Walks the Program node, returns a finished
// Function.
// =====================================================================

// Recurse into the AST and hoist every `var` declaration + top-level
// function/class declaration into the global table. Stops at function,
// class, and arrow boundaries — those introduce their own scope.
// Walk a destructuring pattern at module top-level and pre-declare
// every contained binding name as a global.
fn hoist_pattern_globals(c: Compiler*, pat: AstNode*) -> void {
    if pat == NULL { return; }
    if pat.kind == NodeKind::IdentExpr {
        if pat.name_length > 0 {
            let slot = ctx_intern_global(c.ctx, c.source + pat.name_start, pat.name_length);
            c.ctx.realm.globals[slot].defined = true;
        }
        return;
    }
    if pat.kind == NodeKind::ObjectPattern || pat.kind == NodeKind::ArrayPattern {
        let i: u32 = 0;
        while i < pat.children_count {
            let entry = pat.children[i];
            if entry.left != NULL { hoist_pattern_globals(c, entry.left); }
            i = i + 1;
        }
    }
}

fn hoist_program_decls(c: Compiler*, node: AstNode*) -> void {
    if node == NULL { return; }
    let k = node.kind;
    if k == NodeKind::FunctionDecl {
        // Hoist the function name. Its BODY has its own scope, so don't
        // recurse further (the inner-function compiler does its own pass).
        let nm = c.source + node.name_start;
        let nl = node.name_length;
        let slot = ctx_intern_global(c.ctx, nm, nl);
        c.ctx.realm.globals[slot].defined = true;
        return;
    }
    if k == NodeKind::FunctionExpr || k == NodeKind::ArrowFunc { return; }
    if k == NodeKind::ClassDecl {
        let nm = c.source + node.name_start;
        let nl = node.name_length;
        let slot = ctx_intern_global(c.ctx, nm, nl);
        c.ctx.realm.globals[slot].defined = true;
        return;   // class body is not hoisted
    }
    if k == NodeKind::ClassExpr { return; }
    if k == NodeKind::VarDecl {
        // Only `var` hoists into the global object (ECMA-262 §10.2.11).
        // `let` / `const` are block-scoped — pre-declaring them as
        // globals here would let bare reads after the block silently
        // see `undefined` instead of throwing ReferenceError.
        if node.op != TokenKind::KwVar { return; }
        let j: u32 = 0;
        while j < node.children_count {
            let decl = node.children[j];
            if decl != NULL {
                if decl.name_length > 0 {
                    let nm = c.source + decl.name_start;
                    let nl = decl.name_length;
                    let slot = ctx_intern_global(c.ctx, nm, nl);
                    c.ctx.realm.globals[slot].defined = true;
                } else if decl.third != NULL {
                    // Destructuring declarator at module scope —
                    // hoist every contained binding name.
                    hoist_pattern_globals(c, decl.third);
                }
            }
            j = j + 1;
        }
        return;
    }
    // Generic recursion through this node's children.
    if node.left  != NULL { hoist_program_decls(c, node.left); }
    if node.right != NULL { hoist_program_decls(c, node.right); }
    if node.third != NULL { hoist_program_decls(c, node.third); }
    let i: u32 = 0;
    while i < node.children_count {
        hoist_program_decls(c, node.children[i]);
        i = i + 1;
    }
}

fn compile_program(ctx: ZjsContext*, source: char*, root: AstNode*) -> Function* {
    let c = compiler_new(ctx, source);
    defer compiler_free(c);

    // Module mode (root.bool_value == true): top-level declarations
    // become module-scoped locals instead of globals. We flip the
    // compiler's is_function flag — the existing VarDecl / FunctionDecl
    // / ClassDecl paths already do the right thing in that mode.
    let is_module: bool = root != NULL && root.bool_value;
    // Modules are always strict; scripts are strict only with a
    // top-level "use strict" prologue.
    if is_module { c.strict = true; }
    else if root != NULL && body_has_use_strict_directive(root, source) { c.strict = true; }
    if is_module {
        c.is_function = true;
        collect_locals(c, root);
        reset_scope_walk(c);
        analyze_captures(c, root);
        if c.needs_env {
            c.env_reg = alloc_reg(c);
        }
    } else {
        // Script mode (the common case). Top-level let/const/class go
        // into a script-scope lexical env (= register slots, just like
        // a function frame). `var` and FunctionDecls still create
        // properties on globalThis per spec — the collect_locals path
        // below sees c.is_script and skips them.
        c.is_function = true;
        c.is_script   = true;
        if root != NULL { collect_locals(c, root); }
        reset_scope_walk(c);
        if root != NULL { analyze_captures(c, root); }
        if c.needs_env {
            c.env_reg = alloc_reg(c);
        }
    }
    // Reset scope tracking so compile_stmt re-enters each block with
    // the same ids collect_locals + analyze_captures just assigned.
    reset_scope_walk(c);

    // Reserve a stable program-result register. Every top-level
    // expression statement Movs into it; the final Return reads from
    // it. This makes the program's return value deterministic even
    // when try/catch creates branchy runtime flow.
    let result_reg = alloc_reg(c);
    emit(c, make_inst_a(Op::LoadUndefined, result_reg));
    c.fixed_regs = result_reg + 1;
    c.last_expr_reg = (i32)result_reg;

    // Module/script env construction: instantiate the env object
    // right after the result-reg prologue so subsequent ImportBind /
    // VarDecl emissions can StoreProp captured locals into it.
    if c.needs_env {
        emit(c, make_inst_a(Op::NewObject, c.env_reg));
    }

    if root != NULL && root.kind == NodeKind::Program {
        // Hoist top-level declarations into globals so forward references
        // and "defined-via-conditional-branch" var declarations resolve
        // without ReferenceError. In module mode this is a no-op for
        // var/let/const (already handled by collect_locals above) but
        // still hoists function decls.
        if !is_module { hoist_program_decls(c, root); }
        // ECMA-262 §10.2.11: function declarations are evaluated at
        // scope entry, so calling them before their textual position is
        // valid. Two-pass compilation of the top level: emit
        // FunctionDecl statements first (in source order), then emit
        // the rest of the body skipping the already-emitted FunctionDecls.
        let i1: u32 = 0;
        while i1 < root.children_count && !c.had_error {
            let child = root.children[i1];
            if child != NULL && child.kind == NodeKind::FunctionDecl {
                compile_stmt(c, child);
            }
            i1 = i1 + 1;
        }
        let i2: u32 = 0;
        while i2 < root.children_count && !c.had_error {
            let child = root.children[i2];
            if child != NULL && child.kind != NodeKind::FunctionDecl {
                compile_stmt(c, child);
            }
            i2 = i2 + 1;
        }
    } else {
        c.had_error = true;
    }

    // Emit final Return — always from the stable result_reg.
    emit(c, make_inst_a(Op::Return, result_reg));

    if c.had_error { return NULL; }

    // Transfer ownership of code + constants + ICs to a fresh Function.
    let f = function_new();
    f.realm = c.ctx.realm;   // [[Realm]] — the realm this code compiled in
    f.code = c.code;
    f.code_len = c.code_count;
    f.constants = c.constants;
    f.const_count = c.const_count;
    f.register_count = (u32)(c.max_reg + 1);
    if f.register_count == 0 { f.register_count = 1; }
    // For the top-level program, init everything — script-scope locals
    // (declared via top-level let/const) live above the params=0
    // baseline and are bumped into c.fixed_regs by the compiler, but
    // there's also the conservative win of just clamping to
    // register_count when in doubt. The skip is mostly leverage for
    // hot leaf functions, not the one-shot top-level.
    f.fixed_regs = (u32)c.fixed_regs;
    if f.fixed_regs > f.register_count { f.fixed_regs = f.register_count; }
    f.param_count = 0;
    f.strict = c.strict;
    f.ics = c.ics;
    f.ic_count = c.ic_count;
    if c.tmpl_site_count > 0 {
        c.tmpl_seg_start[c.tmpl_site_count] = c.tmpl_seg_count;
        f.template_count     = c.tmpl_site_count;
        f.template_cooked    = c.tmpl_cooked;
        f.template_raw       = c.tmpl_raw;
        f.template_seg_start = c.tmpl_seg_start;
        f.template_cache     = alloc_n<ZjsArray*>((usize)c.tmpl_site_count);
        let ti: u32 = 0;
        while ti < c.tmpl_site_count { f.template_cache[ti] = NULL; ti = ti + 1; }
        c.tmpl_cooked    = NULL;
        c.tmpl_raw       = NULL;
        c.tmpl_seg_start = NULL;
    }

    // Steal the buffers from the compiler so its destructor doesn't free them.
    c.code = NULL;
    c.constants = NULL;
    c.ics = NULL;
    return f;
}
