// WHATWG Streams — pure-JS bootstrap.
//
// The actual JS source lives in `src/stdlib/web_streams.js` so it
// gets full editor support (syntax highlighting, format, lint,
// `@ts-check` against zjs-types). The .gen.h file is produced by
// `tools/embed_js.py` during the build (see Makefile's stdlib-embed
// rule); it declares:
//
//     static const char  WEB_STREAMS_SOURCE[];
//     static const size_t WEB_STREAMS_SOURCE_LEN;
//
// What's covered: ReadableStream + default reader + BYOB reader (for
// `type: 'bytes'` streams), WritableStream + default writer,
// TransformStream, CountQueuingStrategy / ByteLengthQueuingStrategy,
// pipeTo / pipeThrough, async iteration, tee(), TextEncoderStream /
// TextDecoderStream. Producer-side byobRequest / respond is deferred.
//
// Bundle: this is the largest of the web-globals bootstraps (~50KB
// of source). Registered via its own `zjs_install_web_streams` so
// an embedder can selectively skip it for a tinier engine — the
// other Tier-2 web globals stay regardless.

raw {
    #include "stdlib/web_streams.gen.h"
}

fn zjs_install_web_streams(ctx: ZjsContext*) -> void {
    let src: char* = NULL;
    raw { src = (char*)WEB_STREAMS_SOURCE; }
    let r = zjs_eval(ctx, src);
    if ctx.had_error {
        let err = ctx.last_error;
        let name_s: ZjsString* = NULL;
        let msg_s:  ZjsString* = NULL;
        if zjs_is_object(err) != 0 {
            let n = property_get(ctx, err, ctx_intern_string(ctx, (char*)"name", 4));
            let m = property_get(ctx, err, ctx_intern_string(ctx, (char*)"message", 7));
            if zjs_is_string(n) != 0 { name_s = zjs_as_string(n); }
            if zjs_is_string(m) != 0 { msg_s  = zjs_as_string(m); }
        }
        raw {
            fprintf(stderr, "[stdlib] web_streams bootstrap failed: %.*s: %.*s\n",
                    name_s ? (int)name_s->length : 7,
                    name_s ? name_s->data : "Unknown",
                    msg_s  ? (int)msg_s->length  : 0,
                    msg_s  ? msg_s->data  : "");
        }
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
    }
}
