// node:path — pure-JS implementation, inlined as a static source
// string and lazily compiled to bytecode on first `import 'node:path'`.
//
// The JS source lives in `src/stdlib/node_path.js` (real file, full
// editor support). Embedded as a C string literal at build time via
// tools/embed_js.py — see Makefile's stdlib-embed rule.
//
// Scope: POSIX-style path operations covering the common app-code
// surface. Windows-style separator handling is deferred (Zapp's first
// consumer is iOS/macOS); when Linux/Windows ports need it, we'll add
// a `win32` subnamespace per the Node API.
//
// Methods exported: join, resolve, normalize, dirname, basename,
// extname, parse, format, isAbsolute, relative. Constants: sep,
// delimiter.

raw {
    #include "stdlib/node_path.gen.h"
}

fn zjs_register_node_path(ctx: ZjsContext*) -> void {
    let src: char* = NULL;
    let slen: u32 = 0;
    raw {
        src = (char*)NODE_PATH_SOURCE;
        slen = (uint32_t)(sizeof(NODE_PATH_SOURCE) - 1);
    }
    ctx_register_builtin_module_source(ctx, (char*)"node:path", src, slen);
}
