// Blob + File + FormData — pure-JS web globals.
//
// The JS source lives in `src/stdlib/web_blob.js` (real file, full
// editor support). Embedded as a C string literal at build time via
// tools/embed_js.py — see Makefile's stdlib-embed rule.
//
// Blob stores parts as a single concatenated Uint8Array. Construction
// flattens nested Blobs and string parts (utf-8) so .size and slicing
// are O(1)/O(slice) instead of carrying an array-of-parts forever.
//
// FormData is a multimap (array of {name, value, filename} entries)
// with the iterator protocol so `for ([k, v] of fd)` works.

raw {
    #include "stdlib/web_blob.gen.h"
}

fn zjs_install_web_blob(ctx: ZjsContext*) -> void {
    let src: char* = NULL;
    raw { src = (char*)WEB_BLOB_SOURCE; }
    let r = zjs_eval(ctx, src);
    if ctx.had_error {
        let err = ctx.last_error;
        let name_s: ZjsString* = NULL;
        let msg_s:  ZjsString* = NULL;
        if zjs_is_object(err) != 0 {
            let n = property_get(ctx, err, ctx_intern_string(ctx, (char*)"name", 4));
            let m = property_get(ctx, err, ctx_intern_string(ctx, (char*)"message", 7));
            if zjs_is_string(n) != 0 { name_s = zjs_as_string(n); }
            if zjs_is_string(m) != 0 { msg_s  = zjs_as_string(m); }
        }
        raw {
            fprintf(stderr, "[stdlib] web_blob bootstrap failed: %.*s: %.*s\n",
                    name_s ? (int)name_s->length : 7,
                    name_s ? name_s->data : "Unknown",
                    msg_s  ? (int)msg_s->length  : 0,
                    msg_s  ? msg_s->data  : "");
        }
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
    }
}
