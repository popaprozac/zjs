// Pure-JS polyfills for the Array / TypedArray / String prototype
// methods that the engine doesn't ship natively yet. Installed at
// context init, after the array_proto / string_proto are in place.
//
// Each method only assigns if missing — playing safe against future
// native impls that supersede a polyfill.

raw {
    static const char WEB_POLYFILLS_SOURCE[] =
        "(function() {\n"
        "  function defineIfMissing(proto, name, fn) {\n"
        "    if (proto && typeof proto[name] !== 'function') {\n"
        "      proto[name] = fn;\n"
        "    }\n"
        "  }\n"
        "  var AP = Array.prototype;\n"
        "\n"
        "  defineIfMissing(AP, 'every', function(fn, thisArg) {\n"
        "    for (var i = 0; i < this.length; ++i)\n"
        "      if (!fn.call(thisArg, this[i], i, this)) return false;\n"
        "    return true;\n"
        "  });\n"
        "  defineIfMissing(AP, 'some', function(fn, thisArg) {\n"
        "    for (var i = 0; i < this.length; ++i)\n"
        "      if (fn.call(thisArg, this[i], i, this)) return true;\n"
        "    return false;\n"
        "  });\n"
        "  defineIfMissing(AP, 'find', function(fn, thisArg) {\n"
        "    for (var i = 0; i < this.length; ++i)\n"
        "      if (fn.call(thisArg, this[i], i, this)) return this[i];\n"
        "    return undefined;\n"
        "  });\n"
        "  defineIfMissing(AP, 'findIndex', function(fn, thisArg) {\n"
        "    for (var i = 0; i < this.length; ++i)\n"
        "      if (fn.call(thisArg, this[i], i, this)) return i;\n"
        "    return -1;\n"
        "  });\n"
        "  defineIfMissing(AP, 'filter', function(fn, thisArg) {\n"
        "    var out = [];\n"
        "    for (var i = 0; i < this.length; ++i)\n"
        "      if (fn.call(thisArg, this[i], i, this)) out.push(this[i]);\n"
        "    return out;\n"
        "  });\n"
        "  defineIfMissing(AP, 'reduce', function(fn, initial) {\n"
        "    var i = 0;\n"
        "    var acc;\n"
        "    if (arguments.length >= 2) { acc = initial; }\n"
        "    else {\n"
        "      if (this.length === 0) throw new TypeError('Reduce of empty array with no initial value');\n"
        "      acc = this[0]; i = 1;\n"
        "    }\n"
        "    for (; i < this.length; ++i) acc = fn(acc, this[i], i, this);\n"
        "    return acc;\n"
        "  });\n"
        "  defineIfMissing(AP, 'reduceRight', function(fn, initial) {\n"
        "    var i = this.length - 1;\n"
        "    var acc;\n"
        "    if (arguments.length >= 2) { acc = initial; }\n"
        "    else {\n"
        "      if (this.length === 0) throw new TypeError('Reduce of empty array with no initial value');\n"
        "      acc = this[i]; i = i - 1;\n"
        "    }\n"
        "    for (; i >= 0; --i) acc = fn(acc, this[i], i, this);\n"
        "    return acc;\n"
        "  });\n"
        "  defineIfMissing(AP, 'includes', function(val, fromIndex) {\n"
        "    var start = fromIndex | 0;\n"
        "    if (start < 0) start = Math.max(0, this.length + start);\n"
        "    for (var i = start; i < this.length; ++i) {\n"
        "      var v = this[i];\n"
        "      if (v === val) return true;\n"
        "      if (v !== v && val !== val) return true;\n" // NaN == NaN per includes
        "    }\n"
        "    return false;\n"
        "  });\n"
        "  defineIfMissing(AP, 'lastIndexOf', function(val, fromIndex) {\n"
        "    var start = (fromIndex === undefined) ? this.length - 1 : (fromIndex | 0);\n"
        "    if (start < 0) start = this.length + start;\n"
        "    if (start >= this.length) start = this.length - 1;\n"
        "    for (var i = start; i >= 0; --i) if (this[i] === val) return i;\n"
        "    return -1;\n"
        "  });\n"
        "  defineIfMissing(AP, 'at', function(idx) {\n"
        "    var n = idx | 0;\n"
        "    if (n < 0) n = this.length + n;\n"
        "    if (n < 0 || n >= this.length) return undefined;\n"
        "    return this[n];\n"
        "  });\n"
        "  defineIfMissing(AP, 'flat', function(depth) {\n"
        "    var d = depth === undefined ? 1 : (depth | 0);\n"
        "    var out = [];\n"
        "    var walk = function(arr, dep) {\n"
        "      for (var i = 0; i < arr.length; ++i) {\n"
        "        var v = arr[i];\n"
        "        if (Array.isArray(v) && dep > 0) walk(v, dep - 1);\n"
        "        else out.push(v);\n"
        "      }\n"
        "    };\n"
        "    walk(this, d);\n"
        "    return out;\n"
        "  });\n"
        "  defineIfMissing(AP, 'flatMap', function(fn, thisArg) {\n"
        "    var out = [];\n"
        "    for (var i = 0; i < this.length; ++i) {\n"
        "      var v = fn.call(thisArg, this[i], i, this);\n"
        "      if (Array.isArray(v)) {\n"
        "        for (var j = 0; j < v.length; ++j) out.push(v[j]);\n"
        "      } else {\n"
        "        out.push(v);\n"
        "      }\n"
        "    }\n"
        "    return out;\n"
        "  });\n"
        "  defineIfMissing(AP, 'reverse', function() {\n"
        "    var i = 0, j = this.length - 1;\n"
        "    while (i < j) {\n"
        "      var t = this[i]; this[i] = this[j]; this[j] = t;\n"
        "      i = i + 1; j = j - 1;\n"
        "    }\n"
        "    return this;\n"
        "  });\n"
        "  defineIfMissing(AP, 'sort', function(cmp) {\n"
        "    // Simple in-place quicksort. cmp defaults to lexicographic.\n"
        "    var defaultCmp = function(a, b) {\n"
        "      if (a === undefined) return b === undefined ? 0 : 1;\n"
        "      if (b === undefined) return -1;\n"
        "      var sa = String(a), sb = String(b);\n"
        "      return sa < sb ? -1 : sa > sb ? 1 : 0;\n"
        "    };\n"
        "    var c = cmp || defaultCmp;\n"
        "    var arr = this;\n"
        "    var qs = function(lo, hi) {\n"
        "      if (lo >= hi) return;\n"
        "      var pivot = arr[(lo + hi) >> 1];\n"
        "      var i = lo, j = hi;\n"
        "      while (i <= j) {\n"
        "        while (c(arr[i], pivot) < 0) i++;\n"
        "        while (c(arr[j], pivot) > 0) j--;\n"
        "        if (i <= j) {\n"
        "          var t = arr[i]; arr[i] = arr[j]; arr[j] = t;\n"
        "          i++; j--;\n"
        "        }\n"
        "      }\n"
        "      qs(lo, j); qs(i, hi);\n"
        "    };\n"
        "    qs(0, this.length - 1);\n"
        "    return this;\n"
        "  });\n"
        "  defineIfMissing(AP, 'splice', function(start, deleteCount) {\n"
        "    var len = this.length;\n"
        "    var s = start | 0;\n"
        "    if (s < 0) s = Math.max(0, len + s);\n"
        "    else s = Math.min(s, len);\n"
        "    var dc;\n"
        "    if (arguments.length < 2) dc = len - s;\n"
        "    else dc = Math.max(0, Math.min(deleteCount | 0, len - s));\n"
        "    // Extract removed.\n"
        "    var removed = [];\n"
        "    for (var i = 0; i < dc; ++i) removed.push(this[s + i]);\n"
        "    // Items to insert.\n"
        "    var nIns = arguments.length > 2 ? arguments.length - 2 : 0;\n"
        "    // Shift.\n"
        "    var diff = nIns - dc;\n"
        "    if (diff > 0) {\n"
        "      for (var i = len - 1; i >= s + dc; --i) this[i + diff] = this[i];\n"
        "    } else if (diff < 0) {\n"
        "      for (var i = s + dc; i < len; ++i) this[i + diff] = this[i];\n"
        "      this.length = len + diff;\n"
        "    }\n"
        "    for (var i = 0; i < nIns; ++i) this[s + i] = arguments[i + 2];\n"
        "    if (diff > 0) this.length = len + diff;\n"
        "    return removed;\n"
        "  });\n"
        "\n"
        "  // Array statics.\n"
        "  if (typeof Array.from !== 'function') {\n"
        "    Array.from = function(iterable, mapFn, thisArg) {\n"
        "      if (iterable == null) throw new TypeError('Array.from requires an iterable');\n"
        "      var out = [];\n"
        "      if (typeof iterable.length === 'number') {\n"
        "        for (var i = 0; i < iterable.length; ++i) {\n"
        "          var v = iterable[i];\n"
        "          out.push(mapFn ? mapFn.call(thisArg, v, i) : v);\n"
        "        }\n"
        "        return out;\n"
        "      }\n"
        "      // Iterable protocol.\n"
        "      var iter = iterable[Symbol.iterator] && iterable[Symbol.iterator]();\n"
        "      if (!iter) throw new TypeError('object is not iterable');\n"
        "      var step, idx = 0;\n"
        "      while (!(step = iter.next()).done) {\n"
        "        out.push(mapFn ? mapFn.call(thisArg, step.value, idx) : step.value);\n"
        "        idx = idx + 1;\n"
        "      }\n"
        "      return out;\n"
        "    };\n"
        "  }\n"
        "  if (typeof Array.of !== 'function') {\n"
        "    Array.of = function() {\n"
        "      var out = [];\n"
        "      for (var i = 0; i < arguments.length; ++i) out.push(arguments[i]);\n"
        "      return out;\n"
        "    };\n"
        "  }\n"
        "})();\n";
}

fn zjs_install_web_polyfills(ctx: ZjsContext*) -> void {
    let src: char* = NULL;
    raw { src = (char*)WEB_POLYFILLS_SOURCE; }
    let r = zjs_eval(ctx, src);
    if ctx.had_error {
        let err = ctx.last_error;
        let name_s: ZjsString* = NULL;
        let msg_s:  ZjsString* = NULL;
        if zjs_is_object(err) != 0 {
            let n = property_get(ctx, err, ctx_intern_string(ctx, (char*)"name", 4));
            let m = property_get(ctx, err, ctx_intern_string(ctx, (char*)"message", 7));
            if zjs_is_string(n) != 0 { name_s = zjs_as_string(n); }
            if zjs_is_string(m) != 0 { msg_s  = zjs_as_string(m); }
        }
        raw {
            fprintf(stderr, "[stdlib] web_polyfills bootstrap failed: %.*s: %.*s\n",
                    name_s ? (int)name_s->length : 7,
                    name_s ? name_s->data : "Unknown",
                    msg_s  ? (int)msg_s->length  : 0,
                    msg_s  ? msg_s->data  : "");
        }
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
    }
}
