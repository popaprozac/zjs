// Bytecode types — emitted by the compiler, consumed by the interpreter.
//
// Uniform 4-byte instruction format: { op:u8, a:u8, b:u8, c:u8 }.
// Operands are reinterpreted per opcode. The encoding favors simplicity
// over density at this stage; Hermes-style packed-struct-per-opcode is
// the direction (see docs/jitless-design-study.md §2-3), and we can
// migrate later — the lookup-by-tag-then-decode pattern is the same.
//
// One `Function` per compiled function. The top-level program is also
// a Function. Each Function owns its bytecode, its constant pool, and
// its register count.

import "./value.zc";
import "std/mem.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
}

enum Op {
    Halt,             // safety net; interpreter never expects to hit this

    // Loads & moves
    LoadConst,        // a=dst, bc=const_idx (u16)
    LoadInt,          // a=dst, bc=imm (i16) — small-int fast path
    LoadUndefined,    // a=dst
    LoadHole,         // a=dst — zjs_deleted sentinel for array elision slots
    LoadNull,         // a=dst
    LoadTrue,         // a=dst
    LoadFalse,        // a=dst
    Mov,              // a=dst, b=src

    // Globals (program-scope variables)
    DefineGlobal,     // a=src, bc=slot (u16)   — initialize globals[slot] = regs[a]
    LoadGlobal,       // a=dst, bc=slot (u16)  — throws ReferenceError if undeclared
    StoreGlobal,      // a=src, bc=slot (u16)  — also defines the global (sloppy semantics)
    LoadGlobalOrUndefined,  // a=dst, bc=slot (u16) — typeof's special-case load: undefined if undeclared

    // Binary arithmetic
    Add, Sub, Mul, Div, Mod, Pow,

    // Fused arithmetic-with-immediate (Phase 3.9g). Hot path: int32 +/-
    // small constant. Folds LoadInt + Add/Sub into a single dispatch.
    // c is the immediate, reinterpreted as i8 (range -128..127). The
    // interpreter still falls through to general numeric coercion if
    // the source register isn't int32.
    AddImm,           // a=dst, b=src_reg, c=imm (i8)
    SubImm,           // a=dst, b=src_reg, c=imm (i8)

    // Fused comparison-with-immediate. RHS-only (LHS-imm version is
    // ambiguous under ToPrimitive when LHS could be an object). Same
    // i8 immediate range as AddImm/SubImm. Falls through to general
    // comparison if the source reg isn't int32.
    CmpLtImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    CmpLeImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    CmpGtImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    CmpGeImm,         // a=dst (bool), b=src_reg, c=imm (i8)
    BitAnd, BitOr, BitXor,
    Shl, Shr, UShr,

    // Comparison — prefix with Cmp to avoid collisions with TokenKind
    // variants of the same name (Zen-c codegen merges variant symbols
    // across enums in the same TU). See reference_zen-c.md gotcha #11.
    CmpEq, CmpNe, CmpStrictEq, CmpStrictNe,
    CmpLt, CmpLe, CmpGt, CmpGe,

    // Unary
    Neg, BitNot, LogicalNot,

    // Control flow
    Jmp,              // bc = signed offset in instructions
    JmpIfTrue,        // a=src, bc=offset
    JmpIfFalse,       // a=src, bc=offset
    JmpIfNotNullish,  // a=src, bc=offset — used by ??; jumps when src
                      // is anything other than null or undefined.

    // Fused compare-and-branch — collapses Cmp + JmpIfFalse (the
    // standard while/for/if loop-exit shape) into a single dispatch.
    // Two-instruction encoding: the op carries the operands (a=lhs,
    // b=rhs reg OR i8 imm), and the next instruction's bc bytes hold
    // the i16 branch offset (relative to inst[J+2], same convention
    // as a plain Jmp at J+1). Branches when the comparison is *false*.
    // Falls through to the spec ToPrimitive-then-numeric path when
    // operands aren't both int32 (same shape as CmpLtImm fast paths).
    JmpIfNotLt,       // a=lhs_reg, b=rhs_reg ; next.bc = i16 offset
    JmpIfNotLe,
    JmpIfNotGt,
    JmpIfNotGe,
    JmpIfNotLtImm,    // a=lhs_reg, b=imm_i8 ; next.bc = i16 offset
    JmpIfNotLeImm,
    JmpIfNotGtImm,
    JmpIfNotGeImm,

    // Universal return — exits interpret() with regs[a] as the value.
    Return,

    // Function call. a=dst, b=base, c=arg_count.
    // Convention: regs[base] holds the callee; args are in regs[base+1
    // ..base+arg_count]. Result is written to regs[dst]; dst can be
    // the same as base (the caller's "result reg" reuses the callee
    // slot, which is what the compiler does by default).
    //
    // Named `Invoke` (not `Call`) to avoid the cross-enum-variant
    // collision with NodeKind::Call. Zen-c codegen merges variant
    // symbols across enums in the same TU — see reference_zen-c.md.
    Invoke,

    // Phase 3.9h-C — tail-call optimization. Encoded like Invoke but
    // the caller's CallFrame is REPLACED in-place rather than a new
    // frame pushed: the callee returns directly to *our* original
    // caller. Used when a function ends with `return f(...)` with no
    // pending finallies. inst.a is unused (the return_dst comes from
    // the current frame's stored value).
    TailInvoke,       // b=base, c=arg_count

    // Inline-cached property access (Phase 3.2b).
    // ic_slot indexes into f.ics[] — a per-Function side-table of
    // {atom_name, last-seen HiddenClass, slot} entries patched in
    // place on cache miss. Fast path: pointer-compare the cached
    // class against obj.cls, then indexed slots[] read or write.
    LoadProp,         // a=dst, b=obj_reg, c=ic_slot (u8)
    StoreProp,        // a=obj_reg, b=ic_slot (u8), c=val_reg

    // Iteration setup (Phase 3.4).
    //
    // IterPrepare normalizes the iterable into a plain array of items
    // to walk. `kind` selects the iteration mode:
    //   0 = for-in  — collect own enumerable string keys
    //   1 = for-of  — collect element values (string → char strings)
    // The result is an array; the loop walks 0..length with regular
    // LoadElem + ArrayLength.
    IterPrepare,      // a=dst, b=src, c=kind

    // Direct array.length read — bypasses property_get for the
    // for-in/of loop bound. Returns 0 for non-arrays.
    ArrayLength,      // a=dst, b=src

    // `delete obj[key]` / `delete obj.name` (Phase 3.9c).
    // Marks the slot DELETED (sentinel value), so subsequent lookups
    // walk the proto chain as if the property is absent. Returns
    // boolean to regs[a] (always true in MVP — no non-configurable
    // enforcement yet).
    DeleteElem,       // a=dst (bool), b=obj_reg, c=key_reg

    // `arguments` (Phase 3.8e).
    // Emitted at function entry when the body references `arguments`.
    // Builds a fresh array containing all call args and stores it in
    // regs[a]. Reads interp()'s `args` + `arg_count` parameters.
    BuildArguments,   // a=dst

    // Method calls (Phase 3.5).
    // Same encoding shape as Invoke, but regs[base+1] is the receiver
    // (`this`) and explicit JS args start at regs[base+2]. arg_count
    // counts only the explicit args. Used whenever the source is a
    // member-expression call like `obj.method(args)`. Host functions
    // see the receiver via ctx.host_this; user Function/Closure callees
    // ignore it (no `this` binding for user functions yet).
    MethodInvoke,     // a=dst, b=base, c=arg_count

    // Tail variant of MethodInvoke; same semantics as TailInvoke but
    // also sets ctx.host_this = regs[base+1] for the duration of the
    // callee's execution.
    TailMethodInvoke, // b=base, c=arg_count

    // Closures (Phase 3.3).
    // Object-literal accessor shorthand (`{ get foo() {}, set foo(v) {} }`).
    // Installs / merges a ZjsAccessor cell at obj[name].
    //   a = obj_reg
    //   b = name_const_reg (LoadConst loaded the atom-ZjsValue here)
    //   c = fn_reg
    DefineGetter,
    DefineSetter,
    // 2026-05-15: class get/set accessors. Same shape as DefineGetter
    // /Setter but installs the property as non-enumerable per spec.
    DefineMethodGetter,
    DefineMethodSetter,

    MakeClosure,      // a=dst, b=fn_reg, c=env_reg
                      //   wraps regs[b] (a function value) with regs[c] (an env object)
                      //   into a fresh closure cell.
    LoadEnv,          // a=dst
                      //   dst = current closure's env (or undefined if no closure).

    // Heap-cell creation + access (Phase 3.1b).
    NewRegex,         // a=dst, b=src_const_idx, c=flags_const_idx.
                      // Builds a fresh RegExp from two constant-pool
                      // strings (JS source between the slashes and the
                      // raw flag letters). Each evaluation creates a new
                      // instance so .lastIndex is independent.
    NewObject,        // a=dst. Creates an empty {} object.
    NewArray,         // a=dst, b=base, c=count.
                      // Builds an array containing regs[base..base+count).
                      // Safe even if dst==base — the interpreter copies
                      // elements out before writing dst.
    LoadElem,         // a=dst, b=obj_reg, c=key_reg.
                      // dst = obj[key]. For arrays: numeric/numeric-string
                      // index, or special-case "length". For objects:
                      // ToString(key), linear prop lookup.
    StoreElem,        // a=obj_reg, b=key_reg, c=val_reg.
                      // obj[key] = val. Auto-grows arrays.

    // Exceptions (Phase 3.1c).
    Throw,            // a=src. Raises regs[src] as the thrown value.
    EnterTry,         // a=catch_reg, bc=offset (i16).
                      // Push a try frame. On throw, ip jumps to
                      // (this_inst + 1 + offset) and regs[catch_reg]
                      // receives the thrown value.
    LeaveTry,         // No operands. Pop the innermost try frame.
                      // Emitted at the normal end of a try block.

    // Prototype chain + new (Phase 3.6).
    //
    // `In b in c` checks if regs[b] is a key of regs[c] (string key on
    // an object; integer index on an array). Returns boolean.
    //
    // `Instanceof b instanceof c` checks regs[c].prototype is in
    // regs[b]'s proto chain.
    //
    // `LoadThis` reads ctx.host_this (the implicit `this`).
    //
    // `NewInvoke` is like Invoke but:
    //   - allocates a fresh object whose proto is callee.prototype
    //   - calls callee with that object bound as `this`
    //   - if callee returns an object, uses that; else uses the new obj
    In,               // a=dst, b=key_reg, c=obj_reg
    Instanceof,       // a=dst, b=val_reg, c=ctor_reg
    LoadThis,         // a=dst
    NewInvoke,        // a=dst, b=base, c=arg_count

    // Type introspection (Phase 3.1e).
    Typeof,           // a=dst, b=src.
    // Class machinery (2026-05-15).
    // SetProto: assign regs[b]'s prototype to be regs[a].
    //   regs[a] must be an Object (typically a constructor's
    //   .prototype); regs[b] must be an Object too. Used by the
    //   class-extends path to wire Child.prototype.[[Prototype]] =
    //   Parent.prototype after the methods are attached.
    SetProto,         // a=proto, b=obj.
    // SuperCall: call regs[b] (the parent constructor) with the
    //   current ctx.host_this and ctx.new_target_active preserved,
    //   args at regs[b+1 .. b+c]. Used to compile super(...) in a
    //   derived-class constructor. Unlike Op::Invoke this DOES NOT
    //   reset host_this to undefined/global.
    SuperCall,        // a=dst, b=base, c=argc.
    // DefineMethod: like StoreProp but the resulting slot's attrs
    //   are (writable + configurable, NOT enumerable). Used by
    //   class method definitions which spec-mandate non-enumerable.
    DefineMethod,     // a=obj, b=ic_slot, c=val_reg.
    // SetParentCtor: record regs[b] (the parent constructor) on
    //   the Function* in regs[a]. Used by class-extends so
    //   Object.getPrototypeOf(Child) returns Parent.
    SetParentCtor,    // a=ctor, b=parent.
                      // dst = a string from ECMA-262 §13.5.3
                      // (one of: "undefined" "object" "boolean"
                      // "number" "string" "function").
}

struct Inst {
    op: Op;
    a:  u8;
    b:  u8;
    c:  u8;
}

impl Copy for Inst {}

// --- Operand encode / decode ----------------------------------------

fn inst_bc_u16(i: Inst) -> u16 {
    return (u16)i.b | ((u16)i.c << 8);
}

fn inst_bc_i16(i: Inst) -> i32 {
    // Sign-extend the 16-bit operand into a wider signed type so callers
    // can do arithmetic on it cleanly. Zen-c doesn't expose an explicit
    // i16 sign-extension cast, so we do it via shift.
    let v = (u32)((u32)i.b | ((u32)i.c << 8));
    if v & 0x8000 != 0 { return (i32)(v | 0xffff0000); }
    return (i32)v;
}

fn make_inst_a(op: Op, a: u8) -> Inst {
    return Inst{op: op, a: a, b: 0, c: 0};
}

fn make_inst_ab(op: Op, a: u8, b: u8) -> Inst {
    return Inst{op: op, a: a, b: b, c: 0};
}

fn make_inst_abc(op: Op, a: u8, b: u8, c: u8) -> Inst {
    return Inst{op: op, a: a, b: b, c: c};
}

fn make_inst_a_u16(op: Op, a: u8, v: u16) -> Inst {
    return Inst{op: op, a: a, b: (u8)(v & 0xff), c: (u8)((v >> 8) & 0xff)};
}

fn make_inst_a_i16(op: Op, a: u8, v: i32) -> Inst {
    let u: u16 = (u16)((u32)v & 0xffff);
    return Inst{op: op, a: a, b: (u8)(u & 0xff), c: (u8)((u >> 8) & 0xff)};
}

fn make_inst_u16(op: Op, v: u16) -> Inst {
    return Inst{op: op, a: 0, b: (u8)(v & 0xff), c: (u8)((v >> 8) & 0xff)};
}

fn make_inst_i16(op: Op, v: i32) -> Inst {
    let u: u16 = (u16)((u32)v & 0xffff);
    return Inst{op: op, a: 0, b: (u8)(u & 0xff), c: (u8)((u >> 8) & 0xff)};
}

// --- Function ----------------------------------------------------
//
// A compiled function. For Phase 3.0a there's only ever one — the
// top-level "program" function. Phase 3.0b adds first-class user
// functions and stores them on the context.

// Inline-cache entry. Allocated per LoadProp/StoreProp site at
// compile time; cold (all classes NULL) until the first execution
// warms it.
//
// Phase 3.9f: polymorphic — caches up to IC_POLY_SIZE distinct
// (class, slot) pairs. Fast path linearly probes classes[0..count].
// When all slots are full and a new shape appears, the entry flips
// to `megamorphic` and the fast path is skipped from then on.
//
// The class_ pointers are WEAK refs (see gc_nullify_dead_ics): if
// the cached class is unreachable, we null it out during sweep.
def IC_POLY_SIZE: u32 = 4;

struct ICEntry {
    name:        ZjsString*;            // atom; set at compile time, immutable
    classes:     ZjsHiddenClass*[4];    // cached shapes (NULL = empty slot)
    slots:       u32[4];                // slot index per cached class
    entry_count: u8;                    // # of populated entries (0..IC_POLY_SIZE)
    megamorphic: bool;                  // once set, fast-path is skipped permanently
}

// Kept for compile-time clarity; once we have IC_POLY_SIZE entries and
// still miss, we go megamorphic immediately (no separate miss-count
// threshold needed — the polymorphic cache absorbs ordinary churn).
def IC_MEGAMORPHIC_LIMIT: u32 = IC_POLY_SIZE;

struct Function {
    header:         CellHeader; // { type_tag = TAG_FUNCTION } — must be first field
    code:           Inst*;     // bytecode (heap-allocated)
    code_len:       usize;
    constants:      ZjsValue*; // constant pool
    const_count:    u32;
    register_count: u32;       // size of the register file the interpreter must allocate
    param_count:    u32;       // 0 for the top-level program

    // Inline-cache table for LoadProp / StoreProp (Phase 3.2b).
    ics:            ICEntry*;
    ic_count:       u32;

    // Closures (Phase 3.3). `needs_env` means this function should
    // allocate an env object at entry — it has nested functions that
    // capture its locals. `env_reg` is where that env lives. The
    // captured-names list drives the inner function's outer-name
    // resolution.
    needs_env:      bool;
    env_reg:        u8;

    // Phase 3.6: `.prototype` for instanceof + constructor-style use.
    // Lazy — first read auto-creates an empty object.
    prototype:      ZjsObject*;

    // Expando bag for arbitrary properties (`fn.foo = 1`). Lazy — NULL
    // until the first non-`prototype` string-keyed property is set.
    // Matches ZjsHostFunction.props in shape and lifetime; the
    // property_get / property_set / Op::In paths route through this
    // before falling back to Object.prototype.
    props:          ZjsObject*;

    // 2026-05-15 — set when this Function was emitted as a class
    // constructor. Op::Invoke / Op::MethodInvoke throw TypeError when
    // called without `new` (NewInvoke clears the flag's effect via
    // new_target_active).
    is_class_constructor: bool;
    // Class method / accessor — distinct from a constructor in that
    // it has no .prototype property and is not constructible. Read
    // by `is_proto` and the constructibility checks.
    is_method: bool;
    // For `class Child extends Parent { ... }`: holds the parent
    // constructor so Object.getPrototypeOf(Child) === Parent. Plain
    // (non-extended) classes leave this undefined. Marked at class-
    // create time on the Function*.
    parent_ctor:          ZjsValue;
    // Synthesized default constructor for `class Child extends
    // Parent {}`. Op::NewInvoke detects this and forwards its args
    // directly to parent_ctor instead of interpreting an empty body.
    is_default_derived_ctor: bool;
}

fn function_new() -> Function* {
    // zalloc so prototype / props / needs_env etc. start cleanly zeroed.
    // Several lookups check `f.prototype == NULL` / `f.props == NULL`
    // as the lazy-create gate — relying on garbage there would be a
    // very subtle bug.
    let f = zalloc<Function>();
    f.header.type_tag = TAG_FUNCTION;
    f.parent_ctor = zjs_undefined();
    return f;
}

fn function_free(f: Function*) -> void {
    if f == NULL { return; }
    dealloc(f.code);
    dealloc(f.constants);
    dealloc(f.ics);
    dealloc(f);
}

// C-callable wrapper so context.zc can free functions without depending
// on bytecode.zc's import path. The forward declaration lives inside
// context.zc's `zjs_free_context` raw block.
fn function_free_void(p: void*) -> void {
    let f: Function* = NULL;
    raw { f = (Function*)p; }
    function_free(f);
}
