// AST — emitted by the parser, consumed by the bytecode compiler (Phase 3).
//
// Flat tagged struct: one universal AstNode shape with every possible
// field. Only the fields relevant to each kind are meaningful. Trades
// memory for simplicity; the AST is transient (lifetime = one compile).
//
// All allocations are tracked on the owning Parser's free-list so the
// caller can release the whole tree with one parser_free_result call.

import "./token.zc";
import "std/mem.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
}

enum NodeKind {
    // Root
    Program,                // children = expression-statements

    // Atoms — *Expr suffix to avoid name collisions with TokenKind
    // variants like NumberLit/StringLit/Identifier (Zen-c codegen
    // gets confused if two enums in the same TU share variant names).
    NumberExpr,             // num
    StringExpr,             // (start..end is the slice including quotes)
    BoolExpr,               // bool_value
    NullExpr,
    UndefinedExpr,
    HoleExpr,               // array-literal elision (`,` slot) — distinct
                            //   from explicit `undefined` so the slot can
                            //   be recorded as a hole (zjs_deleted)
                            //   rather than a real undefined value.
    ThisExpr,
    IdentExpr,              // (start..end is the identifier text)
    RegexExpr,              // (start..end is the full /pattern/flags slice)

    // Operators
    Binary,                 // op, left, right
    Logical,                // op (&&, ||, ??), left, right
    Unary,                  // op (prefix), left = operand
    Postfix,                // op (++ or --), left = operand
    Conditional,            // left = test, right = consequent, third = alternate
    Assignment,             // op, left = target, right = value

    // Access
    Call,                   // left = callee, children = args
    OptionalCall,           // left = callee, children = args (?.())
    New,                    // left = callee, children = args (may be empty)
    Member,                 // left = object, name_start/length = property name
    OptionalMember,         // left = object, name_start/length (?.name)
    Computed,               // left = object, right = property expression (a[expr])
    OptionalComputed,       // left = object, right = property expression (a?.[expr])

    // Aggregates
    Sequence,               // children = a, b, c
    Array,                  // children = elements
    Object,                 // children = ObjectProp nodes
    ObjectProp,             // name_start/length = key, left = value
    Paren,                  // left = inner (mostly for debugging clarity)

    // Statements (Phase 2.4)
    BlockStmt,              // children = stmts
    VarDecl,                // op = KwVar | KwLet | KwConst, children = Declarators
    Declarator,             // name_start/length, left = init (NULL if absent)
    IfStmt,                 // left = test, right = then, third = else (NULL)
    ReturnStmt,             // left = argument (NULL for bare return)
    WhileStmt,              // left = test, right = body
    DoWhileStmt,            // left = body, right = test
    ForStmt,                // left = init, right = test, third = update,
                            // children[0] = body
    BreakStmt,              // name_start/length = target label name (0/0 = unlabeled)
    ContinueStmt,           // name_start/length = target label name (0/0 = unlabeled)
    EmptyStmt,
    LabeledStmt,            // name_start/length = label name, left = labeled statement

    // Functions + iteration (Phase 2.5)
    FunctionDecl,           // name_start/length, children=params, left=body (BlockStmt)
    FunctionExpr,           // name_start/length (0 if anon), children=params, left=body
    ArrowFunc,              // children=params, left=body (BlockStmt or expression)
    ForInStmt,              // left=binding, right=iterable, children[0]=body
    ForOfStmt,              // same shape as ForInStmt

    // Exceptions (Phase 3.1c)
    ThrowStmt,              // left = thrown value expression
    TryStmt,                // left = try-block, right = catch-block,
                            // name_start/length = catch param name (0 if absent)

    // Classes (Phase 3.7)
    ClassDecl,              // name_start/length = class name, children = MethodDefs
                            // (the constructor, if any, is one of the children
                            // — distinguished by its method name being "constructor")
                            // right = parent expression for `extends Parent` (or NULL)
    ClassExpr,              // same shape as ClassDecl but used in expression position
    MethodDef,              // name_start/length = method name, children = params,
                            // left = body (BlockStmt). bool_value = true for `static`.
    SuperExpr,              // bare `super` reference; used in SuperCall (parent fn
                            // contextual lookup) and SuperMember (left = property name).
    SuperCall,              // children = args. Implicit ctor lookup.

    // Function-parameter shapes (2026-05-15).
    // Plain bindings stay as IdentExpr with `right` carrying the default
    // initializer (or NULL if none); RestParam wraps the binding for
    // `...name` and is always the LAST entry in the params list.
    RestParam,              // left = IdentExpr (the rest binding)
    // Spread in argument lists, array literals, and object literals
    // — `...expr`. Compiler expands the inner iterable at call/build
    // time. left = the expression being spread.
    Spread,

    // async/await (2026-05-15).
    // FunctionDecl/FunctionExpr/ArrowFunc reuse bool_value = true to
    // mark themselves as `async function`. AwaitExpr is the `await x`
    // operator — left = the awaited expression.
    AwaitExpr,

    // ES modules (2026-05-15).
    //   ImportDecl: children = ImportClause* (Default/Named/Namespace
    //               specifiers), name_start/length = string-literal slice
    //               of the source path (incl. quotes). bool_value
    //               currently unused.
    //   ImportClause:
    //     - op == TokenKind::KwDefault: default import, name = local binding
    //     - op == TokenKind::Star:      namespace import, name = local
    //     - op == TokenKind::Eq:        named import; name = local binding,
    //                                   third->name_* = source export name
    //                                   (left field may be NULL when local
    //                                   matches export name)
    //   ExportDecl: top-level export
    //     - left:  declaration being exported (VarDecl / FunctionDecl /
    //              ClassDecl) when this is `export <decl>`; NULL for
    //              `export { ... }` / `export default expr` shapes
    //     - children: list of ExportClause nodes for `export { ... }`
    //     - bool_value = true for `export default`
    //     - When default: left = the expression being exported
    //     - name_start/length: source-specifier for `export { ... } from "x"`
    //   ExportClause: a single `{ local as export }` entry
    //     - name_start/length: the local name being exported
    //     - third->name_*: the exported-as name (same as local when omitted)
    ImportDecl,
    ImportClause,
    ExportDecl,
    ExportClause,
}

struct AstNode {
    kind:           NodeKind;
    start:          u32;
    end:            u32;

    op:             TokenKind;
    num:            f64;
    bool_value:     bool;

    left:           AstNode*;
    right:          AstNode*;
    third:          AstNode*;

    children:       AstNode**;
    children_count: u32;

    name_start:     u32;
    name_length:    u32;
}

// --- Allocation tracking --------------------------------------------
//
// Every node and every children-array allocated by the parser is
// registered in an AllocList. parser_free_result walks the list and
// releases everything in one shot.

struct AllocList {
    items: void**;
    count: usize;
    cap:   usize;
}

fn alloc_list_new() -> AllocList {
    return AllocList{ items: NULL, count: 0, cap: 0 };
}

fn alloc_list_push(list: AllocList*, ptr: void*) -> void {
    if list.count >= list.cap {
        let new_cap: usize = if list.cap == 0 { 16 } else { list.cap * 2 };
        list.items = realloc_n<void*>(list.items, list.cap, new_cap);
        list.cap = new_cap;
    }
    list.items[list.count] = ptr;
    list.count = list.count + 1;
}

fn alloc_list_free_all(list: AllocList*) -> void {
    let i: usize = 0;
    while i < list.count {
        dealloc(list.items[i]);
        i = i + 1;
    }
    dealloc(list.items);
    list.items = NULL;
    list.count = 0;
    list.cap = 0;
}

// --- Node factory ---------------------------------------------------
//
// Allocates a zero-initialized node and registers it on `tracker`.
// Subsequent fields are filled in by the parser after this returns.

fn new_node(tracker: AllocList*, kind: NodeKind, start: u32, end: u32) -> AstNode* {
    let node = alloc<AstNode>();
    node.kind = kind;
    node.start = start;
    node.end = end;
    alloc_list_push(tracker, (void*)node);
    return node;
}

// Allocates a children array of the requested size. Caller fills it.
fn new_children(tracker: AllocList*, count: u32) -> AstNode** {
    if count == 0 { return NULL; }
    let arr = alloc_n<AstNode*>((usize)count);
    alloc_list_push(tracker, (void*)arr);
    return arr;
}
