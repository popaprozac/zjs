// Parser — recursive descent over the ECMA-262 expression grammar.
//
// One Parser instance owns one parse. After parse_program returns, the
// caller must hold onto the ParseResult and eventually call
// parser_free_result to release every node and children-array the
// parser allocated.

import "./token.zc";
import "./lexer.zc";
import "./ast.zc";
import "std/mem.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
}

// --- Token buffer ---------------------------------------------------
//
// For Phase 2.3 we lex the whole source into a vector up front and
// then drive a cursor over it. This makes lookahead trivial (peek_at).
// Lazy lexing can come later if it ever shows up in a profile.

def MAX_TOKENS: usize = 65536;

struct Parser {
    source:        char*;
    source_len:    usize;
    tokens:        Token*;       // heap-allocated buffer
    token_count:   usize;
    pos:           usize;
    tracker:       AllocList;
    had_error:     bool;
    // ECMA-262 "[NoIn]" parameter: when true, parse_relational won't
    // consume `in` as a binary operator. Set by parse_for around its
    // init slot so that `for (x in obj)` doesn't get eaten as
    // `for ((x in obj))`.
    no_in:         bool;
    // Depth of enclosing function bodies — incremented on entry to a
    // function / method body, decremented on exit. Top-level
    // (function_depth == 0) bare `return` is a SyntaxError.
    function_depth: u32;
    // ECMA-262 [+Await] grammar parameter: true inside an `async`
    // function body. Gates the `await` operator (treated as an
    // identifier otherwise to preserve sloppy-mode names).
    in_async: bool;
    // Module-source flag. When true, `import` / `export` at top
    // level parse as ESM declarations; when false they're contextual
    // identifiers per script grammar.
    is_module: bool;
    // ECMA-262 [+Yield] grammar parameter: true inside a generator
    // body. Gates the `yield` operator (otherwise a contextual ident).
    in_generator: bool;
    // Strict-mode flag. Toggled true for class bodies, modules, and
    // "use strict" directive scopes (only class bodies + modules
    // tracked today). Strict mode forbids `arguments` and `eval` as
    // BindingIdentifier names, treats `yield` as always-reserved, and
    // makes duplicate parameter names a SyntaxError.
    strict_mode: bool;
    // True only inside the constructor body of a derived class (one
    // that has `extends ...`). Gates `super(...)` — anywhere else
    // SuperCall is a parse-time SyntaxError per ECMA-262 §15.7.1.
    in_derived_constructor: bool;
}

// Returns true if a name string is "arguments" or "eval" — the two
// names that strict mode forbids as BindingIdentifier. Doesn't take
// the Parser because callers vary in how they get the name slice.
fn name_is_arguments_or_eval(source: char*, start: u32, length: u32) -> bool {
    if length == 9 {
        let p1 = source + start;
        let eq: int = 0;
        raw { eq = (memcmp(p1, "arguments", 9) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    if length == 4 {
        let p2 = source + start;
        let eq: int = 0;
        raw { eq = (memcmp(p2, "eval", 4) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    return false;
}

struct ParseResult {
    root:          AstNode*;
    parser:        Parser*;
    had_error:     bool;
}

// --- Top-level entry ------------------------------------------------

// Parse the source as an ES module — same shape as parse_program but
// flags the Parser so top-level import/export are valid.
fn parse_module(source: char*, source_len: usize) -> ParseResult {
    let result = parse_program_with(source, source_len, true);
    return result;
}

fn parse_program(source: char*, source_len: usize) -> ParseResult {
    return parse_program_with(source, source_len, false);
}

fn parse_program_with(source: char*, source_len: usize, is_module: bool) -> ParseResult {
    let p = alloc<Parser>();
    p.source = source;
    p.source_len = source_len;
    p.tracker = alloc_list_new();
    p.had_error = false;
    p.in_async = false;
    p.in_generator = false;
    p.is_module = is_module;

    // Lex everything into a buffer.
    p.tokens = alloc_n<Token>(MAX_TOKENS);
    p.token_count = tokenize_into(source, source_len, p.tokens, MAX_TOKENS);
    p.pos = 0;

    // Parse a sequence of expression statements terminated by `;` or EOF.
    let program = new_node(&p.tracker, NodeKind::Program, 0, (u32)source_len);
    // bool_value = true marks a module program so the compiler treats
    // top-level declarations as module-scoped locals (not globals).
    program.bool_value = is_module;

    // Reserve a temporary children buffer on the parser's tracker.
    // We don't know the exact count up front, so grow into a Vec-style
    // pattern as we go.
    let cap: u32 = 8;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::Eof && !p.had_error {
        let stmt = parse_statement(p);
        if stmt == NULL { break; }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = stmt;
        count = count + 1;
    }

    // Register the final buffer with the tracker and copy into the node.
    alloc_list_push(&p.tracker, (void*)buf);
    program.children = buf;
    program.children_count = count;

    return ParseResult{ root: program, parser: p, had_error: p.had_error };
}

fn parser_free_result(r: ParseResult) -> void {
    alloc_list_free_all(&r.parser.tracker);
    dealloc(r.parser.tokens);
    dealloc(r.parser);
}

// --- Cursor primitives ----------------------------------------------

fn peek(p: Parser*) -> Token {
    if p.pos >= p.token_count {
        // Synthetic Eof beyond the buffer.
        return token_eof((u32)p.source_len);
    }
    return p.tokens[p.pos];
}

// Look ahead one token without consuming. Used by labeled-statement
// detection (`ident :`) where a one-token peek isn't enough.
fn peek_kind2(p: Parser*) -> TokenKind {
    if p.pos + 1 >= p.token_count {
        return TokenKind::Eof;
    }
    return p.tokens[p.pos + 1].kind;
}

// Is there a newline between two source offsets? Used for the
// `break` / `continue` label rule — the optional label must be on
// the SAME source line as the keyword (ASI inserts a `;` otherwise).
fn has_newline_between(p: Parser*, a: u32, b: u32) -> bool {
    let i = a;
    while i < b {
        let c = p.source[i];
        if (u8)c == 10 || (u8)c == 13 { return true; }
        i = i + 1;
    }
    return false;
}

fn peek_kind(p: Parser*) -> TokenKind {
    return peek(p).kind;
}

fn peek_at(p: Parser*, offset: usize) -> Token {
    let i = p.pos + offset;
    if i >= p.token_count {
        return token_eof((u32)p.source_len);
    }
    return p.tokens[i];
}

fn advance(p: Parser*) -> Token {
    let t = peek(p);
    if p.pos < p.token_count { p.pos = p.pos + 1; }
    return t;
}

fn match_kind(p: Parser*, k: TokenKind) -> bool {
    if peek_kind(p) != k { return false; }
    advance(p);
    return true;
}

fn expect_kind(p: Parser*, k: TokenKind) -> bool {
    if peek_kind(p) != k {
        p.had_error = true;
        return false;
    }
    advance(p);
    return true;
}

// Lenient statement terminator. Consumes `;` if present; tolerates a
// missing `;` before `}` or EOF (a stand-in for real ASI, which we
// can't do yet because the lexer doesn't track newline positions).
fn match_terminator(p: Parser*) -> void {
    if peek_kind(p) == TokenKind::Semicolon { advance(p); return; }
    // No-op for EOF / RBrace. Anything else slips through too — a real
    // ASI implementation would check newline-before-token here.
}

// =====================================================================
// Statement parsing. Dispatches on the leading token.
// =====================================================================

fn parse_statement(p: Parser*) -> AstNode* {
    let k = peek_kind(p);

    if k == TokenKind::LBrace      { return parse_block(p); }
    if k == TokenKind::KwVar       { return parse_var_decl(p, true); }
    if k == TokenKind::KwLet       { return parse_var_decl(p, true); }
    if k == TokenKind::KwConst     { return parse_var_decl(p, true); }
    if k == TokenKind::KwFunction  { return parse_function_decl(p, false); }
    // `async function f() { ... }` — function declaration with the
    // is_async marker. ASI consideration: ECMA-262 requires no line
    // terminator between `async` and `function` for this to be a
    // declaration; we enforce that.
    if k == TokenKind::KwAsync && peek_kind2(p) == TokenKind::KwFunction {
        advance(p);
        return parse_function_decl(p, true);
    }
    // ES module top-level: import / export. Only valid when parsing
    // module source (p.is_module). Script-mode parses see them as
    // ordinary identifiers (the existing contextual-keyword behavior).
    if p.is_module && k == TokenKind::KwImport { return parse_import_decl(p); }
    if p.is_module && k == TokenKind::KwExport { return parse_export_decl(p); }
    if k == TokenKind::KwClass     { return parse_class_decl(p); }
    if k == TokenKind::KwIf        { return parse_if(p); }
    if k == TokenKind::KwReturn    { return parse_return(p); }
    if k == TokenKind::KwWhile     { return parse_while(p); }
    if k == TokenKind::KwDo        { return parse_do_while(p); }
    if k == TokenKind::KwFor       { return parse_for(p); }
    if k == TokenKind::KwBreak     { return parse_break(p); }
    if k == TokenKind::KwContinue  { return parse_continue(p); }
    if k == TokenKind::KwThrow     { return parse_throw(p); }
    if k == TokenKind::KwTry       { return parse_try(p); }
    if k == TokenKind::KwSwitch    { return parse_switch(p); }
    if k == TokenKind::Semicolon {
        let semi = advance(p);
        return new_node(&p.tracker, NodeKind::EmptyStmt, semi.start, semi.start + semi.length);
    }
    if k == TokenKind::Eof { return NULL; }

    // Labeled statement: `IDENT : statement`. Detected by a 2-token
    // lookahead — Identifier followed by Colon.
    if k == TokenKind::Identifier && peek_kind2(p) == TokenKind::Colon {
        let id = advance(p);     // identifier
        advance(p);              // ':'
        let body = parse_statement(p);
        if body == NULL { return NULL; }
        // Strict-mode: a LabelledStatement's body is a Statement, not
        // a Declaration. `label: function f() {}` and friends are a
        // SyntaxError. (Sloppy-mode Annex B allows function decls, but
        // we're effectively strict everywhere.)
        if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }
        let node = new_node(&p.tracker, NodeKind::LabeledStmt, id.start, body.end);
        node.name_start  = id.start;
        node.name_length = id.length;
        node.left = body;
        return node;
    }

    // Default: expression statement.
    let expr = parse_expression(p);
    if expr == NULL { return NULL; }
    match_terminator(p);
    return expr;
}

fn parse_block(p: Parser*) -> AstNode* {
    let lbrace = advance(p);     // consume '{'

    let cap: u32 = 8;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof && !p.had_error {
        let stmt = parse_statement(p);
        if stmt == NULL { break; }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = stmt;
        count = count + 1;
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RBrace);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::BlockStmt, lbrace.start, close.start + close.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

// `consume_semi` controls whether we consume the trailing `;`. For-init
// uses `false` because the for-loop owns the `;` between init/cond.
// Some keywords are contextual — they're reserved in specific syntactic
// positions but legal identifiers elsewhere. ECMA-262 §13.1: at minimum,
// `of`, `let`, `static`, `async`, `yield`, `await` can be binding
// identifiers in sloppy mode. We accept them broadly; strict-mode tests
// for these would need a separate gate (not implemented yet).
// ECMA-262 §15.1.5: a FormalParameterList is "simple" iff every entry
// is a plain BindingIdentifier without an initializer (no patterns, no
// defaults, no rest). A function whose params aren't simple must NOT
// contain a "use strict" directive — that's a parse-time SyntaxError.
fn params_are_simple(params: ParamList) -> bool {
    let i: u32 = 0;
    while i < params.count {
        let p: AstNode* = params.arr[i];
        if p == NULL                              { return false; }
        if p.kind == NodeKind::RestParam          { return false; }
        if p.kind != NodeKind::IdentExpr          { return false; }
        if p.name_length == 0                     { return false; }   // pattern stub
        if p.right != NULL                        { return false; }   // has default
        i = i + 1;
    }
    return true;
}

// Walk a function's parameter list and flag any duplicate binding
// names. ECMA-262 §15.1.1: non-simple parameter lists may not contain
// duplicate identifiers. (Strict-mode bodies also forbid them, but
// we don't track per-function strict mode yet — non-simple coverage
// is the bulk of the failing tests.)
fn params_have_duplicate(params: ParamList, source: char*) -> bool {
    let i: u32 = 0;
    while i < params.count {
        let pi: AstNode* = params.arr[i];
        let pi_name = pi;
        if pi != NULL && pi.kind == NodeKind::RestParam { pi_name = pi.left; }
        if pi_name == NULL { i = i + 1; continue; }
        if pi_name.kind != NodeKind::IdentExpr || pi_name.name_length == 0 {
            i = i + 1; continue;
        }
        let j: u32 = i + 1;
        while j < params.count {
            let pj: AstNode* = params.arr[j];
            let pj_name = pj;
            if pj != NULL && pj.kind == NodeKind::RestParam { pj_name = pj.left; }
            if pj_name != NULL && pj_name.kind == NodeKind::IdentExpr
               && pj_name.name_length == pi_name.name_length {
                let a = source + pi_name.name_start;
                let b = source + pj_name.name_start;
                let n = pi_name.name_length;
                let eq: int = 0;
                raw { eq = (memcmp(a, b, n) == 0) ? 1 : 0; }
                if eq != 0 { return true; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

// Detect a `"use strict"` directive prologue at the top of a function
// body. Walks past empty-statement noise but does not look past any
// non-string statements (per spec, directives are a prologue that ends
// at the first non-string-literal statement).
fn body_has_use_strict_directive(body: AstNode*, source: char*) -> bool {
    if body == NULL || body.kind != NodeKind::BlockStmt { return false; }
    let i: u32 = 0;
    while i < body.children_count {
        let stmt = body.children[i];
        if stmt == NULL { return false; }
        if stmt.kind != NodeKind::StringExpr { return false; }
        let span = stmt.end - stmt.start;
        if span == 12 {
            let s = source + stmt.start;
            let matches: int = 0;
            raw {
                matches = ((s[0] == '"' || s[0] == '\'')
                           && memcmp(s + 1, "use strict", 10) == 0
                           && s[11] == s[0]) ? 1 : 0;
            }
            if matches != 0 { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn is_binding_ident(k: TokenKind) -> bool {
    if k == TokenKind::Identifier { return true; }
    if k == TokenKind::KwOf       { return true; }
    if k == TokenKind::KwLet      { return true; }
    if k == TokenKind::KwYield    { return true; }
    if k == TokenKind::KwAwait    { return true; }
    if k == TokenKind::KwAsync    { return true; }
    return false;
}

// Spec-strict version: rejects `yield` inside a generator body and
// `await` inside an async function body (both become reserved words
// there). Pass-through to is_binding_ident for everything else. Use
// this at every BindingIdentifier site (var/let/const declarators,
// catch parameter, function params, class field name when treated
// as a binding, import locals, etc.).
fn is_binding_ident_ctx(p: Parser*, k: TokenKind) -> bool {
    if k == TokenKind::KwYield && p.in_generator { return false; }
    if k == TokenKind::KwAwait && p.in_async     { return false; }
    // Strict mode reserves `yield` unconditionally (even outside a
    // generator). Modules + class bodies are implicitly strict.
    if k == TokenKind::KwYield && p.strict_mode  { return false; }
    return is_binding_ident(k);
}

// IdentifierName per ECMA-262 §11.6: identifier OR any reserved
// word. Used wherever the spec allows a keyword as a name —
// PropertyName in object literals, MemberExpression after `.`, etc.
fn is_keyword_token(k: TokenKind) -> bool {
    if k == TokenKind::KwVar || k == TokenKind::KwLet || k == TokenKind::KwConst { return true; }
    if k == TokenKind::KwFunction || k == TokenKind::KwReturn { return true; }
    if k == TokenKind::KwIf || k == TokenKind::KwElse { return true; }
    if k == TokenKind::KwFor || k == TokenKind::KwWhile || k == TokenKind::KwDo { return true; }
    if k == TokenKind::KwBreak || k == TokenKind::KwContinue { return true; }
    if k == TokenKind::KwClass || k == TokenKind::KwExtends || k == TokenKind::KwSuper { return true; }
    if k == TokenKind::KwNew || k == TokenKind::KwThis { return true; }
    if k == TokenKind::KwTrue || k == TokenKind::KwFalse || k == TokenKind::KwNull || k == TokenKind::KwUndefined { return true; }
    if k == TokenKind::KwTypeof || k == TokenKind::KwDelete || k == TokenKind::KwVoid { return true; }
    if k == TokenKind::KwIn || k == TokenKind::KwOf || k == TokenKind::KwInstanceof { return true; }
    if k == TokenKind::KwThrow || k == TokenKind::KwTry || k == TokenKind::KwCatch || k == TokenKind::KwFinally { return true; }
    if k == TokenKind::KwSwitch || k == TokenKind::KwCase || k == TokenKind::KwDefault { return true; }
    if k == TokenKind::KwAsync || k == TokenKind::KwAwait || k == TokenKind::KwYield { return true; }
    if k == TokenKind::KwImport || k == TokenKind::KwExport || k == TokenKind::KwFrom || k == TokenKind::KwAs { return true; }
    return false;
}

fn is_property_name_start(k: TokenKind) -> bool {
    if k == TokenKind::Identifier { return true; }
    if k == TokenKind::StringLit  { return true; }
    if k == TokenKind::NumberLit  { return true; }
    return is_keyword_token(k);
}

// A "binding target" is either an identifier (the common case) or a
// destructuring pattern (`{...}` / `[...]`). Returns NULL on parse
// error. Callers slot the returned node either into Declarator
// (variable decls) or as a function parameter.
fn parse_binding_target(p: Parser*) -> AstNode* {
    let k = peek_kind(p);
    if k == TokenKind::LBrace  { return parse_object_pattern(p); }
    if k == TokenKind::LBracket { return parse_array_pattern(p); }
    let t = peek(p);
    if !is_binding_ident_ctx(p, t.kind) { p.had_error = true; return NULL; }
    advance(p);
    let node = new_node(&p.tracker, NodeKind::IdentExpr, t.start, t.start + t.length);
    node.name_start  = t.start;
    node.name_length = t.length;
    return node;
}

// `{ a, b: rename, c = default, ...rest }`
fn parse_object_pattern(p: Parser*) -> AstNode* {
    let lb = advance(p);            // '{'
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);
    let seen_rest: bool = false;
    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
        if seen_rest { p.had_error = true; break; }
        let entry_start = peek(p).start;
        // Rest: `...name` (target must be an identifier; spec says
        // restricted, no nested pattern).
        if peek_kind(p) == TokenKind::Ellipsis {
            advance(p);
            let id = peek(p);
            if !is_binding_ident_ctx(p, id.kind) { p.had_error = true; break; }
            advance(p);
            let ident = new_node(&p.tracker, NodeKind::IdentExpr, id.start, id.start + id.length);
            ident.name_start  = id.start;
            ident.name_length = id.length;
            let r = new_node(&p.tracker, NodeKind::PatternEntry, entry_start, id.start + id.length);
            r.name_start  = 0;
            r.name_length = 0;
            r.left        = ident;
            r.right       = NULL;
            r.third       = NULL;
            r.bool_value  = true;       // rest sentinel
            if count >= cap { let oc = cap; cap = cap * 2; buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap); }
            buf[count] = r; count = count + 1;
            seen_rest = true;
            // Allow trailing comma per spec? No — rest must be last,
            // no trailing comma. Break.
            break;
        }
        // Computed key: `[expr]: target`
        let computed_key: AstNode* = NULL;
        let key_start: u32 = 0;
        let key_len: u32 = 0;
        if peek_kind(p) == TokenKind::LBracket {
            advance(p);
            computed_key = parse_assignment(p);
            if computed_key == NULL { break; }
            if !expect_kind(p, TokenKind::RBracket) { break; }
        } else {
            let key_tok = peek(p);
            if !is_property_name_start(key_tok.kind) { p.had_error = true; break; }
            advance(p);
            key_start = key_tok.start;
            key_len   = key_tok.length;
        }
        // Optional `: target` (rename or nested pattern); otherwise
        // shorthand — the key doubles as the local binding name.
        let target: AstNode* = NULL;
        if match_kind(p, TokenKind::Colon) {
            target = parse_binding_target(p);
            if target == NULL { break; }
        } else if computed_key != NULL {
            // Computed key without a target — spec error.
            p.had_error = true; break;
        } else {
            // Shorthand: target = IdentExpr matching the key.
            target = new_node(&p.tracker, NodeKind::IdentExpr, key_start, key_start + key_len);
            target.name_start  = key_start;
            target.name_length = key_len;
        }
        // Optional default: `target = init`.
        let default_expr: AstNode* = NULL;
        if match_kind(p, TokenKind::Eq) {
            default_expr = parse_assignment(p);
            if default_expr == NULL { break; }
        }
        let entry_end = if default_expr != NULL { default_expr.end } else { target.end };
        let entry = new_node(&p.tracker, NodeKind::PatternEntry, entry_start, entry_end);
        entry.name_start  = key_start;
        entry.name_length = key_len;
        entry.third       = computed_key;
        entry.left        = target;
        entry.right       = default_expr;
        entry.bool_value  = false;
        if count >= cap { let oc = cap; cap = cap * 2; buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap); }
        buf[count] = entry; count = count + 1;
        if !match_kind(p, TokenKind::Comma) { break; }
    }
    let rb_tok = peek(p);
    if !expect_kind(p, TokenKind::RBrace) { dealloc(buf); return NULL; }
    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }
    let node = new_node(&p.tracker, NodeKind::ObjectPattern, lb.start, rb_tok.start + rb_tok.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

// `[a, , b = default, ...tail]`
fn parse_array_pattern(p: Parser*) -> AstNode* {
    let lb = advance(p);           // '['
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);
    let seen_rest: bool = false;
    while peek_kind(p) != TokenKind::RBracket && peek_kind(p) != TokenKind::Eof {
        if seen_rest { p.had_error = true; break; }
        let entry_start = peek(p).start;
        // Hole: bare comma — `[a, , c]` skips index 1.
        if peek_kind(p) == TokenKind::Comma {
            let h = new_node(&p.tracker, NodeKind::PatternEntry, entry_start, entry_start);
            h.left = NULL;     // elision sentinel
            h.right = NULL;
            h.third = NULL;
            h.name_start  = 0;
            h.name_length = 0;
            h.bool_value  = false;
            if count >= cap { let oc = cap; cap = cap * 2; buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap); }
            buf[count] = h; count = count + 1;
            advance(p);    // consume comma; loop continues
            continue;
        }
        // Rest: `...target` (target may be an ident OR a nested pattern,
        // though most code uses an ident).
        let is_rest: bool = false;
        if peek_kind(p) == TokenKind::Ellipsis {
            advance(p);
            is_rest = true;
        }
        let target = parse_binding_target(p);
        if target == NULL { break; }
        let default_expr: AstNode* = NULL;
        if !is_rest && match_kind(p, TokenKind::Eq) {
            default_expr = parse_assignment(p);
            if default_expr == NULL { break; }
        }
        let entry_end = if default_expr != NULL { default_expr.end } else { target.end };
        let entry = new_node(&p.tracker, NodeKind::PatternEntry, entry_start, entry_end);
        entry.name_start  = 0;
        entry.name_length = 0;
        entry.third       = NULL;
        entry.left        = target;
        entry.right       = default_expr;
        entry.bool_value  = is_rest;
        if count >= cap { let oc = cap; cap = cap * 2; buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap); }
        buf[count] = entry; count = count + 1;
        if is_rest { seen_rest = true; break; }
        if !match_kind(p, TokenKind::Comma) { break; }
    }
    let rb_tok = peek(p);
    if !expect_kind(p, TokenKind::RBracket) { dealloc(buf); return NULL; }
    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }
    let node = new_node(&p.tracker, NodeKind::ArrayPattern, lb.start, rb_tok.start + rb_tok.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

fn parse_var_decl(p: Parser*, consume_semi: bool) -> AstNode* {
    let kw = advance(p);   // var / let / const

    let cap: u32 = 2;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    let last_end: u32 = kw.start + kw.length;
    while true {
        let k = peek_kind(p);
        let is_pattern: bool = k == TokenKind::LBrace || k == TokenKind::LBracket;
        let decl_start: u32 = peek(p).start;
        let decl: AstNode* = new_node(&p.tracker, NodeKind::Declarator,
                                       decl_start, decl_start);
        if is_pattern {
            let pat = parse_binding_target(p);
            if pat == NULL { break; }
            // Pattern bindings use name_length = 0 as the sentinel;
            // `third` carries the pattern node. compile_stmt /
            // collect_locals dispatch on that.
            decl.name_start  = 0;
            decl.name_length = 0;
            decl.third       = pat;
            decl.end         = pat.end;
        } else {
            let name_tok = peek(p);
            if !is_binding_ident_ctx(p, name_tok.kind) {
                p.had_error = true;
                break;
            }
            advance(p);
            decl.start       = name_tok.start;
            decl.end         = name_tok.start + name_tok.length;
            decl.name_start  = name_tok.start;
            decl.name_length = name_tok.length;
        }

        if match_kind(p, TokenKind::Eq) {
            let init = parse_assignment(p);
            if init == NULL { break; }
            decl.left = init;
            decl.end = init.end;
        }

        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = decl;
        count = count + 1;
        last_end = decl.end;

        if !match_kind(p, TokenKind::Comma) { break; }
    }

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::VarDecl, kw.start, last_end);
    node.op = kw.kind;
    node.children = buf;
    node.children_count = count;

    if consume_semi { match_terminator(p); }
    return node;
}

// ECMA-262 grammar split: the body of `if/while/do-while/for/for-in/for-of`
// is `Statement`, not `Declaration`. So `let`, `const`, `function`, and
// `class` declarations are illegal as a non-block statement body. The
// only `var` form that IS allowed is the legacy `var` statement
// (VarDecl with op=KwVar). Returns true if the node is one of the
// disallowed declarations.
fn is_disallowed_statement_body(n: AstNode*) -> bool {
    if n == NULL { return false; }
    let k = n.kind;
    if k == NodeKind::FunctionDecl { return true; }
    if k == NodeKind::ClassDecl    { return true; }
    if k == NodeKind::VarDecl {
        // let/const declarations are disallowed; var is allowed.
        if n.op == TokenKind::KwLet || n.op == TokenKind::KwConst {
            return true;
        }
    }
    return false;
}

fn parse_if(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'if'
    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let cond = parse_expression(p);
    if cond == NULL { return NULL; }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    let then_stmt = parse_statement(p);
    if then_stmt == NULL { return NULL; }
    if is_disallowed_statement_body(then_stmt) { p.had_error = true; return NULL; }

    let end: u32 = then_stmt.end;
    let else_stmt: AstNode* = NULL;
    if match_kind(p, TokenKind::KwElse) {
        else_stmt = parse_statement(p);
        if else_stmt == NULL { return NULL; }
        if is_disallowed_statement_body(else_stmt) { p.had_error = true; return NULL; }
        end = else_stmt.end;
    }

    let node = new_node(&p.tracker, NodeKind::IfStmt, kw.start, end);
    node.left = cond;
    node.right = then_stmt;
    node.third = else_stmt;
    return node;
}

fn parse_return(p: Parser*) -> AstNode* {
    if p.function_depth == 0 { p.had_error = true; return NULL; }
    let kw = advance(p);   // 'return'
    let end: u32 = kw.start + kw.length;
    let arg: AstNode* = NULL;

    // Bare `return;` or `return` at end-of-block keeps arg=NULL.
    let k = peek_kind(p);
    if k != TokenKind::Semicolon && k != TokenKind::RBrace && k != TokenKind::Eof {
        arg = parse_expression(p);
        if arg == NULL { return NULL; }
        end = arg.end;
    }

    let node = new_node(&p.tracker, NodeKind::ReturnStmt, kw.start, end);
    node.left = arg;
    match_terminator(p);
    return node;
}

fn parse_while(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'while'
    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let cond = parse_expression(p);
    if cond == NULL { return NULL; }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }
    let node = new_node(&p.tracker, NodeKind::WhileStmt, kw.start, body.end);
    node.left = cond;
    node.right = body;
    return node;
}

fn parse_do_while(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'do'
    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }
    if !expect_kind(p, TokenKind::KwWhile) { return NULL; }
    if !expect_kind(p, TokenKind::LParen)  { return NULL; }
    let cond = parse_expression(p);
    if cond == NULL { return NULL; }
    let close = peek(p);
    if !expect_kind(p, TokenKind::RParen)  { return NULL; }
    let node = new_node(&p.tracker, NodeKind::DoWhileStmt, kw.start, close.start + close.length);
    node.left = body;
    node.right = cond;
    match_terminator(p);
    return node;
}

fn parse_for(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'for'
    if !expect_kind(p, TokenKind::LParen) { return NULL; }

    // init slot: var-decl (no `;` consumed), expression, or empty.
    // After parsing the init, peek for 'in' / 'of' to switch into the
    // for-in / for-of branches; otherwise expect the C-style `;`.
    //
    // Enter no-in mode around the init so the relational parser doesn't
    // greedily consume `for (x in obj)` as `for ((x in obj))`.
    let saved_no_in = p.no_in;
    p.no_in = true;

    let init: AstNode* = NULL;
    let kk = peek_kind(p);
    if kk == TokenKind::Semicolon {
        advance(p);
        p.no_in = saved_no_in;
    } else if kk == TokenKind::KwVar || kk == TokenKind::KwLet || kk == TokenKind::KwConst {
        init = parse_var_decl(p, false);
        p.no_in = saved_no_in;
        if init == NULL { return NULL; }
        let after = peek_kind(p);
        if after == TokenKind::KwIn || after == TokenKind::KwOf {
            return finish_for_in_or_of(p, kw, init, after);
        }
        if !expect_kind(p, TokenKind::Semicolon) { return NULL; }
    } else {
        init = parse_expression(p);
        p.no_in = saved_no_in;
        if init == NULL { return NULL; }
        let after = peek_kind(p);
        if after == TokenKind::KwIn || after == TokenKind::KwOf {
            return finish_for_in_or_of(p, kw, init, after);
        }
        if !expect_kind(p, TokenKind::Semicolon) { return NULL; }
    }

    // test slot: optional expression, terminated by `;`.
    let test_e: AstNode* = NULL;
    if peek_kind(p) != TokenKind::Semicolon {
        test_e = parse_expression(p);
        if test_e == NULL { return NULL; }
    }
    if !expect_kind(p, TokenKind::Semicolon) { return NULL; }

    // update slot: optional expression, terminated by `)`.
    let update: AstNode* = NULL;
    if peek_kind(p) != TokenKind::RParen {
        update = parse_expression(p);
        if update == NULL { return NULL; }
    }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }

    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }

    let node = new_node(&p.tracker, NodeKind::ForStmt, kw.start, body.end);
    node.left = init;
    node.right = test_e;
    node.third = update;

    // Body lives in children[0] (the variadic slot — left/right/third are taken).
    let body_arr: AstNode** = NULL;
    body_arr = alloc_n<AstNode*>(1);
    body_arr[0] = body;
    alloc_list_push(&p.tracker, (void*)body_arr);
    node.children = body_arr;
    node.children_count = 1;

    return node;
}

// Build a ForInStmt / ForOfStmt after parse_for has already consumed
// `for (` and the binding. `op_kind` is KwIn or KwOf — drives the
// returned NodeKind.
fn finish_for_in_or_of(p: Parser*, kw_tok: Token, binding: AstNode*, op_kind: TokenKind) -> AstNode* {
    // ECMA-262: ForDeclaration / ForBinding in for-in / for-of heads
    // may not carry an initializer, and must be exactly one binding.
    // `for (let x = 1 of [])` and `for (var x, y in obj)` are both
    // early SyntaxErrors.
    // Cover-grammar: `for ([a,b] of ...)` / `for ({a} of ...)` parses
    // the head as an Array/Object literal expression. Reinterpret as
    // an AssignmentPattern so the for-of compile path can destructure
    // each element.
    if binding != NULL
       && (binding.kind == NodeKind::Array || binding.kind == NodeKind::Object) {
        binding = reinterpret_as_pattern(p, binding);
        if binding == NULL { return NULL; }
    }
    if binding != NULL && binding.kind == NodeKind::VarDecl {
        if binding.children_count != 1 { p.had_error = true; return NULL; }
        let decl0 = binding.children[0];
        if decl0 != NULL && decl0.left != NULL { p.had_error = true; return NULL; }
        // Spec: a `let` / `const` ForDeclaration may not bind the
        // identifier `let`.  `for (let let of ...)` and the const
        // version are SyntaxErrors. Bare `var let` is still fine.
        if decl0 != NULL && decl0.name_length == 3
           && (binding.op == TokenKind::KwLet || binding.op == TokenKind::KwConst) {
            let nm = p.source + decl0.name_start;
            let is_let: int = 0;
            raw { is_let = (memcmp(nm, "let", 3) == 0) ? 1 : 0; }
            if is_let != 0 { p.had_error = true; return NULL; }
        }
    }
    // Spec: for-of LHS may not begin with the identifier `async`.
    // `for (async of [1])` is an early SyntaxError so the head can be
    // disambiguated from `for await (async of [...])` etc.
    if op_kind == TokenKind::KwOf && binding != NULL && binding.kind == NodeKind::IdentExpr {
        let bn_len = binding.end - binding.start;
        if bn_len == 5 {
            let nm = p.source + binding.start;
            let is_async: int = 0;
            raw { is_async = (memcmp(nm, "async", 5) == 0) ? 1 : 0; }
            if is_async != 0 { p.had_error = true; return NULL; }
        }
    }
    advance(p);    // consume 'in' or 'of'
    // ECMA-262: for-of's RHS is an AssignmentExpression (no comma);
    // for-in's RHS is an Expression. We constrain both to
    // AssignmentExpression-or-Comma here for simplicity, then verify
    // for-of did not consume a comma by checking we land at ')'.
    let iter_expr: AstNode* = NULL;
    if op_kind == TokenKind::KwOf {
        iter_expr = parse_assignment(p);
    } else {
        iter_expr = parse_expression(p);
    }
    if iter_expr == NULL { return NULL; }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }

    let kind = if op_kind == TokenKind::KwIn { NodeKind::ForInStmt } else { NodeKind::ForOfStmt };
    let node = new_node(&p.tracker, kind, kw_tok.start, body.end);
    node.left = binding;
    node.right = iter_expr;

    let body_arr: AstNode** = NULL;
    body_arr = alloc_n<AstNode*>(1);
    body_arr[0] = body;
    alloc_list_push(&p.tracker, (void*)body_arr);
    node.children = body_arr;
    node.children_count = 1;

    return node;
}

fn parse_break(p: Parser*) -> AstNode* {
    let kw = advance(p);
    let end_pos = kw.start + kw.length;
    let label_start: u32 = 0;
    let label_length: u32 = 0;
    // Optional label identifier immediately after `break` / `continue`,
    // unless the next token is a statement terminator. We don't have
    // proper ASI yet, so accept an identifier whenever we see one.
    if peek_kind(p) == TokenKind::Identifier {
        let next = peek(p);
        let kw_end = kw.start + kw.length;
        if !has_newline_between(p, kw_end, next.start) {
            let id = advance(p);
            label_start  = id.start;
            label_length = id.length;
            end_pos      = id.start + id.length;
        }
    }
    let node = new_node(&p.tracker, NodeKind::BreakStmt, kw.start, end_pos);
    node.name_start  = label_start;
    node.name_length = label_length;
    match_terminator(p);
    return node;
}

fn parse_continue(p: Parser*) -> AstNode* {
    let kw = advance(p);
    let end_pos = kw.start + kw.length;
    let label_start: u32 = 0;
    let label_length: u32 = 0;
    if peek_kind(p) == TokenKind::Identifier {
        let next = peek(p);
        let kw_end = kw.start + kw.length;
        if !has_newline_between(p, kw_end, next.start) {
            let id = advance(p);
            label_start  = id.start;
            label_length = id.length;
            end_pos      = id.start + id.length;
        }
    }
    let node = new_node(&p.tracker, NodeKind::ContinueStmt, kw.start, end_pos);
    node.name_start  = label_start;
    node.name_length = label_length;
    match_terminator(p);
    return node;
}

fn parse_throw(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'throw'
    let arg = parse_expression(p);
    if arg == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::ThrowStmt, kw.start, arg.end);
    node.left = arg;
    match_terminator(p);
    return node;
}

// switch (expr) { case A: ...; case B: ... break; default: ... }
// Each case is a SwitchCase node holding a list of body statements.
// `default` may appear anywhere; not necessarily last. The compiler
// reorders test/exec to handle that.
fn parse_switch(p: Parser*) -> AstNode* {
    let kw = advance(p);     // 'switch'
    if !expect_kind(p, TokenKind::LParen)  { return NULL; }
    let disc = parse_expression(p);
    if disc == NULL { return NULL; }
    if !expect_kind(p, TokenKind::RParen)  { return NULL; }
    if !expect_kind(p, TokenKind::LBrace)  { return NULL; }

    let cap: u32 = 4;
    let cnt: u32 = 0;
    let cases = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
        let head_tok = peek(p);
        let is_default: bool = false;
        let test_expr: AstNode* = NULL;
        if head_tok.kind == TokenKind::KwDefault {
            advance(p);
            is_default = true;
        } else if head_tok.kind == TokenKind::KwCase {
            advance(p);
            test_expr = parse_expression(p);
            if test_expr == NULL { break; }
        } else {
            p.had_error = true; break;
        }
        if !expect_kind(p, TokenKind::Colon) { break; }

        // Body: any number of statements until the next case/default/}.
        let bcap: u32 = 4;
        let bcnt: u32 = 0;
        let body = alloc_n<AstNode*>((usize)bcap);
        while peek_kind(p) != TokenKind::KwCase
              && peek_kind(p) != TokenKind::KwDefault
              && peek_kind(p) != TokenKind::RBrace
              && peek_kind(p) != TokenKind::Eof {
            let s = parse_statement(p);
            if s == NULL { break; }
            if bcnt >= bcap {
                let oc = bcap; bcap = bcap * 2;
                body = realloc_n<AstNode*>(body, (usize)oc, (usize)bcap);
            }
            body[bcnt] = s; bcnt = bcnt + 1;
        }
        if bcnt > 0 { alloc_list_push(&p.tracker, (void*)body); }
        else        { dealloc(body); body = NULL; }

        let case_end = if bcnt > 0 { body[bcnt - 1].end } else { head_tok.start + head_tok.length };
        let case_node = new_node(&p.tracker, NodeKind::SwitchCase, head_tok.start, case_end);
        case_node.left = test_expr;
        case_node.children = body;
        case_node.children_count = bcnt;
        case_node.bool_value = is_default;

        if cnt >= cap {
            let oc = cap; cap = cap * 2;
            cases = realloc_n<AstNode*>(cases, (usize)oc, (usize)cap);
        }
        cases[cnt] = case_node; cnt = cnt + 1;
    }
    let close = peek(p);
    if !expect_kind(p, TokenKind::RBrace) { dealloc(cases); return NULL; }

    if cnt > 0 { alloc_list_push(&p.tracker, (void*)cases); }
    else       { dealloc(cases); cases = NULL; }

    let node = new_node(&p.tracker, NodeKind::SwitchStmt, kw.start, close.start + close.length);
    node.left = disc;
    node.children = cases;
    node.children_count = cnt;
    return node;
}

fn parse_try(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'try'

    if peek_kind(p) != TokenKind::LBrace { p.had_error = true; return NULL; }
    let try_block = parse_block(p);
    if try_block == NULL { return NULL; }

    // Catch clause (optional in the presence of finally).
    let catch_block: AstNode* = NULL;
    let catch_name_start: u32 = 0;
    let catch_name_length: u32 = 0;
    let catch_pattern: AstNode* = NULL;
    if match_kind(p, TokenKind::KwCatch) {
        if match_kind(p, TokenKind::LParen) {
            // Catch param: bare identifier OR destructuring pattern.
            let id_or_pat = parse_binding_target(p);
            if id_or_pat == NULL { return NULL; }
            if id_or_pat.kind == NodeKind::IdentExpr {
                catch_name_start = id_or_pat.start;
                catch_name_length = id_or_pat.end - id_or_pat.start;
            } else {
                catch_pattern = id_or_pat;
            }
            if !expect_kind(p, TokenKind::RParen) { return NULL; }
        }
        if peek_kind(p) != TokenKind::LBrace { p.had_error = true; return NULL; }
        catch_block = parse_block(p);
        if catch_block == NULL { return NULL; }
    }

    // Finally clause (optional).
    let finally_block: AstNode* = NULL;
    if match_kind(p, TokenKind::KwFinally) {
        if peek_kind(p) != TokenKind::LBrace { p.had_error = true; return NULL; }
        finally_block = parse_block(p);
        if finally_block == NULL { return NULL; }
    }

    // Must have at least one of catch / finally.
    if catch_block == NULL && finally_block == NULL {
        p.had_error = true;
        return NULL;
    }

    let end_pos = if finally_block != NULL { finally_block.end }
                  else if catch_block != NULL { catch_block.end }
                  else { try_block.end };
    let node = new_node(&p.tracker, NodeKind::TryStmt, kw.start, end_pos);
    node.left  = try_block;
    node.right = catch_block;
    node.third = finally_block;
    node.name_start  = catch_name_start;
    node.name_length = catch_name_length;
    // Destructuring catch param lives at children[0] when present.
    // (name_length == 0 && children_count == 1 distinguishes pattern
    // from `catch { ... }` parameter-less form, which leaves both
    // zero.)
    if catch_pattern != NULL {
        let kids = new_children(&p.tracker, 1);
        kids[0] = catch_pattern;
        node.children = kids;
        node.children_count = 1;
    }
    return node;
}

// =====================================================================
// Functions, arrow functions, parameter lists. Phase 2.5.
// =====================================================================

struct ParamList {
    arr:   AstNode**;
    count: u32;
}

// Parse a comma-separated list of bindings up to (but not including)
// the closing `)`. Supports:
//   - plain identifier:                 function f(a) {}
//   - default-initialized identifier:   function f(a = 5) {}
//   - rest parameter (must be last):    function f(...rest) {}
fn parse_param_list(p: Parser*) -> ParamList {
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);
    let seen_rest: bool = false;

    while peek_kind(p) != TokenKind::RParen && peek_kind(p) != TokenKind::Eof {
        if seen_rest {
            // `...rest` must be the last entry — no trailing comma, no
            // more bindings after it.
            p.had_error = true;
            break;
        }
        let is_rest: bool = false;
        if peek_kind(p) == TokenKind::Ellipsis {
            advance(p);
            is_rest = true;
        }
        // Param target: identifier OR destructuring pattern. Patterns
        // get wrapped in an IdentExpr placeholder whose name_length = 0
        // and whose `third` points to the pattern node — same shape
        // the var-declarator uses.
        let pk = peek_kind(p);
        let is_pattern: bool = pk == TokenKind::LBrace || pk == TokenKind::LBracket;
        let ident: AstNode* = NULL;
        let ident_start: u32 = 0;
        let ident_end:   u32 = 0;
        if is_pattern {
            if is_rest { p.had_error = true; break; }  // rest with pattern: not yet
            let pat = parse_binding_target(p);
            if pat == NULL { break; }
            ident_start = pat.start;
            ident_end   = pat.end;
            ident = new_node(&p.tracker, NodeKind::IdentExpr, ident_start, ident_end);
            ident.name_start  = 0;
            ident.name_length = 0;
            ident.third       = pat;
        } else {
            let name_tok = peek(p);
            if !is_binding_ident_ctx(p, name_tok.kind) {
                p.had_error = true;
                break;
            }
            // ECMA-262 §15.1.1 / §15.2.1.1 strict-mode early error:
            // FormalParameter name MUST NOT be `arguments` or `eval`.
            if p.strict_mode && name_is_arguments_or_eval(p.source, name_tok.start, name_tok.length) {
                p.had_error = true;
                break;
            }
            advance(p);
            ident_start = name_tok.start;
            ident_end   = name_tok.start + name_tok.length;
            ident = new_node(&p.tracker, NodeKind::IdentExpr, ident_start, ident_end);
            ident.name_start  = ident_start;
            ident.name_length = name_tok.length;
        }

        let param: AstNode* = ident;
        if is_rest {
            // `...name` — rest params can't have a default (per spec).
            let rest = new_node(&p.tracker, NodeKind::RestParam, ident_start, ident_end);
            rest.left = ident;
            param = rest;
            seen_rest = true;
        } else if peek_kind(p) == TokenKind::Eq {
            // `name = expr` — default initializer. Parsed at AssignmentExpr
            // precedence so commas terminate the list cleanly. Note the
            // IdentExpr's start/end stay bounded to the name itself —
            // the compiler reads that range when registering the local.
            advance(p);
            let init = parse_assignment(p);
            if init == NULL { break; }
            param.right = init;
        }

        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = param;
        count = count + 1;

        if !match_kind(p, TokenKind::Comma) { break; }
        // ES2017 trailing-comma tolerance: `function f(a, b,)` is OK,
        // but `function f(...a,)` is a SyntaxError — rest params
        // disallow ANY following token (including the trailing comma)
        // per UniqueFormalParameters grammar.
        if seen_rest {
            p.had_error = true;
            break;
        }
        if peek_kind(p) == TokenKind::RParen { break; }
    }

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }
    // ECMA-262 §15.1.1 strict-mode early error: duplicate parameter
    // names are a SyntaxError. (Also UniqueFormalParameters in arrow
    // funcs and methods — we approximate by checking when the parser
    // is in strict mode, which covers class bodies.)
    if p.strict_mode && count >= 2 {
        let pi: u32 = 0;
        while pi < count {
            let pa = buf[pi];
            let pa_id: AstNode* = if pa != NULL && pa.kind == NodeKind::RestParam { pa.left } else { pa };
            if pa_id != NULL && pa_id.kind == NodeKind::IdentExpr && pa_id.name_length > 0 {
                let pj: u32 = pi + 1;
                while pj < count {
                    let pb = buf[pj];
                    let pb_id: AstNode* = if pb != NULL && pb.kind == NodeKind::RestParam { pb.left } else { pb };
                    if pb_id != NULL && pb_id.kind == NodeKind::IdentExpr
                       && pb_id.name_length == pa_id.name_length {
                        let na = p.source + pa_id.name_start;
                        let nb = p.source + pb_id.name_start;
                        let nl: u32 = pa_id.name_length;
                        let eq: int = 0;
                        raw { eq = (memcmp(na, nb, (size_t)nl) == 0) ? 1 : 0; }
                        if eq != 0 { p.had_error = true; }
                    }
                    pj = pj + 1;
                }
            }
            pi = pi + 1;
        }
    }
    return ParamList{ arr: buf, count: count };
}

fn parse_function_decl(p: Parser*, is_async: bool) -> AstNode* {
    let kw = advance(p);     // 'function'
    // Generator marker: `function* g() {}` or `async function* () {}`.
    // We don't fully support async generators yet — flag the parse but
    // compile path treats async-and-generator as async-only for now.
    let is_generator: bool = false;
    if peek_kind(p) == TokenKind::Star {
        advance(p);
        is_generator = true;
    }

    let name_tok = peek(p);
    if name_tok.kind != TokenKind::Identifier {
        p.had_error = true;
        return NULL;
    }
    advance(p);

    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) { return NULL; }

    if peek_kind(p) != TokenKind::LBrace {
        p.had_error = true;
        return NULL;
    }
    let saved_async = p.in_async;
    let saved_gen   = p.in_generator;
    p.in_async = is_async;
    p.in_generator = is_generator;
    p.function_depth = p.function_depth + 1;
    let body = parse_block(p);
    p.function_depth = p.function_depth - 1;
    p.in_async = saved_async;
    p.in_generator = saved_gen;
    if body == NULL { return NULL; }
    if !params_are_simple(params) && body_has_use_strict_directive(body, p.source) {
        p.had_error = true; return NULL;
    }
    if !params_are_simple(params) && params_have_duplicate(params, p.source) {
        p.had_error = true; return NULL;
    }

    let node = new_node(&p.tracker, NodeKind::FunctionDecl, kw.start, body.end);
    node.name_start = name_tok.start;
    node.name_length = name_tok.length;
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    node.bool_value = is_async;
    if is_generator { node.num = 3.0; }
    return node;
}

// --- Classes (Phase 3.7) -------------------------------------------
//
// Grammar (MVP, no extends / static / get / set):
//     class X { method() {} otherMethod(a, b) {} constructor(...) {} }
// `constructor` and other methods share the MethodDef shape. The
// compiler distinguishes the constructor by name.

// True if the identifier slice is one of the strict-mode reserved
// words that may not be used as a class or function binding name.
fn is_strict_reserved_name(name: char*, name_len: u32) -> bool {
    if name_len == 3 {
        let eq: int = 0;
        raw { eq = (memcmp(name, "let", 3) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    if name_len == 5 {
        let eq: int = 0;
        raw { eq = (memcmp(name, "yield", 5) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    if name_len == 6 {
        let eq: int = 0;
        raw {
            eq = (memcmp(name, "static", 6) == 0
               || memcmp(name, "public", 6) == 0) ? 1 : 0;
        }
        if eq != 0 { return true; }
    }
    if name_len == 7 {
        let eq: int = 0;
        raw {
            eq = (memcmp(name, "package", 7) == 0
               || memcmp(name, "private", 7) == 0) ? 1 : 0;
        }
        if eq != 0 { return true; }
    }
    if name_len == 9 {
        let eq: int = 0;
        raw {
            eq = (memcmp(name, "interface", 9) == 0
               || memcmp(name, "protected", 9) == 0) ? 1 : 0;
        }
        if eq != 0 { return true; }
    }
    if name_len == 10 {
        let eq: int = 0;
        raw { eq = (memcmp(name, "implements", 10) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    return false;
}

fn parse_method_body_pair(p: Parser*) -> AstNode* {
    let mut_start = peek(p).start;
    // Optional `static` prefix. We only treat it as the static keyword
    // when followed by another property-name token (the actual method
    // name). `static() {}` keeps `static` as the method name.
    let is_static: bool = false;
    let first = peek(p);
    if first.kind == TokenKind::Identifier && first.length == 6 {
        let nd = p.source + first.start;
        let is_kw_static: int = 0;
        raw { is_kw_static = (memcmp(nd, "static", 6) == 0) ? 1 : 0; }
        // `static` can be followed by a property-name, `[` (computed),
        // `*` (generator method), or — once we add it — `async` for an
        // async method.
        if is_kw_static != 0 && (is_property_name_start(peek_kind2(p))
                                 || peek_kind2(p) == TokenKind::LBracket
                                 || peek_kind2(p) == TokenKind::Star) {
            advance(p);
            is_static = true;
        }
    }
    // Optional `async` prefix: `async method() {}` (or
    // `static async method() {}`). Same lookahead rule as `static` and
    // `get`/`set` — only consume when followed by a property-name token
    // (or a computed `[`).
    let is_async_method: bool = false;
    if peek_kind(p) == TokenKind::KwAsync && (is_property_name_start(peek_kind2(p)) || peek_kind2(p) == TokenKind::LBracket) {
        advance(p);
        is_async_method = true;
    }
    // Optional `*` — generator method (or async generator). Async
    // generators (`async *method`) parse but aren't fully supported
    // yet; we tag them so they at least don't trip the parser.
    let is_gen_method: bool = false;
    if peek_kind(p) == TokenKind::Star {
        advance(p);
        is_gen_method = true;
    }
    // Optional `get` / `set` accessor prefix. Same rule as `static`:
    // only treat as the contextual keyword when followed by another
    // property name (so `get() {}` defines a method called `get`).
    // `async get`/`async set` aren't valid syntax; we don't accept them
    // here either.
    let acc_kind: TokenKind = TokenKind::Eq;   // sentinel for "regular method"
    if !is_async_method {
        let id2 = peek(p);
        if id2.kind == TokenKind::Identifier && id2.length == 3 {
            let nd = p.source + id2.start;
            let is_get: int = 0;
            let is_set: int = 0;
            raw {
                is_get = (memcmp(nd, "get", 3) == 0) ? 1 : 0;
                is_set = (memcmp(nd, "set", 3) == 0) ? 1 : 0;
            }
            if (is_get != 0 || is_set != 0)
               && (is_property_name_start(peek_kind2(p)) || peek_kind2(p) == TokenKind::LBracket) {
                advance(p);
                acc_kind = if is_get != 0 { TokenKind::KwGet } else { TokenKind::KwSet };
            }
        }
    }
    // Method name: Identifier OR a contextual / reserved word usable as
    // a property name (`of`, `static`, `let`, ...) OR a computed
    // `[expr]` form.
    let computed_key: AstNode* = NULL;
    let name_tok = peek(p);
    if name_tok.kind == TokenKind::LBracket {
        advance(p);
        computed_key = parse_assignment(p);
        if computed_key == NULL { return NULL; }
        if !expect_kind(p, TokenKind::RBracket) { return NULL; }
    } else {
        if !is_property_name_start(name_tok.kind) { p.had_error = true; return NULL; }
        advance(p);
    }

    // Disambiguate method vs field. A `(` here means method; anything
    // else (`=`, `;`, `}`, or the next class-element name on a new
    // line) is a public class field.
    if peek_kind(p) != TokenKind::LParen && acc_kind == TokenKind::Eq && !is_async_method && !is_gen_method {
        // ECMA-262 Static Semantics: PropName restrictions for fields.
        //   FieldDefinition (instance): PropName MUST NOT be "constructor".
        //   FieldDefinition (static)  : PropName MUST NOT be "prototype"
        //                               or "constructor".
        // String-literal field names ('constructor') and Identifier
        // field names hit the same rule; computed names skip the check
        // (PropName is unknown until runtime).
        if computed_key == NULL && name_tok.length > 0 {
            // For Identifier tokens the slice IS the name. For StringLit
            // we want to compare the body (drop the surrounding quotes).
            let nd_full = p.source + name_tok.start;
            let nl_full: u32 = name_tok.length;
            let nd: char* = nd_full;
            let nl: u32 = nl_full;
            if name_tok.kind == TokenKind::StringLit && nl >= 2 {
                raw { nd = (char*)(nd_full + 1); }
                nl = nl - 2;
            }
            if nl == 11 {
                let is_ctor: int = 0;
                raw { is_ctor = (memcmp(nd, "constructor", 11) == 0) ? 1 : 0; }
                if is_ctor != 0 { p.had_error = true; return NULL; }
            }
            if is_static && nl == 9 {
                let is_proto: int = 0;
                raw { is_proto = (memcmp(nd, "prototype", 9) == 0) ? 1 : 0; }
                if is_proto != 0 { p.had_error = true; return NULL; }
            }
        }
        // Field: `name = expr`, `name;`, or bare `name` (ASI).
        let init_expr: AstNode* = NULL;
        if peek_kind(p) == TokenKind::Eq {
            advance(p);
            init_expr = parse_assignment(p);
            if init_expr == NULL { return NULL; }
            // ECMA-262 Static Semantics: ContainsArguments — class field
            // initializers must not reference `arguments` (recurses into
            // arrow functions but stops at function expressions which
            // shadow the binding).
            if expr_contains_arguments(p, init_expr) {
                p.had_error = true;
                return NULL;
            }
        }
        // Field terminator: explicit `;`, or rely on ASI at `}` / newline.
        match_kind(p, TokenKind::Semicolon);
        let field_end: u32 = if init_expr != NULL { init_expr.end }
                             else if computed_key != NULL { computed_key.end }
                             else { name_tok.start + name_tok.length };
        let field = new_node(&p.tracker, NodeKind::ClassField, mut_start, field_end);
        if computed_key != NULL {
            field.name_start  = 0;
            field.name_length = 0;
            field.third       = computed_key;
        } else {
            field.name_start  = name_tok.start;
            field.name_length = name_tok.length;
        }
        field.bool_value = is_static;
        field.left = init_expr;
        return field;
    }
    // ECMA-262: an async-method's params are parsed in [+Await] context
    // and a generator-method's params in [+Yield]; in both modes the
    // respective keyword is reserved as a BindingIdentifier. Toggle
    // BEFORE parse_param_list, restore after the body.
    let saved_async = p.in_async;
    let saved_gen = p.in_generator;
    p.in_async = is_async_method;
    p.in_generator = is_gen_method;
    if !expect_kind(p, TokenKind::LParen) {
        p.in_async = saved_async; p.in_generator = saved_gen; return NULL;
    }
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) {
        p.in_async = saved_async; p.in_generator = saved_gen; return NULL;
    }

    if peek_kind(p) != TokenKind::LBrace {
        p.in_async = saved_async; p.in_generator = saved_gen;
        p.had_error = true; return NULL;
    }
    p.function_depth = p.function_depth + 1;
    let body = parse_block(p);
    p.function_depth = p.function_depth - 1;
    p.in_async = saved_async;
    p.in_generator = saved_gen;
    if body == NULL { return NULL; }
    if !params_are_simple(params) && body_has_use_strict_directive(body, p.source) {
        p.had_error = true; return NULL;
    }
    if !params_are_simple(params) && params_have_duplicate(params, p.source) {
        p.had_error = true; return NULL;
    }

    let node = new_node(&p.tracker, NodeKind::MethodDef, mut_start, body.end);
    if computed_key != NULL {
        node.name_start  = 0;
        node.name_length = 0;        // sentinel: computed
        node.third       = computed_key;
    } else {
        node.name_start  = name_tok.start;
        node.name_length = name_tok.length;
    }
    node.bool_value  = is_static;
    node.op          = acc_kind;
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    // Reuse `num` to stash function-kind flags. Class methods don't
    // use num for anything else, and adding dedicated bools would
    // ripple through every AstNode.
    //   1.0 = async, 4.0 = generator, 5.0 = async generator (parsed
    //   but treated as plain generator below the parser).
    if is_async_method && is_gen_method { node.num = 5.0; }
    else if is_async_method            { node.num = 1.0; }
    else if is_gen_method              { node.num = 4.0; }
    else                               { node.num = 0.0; }
    return node;
}

fn parse_class_body(p: Parser*, is_derived: bool) -> ParamList {
    if !expect_kind(p, TokenKind::LBrace) {
        return ParamList{ arr: NULL, count: 0 };
    }
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf: AstNode** = NULL;
    buf = alloc_n<AstNode*>((usize)cap);

    // Class bodies are implicitly strict per ECMA-262 §10.2.1. Toggle
    // the strict flag so BindingIdentifier checks reject the strict-
    // mode reserved names inside methods, fields, and their parameter
    // lists. Restored on exit so nested class declarations leave
    // sibling code alone.
    let saved_strict = p.strict_mode;
    p.strict_mode = true;
    let saved_derived = p.in_derived_constructor;

    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
        // Skip empty `;` separators (allowed inside class bodies).
        if peek_kind(p) == TokenKind::Semicolon { advance(p); continue; }
        // Constructor body of a derived class can use `super(...)`;
        // every other method body cannot. The flag is consumed by the
        // SuperCall check in parse_call_member and is RESTORED here
        // each loop iteration so a previous-method context doesn't
        // leak into the next sibling.
        p.in_derived_constructor = is_derived && next_method_is_constructor(p);
        let m = parse_method_body_pair(p);
        if m == NULL { p.had_error = true; break; }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = m;
        count = count + 1;
    }
    expect_kind(p, TokenKind::RBrace);

    // Post-process: inject instance-field initializers into the
    // constructor body. Each instance field `name = init;` desugars to
    // `this.name = init;` prepended at the constructor's entry. We
    // only handle the explicit-constructor case here; classes without
    // an explicit constructor + with instance fields still parse
    // cleanly but the inits silently no-op for now (V2 work).
    let ctor_idx: i32 = -1;
    let any_inst_field: bool = false;
    let scan: u32 = 0;
    while scan < count {
        let m = buf[scan];
        if m.kind == NodeKind::ClassField && !m.bool_value {
            any_inst_field = true;
        }
        if m.kind == NodeKind::MethodDef && m.name_length == 11 && !m.bool_value {
            let mn = p.source + m.name_start;
            let is_ctor: int = 0;
            raw { is_ctor = (memcmp(mn, "constructor", 11) == 0) ? 1 : 0; }
            if is_ctor != 0 {
                // ECMA-262 §15.7 — ClassBody MUST NOT contain more than
                // one non-static MethodDefinition named "constructor".
                // (Static methods named "constructor" are allowed and
                // don't conflict — they're flagged via bool_value, which
                // this branch already excludes.)
                if ctor_idx < 0 { ctor_idx = (i32)scan; }
                else            { p.had_error = true; }
            }
        }
        scan = scan + 1;
    }
    // Synthesize an empty constructor when fields exist but none was
    // declared. The compiler recognizes it via a sentinel on `num`
    // (synth_ctor = 2.0) rather than a source-slice memcmp, so we
    // don't need to find the literal word "constructor" in source.
    // (Extends-class without ctor still incomplete here: we don't
    // synthesize a `super(...args)` call — covered by a follow-up.)
    if any_inst_field && ctor_idx < 0 {
        let synth_anchor: u32 = if count > 0 { buf[0].start } else { 0 };
        let body_block = new_node(&p.tracker, NodeKind::BlockStmt, synth_anchor, synth_anchor);
        body_block.children = NULL;
        body_block.children_count = 0;
        let synth = new_node(&p.tracker, NodeKind::MethodDef, synth_anchor, synth_anchor);
        synth.name_start  = synth_anchor;
        synth.name_length = 0;          // 0-length name; sentinel ensures recognition
        synth.bool_value  = false;
        synth.op          = TokenKind::Eq;
        synth.num         = 2.0;        // synth-constructor sentinel
        synth.left        = body_block;
        synth.children    = NULL;
        synth.children_count = 0;
        if count >= cap {
            let oc = cap; cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap);
        }
        buf[count] = synth;
        ctor_idx = (i32)count;
        count = count + 1;
    }
    if any_inst_field && ctor_idx >= 0 {
        let ctor = buf[(u32)ctor_idx];
        let block = ctor.left;       // BlockStmt
        if block != NULL && block.kind == NodeKind::BlockStmt {
            // Count field inits.
            let init_count: u32 = 0;
            let s2: u32 = 0;
            while s2 < count {
                let m2 = buf[s2];
                if m2.kind == NodeKind::ClassField && !m2.bool_value { init_count = init_count + 1; }
                s2 = s2 + 1;
            }
            // Build new children array: init stmts first, then original body.
            let new_total: u32 = init_count + block.children_count;
            let new_children = alloc_n<AstNode*>((usize)new_total);
            let ni: u32 = 0;
            let s3: u32 = 0;
            while s3 < count {
                let f = buf[s3];
                if f.kind == NodeKind::ClassField && !f.bool_value {
                    // Build `this.<name> = <init>` or
                    // `this[<key>] = <init>` for computed.
                    let this_e = new_node(&p.tracker, NodeKind::ThisExpr, f.start, f.start);
                    let target: AstNode* = NULL;
                    if f.name_length == 0 && f.third != NULL {
                        let m_node = new_node(&p.tracker, NodeKind::Computed, f.start, f.end);
                        m_node.left  = this_e;
                        m_node.right = f.third;
                        target = m_node;
                    } else {
                        let m_node = new_node(&p.tracker, NodeKind::Member, f.start, f.end);
                        m_node.left  = this_e;
                        m_node.name_start  = f.name_start;
                        m_node.name_length = f.name_length;
                        target = m_node;
                    }
                    let init_val = f.left;
                    if init_val == NULL {
                        init_val = new_node(&p.tracker, NodeKind::UndefinedExpr, f.start, f.start);
                    }
                    let assign = new_node(&p.tracker, NodeKind::Assignment, f.start, init_val.end);
                    assign.op    = TokenKind::Eq;
                    assign.left  = target;
                    assign.right = init_val;
                    new_children[ni] = assign;
                    ni = ni + 1;
                }
                s3 = s3 + 1;
            }
            // Append original body children.
            let bi: u32 = 0;
            while bi < block.children_count {
                new_children[ni] = block.children[bi];
                ni = ni + 1;
                bi = bi + 1;
            }
            alloc_list_push(&p.tracker, (void*)new_children);
            block.children = new_children;
            block.children_count = new_total;
        }
    }

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }
    p.strict_mode = saved_strict;
    p.in_derived_constructor = saved_derived;
    return ParamList{ arr: buf, count: count };
}

// Look ahead at the upcoming method's declarator and report whether
// it's a non-static `constructor(...) { ... }`. Pure peek — doesn't
// advance p.pos. Used by parse_class_body to gate the
// `in_derived_constructor` flag around exactly one method body.
fn next_method_is_constructor(p: Parser*) -> bool {
    let i: usize = p.pos;
    let saw_static: bool = false;
    let saw_async: bool = false;
    let saw_gen: bool = false;
    let saw_accessor: bool = false;
    while i < p.token_count {
        let t = p.tokens[i];
        if t.kind == TokenKind::Identifier && t.length == 6 {
            let nd = p.source + t.start;
            let is_static: int = 0;
            raw { is_static = (memcmp(nd, "static", 6) == 0) ? 1 : 0; }
            if is_static != 0 { saw_static = true; i = i + 1; continue; }
        }
        if t.kind == TokenKind::KwAsync { saw_async = true; i = i + 1; continue; }
        if t.kind == TokenKind::Star    { saw_gen   = true; i = i + 1; continue; }
        if t.kind == TokenKind::Identifier && t.length == 3 {
            let nd = p.source + t.start;
            let is_acc: int = 0;
            raw { is_acc = ((memcmp(nd, "get", 3) == 0) || (memcmp(nd, "set", 3) == 0)) ? 1 : 0; }
            if is_acc != 0 { saw_accessor = true; i = i + 1; continue; }
        }
        // Static / async / generator / accessor methods can be named
        // `constructor` without being THE constructor — those are
        // ordinary methods. The SuperCall body-context only applies
        // to a plain non-static, non-accessor `constructor(...) { }`.
        if saw_static || saw_async || saw_gen || saw_accessor { return false; }
        if t.kind == TokenKind::Identifier && t.length == 11 {
            let nd = p.source + t.start;
            let is_ctor: int = 0;
            raw { is_ctor = (memcmp(nd, "constructor", 11) == 0) ? 1 : 0; }
            if is_ctor != 0 {
                let nxt = if i + 1 < p.token_count { p.tokens[i + 1].kind } else { TokenKind::Eof };
                return nxt == TokenKind::LParen;
            }
        }
        return false;
    }
    return false;
}

// =====================================================================
// ES module declarations: import + export.
// =====================================================================

// `import 'mod'`
// `import x from 'mod'`
// `import { a, b as c } from 'mod'`
// `import * as ns from 'mod'`
// `import x, { a } from 'mod'`
// `import x, * as ns from 'mod'`
fn parse_import_decl(p: Parser*) -> AstNode* {
    let kw = advance(p);     // 'import'
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    // Bare `import 'mod'` — side-effect only, no clauses.
    if peek_kind(p) == TokenKind::StringLit {
        let spec_tok = advance(p);
        match_kind(p, TokenKind::Semicolon);
        let node = new_node(&p.tracker, NodeKind::ImportDecl, kw.start, spec_tok.start + spec_tok.length);
        node.name_start  = spec_tok.start;
        node.name_length = spec_tok.length;
        node.children = NULL;
        node.children_count = 0;
        dealloc(buf);
        return node;
    }

    // Default binding: `import x` or `import x,` ...
    if peek_kind(p) == TokenKind::Identifier {
        let name_tok = advance(p);
        let cl = new_node(&p.tracker, NodeKind::ImportClause, name_tok.start, name_tok.start + name_tok.length);
        cl.op = TokenKind::KwDefault;
        cl.name_start  = name_tok.start;
        cl.name_length = name_tok.length;
        buf[count] = cl; count = count + 1;
        if peek_kind(p) == TokenKind::Comma { advance(p); }
    }

    // Namespace: `* as ns`
    if peek_kind(p) == TokenKind::Star {
        let star_tok = advance(p);
        if peek_kind(p) != TokenKind::KwAs {
            p.had_error = true; dealloc(buf); return NULL;
        }
        advance(p);
        let name_tok = peek(p);
        if !is_binding_ident_ctx(p, name_tok.kind) {
            p.had_error = true; dealloc(buf); return NULL;
        }
        advance(p);
        let cl = new_node(&p.tracker, NodeKind::ImportClause, star_tok.start, name_tok.start + name_tok.length);
        cl.op = TokenKind::Star;
        cl.name_start  = name_tok.start;
        cl.name_length = name_tok.length;
        if count >= cap { cap = cap * 2; buf = realloc_n<AstNode*>(buf, (usize)(cap/2), (usize)cap); }
        buf[count] = cl; count = count + 1;
    } else if peek_kind(p) == TokenKind::LBrace {
        // `{ a, b as c }` — named imports.
        advance(p);
        while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
            let src_tok = peek(p);
            if !is_binding_ident_ctx(p, src_tok.kind) && !is_keyword_token(src_tok.kind) {
                p.had_error = true; dealloc(buf); return NULL;
            }
            advance(p);
            // Default optional rename: local = source name.
            let local_start = src_tok.start;
            let local_len   = src_tok.length;
            if peek_kind(p) == TokenKind::KwAs {
                advance(p);
                let loc_tok = peek(p);
                if !is_binding_ident_ctx(p, loc_tok.kind) {
                    p.had_error = true; dealloc(buf); return NULL;
                }
                advance(p);
                local_start = loc_tok.start;
                local_len   = loc_tok.length;
            }
            let cl = new_node(&p.tracker, NodeKind::ImportClause, src_tok.start, local_start + local_len);
            cl.op = TokenKind::Eq;
            cl.name_start  = local_start;     // local binding name
            cl.name_length = local_len;
            // Source export name carried on a synthetic IdentExpr in `third`.
            let src_node = new_node(&p.tracker, NodeKind::IdentExpr, src_tok.start, src_tok.start + src_tok.length);
            src_node.name_start  = src_tok.start;
            src_node.name_length = src_tok.length;
            cl.third = src_node;
            if count >= cap { let oc = cap; cap = cap * 2; buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap); }
            buf[count] = cl; count = count + 1;
            if !match_kind(p, TokenKind::Comma) { break; }
        }
        if !expect_kind(p, TokenKind::RBrace) { dealloc(buf); return NULL; }
    }

    if peek_kind(p) != TokenKind::KwFrom {
        p.had_error = true; dealloc(buf); return NULL;
    }
    advance(p);
    let spec_tok = peek(p);
    if spec_tok.kind != TokenKind::StringLit {
        p.had_error = true; dealloc(buf); return NULL;
    }
    advance(p);
    match_kind(p, TokenKind::Semicolon);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::ImportDecl, kw.start, spec_tok.start + spec_tok.length);
    node.name_start  = spec_tok.start;
    node.name_length = spec_tok.length;
    node.children = buf;
    node.children_count = count;
    return node;
}

// `export default expr;`
// `export default function f() {}`
// `export default class C {}`
// `export { a, b as c };`
// `export { a, b as c } from 'mod';`
// `export const x = 1;` / `export let x = 1;` / `export var x = 1;`
// `export function f() {}`
// `export class C {}`
fn parse_export_decl(p: Parser*) -> AstNode* {
    let kw = advance(p);     // 'export'

    if peek_kind(p) == TokenKind::KwDefault {
        let dflt = advance(p);
        // `export default function ...` / `class ...` / expr.
        let value: AstNode* = NULL;
        let k = peek_kind(p);
        if k == TokenKind::KwFunction { value = parse_function_expr(p, false); }
        else if k == TokenKind::KwAsync && peek_kind2(p) == TokenKind::KwFunction {
            advance(p);
            value = parse_function_expr(p, true);
        }
        else if k == TokenKind::KwClass { value = parse_class_expr(p); }
        else { value = parse_assignment(p); match_kind(p, TokenKind::Semicolon); }
        if value == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::ExportDecl, kw.start, value.end);
        node.bool_value = true;       // export-default marker
        node.left = value;
        return node;
    }

    // `export { ... }` / `export { ... } from 'mod'`
    if peek_kind(p) == TokenKind::LBrace {
        advance(p);
        let cap: u32 = 4;
        let count: u32 = 0;
        let buf = alloc_n<AstNode*>((usize)cap);
        while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
            let local_tok = peek(p);
            if !is_binding_ident_ctx(p, local_tok.kind) && !is_keyword_token(local_tok.kind) {
                p.had_error = true; break;
            }
            advance(p);
            let export_start = local_tok.start;
            let export_len   = local_tok.length;
            if peek_kind(p) == TokenKind::KwAs {
                advance(p);
                let e_tok = peek(p);
                if !is_binding_ident_ctx(p, e_tok.kind) && !is_keyword_token(e_tok.kind) {
                    p.had_error = true; break;
                }
                advance(p);
                export_start = e_tok.start;
                export_len   = e_tok.length;
            }
            let cl = new_node(&p.tracker, NodeKind::ExportClause, local_tok.start, export_start + export_len);
            cl.name_start  = local_tok.start;     // local name
            cl.name_length = local_tok.length;
            let en = new_node(&p.tracker, NodeKind::IdentExpr, export_start, export_start + export_len);
            en.name_start  = export_start;
            en.name_length = export_len;
            cl.third = en;                         // export-as name
            if count >= cap { let oc = cap; cap = cap * 2; buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap); }
            buf[count] = cl; count = count + 1;
            if !match_kind(p, TokenKind::Comma) { break; }
        }
        if !expect_kind(p, TokenKind::RBrace) { dealloc(buf); return NULL; }
        let from_spec_start: u32 = 0;
        let from_spec_len:   u32 = 0;
        if peek_kind(p) == TokenKind::KwFrom {
            advance(p);
            let spec_tok = peek(p);
            if spec_tok.kind != TokenKind::StringLit { p.had_error = true; dealloc(buf); return NULL; }
            advance(p);
            from_spec_start = spec_tok.start;
            from_spec_len   = spec_tok.length;
        }
        match_kind(p, TokenKind::Semicolon);
        if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
        else         { dealloc(buf); buf = NULL; }
        let node = new_node(&p.tracker, NodeKind::ExportDecl, kw.start, peek(p).start);
        node.children = buf;
        node.children_count = count;
        node.name_start  = from_spec_start;       // 0 when not re-export
        node.name_length = from_spec_len;
        return node;
    }

    // `export <decl>` — decl is var / let / const / function / class.
    let decl: AstNode* = NULL;
    let k = peek_kind(p);
    if      k == TokenKind::KwVar     { decl = parse_var_decl(p, true); }
    else if k == TokenKind::KwLet     { decl = parse_var_decl(p, true); }
    else if k == TokenKind::KwConst   { decl = parse_var_decl(p, true); }
    else if k == TokenKind::KwFunction { decl = parse_function_decl(p, false); }
    else if k == TokenKind::KwClass    { decl = parse_class_decl(p); }
    else if k == TokenKind::KwAsync && peek_kind2(p) == TokenKind::KwFunction {
        advance(p);
        decl = parse_function_decl(p, true);
    }
    else { p.had_error = true; return NULL; }
    if decl == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::ExportDecl, kw.start, decl.end);
    node.left = decl;
    return node;
}

fn parse_class_decl(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'class'
    let name_tok = peek(p);
    // Class names allow the same broad "binding identifier" set as
    // other declarations: plain Identifier plus contextual keywords
    // (`await`, `yield`, `let`, `of`, `async`, …) when not in a
    // module / async context where they'd be reserved.
    if !is_binding_ident_ctx(p, name_tok.kind) { p.had_error = true; return NULL; }
    // Class bodies are strict-mode code by spec. The class name may
    // not be a strict-reserved identifier.
    if is_strict_reserved_name(p.source + name_tok.start, name_tok.length) {
        p.had_error = true; return NULL;
    }
    advance(p);

    // Optional `extends <LeftHandSideExpression>`.
    let parent: AstNode* = NULL;
    if peek_kind(p) == TokenKind::KwExtends {
        advance(p);
        parent = parse_call_member(p);
        if parent == NULL { return NULL; }
    }

    let body = parse_class_body(p, parent != NULL);
    let end_pos = if body.count > 0 { body.arr[body.count - 1].end } else { peek(p).start };

    let node = new_node(&p.tracker, NodeKind::ClassDecl, kw.start, end_pos);
    node.name_start  = name_tok.start;
    node.name_length = name_tok.length;
    node.right       = parent;
    node.children = body.arr;
    node.children_count = body.count;
    return node;
}

fn parse_class_expr(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'class'
    let name_start: u32 = 0;
    let name_length: u32 = 0;
    if peek_kind(p) == TokenKind::Identifier {
        let nt = advance(p);
        name_start  = nt.start;
        name_length = nt.length;
    }
    let parent: AstNode* = NULL;
    if peek_kind(p) == TokenKind::KwExtends {
        advance(p);
        parent = parse_call_member(p);
        if parent == NULL { return NULL; }
    }
    let body = parse_class_body(p, parent != NULL);
    let end_pos = if body.count > 0 { body.arr[body.count - 1].end } else { peek(p).start };

    let node = new_node(&p.tracker, NodeKind::ClassExpr, kw.start, end_pos);
    node.name_start  = name_start;
    node.name_length = name_length;
    node.right       = parent;
    node.children = body.arr;
    node.children_count = body.count;
    return node;
}

// Function expressions live in expression context. Name is optional.
fn parse_function_expr(p: Parser*, is_async: bool) -> AstNode* {
    let kw = advance(p);     // 'function'
    let is_generator: bool = false;
    if peek_kind(p) == TokenKind::Star {
        advance(p);
        is_generator = true;
    }

    let name_start: u32 = 0;
    let name_length: u32 = 0;
    if peek_kind(p) == TokenKind::Identifier {
        let name_tok = advance(p);
        name_start = name_tok.start;
        name_length = name_tok.length;
    }

    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) { return NULL; }

    if peek_kind(p) != TokenKind::LBrace {
        p.had_error = true;
        return NULL;
    }
    let saved_async = p.in_async;
    let saved_gen   = p.in_generator;
    p.in_async = is_async;
    p.in_generator = is_generator;
    p.function_depth = p.function_depth + 1;
    let body = parse_block(p);
    p.function_depth = p.function_depth - 1;
    p.in_async = saved_async;
    p.in_generator = saved_gen;
    if body == NULL { return NULL; }
    if !params_are_simple(params) && body_has_use_strict_directive(body, p.source) {
        p.had_error = true; return NULL;
    }
    if !params_are_simple(params) && params_have_duplicate(params, p.source) {
        p.had_error = true; return NULL;
    }

    let node = new_node(&p.tracker, NodeKind::FunctionExpr, kw.start, body.end);
    node.name_start = name_start;
    node.name_length = name_length;
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    node.bool_value = is_async;
    if is_generator { node.num = 3.0; }
    return node;
}

// Arrow function body: a block (preserves explicit return semantics)
// OR a single AssignmentExpression (concise body — implicit return).
// Both forms count as entering a function for `return` purposes.
fn parse_arrow_body(p: Parser*, is_async: bool) -> AstNode* {
    let saved_async = p.in_async;
    p.in_async = is_async;
    p.function_depth = p.function_depth + 1;
    let r: AstNode* = NULL;
    if peek_kind(p) == TokenKind::LBrace {
        r = parse_block(p);
    } else {
        r = parse_assignment(p);
    }
    p.function_depth = p.function_depth - 1;
    p.in_async = saved_async;
    return r;
}

// Single-identifier arrow: `x => body` (or `async x => body`)
fn parse_arrow_single(p: Parser*, is_async: bool) -> AstNode* {
    let start_pos = peek(p).start;
    let name_tok = advance(p);     // identifier
    advance(p);                    // '=>'

    let param = new_node(&p.tracker, NodeKind::IdentExpr,
                         name_tok.start, name_tok.start + name_tok.length);
    param.name_start  = name_tok.start;
    param.name_length = name_tok.length;
    let arr: AstNode** = NULL;
    arr = alloc_n<AstNode*>(1);
    arr[0] = param;
    alloc_list_push(&p.tracker, (void*)arr);

    let body = parse_arrow_body(p, is_async);
    if body == NULL { return NULL; }

    let node = new_node(&p.tracker, NodeKind::ArrowFunc, start_pos, body.end);
    node.left = body;
    node.children = arr;
    node.children_count = 1;
    node.bool_value = is_async;
    return node;
}

// Paren-list arrow: `(a, b) => body`, `() => body` (or `async (...) => body`)
fn parse_arrow_paren(p: Parser*, is_async: bool) -> AstNode* {
    let start_pos = peek(p).start;
    advance(p);                  // '('
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    if !expect_kind(p, TokenKind::Arrow)  { return NULL; }
    let body = parse_arrow_body(p, is_async);
    if body == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::ArrowFunc, start_pos, body.end);
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    node.bool_value = is_async;
    return node;
}

// Scan forward from peek_kind(p) == LParen to find the matching `)` and
// peek at the token after it. Returns true iff that token is `=>`.
fn lookahead_arrow_paren(p: Parser*) -> bool {
    let depth: int = 0;
    let i = p.pos;
    while i < p.token_count {
        let k = p.tokens[i].kind;
        if k == TokenKind::LParen { depth = depth + 1; }
        else if k == TokenKind::RParen {
            depth = depth - 1;
            if depth == 0 {
                let next = i + 1;
                if next >= p.token_count { return false; }
                return p.tokens[next].kind == TokenKind::Arrow;
            }
        }
        else if k == TokenKind::Eof { return false; }
        i = i + 1;
    }
    return false;
}

// =====================================================================
// Precedence climb. One function per level, from lowest precedence
// (root of the recursion) to highest (closest to primary).
// =====================================================================

// Level 18 — comma sequence (lowest precedence).
fn parse_expression(p: Parser*) -> AstNode* {
    let first = parse_assignment(p);
    if first == NULL { return NULL; }
    if peek_kind(p) != TokenKind::Comma { return first; }

    // Build a Sequence node.
    let cap: u32 = 4;
    let count: u32 = 1;
    let buf = alloc_n<AstNode*>((usize)cap);
    buf[0] = first;
    while match_kind(p, TokenKind::Comma) {
        let next = parse_assignment(p);
        if next == NULL { break; }
        if count >= cap {
            cap = cap * 2;
            raw {
                buf = (AstNode**)realloc(buf, cap * sizeof(AstNode*));
            }
        }
        buf[count] = next;
        count = count + 1;
    }

    alloc_list_push(&p.tracker, (void*)buf);
    let node = new_node(&p.tracker, NodeKind::Sequence, first.start, buf[count - 1].end);
    node.children = buf;
    node.children_count = count;
    return node;
}

// Level 17 — assignment (right-associative). Also dispatches to arrow
// functions, which share the assignment grammar slot in ECMA-262.
// Cover-grammar reinterpretation: turn an Array / Object literal
// (parsed as an expression) into the equivalent ArrayPattern /
// ObjectPattern. Used when the literal turns out to be the LHS of
// an assignment (`[a, b] = src` or `({a} = src)`) or the binding
// of a for-of/for-in head (`for ([a, b] of ...)`).
//
// Returns NULL and sets p.had_error on shapes that are valid
// expressions but invalid as assignment patterns (e.g. a NumberLit
// in an array slot).
fn reinterpret_as_pattern(p: Parser*, expr: AstNode*) -> AstNode* {
    if expr == NULL { return NULL; }
    let k = expr.kind;
    if k == NodeKind::Array {
        let pat = new_node(&p.tracker, NodeKind::ArrayPattern, expr.start, expr.end);
        let n = expr.children_count;
        let kids = new_children(&p.tracker, n);
        let i: u32 = 0;
        while i < n {
            let elem = expr.children[i];
            let entry = new_node(&p.tracker, NodeKind::PatternEntry,
                                 if elem != NULL { elem.start } else { pat.start },
                                 if elem != NULL { elem.end } else { pat.start });
            if elem == NULL || elem.kind == NodeKind::HoleExpr {
                // Elision — entry.left stays NULL, no default.
            } else if elem.kind == NodeKind::Spread {
                // ECMA-262 AssignmentRestElement must be the LAST entry.
                // `[...x, y]`, `[...x,,]`, `[...x, ...y]` all early-error.
                if i + 1 != n {
                    p.had_error = true;
                    return NULL;
                }
                entry.bool_value = true;
                let inner = elem.left;
                let target = reinterpret_assign_target(p, inner);
                if target == NULL { return NULL; }
                entry.left = target;
            } else if elem.kind == NodeKind::Assignment && elem.op == TokenKind::Eq {
                let target = reinterpret_assign_target(p, elem.left);
                if target == NULL { return NULL; }
                entry.left = target;
                entry.right = elem.right;
            } else {
                let target = reinterpret_assign_target(p, elem);
                if target == NULL { return NULL; }
                entry.left = target;
            }
            kids[i] = entry;
            i = i + 1;
        }
        pat.children = kids;
        pat.children_count = n;
        return pat;
    }
    if k == NodeKind::Object {
        let pat = new_node(&p.tracker, NodeKind::ObjectPattern, expr.start, expr.end);
        let n = expr.children_count;
        let kids = new_children(&p.tracker, n);
        let i: u32 = 0;
        while i < n {
            let prop = expr.children[i];
            if prop == NULL { p.had_error = true; return NULL; }
            let entry = new_node(&p.tracker, NodeKind::PatternEntry, prop.start, prop.end);
            if prop.kind == NodeKind::Spread {
                // `{ ...rest }` at object-literal position.
                entry.bool_value = true;
                let tgt = reinterpret_assign_target(p, prop.left);
                if tgt == NULL { return NULL; }
                entry.left = tgt;
                kids[i] = entry;
                i = i + 1;
                continue;
            }
            if prop.kind != NodeKind::ObjectProp { p.had_error = true; return NULL; }
            entry.name_start  = prop.name_start;
            entry.name_length = prop.name_length;
            if prop.third != NULL { entry.third = prop.third; }   // computed key carry-over
            // prop.left is the value expression. It may carry a
            // default — `{ a = 5 }` shorthand parses as
            // ObjectProp(name="a", left=Assignment(Ident "a", "=", 5))
            // — or a rename — `{ a: x }` → left is the Ident "x". A
            // nested pattern shows up as a Spread / Array / Object.
            let val = prop.left;
            if val != NULL && val.kind == NodeKind::Assignment && val.op == TokenKind::Eq {
                let tgt = reinterpret_assign_target(p, val.left);
                if tgt == NULL { return NULL; }
                entry.left = tgt;
                entry.right = val.right;
            } else {
                let tgt = reinterpret_assign_target(p, val);
                if tgt == NULL { return NULL; }
                entry.left = tgt;
            }
            kids[i] = entry;
            i = i + 1;
        }
        pat.children = kids;
        pat.children_count = n;
        return pat;
    }
    if k == NodeKind::Paren {
        return reinterpret_as_pattern(p, expr.left);
    }
    // Already a pattern (from a previous nesting through this same
    // helper).
    if k == NodeKind::ArrayPattern || k == NodeKind::ObjectPattern {
        return expr;
    }
    p.had_error = true;
    return NULL;
}

// Inner element/property target — either a nested pattern (recurse
// through reinterpret_as_pattern) or a leaf LHSExpression (Ident /
// Member / Computed). Anything else is invalid as an assignment
// target.
fn reinterpret_assign_target(p: Parser*, expr: AstNode*) -> AstNode* {
    if expr == NULL { return NULL; }
    let k = expr.kind;
    if k == NodeKind::Array || k == NodeKind::Object {
        return reinterpret_as_pattern(p, expr);
    }
    if k == NodeKind::Paren {
        return reinterpret_assign_target(p, expr.left);
    }
    if k == NodeKind::IdentExpr
       || k == NodeKind::Member
       || k == NodeKind::Computed
       || k == NodeKind::ArrayPattern
       || k == NodeKind::ObjectPattern {
        return expr;
    }
    p.had_error = true;
    return NULL;
}

fn parse_assignment(p: Parser*) -> AstNode* {
    // Arrow detection — must come before falling through to the
    // expression path, because `x => body` and `(a, b) => body` would
    // otherwise be eagerly consumed as Identifier / Paren expressions.
    if peek_kind(p) == TokenKind::Identifier && peek_at(p, 1).kind == TokenKind::Arrow {
        return parse_arrow_single(p, false);
    }
    if peek_kind(p) == TokenKind::LParen && lookahead_arrow_paren(p) {
        return parse_arrow_paren(p, false);
    }
    // `async x => body` / `async (...) => body` — async arrow.
    if peek_kind(p) == TokenKind::KwAsync {
        let next = peek_at(p, 1);
        if next.kind == TokenKind::Identifier && peek_at(p, 2).kind == TokenKind::Arrow {
            advance(p);                              // consume `async`
            return parse_arrow_single(p, true);
        }
        if next.kind == TokenKind::LParen {
            // Save / restore in case the LParen turns out to be a call.
            let saved_pos = p.pos;
            advance(p);                              // consume `async`
            if lookahead_arrow_paren(p) {
                return parse_arrow_paren(p, true);
            }
            p.pos = saved_pos;                       // rewind to `async`
        }
    }

    let left = parse_conditional(p);
    if left == NULL { return NULL; }
    let k = peek_kind(p);
    if is_assignment_op(k) {
        let op_tok = advance(p);
        // Cover-grammar: for plain `=`, reinterpret an Array/Object
        // literal LHS as the matching AssignmentPattern. Compound
        // assignment (`+=` etc.) doesn't permit destructuring per spec.
        let target = left;
        if op_tok.kind == TokenKind::Eq
           && (left.kind == NodeKind::Array || left.kind == NodeKind::Object) {
            target = reinterpret_as_pattern(p, left);
            if target == NULL { return NULL; }
        }
        let right = parse_assignment(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Assignment, target.start, right.end);
        node.op = op_tok.kind;
        node.left = target;
        node.right = right;
        return node;
    }
    return left;
}

fn is_assignment_op(k: TokenKind) -> bool {
    if k == TokenKind::Eq            { return true; }
    if k == TokenKind::PlusEq        { return true; }
    if k == TokenKind::MinusEq       { return true; }
    if k == TokenKind::StarEq        { return true; }
    if k == TokenKind::StarStarEq    { return true; }
    if k == TokenKind::SlashEq       { return true; }
    if k == TokenKind::PercentEq     { return true; }
    if k == TokenKind::LtLtEq        { return true; }
    if k == TokenKind::GtGtEq        { return true; }
    if k == TokenKind::GtGtGtEq      { return true; }
    if k == TokenKind::AmpEq         { return true; }
    if k == TokenKind::PipeEq        { return true; }
    if k == TokenKind::CaretEq       { return true; }
    if k == TokenKind::AmpAmpEq      { return true; }
    if k == TokenKind::PipePipeEq    { return true; }
    if k == TokenKind::QuestionQuestionEq { return true; }
    return false;
}

// Level 16 — ternary (right-associative).
fn parse_conditional(p: Parser*) -> AstNode* {
    let cond = parse_nullish(p);
    if cond == NULL { return NULL; }
    if !match_kind(p, TokenKind::Question) { return cond; }
    // ECMA-262: the consequent branch's grammar parameter is [+In] even
    // when the outer context is [~In] — so `cond ? 'k' in obj : alt`
    // parses in a `for(...)` head. The alternate branch inherits the
    // outer flag.
    let saved_no_in = p.no_in;
    p.no_in = false;
    let conseq = parse_assignment(p);
    p.no_in = saved_no_in;
    if conseq == NULL { return NULL; }
    if !expect_kind(p, TokenKind::Colon) { return NULL; }
    let alt = parse_assignment(p);
    if alt == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::Conditional, cond.start, alt.end);
    node.left = cond;
    node.right = conseq;
    node.third = alt;
    return node;
}

// Level 15 — nullish coalescing.
fn parse_nullish(p: Parser*) -> AstNode* {
    let left = parse_logical_or(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::QuestionQuestion {
        let op_tok = advance(p);
        let right = parse_logical_or(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Logical, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 14 — logical OR.
fn parse_logical_or(p: Parser*) -> AstNode* {
    let left = parse_logical_and(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::PipePipe {
        let op_tok = advance(p);
        let right = parse_logical_and(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Logical, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 13 — logical AND.
fn parse_logical_and(p: Parser*) -> AstNode* {
    let left = parse_bit_or(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::AmpAmp {
        let op_tok = advance(p);
        let right = parse_bit_or(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Logical, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 12 — bitwise OR.
fn parse_bit_or(p: Parser*) -> AstNode* {
    let left = parse_bit_xor(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::Pipe {
        let op_tok = advance(p);
        let right = parse_bit_xor(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 11 — bitwise XOR.
fn parse_bit_xor(p: Parser*) -> AstNode* {
    let left = parse_bit_and(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::Caret {
        let op_tok = advance(p);
        let right = parse_bit_and(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 10 — bitwise AND.
fn parse_bit_and(p: Parser*) -> AstNode* {
    let left = parse_equality(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::Amp {
        let op_tok = advance(p);
        let right = parse_equality(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 9 — equality.
fn parse_equality(p: Parser*) -> AstNode* {
    let left = parse_relational(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::EqEq && k != TokenKind::BangEq &&
           k != TokenKind::EqEqEq && k != TokenKind::BangEqEq {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_relational(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 8 — relational (`< > <= >= in instanceof`).
//
// The `in` operator is suppressed when p.no_in is true — used by
// parse_for so that `for (x in obj)` parses the binding as `x` and
// then dispatches to for-in, rather than swallowing `x in obj` as a
// Binary here.
fn parse_relational(p: Parser*) -> AstNode* {
    let left = parse_shift(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        let is_in = k == TokenKind::KwIn;
        if k != TokenKind::Lt && k != TokenKind::Gt &&
           k != TokenKind::LtEq && k != TokenKind::GtEq &&
           (!is_in || p.no_in) && k != TokenKind::KwInstanceof {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_shift(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 7 — shift.
fn parse_shift(p: Parser*) -> AstNode* {
    let left = parse_additive(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::LtLt && k != TokenKind::GtGt && k != TokenKind::GtGtGt {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_additive(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 6 — additive.
fn parse_additive(p: Parser*) -> AstNode* {
    let left = parse_multiplicative(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::Plus && k != TokenKind::Minus { return left; }
        let op_tok = advance(p);
        let right = parse_multiplicative(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 5 — multiplicative.
fn parse_multiplicative(p: Parser*) -> AstNode* {
    let left = parse_exponent(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::Star && k != TokenKind::Slash && k != TokenKind::Percent {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_exponent(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 4 — exponentiation (right-associative).
fn parse_exponent(p: Parser*) -> AstNode* {
    let left = parse_unary(p);
    if left == NULL { return NULL; }
    if peek_kind(p) != TokenKind::StarStar { return left; }
    let op_tok = advance(p);
    let right = parse_exponent(p);     // right-associative recursion
    if right == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
    node.op = op_tok.kind;
    node.left = left;
    node.right = right;
    return node;
}

// Level 3 — unary prefix.
fn parse_unary(p: Parser*) -> AstNode* {
    let k = peek_kind(p);
    if k == TokenKind::Bang || k == TokenKind::Tilde ||
       k == TokenKind::Plus || k == TokenKind::Minus ||
       k == TokenKind::PlusPlus || k == TokenKind::MinusMinus ||
       k == TokenKind::KwTypeof || k == TokenKind::KwVoid || k == TokenKind::KwDelete {
        let op_tok = advance(p);
        let operand = parse_unary(p);    // unary is right-assoc
        if operand == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Unary, op_tok.start, operand.end);
        node.op = op_tok.kind;
        node.left = operand;
        return node;
    }
    return parse_postfix(p);
}

// Level 2 — postfix.
fn parse_postfix(p: Parser*) -> AstNode* {
    let operand = parse_call_member(p);
    if operand == NULL { return NULL; }
    let k = peek_kind(p);
    if k == TokenKind::PlusPlus || k == TokenKind::MinusMinus {
        let op_tok = advance(p);
        let node = new_node(&p.tracker, NodeKind::Postfix, operand.start, op_tok.start + op_tok.length);
        node.op = op_tok.kind;
        node.left = operand;
        return node;
    }
    return operand;
}

// Level 1 — `new`, call, member, optional chain.
fn parse_call_member(p: Parser*) -> AstNode* {
    let expr: AstNode* = NULL;

    if peek_kind(p) == TokenKind::KwNew {
        let new_tok = advance(p);
        // `new.target` — meta-property. Returns the `[[NewTarget]]`
        // internal slot of the executing function (the ctor if called
        // via `new`, undefined otherwise). Encoded as a dedicated
        // ThisExpr-shaped node since it's a zero-arg primitive.
        if peek_kind(p) == TokenKind::Dot {
            let dot = peek_at(p, 1);
            let target_tok = peek_at(p, 1);
            if target_tok.kind == TokenKind::Identifier && target_tok.length == 6 {
                let nm_data = p.source + target_tok.start;
                let is_target: int = 0;
                raw { is_target = (memcmp(nm_data, "target", 6) == 0) ? 1 : 0; }
                if is_target != 0 {
                    advance(p);                    // consume '.'
                    advance(p);                    // consume 'target'
                    let nt = new_node(&p.tracker, NodeKind::ThisExpr, new_tok.start, target_tok.start + 6);
                    // Reuse ThisExpr kind with bool_value=true to mean
                    // "new.target" — the compiler dispatches on this.
                    nt.bool_value = true;
                    return nt;
                }
            }
        }
        // The callee can itself contain member access but NOT a call —
        // `new Foo.bar()` is `new (Foo.bar)()`. We loop manually here
        // for member access only, then accept an optional arg list.
        let callee = parse_primary(p);
        if callee == NULL { return NULL; }
        while true {
            let kk = peek_kind(p);
            if kk == TokenKind::Dot {
                advance(p);
                let id_tok = advance(p);
                let mnode = new_node(&p.tracker, NodeKind::Member, callee.start, id_tok.start + id_tok.length);
                mnode.left = callee;
                mnode.name_start = id_tok.start;
                mnode.name_length = id_tok.length;
                callee = mnode;
            } else if kk == TokenKind::LBracket {
                advance(p);
                let prop = parse_expression(p);
                if prop == NULL { return NULL; }
                let close = peek(p);
                if !expect_kind(p, TokenKind::RBracket) { return NULL; }
                let cnode = new_node(&p.tracker, NodeKind::Computed, callee.start, close.start + close.length);
                cnode.left = callee;
                cnode.right = prop;
                callee = cnode;
            } else {
                break;
            }
        }
        let new_node_n = new_node(&p.tracker, NodeKind::New, new_tok.start, callee.end);
        new_node_n.left = callee;
        if peek_kind(p) == TokenKind::LParen {
            let args_pair = parse_arguments(p);
            new_node_n.children = args_pair.left_arr;
            new_node_n.children_count = args_pair.count;
            new_node_n.end = args_pair.end;
        }
        expr = new_node_n;
    } else {
        expr = parse_primary(p);
        if expr == NULL { return NULL; }
    }

    // Now consume call / member / optional-chain suffixes.
    while true {
        let k = peek_kind(p);
        if k == TokenKind::Dot {
            advance(p);
            let id_tok = advance(p);
            let mnode = new_node(&p.tracker, NodeKind::Member, expr.start, id_tok.start + id_tok.length);
            mnode.left = expr;
            mnode.name_start = id_tok.start;
            mnode.name_length = id_tok.length;
            expr = mnode;
        } else if k == TokenKind::LBracket {
            advance(p);
            let prop = parse_expression(p);
            if prop == NULL { return NULL; }
            let close = peek(p);
            if !expect_kind(p, TokenKind::RBracket) { return NULL; }
            let cnode = new_node(&p.tracker, NodeKind::Computed, expr.start, close.start + close.length);
            cnode.left = expr;
            cnode.right = prop;
            expr = cnode;
        } else if k == TokenKind::LParen {
            // ECMA-262 §13.3.7 / §15.7.1: SuperCall (`super(...)`) is
            // only valid in a derived-class constructor body. Anywhere
            // else (regular methods, async/gen methods, non-derived
            // ctor, top-level) it's a parse-time SyntaxError.
            if expr != NULL && expr.kind == NodeKind::SuperExpr && !p.in_derived_constructor {
                p.had_error = true;
                return NULL;
            }
            let args_pair = parse_arguments(p);
            let cnode = new_node(&p.tracker, NodeKind::Call, expr.start, args_pair.end);
            cnode.left = expr;
            cnode.children = args_pair.left_arr;
            cnode.children_count = args_pair.count;
            expr = cnode;
        } else if k == TokenKind::QuestionDot {
            advance(p);
            let after = peek_kind(p);
            if after == TokenKind::LParen {
                let args_pair = parse_arguments(p);
                let cnode = new_node(&p.tracker, NodeKind::OptionalCall, expr.start, args_pair.end);
                cnode.left = expr;
                cnode.children = args_pair.left_arr;
                cnode.children_count = args_pair.count;
                expr = cnode;
            } else if after == TokenKind::LBracket {
                advance(p);
                let prop = parse_expression(p);
                if prop == NULL { return NULL; }
                let close = peek(p);
                if !expect_kind(p, TokenKind::RBracket) { return NULL; }
                let cnode = new_node(&p.tracker, NodeKind::OptionalComputed, expr.start, close.start + close.length);
                cnode.left = expr;
                cnode.right = prop;
                expr = cnode;
            } else {
                let id_tok = advance(p);
                let mnode = new_node(&p.tracker, NodeKind::OptionalMember, expr.start, id_tok.start + id_tok.length);
                mnode.left = expr;
                mnode.name_start = id_tok.start;
                mnode.name_length = id_tok.length;
                expr = mnode;
            }
        } else {
            return expr;
        }
    }
    return expr;
}

// Arguments parser — used by Call / OptionalCall / New.
//
// Returns a small struct so we can pass back the array, its count, and
// the end byte offset all together.

struct ArgsResult {
    left_arr: AstNode**;
    count:    u32;
    end:      u32;
}

fn parse_arguments(p: Parser*) -> ArgsResult {
    let lparen = advance(p);     // consume '('
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    if peek_kind(p) != TokenKind::RParen {
        while true {
            let arg: AstNode* = NULL;
            if peek_kind(p) == TokenKind::Ellipsis {
                let dots = advance(p);
                let inner = parse_assignment(p);
                if inner == NULL { break; }
                let s = new_node(&p.tracker, NodeKind::Spread, dots.start, inner.end);
                s.left = inner;
                arg = s;
            } else {
                arg = parse_assignment(p);
                if arg == NULL { break; }
            }
            if count >= cap {
                cap = cap * 2;
                raw {
                    buf = (AstNode**)realloc(buf, cap * sizeof(AstNode*));
                }
            }
            buf[count] = arg;
            count = count + 1;
            if !match_kind(p, TokenKind::Comma) { break; }
        }
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RParen);

    if count == 0 {
        dealloc(buf);
        buf = NULL;
    } else {
        alloc_list_push(&p.tracker, (void*)buf);
    }
    return ArgsResult{ left_arr: buf, count: count, end: close.start + close.length };
}

// =====================================================================
// Template literal — `... ${expr} ...`
//
// The lexer emits a single TemplateLit token whose slice spans the
// entire `...` (inclusive). We walk that slice here, splitting on
// `${ }` to produce alternating TemplatePart (literal) and expression
// children. Each embedded expression is re-tokenized + parsed in
// isolation; absolute source offsets are preserved so error messages
// and decoded constants point at the right place.
// =====================================================================

fn parse_template_lit(p: Parser*) -> AstNode* {
    let t = advance(p);
    let body_start: u32 = t.start + 1;
    let body_end:   u32 = if t.length >= 2 { t.start + t.length - 1 } else { t.start + 1 };
    let node = new_node(&p.tracker, NodeKind::TemplateExpr, t.start, t.start + t.length);

    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    let cur: u32 = body_start;
    let seg_start: u32 = cur;
    while cur < body_end {
        let c = (u8)p.source[cur];
        if c == (u8)'\\' {
            cur = cur + 1;
            if cur < body_end { cur = cur + 1; }
            continue;
        }
        if c == (u8)'$' && cur + 1 < body_end && (u8)p.source[cur + 1] == (u8)'{' {
            // Emit the preceding literal part (possibly empty).
            let part = new_node(&p.tracker, NodeKind::TemplatePartExpr, seg_start, cur);
            if count >= cap {
                let oc = cap; cap = cap * 2;
                buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap);
            }
            buf[count] = part; count = count + 1;

            // Walk past `${`, balance braces to find the matching `}`.
            cur = cur + 2;
            let expr_start: u32 = cur;
            let depth: u32 = 1;
            while cur < body_end {
                let ec = (u8)p.source[cur];
                if ec == (u8)'\\' {
                    cur = cur + 1;
                    if cur < body_end { cur = cur + 1; }
                    continue;
                }
                if ec == (u8)'{' { depth = depth + 1; cur = cur + 1; continue; }
                if ec == (u8)'}' {
                    depth = depth - 1;
                    if depth == 0 { break; }
                    cur = cur + 1;
                    continue;
                }
                // Quoted strings: skip to matching quote so a `}` inside
                // a string literal doesn't end the substitution early.
                if ec == (u8)'"' || ec == (u8)'\'' {
                    let q = ec;
                    cur = cur + 1;
                    while cur < body_end && (u8)p.source[cur] != q {
                        if (u8)p.source[cur] == (u8)'\\' {
                            cur = cur + 1;
                            if cur < body_end { cur = cur + 1; }
                        } else {
                            cur = cur + 1;
                        }
                    }
                    if cur < body_end { cur = cur + 1; }
                    continue;
                }
                // Nested template — skip through it as one unit, handling
                // its own ${ } substitutions recursively (depth-only
                // tracking; full re-parse happens when the OUTER node's
                // expression gets parsed).
                if ec == (u8)'`' {
                    cur = cur + 1;
                    while cur < body_end && (u8)p.source[cur] != (u8)'`' {
                        let tc = (u8)p.source[cur];
                        if tc == (u8)'\\' {
                            cur = cur + 1;
                            if cur < body_end { cur = cur + 1; }
                            continue;
                        }
                        if tc == (u8)'$' && cur + 1 < body_end && (u8)p.source[cur + 1] == (u8)'{' {
                            // Skip nested ${ ... } at brace depth.
                            cur = cur + 2;
                            let nd: u32 = 1;
                            while cur < body_end && nd > 0 {
                                let nc = (u8)p.source[cur];
                                if nc == (u8)'\\' { cur = cur + 1; if cur < body_end { cur = cur + 1; } continue; }
                                if nc == (u8)'{' { nd = nd + 1; }
                                if nc == (u8)'}' { nd = nd - 1; if nd == 0 { cur = cur + 1; break; } }
                                cur = cur + 1;
                            }
                            continue;
                        }
                        cur = cur + 1;
                    }
                    if cur < body_end { cur = cur + 1; }
                    continue;
                }
                cur = cur + 1;
            }
            let expr_end: u32 = cur;
            if cur < body_end { cur = cur + 1; } // past `}`

            // Re-tokenize + parse the expression slice as a standalone
            // assignment expression. Tokens are produced with offsets
            // relative to the slice start; bump them to absolute so
            // downstream identifier/string slicing reads correctly.
            let expr = parse_template_expr_slice(p, expr_start, expr_end);
            if expr == NULL {
                p.had_error = true;
                node.children = buf;
                node.children_count = count;
                return node;
            }
            if count >= cap {
                let oc = cap; cap = cap * 2;
                buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap);
            }
            buf[count] = expr; count = count + 1;

            seg_start = cur;
            continue;
        }
        cur = cur + 1;
    }
    // Trailing literal part (possibly empty — keeps the
    // "N+1 parts, N expressions" invariant).
    let tail = new_node(&p.tracker, NodeKind::TemplatePartExpr, seg_start, body_end);
    if count >= cap {
        let oc = cap; cap = cap * 2;
        buf = realloc_n<AstNode*>(buf, (usize)oc, (usize)cap);
    }
    buf[count] = tail; count = count + 1;

    alloc_list_push(&p.tracker, (void*)buf);
    node.children = buf;
    node.children_count = count;
    return node;
}

// Re-tokenize [expr_start, expr_end) on the parser's source and parse
// it as an assignment expression. Tokens get their offsets shifted to
// absolute so the resulting AST keeps real source positions. Restores
// the parser's token stream + cursor on exit.
fn parse_template_expr_slice(p: Parser*, expr_start: u32, expr_end: u32) -> AstNode* {
    let slice_len: usize = (usize)(expr_end - expr_start);
    let saved_tokens = p.tokens;
    let saved_token_count = p.token_count;
    let saved_pos = p.pos;
    let saved_no_in = p.no_in;

    let cap: usize = 128;
    let toks = alloc_n<Token>(cap);
    let slice_src: char* = NULL;
    raw { slice_src = &(p->source[expr_start]); }
    let n = tokenize_into(slice_src, slice_len, toks, cap);
    let i: usize = 0;
    while i < n {
        // Shift to absolute offsets so AST + error messages point at
        // the right place in the outer source.
        toks[i].start = toks[i].start + expr_start;
        i = i + 1;
    }

    p.tokens = toks;
    p.token_count = n;
    p.pos = 0;
    p.no_in = false;

    let expr = parse_assignment(p);

    p.tokens = saved_tokens;
    p.token_count = saved_token_count;
    p.pos = saved_pos;
    p.no_in = saved_no_in;

    // toks buffer is registered with the tracker so it stays alive for
    // the AST's lifetime (token ranges aren't dereferenced post-parse,
    // but the buffer's lifetime should track the AST anyway).
    alloc_list_push(&p.tracker, (void*)toks);
    return expr;
}

// ECMA-262 Static Semantics: ContainsArguments — used for class field
// initializer early errors. Returns true if any IdentifierReference
// named `arguments` appears in the subtree. Recurses through arrow
// functions (which don't introduce their own `arguments`) but stops
// at FunctionDecl / FunctionExpr / MethodDef (which do).
fn expr_contains_arguments(p: Parser*, node: AstNode*) -> bool {
    if node == NULL { return false; }
    let k = node.kind;
    if k == NodeKind::FunctionDecl || k == NodeKind::FunctionExpr || k == NodeKind::MethodDef {
        return false;
    }
    if k == NodeKind::IdentExpr {
        let n = p.source + node.start;
        let nl = node.end - node.start;
        if nl == 9 {
            let is_arg: int = 0;
            raw { is_arg = (memcmp(n, "arguments", 9) == 0) ? 1 : 0; }
            if is_arg != 0 { return true; }
        }
        return false;
    }
    if node.left  != NULL && expr_contains_arguments(p, node.left)  { return true; }
    if node.right != NULL && expr_contains_arguments(p, node.right) { return true; }
    if node.third != NULL && expr_contains_arguments(p, node.third) { return true; }
    let i: u32 = 0;
    while i < node.children_count {
        if expr_contains_arguments(p, node.children[i]) { return true; }
        i = i + 1;
    }
    return false;
}

// Level 0 — primary.
fn parse_primary(p: Parser*) -> AstNode* {
    let t = peek(p);
    let k = t.kind;

    if k == TokenKind::KwFunction { return parse_function_expr(p, false); }
    // `async function f() {}` / `async function() {}` in expression context.
    if k == TokenKind::KwAsync && peek_kind2(p) == TokenKind::KwFunction {
        advance(p);
        return parse_function_expr(p, true);
    }
    // `await expr` — only valid inside an async function body. Otherwise
    // `await` falls through and is treated as an identifier reference
    // (the contextual-keyword rule).
    if k == TokenKind::KwAwait && p.in_async {
        let kw_t = advance(p);
        let inner = parse_unary(p);
        if inner == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::AwaitExpr, kw_t.start, inner.end);
        node.left = inner;
        return node;
    }
    // `yield expr` / `yield* iterable` / `yield` — only inside a generator
    // body. Argument is optional and right-associative at
    // AssignmentExpression precedence per spec. We approximate by
    // bailing on tokens that obviously end the operand (comma, semi,
    // close-bracket / paren / brace).
    if k == TokenKind::KwYield && p.in_generator {
        let kw_t = advance(p);
        let is_delegate: bool = false;
        if peek_kind(p) == TokenKind::Star {
            advance(p);
            is_delegate = true;
        }
        let node = new_node(&p.tracker, NodeKind::YieldExpr, kw_t.start, kw_t.start + kw_t.length);
        node.bool_value = is_delegate;
        node.left = NULL;
        let next = peek_kind(p);
        if next != TokenKind::Comma && next != TokenKind::Semicolon
           && next != TokenKind::RParen && next != TokenKind::RBracket
           && next != TokenKind::RBrace && next != TokenKind::Colon
           && next != TokenKind::Eof {
            let arg = parse_assignment(p);
            if arg != NULL {
                node.left = arg;
                node.end = arg.end;
            }
        }
        return node;
    }
    if k == TokenKind::KwClass    { return parse_class_expr(p); }

    if k == TokenKind::NumberLit {
        advance(p);
        let node = new_node(&p.tracker, NodeKind::NumberExpr, t.start, t.start + t.length);
        node.num = parse_number_literal(p.source, t.start, t.length);
        return node;
    }
    if k == TokenKind::StringLit {
        advance(p);
        return new_node(&p.tracker, NodeKind::StringExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::TemplateLit {
        return parse_template_lit(p);
    }
    if k == TokenKind::RegexLit {
        // Source slice is `/pattern/flags` — the compiler splits it.
        advance(p);
        return new_node(&p.tracker, NodeKind::RegexExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwTrue {
        advance(p);
        let node = new_node(&p.tracker, NodeKind::BoolExpr, t.start, t.start + t.length);
        node.bool_value = true;
        return node;
    }
    if k == TokenKind::KwFalse {
        advance(p);
        let node = new_node(&p.tracker, NodeKind::BoolExpr, t.start, t.start + t.length);
        node.bool_value = false;
        return node;
    }
    if k == TokenKind::KwNull {
        advance(p);
        return new_node(&p.tracker, NodeKind::NullExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwUndefined {
        advance(p);
        return new_node(&p.tracker, NodeKind::UndefinedExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwThis {
        advance(p);
        return new_node(&p.tracker, NodeKind::ThisExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwSuper {
        advance(p);
        // Bare `super` is only valid in a class method context; the
        // distinction (call vs member) is made by parse_call_member
        // when it sees the trailing `(` / `.` / `[`.
        return new_node(&p.tracker, NodeKind::SuperExpr, t.start, t.start + t.length);
    }
    if is_binding_ident(k) {
        // Identifier OR a contextual keyword being used as a reference
        // (`of`, `let`, `yield`, `await`, `async` in non-keyword
        // positions). See is_binding_ident.
        advance(p);
        let id_node = new_node(&p.tracker, NodeKind::IdentExpr, t.start, t.start + t.length);
        id_node.name_start  = t.start;
        id_node.name_length = t.length;
        return id_node;
    }
    if k == TokenKind::LParen {
        advance(p);
        let inner = parse_expression(p);
        if inner == NULL { return NULL; }
        let close = peek(p);
        if !expect_kind(p, TokenKind::RParen) { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Paren, t.start, close.start + close.length);
        node.left = inner;
        return node;
    }
    if k == TokenKind::LBracket {
        return parse_array(p);
    }
    if k == TokenKind::LBrace {
        return parse_object(p);
    }

    // Anything else: error.
    p.had_error = true;
    advance(p);
    return NULL;
}

fn parse_array(p: Parser*) -> AstNode* {
    let lbrack = advance(p);        // consume '['
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBracket && peek_kind(p) != TokenKind::Eof {
        // Elision: `,` in place of an element means an empty slot
        // (spec calls this an "array hole"). Distinct from explicit
        // `undefined` — holes are absent from HasProperty / Object.keys.
        let elem: AstNode* = NULL;
        if peek_kind(p) == TokenKind::Comma {
            elem = new_node(&p.tracker, NodeKind::HoleExpr,
                            peek(p).start, peek(p).start);
        } else if peek_kind(p) == TokenKind::Ellipsis {
            // `...expr` — spread element. Compiler iterates the value
            // and appends each element to the array under construction.
            let dots = advance(p);
            let inner = parse_assignment(p);
            if inner == NULL { break; }
            let s = new_node(&p.tracker, NodeKind::Spread, dots.start, inner.end);
            s.left = inner;
            elem = s;
        } else {
            elem = parse_assignment(p);
            if elem == NULL { break; }
        }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = elem;
        count = count + 1;
        if !match_kind(p, TokenKind::Comma) { break; }
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RBracket);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::Array, lbrack.start, close.start + close.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

fn parse_object(p: Parser*) -> AstNode* {
    let lbrace = advance(p);        // consume '{'
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
        // Object spread: `{ ...src, key: value }`. The Spread node is
        // installed as a property entry; the compiler emits ObjectSpread
        // when it walks it.
        if peek_kind(p) == TokenKind::Ellipsis {
            let dots = advance(p);
            let inner = parse_assignment(p);
            if inner == NULL { break; }
            let s = new_node(&p.tracker, NodeKind::Spread, dots.start, inner.end);
            s.left = inner;
            if count >= cap {
                let old_cap = cap;
                cap = cap * 2;
                buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
            }
            buf[count] = s;
            count = count + 1;
            if !match_kind(p, TokenKind::Comma) { break; }
            continue;
        }
        // Computed property name: `{ [expr]: value }` or
        // `{ [expr](args) { body } }`. The key expression is evaluated
        // at object-build time and ToPropertyKey'd.
        if peek_kind(p) == TokenKind::LBracket {
            let lb = advance(p);
            let key_expr = parse_assignment(p);
            if key_expr == NULL { break; }
            if !expect_kind(p, TokenKind::RBracket) { break; }

            let value: AstNode* = NULL;
            if match_kind(p, TokenKind::Colon) {
                value = parse_assignment(p);
                if value == NULL { break; }
            } else if peek_kind(p) == TokenKind::LParen {
                // Method shorthand with computed name.
                advance(p);
                let params = parse_param_list(p);
                if !expect_kind(p, TokenKind::RParen) { break; }
                if peek_kind(p) != TokenKind::LBrace { p.had_error = true; break; }
                p.function_depth = p.function_depth + 1;
                let body = parse_block(p);
                p.function_depth = p.function_depth - 1;
                if body == NULL { break; }
                let mfn = new_node(&p.tracker, NodeKind::FunctionExpr, lb.start, body.end);
                mfn.left = body;
                mfn.children = params.arr;
                mfn.children_count = params.count;
                value = mfn;
            } else {
                p.had_error = true; break;
            }

            let prop = new_node(&p.tracker, NodeKind::ObjectProp, lb.start, value.end);
            prop.name_start = 0;
            prop.name_length = 0;          // sentinel: computed key
            prop.left  = value;
            prop.third = key_expr;          // computed key lives here
            if count >= cap {
                let old_cap = cap;
                cap = cap * 2;
                buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
            }
            buf[count] = prop;
            count = count + 1;
            if !match_kind(p, TokenKind::Comma) { break; }
            continue;
        }
        let key_tok = peek(p);
        // Key: any IdentifierName (Identifier or reserved word),
        // string literal, or numeric literal.
        if !is_property_name_start(key_tok.kind) {
            p.had_error = true;
            break;
        }

        // Accessor shorthand: `get foo() {...}` / `set foo(v) {...}`.
        // Detected when key is the identifier `get` or `set` AND the
        // next token is an identifier (the property name) rather than
        // `:` / `(` / `,` / `}`. Compiles into the existing accessor
        // path via a synthetic Object.defineProperty-shaped node.
        let is_accessor: bool = false;
        let is_setter: bool = false;
        if key_tok.kind == TokenKind::Identifier && key_tok.length == 3 {
            let kd = p.source + key_tok.start;
            let g_match: int = 0;
            let s_match: int = 0;
            raw {
                g_match = (memcmp(kd, "get", 3) == 0) ? 1 : 0;
                s_match = (memcmp(kd, "set", 3) == 0) ? 1 : 0;
            }
            if (g_match != 0 || s_match != 0) {
                let after = peek_kind2(p);
                if after == TokenKind::Identifier
                    || after == TokenKind::StringLit
                    || after == TokenKind::NumberLit
                    || after == TokenKind::LBracket {
                    is_accessor = true;
                    is_setter = s_match != 0;
                }
            }
        }

        advance(p);

        let prop_start = key_tok.start;
        let prop_end = key_tok.start + key_tok.length;

        // Handle accessor first — replaces key_tok-as-name with the
        // real property name following `get`/`set`, and parses the
        // getter/setter function shape.
        if is_accessor {
            let real_name_tok = peek(p);
            let acc_computed_key: AstNode* = NULL;
            if real_name_tok.kind == TokenKind::LBracket {
                advance(p);                      // consume '['
                acc_computed_key = parse_assignment(p);
                if acc_computed_key == NULL { break; }
                if !expect_kind(p, TokenKind::RBracket) { break; }
            } else {
                advance(p);
            }
            if !expect_kind(p, TokenKind::LParen) { break; }
            let params = parse_param_list(p);
            if !expect_kind(p, TokenKind::RParen) { break; }
            if peek_kind(p) != TokenKind::LBrace { p.had_error = true; break; }
            p.function_depth = p.function_depth + 1;
            let body = parse_block(p);
            p.function_depth = p.function_depth - 1;
            if body == NULL { break; }

            let accessor_fn = new_node(&p.tracker, NodeKind::FunctionExpr,
                                       real_name_tok.start, body.end);
            accessor_fn.name_start  = if acc_computed_key != NULL { 0 } else { real_name_tok.start };
            accessor_fn.name_length = if acc_computed_key != NULL { 0 } else { real_name_tok.length };
            accessor_fn.left = body;
            accessor_fn.children = params.arr;
            accessor_fn.children_count = params.count;

            let prop = new_node(&p.tracker, NodeKind::ObjectProp,
                                key_tok.start, body.end);
            if acc_computed_key != NULL {
                // Computed-key accessor — same sentinel object-literal
                // already uses for computed plain props: name_length=0
                // with the key expression on `third`.
                prop.name_start  = 0;
                prop.name_length = 0;
                prop.third       = acc_computed_key;
            } else {
                prop.name_start = real_name_tok.start;
                prop.name_length = real_name_tok.length;
            }
            prop.left = accessor_fn;
            // op carries the accessor kind so compile_object can wire
            // it through Op::SetGet / Op::SetSet (or whatever path).
            // We reuse TokenKind::KwGet / KwSet if available, else the
            // simpler boolean stashing below.
            if is_setter { prop.op = TokenKind::KwSet; }
            else         { prop.op = TokenKind::KwGet; }

            if count >= cap {
                let old_cap = cap;
                cap = cap * 2;
                buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
            }
            buf[count] = prop;
            count = count + 1;

            if !match_kind(p, TokenKind::Comma) { break; }
            continue;
        }

        let value: AstNode* = NULL;
        if match_kind(p, TokenKind::Colon) {
            value = parse_assignment(p);
            if value == NULL { break; }
            prop_end = value.end;
        } else if peek_kind(p) == TokenKind::LParen {
            // Method shorthand: { foo() {} } desugars to { foo: function foo() {} }.
            // ECMA-262 §13.2.5 MethodDefinition.
            if !expect_kind(p, TokenKind::LParen) { break; }
            let params = parse_param_list(p);
            if !expect_kind(p, TokenKind::RParen) { break; }
            if peek_kind(p) != TokenKind::LBrace { p.had_error = true; break; }
            p.function_depth = p.function_depth + 1;
            let body = parse_block(p);
            p.function_depth = p.function_depth - 1;
            if body == NULL { break; }
            let method_fn = new_node(&p.tracker, NodeKind::FunctionExpr, key_tok.start, body.end);
            method_fn.name_start  = key_tok.start;
            method_fn.name_length = key_tok.length;
            method_fn.left = body;
            method_fn.children = params.arr;
            method_fn.children_count = params.count;
            value = method_fn;
            prop_end = body.end;
        } else {
            // Shorthand: { x } = { x: x }. Only valid if key is an Identifier.
            // Object-literal cover-grammar also reaches here for the
            // shorthand `{ x = init }` form (where `x` is both the
            // property key and a binding/assignment target with a
            // default). The default carries on prop.right (parsed
            // below) so reinterpret_as_pattern can lift it.
            if key_tok.kind != TokenKind::Identifier {
                p.had_error = true;
                break;
            }
            let ident_node = new_node(&p.tracker, NodeKind::IdentExpr,
                                      key_tok.start,
                                      key_tok.start + key_tok.length);
            ident_node.name_start  = key_tok.start;
            ident_node.name_length = key_tok.length;
            value = ident_node;
        }

        let prop = new_node(&p.tracker, NodeKind::ObjectProp, prop_start, prop_end);
        prop.name_start = key_tok.start;
        prop.name_length = key_tok.length;
        prop.left = value;

        if count >= cap {
            cap = cap * 2;
            raw {
                buf = (AstNode**)realloc(buf, cap * sizeof(AstNode*));
            }
        }
        buf[count] = prop;
        count = count + 1;

        if !match_kind(p, TokenKind::Comma) { break; }
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RBrace);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::Object, lbrace.start, close.start + close.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

// =====================================================================
// Numeric literal decoding. Called once per NumberLit at parse time so
// the AST already carries the unboxed f64.
// =====================================================================

fn parse_number_literal(source: char*, start: u32, length: u32) -> f64 {
    // Copy the slice into a stack buffer + null-terminator; call strtod
    // (or hand-roll for prefixed forms). Source slices may not be
    // null-terminated; we have to copy. Strip numeric-separator `_`
    // characters on the way in — the lexer accepts them anywhere in
    // the digit run; strtod / parse_int_prefix don't.
    let buf: u8[64];
    let copy_len: u32 = 0;
    let i: u32 = 0;
    while i < length && copy_len < 63 {
        let c = (u8)source[start + i];
        if c != (u8)'_' {
            buf[copy_len] = c;
            copy_len = copy_len + 1;
        }
        i = i + 1;
    }
    buf[copy_len] = 0;

    // Hex / binary / octal — first two chars are 0x / 0b / 0o.
    if length >= 2 && buf[0] == (u8)'0' {
        let c1 = buf[1];
        if c1 == (u8)'x' || c1 == (u8)'X' { return parse_int_prefix(&buf[2], copy_len - 2, 16); }
        if c1 == (u8)'b' || c1 == (u8)'B' { return parse_int_prefix(&buf[2], copy_len - 2, 2); }
        if c1 == (u8)'o' || c1 == (u8)'O' { return parse_int_prefix(&buf[2], copy_len - 2, 8); }
    }

    // Decimal / scientific via strtod.
    let result: f64 = 0.0;
    raw {
        result = strtod((const char*)&buf[0], NULL);
    }
    return result;
}

fn parse_int_prefix(digits: u8*, len: u32, base: u32) -> f64 {
    let acc: f64 = 0.0;
    let i: u32 = 0;
    while i < len {
        let c = digits[i];
        let d: u32 = 0;
        if c >= (u8)'0' && c <= (u8)'9' { d = (u32)(c - (u8)'0'); }
        else if c >= (u8)'a' && c <= (u8)'f' { d = (u32)(c - (u8)'a') + 10; }
        else if c >= (u8)'A' && c <= (u8)'F' { d = (u32)(c - (u8)'A') + 10; }
        else { return acc; }
        acc = acc * (f64)base + (f64)d;
        i = i + 1;
    }
    return acc;
}
