// Parser — recursive descent over the ECMA-262 expression grammar.
//
// One Parser instance owns one parse. After parse_program returns, the
// caller must hold onto the ParseResult and eventually call
// parser_free_result to release every node and children-array the
// parser allocated.

import "./token.zc";
import "./lexer.zc";
import "./ast.zc";
import "std/mem.zc"

raw {
    #include <stdlib.h>
    #include <string.h>
}

// --- Token buffer ---------------------------------------------------
//
// For Phase 2.3 we lex the whole source into a vector up front and
// then drive a cursor over it. This makes lookahead trivial (peek_at).
// Lazy lexing can come later if it ever shows up in a profile.

def MAX_TOKENS: usize = 65536;

struct Parser {
    source:        char*;
    source_len:    usize;
    tokens:        Token*;       // heap-allocated buffer
    token_count:   usize;
    pos:           usize;
    tracker:       AllocList;
    had_error:     bool;
    // ECMA-262 "[NoIn]" parameter: when true, parse_relational won't
    // consume `in` as a binary operator. Set by parse_for around its
    // init slot so that `for (x in obj)` doesn't get eaten as
    // `for ((x in obj))`.
    no_in:         bool;
    // Depth of enclosing function bodies — incremented on entry to a
    // function / method body, decremented on exit. Top-level
    // (function_depth == 0) bare `return` is a SyntaxError.
    function_depth: u32;
}

struct ParseResult {
    root:          AstNode*;
    parser:        Parser*;
    had_error:     bool;
}

// --- Top-level entry ------------------------------------------------

fn parse_program(source: char*, source_len: usize) -> ParseResult {
    let p = alloc<Parser>();
    p.source = source;
    p.source_len = source_len;
    p.tracker = alloc_list_new();
    p.had_error = false;

    // Lex everything into a buffer.
    p.tokens = alloc_n<Token>(MAX_TOKENS);
    p.token_count = tokenize_into(source, source_len, p.tokens, MAX_TOKENS);
    p.pos = 0;

    // Parse a sequence of expression statements terminated by `;` or EOF.
    let program = new_node(&p.tracker, NodeKind::Program, 0, (u32)source_len);

    // Reserve a temporary children buffer on the parser's tracker.
    // We don't know the exact count up front, so grow into a Vec-style
    // pattern as we go.
    let cap: u32 = 8;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::Eof && !p.had_error {
        let stmt = parse_statement(p);
        if stmt == NULL { break; }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = stmt;
        count = count + 1;
    }

    // Register the final buffer with the tracker and copy into the node.
    alloc_list_push(&p.tracker, (void*)buf);
    program.children = buf;
    program.children_count = count;

    return ParseResult{ root: program, parser: p, had_error: p.had_error };
}

fn parser_free_result(r: ParseResult) -> void {
    alloc_list_free_all(&r.parser.tracker);
    dealloc(r.parser.tokens);
    dealloc(r.parser);
}

// --- Cursor primitives ----------------------------------------------

fn peek(p: Parser*) -> Token {
    if p.pos >= p.token_count {
        // Synthetic Eof beyond the buffer.
        return token_eof((u32)p.source_len);
    }
    return p.tokens[p.pos];
}

// Look ahead one token without consuming. Used by labeled-statement
// detection (`ident :`) where a one-token peek isn't enough.
fn peek_kind2(p: Parser*) -> TokenKind {
    if p.pos + 1 >= p.token_count {
        return TokenKind::Eof;
    }
    return p.tokens[p.pos + 1].kind;
}

// Is there a newline between two source offsets? Used for the
// `break` / `continue` label rule — the optional label must be on
// the SAME source line as the keyword (ASI inserts a `;` otherwise).
fn has_newline_between(p: Parser*, a: u32, b: u32) -> bool {
    let i = a;
    while i < b {
        let c = p.source[i];
        if (u8)c == 10 || (u8)c == 13 { return true; }
        i = i + 1;
    }
    return false;
}

fn peek_kind(p: Parser*) -> TokenKind {
    return peek(p).kind;
}

fn peek_at(p: Parser*, offset: usize) -> Token {
    let i = p.pos + offset;
    if i >= p.token_count {
        return token_eof((u32)p.source_len);
    }
    return p.tokens[i];
}

fn advance(p: Parser*) -> Token {
    let t = peek(p);
    if p.pos < p.token_count { p.pos = p.pos + 1; }
    return t;
}

fn match_kind(p: Parser*, k: TokenKind) -> bool {
    if peek_kind(p) != k { return false; }
    advance(p);
    return true;
}

fn expect_kind(p: Parser*, k: TokenKind) -> bool {
    if peek_kind(p) != k {
        p.had_error = true;
        return false;
    }
    advance(p);
    return true;
}

// Lenient statement terminator. Consumes `;` if present; tolerates a
// missing `;` before `}` or EOF (a stand-in for real ASI, which we
// can't do yet because the lexer doesn't track newline positions).
fn match_terminator(p: Parser*) -> void {
    if peek_kind(p) == TokenKind::Semicolon { advance(p); return; }
    // No-op for EOF / RBrace. Anything else slips through too — a real
    // ASI implementation would check newline-before-token here.
}

// =====================================================================
// Statement parsing. Dispatches on the leading token.
// =====================================================================

fn parse_statement(p: Parser*) -> AstNode* {
    let k = peek_kind(p);

    if k == TokenKind::LBrace      { return parse_block(p); }
    if k == TokenKind::KwVar       { return parse_var_decl(p, true); }
    if k == TokenKind::KwLet       { return parse_var_decl(p, true); }
    if k == TokenKind::KwConst     { return parse_var_decl(p, true); }
    if k == TokenKind::KwFunction  { return parse_function_decl(p); }
    if k == TokenKind::KwClass     { return parse_class_decl(p); }
    if k == TokenKind::KwIf        { return parse_if(p); }
    if k == TokenKind::KwReturn    { return parse_return(p); }
    if k == TokenKind::KwWhile     { return parse_while(p); }
    if k == TokenKind::KwDo        { return parse_do_while(p); }
    if k == TokenKind::KwFor       { return parse_for(p); }
    if k == TokenKind::KwBreak     { return parse_break(p); }
    if k == TokenKind::KwContinue  { return parse_continue(p); }
    if k == TokenKind::KwThrow     { return parse_throw(p); }
    if k == TokenKind::KwTry       { return parse_try(p); }
    if k == TokenKind::Semicolon {
        let semi = advance(p);
        return new_node(&p.tracker, NodeKind::EmptyStmt, semi.start, semi.start + semi.length);
    }
    if k == TokenKind::Eof { return NULL; }

    // Labeled statement: `IDENT : statement`. Detected by a 2-token
    // lookahead — Identifier followed by Colon.
    if k == TokenKind::Identifier && peek_kind2(p) == TokenKind::Colon {
        let id = advance(p);     // identifier
        advance(p);              // ':'
        let body = parse_statement(p);
        if body == NULL { return NULL; }
        // Strict-mode: a LabelledStatement's body is a Statement, not
        // a Declaration. `label: function f() {}` and friends are a
        // SyntaxError. (Sloppy-mode Annex B allows function decls, but
        // we're effectively strict everywhere.)
        if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }
        let node = new_node(&p.tracker, NodeKind::LabeledStmt, id.start, body.end);
        node.name_start  = id.start;
        node.name_length = id.length;
        node.left = body;
        return node;
    }

    // Default: expression statement.
    let expr = parse_expression(p);
    if expr == NULL { return NULL; }
    match_terminator(p);
    return expr;
}

fn parse_block(p: Parser*) -> AstNode* {
    let lbrace = advance(p);     // consume '{'

    let cap: u32 = 8;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof && !p.had_error {
        let stmt = parse_statement(p);
        if stmt == NULL { break; }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = stmt;
        count = count + 1;
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RBrace);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::BlockStmt, lbrace.start, close.start + close.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

// `consume_semi` controls whether we consume the trailing `;`. For-init
// uses `false` because the for-loop owns the `;` between init/cond.
// Some keywords are contextual — they're reserved in specific syntactic
// positions but legal identifiers elsewhere. ECMA-262 §13.1: at minimum,
// `of`, `let`, `static`, `async`, `yield`, `await` can be binding
// identifiers in sloppy mode. We accept them broadly; strict-mode tests
// for these would need a separate gate (not implemented yet).
fn is_binding_ident(k: TokenKind) -> bool {
    if k == TokenKind::Identifier { return true; }
    if k == TokenKind::KwOf       { return true; }
    if k == TokenKind::KwLet      { return true; }
    if k == TokenKind::KwYield    { return true; }
    if k == TokenKind::KwAwait    { return true; }
    if k == TokenKind::KwAsync    { return true; }
    return false;
}

// IdentifierName per ECMA-262 §11.6: identifier OR any reserved
// word. Used wherever the spec allows a keyword as a name —
// PropertyName in object literals, MemberExpression after `.`, etc.
fn is_keyword_token(k: TokenKind) -> bool {
    if k == TokenKind::KwVar || k == TokenKind::KwLet || k == TokenKind::KwConst { return true; }
    if k == TokenKind::KwFunction || k == TokenKind::KwReturn { return true; }
    if k == TokenKind::KwIf || k == TokenKind::KwElse { return true; }
    if k == TokenKind::KwFor || k == TokenKind::KwWhile || k == TokenKind::KwDo { return true; }
    if k == TokenKind::KwBreak || k == TokenKind::KwContinue { return true; }
    if k == TokenKind::KwClass || k == TokenKind::KwExtends || k == TokenKind::KwSuper { return true; }
    if k == TokenKind::KwNew || k == TokenKind::KwThis { return true; }
    if k == TokenKind::KwTrue || k == TokenKind::KwFalse || k == TokenKind::KwNull || k == TokenKind::KwUndefined { return true; }
    if k == TokenKind::KwTypeof || k == TokenKind::KwDelete || k == TokenKind::KwVoid { return true; }
    if k == TokenKind::KwIn || k == TokenKind::KwOf || k == TokenKind::KwInstanceof { return true; }
    if k == TokenKind::KwThrow || k == TokenKind::KwTry || k == TokenKind::KwCatch || k == TokenKind::KwFinally { return true; }
    if k == TokenKind::KwSwitch || k == TokenKind::KwCase || k == TokenKind::KwDefault { return true; }
    if k == TokenKind::KwAsync || k == TokenKind::KwAwait || k == TokenKind::KwYield { return true; }
    if k == TokenKind::KwImport || k == TokenKind::KwExport || k == TokenKind::KwFrom || k == TokenKind::KwAs { return true; }
    return false;
}

fn is_property_name_start(k: TokenKind) -> bool {
    if k == TokenKind::Identifier { return true; }
    if k == TokenKind::StringLit  { return true; }
    if k == TokenKind::NumberLit  { return true; }
    return is_keyword_token(k);
}

fn parse_var_decl(p: Parser*, consume_semi: bool) -> AstNode* {
    let kw = advance(p);   // var / let / const

    let cap: u32 = 2;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    let last_end: u32 = kw.start + kw.length;
    while true {
        let name_tok = peek(p);
        if !is_binding_ident(name_tok.kind) {
            p.had_error = true;
            break;
        }
        advance(p);

        let decl = new_node(&p.tracker, NodeKind::Declarator,
                            name_tok.start, name_tok.start + name_tok.length);
        decl.name_start = name_tok.start;
        decl.name_length = name_tok.length;

        if match_kind(p, TokenKind::Eq) {
            let init = parse_assignment(p);
            if init == NULL { break; }
            decl.left = init;
            decl.end = init.end;
        }

        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = decl;
        count = count + 1;
        last_end = decl.end;

        if !match_kind(p, TokenKind::Comma) { break; }
    }

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::VarDecl, kw.start, last_end);
    node.op = kw.kind;
    node.children = buf;
    node.children_count = count;

    if consume_semi { match_terminator(p); }
    return node;
}

// ECMA-262 grammar split: the body of `if/while/do-while/for/for-in/for-of`
// is `Statement`, not `Declaration`. So `let`, `const`, `function`, and
// `class` declarations are illegal as a non-block statement body. The
// only `var` form that IS allowed is the legacy `var` statement
// (VarDecl with op=KwVar). Returns true if the node is one of the
// disallowed declarations.
fn is_disallowed_statement_body(n: AstNode*) -> bool {
    if n == NULL { return false; }
    let k = n.kind;
    if k == NodeKind::FunctionDecl { return true; }
    if k == NodeKind::ClassDecl    { return true; }
    if k == NodeKind::VarDecl {
        // let/const declarations are disallowed; var is allowed.
        if n.op == TokenKind::KwLet || n.op == TokenKind::KwConst {
            return true;
        }
    }
    return false;
}

fn parse_if(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'if'
    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let cond = parse_expression(p);
    if cond == NULL { return NULL; }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    let then_stmt = parse_statement(p);
    if then_stmt == NULL { return NULL; }
    if is_disallowed_statement_body(then_stmt) { p.had_error = true; return NULL; }

    let end: u32 = then_stmt.end;
    let else_stmt: AstNode* = NULL;
    if match_kind(p, TokenKind::KwElse) {
        else_stmt = parse_statement(p);
        if else_stmt == NULL { return NULL; }
        if is_disallowed_statement_body(else_stmt) { p.had_error = true; return NULL; }
        end = else_stmt.end;
    }

    let node = new_node(&p.tracker, NodeKind::IfStmt, kw.start, end);
    node.left = cond;
    node.right = then_stmt;
    node.third = else_stmt;
    return node;
}

fn parse_return(p: Parser*) -> AstNode* {
    if p.function_depth == 0 { p.had_error = true; return NULL; }
    let kw = advance(p);   // 'return'
    let end: u32 = kw.start + kw.length;
    let arg: AstNode* = NULL;

    // Bare `return;` or `return` at end-of-block keeps arg=NULL.
    let k = peek_kind(p);
    if k != TokenKind::Semicolon && k != TokenKind::RBrace && k != TokenKind::Eof {
        arg = parse_expression(p);
        if arg == NULL { return NULL; }
        end = arg.end;
    }

    let node = new_node(&p.tracker, NodeKind::ReturnStmt, kw.start, end);
    node.left = arg;
    match_terminator(p);
    return node;
}

fn parse_while(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'while'
    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let cond = parse_expression(p);
    if cond == NULL { return NULL; }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }
    let node = new_node(&p.tracker, NodeKind::WhileStmt, kw.start, body.end);
    node.left = cond;
    node.right = body;
    return node;
}

fn parse_do_while(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'do'
    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }
    if !expect_kind(p, TokenKind::KwWhile) { return NULL; }
    if !expect_kind(p, TokenKind::LParen)  { return NULL; }
    let cond = parse_expression(p);
    if cond == NULL { return NULL; }
    let close = peek(p);
    if !expect_kind(p, TokenKind::RParen)  { return NULL; }
    let node = new_node(&p.tracker, NodeKind::DoWhileStmt, kw.start, close.start + close.length);
    node.left = body;
    node.right = cond;
    match_terminator(p);
    return node;
}

fn parse_for(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'for'
    if !expect_kind(p, TokenKind::LParen) { return NULL; }

    // init slot: var-decl (no `;` consumed), expression, or empty.
    // After parsing the init, peek for 'in' / 'of' to switch into the
    // for-in / for-of branches; otherwise expect the C-style `;`.
    //
    // Enter no-in mode around the init so the relational parser doesn't
    // greedily consume `for (x in obj)` as `for ((x in obj))`.
    let saved_no_in = p.no_in;
    p.no_in = true;

    let init: AstNode* = NULL;
    let kk = peek_kind(p);
    if kk == TokenKind::Semicolon {
        advance(p);
        p.no_in = saved_no_in;
    } else if kk == TokenKind::KwVar || kk == TokenKind::KwLet || kk == TokenKind::KwConst {
        init = parse_var_decl(p, false);
        p.no_in = saved_no_in;
        if init == NULL { return NULL; }
        let after = peek_kind(p);
        if after == TokenKind::KwIn || after == TokenKind::KwOf {
            return finish_for_in_or_of(p, kw, init, after);
        }
        if !expect_kind(p, TokenKind::Semicolon) { return NULL; }
    } else {
        init = parse_expression(p);
        p.no_in = saved_no_in;
        if init == NULL { return NULL; }
        let after = peek_kind(p);
        if after == TokenKind::KwIn || after == TokenKind::KwOf {
            return finish_for_in_or_of(p, kw, init, after);
        }
        if !expect_kind(p, TokenKind::Semicolon) { return NULL; }
    }

    // test slot: optional expression, terminated by `;`.
    let test_e: AstNode* = NULL;
    if peek_kind(p) != TokenKind::Semicolon {
        test_e = parse_expression(p);
        if test_e == NULL { return NULL; }
    }
    if !expect_kind(p, TokenKind::Semicolon) { return NULL; }

    // update slot: optional expression, terminated by `)`.
    let update: AstNode* = NULL;
    if peek_kind(p) != TokenKind::RParen {
        update = parse_expression(p);
        if update == NULL { return NULL; }
    }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }

    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }

    let node = new_node(&p.tracker, NodeKind::ForStmt, kw.start, body.end);
    node.left = init;
    node.right = test_e;
    node.third = update;

    // Body lives in children[0] (the variadic slot — left/right/third are taken).
    let body_arr: AstNode** = NULL;
    body_arr = alloc_n<AstNode*>(1);
    body_arr[0] = body;
    alloc_list_push(&p.tracker, (void*)body_arr);
    node.children = body_arr;
    node.children_count = 1;

    return node;
}

// Build a ForInStmt / ForOfStmt after parse_for has already consumed
// `for (` and the binding. `op_kind` is KwIn or KwOf — drives the
// returned NodeKind.
fn finish_for_in_or_of(p: Parser*, kw_tok: Token, binding: AstNode*, op_kind: TokenKind) -> AstNode* {
    // ECMA-262: ForDeclaration / ForBinding in for-in / for-of heads
    // may not carry an initializer, and must be exactly one binding.
    // `for (let x = 1 of [])` and `for (var x, y in obj)` are both
    // early SyntaxErrors.
    if binding != NULL && binding.kind == NodeKind::VarDecl {
        if binding.children_count != 1 { p.had_error = true; return NULL; }
        let decl0 = binding.children[0];
        if decl0 != NULL && decl0.left != NULL { p.had_error = true; return NULL; }
        // Spec: a `let` / `const` ForDeclaration may not bind the
        // identifier `let`.  `for (let let of ...)` and the const
        // version are SyntaxErrors. Bare `var let` is still fine.
        if decl0 != NULL && decl0.name_length == 3
           && (binding.op == TokenKind::KwLet || binding.op == TokenKind::KwConst) {
            let nm = p.source + decl0.name_start;
            let is_let: int = 0;
            raw { is_let = (memcmp(nm, "let", 3) == 0) ? 1 : 0; }
            if is_let != 0 { p.had_error = true; return NULL; }
        }
    }
    // Spec: for-of LHS may not begin with the identifier `async`.
    // `for (async of [1])` is an early SyntaxError so the head can be
    // disambiguated from `for await (async of [...])` etc.
    if op_kind == TokenKind::KwOf && binding != NULL && binding.kind == NodeKind::IdentExpr {
        let bn_len = binding.end - binding.start;
        if bn_len == 5 {
            let nm = p.source + binding.start;
            let is_async: int = 0;
            raw { is_async = (memcmp(nm, "async", 5) == 0) ? 1 : 0; }
            if is_async != 0 { p.had_error = true; return NULL; }
        }
    }
    advance(p);    // consume 'in' or 'of'
    // ECMA-262: for-of's RHS is an AssignmentExpression (no comma);
    // for-in's RHS is an Expression. We constrain both to
    // AssignmentExpression-or-Comma here for simplicity, then verify
    // for-of did not consume a comma by checking we land at ')'.
    let iter_expr: AstNode* = NULL;
    if op_kind == TokenKind::KwOf {
        iter_expr = parse_assignment(p);
    } else {
        iter_expr = parse_expression(p);
    }
    if iter_expr == NULL { return NULL; }
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    let body = parse_statement(p);
    if body == NULL { return NULL; }
    if is_disallowed_statement_body(body) { p.had_error = true; return NULL; }

    let kind = if op_kind == TokenKind::KwIn { NodeKind::ForInStmt } else { NodeKind::ForOfStmt };
    let node = new_node(&p.tracker, kind, kw_tok.start, body.end);
    node.left = binding;
    node.right = iter_expr;

    let body_arr: AstNode** = NULL;
    body_arr = alloc_n<AstNode*>(1);
    body_arr[0] = body;
    alloc_list_push(&p.tracker, (void*)body_arr);
    node.children = body_arr;
    node.children_count = 1;

    return node;
}

fn parse_break(p: Parser*) -> AstNode* {
    let kw = advance(p);
    let end_pos = kw.start + kw.length;
    let label_start: u32 = 0;
    let label_length: u32 = 0;
    // Optional label identifier immediately after `break` / `continue`,
    // unless the next token is a statement terminator. We don't have
    // proper ASI yet, so accept an identifier whenever we see one.
    if peek_kind(p) == TokenKind::Identifier {
        let next = peek(p);
        let kw_end = kw.start + kw.length;
        if !has_newline_between(p, kw_end, next.start) {
            let id = advance(p);
            label_start  = id.start;
            label_length = id.length;
            end_pos      = id.start + id.length;
        }
    }
    let node = new_node(&p.tracker, NodeKind::BreakStmt, kw.start, end_pos);
    node.name_start  = label_start;
    node.name_length = label_length;
    match_terminator(p);
    return node;
}

fn parse_continue(p: Parser*) -> AstNode* {
    let kw = advance(p);
    let end_pos = kw.start + kw.length;
    let label_start: u32 = 0;
    let label_length: u32 = 0;
    if peek_kind(p) == TokenKind::Identifier {
        let next = peek(p);
        let kw_end = kw.start + kw.length;
        if !has_newline_between(p, kw_end, next.start) {
            let id = advance(p);
            label_start  = id.start;
            label_length = id.length;
            end_pos      = id.start + id.length;
        }
    }
    let node = new_node(&p.tracker, NodeKind::ContinueStmt, kw.start, end_pos);
    node.name_start  = label_start;
    node.name_length = label_length;
    match_terminator(p);
    return node;
}

fn parse_throw(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'throw'
    let arg = parse_expression(p);
    if arg == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::ThrowStmt, kw.start, arg.end);
    node.left = arg;
    match_terminator(p);
    return node;
}

fn parse_try(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'try'

    if peek_kind(p) != TokenKind::LBrace { p.had_error = true; return NULL; }
    let try_block = parse_block(p);
    if try_block == NULL { return NULL; }

    // Catch clause (optional in the presence of finally).
    let catch_block: AstNode* = NULL;
    let catch_name_start: u32 = 0;
    let catch_name_length: u32 = 0;
    if match_kind(p, TokenKind::KwCatch) {
        if match_kind(p, TokenKind::LParen) {
            let id = peek(p);
            if id.kind != TokenKind::Identifier {
                p.had_error = true; return NULL;
            }
            advance(p);
            catch_name_start = id.start;
            catch_name_length = id.length;
            if !expect_kind(p, TokenKind::RParen) { return NULL; }
        }
        if peek_kind(p) != TokenKind::LBrace { p.had_error = true; return NULL; }
        catch_block = parse_block(p);
        if catch_block == NULL { return NULL; }
    }

    // Finally clause (optional).
    let finally_block: AstNode* = NULL;
    if match_kind(p, TokenKind::KwFinally) {
        if peek_kind(p) != TokenKind::LBrace { p.had_error = true; return NULL; }
        finally_block = parse_block(p);
        if finally_block == NULL { return NULL; }
    }

    // Must have at least one of catch / finally.
    if catch_block == NULL && finally_block == NULL {
        p.had_error = true;
        return NULL;
    }

    let end_pos = if finally_block != NULL { finally_block.end }
                  else if catch_block != NULL { catch_block.end }
                  else { try_block.end };
    let node = new_node(&p.tracker, NodeKind::TryStmt, kw.start, end_pos);
    node.left  = try_block;
    node.right = catch_block;
    node.third = finally_block;
    node.name_start  = catch_name_start;
    node.name_length = catch_name_length;
    return node;
}

// =====================================================================
// Functions, arrow functions, parameter lists. Phase 2.5.
// =====================================================================

struct ParamList {
    arr:   AstNode**;
    count: u32;
}

// Parse a comma-separated list of bindings up to (but not including)
// the closing `)`. Supports:
//   - plain identifier:                 function f(a) {}
//   - default-initialized identifier:   function f(a = 5) {}
//   - rest parameter (must be last):    function f(...rest) {}
fn parse_param_list(p: Parser*) -> ParamList {
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);
    let seen_rest: bool = false;

    while peek_kind(p) != TokenKind::RParen && peek_kind(p) != TokenKind::Eof {
        if seen_rest {
            // `...rest` must be the last entry — no trailing comma, no
            // more bindings after it.
            p.had_error = true;
            break;
        }
        let is_rest: bool = false;
        if peek_kind(p) == TokenKind::Ellipsis {
            advance(p);
            is_rest = true;
        }
        let name_tok = peek(p);
        if !is_binding_ident(name_tok.kind) {
            p.had_error = true;
            break;
        }
        advance(p);
        let ident_start = name_tok.start;
        let ident_end   = name_tok.start + name_tok.length;
        let ident = new_node(&p.tracker, NodeKind::IdentExpr, ident_start, ident_end);

        let param: AstNode* = ident;
        if is_rest {
            // `...name` — rest params can't have a default (per spec).
            let rest = new_node(&p.tracker, NodeKind::RestParam, ident_start, ident_end);
            rest.left = ident;
            param = rest;
            seen_rest = true;
        } else if peek_kind(p) == TokenKind::Eq {
            // `name = expr` — default initializer. Parsed at AssignmentExpr
            // precedence so commas terminate the list cleanly. Note the
            // IdentExpr's start/end stay bounded to the name itself —
            // the compiler reads that range when registering the local.
            advance(p);
            let init = parse_assignment(p);
            if init == NULL { break; }
            param.right = init;
        }

        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = param;
        count = count + 1;

        if !match_kind(p, TokenKind::Comma) { break; }
        // Tolerate a single trailing comma before the closing paren
        // (ES2017 — `function f(a, b,)`).
        if peek_kind(p) == TokenKind::RParen { break; }
    }

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }
    return ParamList{ arr: buf, count: count };
}

fn parse_function_decl(p: Parser*) -> AstNode* {
    let kw = advance(p);     // 'function'

    let name_tok = peek(p);
    if name_tok.kind != TokenKind::Identifier {
        p.had_error = true;
        return NULL;
    }
    advance(p);

    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) { return NULL; }

    if peek_kind(p) != TokenKind::LBrace {
        p.had_error = true;
        return NULL;
    }
    p.function_depth = p.function_depth + 1;
    let body = parse_block(p);
    p.function_depth = p.function_depth - 1;
    if body == NULL { return NULL; }

    let node = new_node(&p.tracker, NodeKind::FunctionDecl, kw.start, body.end);
    node.name_start = name_tok.start;
    node.name_length = name_tok.length;
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    return node;
}

// --- Classes (Phase 3.7) -------------------------------------------
//
// Grammar (MVP, no extends / static / get / set):
//     class X { method() {} otherMethod(a, b) {} constructor(...) {} }
// `constructor` and other methods share the MethodDef shape. The
// compiler distinguishes the constructor by name.

// True if the identifier slice is one of the strict-mode reserved
// words that may not be used as a class or function binding name.
fn is_strict_reserved_name(name: char*, name_len: u32) -> bool {
    if name_len == 3 {
        let eq: int = 0;
        raw { eq = (memcmp(name, "let", 3) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    if name_len == 5 {
        let eq: int = 0;
        raw { eq = (memcmp(name, "yield", 5) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    if name_len == 6 {
        let eq: int = 0;
        raw {
            eq = (memcmp(name, "static", 6) == 0
               || memcmp(name, "public", 6) == 0) ? 1 : 0;
        }
        if eq != 0 { return true; }
    }
    if name_len == 7 {
        let eq: int = 0;
        raw {
            eq = (memcmp(name, "package", 7) == 0
               || memcmp(name, "private", 7) == 0) ? 1 : 0;
        }
        if eq != 0 { return true; }
    }
    if name_len == 9 {
        let eq: int = 0;
        raw {
            eq = (memcmp(name, "interface", 9) == 0
               || memcmp(name, "protected", 9) == 0) ? 1 : 0;
        }
        if eq != 0 { return true; }
    }
    if name_len == 10 {
        let eq: int = 0;
        raw { eq = (memcmp(name, "implements", 10) == 0) ? 1 : 0; }
        if eq != 0 { return true; }
    }
    return false;
}

fn parse_method_body_pair(p: Parser*) -> AstNode* {
    let mut_start = peek(p).start;
    // Optional `static` prefix. We only treat it as the static keyword
    // when followed by another property-name token (the actual method
    // name). `static() {}` keeps `static` as the method name.
    let is_static: bool = false;
    let first = peek(p);
    if first.kind == TokenKind::Identifier && first.length == 6 {
        let nd = p.source + first.start;
        let is_kw_static: int = 0;
        raw { is_kw_static = (memcmp(nd, "static", 6) == 0) ? 1 : 0; }
        if is_kw_static != 0 && is_property_name_start(peek_kind2(p)) {
            advance(p);
            is_static = true;
        }
    }
    // Optional `get` / `set` accessor prefix. Same rule as `static`:
    // only treat as the contextual keyword when followed by another
    // property name (so `get() {}` defines a method called `get`).
    let acc_kind: TokenKind = TokenKind::Eq;   // sentinel for "regular method"
    let id2 = peek(p);
    if id2.kind == TokenKind::Identifier && id2.length == 3 {
        let nd = p.source + id2.start;
        let is_get: int = 0;
        let is_set: int = 0;
        raw {
            is_get = (memcmp(nd, "get", 3) == 0) ? 1 : 0;
            is_set = (memcmp(nd, "set", 3) == 0) ? 1 : 0;
        }
        if (is_get != 0 || is_set != 0) && is_property_name_start(peek_kind2(p)) {
            advance(p);
            acc_kind = if is_get != 0 { TokenKind::KwGet } else { TokenKind::KwSet };
        }
    }
    // Method name: Identifier OR a contextual / reserved word usable as
    // a property name (`of`, `static`, `let`, ...).
    let name_tok = peek(p);
    if !is_property_name_start(name_tok.kind) { p.had_error = true; return NULL; }
    advance(p);

    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) { return NULL; }

    if peek_kind(p) != TokenKind::LBrace { p.had_error = true; return NULL; }
    p.function_depth = p.function_depth + 1;
    let body = parse_block(p);
    p.function_depth = p.function_depth - 1;
    if body == NULL { return NULL; }

    let node = new_node(&p.tracker, NodeKind::MethodDef, mut_start, body.end);
    node.name_start  = name_tok.start;
    node.name_length = name_tok.length;
    node.bool_value  = is_static;
    node.op          = acc_kind;
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    return node;
}

fn parse_class_body(p: Parser*) -> ParamList {
    if !expect_kind(p, TokenKind::LBrace) {
        return ParamList{ arr: NULL, count: 0 };
    }
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf: AstNode** = NULL;
    buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
        // Skip empty `;` separators (allowed inside class bodies).
        if peek_kind(p) == TokenKind::Semicolon { advance(p); continue; }
        let m = parse_method_body_pair(p);
        if m == NULL { p.had_error = true; break; }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = m;
        count = count + 1;
    }
    expect_kind(p, TokenKind::RBrace);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }
    return ParamList{ arr: buf, count: count };
}

fn parse_class_decl(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'class'
    let name_tok = peek(p);
    // Class names allow the same broad "binding identifier" set as
    // other declarations: plain Identifier plus contextual keywords
    // (`await`, `yield`, `let`, `of`, `async`, …) when not in a
    // module / async context where they'd be reserved.
    if !is_binding_ident(name_tok.kind) { p.had_error = true; return NULL; }
    // Class bodies are strict-mode code by spec. The class name may
    // not be a strict-reserved identifier.
    if is_strict_reserved_name(p.source + name_tok.start, name_tok.length) {
        p.had_error = true; return NULL;
    }
    advance(p);

    // Optional `extends <LeftHandSideExpression>`.
    let parent: AstNode* = NULL;
    if peek_kind(p) == TokenKind::KwExtends {
        advance(p);
        parent = parse_call_member(p);
        if parent == NULL { return NULL; }
    }

    let body = parse_class_body(p);
    let end_pos = if body.count > 0 { body.arr[body.count - 1].end } else { peek(p).start };

    let node = new_node(&p.tracker, NodeKind::ClassDecl, kw.start, end_pos);
    node.name_start  = name_tok.start;
    node.name_length = name_tok.length;
    node.right       = parent;
    node.children = body.arr;
    node.children_count = body.count;
    return node;
}

fn parse_class_expr(p: Parser*) -> AstNode* {
    let kw = advance(p);   // 'class'
    let name_start: u32 = 0;
    let name_length: u32 = 0;
    if peek_kind(p) == TokenKind::Identifier {
        let nt = advance(p);
        name_start  = nt.start;
        name_length = nt.length;
    }
    let parent: AstNode* = NULL;
    if peek_kind(p) == TokenKind::KwExtends {
        advance(p);
        parent = parse_call_member(p);
        if parent == NULL { return NULL; }
    }
    let body = parse_class_body(p);
    let end_pos = if body.count > 0 { body.arr[body.count - 1].end } else { peek(p).start };

    let node = new_node(&p.tracker, NodeKind::ClassExpr, kw.start, end_pos);
    node.name_start  = name_start;
    node.name_length = name_length;
    node.right       = parent;
    node.children = body.arr;
    node.children_count = body.count;
    return node;
}

// Function expressions live in expression context. Name is optional.
fn parse_function_expr(p: Parser*) -> AstNode* {
    let kw = advance(p);     // 'function'

    let name_start: u32 = 0;
    let name_length: u32 = 0;
    if peek_kind(p) == TokenKind::Identifier {
        let name_tok = advance(p);
        name_start = name_tok.start;
        name_length = name_tok.length;
    }

    if !expect_kind(p, TokenKind::LParen) { return NULL; }
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) { return NULL; }

    if peek_kind(p) != TokenKind::LBrace {
        p.had_error = true;
        return NULL;
    }
    p.function_depth = p.function_depth + 1;
    let body = parse_block(p);
    p.function_depth = p.function_depth - 1;
    if body == NULL { return NULL; }

    let node = new_node(&p.tracker, NodeKind::FunctionExpr, kw.start, body.end);
    node.name_start = name_start;
    node.name_length = name_length;
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    return node;
}

// Arrow function body: a block (preserves explicit return semantics)
// OR a single AssignmentExpression (concise body — implicit return).
// Both forms count as entering a function for `return` purposes.
fn parse_arrow_body(p: Parser*) -> AstNode* {
    p.function_depth = p.function_depth + 1;
    let r: AstNode* = NULL;
    if peek_kind(p) == TokenKind::LBrace {
        r = parse_block(p);
    } else {
        r = parse_assignment(p);
    }
    p.function_depth = p.function_depth - 1;
    return r;
}

// Single-identifier arrow: `x => body`
fn parse_arrow_single(p: Parser*) -> AstNode* {
    let name_tok = advance(p);     // identifier
    advance(p);                    // '=>'

    let param = new_node(&p.tracker, NodeKind::IdentExpr,
                         name_tok.start, name_tok.start + name_tok.length);
    let arr: AstNode** = NULL;
    arr = alloc_n<AstNode*>(1);
    arr[0] = param;
    alloc_list_push(&p.tracker, (void*)arr);

    let body = parse_arrow_body(p);
    if body == NULL { return NULL; }

    let node = new_node(&p.tracker, NodeKind::ArrowFunc, name_tok.start, body.end);
    node.left = body;
    node.children = arr;
    node.children_count = 1;
    return node;
}

// Paren-list arrow: `(a, b) => body`, `() => body`
fn parse_arrow_paren(p: Parser*) -> AstNode* {
    let lparen = advance(p);     // '('
    let params = parse_param_list(p);
    if !expect_kind(p, TokenKind::RParen) { return NULL; }
    if !expect_kind(p, TokenKind::Arrow)  { return NULL; }
    let body = parse_arrow_body(p);
    if body == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::ArrowFunc, lparen.start, body.end);
    node.left = body;
    node.children = params.arr;
    node.children_count = params.count;
    return node;
}

// Scan forward from peek_kind(p) == LParen to find the matching `)` and
// peek at the token after it. Returns true iff that token is `=>`.
fn lookahead_arrow_paren(p: Parser*) -> bool {
    let depth: int = 0;
    let i = p.pos;
    while i < p.token_count {
        let k = p.tokens[i].kind;
        if k == TokenKind::LParen { depth = depth + 1; }
        else if k == TokenKind::RParen {
            depth = depth - 1;
            if depth == 0 {
                let next = i + 1;
                if next >= p.token_count { return false; }
                return p.tokens[next].kind == TokenKind::Arrow;
            }
        }
        else if k == TokenKind::Eof { return false; }
        i = i + 1;
    }
    return false;
}

// =====================================================================
// Precedence climb. One function per level, from lowest precedence
// (root of the recursion) to highest (closest to primary).
// =====================================================================

// Level 18 — comma sequence (lowest precedence).
fn parse_expression(p: Parser*) -> AstNode* {
    let first = parse_assignment(p);
    if first == NULL { return NULL; }
    if peek_kind(p) != TokenKind::Comma { return first; }

    // Build a Sequence node.
    let cap: u32 = 4;
    let count: u32 = 1;
    let buf = alloc_n<AstNode*>((usize)cap);
    buf[0] = first;
    while match_kind(p, TokenKind::Comma) {
        let next = parse_assignment(p);
        if next == NULL { break; }
        if count >= cap {
            cap = cap * 2;
            raw {
                buf = (AstNode**)realloc(buf, cap * sizeof(AstNode*));
            }
        }
        buf[count] = next;
        count = count + 1;
    }

    alloc_list_push(&p.tracker, (void*)buf);
    let node = new_node(&p.tracker, NodeKind::Sequence, first.start, buf[count - 1].end);
    node.children = buf;
    node.children_count = count;
    return node;
}

// Level 17 — assignment (right-associative). Also dispatches to arrow
// functions, which share the assignment grammar slot in ECMA-262.
fn parse_assignment(p: Parser*) -> AstNode* {
    // Arrow detection — must come before falling through to the
    // expression path, because `x => body` and `(a, b) => body` would
    // otherwise be eagerly consumed as Identifier / Paren expressions.
    if peek_kind(p) == TokenKind::Identifier && peek_at(p, 1).kind == TokenKind::Arrow {
        return parse_arrow_single(p);
    }
    if peek_kind(p) == TokenKind::LParen && lookahead_arrow_paren(p) {
        return parse_arrow_paren(p);
    }

    let left = parse_conditional(p);
    if left == NULL { return NULL; }
    let k = peek_kind(p);
    if is_assignment_op(k) {
        let op_tok = advance(p);
        let right = parse_assignment(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Assignment, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        return node;
    }
    return left;
}

fn is_assignment_op(k: TokenKind) -> bool {
    if k == TokenKind::Eq            { return true; }
    if k == TokenKind::PlusEq        { return true; }
    if k == TokenKind::MinusEq       { return true; }
    if k == TokenKind::StarEq        { return true; }
    if k == TokenKind::StarStarEq    { return true; }
    if k == TokenKind::SlashEq       { return true; }
    if k == TokenKind::PercentEq     { return true; }
    if k == TokenKind::LtLtEq        { return true; }
    if k == TokenKind::GtGtEq        { return true; }
    if k == TokenKind::GtGtGtEq      { return true; }
    if k == TokenKind::AmpEq         { return true; }
    if k == TokenKind::PipeEq        { return true; }
    if k == TokenKind::CaretEq       { return true; }
    if k == TokenKind::AmpAmpEq      { return true; }
    if k == TokenKind::PipePipeEq    { return true; }
    if k == TokenKind::QuestionQuestionEq { return true; }
    return false;
}

// Level 16 — ternary (right-associative).
fn parse_conditional(p: Parser*) -> AstNode* {
    let cond = parse_nullish(p);
    if cond == NULL { return NULL; }
    if !match_kind(p, TokenKind::Question) { return cond; }
    let conseq = parse_assignment(p);
    if conseq == NULL { return NULL; }
    if !expect_kind(p, TokenKind::Colon) { return NULL; }
    let alt = parse_assignment(p);
    if alt == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::Conditional, cond.start, alt.end);
    node.left = cond;
    node.right = conseq;
    node.third = alt;
    return node;
}

// Level 15 — nullish coalescing.
fn parse_nullish(p: Parser*) -> AstNode* {
    let left = parse_logical_or(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::QuestionQuestion {
        let op_tok = advance(p);
        let right = parse_logical_or(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Logical, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 14 — logical OR.
fn parse_logical_or(p: Parser*) -> AstNode* {
    let left = parse_logical_and(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::PipePipe {
        let op_tok = advance(p);
        let right = parse_logical_and(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Logical, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 13 — logical AND.
fn parse_logical_and(p: Parser*) -> AstNode* {
    let left = parse_bit_or(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::AmpAmp {
        let op_tok = advance(p);
        let right = parse_bit_or(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Logical, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 12 — bitwise OR.
fn parse_bit_or(p: Parser*) -> AstNode* {
    let left = parse_bit_xor(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::Pipe {
        let op_tok = advance(p);
        let right = parse_bit_xor(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 11 — bitwise XOR.
fn parse_bit_xor(p: Parser*) -> AstNode* {
    let left = parse_bit_and(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::Caret {
        let op_tok = advance(p);
        let right = parse_bit_and(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 10 — bitwise AND.
fn parse_bit_and(p: Parser*) -> AstNode* {
    let left = parse_equality(p);
    if left == NULL { return NULL; }
    while peek_kind(p) == TokenKind::Amp {
        let op_tok = advance(p);
        let right = parse_equality(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 9 — equality.
fn parse_equality(p: Parser*) -> AstNode* {
    let left = parse_relational(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::EqEq && k != TokenKind::BangEq &&
           k != TokenKind::EqEqEq && k != TokenKind::BangEqEq {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_relational(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 8 — relational (`< > <= >= in instanceof`).
//
// The `in` operator is suppressed when p.no_in is true — used by
// parse_for so that `for (x in obj)` parses the binding as `x` and
// then dispatches to for-in, rather than swallowing `x in obj` as a
// Binary here.
fn parse_relational(p: Parser*) -> AstNode* {
    let left = parse_shift(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        let is_in = k == TokenKind::KwIn;
        if k != TokenKind::Lt && k != TokenKind::Gt &&
           k != TokenKind::LtEq && k != TokenKind::GtEq &&
           (!is_in || p.no_in) && k != TokenKind::KwInstanceof {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_shift(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 7 — shift.
fn parse_shift(p: Parser*) -> AstNode* {
    let left = parse_additive(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::LtLt && k != TokenKind::GtGt && k != TokenKind::GtGtGt {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_additive(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 6 — additive.
fn parse_additive(p: Parser*) -> AstNode* {
    let left = parse_multiplicative(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::Plus && k != TokenKind::Minus { return left; }
        let op_tok = advance(p);
        let right = parse_multiplicative(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 5 — multiplicative.
fn parse_multiplicative(p: Parser*) -> AstNode* {
    let left = parse_exponent(p);
    if left == NULL { return NULL; }
    while true {
        let k = peek_kind(p);
        if k != TokenKind::Star && k != TokenKind::Slash && k != TokenKind::Percent {
            return left;
        }
        let op_tok = advance(p);
        let right = parse_exponent(p);
        if right == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
        node.op = op_tok.kind;
        node.left = left;
        node.right = right;
        left = node;
    }
    return left;
}

// Level 4 — exponentiation (right-associative).
fn parse_exponent(p: Parser*) -> AstNode* {
    let left = parse_unary(p);
    if left == NULL { return NULL; }
    if peek_kind(p) != TokenKind::StarStar { return left; }
    let op_tok = advance(p);
    let right = parse_exponent(p);     // right-associative recursion
    if right == NULL { return NULL; }
    let node = new_node(&p.tracker, NodeKind::Binary, left.start, right.end);
    node.op = op_tok.kind;
    node.left = left;
    node.right = right;
    return node;
}

// Level 3 — unary prefix.
fn parse_unary(p: Parser*) -> AstNode* {
    let k = peek_kind(p);
    if k == TokenKind::Bang || k == TokenKind::Tilde ||
       k == TokenKind::Plus || k == TokenKind::Minus ||
       k == TokenKind::PlusPlus || k == TokenKind::MinusMinus ||
       k == TokenKind::KwTypeof || k == TokenKind::KwVoid || k == TokenKind::KwDelete {
        let op_tok = advance(p);
        let operand = parse_unary(p);    // unary is right-assoc
        if operand == NULL { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Unary, op_tok.start, operand.end);
        node.op = op_tok.kind;
        node.left = operand;
        return node;
    }
    return parse_postfix(p);
}

// Level 2 — postfix.
fn parse_postfix(p: Parser*) -> AstNode* {
    let operand = parse_call_member(p);
    if operand == NULL { return NULL; }
    let k = peek_kind(p);
    if k == TokenKind::PlusPlus || k == TokenKind::MinusMinus {
        let op_tok = advance(p);
        let node = new_node(&p.tracker, NodeKind::Postfix, operand.start, op_tok.start + op_tok.length);
        node.op = op_tok.kind;
        node.left = operand;
        return node;
    }
    return operand;
}

// Level 1 — `new`, call, member, optional chain.
fn parse_call_member(p: Parser*) -> AstNode* {
    let expr: AstNode* = NULL;

    if peek_kind(p) == TokenKind::KwNew {
        let new_tok = advance(p);
        // The callee can itself contain member access but NOT a call —
        // `new Foo.bar()` is `new (Foo.bar)()`. We loop manually here
        // for member access only, then accept an optional arg list.
        let callee = parse_primary(p);
        if callee == NULL { return NULL; }
        while true {
            let kk = peek_kind(p);
            if kk == TokenKind::Dot {
                advance(p);
                let id_tok = advance(p);
                let mnode = new_node(&p.tracker, NodeKind::Member, callee.start, id_tok.start + id_tok.length);
                mnode.left = callee;
                mnode.name_start = id_tok.start;
                mnode.name_length = id_tok.length;
                callee = mnode;
            } else if kk == TokenKind::LBracket {
                advance(p);
                let prop = parse_expression(p);
                if prop == NULL { return NULL; }
                let close = peek(p);
                if !expect_kind(p, TokenKind::RBracket) { return NULL; }
                let cnode = new_node(&p.tracker, NodeKind::Computed, callee.start, close.start + close.length);
                cnode.left = callee;
                cnode.right = prop;
                callee = cnode;
            } else {
                break;
            }
        }
        let new_node_n = new_node(&p.tracker, NodeKind::New, new_tok.start, callee.end);
        new_node_n.left = callee;
        if peek_kind(p) == TokenKind::LParen {
            let args_pair = parse_arguments(p);
            new_node_n.children = args_pair.left_arr;
            new_node_n.children_count = args_pair.count;
            new_node_n.end = args_pair.end;
        }
        expr = new_node_n;
    } else {
        expr = parse_primary(p);
        if expr == NULL { return NULL; }
    }

    // Now consume call / member / optional-chain suffixes.
    while true {
        let k = peek_kind(p);
        if k == TokenKind::Dot {
            advance(p);
            let id_tok = advance(p);
            let mnode = new_node(&p.tracker, NodeKind::Member, expr.start, id_tok.start + id_tok.length);
            mnode.left = expr;
            mnode.name_start = id_tok.start;
            mnode.name_length = id_tok.length;
            expr = mnode;
        } else if k == TokenKind::LBracket {
            advance(p);
            let prop = parse_expression(p);
            if prop == NULL { return NULL; }
            let close = peek(p);
            if !expect_kind(p, TokenKind::RBracket) { return NULL; }
            let cnode = new_node(&p.tracker, NodeKind::Computed, expr.start, close.start + close.length);
            cnode.left = expr;
            cnode.right = prop;
            expr = cnode;
        } else if k == TokenKind::LParen {
            let args_pair = parse_arguments(p);
            let cnode = new_node(&p.tracker, NodeKind::Call, expr.start, args_pair.end);
            cnode.left = expr;
            cnode.children = args_pair.left_arr;
            cnode.children_count = args_pair.count;
            expr = cnode;
        } else if k == TokenKind::QuestionDot {
            advance(p);
            let after = peek_kind(p);
            if after == TokenKind::LParen {
                let args_pair = parse_arguments(p);
                let cnode = new_node(&p.tracker, NodeKind::OptionalCall, expr.start, args_pair.end);
                cnode.left = expr;
                cnode.children = args_pair.left_arr;
                cnode.children_count = args_pair.count;
                expr = cnode;
            } else if after == TokenKind::LBracket {
                advance(p);
                let prop = parse_expression(p);
                if prop == NULL { return NULL; }
                let close = peek(p);
                if !expect_kind(p, TokenKind::RBracket) { return NULL; }
                let cnode = new_node(&p.tracker, NodeKind::OptionalComputed, expr.start, close.start + close.length);
                cnode.left = expr;
                cnode.right = prop;
                expr = cnode;
            } else {
                let id_tok = advance(p);
                let mnode = new_node(&p.tracker, NodeKind::OptionalMember, expr.start, id_tok.start + id_tok.length);
                mnode.left = expr;
                mnode.name_start = id_tok.start;
                mnode.name_length = id_tok.length;
                expr = mnode;
            }
        } else {
            return expr;
        }
    }
    return expr;
}

// Arguments parser — used by Call / OptionalCall / New.
//
// Returns a small struct so we can pass back the array, its count, and
// the end byte offset all together.

struct ArgsResult {
    left_arr: AstNode**;
    count:    u32;
    end:      u32;
}

fn parse_arguments(p: Parser*) -> ArgsResult {
    let lparen = advance(p);     // consume '('
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    if peek_kind(p) != TokenKind::RParen {
        while true {
            let arg: AstNode* = NULL;
            if peek_kind(p) == TokenKind::Ellipsis {
                let dots = advance(p);
                let inner = parse_assignment(p);
                if inner == NULL { break; }
                let s = new_node(&p.tracker, NodeKind::Spread, dots.start, inner.end);
                s.left = inner;
                arg = s;
            } else {
                arg = parse_assignment(p);
                if arg == NULL { break; }
            }
            if count >= cap {
                cap = cap * 2;
                raw {
                    buf = (AstNode**)realloc(buf, cap * sizeof(AstNode*));
                }
            }
            buf[count] = arg;
            count = count + 1;
            if !match_kind(p, TokenKind::Comma) { break; }
        }
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RParen);

    if count == 0 {
        dealloc(buf);
        buf = NULL;
    } else {
        alloc_list_push(&p.tracker, (void*)buf);
    }
    return ArgsResult{ left_arr: buf, count: count, end: close.start + close.length };
}

// Level 0 — primary.
fn parse_primary(p: Parser*) -> AstNode* {
    let t = peek(p);
    let k = t.kind;

    if k == TokenKind::KwFunction { return parse_function_expr(p); }
    if k == TokenKind::KwClass    { return parse_class_expr(p); }

    if k == TokenKind::NumberLit {
        advance(p);
        let node = new_node(&p.tracker, NodeKind::NumberExpr, t.start, t.start + t.length);
        node.num = parse_number_literal(p.source, t.start, t.length);
        return node;
    }
    if k == TokenKind::StringLit {
        advance(p);
        return new_node(&p.tracker, NodeKind::StringExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::RegexLit {
        // Source slice is `/pattern/flags` — the compiler splits it.
        advance(p);
        return new_node(&p.tracker, NodeKind::RegexExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwTrue {
        advance(p);
        let node = new_node(&p.tracker, NodeKind::BoolExpr, t.start, t.start + t.length);
        node.bool_value = true;
        return node;
    }
    if k == TokenKind::KwFalse {
        advance(p);
        let node = new_node(&p.tracker, NodeKind::BoolExpr, t.start, t.start + t.length);
        node.bool_value = false;
        return node;
    }
    if k == TokenKind::KwNull {
        advance(p);
        return new_node(&p.tracker, NodeKind::NullExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwUndefined {
        advance(p);
        return new_node(&p.tracker, NodeKind::UndefinedExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwThis {
        advance(p);
        return new_node(&p.tracker, NodeKind::ThisExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::KwSuper {
        advance(p);
        // Bare `super` is only valid in a class method context; the
        // distinction (call vs member) is made by parse_call_member
        // when it sees the trailing `(` / `.` / `[`.
        return new_node(&p.tracker, NodeKind::SuperExpr, t.start, t.start + t.length);
    }
    if is_binding_ident(k) {
        // Identifier OR a contextual keyword being used as a reference
        // (`of`, `let`, `yield`, `await`, `async` in non-keyword
        // positions). See is_binding_ident.
        advance(p);
        return new_node(&p.tracker, NodeKind::IdentExpr, t.start, t.start + t.length);
    }
    if k == TokenKind::LParen {
        advance(p);
        let inner = parse_expression(p);
        if inner == NULL { return NULL; }
        let close = peek(p);
        if !expect_kind(p, TokenKind::RParen) { return NULL; }
        let node = new_node(&p.tracker, NodeKind::Paren, t.start, close.start + close.length);
        node.left = inner;
        return node;
    }
    if k == TokenKind::LBracket {
        return parse_array(p);
    }
    if k == TokenKind::LBrace {
        return parse_object(p);
    }

    // Anything else: error.
    p.had_error = true;
    advance(p);
    return NULL;
}

fn parse_array(p: Parser*) -> AstNode* {
    let lbrack = advance(p);        // consume '['
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBracket && peek_kind(p) != TokenKind::Eof {
        // Elision: `,` in place of an element means an empty slot
        // (spec calls this an "array hole"). Distinct from explicit
        // `undefined` — holes are absent from HasProperty / Object.keys.
        let elem: AstNode* = NULL;
        if peek_kind(p) == TokenKind::Comma {
            elem = new_node(&p.tracker, NodeKind::HoleExpr,
                            peek(p).start, peek(p).start);
        } else if peek_kind(p) == TokenKind::Ellipsis {
            // `...expr` — spread element. Compiler iterates the value
            // and appends each element to the array under construction.
            let dots = advance(p);
            let inner = parse_assignment(p);
            if inner == NULL { break; }
            let s = new_node(&p.tracker, NodeKind::Spread, dots.start, inner.end);
            s.left = inner;
            elem = s;
        } else {
            elem = parse_assignment(p);
            if elem == NULL { break; }
        }
        if count >= cap {
            let old_cap = cap;
            cap = cap * 2;
            buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
        }
        buf[count] = elem;
        count = count + 1;
        if !match_kind(p, TokenKind::Comma) { break; }
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RBracket);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::Array, lbrack.start, close.start + close.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

fn parse_object(p: Parser*) -> AstNode* {
    let lbrace = advance(p);        // consume '{'
    let cap: u32 = 4;
    let count: u32 = 0;
    let buf = alloc_n<AstNode*>((usize)cap);

    while peek_kind(p) != TokenKind::RBrace && peek_kind(p) != TokenKind::Eof {
        // Object spread: `{ ...src, key: value }`. The Spread node is
        // installed as a property entry; the compiler emits ObjectSpread
        // when it walks it.
        if peek_kind(p) == TokenKind::Ellipsis {
            let dots = advance(p);
            let inner = parse_assignment(p);
            if inner == NULL { break; }
            let s = new_node(&p.tracker, NodeKind::Spread, dots.start, inner.end);
            s.left = inner;
            if count >= cap {
                let old_cap = cap;
                cap = cap * 2;
                buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
            }
            buf[count] = s;
            count = count + 1;
            if !match_kind(p, TokenKind::Comma) { break; }
            continue;
        }
        let key_tok = peek(p);
        // Key: any IdentifierName (Identifier or reserved word),
        // string literal, or numeric literal. Computed-key
        // [expr] forms are TODO.
        if !is_property_name_start(key_tok.kind) {
            p.had_error = true;
            break;
        }

        // Accessor shorthand: `get foo() {...}` / `set foo(v) {...}`.
        // Detected when key is the identifier `get` or `set` AND the
        // next token is an identifier (the property name) rather than
        // `:` / `(` / `,` / `}`. Compiles into the existing accessor
        // path via a synthetic Object.defineProperty-shaped node.
        let is_accessor: bool = false;
        let is_setter: bool = false;
        if key_tok.kind == TokenKind::Identifier && key_tok.length == 3 {
            let kd = p.source + key_tok.start;
            let g_match: int = 0;
            let s_match: int = 0;
            raw {
                g_match = (memcmp(kd, "get", 3) == 0) ? 1 : 0;
                s_match = (memcmp(kd, "set", 3) == 0) ? 1 : 0;
            }
            if (g_match != 0 || s_match != 0) {
                let after = peek_kind2(p);
                if after == TokenKind::Identifier
                    || after == TokenKind::StringLit
                    || after == TokenKind::NumberLit {
                    is_accessor = true;
                    is_setter = s_match != 0;
                }
            }
        }

        advance(p);

        let prop_start = key_tok.start;
        let prop_end = key_tok.start + key_tok.length;

        // Handle accessor first — replaces key_tok-as-name with the
        // real property name following `get`/`set`, and parses the
        // getter/setter function shape.
        if is_accessor {
            let real_name_tok = peek(p);
            advance(p);
            if !expect_kind(p, TokenKind::LParen) { break; }
            let params = parse_param_list(p);
            if !expect_kind(p, TokenKind::RParen) { break; }
            if peek_kind(p) != TokenKind::LBrace { p.had_error = true; break; }
            p.function_depth = p.function_depth + 1;
            let body = parse_block(p);
            p.function_depth = p.function_depth - 1;
            if body == NULL { break; }

            let accessor_fn = new_node(&p.tracker, NodeKind::FunctionExpr,
                                       real_name_tok.start, body.end);
            accessor_fn.name_start  = real_name_tok.start;
            accessor_fn.name_length = real_name_tok.length;
            accessor_fn.left = body;
            accessor_fn.children = params.arr;
            accessor_fn.children_count = params.count;

            let prop = new_node(&p.tracker, NodeKind::ObjectProp,
                                key_tok.start, body.end);
            prop.name_start = real_name_tok.start;
            prop.name_length = real_name_tok.length;
            prop.left = accessor_fn;
            // op carries the accessor kind so compile_object can wire
            // it through Op::SetGet / Op::SetSet (or whatever path).
            // We reuse TokenKind::KwGet / KwSet if available, else the
            // simpler boolean stashing below.
            if is_setter { prop.op = TokenKind::KwSet; }
            else         { prop.op = TokenKind::KwGet; }

            if count >= cap {
                let old_cap = cap;
                cap = cap * 2;
                buf = realloc_n<AstNode*>(buf, (usize)old_cap, (usize)cap);
            }
            buf[count] = prop;
            count = count + 1;

            if !match_kind(p, TokenKind::Comma) { break; }
            continue;
        }

        let value: AstNode* = NULL;
        if match_kind(p, TokenKind::Colon) {
            value = parse_assignment(p);
            if value == NULL { break; }
            prop_end = value.end;
        } else if peek_kind(p) == TokenKind::LParen {
            // Method shorthand: { foo() {} } desugars to { foo: function foo() {} }.
            // ECMA-262 §13.2.5 MethodDefinition.
            if !expect_kind(p, TokenKind::LParen) { break; }
            let params = parse_param_list(p);
            if !expect_kind(p, TokenKind::RParen) { break; }
            if peek_kind(p) != TokenKind::LBrace { p.had_error = true; break; }
            p.function_depth = p.function_depth + 1;
            let body = parse_block(p);
            p.function_depth = p.function_depth - 1;
            if body == NULL { break; }
            let method_fn = new_node(&p.tracker, NodeKind::FunctionExpr, key_tok.start, body.end);
            method_fn.name_start  = key_tok.start;
            method_fn.name_length = key_tok.length;
            method_fn.left = body;
            method_fn.children = params.arr;
            method_fn.children_count = params.count;
            value = method_fn;
            prop_end = body.end;
        } else {
            // Shorthand: { x } = { x: x }. Only valid if key is an Identifier.
            if key_tok.kind != TokenKind::Identifier {
                p.had_error = true;
                break;
            }
            value = new_node(&p.tracker, NodeKind::IdentExpr, key_tok.start, key_tok.start + key_tok.length);
        }

        let prop = new_node(&p.tracker, NodeKind::ObjectProp, prop_start, prop_end);
        prop.name_start = key_tok.start;
        prop.name_length = key_tok.length;
        prop.left = value;

        if count >= cap {
            cap = cap * 2;
            raw {
                buf = (AstNode**)realloc(buf, cap * sizeof(AstNode*));
            }
        }
        buf[count] = prop;
        count = count + 1;

        if !match_kind(p, TokenKind::Comma) { break; }
    }

    let close = peek(p);
    expect_kind(p, TokenKind::RBrace);

    if count > 0 { alloc_list_push(&p.tracker, (void*)buf); }
    else         { dealloc(buf); buf = NULL; }

    let node = new_node(&p.tracker, NodeKind::Object, lbrace.start, close.start + close.length);
    node.children = buf;
    node.children_count = count;
    return node;
}

// =====================================================================
// Numeric literal decoding. Called once per NumberLit at parse time so
// the AST already carries the unboxed f64.
// =====================================================================

fn parse_number_literal(source: char*, start: u32, length: u32) -> f64 {
    // Copy the slice into a stack buffer + null-terminator; call strtod
    // (or hand-roll for prefixed forms). Source slices may not be
    // null-terminated; we have to copy.
    let buf: u8[64];
    let copy_len: u32 = length;
    if copy_len > 63 { copy_len = 63; }
    let i: u32 = 0;
    while i < copy_len {
        buf[i] = (u8)source[start + i];
        i = i + 1;
    }
    buf[copy_len] = 0;

    // Hex / binary / octal — first two chars are 0x / 0b / 0o.
    if length >= 2 && buf[0] == (u8)'0' {
        let c1 = buf[1];
        if c1 == (u8)'x' || c1 == (u8)'X' { return parse_int_prefix(&buf[2], copy_len - 2, 16); }
        if c1 == (u8)'b' || c1 == (u8)'B' { return parse_int_prefix(&buf[2], copy_len - 2, 2); }
        if c1 == (u8)'o' || c1 == (u8)'O' { return parse_int_prefix(&buf[2], copy_len - 2, 8); }
    }

    // Decimal / scientific via strtod.
    let result: f64 = 0.0;
    raw {
        result = strtod((const char*)&buf[0], NULL);
    }
    return result;
}

fn parse_int_prefix(digits: u8*, len: u32, base: u32) -> f64 {
    let acc: f64 = 0.0;
    let i: u32 = 0;
    while i < len {
        let c = digits[i];
        let d: u32 = 0;
        if c >= (u8)'0' && c <= (u8)'9' { d = (u32)(c - (u8)'0'); }
        else if c >= (u8)'a' && c <= (u8)'f' { d = (u32)(c - (u8)'a') + 10; }
        else if c >= (u8)'A' && c <= (u8)'F' { d = (u32)(c - (u8)'A') + 10; }
        else { return acc; }
        acc = acc * (f64)base + (f64)d;
        i = i + 1;
    }
    return acc;
}
