// Lexer — converts source bytes into a token stream.
//
// Single-pass, hand-written, no allocation. Tokens slice into the
// caller-owned `source` buffer; the lexer borrows that pointer for
// its lifetime. Whitespace and comments are silently skipped between
// real tokens. EOF is returned indefinitely past end-of-input — the
// parser tolerates that better than a special "no more tokens" sentinel.
//
// ASCII-only identifiers for now (Unicode IdentifierStart deferred).
// Numeric values and string contents are NOT decoded here — the
// emitted token is a source slice; the bytecode compiler will parse
// the digits / unescape the characters when it materializes constants.

import "./token.zc";

struct Lexer {
    source: char*;
    pos:    usize;
    len:    usize;
    line:   u32;
    // ECMA-262 §12.2.1 — InputElementDiv vs InputElementRegExp. Whether
    // the next `/` should lex as division or as a regex literal depends
    // on what the previous significant token expects to be followed by:
    // after a value-producing token (identifier / number / string / `)`
    // / `]` / `++` / `--` / `}`) we expect a binary operator, so `/` is
    // division; after almost everything else we expect a fresh
    // expression, so `/` starts a regex literal. Updated after each
    // token by `expect_regex_after`.
    expect_regex: bool;
    // The kind of the most-recently-emitted token. Used to refine the
    // `} /...` ambiguity: a `}` that's followed by a newline before
    // `/` is almost certainly the end of a block statement (function
    // body, if-block, etc.) where ASI inserts a `;` and the next
    // statement starts with a regex literal — `function f() { return
    // /x/.test }\n /y/.test(...)`. Without the newline, `}/` is much
    // more likely an object-literal followed by division.
    prev_kind: TokenKind;
    crossed_newline: bool;
}

impl Lexer {
    fn new(source: char*, len: usize) -> Self {
        return Lexer{
            source: source,
            pos:    0,
            len:    len,
            line:   1,
            // At source start we're expecting an expression, so a
            // leading `/foo/` is a regex literal.
            expect_regex: true,
            prev_kind: TokenKind::Eof,
            crossed_newline: false,
        };
    }

    // --- Cursor primitives ------------------------------------------

    fn at_end(self) -> bool {
        return self.pos >= self.len;
    }

    fn peek(self) -> u8 {
        if self.pos >= self.len { return 0; }
        return (u8)self.source[self.pos];
    }

    fn peek_at(self, offset: usize) -> u8 {
        let p = self.pos + offset;
        if p >= self.len { return 0; }
        return (u8)self.source[p];
    }

    fn advance(self) -> u8 {
        let c = self.peek();
        self.pos = self.pos + 1;
        if c == (u8)'\n' { self.line = self.line + 1; }
        return c;
    }

    fn match_char(self, expected: u8) -> bool {
        if self.peek() != expected { return false; }
        self.advance();
        return true;
    }

    // --- Whitespace + comments --------------------------------------

    fn skip_trivia(self) -> void {
        self.crossed_newline = false;
        while !self.at_end() {
            let c = self.peek();
            if c == (u8)' ' || c == (u8)'\t' || c == (u8)'\r' || c == (u8)'\n'
               || c == 0x0B || c == 0x0C {
                if c == (u8)'\n' { self.crossed_newline = true; }
                self.advance();
            } else if c == 0xC2 && self.peek_at(1) == 0xA0 {
                // U+00A0 NO-BREAK SPACE (UTF-8: C2 A0).
                self.advance(); self.advance();
            } else if c == 0xEF && self.peek_at(1) == 0xBB && self.peek_at(2) == 0xBF {
                // U+FEFF ZERO WIDTH NO-BREAK SPACE / BOM (UTF-8: EF BB BF).
                self.advance(); self.advance(); self.advance();
            } else if c == 0xE2 && self.peek_at(1) == 0x80
                      && (self.peek_at(2) == 0xA8 || self.peek_at(2) == 0xA9) {
                // U+2028 LINE SEPARATOR / U+2029 PARAGRAPH SEPARATOR
                // (UTF-8: E2 80 A8 / E2 80 A9) — both are line terminators.
                self.crossed_newline = true;
                self.advance(); self.advance(); self.advance();
            } else if c == (u8)'/' && self.peek_at(1) == (u8)'/' {
                // line comment: consume until newline (don't eat the newline itself —
                // advance() will count it next pass through the loop)
                self.advance();
                self.advance();
                while !self.at_end() && self.peek() != (u8)'\n' {
                    self.advance();
                }
            } else if c == (u8)'/' && self.peek_at(1) == (u8)'*' {
                // block comment: consume until "*/"
                self.advance();
                self.advance();
                while !self.at_end() {
                    if self.peek() == (u8)'*' && self.peek_at(1) == (u8)'/' {
                        self.advance();
                        self.advance();
                        break;
                    }
                    self.advance();
                }
            } else {
                return;
            }
        }
    }

    // --- Top-level entry --------------------------------------------

    fn next_token(self) -> Token {
        let t = self.next_token_inner();
        self.expect_regex = expect_regex_after(t.kind);
        self.prev_kind = t.kind;
        return t;
    }

    fn next_token_inner(self) -> Token {
        self.skip_trivia();
        if self.at_end() {
            return token_eof((u32)self.pos);
        }

        let start: u32 = (u32)self.pos;
        let c = self.peek();

        if is_id_start(c) {
            return self.scan_identifier_or_keyword(start);
        }
        // `\uXXXX` / `\u{...}` is a valid IdentifierStart per spec —
        // accept it here so the body of scan_identifier_or_keyword
        // can do the full pass.
        if c == (u8)'\\' && self.peek_at(1) == (u8)'u' {
            return self.scan_identifier_or_keyword(start);
        }
        if is_digit(c) {
            return self.scan_number(start);
        }
        if c == (u8)'"' || c == (u8)'\'' {
            return self.scan_string(start, c);
        }
        if c == (u8)'`' {
            return self.scan_template(start);
        }
        // '.' is special: it may be a NumberLit (`.5`), an Ellipsis (`...`),
        // or just `Dot`.
        if c == (u8)'.' {
            if is_digit(self.peek_at(1)) {
                return self.scan_number(start);
            }
            if self.peek_at(1) == (u8)'.' && self.peek_at(2) == (u8)'.' {
                self.advance(); self.advance(); self.advance();
                return Token{kind: TokenKind::Ellipsis, start: start, length: 3};
            }
            self.advance();
            return Token{kind: TokenKind::Dot, start: start, length: 1};
        }

        return self.scan_punctuator(start);
    }

    // --- Identifier / keyword ---------------------------------------

    fn scan_identifier_or_keyword(self, start: u32) -> Token {
        // First char is is_id_start OR a `\u` escape (caller-checked).
        let has_escape: bool = false;
        // Consume the first char (either an id_start byte or a
        // `\uXXXX` / `\u{...}` escape).
        if self.peek() == (u8)'\\' {
            if !self.consume_unicode_escape() {
                return Token{kind: TokenKind::Invalid, start: start, length: 1};
            }
            has_escape = true;
        } else {
            self.advance();
        }
        while !self.at_end() {
            let c = self.peek();
            if is_id_part(c) {
                self.advance();
            } else if c == (u8)'\\' && self.peek_at(1) == (u8)'u' {
                if !self.consume_unicode_escape() {
                    return Token{kind: TokenKind::Invalid, start: start, length: 1};
                }
                has_escape = true;
            } else {
                break;
            }
        }
        let length: u32 = (u32)self.pos - start;
        // If any escape was used, this is an IdentifierName but NOT
        // a reserved word (spec): `if` is an identifier, never a
        // keyword. Force Identifier kind to keep keyword positions strict.
        if has_escape {
            return Token{kind: TokenKind::Identifier, start: start, length: length};
        }
        let kind = lookup_keyword(self.source + start, (usize)length);
        return Token{kind: kind, start: start, length: length};
    }

    // Consumes a `\uXXXX` or `\u{...}` escape after verifying that
    // the resulting code point would be a valid IdentifierPart/Start.
    // Currently restricts code points to ASCII id_part chars — the
    // lexer is ASCII-only elsewhere, so accepting non-ASCII via escape
    // would be inconsistent with the rest of identifier scanning.
    fn consume_unicode_escape(self) -> bool {
        if self.peek() != (u8)'\\' || self.peek_at(1) != (u8)'u' { return false; }
        self.advance(); self.advance();    // \u
        let cp: u32 = 0;
        if self.peek() == (u8)'{' {
            self.advance();
            let n: u32 = 0;
            while !self.at_end() && self.peek() != (u8)'}' {
                let d = hex_digit_val(self.peek());
                if d < 0 { return false; }
                cp = (cp << 4) | (u32)d;
                n = n + 1;
                if n > 6 || cp > 0x10FFFF { return false; }
                self.advance();
            }
            if self.peek() != (u8)'}' { return false; }
            self.advance();
        } else {
            let i: u32 = 0;
            while i < 4 {
                let d = hex_digit_val(self.peek());
                if d < 0 { return false; }
                cp = (cp << 4) | (u32)d;
                self.advance();
                i = i + 1;
            }
        }
        // Restrict to ASCII id_part for now.
        if cp > 0x7F { return false; }
        if !is_id_part((u8)cp) { return false; }
        return true;
    }

    // --- Number -----------------------------------------------------

    fn scan_number(self, start: u32) -> Token {
        let c0 = self.peek();
        let c1 = self.peek_at(1);

        // Numeric separator '_': accept inside any digit run (decimal,
        // hex, binary, octal, exponent). The parser strips them when
        // converting to f64. We don't enforce the spec edge cases
        // (consecutive _, leading/trailing _) — tests that exercise
        // those expect a SyntaxError we don't surface, which is its
        // own tracked gap.
        if c0 == (u8)'0' && (c1 == (u8)'x' || c1 == (u8)'X') {
            self.advance(); self.advance();
            while !self.at_end() && (is_hex_digit(self.peek()) || self.peek() == (u8)'_') { self.advance(); }
            return Token{kind: TokenKind::NumberLit, start: start, length: (u32)self.pos - start};
        }
        if c0 == (u8)'0' && (c1 == (u8)'b' || c1 == (u8)'B') {
            self.advance(); self.advance();
            while !self.at_end() && (self.peek() == (u8)'0' || self.peek() == (u8)'1' || self.peek() == (u8)'_') { self.advance(); }
            return Token{kind: TokenKind::NumberLit, start: start, length: (u32)self.pos - start};
        }
        if c0 == (u8)'0' && (c1 == (u8)'o' || c1 == (u8)'O') {
            self.advance(); self.advance();
            while !self.at_end() && ((self.peek() >= (u8)'0' && self.peek() <= (u8)'7') || self.peek() == (u8)'_') { self.advance(); }
            return Token{kind: TokenKind::NumberLit, start: start, length: (u32)self.pos - start};
        }

        // Decimal integer part (may be empty if we started on '.').
        while !self.at_end() && (is_digit(self.peek()) || self.peek() == (u8)'_') { self.advance(); }

        // Optional fractional part.
        if self.peek() == (u8)'.' {
            self.advance();
            while !self.at_end() && (is_digit(self.peek()) || self.peek() == (u8)'_') { self.advance(); }
        }

        // Optional exponent.
        if self.peek() == (u8)'e' || self.peek() == (u8)'E' {
            self.advance();
            if self.peek() == (u8)'+' || self.peek() == (u8)'-' { self.advance(); }
            while !self.at_end() && (is_digit(self.peek()) || self.peek() == (u8)'_') { self.advance(); }
        }

        return Token{kind: TokenKind::NumberLit, start: start, length: (u32)self.pos - start};
    }

    // --- String -----------------------------------------------------

    fn scan_string(self, start: u32, quote: u8) -> Token {
        self.advance(); // consume opening quote
        while !self.at_end() {
            let c = self.peek();
            if c == quote {
                self.advance();
                return Token{kind: TokenKind::StringLit, start: start, length: (u32)self.pos - start};
            }
            if c == (u8)'\n' {
                // unterminated string at end of line
                return Token{kind: TokenKind::Invalid, start: start, length: (u32)self.pos - start};
            }
            if c == (u8)'\\' {
                self.advance();
                if !self.at_end() { self.advance(); }
            } else {
                self.advance();
            }
        }
        // ran off the end without a closing quote
        return Token{kind: TokenKind::Invalid, start: start, length: (u32)self.pos - start};
    }

    // --- Template literal -------------------------------------------
    //
    // Emits a single TemplateLit token covering the entire backtick-
    // delimited literal including all ${...} interpolations. The parser
    // walks the slice to extract the cooked string segments and
    // re-parses each expression separately. This keeps the lexer free
    // of parser-driven mode switching at the cost of one extra source
    // pass per template.
    //
    // Embedded ${ ... } balances braces; nested template literals,
    // strings, and regexes inside an expression are tracked just well
    // enough to find the matching `}`. The slow path is the parser's
    // problem — surface errors there rather than mis-tokenize here.

    fn scan_template(self, start: u32) -> Token {
        self.advance(); // consume opening backtick
        while !self.at_end() {
            let c = self.peek();
            if c == (u8)'`' {
                self.advance();
                return Token{kind: TokenKind::TemplateLit, start: start, length: (u32)self.pos - start};
            }
            if c == (u8)'\\' {
                self.advance();
                if !self.at_end() { self.advance(); }
                continue;
            }
            if c == (u8)'$' && self.peek_at(1) == (u8)'{' {
                self.advance(); self.advance(); // past `${`
                if !self.scan_template_substitution() {
                    return Token{kind: TokenKind::Invalid, start: start, length: (u32)self.pos - start};
                }
                continue;
            }
            self.advance();
        }
        return Token{kind: TokenKind::Invalid, start: start, length: (u32)self.pos - start};
    }

    // Skip past the body of a `${ ... }` substitution. Tracks balanced
    // braces, recursing into nested templates / strings / line comments
    // / block comments / regexes (best-effort). Returns false on
    // unterminated input.
    fn scan_template_substitution(self) -> bool {
        let depth: u32 = 1;
        while depth > 0 && !self.at_end() {
            let c = self.peek();
            if c == (u8)'{' { self.advance(); depth = depth + 1; continue; }
            if c == (u8)'}' { self.advance(); depth = depth - 1; continue; }
            if c == (u8)'\\' {
                self.advance();
                if !self.at_end() { self.advance(); }
                continue;
            }
            if c == (u8)'`' {
                // Nested template — recurse via scan_template's loop
                // body to consume it whole.
                self.advance();
                while !self.at_end() && self.peek() != (u8)'`' {
                    let ic = self.peek();
                    if ic == (u8)'\\' {
                        self.advance();
                        if !self.at_end() { self.advance(); }
                        continue;
                    }
                    if ic == (u8)'$' && self.peek_at(1) == (u8)'{' {
                        self.advance(); self.advance();
                        if !self.scan_template_substitution() { return false; }
                        continue;
                    }
                    self.advance();
                }
                if !self.at_end() { self.advance(); } // closing `
                continue;
            }
            if c == (u8)'"' || c == (u8)'\'' {
                let quote = c;
                self.advance();
                while !self.at_end() && self.peek() != quote {
                    if self.peek() == (u8)'\\' {
                        self.advance();
                        if !self.at_end() { self.advance(); }
                    } else if self.peek() == (u8)'\n' {
                        return false;
                    } else {
                        self.advance();
                    }
                }
                if !self.at_end() { self.advance(); }
                continue;
            }
            self.advance();
        }
        return depth == 0;
    }

    // --- Punctuators ------------------------------------------------
    //
    // Single-char dispatch, with longest-match for multi-char operators
    // built up explicitly. ECMA-262 §12.7 surface coverage.

    fn scan_punctuator(self, start: u32) -> Token {
        let c = self.advance();

        if c == (u8)'(' { return self.tok1(TokenKind::LParen, start); }
        if c == (u8)')' { return self.tok1(TokenKind::RParen, start); }
        if c == (u8)'[' { return self.tok1(TokenKind::LBracket, start); }
        if c == (u8)']' { return self.tok1(TokenKind::RBracket, start); }
        if c == (u8)'{' { return self.tok1(TokenKind::LBrace, start); }
        if c == (u8)'}' { return self.tok1(TokenKind::RBrace, start); }
        if c == (u8)',' { return self.tok1(TokenKind::Comma, start); }
        if c == (u8)';' { return self.tok1(TokenKind::Semicolon, start); }
        if c == (u8)':' { return self.tok1(TokenKind::Colon, start); }
        if c == (u8)'~' { return self.tok1(TokenKind::Tilde, start); }

        if c == (u8)'?' {
            if self.match_char((u8)'?') {
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::QuestionQuestionEq, start); }
                return self.tok_n(TokenKind::QuestionQuestion, start);
            }
            if self.match_char((u8)'.') { return self.tok_n(TokenKind::QuestionDot, start); }
            return self.tok1(TokenKind::Question, start);
        }

        if c == (u8)'!' {
            if self.match_char((u8)'=') {
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::BangEqEq, start); }
                return self.tok_n(TokenKind::BangEq, start);
            }
            return self.tok1(TokenKind::Bang, start);
        }

        if c == (u8)'=' {
            if self.match_char((u8)'=') {
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::EqEqEq, start); }
                return self.tok_n(TokenKind::EqEq, start);
            }
            if self.match_char((u8)'>') { return self.tok_n(TokenKind::Arrow, start); }
            return self.tok1(TokenKind::Eq, start);
        }

        if c == (u8)'<' {
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::LtEq, start); }
            if self.match_char((u8)'<') {
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::LtLtEq, start); }
                return self.tok_n(TokenKind::LtLt, start);
            }
            return self.tok1(TokenKind::Lt, start);
        }

        if c == (u8)'>' {
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::GtEq, start); }
            if self.match_char((u8)'>') {
                if self.match_char((u8)'>') {
                    if self.match_char((u8)'=') { return self.tok_n(TokenKind::GtGtGtEq, start); }
                    return self.tok_n(TokenKind::GtGtGt, start);
                }
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::GtGtEq, start); }
                return self.tok_n(TokenKind::GtGt, start);
            }
            return self.tok1(TokenKind::Gt, start);
        }

        if c == (u8)'+' {
            if self.match_char((u8)'+') { return self.tok_n(TokenKind::PlusPlus, start); }
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::PlusEq, start); }
            return self.tok1(TokenKind::Plus, start);
        }

        if c == (u8)'-' {
            if self.match_char((u8)'-') { return self.tok_n(TokenKind::MinusMinus, start); }
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::MinusEq, start); }
            return self.tok1(TokenKind::Minus, start);
        }

        if c == (u8)'*' {
            if self.match_char((u8)'*') {
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::StarStarEq, start); }
                return self.tok_n(TokenKind::StarStar, start);
            }
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::StarEq, start); }
            return self.tok1(TokenKind::Star, start);
        }

        if c == (u8)'/' {
            // Contextual: regex literal vs division. `expect_regex` is
            // set/cleared after every token by next_token's post-pass.
            // The opening `/` has already been consumed by the
            // `let c = self.advance()` at the top of this fn.
            //
            // Special case for `}` followed by a newline-then-`/` — this
            // is the ASI-disambiguated "end of block statement, then a
            // new expression statement starting with a regex literal"
            // pattern. The plain `}/` case (no newline) is left as
            // division because `{}/x` is the more common shape.
            let force_regex: bool =
                self.expect_regex
                || (self.prev_kind == TokenKind::RBrace && self.crossed_newline);
            if force_regex {
                return self.scan_regex_body(start);
            }
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::SlashEq, start); }
            return self.tok1(TokenKind::Slash, start);
        }

        if c == (u8)'%' {
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::PercentEq, start); }
            return self.tok1(TokenKind::Percent, start);
        }

        if c == (u8)'&' {
            if self.match_char((u8)'&') {
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::AmpAmpEq, start); }
                return self.tok_n(TokenKind::AmpAmp, start);
            }
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::AmpEq, start); }
            return self.tok1(TokenKind::Amp, start);
        }

        if c == (u8)'|' {
            if self.match_char((u8)'|') {
                if self.match_char((u8)'=') { return self.tok_n(TokenKind::PipePipeEq, start); }
                return self.tok_n(TokenKind::PipePipe, start);
            }
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::PipeEq, start); }
            return self.tok1(TokenKind::Pipe, start);
        }

        if c == (u8)'^' {
            if self.match_char((u8)'=') { return self.tok_n(TokenKind::CaretEq, start); }
            return self.tok1(TokenKind::Caret, start);
        }

        return token_invalid(start);
    }

    // --- Regex literal ---------------------------------------------------

    // Consume `pattern/flags` after the opening `/` has already been
    // eaten. Stops on: closing `/`, raw newline (invalid — ECMA-262
    // disallows LineTerminator in a regex body), or EOF. Tracks
    // character-class depth so that `/` inside `[...]` is literal.
    // Backslash escapes the next char (including `/` and the class
    // brackets). The whole literal — including the surrounding slashes
    // and any flag letters after the closing slash — is returned as one
    // RegexLit token; the parser carves out source/flags.
    fn scan_regex_body(self, start: u32) -> Token {
        let in_class: bool = false;
        while !self.at_end() {
            let c = self.peek();
            if c == (u8)'\n' || c == (u8)'\r' { return token_invalid(start); }
            if c == (u8)'\\' {
                self.advance();
                if !self.at_end() {
                    let nc = self.peek();
                    if nc == (u8)'\n' || nc == (u8)'\r' { return token_invalid(start); }
                    self.advance();
                }
                continue;
            }
            if c == (u8)'[' { in_class = true; self.advance(); continue; }
            if c == (u8)']' { in_class = false; self.advance(); continue; }
            if c == (u8)'/' && !in_class {
                self.advance();   // closing slash
                // Flags: greedy run of identifier-part chars (g/i/m/s/u/y/d).
                while !self.at_end() && is_id_part(self.peek()) {
                    self.advance();
                }
                return self.tok_n(TokenKind::RegexLit, start);
            }
            self.advance();
        }
        return token_invalid(start);
    }

    // --- Token constructors (after the cursor has advanced) ---------

    fn tok1(self, kind: TokenKind, start: u32) -> Token {
        return Token{kind: kind, start: start, length: 1};
    }

    fn tok_n(self, kind: TokenKind, start: u32) -> Token {
        return Token{kind: kind, start: start, length: (u32)self.pos - start};
    }
}

// =====================================================================
// Eager helper — fills a caller-owned buffer with tokens. Returns the
// count emitted (always includes a trailing Eof). Stops if buf would
// overflow; caller can detect by comparing returned count to capacity.
// =====================================================================

// Whether the *next* `/` should lex as a regex literal, given the
// kind of token that was just emitted. Anything that produces a
// value (literal, identifier, postfix increment, closing
// paren/bracket, closing brace) blocks regex-mode; everything else
// (binary ops, opening punctuators, keywords that take an
// expression, `;`, etc.) leaves it on.
//
// `}` is treated as div-mode: the strict rule depends on whether
// the `}` closes a block statement (next `/` is regex — `function f()
// { return /x/ }`) vs an object literal (next `/` is division —
// `({}) / 2`). The lexer can't tell, but div-mode is the more common
// real-world case, and the regex case still works with the standard
// `; /x/` form. Most test262 regex tests put the literal at the
// start of an expression statement, not after a bare `}`.
fn expect_regex_after(kind: TokenKind) -> bool {
    if kind == TokenKind::Identifier
       || kind == TokenKind::NumberLit
       || kind == TokenKind::StringLit
       || kind == TokenKind::RegexLit
       || kind == TokenKind::RParen
       || kind == TokenKind::RBracket
       || kind == TokenKind::RBrace
       || kind == TokenKind::PlusPlus
       || kind == TokenKind::MinusMinus
       || kind == TokenKind::KwTrue
       || kind == TokenKind::KwFalse
       || kind == TokenKind::KwNull
       || kind == TokenKind::KwUndefined
       || kind == TokenKind::KwThis
       || kind == TokenKind::KwSuper
       // Contextual keywords that can also stand in as identifiers
       // (`let of = 6; instance/of/g` is a chain of divisions). The
       // lexer can't tell the difference without parser feedback;
       // treating these as value-producers is the right call because
       // the genuine keyword positions (`for ... of`, `import ... as ...`,
       // `async ()=>`) never sit directly before `/`.
       || kind == TokenKind::KwOf
       || kind == TokenKind::KwAs
       || kind == TokenKind::KwFrom
       || kind == TokenKind::KwGet
       || kind == TokenKind::KwSet
       || kind == TokenKind::KwAsync
       || kind == TokenKind::KwAwait
       || kind == TokenKind::KwYield {
        return false;
    }
    return true;
}

fn tokenize_into(source: char*, len: usize, out: Token*, cap: usize) -> usize {
    let lex = Lexer::new(source, len);
    let n: usize = 0;
    while n < cap {
        let t = lex.next_token();
        out[n] = t;
        n = n + 1;
        if t.kind == TokenKind::Eof { return n; }
    }
    return n;
}

// =====================================================================
// Character classification (ASCII fast paths).
// =====================================================================

fn is_digit(c: u8) -> bool {
    return c >= (u8)'0' && c <= (u8)'9';
}

fn is_hex_digit(c: u8) -> bool {
    if is_digit(c) { return true; }
    if c >= (u8)'a' && c <= (u8)'f' { return true; }
    if c >= (u8)'A' && c <= (u8)'F' { return true; }
    return false;
}

// Returns 0–15 for a hex digit, -1 otherwise. Useful when the value
// is needed (vs just classification).
fn hex_digit_val(c: u8) -> int {
    if c >= (u8)'0' && c <= (u8)'9' { return (int)(c - (u8)'0'); }
    if c >= (u8)'a' && c <= (u8)'f' { return (int)(c - (u8)'a') + 10; }
    if c >= (u8)'A' && c <= (u8)'F' { return (int)(c - (u8)'A') + 10; }
    return -1;
}

fn is_alpha(c: u8) -> bool {
    if c >= (u8)'a' && c <= (u8)'z' { return true; }
    if c >= (u8)'A' && c <= (u8)'Z' { return true; }
    return false;
}

fn is_id_start(c: u8) -> bool {
    if is_alpha(c) { return true; }
    if c == (u8)'_' { return true; }
    if c == (u8)'$' { return true; }
    return false;
}

fn is_id_part(c: u8) -> bool {
    if is_id_start(c) { return true; }
    if is_digit(c) { return true; }
    return false;
}

// =====================================================================
// Keyword recognition. Linear walk for now — ~40 entries, only runs
// after a full identifier has already been scanned. Profile first if
// this ever shows up hot; then swap in length-bucketed dispatch or
// gperf.
// =====================================================================

fn streq_n(a: char*, alen: usize, b: char*, blen: usize) -> bool {
    if alen != blen { return false; }
    let i: usize = 0;
    while i < alen {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn lookup_keyword(text: char*, len: usize) -> TokenKind {
    if streq_n(text, len, "var", 3)         { return TokenKind::KwVar; }
    if streq_n(text, len, "let", 3)         { return TokenKind::KwLet; }
    if streq_n(text, len, "const", 5)       { return TokenKind::KwConst; }
    if streq_n(text, len, "function", 8)    { return TokenKind::KwFunction; }
    if streq_n(text, len, "return", 6)      { return TokenKind::KwReturn; }
    if streq_n(text, len, "if", 2)          { return TokenKind::KwIf; }
    if streq_n(text, len, "else", 4)        { return TokenKind::KwElse; }
    if streq_n(text, len, "for", 3)         { return TokenKind::KwFor; }
    if streq_n(text, len, "while", 5)       { return TokenKind::KwWhile; }
    if streq_n(text, len, "do", 2)          { return TokenKind::KwDo; }
    if streq_n(text, len, "break", 5)       { return TokenKind::KwBreak; }
    if streq_n(text, len, "continue", 8)    { return TokenKind::KwContinue; }
    if streq_n(text, len, "class", 5)       { return TokenKind::KwClass; }
    if streq_n(text, len, "extends", 7)     { return TokenKind::KwExtends; }
    if streq_n(text, len, "super", 5)       { return TokenKind::KwSuper; }
    if streq_n(text, len, "new", 3)         { return TokenKind::KwNew; }
    if streq_n(text, len, "this", 4)        { return TokenKind::KwThis; }
    if streq_n(text, len, "true", 4)        { return TokenKind::KwTrue; }
    if streq_n(text, len, "false", 5)       { return TokenKind::KwFalse; }
    if streq_n(text, len, "null", 4)        { return TokenKind::KwNull; }
    if streq_n(text, len, "undefined", 9)   { return TokenKind::KwUndefined; }
    if streq_n(text, len, "typeof", 6)      { return TokenKind::KwTypeof; }
    if streq_n(text, len, "delete", 6)      { return TokenKind::KwDelete; }
    if streq_n(text, len, "void", 4)        { return TokenKind::KwVoid; }
    if streq_n(text, len, "in", 2)          { return TokenKind::KwIn; }
    if streq_n(text, len, "of", 2)          { return TokenKind::KwOf; }
    if streq_n(text, len, "instanceof", 10) { return TokenKind::KwInstanceof; }
    if streq_n(text, len, "throw", 5)       { return TokenKind::KwThrow; }
    if streq_n(text, len, "try", 3)         { return TokenKind::KwTry; }
    if streq_n(text, len, "catch", 5)       { return TokenKind::KwCatch; }
    if streq_n(text, len, "finally", 7)     { return TokenKind::KwFinally; }
    if streq_n(text, len, "switch", 6)      { return TokenKind::KwSwitch; }
    if streq_n(text, len, "case", 4)        { return TokenKind::KwCase; }
    if streq_n(text, len, "default", 7)     { return TokenKind::KwDefault; }
    if streq_n(text, len, "async", 5)       { return TokenKind::KwAsync; }
    if streq_n(text, len, "await", 5)       { return TokenKind::KwAwait; }
    if streq_n(text, len, "yield", 5)       { return TokenKind::KwYield; }
    if streq_n(text, len, "import", 6)      { return TokenKind::KwImport; }
    if streq_n(text, len, "export", 6)      { return TokenKind::KwExport; }
    if streq_n(text, len, "from", 4)        { return TokenKind::KwFrom; }
    if streq_n(text, len, "as", 2)          { return TokenKind::KwAs; }
    return TokenKind::Identifier;
}
