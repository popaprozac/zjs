    object_set(ctx, temporal_o, ctx_intern_atom(ctx, (char*)"PlainYearMonth", 14), ym_ctor);

    // --- Temporal.PlainMonthDay ---
    let md_ctor_ptr: void* = NULL; raw { md_ctor_ptr = (void*)host_temporal_monthday_ctor; }
