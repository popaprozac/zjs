    let console_o = zjs_as_object(console_v);
    let log_ptr:   void* = NULL; raw { log_ptr   = (void*)host_console_log; }
    let info_ptr:  void* = NULL; raw { info_ptr  = (void*)host_console_info; }
    let warn_ptr:  void* = NULL; raw { warn_ptr  = (void*)host_console_warn; }
    let cerr_ptr:  void* = NULL; raw { cerr_ptr  = (void*)host_console_error; }
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"log", 3),
