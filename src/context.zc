fn host_math_sign(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    // Per spec: NaN→NaN; -0→-0; +0→+0; positive→1; negative→-1.
    let is_nan: int = 0;
    raw { is_nan = isnan(d) ? 1 : 0; }
    if is_nan != 0 { return zjs_double(d); }
    if d > 0.0 { return zjs_int32(1); }
    if d < 0.0 { return zjs_int32(-1); }
    return zjs_double(d);   // preserves signed zero
}
fn host_math_hypot(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §21.3.2.18: ToNumber every arg left-to-right; any abrupt
    // completion aborts (no remaining valueOf is consulted). Then the
    // result is sqrt(sum of squares), with the special-case that any
    // ±Infinity input → +Infinity result.
    if argc == 0 { return zjs_double(0.0); }
    let pre = alloc_n<f64>((usize)argc);
    let i: u32 = 0;
    while i < argc {
        let av = args[i];
        // Route objects through ToPrimitive("number") so their valueOf
        // fires (and any throw aborts further argument processing).
        if zjs_is_object(av) != 0 || zjs_is_array(av) != 0 {
            av = zjs_to_primitive(ctx, av, false);
            if ctx.pending_throw_active { dealloc(pre); return zjs_undefined(); }
        }
        let d = zjs_to_double(av);
        if ctx.pending_throw_active { dealloc(pre); return zjs_undefined(); }
        pre[i] = d;
        i = i + 1;
    }
    // Spec: if any arg is ±Infinity, result is +Infinity (even with NaN
    // elsewhere). Then NaN propagates if any arg is NaN. Otherwise compute.
    let any_inf: int = 0;
    let any_nan: int = 0;
    let j: u32 = 0;
    while j < argc {
        let d = pre[j];
        let isinfv: int = 0; let isnanv: int = 0;
        raw { isinfv = isinf(d) ? 1 : 0; isnanv = isnan(d) ? 1 : 0; }
        if isinfv != 0 { any_inf = 1; }
        if isnanv != 0 { any_nan = 1; }
        j = j + 1;
    }
    if any_inf != 0 {
        let inf: f64 = 0.0; raw { inf = INFINITY; }
        dealloc(pre); return zjs_double(inf);
    }
    if any_nan != 0 {
        let nan: f64 = 0.0; raw { nan = NAN; }
        dealloc(pre); return zjs_double(nan);
    }
    if argc == 1 {
        let r: f64 = 0.0; raw { r = fabs(pre[0]); }
        dealloc(pre); return zjs_double(r);
    }
    if argc == 2 {
        let r: f64 = 0.0; raw { r = hypot(pre[0], pre[1]); }
        dealloc(pre); return zjs_double(r);
    }
    let sum: f64 = 0.0;
    let k: u32 = 0;
    while k < argc {
        let d = pre[k];
        sum = sum + d * d;
        k = k + 1;
    }
    let r: f64 = 0.0; raw { r = sqrt(sum); }
    dealloc(pre);
    return zjs_double(r);
}
fn host_math_fround(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    let r: f64 = 0.0;
    raw { float f = (float)d; r = (double)f; }
    return zjs_double(r);
}
fn host_math_clz32(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    let v: u32 = 0;
    raw {
        if (isnan(d) || isinf(d)) v = 0;
        else v = (uint32_t)((int64_t)d & 0xFFFFFFFFLL);
    }
    if v == 0 { return zjs_int32(32); }
    let n: i32 = 0;
    raw { n = (int32_t)__builtin_clz(v); }
    return zjs_int32(n);
}
fn host_math_imul(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let a = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    let b = if argc >= 2 { zjs_to_double(args[1]) } else { 0.0 };
    let r: i32 = 0;
    raw {
        int32_t ai = (int32_t)(int64_t)a;
        int32_t bi = (int32_t)(int64_t)b;
        r = (int32_t)((uint32_t)ai * (uint32_t)bi);
    }
    return zjs_int32(r);
}
fn host_math_random(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // [0,1) — coarse: rand() / (RAND_MAX + 1.0). Engine-quality
    // PRNG is a separate concern.
    let r: f64 = 0.0;
    raw { r = (double)rand() / ((double)RAND_MAX + 1.0); }
    return zjs_double(r);
}

// =====================================================================
// Phase 3.4 — for-in / for-of iteration prepare.
//
// `kind` 0 = for-in (own enumerable string keys of an object); 1 = for-of
// (element values; strings yield each char as a 1-char string). Non-
// iterables yield an empty array. Used by Op::IterPrepare.
// =====================================================================

fn iter_prepare(ctx: ZjsContext*, src: ZjsValue, kind: u32) -> ZjsValue {
    if kind == 0 {
        // for-in: enumerate own + inherited string keys, in insertion
        // order at each prototype level, skipping names already seen
        // at a more-specific level (own shadows inherited) and skipping
        // DELETED slots.
        //
        // We stop at ctx.object_proto so the global Object.prototype's
        // built-in methods (toString/hasOwnProperty) don't appear in
        // for-in output — those are non-enumerable per spec, and we
        // don't track enumerable flags yet. Plain objects' own props
        // are surfaced normally because their cls chain stops above
        // object_proto.
        if zjs_is_array(src) != 0 {
            // Arrays: enumerate the present index keys as strings
            // "0", "1", ... (skips holes per spec — for-in iterates
            // own enumerable string keys, and a hole is not "own").
            let a = zjs_as_array(src);
            let arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, arr_v);
            defer ctx_pop_temp_root(ctx);
            let arr = zjs_as_array(arr_v);
            let i: u32 = 0;
            while i < a.length {
                if zjs_is_deleted(a.elements[i]) == 0 {
                    let buf: char[16];
                    let key_len: int = 0;
                    raw { key_len = snprintf(&buf[0], 16, "%u", (unsigned)i); }
                    let kp: char* = NULL;
                    raw { kp = &buf[0]; }
                    array_set(arr, arr.length, ctx_intern_string(ctx, kp, (u32)key_len));
                }
                i = i + 1;
            }
            return arr_v;
        }
        if zjs_is_object(src) != 0 {
            let arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, arr_v);
            defer ctx_pop_temp_root(ctx);
            // Track all own names seen across the proto walk — used to
            // shadow ancestor entries even when the closer level's
            // entry was non-enumerable (spec). Separate from `arr`
            // which only collects the emitted enumerable keys.
            let shadowed_arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, shadowed_arr_v);
            defer ctx_pop_temp_root(ctx);
            let shadowed_v = zjs_as_array(shadowed_arr_v);
            let arr = zjs_as_array(arr_v);
            let cur: ZjsObject* = zjs_as_object(src);
            while cur != NULL && cur != ctx.object_proto {
                // Collect this level's own names in insertion order
                // (= slot index order). Then append to the result,
                // skipping shadowed names.
                let prop_count = cur.cls.prop_count;
                let scratch: ZjsString*[64];
                let scratch_del: bool[64];
                let limit: u32 = if prop_count > 64 { 64 } else { prop_count };
                let init_i: u32 = 0;
                while init_i < limit {
                    scratch[init_i] = NULL;
                    scratch_del[init_i] = false;
                    init_i = init_i + 1;
                }
                let cls = cur.cls;
                while cls != NULL && cls.parent != NULL {
                    let slot = cls.transition_slot;
                    if slot < limit {
                        // for-in yields only enumerable own keys per
                        // spec; non-enumerable slots are silently
                        // skipped (the `scratch_del` flag handles
                        // both holes and non-enumerable as "absent").
                        let a = object_get_attrs(cur, slot);
                        let enumerable = (a & PROP_ENUMERABLE) != 0;
                        scratch[slot] = cls.transition_name;
                        scratch_del[slot] =
                            zjs_is_deleted(cur.slots[slot]) != 0
                            || !enumerable;
                    }
                    cls = cls.parent;
                }
                let i: u32 = 0;
                while i < limit {
                    let nm = scratch[i];
                    if nm != NULL {
                        // Skip our internal hidden keys (`__zjs_*`) —
                        // wrapper primitives, env chain, toString tag.
                        let is_internal: bool = false;
                        if nm.length >= 6 {
                            let nd = nm.data;
                            raw { is_internal = (memcmp(nd, "__zjs_", 6) == 0) ? true : false; }
                        }
                        if !is_internal {
                            // Shadowed by an earlier (more-specific)
                            // level? Important: even an own
                            // non-enumerable own prop shadows the
                            // ancestor's enumerable one, so we track
                            // shadowing via `shadowed_v`, separate
                            // from the emit list.
                            let seen: bool = false;
                            let j: u32 = 0;
                            while j < shadowed_v.length {
                                if zjs_as_string(shadowed_v.elements[j]) == nm {
                                    seen = true; j = shadowed_v.length;
                                } else { j = j + 1; }
                            }
                            if !seen {
                                array_set(shadowed_v, shadowed_v.length, zjs_cell_from_ptr((void*)nm));
                                if !scratch_del[i] {
                                    array_set(arr, arr.length, zjs_cell_from_ptr((void*)nm));
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
                cur = cur.proto;
            }
            return arr_v;
        }
        return ctx_new_array(ctx, 0);
    }

    // for-of on null/undefined throws TypeError per ECMA-262
    // §14.7.5.5 (GetIterator → RequireObjectCoercible).
    if zjs_is_null(src) != 0 || zjs_is_undefined(src) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"for-of on null or undefined", 27);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return ctx_new_array(ctx, 0);
    }
    // for-of: element values. Spec: %ArrayIteratorPrototype%.next does
    // Get(O, ToString(k)) on each step — holes surface as undefined to
    // the loop, and **mutations during iteration are observed** (pops
    // shorten the run, pushes extend it). Return the live array; the
    // for-of bytecode re-reads ArrayLength on every iteration to pick
    // up length changes.
    if zjs_is_array(src) != 0 {
        return src;
    }
    if zjs_is_string(src) != 0 {
        // Split into 1-char strings. Cheap fallback — proper iterator
        // protocol arrives later.
        let s = zjs_as_string(src);
        let arr_v = ctx_new_array(ctx, s.length);
        ctx_push_temp_root(ctx, arr_v);
        let arr = zjs_as_array(arr_v);
        let sdata = s.data;
        let i: u32 = 0;
        while i < s.length {
            let buf = alloc_n<char>((usize)2);
            buf[0] = sdata[i];
            buf[1] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, 1);
            arr.elements[i] = piece;
            i = i + 1;
        }
        arr.length = s.length;
        ctx_pop_temp_root(ctx);
        return arr_v;
    }
    // ECMA-262 GetIterator: pull the iterator via [@@iterator] (we
    // stand in for Symbol.iterator with the string key "@@iterator"
    // until real Symbols ship). Generators have it on their proto;
    // user code can install it on plain objects to make them iterable.
    let iter_key = ctx_intern_atom(ctx, (char*)"@@iterator", 10);
    let iter_key_v = zjs_cell_from_ptr((void*)iter_key);
    let getter = property_get(ctx, src, iter_key_v);
    if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
    let getter_callable: bool =
        zjs_is_function(getter) != 0
        || zjs_is_closure(getter) != 0
        || zjs_is_host_function(getter) != 0;
    if getter_callable {
        let nullp: ZjsValue* = NULL;
        let iter: ZjsValue = zjs_undefined();
        raw { iter = zjs_call_value_with_this(ctx, getter, src, nullp, 0); }
        if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        // Drive iter.next() until done. Pre-collect into an array — we
        // don't have a lazy for-of yet.
        let next_atom = ctx_intern_atom(ctx, (char*)"next", 4);
        let value_atom = ctx_intern_atom(ctx, (char*)"value", 5);
        let done_atom  = ctx_intern_atom(ctx, (char*)"done", 4);
        let coll = ctx_new_array(ctx, 0);
        ctx_push_temp_root(ctx, coll);
        let coll_arr = zjs_as_array(coll);
        let safety: u32 = 0;
        while safety < 100000000 {
            let next_fn = property_get(ctx, iter, zjs_cell_from_ptr((void*)next_atom));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            let result_v: ZjsValue = zjs_undefined();
            raw { result_v = zjs_call_value_with_this(ctx, next_fn, iter, nullp, 0); }
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            let d_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)done_atom));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            let done: bool = false;
            if zjs_is_bool(d_v) != 0 { done = zjs_as_bool(d_v) != 0; }
            if done { break; }
            let v_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)value_atom));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            array_set(coll_arr, coll_arr.length, v_v);
            safety = safety + 1;
        }
        ctx_pop_temp_root(ctx);
        return coll;
    }
    // Sloppy fallback for an iterable-shaped plain object without
    // @@iterator: a `length` property + numeric keys.
    if zjs_is_object(src) != 0 {
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        let lv = property_get(ctx, src, zjs_cell_from_ptr((void*)len_atom));
        if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        if zjs_is_undefined(lv) == 0 {
            return src;   // walk by index (array-like)
        }
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"for-of on non-iterable value", 28);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return ctx_new_array(ctx, 0);
}

// =====================================================================
// Live iterator helpers (2026-05-16). Backing for array destructuring
// and (future) lazy for-of. iter_prepare above eagerly materializes;
// these three step through one .next() at a time, observe iter.return()
// when needed, and propagate abrupt completions.
// =====================================================================

struct IterStep {
    value: ZjsValue;
    done:  bool;
}

// In JS, "Object" means "anything that isn't a primitive". For the
// iterator protocol's GetIterator / IteratorStep checks the engine
// needs to be precise: arrays, functions, closures, host functions,
// arguments, generators all qualify; numbers / booleans / strings /
// null / undefined / symbols do not.
fn value_is_js_object(v: ZjsValue) -> bool {
    if zjs_is_undefined(v) != 0 { return false; }
    if zjs_is_null(v)      != 0 { return false; }
    if zjs_is_bool(v)      != 0 { return false; }
    if zjs_is_int32(v)     != 0 { return false; }
    if zjs_is_double(v)    != 0 { return false; }
    if zjs_is_string(v)    != 0 { return false; }
    return true;
}

// Equivalent of spec's GetIterator(src, sync). Returns the iterator
// object — calling src[@@iterator]() with src as `this`. On error
// (non-callable @@iterator, throw from the call) sets
// ctx.pending_throw_active and returns undefined. Arrays carry an
// implicit iterator backed by .length + index walk; we materialize
// that into a generator-shaped object lazily here when src has no
// own/inherited @@iterator (matches our string stand-in for
// Symbol.iterator).
fn iter_get(ctx: ZjsContext*, src: ZjsValue) -> ZjsValue {
    // Coerce null/undefined explicitly — every caller already runs
    // RequireObjectCoercible, so a direct TypeError here would mask
    // the more specific destructure_pattern message. Treat as empty.
    if zjs_is_undefined(src) != 0 || zjs_is_null(src) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"value is not iterable", 21);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let iter_key = ctx_intern_atom(ctx, (char*)"@@iterator", 10);
    let getter = property_get(ctx, src, zjs_cell_from_ptr((void*)iter_key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let getter_callable: bool =
        zjs_is_function(getter) != 0
        || zjs_is_closure(getter) != 0
        || zjs_is_host_function(getter) != 0;
    if getter_callable {
        // Fast path: pristine Array / String iterator. The @@iterator
        // lookup resolved to our cached host fn AND src is the right
        // shape — skip the wrapper-object dance and just hand back a
        // TAG_ARRAY_ITER, which iter_step indexes directly.
        if getter.bits == ctx.array_iter_host_fn.bits
           && (zjs_is_array(src) != 0 || zjs_is_string(src) != 0) {
            let ai = zjs_array_iter_new(src);
            ctx_register_cell(ctx, (void*)ai);
            return zjs_cell_from_ptr((void*)ai);
        }
        let nullp: ZjsValue* = NULL;
        let iter: ZjsValue = zjs_undefined();
        raw { iter = zjs_call_value_with_this(ctx, getter, src, nullp, 0); }
        if ctx.pending_throw_active { return zjs_undefined(); }
        // Spec GetIterator step "If Type(iterator) is not Object, throw
        // a TypeError exception." Without this check we'd hand a
        // primitive back to iter_step, which would silently no-op the
        // next() call and loop forever. Surfaces as TypeError so the
        // outer combinator can reject its promise normally.
        if !value_is_js_object(iter) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"iterator result is not an object", 32);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        return iter;
    }
    // No callable @@iterator — including the case where user code
    // explicitly deleted it (`delete Array.prototype[Symbol.iterator]`).
    // Per spec: TypeError, full stop. Earlier impls fell back to a
    // synthetic wrapper here; that path is dead now that Array.prototype
    // and String.prototype carry @@iterator.
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"value is not iterable", 21);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return zjs_undefined();
}

// Spec IteratorStep: calls iter.next(); returns {value, done}. On
// abrupt completion sets ctx.pending_throw_active and returns
// {undefined, true} (treat as done so callers stop).
fn iter_step(ctx: ZjsContext*, iter: ZjsValue) -> IterStep {
    // Fast path for the pristine-array iterator. Index walk, no
    // property_get, no host call. Recovers the ~3x array_iterate
    // regression introduced by switching for-of to the live protocol.
    if zjs_is_array_iter(iter) != 0 {
        let ai = zjs_as_array_iter(iter);
        if ai.done { return IterStep{ value: zjs_undefined(), done: true }; }
        if zjs_is_array(ai.src) != 0 {
            let arr = zjs_as_array(ai.src);
            if ai.index >= arr.length {
                ai.done = true;
                return IterStep{ value: zjs_undefined(), done: true };
            }
            // Expando bag present → an indexed accessor may be defined
            // for this slot (e.g. defineProperty on "0" with a getter).
            // Route through property_get so the getter fires; otherwise
            // the spec-required side effects on iteration are silently
            // skipped. Plain dense arrays (no props) keep the fast path.
            if arr.props != NULL {
                let idx_key = zjs_int32((i32)ai.index);
                let v_slow = property_get(ctx, ai.src, idx_key);
                if ctx.pending_throw_active {
                    return IterStep{ value: zjs_undefined(), done: true };
                }
                ai.index = ai.index + 1;
                return IterStep{ value: v_slow, done: false };
            }
            let v = arr.elements[ai.index];
            if zjs_is_deleted(v) != 0 { v = zjs_undefined(); }
            ai.index = ai.index + 1;
            return IterStep{ value: v, done: false };
        }
        if zjs_is_string(ai.src) != 0 {
            let s = zjs_as_string(ai.src);
            if ai.index >= s.length {
                ai.done = true;
                return IterStep{ value: zjs_undefined(), done: true };
            }
            let buf = alloc_n<char>((usize)2);
            buf[0] = s.data[ai.index];
            buf[1] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, 1);
            ai.index = ai.index + 1;
            return IterStep{ value: piece, done: false };
        }
        // Shouldn't happen, but fall through to done.
        ai.done = true;
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let nullp: ZjsValue* = NULL;
    let next_atom = ctx_intern_atom(ctx, (char*)"next", 4);
    let next_fn = property_get(ctx, iter, zjs_cell_from_ptr((void*)next_atom));
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    // Spec IteratorNext: next must be callable. Without this our
    // zjs_call_value_with_this silently returns undefined when handed
    // a non-callable, and the loop spins forever interpreting `{ done:
    // undefined }` as "keep going".
    let next_callable: bool =
        zjs_is_function(next_fn) != 0
        || zjs_is_closure(next_fn) != 0
        || zjs_is_host_function(next_fn) != 0;
    if !next_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"iterator.next is not callable", 29);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let result_v: ZjsValue = zjs_undefined();
    raw { result_v = zjs_call_value_with_this(ctx, next_fn, iter, nullp, 0); }
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    // Spec IteratorNext: result must be an Object. Otherwise the
    // protocol can't trust .done / .value and we'd loop or read holes.
    if !value_is_js_object(result_v) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"iterator result is not an object", 32);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let done_atom  = ctx_intern_atom(ctx, (char*)"done", 4);
    let value_atom = ctx_intern_atom(ctx, (char*)"value", 5);
    let d_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)done_atom));
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    let done: bool = false;
    if zjs_is_bool(d_v) != 0 { done = zjs_as_bool(d_v) != 0; }
    else if zjs_is_undefined(d_v) == 0 { done = true; }   // spec: ToBoolean
    if done {
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let v_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)value_atom));
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    return IterStep{ value: v_v, done: false };
}

// Spec IteratorClose with normal completion: calls iter.return() if
// the iterator has one. Spec also has a "with abrupt" variant that
// rethrows the original completion if return() throws — for now we
// don't distinguish; a throwing return() surfaces directly.
fn iter_close(ctx: ZjsContext*, iter: ZjsValue) -> void {
    if zjs_is_undefined(iter) != 0 || zjs_is_null(iter) != 0 { return; }
    // Fast-path iterators have no .return() — nothing to do.
    if zjs_is_array_iter(iter) != 0 { return; }
    let nullp: ZjsValue* = NULL;
    let ret_atom = ctx_intern_atom(ctx, (char*)"return", 6);
    let ret_fn = property_get(ctx, iter, zjs_cell_from_ptr((void*)ret_atom));
    if ctx.pending_throw_active { return; }
    if zjs_is_undefined(ret_fn) != 0 || zjs_is_null(ret_fn) != 0 { return; }
    let callable: bool =
        zjs_is_function(ret_fn) != 0
        || zjs_is_closure(ret_fn) != 0
        || zjs_is_host_function(ret_fn) != 0;
    if !callable { return; }
    let _result: ZjsValue = zjs_undefined();
    raw { _result = zjs_call_value_with_this(ctx, ret_fn, iter, nullp, 0); }
    // Pending throw (if any) is left active so the caller propagates.
}

// `this[@@iterator]()` for arrays and strings — returns the synthetic
// `{ _src, _i, next }` wrapper. Installed on Array.prototype /
// String.prototype below so user code (and our own iter_get) sees
// arrays as natively iterable.
fn host_array_at_iterator(ctx: ZjsContext*) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    let wrapper = ctx_new_object(ctx);
    let w = zjs_as_object(wrapper);
    let i_atom = ctx_intern_atom(ctx, (char*)"_i", 2);
    let src_atom = ctx_intern_atom(ctx, (char*)"_src", 4);
    object_set(ctx, w, i_atom, zjs_int32(0));
    object_set(ctx, w, src_atom, recv);
    let next_fn = ctx_make_host_function(ctx, (char*)"next", (void*)host_array_iter_next);
    let next_atom = ctx_intern_atom(ctx, (char*)"next", 4);
    object_set(ctx, w, next_atom, next_fn);
    // %ArrayIteratorPrototype% has @@iterator returning self, so user
    // code can do `for (const v of arr[Symbol.iterator]())`. Install
    // it on the wrapper itself for now — a real prototype chain is
    // overkill until iterators grow more shape.
    let self_iter_fn = ctx_make_host_function(ctx, (char*)"[Symbol.iterator]", (void*)host_self_iter);
    object_set(ctx, w, ctx_intern_atom(ctx, (char*)"@@iterator", 10), self_iter_fn);
    return wrapper;
}

// `function() { return this; }` — used as @@iterator on iterators
// (per spec, iterators are themselves iterable, returning themselves).
fn host_self_iter(ctx: ZjsContext*) -> ZjsValue {
    return zjs_get_host_this(ctx);
}

// Host-side next() for the synthetic array/string iterator built by
// iter_get. `this` carries _src + _i; bump _i, return { value, done }.
fn host_array_iter_next(ctx: ZjsContext*) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    if zjs_is_object(recv) == 0 {
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let i_atom = ctx_intern_atom(ctx, (char*)"_i", 2);
    let src_atom = ctx_intern_atom(ctx, (char*)"_src", 4);
    let i_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)i_atom));
    let src = property_get(ctx, recv, zjs_cell_from_ptr((void*)src_atom));
    let i: u32 = 0;
    if zjs_is_int32(i_v) != 0 { i = (u32)zjs_as_int32(i_v); }
    if zjs_is_array(src) != 0 {
        let a = zjs_as_array(src);
        if i >= a.length { return build_iter_result_helper(ctx, zjs_undefined(), true); }
        let v = a.elements[i];
        if zjs_is_deleted(v) != 0 { v = zjs_undefined(); }
        object_set(ctx, zjs_as_object(recv), i_atom, zjs_int32((i32)(i + 1)));
        return build_iter_result_helper(ctx, v, false);
    }
    if zjs_is_string(src) != 0 {
        let s = zjs_as_string(src);
        if i >= s.length { return build_iter_result_helper(ctx, zjs_undefined(), true); }
        let buf = alloc_n<char>((usize)2);
        buf[0] = s.data[i];
        buf[1] = (char)0;
        let piece = ctx_intern_string_take(ctx, buf, 1);
        object_set(ctx, zjs_as_object(recv), i_atom, zjs_int32((i32)(i + 1)));
        return build_iter_result_helper(ctx, piece, false);
    }
    return build_iter_result_helper(ctx, zjs_undefined(), true);
}

// Construct an `{ value, done }` result object — separate from the
// interpreter's local helper so this file can build them too.
fn build_iter_result_helper(ctx: ZjsContext*, value: ZjsValue, done: bool) -> ZjsValue {
    let r = ctx_new_object(ctx);
    let ro = zjs_as_object(r);
    object_set(ctx, ro, ctx_intern_atom(ctx, (char*)"value", 5), value);
    object_set(ctx, ro, ctx_intern_atom(ctx, (char*)"done",  4), zjs_bool(done));
    return r;
}

// =====================================================================
// Phase 3.5 — Object / Array / String / JSON built-ins.
// =====================================================================

// Implicit receiver accessor for host functions. zjs_undefined() if the
// host was called via plain Invoke; the method-call receiver if via
// MethodInvoke.
fn zjs_get_host_this(ctx: ZjsContext*) -> ZjsValue {
    return ctx.host_this;
}

// Object() / new Object() — when called as a constructor, returns the
// (potentially boxed) primitive or a fresh object.
fn host_object_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §20.1.1.1: Object(value) returns a wrapped version of
    // primitives, and the value itself if it's already an object.
    // For `new Object()` with no args, returns a fresh {}.
    if argc == 0 {
        if zjs_is_object(ctx.host_this) != 0 { return ctx.host_this; }
        return ctx_new_object(ctx);
    }
    let v = args[0];
    if zjs_is_undefined(v) != 0 || zjs_is_null(v) != 0 {
        if zjs_is_object(ctx.host_this) != 0 { return ctx.host_this; }
        return ctx_new_object(ctx);
    }
    if zjs_is_object(v) != 0 || zjs_is_array(v) != 0
       || zjs_is_function(v) != 0 || zjs_is_closure(v) != 0
       || zjs_is_host_function(v) != 0 || zjs_is_promise(v) != 0 {
        return v;
    }
    // Primitive — wrap via ToObject (yields Boolean/Number/String wrapper
    // with the appropriate prototype chain).
    let wrapped = ctx_to_object(ctx, v);
    if ctx.pending_throw_active { return zjs_undefined(); }
    return wrapped;
}

// Object.create(proto) — fresh empty object whose [[Prototype]] is proto.
// Phase 3.6.
// Forward — defined below.
raw {
    extern ZjsValue host_object_define_properties(ZjsContext* ctx, ZjsValue* args, uint32_t argc);
}

fn host_object_create(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §20.1.2.2 — Object.create(O, Properties): O must be an
    // Object or null, else throw TypeError. argc==0 is treated as O =
    // undefined per spec semantics.
    let proto_v = if argc > 0 { args[0] } else { zjs_undefined() };
    let proto_ok: bool =
           zjs_is_object(proto_v) != 0
        || zjs_is_null(proto_v) != 0;
    if !proto_ok {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object prototype may only be an Object or null", 47);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    if zjs_is_object(proto_v) != 0 {
        obj.proto = zjs_as_object(proto_v);
    }
    // null proto stays as top-of-chain (obj.proto = NULL).
    // Phase 3.9a: second arg is a descriptor map. Accept any object-y
    // value (plain object, array with expandos, host/user function
    // with .props) — host_object_define_properties knows how to walk
    // each shape.
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let p1 = args[1];
        // ECMA-262 §20.1.2.3.1: Properties argument must be coercible
        // to an Object. null and other primitives throw. Strings are
        // wrapped (they coerce to a String object whose enumerable
        // chars become descriptor names → which then fail
        // ToPropertyDescriptor for the single-char descriptor values).
        // We model that as "throw TypeError" for both null and
        // primitives — the inner test would throw anyway.
        // ECMA-262 ToObject(props) accepts any object-coercible value.
        // For zjs that means any cell value EXCEPT a primitive string
        // (a string here would coerce to String wrapper but its own
        // enumerable keys are character indices, none of which are
        // valid descriptors — net effect = no descriptors applied, no
        // error). null/undefined are the actual reject case.
        let p1_objlike: bool =
               zjs_is_object(p1) != 0
            || zjs_is_array(p1) != 0
            || zjs_is_function(p1) != 0
            || zjs_is_host_function(p1) != 0
            || zjs_is_regexp(p1) != 0
            || zjs_is_date(p1) != 0
            || zjs_is_map(p1) != 0
            || zjs_is_set(p1) != 0
            || zjs_is_symbol(p1) != 0;
        if !p1_objlike {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Object.create properties must be an Object", 42);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        if p1_objlike {
            ctx_push_temp_root(ctx, obj_v);
            let dp_args: ZjsValue[2];
            dp_args[0] = obj_v;
            dp_args[1] = p1;
            let p: ZjsValue* = NULL;
            raw { p = &dp_args[0]; }
            raw { (void)host_object_define_properties(ctx, p, 2); }
            ctx_pop_temp_root(ctx);
        }
    }
    return obj_v;
}

// Object.defineProperty(obj, key, descriptor) — Phase 3.9a.
//
// MVP: handles DATA descriptors (the `value` field). The
// writable/enumerable/configurable attributes are accepted but not
// enforced — every property is effectively configurable. Accessor
// descriptors (get/set) are recognized as "absent value" and the
// property is created with value = undefined; calling the
// accessor isn't wired up yet (Phase 3.9b).
// Resolve the receiver to the ZjsObject* where named properties go.
// Plain objects ARE the receiver. Arrays / functions / host fns /
// regex carry their named props in a sub-object (lazy-created via
// the .props field). Returns NULL if the receiver isn't supported
// (e.g. primitives — defineProperty silently no-ops there).
fn resolve_define_receiver(ctx: ZjsContext*, obj_v: ZjsValue) -> ZjsObject* {
    if zjs_is_object(obj_v) != 0 { return zjs_as_object(obj_v); }
    if zjs_is_array(obj_v) != 0 {
        let arr = zjs_as_array(obj_v);
        if arr.props == NULL {
            let pv = ctx_new_object(ctx);
            arr.props = zjs_as_object(pv);
        }
        return arr.props;
    }
    if zjs_is_function(obj_v) != 0 {
        let fp = zjs_cell_as_ptr(obj_v);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if f.props == NULL {
            let pv = ctx_new_object(ctx);
            f.props = zjs_as_object(pv);
        }
        return f.props;
    }
    if zjs_is_host_function(obj_v) != 0 {
        let hf = zjs_as_host_function(obj_v);
        if hf.props == NULL {
            let pv = ctx_new_object(ctx);
            hf.props = zjs_as_object(pv);
        }
        return hf.props;
    }
    if zjs_is_regexp(obj_v) != 0 {
        let r = zjs_as_regexp(obj_v);
        if r.props == NULL {
            let pv = ctx_new_object(ctx);
            r.props = zjs_as_object(pv);
        }
        return r.props;
    }
    if zjs_is_date(obj_v) != 0 {
        let d = zjs_as_date(obj_v);
        if d.props == NULL {
            let pv = ctx_new_object(ctx);
            d.props = zjs_as_object(pv);
        }
        return d.props;
    }
    if zjs_is_map(obj_v) != 0 {
        let m = zjs_as_map(obj_v);
        if m.props == NULL {
            let pv = ctx_new_object(ctx);
            m.props = zjs_as_object(pv);
        }
        return m.props;
    }
    if zjs_is_set(obj_v) != 0 {
        let s = zjs_as_set(obj_v);
        if s.props == NULL {
            let pv = ctx_new_object(ctx);
            s.props = zjs_as_object(pv);
        }
        return s.props;
    }
    if zjs_is_symbol(obj_v) != 0 {
        let sym = zjs_as_symbol(obj_v);
        if sym.props == NULL {
            let pv = ctx_new_object(ctx);
            sym.props = zjs_as_object(pv);
        }
        return sym.props;
    }
    return NULL;
}

// ECMA-262 HasProperty(desc, name): walks the descriptor's proto
// chain for plain objects, plus checks the expando bag for
// array / function / host-fn / regex descriptors. Used by
// defineProperty's partial-merge logic — ToPropertyDescriptor
// queries HasProperty rather than [[GetOwnProperty]], so inherited
// fields participate.
fn descriptor_has_own(desc: ZjsValue, name: ZjsString*) -> bool {
    if zjs_is_object(desc) != 0 {
        let cur = zjs_as_object(desc);
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 {
                return true;
            }
            cur = cur.proto;
        }
        return false;
    }
    let bag: ZjsObject* = NULL;
    if zjs_is_array(desc) != 0 {
        let a = zjs_as_array(desc);
        bag = a.props;
    } else if zjs_is_function(desc) != 0 {
        let fp = zjs_cell_as_ptr(desc);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        bag = f.props;
    } else if zjs_is_host_function(desc) != 0 {
        bag = zjs_as_host_function(desc).props;
    } else if zjs_is_regexp(desc) != 0 {
        bag = zjs_as_regexp(desc).props;
    } else {
        return false;
    }
    if bag == NULL { return false; }
    let cur = bag;
    while cur != NULL {
        let slot = class_find_slot(cur.cls, name);
        if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 {
            return true;
        }
        cur = cur.proto;
    }
    return false;
}

fn host_object_define_property(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 3 { return zjs_undefined(); }
    let obj_v = args[0];
    let o = resolve_define_receiver(ctx, obj_v);
    if o == NULL { return obj_v; }

    let key_v = args[1];
    if zjs_is_string(key_v) == 0 { key_v = zjs_to_string(ctx, key_v); }
    let key_str = zjs_as_string(key_v);
    let key_atom = ctx_intern_atom(ctx, key_str.data, key_str.length);

    // ECMA-262 §10.4.2.4 ArraySetLength: if obj is an Array and key
    // names a numeric index, bump array.length to max(length, idx+1).
    // Tests rely on this so a for-of over an array that only had
    // defineProperty install a key visits it.
    if zjs_is_array(obj_v) != 0 {
        let idx = zjs_to_array_index(key_v);
        if idx >= 0 {
            let arr = zjs_as_array(obj_v);
            let need = (u32)idx + 1;
            if need > arr.length { arr.length = need; }
        }
    }

    // Descriptor may be a plain object OR an array (whose expando bag
    // holds the value/get/set keys) OR a host/user function with
    // .props. Use property_get to read named slots through whichever
    // shape is present.
    let desc_v = args[2];
    let desc_objlike: bool =
           zjs_is_object(desc_v) != 0
        || zjs_is_array(desc_v) != 0
        || zjs_is_function(desc_v) != 0
        || zjs_is_host_function(desc_v) != 0
        || zjs_is_regexp(desc_v) != 0;
    if !desc_objlike { return obj_v; }

    let value_key  = ctx_intern_atom(ctx, (char*)"value", 5);
    let get_key    = ctx_intern_atom(ctx, (char*)"get",   3);
    let set_key    = ctx_intern_atom(ctx, (char*)"set",   3);

    let value_key_v = zjs_cell_from_ptr((void*)value_key);
    let get_key_v   = zjs_cell_from_ptr((void*)get_key);
    let set_key_v   = zjs_cell_from_ptr((void*)set_key);

    let value_lookup = property_get(ctx, desc_v, value_key_v);
    let get_lookup   = property_get(ctx, desc_v, get_key_v);
    let set_lookup   = property_get(ctx, desc_v, set_key_v);

    // ECMA-262 §6.2.5 ToPropertyDescriptor: a get/set that is present
    // (non-undefined) but not callable, or a descriptor that mixes a
    // data field (value) with an accessor field (get/set), is a
    // TypeError. property_get returns undefined for missing properties,
    // so a `get: undefined` (or absent `get`) reads as undefined and is
    // a valid "no getter" — only non-undefined non-callable throws.
    let get_present = zjs_is_undefined(get_lookup) == 0;
    let set_present = zjs_is_undefined(set_lookup) == 0;
    let get_callable = zjs_is_function(get_lookup) != 0 || zjs_is_closure(get_lookup) != 0 || zjs_is_host_function(get_lookup) != 0;
    let set_callable = zjs_is_function(set_lookup) != 0 || zjs_is_closure(set_lookup) != 0 || zjs_is_host_function(set_lookup) != 0;
    if get_present && !get_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Getter must be a function or undefined", 38);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    if set_present && !set_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Setter must be a function or undefined", 38);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let has_value = zjs_is_undefined(value_lookup) == 0;
    let has_get   = get_callable;
    let has_set   = set_callable;
    if has_value && (get_present || set_present) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot both specify accessors and a value or writable attribute", 64);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }

    // Read attribute fields. ECMA-262 §6.2.5 ToPropertyDescriptor:
    // when defineProperty/Properties is given a descriptor, ABSENT
    // attributes default to FALSE — stricter than plain assignment
    // (`o.x = 1`) which uses PROP_DEFAULT (all true). When
    // redefining an existing property we'd merge with the existing
    // descriptor, but MVP defines unconditionally with whatever's
    // present (or false).
    // ECMA-262 §6.2.5.1 ToPropertyDescriptor + 9.1.6.3
    // ValidateAndApplyPropertyDescriptor: when redefining an existing
    // own property, fields absent from the new descriptor inherit
    // from the existing one. Detect "has X" by walking the
    // descriptor's own keys (not via property_get, which can't tell
    // missing from undefined-valued).
    let wri_key = ctx_intern_atom(ctx, (char*)"writable",     8);
    let enu_key = ctx_intern_atom(ctx, (char*)"enumerable",   10);
    let cfg_key = ctx_intern_atom(ctx, (char*)"configurable", 12);
    let value_atom_str = ctx_intern_atom(ctx, (char*)"value", 5);
    let has_value_field = descriptor_has_own(desc_v, value_atom_str);
    let has_wri_field   = descriptor_has_own(desc_v, wri_key);
    let has_enu_field   = descriptor_has_own(desc_v, enu_key);
    let has_cfg_field   = descriptor_has_own(desc_v, cfg_key);
    let wri_lookup = property_get(ctx, desc_v, zjs_cell_from_ptr((void*)wri_key));
    let enu_lookup = property_get(ctx, desc_v, zjs_cell_from_ptr((void*)enu_key));
    let cfg_lookup = property_get(ctx, desc_v, zjs_cell_from_ptr((void*)cfg_key));

    // Compute attrs. Existing slot? Start from its current attrs and
    // override only the bits the new descriptor explicitly specifies.
    // No existing slot → defineProperty defaults (all false) per spec.
    let existing_slot = class_find_slot(o.cls, key_atom);
    let attrs: u8 = 0;
    if existing_slot >= 0 {
        attrs = object_get_attrs(o, (u32)existing_slot);
    }
    if has_wri_field {
        if zjs_to_bool_coerce(wri_lookup) != 0 { attrs = attrs | PROP_WRITABLE; }
        else                                   { attrs = attrs & ~PROP_WRITABLE; }
    }
    if has_enu_field {
        if zjs_to_bool_coerce(enu_lookup) != 0 { attrs = attrs | PROP_ENUMERABLE; }
        else                                   { attrs = attrs & ~PROP_ENUMERABLE; }
    }
    if has_cfg_field {
        if zjs_to_bool_coerce(cfg_lookup) != 0 { attrs = attrs | PROP_CONFIGURABLE; }
        else                                   { attrs = attrs & ~PROP_CONFIGURABLE; }
    }

    if has_get || has_set {
        let g: ZjsValue = if has_get { get_lookup } else { zjs_undefined() };
        let s: ZjsValue = if has_set { set_lookup } else { zjs_undefined() };
        let acc = zjs_accessor_new(g, s);
        ctx_register_cell(ctx, (void*)acc);
        let av = zjs_cell_from_ptr((void*)acc);
        let acc_attrs = attrs & (PROP_ENUMERABLE | PROP_CONFIGURABLE);
        object_define_property_slot(ctx, o, key_atom, av, acc_attrs);
        return obj_v;
    }

    // Data descriptor — extract `value`. If the descriptor doesn't
    // carry a `value` field AND the slot already exists, keep the
    // existing value (only attrs change).
    let value: ZjsValue = zjs_undefined();
    if has_value_field {
        value = value_lookup;
    } else if existing_slot >= 0 {
        value = o.slots[(u32)existing_slot];
    }
    object_define_property_slot(ctx, o, key_atom, value, attrs);
    return obj_v;
}

// Object.defineProperties(obj, props) — Phase 3.9a.
// Walks props's own keys (via the hidden-class chain) and calls
// defineProperty for each.
fn host_object_define_properties(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return if argc > 0 { args[0] } else { zjs_undefined() }; }
    let obj_v = args[0];
    if zjs_is_object(obj_v) == 0 { return obj_v; }
    let props_v = args[1];
    // ECMA-262 §19.1.2.3 step 2: props is ToObject'd. Plain objects
    // use their own hidden class. Arrays / functions / host fns /
    // regex carry their named-property expando in a sub-object —
    // walk THAT for the descriptors, but call property_get on the
    // ORIGINAL receiver so accessor `this` is the function / array
    // / regex itself.
    let cls_root: ZjsHiddenClass* = NULL;
    let cls_owner_v: ZjsValue = zjs_undefined();
    if zjs_is_array(props_v) != 0 {
        let pa = zjs_as_array(props_v);
        if pa.props == NULL { return obj_v; }
        cls_root = pa.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_function(props_v) != 0 {
        let fp = zjs_cell_as_ptr(props_v);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if f.props == NULL { return obj_v; }
        cls_root = f.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_host_function(props_v) != 0 {
        let hf = zjs_as_host_function(props_v);
        if hf.props == NULL { return obj_v; }
        cls_root = hf.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_regexp(props_v) != 0 {
        let r = zjs_as_regexp(props_v);
        if r.props == NULL { return obj_v; }
        cls_root = r.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_date(props_v) != 0 {
        let dd = zjs_as_date(props_v);
        if dd.props == NULL { return obj_v; }
        cls_root = dd.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_map(props_v) != 0 {
        let mm = zjs_as_map(props_v);
        if mm.props == NULL { return obj_v; }
        cls_root = mm.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_set(props_v) != 0 {
        let ss = zjs_as_set(props_v);
        if ss.props == NULL { return obj_v; }
        cls_root = ss.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_symbol(props_v) != 0 {
        let symv = zjs_as_symbol(props_v);
        if symv.props == NULL { return obj_v; }
        cls_root = symv.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_object(props_v) != 0 {
        cls_root = zjs_as_object(props_v).cls;
        cls_owner_v = props_v;
    } else {
        return obj_v;
    }

    // Walk props's own properties via the hidden-class chain. For each
    // enumerable property, read its value via property_get so accessor
    // getters fire (with `this = props_v`) — required by ECMA-262
    // §20.1.2.3.1 step 5.b.
    let cls = cls_root;
    while cls != NULL && cls.parent != NULL {
        let name = cls.transition_name;
        let slot = cls.transition_slot;
        // Skip our internal hidden keys (`__zjs_*`).
        let is_internal: bool = false;
        if name.length >= 6 {
            let nd = name.data;
            raw { is_internal = (memcmp(nd, "__zjs_", 6) == 0) ? true : false; }
        }
        if !is_internal {
            // Spec: only ENUMERABLE own props of `props` become
            // descriptor entries. The hidden-class walker visits all
            // slots regardless; skip non-enumerable ones here. Critical
            // for `Object.create({}, Math)` — Math has non-enumerable
            // `PI` (a number) which would otherwise trip the
            // "descriptor must be an object" throw.
            let owner_obj: ZjsObject* = NULL;
            if zjs_is_object(cls_owner_v) != 0 {
                owner_obj = zjs_as_object(cls_owner_v);
            } else if zjs_is_array(cls_owner_v) != 0 {
                let oa = zjs_as_array(cls_owner_v);
                if oa.props != NULL { owner_obj = oa.props; }
            } else if zjs_is_function(cls_owner_v) != 0 {
                let fp = zjs_cell_as_ptr(cls_owner_v);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.props != NULL { owner_obj = f.props; }
            } else if zjs_is_host_function(cls_owner_v) != 0 {
                let hf = zjs_as_host_function(cls_owner_v);
                if hf.props != NULL { owner_obj = hf.props; }
            } else if zjs_is_regexp(cls_owner_v) != 0 {
                let r = zjs_as_regexp(cls_owner_v);
                if r.props != NULL { owner_obj = r.props; }
            } else if zjs_is_date(cls_owner_v) != 0 {
                let dd = zjs_as_date(cls_owner_v);
                if dd.props != NULL { owner_obj = dd.props; }
            } else if zjs_is_map(cls_owner_v) != 0 {
                let mm = zjs_as_map(cls_owner_v);
                if mm.props != NULL { owner_obj = mm.props; }
            } else if zjs_is_set(cls_owner_v) != 0 {
                let ss = zjs_as_set(cls_owner_v);
                if ss.props != NULL { owner_obj = ss.props; }
            } else if zjs_is_symbol(cls_owner_v) != 0 {
                let symv = zjs_as_symbol(cls_owner_v);
                if symv.props != NULL { owner_obj = symv.props; }
            }
            let prop_attrs: u8 = if owner_obj != NULL { object_get_attrs(owner_obj, slot) } else { PROP_DEFAULT };
            if (prop_attrs & PROP_ENUMERABLE) == 0 {
                cls = cls.parent;
                continue;
            }
            let key_v = zjs_cell_from_ptr((void*)name);
            // Read through cls_owner so accessor getters fire on the
            // right receiver. For an array-backed props bag this is
            // the array's expando object (a real ZjsObject).
            let desc_value = property_get(ctx, cls_owner_v, key_v);
            // ECMA-262 §19.1.2.3.1 step 5.c: ToPropertyDescriptor on a
            // non-object descriptor throws TypeError. Most commonly this
            // surfaces when the props bag holds an accessor-only entry
            // (set without get) — reading it returns undefined.
            let dv_objlike: bool =
                   zjs_is_object(desc_value) != 0
                || zjs_is_array(desc_value) != 0
                || zjs_is_function(desc_value) != 0
                || zjs_is_host_function(desc_value) != 0
                || zjs_is_regexp(desc_value) != 0;
            if !dv_objlike {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Property descriptor must be an object", 37);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return zjs_undefined();
            }
            let dp_args: ZjsValue[3];
            dp_args[0] = obj_v;
            dp_args[1] = key_v;
            dp_args[2] = desc_value;
            let dp_p: ZjsValue* = NULL;
            raw { dp_p = &dp_args[0]; }
            host_object_define_property(ctx, dp_p, 3);
            // define_property may have thrown a descriptor-validation
            // TypeError — bubble it out so the caller's invocation
            // epilogue picks it up.
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        cls = cls.parent;
    }
    return obj_v;
}

// Object.getOwnPropertyDescriptor(obj, key) — Phase 3.9a.
// Returns a fresh descriptor object. MVP: all properties report as
// data descriptors with all three attribute bits set to true.
fn host_object_get_own_property_descriptor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    let obj_v = args[0];
    let key_v = args[1];
    if zjs_is_string(key_v) == 0 { key_v = zjs_to_string(ctx, key_v); }

    // Array fast path: numeric indices and "length".
    if zjs_is_array(obj_v) != 0 {
        let arr = zjs_as_array(obj_v);
        let key_str_a = zjs_as_string(key_v);
        // "length"?
        if key_str_a.length == 6 {
            let kd = key_str_a.data;
            let is_len: int = 0;
            raw { is_len = (memcmp(kd, "length", 6) == 0) ? 1 : 0; }
            if is_len != 0 {
                let r_v = ctx_new_object(ctx);
                let r = zjs_as_object(r_v);
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"value", 5), zjs_int32((i32)arr.length));
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(1));
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(0));
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(0));
                return r_v;
            }
        }
        let idx = zjs_to_array_index(key_v);
        if idx >= 0 && (u32)idx < arr.length {
            // Spec: getOwnPropertyDescriptor on a hole returns undefined.
            if zjs_is_deleted(arr.elements[(u32)idx]) != 0 {
                return zjs_undefined();
            }
            let r_v = ctx_new_object(ctx);
            let r = zjs_as_object(r_v);
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"value", 5), arr.elements[(u32)idx]);
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(1));
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(1));
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(1));
            return r_v;
        }
        return zjs_undefined();
    }

    // Function / closure / host-fn special "prototype" / "name" /
    // "length" keys first.
    let key_str_pre = zjs_as_string(key_v);
    let is_prototype_k: int = 0;
    let is_name_k: int = 0;
    let is_length_k: int = 0;
    let ksd = key_str_pre.data;
    let ksn = key_str_pre.length;
    raw {
        is_prototype_k = (ksn == 9 && memcmp(ksd, "prototype", 9) == 0) ? 1 : 0;
        is_name_k      = (ksn == 4 && memcmp(ksd, "name",      4) == 0) ? 1 : 0;
        is_length_k    = (ksn == 6 && memcmp(ksd, "length",    6) == 0) ? 1 : 0;
    }
    if is_prototype_k != 0
       && (zjs_is_function(obj_v) != 0 || zjs_is_closure(obj_v) != 0 || zjs_is_host_function(obj_v) != 0) {
        let proto_v = property_get(ctx, obj_v, key_v);
        if zjs_is_undefined(proto_v) != 0 { return zjs_undefined(); }
        let r_v = ctx_new_object(ctx);
        let r = zjs_as_object(r_v);
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"value", 5), proto_v);
        // For class constructors the prototype is non-writable +
        // non-configurable; regular function ctors are writable +
        // configurable. is_class_constructor only exists on Function*,
        // not closures / host fns — treat host fns as regular ctors.
        let is_class: bool = false;
        if zjs_is_function(obj_v) != 0 {
            let fp = zjs_cell_as_ptr(obj_v);
            let ff: Function* = NULL;
            raw { ff = (Function*)fp; }
            is_class = ff.is_class_constructor;
        }
        let writable: int = if is_class { 0 } else { 1 };
        let configurable: int = if is_class { 0 } else { 1 };
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(writable));
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(0));
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(configurable));
        return r_v;
    }

    // Function / closure / host-fn receivers: route to their .props
    // expando (where static methods, F.x = ..., etc. live).
    let o: ZjsObject* = NULL;
    if zjs_is_object(obj_v) != 0 {
        o = zjs_as_object(obj_v);
    } else if zjs_is_function(obj_v) != 0 {
        let fp = zjs_cell_as_ptr(obj_v);
        let ff: Function* = NULL;
        raw { ff = (Function*)fp; }
        if ff.props != NULL { o = ff.props; }
    } else if zjs_is_closure(obj_v) != 0 {
        let cl = zjs_as_closure(obj_v);
        let fp2 = cl.function;
        let ff2: Function* = NULL;
        raw { ff2 = (Function*)fp2; }
        if ff2.props != NULL { o = ff2.props; }
    } else if zjs_is_host_function(obj_v) != 0 {
        let hf = zjs_as_host_function(obj_v);
        if hf.props != NULL { o = hf.props; }
    }
    if o == NULL { return zjs_undefined(); }
    let key_str = zjs_as_string(key_v);
    let key_atom = ctx_intern_atom(ctx, key_str.data, key_str.length);

    let slot = class_find_slot(o.cls, key_atom);
    if slot < 0 { return zjs_undefined(); }
    let raw_v = o.slots[(u32)slot];

    let result_v = ctx_new_object(ctx);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_object(result_v);
    let pattrs = object_get_attrs(o, (u32)slot);
    if zjs_is_accessor(raw_v) != 0 {
        let acc = zjs_as_accessor(raw_v);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"get", 3), acc.get);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"set", 3), acc.set);
    } else {
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"value", 5), raw_v);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"writable", 8),
                   zjs_bool(if (pattrs & PROP_WRITABLE) != 0 { 1 } else { 0 }));
    }
    object_set(ctx, result, ctx_intern_atom(ctx, (char*)"enumerable", 10),
               zjs_bool(if (pattrs & PROP_ENUMERABLE) != 0 { 1 } else { 0 }));
    object_set(ctx, result, ctx_intern_atom(ctx, (char*)"configurable", 12),
               zjs_bool(if (pattrs & PROP_CONFIGURABLE) != 0 { 1 } else { 0 }));
    return result_v;
}

// Object.getPrototypeOf(obj) — Phase 3.6.
// ECMA-262 ToObject for Object.{keys, values, entries, getPrototypeOf,
// getOwnPropertyNames, ...}: null and undefined throw TypeError per ES2015+.
// Returns true if the argument is suitable; false (with a pending throw
// armed) if the caller must bail.
fn require_object_keys_arg(ctx: ZjsContext*, v: ZjsValue) -> bool {
    if zjs_is_null(v) != 0 || zjs_is_undefined(v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return false;
    }
    return true;
}

// Object.is(a, b) — ECMA-262 §7.2.10 SameValue. Like ===, except
// NaN equals NaN, and +0 doesn't equal -0.
fn host_object_is(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let a = if argc >= 1 { args[0] } else { zjs_undefined() };
    let b = if argc >= 2 { args[1] } else { zjs_undefined() };
    // NaN handling first — Object.is(NaN, NaN) is true.
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        let da = zjs_to_double(a);
        let db = zjs_to_double(b);
        let na_nan: int = 0;
        let nb_nan: int = 0;
        raw {
            na_nan = isnan(da) ? 1 : 0;
            nb_nan = isnan(db) ? 1 : 0;
        }
        if na_nan != 0 && nb_nan != 0 { return zjs_bool(1); }
        if na_nan != 0 || nb_nan != 0 { return zjs_bool(0); }
        // ±0 distinction: 1/+0 = +Infinity, 1/-0 = -Infinity.
        if da == 0.0 && db == 0.0 {
            let sa: int = 0;
            let sb: int = 0;
            raw {
                sa = signbit(da) ? 1 : 0;
                sb = signbit(db) ? 1 : 0;
            }
            return zjs_bool(if sa == sb { 1 } else { 0 });
        }
        return zjs_bool(if da == db { 1 } else { 0 });
    }
    return zjs_bool(zjs_strict_eq(a, b));
}

// Object.setPrototypeOf(O, proto) — Phase 3.9.
// Spec: O must be coercible; proto must be Object or null. Sets
// O.[[Prototype]] and returns O. Primitives are returned unchanged
// after the type-validation step (no wrapper materialization needed).
fn host_object_set_prototype_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let obj_v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_undefined(obj_v) != 0 || zjs_is_null(obj_v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object.setPrototypeOf called on null or undefined", 49);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let proto_v = if argc >= 2 { args[1] } else { zjs_undefined() };
    let proto_ok: bool = zjs_is_null(proto_v) != 0 || zjs_is_object(proto_v) != 0;
    if !proto_ok {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object prototype may only be an Object or null", 47);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    if zjs_is_object(obj_v) != 0 {
        let o = zjs_as_object(obj_v);
        if zjs_is_null(proto_v) != 0 {
            o.proto = NULL;
        } else {
            let new_proto = zjs_as_object(proto_v);
            // Cycle check (ECMA-262 OrdinarySetPrototypeOf step 8). Walk
            // the proposed proto chain; if we reach `o`, the assignment
            // would create a cycle — throw TypeError. Skip when the new
            // proto IS the existing one (identity assign is a no-op).
            if new_proto != o.proto {
                let p = new_proto;
                while p != NULL {
                    if p == o {
                        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                                    (char*)"cyclic __proto__ value", 22);
                        ctx.pending_throw_active = true;
                        ctx.pending_throw_value = err;
                        return zjs_undefined();
                    }
                    p = p.proto;
                }
            }
            o.proto = new_proto;
        }
    }
    // Non-object receivers: spec returns the original value unchanged.
    return obj_v;
}

fn host_object_get_prototype_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if !require_object_keys_arg(ctx, v) { return zjs_undefined(); }
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        if o.proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)o.proto);
    }
    if zjs_is_array(v) != 0 {
        if ctx.array_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.array_proto);
    }
    if zjs_is_host_function(v) != 0 {
        // Host fns may carry an explicit override (used for error
        // subclasses whose [[Prototype]] is Error itself). Otherwise
        // every callable's [[Prototype]] is Function.prototype.
        let hf = zjs_as_host_function(v);
        if zjs_is_undefined(hf.proto_override) == 0 { return hf.proto_override; }
        if ctx.function_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.function_proto);
    }
    if zjs_is_function(v) != 0 {
        let fp = zjs_cell_as_ptr(v);
        let ff: Function* = NULL;
        raw { ff = (Function*)fp; }
        if zjs_is_undefined(ff.parent_ctor) == 0 { return ff.parent_ctor; }
        if ctx.function_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.function_proto);
    }
    if zjs_is_closure(v) != 0 {
        let cl = zjs_as_closure(v);
        let fp2 = cl.function;
        let ff2: Function* = NULL;
        raw { ff2 = (Function*)fp2; }
        if zjs_is_undefined(ff2.parent_ctor) == 0 { return ff2.parent_ctor; }
        if ctx.function_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.function_proto);
    }
    if zjs_is_regexp(v) != 0 && ctx.regexp_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.regexp_proto);
    }
    if zjs_is_promise(v) != 0 && ctx.promise_ctor_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.promise_ctor_proto);
    }
    if zjs_is_generator(v) != 0 && ctx.generator_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.generator_proto);
    }
    // Primitives — ToObject(v) would wrap, then get its prototype.
    // Surface the matching prototype chain root directly; that's the
    // observable result.
    if zjs_is_string(v) != 0 && ctx.string_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.string_proto);
    }
    if zjs_is_bool(v) != 0 {
        let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
        if bool_g >= 0 {
            let bv = ctx.globals[bool_g].value;
            if zjs_is_host_function(bv) != 0 {
                let proto = zjs_as_host_function(bv).prototype;
                if proto != NULL { return zjs_cell_from_ptr((void*)proto); }
            }
        }
        return zjs_null();
    }
    if zjs_is_number(v) != 0 {
        let num_g = ctx_find_global(ctx, (char*)"Number", 6);
        if num_g >= 0 {
            let nv = ctx.globals[num_g].value;
            if zjs_is_host_function(nv) != 0 {
                let proto = zjs_as_host_function(nv).prototype;
                if proto != NULL { return zjs_cell_from_ptr((void*)proto); }
            }
        }
        return zjs_null();
    }
    return zjs_null();
}

// Object.keys(obj) — array of own enumerable string keys, in insertion
// order. We walk the hidden-class chain bottom-up; each transition_name
// goes at transition_slot. Non-object inputs return an empty array.
// Object.getOwnPropertyNames(o) — like Object.keys but spec-wise it
// also lists non-enumerable own properties. We don't track
// enumerability, so the two agree on plain objects + arrays. For a
// host function we additionally surface `length` and `name` to match
// the "built-in property order" tests (length before name).
fn host_object_get_own_property_names(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_new_array(ctx, 0); }
    let v = args[0];
    if zjs_is_host_function(v) != 0 {
        let hf = zjs_as_host_function(v);
        let out_v = ctx_new_array(ctx, 4);
        let out_arr = zjs_as_array(out_v);
        let cursor: u32 = 0;
        // Spec-mandated order: "length" then "name".
        out_arr.elements[cursor] = ctx_intern_string(ctx, (char*)"length", 6);
        cursor = cursor + 1;
        out_arr.elements[cursor] = ctx_intern_string(ctx, (char*)"name", 4);
        cursor = cursor + 1;
        if hf.props != NULL {
            let cls = hf.props.cls;
            while cls != NULL && cls.parent != NULL {
                let nm = cls.transition_name;
                let slot = cls.transition_slot;
                let is_internal: bool = false;
                if nm.length >= 6 {
                    let nd = nm.data;
                    raw { is_internal = (memcmp(nd, "__zjs_", 6) == 0) ? true : false; }
                }
                if !is_internal && zjs_is_deleted(hf.props.slots[slot]) == 0 {
                    if cursor >= out_arr.cap {
                        // Grow if more than the default 4-prep got
                        // exceeded — array_set handles growth for us.
                        array_set(out_arr, cursor, zjs_cell_from_ptr((void*)nm));
                    } else {
                        out_arr.elements[cursor] = zjs_cell_from_ptr((void*)nm);
                    }
                    cursor = cursor + 1;
                }
                cls = cls.parent;
            }
        }
        out_arr.length = cursor;
        return out_v;
    }
    // Other receivers — fall through to Object.keys behavior.
    return host_object_keys(ctx, args, argc);
}

fn host_object_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let arg0 = if argc >= 1 { args[0] } else { zjs_undefined() };
    if !require_object_keys_arg(ctx, arg0) { return zjs_undefined(); }
    // Array path: enumerate present indices as string keys. Holes and
    // out-of-length slots stay invisible. Length itself is
    // non-enumerable so it's omitted.
    if zjs_is_array(args[0]) != 0 {
        let a = zjs_as_array(args[0]);
        let n = a.length;
        let out_v = ctx_new_array(ctx, n);
        ctx_push_temp_root(ctx, out_v);
        defer ctx_pop_temp_root(ctx);
        let out_arr = zjs_as_array(out_v);
        let out_idx: u32 = 0;
        let i: u32 = 0;
        let dense_limit: u32 = if a.cap < n { a.cap } else { n };
        while i < dense_limit {
            // Skip holes — Object.keys reports only present indices.
            if zjs_is_deleted(a.elements[i]) == 0 {
                let buf: char[16];
                let blen: int = 0;
                raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)i); }
                let bp: char* = NULL; raw { bp = &buf[0]; }
                array_set(out_arr, out_idx, ctx_intern_string(ctx, bp, (u32)blen));
                out_idx = out_idx + 1;
            }
            i = i + 1;
        }
        // Indexed entries past arr.cap live on the .props expando — pick
        // them up by walking the expando's hidden class.
        if a.props != NULL {
            let cls = a.props.cls;
            while cls != NULL && cls.parent != NULL {
                let nm = cls.transition_name;
                let slot = cls.transition_slot;
                if slot < a.props.cls.prop_count {
                    let raw_v = a.props.slots[slot];
                    let attrs = object_get_attrs(a.props, slot);
                    if zjs_is_deleted(raw_v) == 0 && (attrs & PROP_ENUMERABLE) != 0 {
                        // Skip internal `__zjs_*` hidden keys. Numeric
                        // keys past arr.cap AND string keys (e.g. a
                        // defineProperty'd named prop on an array)
                        // both land here.
                        let nd = nm.data;
                        let nl = nm.length;
                        let is_internal: bool = false;
                        if nl >= 6 {
                            raw { is_internal = (memcmp(nd, "__zjs_", 6) == 0) ? true : false; }
                        }
                        if !is_internal {
                            array_set(out_arr, out_idx, zjs_cell_from_ptr((void*)nm));
                            out_idx = out_idx + 1;
                        }
                    }
                }
                cls = cls.parent;
            }
        }
        out_arr.length = out_idx;
        return out_v;
    }
    // Function / host-function / regex receivers: walk the .props
    // expando if any. Closure shares the underlying Function*.
    let receiver_obj: ZjsObject* = NULL;
    if zjs_is_function(args[0]) != 0 {
        let fp = zjs_cell_as_ptr(args[0]);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        receiver_obj = f.props;
    } else if zjs_is_closure(args[0]) != 0 {
        let cl = zjs_as_closure(args[0]);
        let fp2 = cl.function;
        let f2: Function* = NULL;
        raw { f2 = (Function*)fp2; }
        receiver_obj = f2.props;
    } else if zjs_is_host_function(args[0]) != 0 {
        let hf = zjs_as_host_function(args[0]);
        receiver_obj = hf.props;
    } else if zjs_is_regexp(args[0]) != 0 {
        let r = zjs_as_regexp(args[0]);
        receiver_obj = r.props;
    } else if zjs_is_object(args[0]) != 0 {
        receiver_obj = zjs_as_object(args[0]);
    } else {
        return ctx_new_array(ctx, 0);
    }
    if receiver_obj == NULL {
        return ctx_new_array(ctx, 0);
    }
    let o = receiver_obj;
    let cap = o.cls.prop_count;
    let arr_v = ctx_new_array(ctx, cap);
    let arr = zjs_as_array(arr_v);
    // Build a name-by-slot scratch first, then compact down to only
    // the present (non-deleted) ones in insertion order.
    let scratch: ZjsString*[64];
    let limit: u32 = if cap > 64 { 64 } else { cap };
    let init_i: u32 = 0;
    while init_i < limit { scratch[init_i] = NULL; init_i = init_i + 1; }
    let cls = o.cls;
    while cls != NULL && cls.parent != NULL {
        let slot = cls.transition_slot;
        // Object.keys reports own enumerable string-keyed properties:
        // skip deleted slots AND skip non-enumerable slots.
        if slot < limit && zjs_is_deleted(o.slots[slot]) == 0 {
            let a = object_get_attrs(o, slot);
            if (a & PROP_ENUMERABLE) != 0 {
                scratch[slot] = cls.transition_name;
            }
        }
        cls = cls.parent;
    }
    // ECMA-262 OrdinaryOwnPropertyKeys: array-index keys first, in
    // ascending numeric order, then string keys in insertion order.
    // Two-pass: separate integer-index keys, sort, emit; then string
    // keys in slot (= creation) order.
    let int_keys: u32[64];
    let int_names: ZjsString*[64];
    let int_count: u32 = 0;
    let i: u32 = 0;
    while i < limit {
        let nm = scratch[i];
        if nm != NULL {
            let is_internal: bool = false;
            if nm.length >= 6 {
                let nd = nm.data;
                raw { is_internal = (memcmp(nd, "__zjs_", 6) == 0) ? true : false; }
            }
            if !is_internal {
                let idx_v: i64 = string_as_array_index(nm);
                if idx_v >= 0 && int_count < 64 {
                    int_keys[int_count] = (u32)idx_v;
                    int_names[int_count] = nm;
                    int_count = int_count + 1;
                    scratch[i] = NULL; // consumed
                }
            }
        }
        i = i + 1;
    }
    // Insertion sort int_keys by numeric value.
    let si: u32 = 1;
    while si < int_count {
        let kv = int_keys[si];
        let nv = int_names[si];
        let sj: i32 = (i32)si - 1;
        while sj >= 0 && int_keys[(u32)sj] > kv {
            int_keys[(u32)(sj + 1)] = int_keys[(u32)sj];
            int_names[(u32)(sj + 1)] = int_names[(u32)sj];
            sj = sj - 1;
        }
        int_keys[(u32)(sj + 1)] = kv;
        int_names[(u32)(sj + 1)] = nv;
        si = si + 1;
    }
    let out: u32 = 0;
    let ii: u32 = 0;
    while ii < int_count {
        arr.elements[out] = zjs_cell_from_ptr((void*)int_names[ii]);
        out = out + 1;
        ii = ii + 1;
    }
    let j: u32 = 0;
    while j < limit {
        if scratch[j] != NULL {
            let nm2 = scratch[j];
            let is_internal2: bool = false;
            if nm2.length >= 6 {
                let nd2 = nm2.data;
                raw { is_internal2 = (memcmp(nd2, "__zjs_", 6) == 0) ? true : false; }
            }
            if !is_internal2 {
                arr.elements[out] = zjs_cell_from_ptr((void*)nm2);
                out = out + 1;
            }
        }
        j = j + 1;
    }
    arr.length = out;
    return arr_v;
}

// Returns the numeric value if `name` is a CanonicalNumericIndexString
// for a non-negative integer in u32 range, else -1.
fn string_as_array_index(name: ZjsString*) -> i64 {
    if name == NULL || name.length == 0 { return -1; }
    let d = name.data;
    let n = name.length;
    if n > 10 { return -1; }  // 10 digits = max u32 (4294967295)
    // Leading-zero disallowed except for the singleton "0".
    let first: u8 = (u8)d[0];
    if first == (u8)'0' {
        if n == 1 { return 0; }
        return -1;
    }
    if first < (u8)'1' || first > (u8)'9' { return -1; }
    let v: u64 = 0;
    let i: u32 = 0;
    while i < n {
        let c = (u8)d[i];
        if c < (u8)'0' || c > (u8)'9' { return -1; }
        v = v * 10 + (u64)(c - (u8)'0');
        i = i + 1;
    }
    if v > 4294967295 { return -1; }
    return (i64)v;
}

// --- Array.prototype helpers ---------------------------------------

// Coerce `.length` to a u32. Most array-like objects have an integer
// length; ECMA-262 has more rigorous coercion rules we approximate.
fn read_length_u32(ctx: ZjsContext*, this_val: ZjsValue) -> u32 {
    if zjs_is_array(this_val) != 0 {
        return zjs_as_array(this_val).length;
    }
    // Any non-array cell value (objects + function / regex / host fn /
    // wrapper primitives) routes through property_get on the receiver,
    // which handles each shape's prototype chain.
    if zjs_is_undefined(this_val) == 0 && zjs_is_null(this_val) == 0 {
        // Use property_get so the proto chain is walked AND accessor
        // properties (Object.defineProperty getters) fire correctly.
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        let key_v = zjs_cell_from_ptr((void*)len_atom);
        let v = property_get(ctx, this_val, key_v);
        if zjs_is_int32(v) != 0 {
            let n = zjs_as_int32(v);
            if n > 0 { return (u32)n; }
            return 0;
        }
        if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        // ECMA-262 ToLength: run ToPrimitive("number") first so the
        // proto-chain valueOf fires (test262 cases use a length object
        // with inherited valueOf returning the actual length).
        if zjs_is_object(v) != 0 || zjs_is_array(v) != 0 {
            let prim = zjs_to_primitive(ctx, v, false);
            if ctx.pending_throw_active { return 0; }
            let d = zjs_to_double(prim);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        if zjs_is_string(v) != 0 {
            // ToNumber on the string.
            let d = zjs_to_double(v);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        if zjs_is_bool(v) != 0 {
            if zjs_as_bool(v) != 0 { return 1; }
            return 0;
        }
        return 0;
    }
    return 0;
}

// Set obj[index] = value where obj is a plain object (generic-this).
fn obj_set_indexed(ctx: ZjsContext*, o: ZjsObject*, index: u32, value: ZjsValue) -> void {
    let key_buf: char[16];
    let key_len: int = 0;
    raw {
        key_len = snprintf(&key_buf[0], 16, "%u", (unsigned)index);
    }
    let kp: char* = NULL;
    raw { kp = &key_buf[0]; }
    let key_atom = ctx_intern_atom(ctx, kp, (u32)key_len);
    object_set(ctx, o, key_atom, value);
}

fn obj_get_indexed(ctx: ZjsContext*, o: ZjsObject*, index: u32) -> ZjsValue {
    // Delegate to property_get so accessors fire and proto-chain
    // semantics (including string/array prototype intercepts) are
    // honored. The key is the integer index reformatted as a string;
    // property_get internally uses zjs_to_array_index for the fast
    // path on real arrays.
    let key_v = zjs_int32((i32)index);
    let obj_v = zjs_cell_from_ptr((void*)o);
    return property_get(ctx, obj_v, key_v);
}

// Spec HasProperty for an indexed key. Walks own props (arrays with
// or without expando bag, plain objects via the class chain) and
// then up the prototype chain. Used by Array.prototype iteration
// methods (map / forEach / filter / find / etc.) to honor the spec's
// "hole = skip callback" rule for BOTH real arrays AND generic
// array-like receivers (Array.prototype.map.call(obj, ...)).
fn value_has_index(ctx: ZjsContext*, v: ZjsValue, idx: u32) -> bool {
    // Real-array fast path: dense slot present means own. If the array
    // also has an expando bag with a stringified-index property, that
    // counts too (defineProperty(arr, "3", ...) lands there).
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        if array_has_index(a, idx) != 0 { return true; }
        // Fall through to the proto walk below — Array.prototype may
        // carry an inherited indexed property (test262 pokes these).
    }
    // Generic-object walk: stringify the index once, then look up by
    // atom in the own class and each ancestor proto's class.
    let buf: char[16];
    let n: int = 0;
    raw { n = snprintf(&buf[0], 16, "%u", (unsigned)idx); }
    let kp: char* = NULL;
    raw { kp = &buf[0]; }
    let key_atom = ctx_intern_atom(ctx, kp, (u32)n);
    if zjs_is_object(v) != 0 {
        let cur: ZjsObject* = zjs_as_object(v);
        while cur != NULL {
            let slot = class_find_slot(cur.cls, key_atom);
            if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 { return true; }
            cur = cur.proto;
        }
        // Wrapped primitive (String boxed via ToObject): indexed access
        // goes through property_get's wrapper path even though the
        // class chain has no per-char slots. For string wrappers a
        // valid in-range index counts as own per spec — exactly the
        // semantics `Array.prototype.forEach.call("abc", cb)` relies on.
        let o2 = zjs_as_object(v);
        let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        let wslot = class_find_slot(o2.cls, wkey);
        if wslot >= 0 {
            let wv = o2.slots[(u32)wslot];
            if zjs_is_string(wv) != 0 {
                let s = zjs_as_string(wv);
                if idx < s.length { return true; }
            }
        }
        return false;
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        // Expando bag: defineProperty(arr, "3", ...) goes here too.
        if a.props != NULL {
            let slot = class_find_slot(a.props.cls, key_atom);
            if slot >= 0 && zjs_is_deleted(a.props.slots[(u32)slot]) == 0 { return true; }
        }
        // Walk up the array's proto chain — Array.prototype is a
        // plain ZjsObject in our model, so the same class walk works.
        if ctx.array_proto != NULL {
            let cur: ZjsObject* = ctx.array_proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, key_atom);
                if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 { return true; }
                cur = cur.proto;
            }
        }
        return false;
    }
    return false;
}

// ECMA-262 RequireObjectCoercible step at the top of every Array
// prototype method: `Array.prototype.X.call(undefined or null)` must
// throw TypeError. Returns `true` on accept (caller continues normally);
// returns `false` on reject after wiring a pending throw — caller must
// `return zjs_undefined()` immediately.
fn require_array_coercible_this(ctx: ZjsContext*) -> bool {
    let this_val = ctx.host_this;
    if zjs_is_undefined(this_val) == 0 && zjs_is_null(this_val) == 0 { return true; }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"Array.prototype method called on null or undefined", 51);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return false;
}

// Spec's IsCallable check for the array-method callback argument. The
// no-callback / non-callable case throws TypeError per
// ECMA-262 §22.1.3.12 (forEach), §22.1.3.18 (map), and siblings.
// Returns true on success; on failure arms the JS-visible throw and
// the caller bails with zjs_undefined().
fn require_callback_callable(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> bool {
    let cb = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_function(cb) != 0 || zjs_is_closure(cb) != 0 || zjs_is_host_function(cb) != 0 {
        return true;
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"Callback is not a function", 26);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return false;
}

fn host_array_push(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let i: u32 = 0;
        while i < argc {
            array_set(arr, arr.length, args[i]);
            i = i + 1;
        }
        return zjs_int32((i32)arr.length);
    }
    // Generic-this: ToObject primitive receivers (push.call(true), etc.)
    if zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let len = read_length_u32(ctx, this_val);
        let i: u32 = 0;
        while i < argc {
            obj_set_indexed(ctx, o, len + i, args[i]);
            i = i + 1;
        }
        let new_len = len + argc;
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        object_set(ctx, o, len_atom, zjs_int32((i32)new_len));
        return zjs_int32((i32)new_len);
    }
    return zjs_undefined();
}

fn host_array_pop(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        if arr.length == 0 { return zjs_undefined(); }
        // Read through array_get so the hole sentinel coerces to
        // undefined; leave the popped slot as a hole.
        let last = array_get(arr, arr.length - 1);
        arr.elements[arr.length - 1] = zjs_deleted();
        arr.length = arr.length - 1;
        return last;
    }
    if zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let len = read_length_u32(ctx, this_val);
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        if len == 0 {
            object_set(ctx, o, len_atom, zjs_int32(0));
            return zjs_undefined();
        }
        let last_idx = len - 1;
        let last_v = obj_get_indexed(ctx, o, last_idx);
        // Remove the property and update length.
        // (We don't have a proper delete — leave it as undefined.)
        obj_set_indexed(ctx, o, last_idx, zjs_undefined());
        object_set(ctx, o, len_atom, zjs_int32((i32)last_idx));
        return last_v;
    }
    return zjs_undefined();
}

fn host_array_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if argc == 0 { return zjs_int32(-1); }
    let needle = args[0];

    // ECMA-262 §22.1.3.14 step 2: `O = ToObject(this)`. For primitive
    // receivers (`indexOf.call("abc", "b")`, `.call(true, target)`,
    // numbers, etc.) wrap and dispatch through the generic-object path.
    // The wrapper's prototype chain carries the indexed properties
    // (Boolean.prototype[1] = ... patterns) and the length getter.
    if zjs_is_array(this_val) == 0 && zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }

    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let len = arr.length;
        let from: u32 = 0;
        if argc >= 2 {
            let fi_v = args[1];
            // ECMA-262: fromIndex via ToInteger → ToPrimitive("number").
            // Object args must fire valueOf / toString in spec order.
            if zjs_is_object(fi_v) != 0 || zjs_is_array(fi_v) != 0 {
                fi_v = zjs_to_primitive(ctx, fi_v, false);
                if ctx.pending_throw_active { return zjs_int32(-1); }
            }
            let fi = zjs_to_double(fi_v);
            raw { if (isnan(fi)) fi = 0; }
            if fi < 0.0 {
                let nfi = (f64)len + fi;
                if nfi < 0.0 { from = 0; } else { from = (u32)nfi; }
            } else if fi >= (f64)len {
                return zjs_int32(-1);
            } else {
                from = (u32)fi;
            }
        }
        let i: u32 = from;
        while i < len {
            // Spec checks HasProperty(O, k) before the strict-equality
            // step — holes never compare equal to anything, including
            // undefined. Skip them. When arr.props exists, route
            // through property_get so installed accessors fire.
            let slot: ZjsValue = zjs_undefined();
            let present: bool = false;
            if arr.props != NULL {
                let v_pg = property_get(ctx, this_val, zjs_int32((i32)i));
                if ctx.pending_throw_active { return zjs_int32(-1); }
                slot = v_pg;
                present = true;
            } else {
                // Defensive: sparse arrays from defineProperty can have
                // length > cap; treat those slots as absent.
                if i < arr.cap {
                    let raw_v = arr.elements[i];
                    if zjs_is_deleted(raw_v) == 0 {
                        slot = raw_v;
                        present = true;
                    }
                }
            }
            if present {
                if zjs_strict_eq(slot, needle) != 0 {
                    return zjs_int32((i32)i);
                }
            }
            i = i + 1;
        }
        return zjs_int32(-1);
    }
    // Generic-this for everything else (objects, functions, closures,
    // host fns, regex). Reads via property_get so the right prototype
    // chain and accessor handling fire for each receiver kind.
    let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
    let lkv = property_get(ctx, this_val, zjs_cell_from_ptr((void*)len_atom));
    if zjs_is_object(lkv) != 0 || zjs_is_array(lkv) != 0 {
        lkv = zjs_to_primitive(ctx, lkv, false);
        if ctx.pending_throw_active { return zjs_int32(-1); }
    }
    let len_d = zjs_to_double(lkv);
    raw {
        if (!isfinite(len_d) || len_d <= 0.0) len_d = 0.0;
        else len_d = floor(len_d);   // ToLength truncates to integer
    }
    let from_d: f64 = 0.0;
    if argc >= 2 {
        let pos = args[1];
        if zjs_is_object(pos) != 0 || zjs_is_array(pos) != 0 {
            pos = zjs_to_primitive(ctx, pos, false);
            if ctx.pending_throw_active { return zjs_int32(-1); }
        }
        from_d = zjs_to_double(pos);
        raw { if (isnan(from_d)) from_d = 0; }
        if from_d < 0.0 {
            from_d = len_d + from_d;
            if from_d < 0.0 { from_d = 0.0; }
        }
    }
    if from_d >= len_d { return zjs_int32(-1); }
    let i = from_d;
    while i < len_d {
        let idx_u: u32 = (u32)i;
        // Spec: HasProperty gates the strict-eq. Without this guard,
        // missing indices read as `undefined` via property_get and
        // spuriously match `indexOf.call({length:5}, undefined)`.
        if value_has_index(ctx, this_val, idx_u) {
            let v = property_get(ctx, this_val, zjs_int32((i32)idx_u));
            if ctx.pending_throw_active { return zjs_int32(-1); }
            if zjs_strict_eq(v, needle) != 0 {
                if i <= 2147483647.0 { return zjs_int32((i32)i); }
                return zjs_double(i);
            }
        }
        i = i + 1.0;
    }
    return zjs_int32(-1);
}

// --- String.prototype helpers ---------------------------------------

// Apply ECMA-262 `O = RequireObjectCoercible(this); S = ToString(O)`
// to the calling-host's `this`. Returns undefined and arms a
// JS-visible TypeError throw via pending_throw_active if `this` is
// null/undefined; returns a string-typed ZjsValue otherwise. Callers
// bail on undefined and the interpreter's post-host-call epilogue
// observes pending_throw_active and unwinds.
fn coerce_string_this(ctx: ZjsContext*) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_undefined(this_val) != 0 || zjs_is_null(this_val) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    if zjs_is_string(this_val) != 0 { return this_val; }
    return zjs_to_string(ctx, this_val);
}

fn host_string_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_int32(-1); }
    if argc == 0 { return zjs_int32(-1); }
    let needle_v = args[0];
    if zjs_is_string(needle_v) == 0 { needle_v = zjs_to_string(ctx, needle_v); }
    if ctx.pending_throw_active { return zjs_int32(-1); }
    let hay = zjs_as_string(str_v);
    if zjs_is_string(needle_v) == 0 { return zjs_int32(-1); }
    let nee = zjs_as_string(needle_v);
    let hay_d = hay.data;
    let hay_n = hay.length;
    let nee_d = nee.data;
    let nee_n = nee.length;
    // Optional fromIndex (clamped to [0, hay_n]). ToNumber via
    // ToPrimitive so an object with valueOf is honored — tests
    // pass `{valueOf: ()=>{throw ...}}` here.
    let from: u32 = 0;
    if argc >= 2 {
        let pos_v = args[1];
        if zjs_is_object(pos_v) != 0 || zjs_is_array(pos_v) != 0 {
            pos_v = zjs_to_primitive(ctx, pos_v, false);
            if ctx.pending_throw_active { return zjs_int32(-1); }
        }
        let fi = zjs_to_double(pos_v);
        raw { if (isnan(fi)) fi = 0; }
        if fi < 0.0 { fi = 0.0; }
        if fi > (f64)hay_n { fi = (f64)hay_n; }
        from = (u32)fi;
    }
    if nee.length == 0 { return zjs_int32((i32)from); }
    if hay_n < nee_n { return zjs_int32(-1); }
    let result: i32 = -1;
    raw {
        for (uint32_t i = from; i + nee_n <= hay_n; i++) {
            if (memcmp(hay_d + i, nee_d, nee_n) == 0) {
                result = (int32_t)i;
                break;
            }
        }
    }
    return zjs_int32(result);
}

// Clamp + normalize a slice endpoint (negatives count from end).
// Runs ToNumber via ToPrimitive("number") so objects with custom
// valueOf throw or coerce as the spec requires.
fn slice_clamp(ctx: ZjsContext*, v: ZjsValue, len: u32, default_val: i32) -> i32 {
    if zjs_is_undefined(v) != 0 { return default_val; }
    if zjs_is_object(v) != 0 || zjs_is_array(v) != 0 {
        v = zjs_to_primitive(ctx, v, false);
        if ctx.pending_throw_active { return 0; }
    }
    let n = (i32)zjs_to_double(v);
    if n < 0 { n = (i32)len + n; }
    if n < 0 { n = 0; }
    if n > (i32)len { n = (i32)len; }
    return n;
}

fn host_string_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let start = if argc >= 1 { slice_clamp(ctx, args[0], s.length, 0) }
                else         { 0 };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let end_default: i32 = (i32)s.length;
    let end = if argc >= 2 { slice_clamp(ctx, args[1], s.length, end_default) }
              else         { end_default };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    if end < start { end = start; }
    let outlen = (u32)(end - start);
    let buf = alloc_n<char>((usize)(outlen + 1));
    if outlen > 0 {
        let src_at: char* = NULL;
        let src_off = (u32)start;
        raw { src_at = &s->data[src_off]; }
        mem_copy<char>(buf, src_at, (usize)outlen);
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

// String.prototype.substring(start, end): like slice but clamps
// negative args to 0 and swaps start/end if start > end.
fn host_string_substring(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let slen: i32 = (i32)s.length;
    let start_d: f64 = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let end_d: f64 = if argc >= 2 { zjs_to_double(args[1]) } else { (f64)slen };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let is_nan_s: int = 0; raw { is_nan_s = isnan(start_d) ? 1 : 0; }
    let is_nan_e: int = 0; raw { is_nan_e = isnan(end_d)   ? 1 : 0; }
    if is_nan_s != 0 { start_d = 0.0; }
    if is_nan_e != 0 { end_d   = 0.0; }
    if start_d < 0.0 { start_d = 0.0; }
    if end_d   < 0.0 { end_d   = 0.0; }
    if start_d > (f64)slen { start_d = (f64)slen; }
    if end_d   > (f64)slen { end_d   = (f64)slen; }
    let start: i32 = (i32)start_d;
    let end:   i32 = (i32)end_d;
    if start > end { let t = start; start = end; end = t; }
    let outlen = (u32)(end - start);
    let buf = alloc_n<char>((usize)(outlen + 1));
    if outlen > 0 {
        let src_at: char* = NULL;
        let src_off = (u32)start;
        raw { src_at = &s->data[src_off]; }
        mem_copy<char>(buf, src_at, (usize)outlen);
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

// String.prototype.startsWith(searchString, position = 0)
fn host_string_starts_with(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_bool(0); }
    let s = zjs_as_string(str_v);
    if argc == 0 { return zjs_bool(0); }
    let needle = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    if ctx.pending_throw_active { return zjs_bool(0); }
    let ns = zjs_as_string(needle);
    let pos: i32 = 0;
    if argc >= 2 { pos = (i32)zjs_to_double(args[1]); }
    if pos < 0 { pos = 0; }
    if pos > (i32)s.length { return zjs_bool(ns.length == 0); }
    if pos + (i32)ns.length > (i32)s.length { return zjs_bool(0); }
    let sd = s.data; let nd = ns.data; let off = (u32)pos; let nl = ns.length;
    let eq: int = 0;
    raw { eq = (memcmp(sd + off, nd, nl) == 0) ? 1 : 0; }
    return zjs_bool(eq);
}

// String.prototype.endsWith(searchString, endPosition = length)
fn host_string_ends_with(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_bool(0); }
    let s = zjs_as_string(str_v);
    if argc == 0 { return zjs_bool(0); }
    let needle = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    if ctx.pending_throw_active { return zjs_bool(0); }
    let ns = zjs_as_string(needle);
    let endp: i32 = (i32)s.length;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        endp = (i32)zjs_to_double(args[1]);
        if endp < 0 { endp = 0; }
        if endp > (i32)s.length { endp = (i32)s.length; }
    }
    if (i32)ns.length > endp { return zjs_bool(ns.length == 0); }
    let from = endp - (i32)ns.length;
    let sd = s.data; let nd = ns.data; let off = (u32)from; let nl = ns.length;
    let eq: int = 0;
    raw { eq = (memcmp(sd + off, nd, nl) == 0) ? 1 : 0; }
    return zjs_bool(eq);
}

// String.prototype.includes(searchString, position = 0)
fn host_string_includes(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_bool(0); }
    if argc == 0 { return zjs_bool(0); }
    // Delegate to indexOf semantics (skipping the regex-as-search guard
    // since ECMA-262 forbids it; spec is detailed elsewhere).
    let need_args: ZjsValue[2];
    need_args[0] = args[0];
    if argc >= 2 { need_args[1] = args[1]; }
    let argp: ZjsValue* = NULL; raw { argp = &need_args[0]; }
    let r = host_string_index_of(ctx, argp, if argc >= 2 { 2 } else { 1 });
    if ctx.pending_throw_active { return zjs_bool(0); }
    return zjs_bool(zjs_is_int32(r) != 0 && zjs_as_int32(r) >= 0);
}

// String.prototype.trim — strip whitespace + line terminators per
// ECMA-262 §22.1.3.32.
fn host_string_trim(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let sd = s.data;
    let lo: u32 = 0;
    let hi: u32 = s.length;
    raw {
        while (lo < hi) {
            unsigned char c = (unsigned char)sd[lo];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f') lo++;
            else break;
        }
        while (hi > lo) {
            unsigned char c = (unsigned char)sd[hi - 1];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f') hi--;
            else break;
        }
    }
    let outlen = hi - lo;
    let buf = alloc_n<char>((usize)(outlen + 1));
    if outlen > 0 {
        let src_at: char* = NULL;
        let src_off = lo;
        raw { src_at = &s->data[src_off]; }
        mem_copy<char>(buf, src_at, (usize)outlen);
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

// String.prototype.repeat(count)
fn host_string_repeat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let n_d: f64 = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let is_inf: int = 0; raw { is_inf = isinf(n_d) ? 1 : 0; }
    if n_d < 0.0 || is_inf != 0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"Invalid count value", 19);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let n: u32 = (u32)n_d;
    if n == 0 || s.length == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let outlen = s.length * n;
    let buf = alloc_n<char>((usize)(outlen + 1));
    let i: u32 = 0;
    while i < n {
        let dst: char* = NULL;
        let off = i * s.length;
        raw { dst = buf + off; }
        mem_copy<char>(dst, s.data, (usize)s.length);
        i = i + 1;
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

fn host_string_char_at(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let idx: i32 = 0;
    if argc >= 1 { idx = (i32)zjs_to_double(args[0]); }
    if idx < 0 || (u32)idx >= s.length {
        return ctx_intern_string(ctx, (char*)"", 0);
    }
    let buf = alloc_n<char>((usize)2);
    buf[0] = s.data[(u32)idx];
    buf[1] = (char)0;
    return ctx_intern_string_take(ctx, buf, 1);
}

fn host_string_char_code_at(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 {
        let nan: f64 = 0.0; raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let s = zjs_as_string(str_v);
    let idx: i32 = 0;
    if argc >= 1 { idx = (i32)zjs_to_double(args[0]); }
    if idx < 0 || (u32)idx >= s.length {
        let nan: f64 = 0.0; raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let c = (u8)s.data[(u32)idx];
    return zjs_int32((i32)c);
}

fn host_string_to_upper_case(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let n = s.length;
    let buf = alloc_n<char>((usize)(n + 1));
    let i: u32 = 0;
    while i < n {
        let c = s.data[i];
        let cu = (u8)c;
        if cu >= 97 && cu <= 122 { buf[i] = (char)(cu - 32); }
        else                     { buf[i] = c; }
        i = i + 1;
    }
    buf[n] = (char)0;
    return ctx_intern_string_take(ctx, buf, n);
}

fn host_string_to_lower_case(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let n = s.length;
    let buf = alloc_n<char>((usize)(n + 1));
    let i: u32 = 0;
    while i < n {
        let c = s.data[i];
        let cu = (u8)c;
        if cu >= 65 && cu <= 90 { buf[i] = (char)(cu + 32); }
        else                    { buf[i] = c; }
        i = i + 1;
    }
    buf[n] = (char)0;
    return ctx_intern_string_take(ctx, buf, n);
}

fn host_string_concat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let result = this_val;
    // Defensive rooting: `result` is held across loop iterations of
    // zjs_string_concat (which allocates). `other` is also briefly
    // held across the concat call and rooted just for that span.
    ctx_push_temp_root(ctx, result);
    defer ctx_pop_temp_root(ctx);
    let i: u32 = 0;
    while i < argc {
        let other = args[i];
        if zjs_is_string(other) == 0 { other = zjs_to_string(ctx, other); }
        ctx_push_temp_root(ctx, other);
        result = zjs_string_concat(ctx, result, other);
        ctx_pop_temp_root(ctx);
        ctx_replace_top_temp_root(ctx, result);
        i = i + 1;
    }
    return result;
}

// String.prototype.replace(search, replacement). MVP support:
//   * search: string OR regex
//   * replacement: string (no `$1`/`$&` substitutions yet) OR function
// For regex search without the `g` flag, replaces only the first
// match. With `g`, replaces all non-overlapping matches.
fn host_string_replace(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return this_val; }
    let s = zjs_as_string(this_val);
    if argc < 2 { return this_val; }
    let search_v = args[0];
    let repl_v   = args[1];
    let repl_is_fn: bool = zjs_is_function(repl_v) != 0
        || zjs_is_closure(repl_v) != 0
        || zjs_is_host_function(repl_v) != 0;
    let repl_str_v: ZjsValue = if !repl_is_fn {
        if zjs_is_string(repl_v) != 0 { repl_v } else { zjs_to_string(ctx, repl_v) }
    } else { zjs_undefined() };

    // Builder: simple growing char buffer.
    let out_cap: u32 = s.length + 16;
    let out_buf = alloc_n<char>((usize)out_cap);
    let out_len: u32 = 0;

    let hay_d = s.data;
    let hay_n = s.length;

    if zjs_is_regexp(search_v) != 0 {
        let r = zjs_as_regexp(search_v);
        if !regex_ensure_compiled(r) {
            dealloc(out_buf);
            return this_val;
        }
        let is_global = (r.flags & REGEX_FLAG_GLOBAL) != 0;
        let preg = r.preg;
        let pmatch_buf: ZRegMatch[1];
        let cursor: u32 = 0;
        let scan: u32 = 0;
        while scan <= hay_n {
            let rc: int = -1;
            let scan_off = scan;
            raw {
                rc = tre_regexec((regex_t*)preg, hay_d + scan_off, 1, (regmatch_t*)pmatch_buf, 0);
            }
            if rc != 0 { break; }
            let mstart = scan + (u32)pmatch_buf[0].rm_so;
            let mend   = scan + (u32)pmatch_buf[0].rm_eo;
            // Append [cursor..mstart) verbatim.
            let pre_len = mstart - cursor;
            while out_len + pre_len + 64 > out_cap {
                let new_cap = out_cap * 2 + 64;
                out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
                out_cap = new_cap;
            }
            if pre_len > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(out_buf + out_len, src, (usize)pre_len);
                out_len = out_len + pre_len;
            }
            // Compute replacement (string or function call).
            let rep_data: char* = NULL;
            let rep_len: u32 = 0;
            let rep_str_holder: ZjsValue = zjs_undefined();
            if repl_is_fn {
                // fn(match, offset, str) — no captures yet for MVP.
                let mlen = mend - mstart;
                let mbuf = alloc_n<char>((usize)(mlen + 1));
                if mlen > 0 {
                    let msrc: char* = NULL;
                    raw { msrc = &hay_d[mstart]; }
                    mem_copy<char>(mbuf, msrc, (usize)mlen);
                }
                mbuf[mlen] = (char)0;
                let mstr = ctx_intern_string_take(ctx, mbuf, mlen);
                let cb_args: ZjsValue[3];
                cb_args[0] = mstr;
                cb_args[1] = zjs_int32((i32)mstart);
                cb_args[2] = this_val;
                let cb_argp: ZjsValue* = NULL;
                raw { cb_argp = &cb_args[0]; }
                let cb_r: ZjsValue = zjs_undefined();
                raw { cb_r = zjs_call_value_with_this(ctx, repl_v, zjs_undefined(), cb_argp, 3); }
                if zjs_is_string(cb_r) == 0 { cb_r = zjs_to_string(ctx, cb_r); }
                rep_str_holder = cb_r;
                rep_data = zjs_as_string(cb_r).data;
                rep_len  = zjs_as_string(cb_r).length;
            } else {
                rep_data = zjs_as_string(repl_str_v).data;
                rep_len  = zjs_as_string(repl_str_v).length;
            }
            while out_len + rep_len + 64 > out_cap {
                let new_cap = out_cap * 2 + 64;
                out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
                out_cap = new_cap;
            }
            if rep_len > 0 {
                mem_copy<char>(out_buf + out_len, rep_data, (usize)rep_len);
                out_len = out_len + rep_len;
            }
            cursor = mend;
            scan = if mend > scan { mend } else { scan + 1 };
            if !is_global { break; }
        }
        // Trailing remainder.
        let tail_len = hay_n - cursor;
        while out_len + tail_len + 1 > out_cap {
            let new_cap = out_cap * 2 + 64;
            out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
            out_cap = new_cap;
        }
        if tail_len > 0 {
            let src: char* = NULL;
            raw { src = &hay_d[cursor]; }
            mem_copy<char>(out_buf + out_len, src, (usize)tail_len);
            out_len = out_len + tail_len;
        }
        out_buf[out_len] = (char)0;
        return ctx_intern_string_take(ctx, out_buf, out_len);
    }

    // String search: replace first occurrence only.
    let search_str_v = if zjs_is_string(search_v) != 0 { search_v } else { zjs_to_string(ctx, search_v) };
    let nee = zjs_as_string(search_str_v);
    let nee_d = nee.data;
    let nee_n = nee.length;
    let found_at: i32 = -1;
    let i: u32 = 0;
    while i + nee_n <= hay_n {
        let off = i;
        let eq: int = 0;
        raw { eq = (memcmp(hay_d + off, nee_d, nee_n) == 0) ? 1 : 0; }
        if eq != 0 { found_at = (i32)i; break; }
        i = i + 1;
    }
    if found_at < 0 {
        dealloc(out_buf);
        return this_val;
    }
    let mstart = (u32)found_at;
    let mend = mstart + nee_n;
    // Append prefix.
    while out_len + mstart + 64 > out_cap {
        let new_cap = out_cap * 2 + 64;
        out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
        out_cap = new_cap;
    }
    if mstart > 0 {
        mem_copy<char>(out_buf + out_len, hay_d, (usize)mstart);
        out_len = out_len + mstart;
    }
    // Replacement.
    let rep_data: char* = NULL;
    let rep_len: u32 = 0;
    if repl_is_fn {
        let cb_args: ZjsValue[3];
        cb_args[0] = search_str_v;
        cb_args[1] = zjs_int32((i32)mstart);
        cb_args[2] = this_val;
        let cb_argp: ZjsValue* = NULL;
        raw { cb_argp = &cb_args[0]; }
        let cb_r: ZjsValue = zjs_undefined();
        raw { cb_r = zjs_call_value_with_this(ctx, repl_v, zjs_undefined(), cb_argp, 3); }
        if zjs_is_string(cb_r) == 0 { cb_r = zjs_to_string(ctx, cb_r); }
        rep_data = zjs_as_string(cb_r).data;
        rep_len  = zjs_as_string(cb_r).length;
    } else {
        rep_data = zjs_as_string(repl_str_v).data;
        rep_len  = zjs_as_string(repl_str_v).length;
    }
    while out_len + rep_len + (hay_n - mend) + 64 > out_cap {
        let new_cap = out_cap * 2 + 64;
        out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
        out_cap = new_cap;
    }
    if rep_len > 0 {
        mem_copy<char>(out_buf + out_len, rep_data, (usize)rep_len);
        out_len = out_len + rep_len;
    }
    let tail_len = hay_n - mend;
    if tail_len > 0 {
        let src: char* = NULL;
        raw { src = &hay_d[mend]; }
        mem_copy<char>(out_buf + out_len, src, (usize)tail_len);
        out_len = out_len + tail_len;
    }
    out_buf[out_len] = (char)0;
    return ctx_intern_string_take(ctx, out_buf, out_len);
}

// String.prototype.match(regexp): if regexp has the global flag,
// return an array of all full-match strings (no captures). Else
// delegate to RegExp.prototype.exec for the single match (full +
// captures + .index/.input). Non-regexp args are coerced via
// new RegExp(arg).
fn host_string_match(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return zjs_null(); }
    // Coerce the argument to a RegExp.
    let pat_v: ZjsValue = if argc >= 1 { args[0] } else { zjs_undefined() };
    let re_v: ZjsValue = zjs_undefined();
    if zjs_is_regexp(pat_v) != 0 {
        re_v = pat_v;
    } else {
        let pat_str = if zjs_is_undefined(pat_v) != 0 {
            ctx_intern_string(ctx, (char*)"", 0)
        } else if zjs_is_string(pat_v) != 0 {
            pat_v
        } else {
            zjs_to_string(ctx, pat_v)
        };
        re_v = ctx_new_regexp(ctx, pat_str, ctx_intern_string(ctx, (char*)"", 0));
    }
    let re = zjs_as_regexp(re_v);
    let is_global = (re.flags & REGEX_FLAG_GLOBAL) != 0;
    if !is_global {
        // Spec routes through @@match → exec(thisStr). Call exec
        // directly to skip a synthetic indirection.
        let saved_host = ctx.host_this;
        ctx.host_this = re_v;
        let ex_args: ZjsValue[1];
        ex_args[0] = this_val;
        let ex_argp: ZjsValue* = NULL;
        raw { ex_argp = &ex_args[0]; }
        let r = host_regexp_exec(ctx, ex_argp, 1);
        ctx.host_this = saved_host;
        return r;
    }
    // Global: iterate exec until no match, collect full-match strings.
    if !regex_ensure_compiled(re) { return zjs_null(); }
    let s = zjs_as_string(this_val);
    let preg = re.preg;
    let hay_d = s.data;
    let hay_n = s.length;
    let result_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let arr = zjs_as_array(result_v);
    let pmatch_buf: ZRegMatch[1];
    let scan: u32 = 0;
    while scan <= hay_n {
        let rc: int = -1;
        let scan_off = scan;
        raw {
            rc = tre_regexec((regex_t*)preg, hay_d + scan_off, 1, (regmatch_t*)pmatch_buf, 0);
        }
        if rc != 0 { break; }
        let mstart = scan + (u32)pmatch_buf[0].rm_so;
        let mend   = scan + (u32)pmatch_buf[0].rm_eo;
        let mlen = mend - mstart;
        let mbuf = alloc_n<char>((usize)(mlen + 1));
        if mlen > 0 {
            let src: char* = NULL;
            raw { src = &hay_d[mstart]; }
            mem_copy<char>(mbuf, src, (usize)mlen);
        }
        mbuf[mlen] = (char)0;
        array_set(arr, arr.length, ctx_intern_string_take(ctx, mbuf, mlen));
        scan = if mend > scan { mend } else { scan + 1 };
    }
    re.last_index = 0;
    if arr.length == 0 { return zjs_null(); }
    return result_v;
}

fn host_string_split(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return ctx_new_array(ctx, 0); }
    let s = zjs_as_string(this_val);
    // ECMA-262: limit is ToUint32(limit) (undefined → 2^32-1).
    // Process this BEFORE the separator-undefined check so a 0 limit
    // still short-circuits to an empty array per step 8.
    let limit_u32: u32 = 0xffffffff;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let lim_v = args[1];
        // ToUint32 → ToNumber → ToPrimitive("number"). Object args
        // route through valueOf / toString — their throws abort split.
        if zjs_is_object(lim_v) != 0 || zjs_is_array(lim_v) != 0 {
            lim_v = zjs_to_primitive(ctx, lim_v, false);
            if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        }
        let lim = zjs_to_double(lim_v);
        if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        let is_nan_l: int = 0; raw { is_nan_l = isnan(lim) ? 1 : 0; }
        if is_nan_l != 0 { lim = 0.0; }
        // ToUint32: floor toward zero, modulo 2^32, treat NaN as 0.
        let v_d: f64 = lim;
        raw {
            if (v_d < 0) v_d = -v_d;
            v_d = floor(v_d);
            v_d = fmod(v_d, 4294967296.0);
            if (lim < 0) v_d = 4294967296.0 - v_d;
            if (v_d == 4294967296.0) v_d = 0.0;
        }
        limit_u32 = (u32)v_d;
    }
    if limit_u32 == 0 { return ctx_new_array(ctx, 0); }
    // If no separator, return [s].
    if argc == 0 || zjs_is_undefined(args[0]) != 0 {
        let one = ctx_new_array(ctx, 1);
        let one_arr = zjs_as_array(one);
        one_arr.elements[0] = this_val;
        one_arr.length = 1;
        return one;
    }
    let sep_arg = args[0];
    if zjs_is_regexp(sep_arg) != 0 {
        let r = zjs_as_regexp(sep_arg);
        let result_v = ctx_new_array(ctx, 0);
        if !regex_ensure_compiled(r) {
            let arr = zjs_as_array(result_v);
            array_set(arr, 0, this_val);
            return result_v;
        }
        let arr = zjs_as_array(result_v);
        let preg = r.preg;
        let hay_d = s.data;
        let hay_n = s.length;
        let pmatch_buf: ZRegMatch[1];
        let cursor: u32 = 0;
        let scan: u32 = 0;
        // Set when the last emitted piece came from the empty-match
        // single-char advance (so the trailing "" should be suppressed,
        // matching ECMA-262's split-into-chars semantic for an empty
        // pattern). Cleared on any normal piece emission.
        let last_was_empty_advance: bool = false;
        while scan <= hay_n && arr.length < limit_u32 {
            let rc: int = -1;
            let scan_off = scan;
            raw {
                rc = tre_regexec((regex_t*)preg, hay_d + scan_off, 1, (regmatch_t*)pmatch_buf, 0);
            }
            if rc != 0 { break; }
            let mstart = scan + (u32)pmatch_buf[0].rm_so;
            let mend   = scan + (u32)pmatch_buf[0].rm_eo;
            if mstart >= hay_n { break; }
            // Empty match at `cursor` is special: ECMA-262 advances one
            // input char and emits a single-char piece. This is what
            // makes `"abc".split(new RegExp())` give ["a","b","c"]
            // rather than ["", "a", "b", "c"].
            if mstart == cursor && mend == mstart {
                if cursor >= hay_n { break; }
                let pbuf = alloc_n<char>(2);
                pbuf[0] = hay_d[cursor];
                pbuf[1] = (char)0;
                array_set(arr, arr.length, ctx_intern_string_take(ctx, pbuf, 1));
                cursor = cursor + 1;
                scan = cursor;
                last_was_empty_advance = true;
                continue;
            }
            last_was_empty_advance = false;
            let piece_len = mstart - cursor;
            let pbuf = alloc_n<char>((usize)(piece_len + 1));
            if piece_len > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(pbuf, src, (usize)piece_len);
            }
            pbuf[piece_len] = (char)0;
            array_set(arr, arr.length, ctx_intern_string_take(ctx, pbuf, piece_len));
            cursor = mend;
            // Avoid infinite loops on /(?=x)/-style empty matches.
            scan = if mend > scan { mend } else { scan + 1 };
        }
        // Trailing piece. Spec emits even an empty trailing element
        // after the final non-empty match (`"abc".split(/[a-z]/)` →
        // `["", "", "", ""]`). The empty-regex / split-into-chars
        // case (`"abc".split(new RegExp())` → `["a", "b", "c"]`) is
        // the lone exception — suppress the tail when the loop exited
        // via the empty-match single-char advance branch.
        if arr.length < limit_u32 && !last_was_empty_advance {
            let tlen = hay_n - cursor;
            let tbuf = alloc_n<char>((usize)(tlen + 1));
            if tlen > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(tbuf, src, (usize)tlen);
            }
            tbuf[tlen] = (char)0;
            array_set(arr, arr.length, ctx_intern_string_take(ctx, tbuf, tlen));
        }
        return result_v;
    }
    let sep_v = sep_arg;
    if zjs_is_string(sep_v) == 0 { sep_v = zjs_to_string(ctx, sep_v); }
    let sep = zjs_as_string(sep_v);
    let result_v = ctx_new_array(ctx, 0);
    let result = zjs_as_array(result_v);

    // ECMA-262 §22.1.3.21 step 9: limit == 0 short-circuits to [].
    if limit_u32 == 0 { return result_v; }

    // Empty separator: split into individual characters, honoring limit.
    if sep.length == 0 {
        let i: u32 = 0;
        while i < s.length && result.length < limit_u32 {
            let buf = alloc_n<char>((usize)2);
            buf[0] = s.data[i];
            buf[1] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, 1);
            array_set(result, result.length, piece);
            i = i + 1;
        }
        return result_v;
    }

    let hay_d  = s.data;
    let hay_n  = s.length;
    let nee_d  = sep.data;
    let nee_n  = sep.length;
    let cursor: u32 = 0;
    let i: u32 = 0;
    while i + nee_n <= hay_n && result.length < limit_u32 {
        let matches: int = 0;
        let off = i;
        raw { matches = (memcmp(hay_d + off, nee_d, nee_n) == 0) ? 1 : 0; }
        if matches != 0 {
            let piece_len = i - cursor;
            let buf = alloc_n<char>((usize)(piece_len + 1));
            if piece_len > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(buf, src, (usize)piece_len);
            }
            buf[piece_len] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, piece_len);
            array_set(result, result.length, piece);
            cursor = i + nee_n;
            i = cursor;
        } else {
            i = i + 1;
        }
    }
    // Trailing remainder (respect limit too).
    if result.length < limit_u32 {
        let tail_len = hay_n - cursor;
        let tail_buf = alloc_n<char>((usize)(tail_len + 1));
        if tail_len > 0 {
            let src: char* = NULL;
            raw { src = &hay_d[cursor]; }
            mem_copy<char>(tail_buf, src, (usize)tail_len);
        }
        tail_buf[tail_len] = (char)0;
        let tail = ctx_intern_string_take(ctx, tail_buf, tail_len);
        array_set(result, result.length, tail);
    }
    return result_v;
}

// --- Higher-order array methods (Phase 3.5b) ----------------------
//
// These call a user-provided JS callback. We use ctx_push_temp_root to
// protect the result accumulator across the inner interpret() call,
// which may GC. The callback receives (element, index, array) — the
// standard JS prototype-method signature.

raw {
    extern ZjsValue zjs_call_value(ZjsContext* ctx, ZjsValue callee, ZjsValue* args, uint32_t argc);
}

fn host_array_map(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    // ECMA-262 §22.1.3.18 step 1: O = ToObject(this). Lift primitives
    // so `Array.prototype.map.call("abc", cb)` walks char indices via
    // the wrapper's String.prototype chain.
    if zjs_is_array(this_val) == 0 && zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    // Length via read_length_u32 — handles arrays (dense), objects
    // (property_get + ToLength), and also functions / regex / host
    // fns / wrapped primitives by walking the value's prototype.
    //
    // Spec order: a length-getter throw fires BEFORE the IsCallable
    // check on the callback, so 4-10-style tests see the original
    // Test262Error rather than a missing-callback TypeError.
    let len_atom_map = ctx_intern_atom(ctx, (char*)"length", 6);
    let len_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)len_atom_map));
    if ctx.pending_throw_active { return zjs_undefined(); }
    if zjs_is_object(len_v) != 0 || zjs_is_array(len_v) != 0 {
        len_v = zjs_to_primitive(ctx, len_v, false);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    let len_d = zjs_to_double(len_v);
    let is_nan_len: int = 0;
    raw { is_nan_len = isnan(len_d) ? 1 : 0; }
    if is_nan_len != 0 { len_d = 0.0; }
    if len_d < 0.0 { len_d = 0.0; }
    // ECMA-262 §10.4.2.4 / ArraySpeciesCreate: a Number length that
    // doesn't fit in a u32 (including +Infinity) throws RangeError
    // before any callback runs.
    if len_d > 4294967295.0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"Invalid array length", 20);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let len = (u32)len_d;
    if !require_callback_callable(ctx, args, argc) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };

    let result_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_array(result_v);

    let i: u32 = 0;
    while i < len {
        // Spec checks HasProperty before invoking callback — holes are
        // skipped entirely and the corresponding slot in the result
        // stays a hole.
        let present: bool = false;
        let src: ZjsValue = zjs_undefined();
        if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
            let arr = zjs_as_array(this_val);
            if i < arr.length && i < arr.cap {
                let raw_v = arr.elements[i];
                if zjs_is_deleted(raw_v) == 0 {
                    present = true;
                    src = raw_v;
                }
            }
        } else {
            // Generic-this (or array with expando bag — defineProperty
            // installed accessors that must fire). Spec HasProperty
            // gates the callback so missing indices stay holes in the
            // result, matching real arrays.
            if value_has_index(ctx, this_val, i) {
                present = true;
                src = property_get(ctx, this_val, zjs_int32((i32)i));
                if ctx.pending_throw_active { return result_v; }
            }
        }
        if present {
            let cb_args: ZjsValue[3];
            cb_args[0] = src;
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            let mapped: ZjsValue = zjs_undefined();
            raw { mapped = zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.pending_throw_active { return result_v; }
            array_set(result, i, mapped);
        }
        i = i + 1;
    }
    result.length = len;
    return result_v;
}

// Array.prototype.keys / values / entries — MVP returns a snapshot
// array suitable for our for-of model (which iterates by numeric
// index). Not a true Iterator object — `.next()` isn't supported, but
// `for (x of arr.keys())` works because for-of just walks length and
// indexes. Holes contribute null for entries / values too, matching
// ECMA-262 IteratorStep on a sparse array.
fn host_array_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let out_v = ctx_new_array(ctx, len);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        array_set(out, i, zjs_int32((i32)i));
        i = i + 1;
    }
    return out_v;
}

fn host_array_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let out_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        array_set(out, i, v);
        i = i + 1;
    }
    return out_v;
}

fn host_array_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let out_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        let pair_v = ctx_new_array(ctx, 2);
        let pair = zjs_as_array(pair_v);
        array_set(pair, 0, zjs_int32((i32)i));
        array_set(pair, 1, v);
        array_set(out, i, pair_v);
        i = i + 1;
    }
    return out_v;
}

fn host_array_join(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let sep_v: ZjsValue = ctx_intern_string(ctx, (char*)",", 1);
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        sep_v = args[0];
        if zjs_is_string(sep_v) == 0 { sep_v = zjs_to_string(ctx, sep_v); }
    }
    if len == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    // Build the joined string by repeated zjs_string_concat. O(n^2)
    // worst case — fine for the test262 inputs we care about.
    let result: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    // Defensive rooting: result + sep_v are held across many
    // allocations (string concat per element, possibly ToString of
    // each element). Push both; release after the loop.
    ctx_push_temp_root(ctx, sep_v);
    ctx_push_temp_root(ctx, result);
    defer ctx_pop_temp_root(ctx);
    defer ctx_pop_temp_root(ctx);
    let arr: ZjsArray* = NULL;
    if zjs_is_array(this_val) != 0 { arr = zjs_as_array(this_val); }
    let i: u32 = 0;
    while i < len {
        if i > 0 {
            result = zjs_string_concat(ctx, result, sep_v);
            ctx_replace_top_temp_root(ctx, result);
        }
        let elem: ZjsValue = zjs_undefined();
        // Spec: holes / undefined / null contribute "" to the join.
        // array_get already coerces holes to undefined; we then check
        // for both undefined and null to suppress the ToString call.
        if arr != NULL { elem = array_get(arr, i); }
        else if zjs_is_object(this_val) != 0 { elem = obj_get_indexed(ctx, zjs_as_object(this_val), i); }
        if zjs_is_undefined(elem) == 0 && zjs_is_null(elem) == 0 {
            if zjs_is_string(elem) == 0 { elem = zjs_to_string(ctx, elem); }
            // Protect `elem` across the concat allocation.
            ctx_push_temp_root(ctx, elem);
            result = zjs_string_concat(ctx, result, elem);
            ctx_pop_temp_root(ctx);
            ctx_replace_top_temp_root(ctx, result);
        }
        i = i + 1;
    }
    return result;
}

fn host_array_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len = read_length_u32(ctx, this_val);
    let start: i32 = 0;
    let end: i32 = (i32)len;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        start = (i32)zjs_to_double(args[0]);
        if start < 0 { start = (i32)len + start; if start < 0 { start = 0; } }
        if start > (i32)len { start = (i32)len; }
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        end = (i32)zjs_to_double(args[1]);
        if end < 0 { end = (i32)len + end; if end < 0 { end = 0; } }
        if end > (i32)len { end = (i32)len; }
    }
    if end < start { end = start; }
    let count = (u32)(end - start);
    let out_v = ctx_new_array(ctx, count);
    let out = zjs_as_array(out_v);
    let arr: ZjsArray* = NULL;
    if zjs_is_array(this_val) != 0 { arr = zjs_as_array(this_val); }
    let i: u32 = 0;
    while i < count {
        let src_idx = (u32)(start) + i;
        if arr != NULL {
            if src_idx < arr.length { out.elements[i] = arr.elements[src_idx]; }
        } else if zjs_is_object(this_val) != 0 {
            out.elements[i] = obj_get_indexed(ctx, zjs_as_object(this_val), src_idx);
        }
        i = i + 1;
    }
    out.length = count;
    return out_v;
}

fn host_array_concat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    // First pass: compute total length.
    let total: u32 = read_length_u32(ctx, this_val);
    let i: u32 = 0;
    while i < argc {
        let a = args[i];
        if zjs_is_array(a) != 0 { total = total + zjs_as_array(a).length; }
        else { total = total + 1; }
        i = i + 1;
    }
    let out_v = ctx_new_array(ctx, total);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let cursor: u32 = 0;
    // Copy this.
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let k: u32 = 0;
        while k < arr.length { out.elements[cursor + k] = arr.elements[k]; k = k + 1; }
        cursor = cursor + arr.length;
    } else if zjs_is_object(this_val) != 0 {
        let len = read_length_u32(ctx, this_val);
        let k: u32 = 0;
        while k < len {
            out.elements[cursor + k] = obj_get_indexed(ctx, zjs_as_object(this_val), k);
            k = k + 1;
        }
        cursor = cursor + len;
    }
    // Then each arg.
    i = 0;
    while i < argc {
        let a = args[i];
        if zjs_is_array(a) != 0 {
            let arr = zjs_as_array(a);
            let k: u32 = 0;
            while k < arr.length { out.elements[cursor + k] = arr.elements[k]; k = k + 1; }
            cursor = cursor + arr.length;
        } else {
            out.elements[cursor] = a;
            cursor = cursor + 1;
        }
        i = i + 1;
    }
    out.length = total;
    return out_v;
}

fn host_array_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) == 0 && zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    // Spec order: length first, then IsCallable.
    let _len_probe = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if !require_callback_callable(ctx, args, argc) { return zjs_undefined(); }
    let cb = args[0];
    // ECMA-262 §22.1.3.12: forEach(callbackfn, thisArg). Second arg
    // becomes `this` in the callback. Pass undefined when absent.
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };

    // Fast path: real array — direct .elements[] access. Skip holes
    // per spec (HasProperty check before the callback invocation).
    // Bail to the generic-property_get path when arr.props is set
    // so defineProperty-installed accessors fire correctly.
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        let len = arr.length;
        let i: u32 = 0;
        while i < len {
            let slot = arr.elements[i];
            if zjs_is_deleted(slot) != 0 {
                i = i + 1;
                continue;
            }
            let cb_args: ZjsValue[3];
            cb_args[0] = slot;
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { (void)zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.pending_throw_active { return zjs_undefined(); }
            i = i + 1;
        }
        return zjs_undefined();
    }

    // Generic-this path: read_length_u32 + property_get on the
    // receiver value. Handles function / host-fn / regex /
    // wrapper-primitive receivers uniformly (no ZjsObject cast).
    // Spec gates the callback on HasProperty so holes / missing
    // indices skip the call entirely.
    let len = read_length_u32(ctx, this_val);
    let i: u32 = 0;
    while i < len {
        if value_has_index(ctx, this_val, i) {
            let v = property_get(ctx, this_val, zjs_int32((i32)i));
            if ctx.pending_throw_active { return zjs_undefined(); }
            let cb_args: ZjsValue[3];
            cb_args[0] = v;
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { (void)zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        i = i + 1;
    }
    return zjs_undefined();
}

// --- JSON.stringify (Phase 3.5b) -----------------------------------
//
// Walks the value and appends JSON to a growable buffer. No `space`,
// no `replacer`, no `toJSON()`. Cycles overflow the stack — not a
// concern for the test workloads we care about now.

struct JsonBuf {
    data: char*;
    len:  u32;
    cap:  u32;
}

fn json_buf_grow(b: JsonBuf*, need: u32) -> void {
    if b.len + need <= b.cap { return; }
    let new_cap: u32 = if b.cap == 0 { 64 } else { b.cap * 2 };
    while new_cap < b.len + need { new_cap = new_cap * 2; }
    b.data = realloc_n<char>(b.data, (usize)b.cap, (usize)new_cap);
    b.cap = new_cap;
}

fn json_buf_putc(b: JsonBuf*, ch: char) -> void {
    json_buf_grow(b, 1);
    b.data[b.len] = ch;
    b.len = b.len + 1;
}

fn json_buf_puts(b: JsonBuf*, s: char*, n: u32) -> void {
    json_buf_grow(b, n);
    let dst: char* = NULL;
    raw { dst = b->data + b->len; }
    mem_copy<char>(dst, s, (usize)n);
    b.len = b.len + n;
}

fn json_emit_string(b: JsonBuf*, s: char*, n: u32) -> void {
    json_buf_putc(b, '"');
    let i: u32 = 0;
    while i < n {
        let c: char = s[i];
        let cu = (u8)c;
        if cu == 34 {           // "
            json_buf_putc(b, '\\'); json_buf_putc(b, '"');
        } else if cu == 92 {    // \
            json_buf_putc(b, '\\'); json_buf_putc(b, '\\');
        } else if cu == 8 {     // \b
            json_buf_putc(b, '\\'); json_buf_putc(b, 'b');
        } else if cu == 9 {     // \t
            json_buf_putc(b, '\\'); json_buf_putc(b, 't');
        } else if cu == 10 {    // \n
            json_buf_putc(b, '\\'); json_buf_putc(b, 'n');
        } else if cu == 12 {    // \f
            json_buf_putc(b, '\\'); json_buf_putc(b, 'f');
        } else if cu == 13 {    // \r
            json_buf_putc(b, '\\'); json_buf_putc(b, 'r');
        } else if cu < 32 {
            // \u00XX
            let hex_lookup: char* = NULL;
            raw { hex_lookup = (char*)"0123456789abcdef"; }
            json_buf_putc(b, '\\');
            json_buf_putc(b, 'u');
            json_buf_putc(b, '0');
            json_buf_putc(b, '0');
            json_buf_putc(b, hex_lookup[(cu >> 4) & 15]);
            json_buf_putc(b, hex_lookup[cu & 15]);
        } else {
            json_buf_putc(b, c);
        }
        i = i + 1;
    }
    json_buf_putc(b, '"');
}

// Bundles the replacer-related state so the recursive serializer
// doesn't drag five separate parameters. `replacer_fn` is a callable
// value (function / closure / host fn) or undefined. `replacer_arr`
// is a property-name allowlist (ZjsArray of strings) or undefined.
// `replacer_fn` and `replacer_arr` are mutually exclusive per spec.
struct JsonCtx {
    replacer_fn:  ZjsValue;
    replacer_arr: ZjsValue;     // (an array) or undefined
    indent_str:   char*;        // owned char buffer or NULL = no indent
    indent_len:   u32;          // strlen(indent_str)
    depth:        u32;          // current nesting level
    // Cycle-detection stack: pointers to objects / arrays currently
    // being serialized. ECMA-262 §25.5.2.4 step 1 throws TypeError if
    // a value is already on the stack. Capped at 32 levels — beyond
    // that we'd risk the host stack anyway.
    stack:        void*[32];
    stack_depth:  u32;
}

// Emit a newline and `depth` copies of the indent string. Used by
// pretty-printing only — when indent_len is 0 this is a no-op caller
// can skip.
fn json_emit_indent(b: JsonBuf*, jc: JsonCtx*) -> void {
    if jc.indent_len == 0 { return; }
    json_buf_putc(b, '\n');
    let i: u32 = 0;
    while i < jc.depth {
        json_buf_puts(b, jc.indent_str, jc.indent_len);
        i = i + 1;
    }
}

// Apply replacer fn to (key, value), returning the value to actually
// serialize. The fn is called with `this = holder` per spec, but we
// pass an empty object for that (no test we care about checks it
// specifically). Returns undefined if the replacer signals "omit".
fn json_apply_replacer(ctx: ZjsContext*, jc: JsonCtx*, key: ZjsValue, v: ZjsValue) -> ZjsValue {
    if zjs_is_undefined(jc.replacer_fn) != 0 { return v; }
    let cb_args: ZjsValue[2];
    cb_args[0] = key;
    cb_args[1] = v;
    let argp: ZjsValue* = NULL;
    raw { argp = &cb_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, jc->replacer_fn, zjs_undefined(), argp, 2); }
    return r;
}

// ECMA-262 §25.5.2.2 SerializeJSONProperty step 2: if value is an
// object (incl. arrays / wrappers) and has a callable .toJSON method,
// invoke it with the current key and use the return value in place
// of the original. Pure no-op for primitives.
fn json_apply_to_json(ctx: ZjsContext*, key: ZjsValue, v: ZjsValue) -> ZjsValue {
    if zjs_is_object(v) == 0 && zjs_is_array(v) == 0 { return v; }
    let to_json_atom = ctx_intern_atom(ctx, (char*)"toJSON", 6);
    let to_json_fn = property_get(ctx, v, zjs_cell_from_ptr((void*)to_json_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_callable = zjs_is_function(to_json_fn) != 0
                     || zjs_is_closure(to_json_fn) != 0
                     || zjs_is_host_function(to_json_fn) != 0;
    if !is_callable { return v; }
    let cb_args: ZjsValue[1];
    cb_args[0] = key;
    let argp: ZjsValue* = NULL;
    raw { argp = &cb_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, to_json_fn, v, argp, 1); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    return r;
}

// True if the property name is in the replacer-array allowlist.
// When no array filter is active, all keys pass.
fn json_key_in_filter(jc: JsonCtx*, name: ZjsString*) -> bool {
    if zjs_is_undefined(jc.replacer_arr) != 0 { return true; }
    if zjs_is_array(jc.replacer_arr) == 0 { return true; }
    let a = zjs_as_array(jc.replacer_arr);
    let i: u32 = 0;
    while i < a.length {
        let el = a.elements[i];
        if zjs_is_deleted(el) == 0 && zjs_is_string(el) != 0 {
            let s = zjs_as_string(el);
            if zjs_string_equals(s, name) != 0 { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn json_stringify_value(ctx: ZjsContext*, jc: JsonCtx*, b: JsonBuf*, v: ZjsValue) -> void {
    if zjs_is_undefined(v) != 0 {
        // JSON.stringify(undefined) is `undefined` in JS (not a string).
        // At the top level the caller handles this by returning undefined;
        // inside an array we'd emit null. For simplicity here, emit null.
        json_buf_puts(b, (char*)"null", 4);
        return;
    }
    if zjs_is_null(v) != 0 { json_buf_puts(b, (char*)"null", 4); return; }
    if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { json_buf_puts(b, (char*)"true", 4); }
        else                   { json_buf_puts(b, (char*)"false", 5); }
        return;
    }
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        let tmp: char[32];
        let written: int = 0;
        let tp: char* = NULL;
        raw { tp = &tmp[0]; written = snprintf(tp, 32, "%d", (int)n); }
        json_buf_puts(b, tp, (u32)written);
        return;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        // NaN / Infinity become null per ECMA-262.
        let is_finite: int = 0;
        raw { is_finite = isfinite(d) ? 1 : 0; }
        if is_finite == 0 { json_buf_puts(b, (char*)"null", 4); return; }
        // ECMA-262 §7.1.16.1 NumberToString: +0 and -0 both serialize
        // as "0". snprintf("%g", -0.0) emits "-0" which violates that.
        if d == 0.0 { json_buf_putc(b, '0'); return; }
        let tmp: char[32];
        let written: int = 0;
        let tp: char* = NULL;
        raw {
            tp = &tmp[0];
            // Shortest round-trip: try precisions until strtod recovers
            // the same double. Same algorithm as zjs_to_string.
            int found = 0;
            for (int prec = 1; prec <= 17 && !found; prec++) {
                int n = snprintf(tp, 32, "%.*g", prec, d);
                char* end = NULL;
                double rt = strtod(tp, &end);
                if (rt == d) { written = n; found = 1; }
            }
            if (!found) { written = snprintf(tp, 32, "%.17g", d); }
        }
        json_buf_puts(b, tp, (u32)written);
        return;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        json_emit_string(b, s.data, s.length);
        return;
    }
    // ECMA-262 §25.5.2.2 SerializeJSONProperty steps 4a-d:
    // unbox Boolean / Number / String / BigInt wrapper objects.
    // Detected via the `__zjs_primitive__` internal slot we stash in
    // `new Boolean(x)` / `new Number(x)` / `new String(x)`. Boolean
    // unboxes directly (the spec reads [[BooleanData]] without
    // observable side effects); Number / String route through the
    // user-overridable ToNumber / ToString so a custom valueOf or
    // toString on the wrapper fires.
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        let prim = object_get(o, wkey);
        if zjs_is_undefined(prim) == 0 {
            let coerced: ZjsValue = prim;
            if zjs_is_bool(prim) != 0 {
                // [[BooleanData]] — read directly.
                coerced = prim;
            } else if zjs_is_string(prim) != 0 {
                coerced = zjs_to_string(ctx, v);
                if ctx.pending_throw_active { return; }
            } else {
                // Number wrapper (or any other) — ToNumber fires valueOf.
                let prim2 = zjs_to_primitive(ctx, v, false);
                if ctx.pending_throw_active { return; }
                coerced = prim2;
            }
            json_stringify_value(ctx, jc, b, coerced);
            return;
        }
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        // Cycle check before descending. ECMA-262 §25.5.2 throws
        // TypeError on a structural cycle (including indirect ones).
        let aptr: void* = (void*)a;
        let s: u32 = 0;
        while s < jc.stack_depth {
            if jc.stack[s] == aptr {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Converting circular structure to JSON", 37);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return;
            }
            s = s + 1;
        }
        if jc.stack_depth >= 32 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"JSON.stringify nesting too deep", 31);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return;
        }
        jc.stack[jc.stack_depth] = aptr;
        jc.stack_depth = jc.stack_depth + 1;
        defer { jc.stack_depth = jc.stack_depth - 1; }
        json_buf_putc(b, '[');
        if a.length == 0 { json_buf_putc(b, ']'); return; }
        jc.depth = jc.depth + 1;
        let i: u32 = 0;
        while i < a.length {
            if i > 0 { json_buf_putc(b, ','); }
            else if jc.indent_len == 0 { /* compact: nothing */ }
            json_emit_indent(b, jc);
            // ECMA-262 SerializeJSONArray: holes emit "null", not "".
            let slot = a.elements[i];
            let elem_v: ZjsValue = if zjs_is_deleted(slot) != 0 { zjs_null() } else { slot };
            // toJSON + replacer key for an array element is index-as-string.
            let buf: char[16];
            let blen: int = 0;
            raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)i); }
            let bp: char* = NULL; raw { bp = &buf[0]; }
            let key_s = ctx_intern_string(ctx, bp, (u32)blen);
            elem_v = json_apply_to_json(ctx, key_s, elem_v);
            if ctx.pending_throw_active { return; }
            if zjs_is_undefined(jc.replacer_fn) == 0 {
                elem_v = json_apply_replacer(ctx, jc, key_s, elem_v);
                if ctx.pending_throw_active { return; }
            }
            if zjs_is_undefined(elem_v) != 0 { json_buf_puts(b, (char*)"null", 4); }
            else                              { json_stringify_value(ctx, jc, b, elem_v); }
            i = i + 1;
        }
        jc.depth = jc.depth - 1;
        json_emit_indent(b, jc);
        json_buf_putc(b, ']');
        return;
    }
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        // Cycle check before descending — mirrors the array branch.
        let optr: void* = (void*)o;
        let s2: u32 = 0;
        while s2 < jc.stack_depth {
            if jc.stack[s2] == optr {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Converting circular structure to JSON", 37);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return;
            }
            s2 = s2 + 1;
        }
        if jc.stack_depth >= 32 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"JSON.stringify nesting too deep", 31);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return;
        }
        jc.stack[jc.stack_depth] = optr;
        jc.stack_depth = jc.stack_depth + 1;
        defer { jc.stack_depth = jc.stack_depth - 1; }
        // Enumerate own property names in insertion order by walking
        // the hidden-class chain bottom-up (same approach as Object.keys).
        let count = o.cls.prop_count;
        json_buf_putc(b, '{');
        let saved_depth = jc.depth;
        jc.depth = jc.depth + 1;
        // First gather names by slot.
        let names: ZjsString*[64];          // MVP: 64-prop cap per object
        let names_ptr: ZjsString** = NULL;
        raw { names_ptr = &names[0]; }
        let limit: u32 = if count > 64 { 64 } else { count };
        let init_i: u32 = 0;
        while init_i < limit { names_ptr[init_i] = NULL; init_i = init_i + 1; }
        let cls = o.cls;
        while cls != NULL && cls.parent != NULL {
            let slot = cls.transition_slot;
            if slot < limit { names_ptr[slot] = cls.transition_name; }
            cls = cls.parent;
        }
        let i: u32 = 0;
        let emitted: u32 = 0;
        // If a replacer-array allowlist is active, the spec says to
        // iterate it in array order (not the object's own-key order)
        // and emit each whitelisted key that EXISTS on the object.
        // For the common test262 patterns this matters — `replacer:
        // ["b","a"]` should emit b before a, not the object's order.
        let use_filter_order = zjs_is_array(jc.replacer_arr) != 0;
        if use_filter_order {
            let fa = zjs_as_array(jc.replacer_arr);
            let fi: u32 = 0;
            while fi < fa.length {
                let kv = fa.elements[fi];
                if zjs_is_deleted(kv) == 0 && zjs_is_string(kv) != 0 {
                    let kname = zjs_as_string(kv);
                    // Find the slot for this name in the object.
                    let slot = class_find_slot(o.cls, kname);
                    if slot >= 0 {
                        let attrs = object_get_attrs(o, (u32)slot);
                        let raw_slot = o.slots[(u32)slot];
                        if (attrs & PROP_ENUMERABLE) != 0 && zjs_is_deleted(raw_slot) == 0 {
                            // Route through property_get so accessor
                            // getters fire (and their throws propagate).
                            let val = property_get(ctx, v, kv);
                            if ctx.pending_throw_active { return; }
                            val = json_apply_to_json(ctx, kv, val);
                            if ctx.pending_throw_active { return; }
                            let processed = json_apply_replacer(ctx, jc, kv, val);
                            if ctx.pending_throw_active { return; }
                            if zjs_is_undefined(processed) == 0
                               && !(zjs_cell_tag(processed) == TAG_FUNCTION
                                    || zjs_cell_tag(processed) == TAG_CLOSURE
                                    || zjs_cell_tag(processed) == TAG_HOST_FUNCTION) {
                                if emitted > 0 { json_buf_putc(b, ','); }
                                json_emit_indent(b, jc);
                                json_emit_string(b, kname.data, kname.length);
                                json_buf_putc(b, ':');
                                if jc.indent_len > 0 { json_buf_putc(b, ' '); }
                                json_stringify_value(ctx, jc, b, processed);
                                emitted = emitted + 1;
                            }
                        }
                    }
                }
                fi = fi + 1;
            }
        } else {
            while i < limit {
                let n = names_ptr[i];
                if n != NULL {
                    let attrs = object_get_attrs(o, i);
                    if (attrs & PROP_ENUMERABLE) != 0 && zjs_is_deleted(o.slots[i]) == 0 {
                        let key_v = zjs_cell_from_ptr((void*)n);
                        // property_get fires accessors and lets their
                        // throws propagate (value-object-abrupt-style).
                        let val = property_get(ctx, v, key_v);
                        if ctx.pending_throw_active { return; }
                        val = json_apply_to_json(ctx, key_v, val);
                        if ctx.pending_throw_active { return; }
                        let processed = json_apply_replacer(ctx, jc, key_v, val);
                        if ctx.pending_throw_active { return; }
                        // Skip undefined and callable values (spec).
                        let is_callable: bool =
                               zjs_is_function(processed) != 0
                            || zjs_is_closure(processed) != 0
                            || zjs_is_host_function(processed) != 0;
                        if zjs_is_undefined(processed) == 0 && !is_callable {
                            if emitted > 0 { json_buf_putc(b, ','); }
                            json_emit_indent(b, jc);
                            json_emit_string(b, n.data, n.length);
                            json_buf_putc(b, ':');
                            if jc.indent_len > 0 { json_buf_putc(b, ' '); }
                            json_stringify_value(ctx, jc, b, processed);
                            emitted = emitted + 1;
                        }
                    }
                }
                i = i + 1;
            }
        }
        jc.depth = saved_depth;
        if emitted > 0 { json_emit_indent(b, jc); }
        json_buf_putc(b, '}');
        return;
    }
    // RegExp: an Object with no own enumerable string properties.
    // Emit empty-object braces — matches what real engines do. (Use
    // putc'd braces; the Zen-c lexer mistakes `{` inside a (char*)
    // literal for an expression start.)
    if zjs_is_regexp(v) != 0 {
        json_buf_putc(b, '{');
        json_buf_putc(b, '}');
        return;
    }
    // Functions, closures, host functions, hidden classes — not
    // serializable. Real JSON.stringify returns undefined for these at
    // top level; inside containers it emits null. MVP: emit null.
    json_buf_puts(b, (char*)"null", 4);
}

fn host_json_stringify(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    // Parse the optional replacer arg (second). Either a callable or
    // an array of names; everything else is ignored. (The third
    // `space` argument is deferred — most tests passing it don't
    // observe formatting differences.)
    let jc: JsonCtx;
    jc.replacer_fn  = zjs_undefined();
    jc.replacer_arr = zjs_undefined();
    jc.indent_str   = NULL;
    jc.indent_len   = 0;
    jc.depth        = 0;
    jc.stack_depth  = 0;
    // Parse the optional `space` arg (third). Number → that many
    // spaces (clamped to 10). String → take up to first 10 chars
    // verbatim. Anything else is ignored.
    if argc >= 3 {
        let sp = args[2];
        // ECMA-262 §25.5.2.1 step 7: if space is a Number wrapper, use
        // ToNumber; if a String wrapper, use ToString. Detect wrapper
        // type via our __zjs_primitive__ slot — Number wrapper holds a
        // number, String wrapper holds a string.
        if zjs_is_object(sp) != 0 {
            let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
            let prim = object_get(zjs_as_object(sp), wkey);
            if zjs_is_string(prim) != 0 {
                // String wrapper → ToString fires toString.
                sp = zjs_to_string(ctx, sp);
                if ctx.pending_throw_active { return zjs_undefined(); }
            } else if zjs_is_number(prim) != 0 {
                // Number wrapper → ToNumber fires valueOf.
                let prim2 = zjs_to_primitive(ctx, sp, false);
                if ctx.pending_throw_active { return zjs_undefined(); }
                sp = prim2;
            }
        }
        if zjs_is_int32(sp) != 0 || zjs_is_double(sp) != 0 {
            let n = zjs_to_double(sp);
            let nclamp: u32 = 0;
            if n >= 1.0 {
                if n > 10.0 { nclamp = 10; } else { nclamp = (u32)n; }
            }
            if nclamp > 0 {
                let buf = alloc_n<char>((usize)(nclamp + 1));
                let bi: u32 = 0;
                while bi < nclamp { buf[bi] = ' '; bi = bi + 1; }
                buf[nclamp] = (char)0;
                jc.indent_str = buf;
                jc.indent_len = nclamp;
            }
        } else if zjs_is_string(sp) != 0 {
            let s = zjs_as_string(sp);
            let take: u32 = if s.length > 10 { 10 } else { s.length };
            if take > 0 {
                let buf = alloc_n<char>((usize)(take + 1));
                let bi: u32 = 0;
                while bi < take { buf[bi] = s.data[bi]; bi = bi + 1; }
                buf[take] = (char)0;
                jc.indent_str = buf;
                jc.indent_len = take;
            }
        }
    }
    if argc >= 2 {
        let r = args[1];
        if zjs_is_function(r) != 0 || zjs_is_closure(r) != 0 || zjs_is_host_function(r) != 0 {
            jc.replacer_fn = r;
        } else if zjs_is_array(r) != 0 {
            // ECMA-262 §25.5.2.1 step 4: build PropertyList from the
            // replacer array. Each item must be a String or a Number
            // (or a wrapper of either); convert Numbers via ToString;
            // skip duplicates and unsupported entries. We allocate a
            // fresh dedup'd array and use that as the filter to keep
            // the inner loop in json_stringify_value clean.
            let src = zjs_as_array(r);
            let out_v = ctx_new_array(ctx, 0);
            let out = zjs_as_array(out_v);
            let i: u32 = 0;
            while i < src.length {
                let item = src.elements[i];
                let key_str_v: ZjsValue = zjs_undefined();
                if zjs_is_string(item) != 0 {
                    key_str_v = item;
                } else if zjs_is_number(item) != 0 {
                    key_str_v = zjs_to_string(ctx, item);
                } else if zjs_is_object(item) != 0 {
                    // ECMA-262 §25.5.2.1 step 4.b.i-iv: a Number /
                    // String wrapper in the replacer array is
                    // unboxed and stringified. Detect by the
                    // __zjs_primitive__ slot we use for wrappers.
                    let wo = zjs_as_object(item);
                    let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
                    let prim = object_get(wo, wkey);
                    if zjs_is_string(prim) != 0 {
                        key_str_v = zjs_to_string(ctx, item);
                        if ctx.pending_throw_active { return zjs_undefined(); }
                    } else if zjs_is_number(prim) != 0 {
                        key_str_v = zjs_to_string(ctx, item);
                        if ctx.pending_throw_active { return zjs_undefined(); }
                    }
                }
                // Skip undefined / unsupported types (objects without
                // a String/Number internal slot).
                if zjs_is_string(key_str_v) != 0 {
                    let kname = zjs_as_string(key_str_v);
                    let seen: bool = false;
                    let j: u32 = 0;
                    while j < out.length {
                        let pj = out.elements[j];
                        if zjs_is_string(pj) != 0 {
                            if zjs_string_equals(zjs_as_string(pj), kname) != 0 {
                                seen = true; j = out.length;
                            } else { j = j + 1; }
                        } else { j = j + 1; }
                    }
                    if !seen {
                        array_set(out, out.length, key_str_v);
                    }
                }
                i = i + 1;
            }
            jc.replacer_arr = out_v;
        }
    }
    // Apply the top-level replacer call. Spec wraps the input in a
    // holder `{"": value}` and calls replacer("", value) before
    // serializing — same effect as letting json_apply_replacer fire
    // once with key="".
    let key0 = ctx_intern_string(ctx, (char*)"", 0);
    // Per spec, toJSON fires BEFORE the replacer.
    v = json_apply_to_json(ctx, key0, v);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if zjs_is_undefined(jc.replacer_fn) == 0 {
        v = json_apply_replacer(ctx, &jc, key0, v);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    // Top-level undefined / functions return undefined (per spec).
    if zjs_is_undefined(v) != 0 { return zjs_undefined(); }
    let t = zjs_cell_tag(v);
    if t == TAG_FUNCTION || t == TAG_CLOSURE || t == TAG_HOST_FUNCTION {
        return zjs_undefined();
    }
    let b: JsonBuf;
    b.data = NULL; b.len = 0; b.cap = 0;
    json_stringify_value(ctx, &jc, &b, v);
    if jc.indent_str != NULL { dealloc(jc.indent_str); }
    // Null-terminate for safety; ctx_intern_string_take only reads `len`.
    json_buf_putc(&b, '\0');
    b.len = b.len - 1;
    return ctx_intern_string_take(ctx, b.data, b.len);
}

// --- JSON.parse (Phase 3.5b) ---------------------------------------

struct JsonParser {
    src:  char*;
    len:  u32;
    pos:  u32;
    fail: bool;
}

fn jp_peek(p: JsonParser*) -> char {
    if p.pos >= p.len { return (char)0; }
    return p.src[p.pos];
}

fn jp_skip_ws(p: JsonParser*) -> void {
    while p.pos < p.len {
        let c = p.src[p.pos];
        let cu = (u8)c;
        if cu == 32 || cu == 9 || cu == 10 || cu == 13 { p.pos = p.pos + 1; }
        else { return; }
    }
}

fn jp_match_word(p: JsonParser*, word: char*, n: u32) -> bool {
    if p.pos + n > p.len { return false; }
    let src = p.src;
    let off = p.pos;
    let eq: int = 0;
    raw { eq = (memcmp(src + off, word, n) == 0) ? 1 : 0; }
    if eq == 0 { return false; }
    p.pos = p.pos + n;
    return true;
}

fn jp_parse_value(ctx: ZjsContext*, p: JsonParser*) -> ZjsValue {
    jp_skip_ws(p);
    if p.pos >= p.len { p.fail = true; return zjs_undefined(); }
    let c = p.src[p.pos];
    let cu = (u8)c;

    if cu == 110 {              // 'n' — null
        if jp_match_word(p, (char*)"null", 4) { return zjs_null(); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 116 {              // 't' — true
        if jp_match_word(p, (char*)"true", 4) { return zjs_bool(1); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 102 {              // 'f' — false
        if jp_match_word(p, (char*)"false", 5) { return zjs_bool(0); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 34 {               // '"' — string
        p.pos = p.pos + 1;
        let buf_cap: u32 = 16;
        let buf = alloc_n<char>((usize)buf_cap);
        let blen: u32 = 0;
        let bcap = buf_cap;
        let ok = true;
        let closed = false;
        while p.pos < p.len {
            let ch = p.src[p.pos];
            let chu = (u8)ch;
            if chu == 34 { p.pos = p.pos + 1; closed = true; break; }
            // ECMA-262 §25.5.1 (JSON.parse grammar): JSONStringCharacter
            // disallows raw U+0000 through U+001F. They must be \uXXXX
            // escaped (and for the C0 controls below   even that
            // is required — most-strict reading). Reject the unescaped
            // form.
            if chu < 0x20 { ok = false; break; }
            if chu == 92 {      // '\'
                p.pos = p.pos + 1;
                if p.pos >= p.len { ok = false; break; }
                let esc = p.src[p.pos];
                let eu = (u8)esc;
                let out: u8 = 0;
                let used_u: bool = false;
                if eu == 34 { out = 34; }
                else if eu == 92 { out = 92; }
                else if eu == 47 { out = 47; }
                else if eu == 98 { out = 8; }      // \b
                else if eu == 102 { out = 12; }    // \f
                else if eu == 110 { out = 10; }    // \n
                else if eu == 114 { out = 13; }    // \r
                else if eu == 116 { out = 9; }     // \t
                else if eu == 117 {                // \uXXXX
                    used_u = true;
                    if p.pos + 4 >= p.len { ok = false; break; }
                    p.pos = p.pos + 1;
                    let cp: u32 = 0;
                    let hi: u32 = 0;
                    while hi < 4 {
                        let hc = p.src[p.pos + hi];
                        let hu = (u8)hc;
                        let digit: u32 = 0;
                        if hu >= 48 && hu <= 57 { digit = (u32)(hu - 48); }
                        else if hu >= 97 && hu <= 102 { digit = (u32)(hu - 97) + 10; }
                        else if hu >= 65 && hu <= 70 { digit = (u32)(hu - 65) + 10; }
                        else { ok = false; }
                        cp = (cp << 4) | digit;
                        hi = hi + 1;
                    }
                    if !ok { break; }
                    p.pos = p.pos + 3;
                    // MVP: encode as UTF-8 (BMP only, no surrogate joining).
                    if cp < 128 {
                        if blen + 1 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                        buf[blen] = (char)cp;
                        blen = blen + 1;
                    } else if cp < 2048 {
                        if blen + 2 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                        buf[blen]     = (char)(192 | (cp >> 6));
                        buf[blen + 1] = (char)(128 | (cp & 63));
                        blen = blen + 2;
                    } else {
                        if blen + 3 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                        buf[blen]     = (char)(224 | (cp >> 12));
                        buf[blen + 1] = (char)(128 | ((cp >> 6) & 63));
                        buf[blen + 2] = (char)(128 | (cp & 63));
                        blen = blen + 3;
                    }
                } else {
                    ok = false; break;
                }
                if !used_u {
                    if blen + 1 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                    buf[blen] = (char)out;
                    blen = blen + 1;
                }
                p.pos = p.pos + 1;
            } else {
                if blen + 1 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                buf[blen] = ch;
                blen = blen + 1;
                p.pos = p.pos + 1;
            }
        }
        // EOF before closing quote also fails: the spec requires a
        // matching `"` to end the string.
        if !ok || !closed { dealloc(buf); p.fail = true; return zjs_undefined(); }
        // Ensure null terminator slot.
        if blen + 1 > bcap { let oldc = bcap; bcap = blen + 1; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
        buf[blen] = '\0';
        return ctx_intern_string_take(ctx, buf, blen);
    }
    if cu == 91 {               // '[' — array
        p.pos = p.pos + 1;
        let arr_v = ctx_new_array(ctx, 0);
        ctx_push_temp_root(ctx, arr_v);
        let arr = zjs_as_array(arr_v);
        jp_skip_ws(p);
        if jp_peek(p) == ']' { p.pos = p.pos + 1; ctx_pop_temp_root(ctx); return arr_v; }
        while true {
            jp_skip_ws(p);
            let elem = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            array_set(arr, arr.length, elem);
            jp_skip_ws(p);
            let cc = jp_peek(p);
            if cc == ',' { p.pos = p.pos + 1; }
            else if cc == ']' { p.pos = p.pos + 1; break; }
            else { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
        }
        ctx_pop_temp_root(ctx);
        return arr_v;
    }
    if cu == 123 {              // '{' — object
        p.pos = p.pos + 1;
        let obj_v = ctx_new_object(ctx);
        ctx_push_temp_root(ctx, obj_v);
        let obj = zjs_as_object(obj_v);
        jp_skip_ws(p);
        if jp_peek(p) == '}' { p.pos = p.pos + 1; ctx_pop_temp_root(ctx); return obj_v; }
        while true {
            jp_skip_ws(p);
            // Key must be string.
            if jp_peek(p) != '"' { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
            let k_v = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            jp_skip_ws(p);
            if jp_peek(p) != ':' { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
            p.pos = p.pos + 1;
            jp_skip_ws(p);
            let val = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            // Use atom-interned key for property name (matches the
            // hidden-class convention).
            let ks = zjs_as_string(k_v);
            let key_atom = ctx_intern_atom(ctx, ks.data, ks.length);
            object_set(ctx, obj, key_atom, val);
            jp_skip_ws(p);
            let cc = jp_peek(p);
            if cc == ',' { p.pos = p.pos + 1; }
            else if cc == '}' { p.pos = p.pos + 1; break; }
            else { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
        }
        ctx_pop_temp_root(ctx);
        return obj_v;
    }
    // Number — optional '-', integer part, optional fraction, optional exponent.
    let is_negative = false;
    if cu == 45 { is_negative = true; p.pos = p.pos + 1; }
    let num_start = p.pos;
    let has_dot = false;
    let has_exp = false;
    while p.pos < p.len {
        let nc = p.src[p.pos];
        let nu = (u8)nc;
        if nu >= 48 && nu <= 57 { p.pos = p.pos + 1; }
        else if nu == 46 && !has_dot { has_dot = true; p.pos = p.pos + 1; }
        else if (nu == 101 || nu == 69) && !has_exp {
            has_exp = true; p.pos = p.pos + 1;
            if p.pos < p.len {
                let sn = (u8)p.src[p.pos];
                if sn == 43 || sn == 45 { p.pos = p.pos + 1; }
            }
        }
        else { break; }
    }
    if p.pos == num_start { p.fail = true; return zjs_undefined(); }
    // strtod the slice via a stack-buffered C string.
    let slice_len = p.pos - num_start;
    let parsed: f64 = 0.0;
    let src = p.src;
    let off = num_start;
    let sl = slice_len;
    raw {
        char buf[64];
        size_t n = sl < 63 ? sl : 63;
        memcpy(buf, src + off, n);
        buf[n] = '\0';
        parsed = strtod(buf, NULL);
    }
    if is_negative { parsed = -parsed; }
    // ECMA-262 §25.5.1 step 9: "-0" parses to -0 (preserves sign).
    // int32 representation can't carry the negative-zero bit, so we
    // route it through double when the input was a literal `-0`.
    if is_negative && parsed == 0.0 { return zjs_double(-0.0); }
    // Prefer int32 representation if it fits.
    let as_int = (i32)parsed;
    if (f64)as_int == parsed { return zjs_int32(as_int); }
    return zjs_double(parsed);
}

fn host_json_parse(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // `JSON.parse()` with no args parses the literal string "undefined"
    // which is invalid JSON and throws — covered by the fail path below.
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_string(v) == 0 {
        v = zjs_to_string(ctx, v);
        // If toString/valueOf threw, propagate that — don't mask it
        // with our own "Invalid JSON" SyntaxError.
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    let s = zjs_as_string(v);
    let p: JsonParser;
    p.src = s.data; p.len = s.length; p.pos = 0; p.fail = false;
    let result = jp_parse_value(ctx, &p);
    if !p.fail {
        jp_skip_ws(&p);
        if p.pos != s.length { p.fail = true; }
    }
    if p.fail {
        let err = build_syntax_error(ctx, (char*)"Invalid JSON");
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return result;
}

// =====================================================================
// RegExp runtime (Phase 3.11)
//
// Compilation is delegated to TRE (Zen-c std/regex pulls it in via
// static link). We hold pattern + flags + a lazily-compiled regex_t
// pointer. The JS regex syntax is translated to POSIX ERE before
// handing to tre_regcomp — common escapes (\d \w \s and negations,
// \b) are expanded; lookahead / named groups / non-greedy quantifiers
// are not supported and would error at compile time.
// =====================================================================

fn regexp_free_void(p: void*) -> void {
    let r: ZjsRegExp* = NULL;
    raw { r = (ZjsRegExp*)p; }
    if r == NULL { return; }
    if r.preg != NULL {
        raw {
            tre_regfree((regex_t*)(r->preg));
            free(r->preg);
        }
        r.preg = NULL;
    }
    dealloc(r);
}

// Translate one ZjsString of JS regex source into a heap-allocated
// NUL-terminated POSIX ERE pattern. Caller owns the returned buffer
// (dealloc<char>). Only the common escapes get rewritten; unsupported
// constructs are passed through and let TRE error on them.
fn regex_translate_to_posix(src: ZjsString*) -> char* {
    let n = src.length;
    let data = src.data;
    // Worst case: every char of \w expands to [A-Za-z0-9_] (11 chars
    // from 2). Allocate 8x as a safe upper bound; we won't exceed it.
    let cap: u32 = if n < 8 { 64 } else { n * 8 + 16 };
    let buf = alloc_n<char>((usize)cap);
    let out: u32 = 0;
    let i: u32 = 0;
    while i < n {
        let c = data[i];
        if c == (char)'\\' && i + 1 < n {
            let nx = data[i + 1];
            // Character-class shortcuts. Replace with POSIX ranges.
            if nx == (char)'d' {
                raw { memcpy(buf + out, "[0-9]", 5); }
                out = out + 5; i = i + 2; continue;
            }
            if nx == (char)'D' {
                raw { memcpy(buf + out, "[^0-9]", 6); }
                out = out + 6; i = i + 2; continue;
            }
            if nx == (char)'w' {
                raw { memcpy(buf + out, "[A-Za-z0-9_]", 12); }
                out = out + 12; i = i + 2; continue;
            }
            if nx == (char)'W' {
                raw { memcpy(buf + out, "[^A-Za-z0-9_]", 13); }
                out = out + 13; i = i + 2; continue;
            }
            if nx == (char)'s' {
                // ECMA-262 WhiteSpace + LineTerminator. POSIX char
                // classes don't interpret \t/\n/\r/\f/\v inside [...] —
                // we must emit the actual control bytes here.
                raw { memcpy(buf + out, "[ \t\n\r\f\v]", 8); }
                out = out + 8; i = i + 2; continue;
            }
            if nx == (char)'S' {
                raw { memcpy(buf + out, "[^ \t\n\r\f\v]", 9); }
                out = out + 9; i = i + 2; continue;
            }
            // \uXXXX — four-hex Unicode escape. ECMA-262 regex grammar
            // allows it both inside and outside character classes. POSIX
            // / TRE doesn't understand `\u`, so emit the actual byte
            // when the code point fits in 7 bits; otherwise pass
            // through (best effort — the regex engine will likely
            // mismatch but at least won't segfault).
            if nx == (char)'u' && i + 5 < n {
                let v0: int = 0; let v1: int = 0; let v2: int = 0; let v3: int = 0;
                let ok: int = 0;
                let h0 = data[i + 2]; let h1 = data[i + 3];
                let h2 = data[i + 4]; let h3 = data[i + 5];
                raw {
                    #define ZJS_HEX(out, c) do { \
                        if (c >= '0' && c <= '9') out = c - '0'; \
                        else if (c >= 'a' && c <= 'f') out = c - 'a' + 10; \
                        else if (c >= 'A' && c <= 'F') out = c - 'A' + 10; \
                        else out = -1; \
                    } while (0)
                    ZJS_HEX(v0, h0); ZJS_HEX(v1, h1);
                    ZJS_HEX(v2, h2); ZJS_HEX(v3, h3);
                    #undef ZJS_HEX
                    ok = (v0 >= 0 && v1 >= 0 && v2 >= 0 && v3 >= 0) ? 1 : 0;
                }
                if ok != 0 {
                    let cp: int = v0 * 4096 + v1 * 256 + v2 * 16 + v3;
                    if cp < 128 {
                        buf[out] = (char)cp;
                        out = out + 1; i = i + 6; continue;
                    }
                    buf[out] = (char)'?';
                    out = out + 1; i = i + 6; continue;
                }
            }
            // \xHH — two-hex escape. Same handling.
            if nx == (char)'x' && i + 3 < n {
                let v0: int = 0; let v1: int = 0;
                let ok: int = 0;
                let h0 = data[i + 2]; let h1 = data[i + 3];
                raw {
                    #define ZJS_HEX(out, c) do { \
                        if (c >= '0' && c <= '9') out = c - '0'; \
                        else if (c >= 'a' && c <= 'f') out = c - 'a' + 10; \
                        else if (c >= 'A' && c <= 'F') out = c - 'A' + 10; \
                        else out = -1; \
                    } while (0)
                    ZJS_HEX(v0, h0); ZJS_HEX(v1, h1);
                    #undef ZJS_HEX
                    ok = (v0 >= 0 && v1 >= 0) ? 1 : 0;
                }
                if ok != 0 {
                    let cp: int = v0 * 16 + v1;
                    if cp < 128 {
                        buf[out] = (char)cp;
                        out = out + 1; i = i + 4; continue;
                    }
                    buf[out] = (char)'?';
                    out = out + 1; i = i + 4; continue;
                }
            }
            // `\b` (word boundary) is `[[:<:]]|[[:>:]]` in TRE — but the
            // alternation only makes sense inside a group. Cheaper +
            // correct enough for most tests: emit `\b` and rely on TRE
            // accepting it as a literal-backslash-b pattern, which
            // matches the same in POSIX-mode strings. (Real word-boundary
            // semantics deferred.)
            // Default: pass the escape through unchanged.
            buf[out] = c;
            buf[out + 1] = nx;
            out = out + 2;
            i = i + 2;
            continue;
        }
        buf[out] = c;
        out = out + 1;
        i = i + 1;
    }
    buf[out] = (char)0;
    return buf;
}

// Compile-on-demand. Returns true if the regex_t is ready to use;
// false if compilation failed (caller falls back to "no match").
fn regex_ensure_compiled(r: ZjsRegExp*) -> bool {
    if r.compiled { return r.preg != NULL; }
    r.compiled = true;
    if r.source == NULL { return false; }
    let posix_pat = regex_translate_to_posix(r.source);
    let cflags: int = 1;     // REG_EXTENDED — JS regex is always extended-style
    if (r.flags & REGEX_FLAG_IGNORE_CASE) != 0 { cflags = cflags | 2; }       // REG_ICASE
    if (r.flags & REGEX_FLAG_MULTILINE)   != 0 { cflags = cflags | 4; }       // REG_NEWLINE
    let preg: void* = NULL;
    let status: int = 0;
    raw {
        preg = malloc(1024);
        if (preg) status = tre_regcomp((regex_t*)preg, posix_pat, cflags);
        else status = -1;
    }
    dealloc(posix_pat);
    if status != 0 {
        raw { if (preg) free(preg); }
        r.preg = NULL;
        return false;
    }
    r.preg = preg;
    return true;
}

// new RegExp(pattern, flags) — constructs a fresh RegExp from
// string arguments. If `pattern` is itself a RegExp, clone its
// source + (overridden) flags.
fn host_regexp_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let pattern_v: ZjsValue = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"", 0) };
    let flags_v:   ZjsValue = if argc >= 2 { args[1] } else { ctx_intern_string(ctx, (char*)"", 0) };
    if zjs_is_regexp(pattern_v) != 0 {
        let src = zjs_as_regexp(pattern_v);
        pattern_v = if src.source != NULL { zjs_cell_from_ptr((void*)src.source) } else { ctx_intern_string(ctx, (char*)"", 0) };
        if argc < 2 {
            flags_v = if src.flags_str != NULL { zjs_cell_from_ptr((void*)src.flags_str) } else { ctx_intern_string(ctx, (char*)"", 0) };
        }
    } else if zjs_is_string(pattern_v) == 0 {
        pattern_v = zjs_to_string(ctx, pattern_v);
    }
    if zjs_is_string(flags_v) == 0 { flags_v = zjs_to_string(ctx, flags_v); }
    return ctx_new_regexp(ctx, pattern_v, flags_v);
}

// RegExp.prototype.exec(str): coerce `str`, run the regex, build a
// match array shaped per ECMA-262 §22.2.7.2:
//   result[0]       = full match
//   result[1..]     = capture groups (or undefined if not matched)
//   result.index    = position of full match in the input
//   result.input    = the original string
//   result.groups   = undefined (we don't have named groups yet)
// Returns null on no match. Honors lastIndex advance for g/y.
fn host_regexp_exec(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_regexp(this_val) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"RegExp.prototype.exec called on non-RegExp", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let r = zjs_as_regexp(this_val);
    if !regex_ensure_compiled(r) { return zjs_null(); }
    let arg_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    if zjs_is_string(arg_v) == 0 { arg_v = zjs_to_string(ctx, arg_v); }
    let s = zjs_as_string(arg_v);
    let stateful = (r.flags & (REGEX_FLAG_GLOBAL | REGEX_FLAG_STICKY)) != 0;
    let start_idx: u32 = if stateful { r.last_index } else { 0 };
    if start_idx > s.length {
        if stateful { r.last_index = 0; }
        return zjs_null();
    }
    let preg = r.preg;
    let sdata = s.data;
    // Read re_nsub off the compiled preg so we know how big the
    // pmatch buffer needs to be (full match + N captures).
    let nsub: u32 = 0;
    raw { nsub = (uint32_t)((regex_t*)preg)->re_nsub; }
    let total_groups = nsub + 1;
    let pmatch_buf = alloc_n<ZRegMatch>((usize)total_groups);
    let rc: int = -1;
    raw {
        rc = tre_regexec((regex_t*)preg, sdata + start_idx, total_groups, (regmatch_t*)pmatch_buf, 0);
    }
    if rc != 0 {
        dealloc(pmatch_buf);
        if stateful { r.last_index = 0; }
        return zjs_null();
    }
    let mstart_off = pmatch_buf[0].rm_so;
    let mend_off   = pmatch_buf[0].rm_eo;
    if (r.flags & REGEX_FLAG_STICKY) != 0 && mstart_off != 0 {
        dealloc(pmatch_buf);
        r.last_index = 0;
        return zjs_null();
    }
    let abs_mstart = start_idx + (u32)mstart_off;
    let abs_mend   = start_idx + (u32)mend_off;
    if stateful { r.last_index = abs_mend; }

    // Build the result array: [fullMatch, group1, group2, ...].
    let result_v = ctx_new_array(ctx, total_groups);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_array(result_v);
    let i: u32 = 0;
    while i < total_groups {
        let gs = pmatch_buf[i].rm_so;
        let ge = pmatch_buf[i].rm_eo;
        if gs < 0 {
            // Group didn't participate in the match.
            result.elements[i] = zjs_undefined();
        } else {
            let gabs_s = start_idx + (u32)gs;
            let gabs_e = start_idx + (u32)ge;
            let glen = gabs_e - gabs_s;
            let slice = ctx_intern_string(ctx, sdata + gabs_s, glen);
            result.elements[i] = slice;
        }
        i = i + 1;
    }
    result.length = total_groups;
    dealloc(pmatch_buf);

    // .index, .input, .groups via the expando bag.
    if result.props == NULL {
        let pv = ctx_new_object(ctx);
        result.props = zjs_as_object(pv);
    }
    object_set(ctx, result.props, ctx_intern_atom(ctx, (char*)"index", 5), zjs_int32((i32)abs_mstart));
    object_set(ctx, result.props, ctx_intern_atom(ctx, (char*)"input", 5), arg_v);
    object_set(ctx, result.props, ctx_intern_atom(ctx, (char*)"groups", 6), zjs_undefined());
    return result_v;
}

// RegExp.prototype.test(str): coerce `str`, run the regex, advance
// .lastIndex for `g`/`y` patterns, return bool.
fn host_regexp_test(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_regexp(this_val) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"RegExp.prototype.test called on non-RegExp", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let r = zjs_as_regexp(this_val);
    if !regex_ensure_compiled(r) { return zjs_bool(0); }
    // Coerce arg to string.
    let arg_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    if zjs_is_string(arg_v) == 0 { arg_v = zjs_to_string(ctx, arg_v); }
    let s = zjs_as_string(arg_v);
    let stateful = (r.flags & (REGEX_FLAG_GLOBAL | REGEX_FLAG_STICKY)) != 0;
    let start_idx: u32 = if stateful { r.last_index } else { 0 };
    if start_idx > s.length {
        if stateful { r.last_index = 0; }
        return zjs_bool(0);
    }
    // tre_regexec on the offset slice. Single capture-group buffer
    // tells us where the match lands; we ignore the captures here
    // (.exec / .match handle them).
    let preg = r.preg;
    let sdata = s.data;
    let pmatch: ZRegMatch[1];
    let rc: int = -1;
    raw {
        rc = tre_regexec((regex_t*)preg, sdata + start_idx, 1, (regmatch_t*)pmatch, 0);
    }
    if rc != 0 {
        if stateful { r.last_index = 0; }
        return zjs_bool(0);
    }
    let mstart = pmatch[0].rm_so;
    let mend   = pmatch[0].rm_eo;
    if (r.flags & REGEX_FLAG_STICKY) != 0 && mstart != 0 {
        // sticky requires the match begin exactly at lastIndex.
        r.last_index = 0;
        return zjs_bool(0);
    }
    if stateful {
        r.last_index = start_idx + (u32)mend;
    }
    return zjs_bool(1);
}

fn ctx_new_regexp(ctx: ZjsContext*, pattern_v: ZjsValue, flags_v: ZjsValue) -> ZjsValue {
    let r = zjs_regexp_new();
    r.source    = if zjs_is_string(pattern_v) != 0 { zjs_as_string(pattern_v) } else { NULL };
    r.flags_str = if zjs_is_string(flags_v)   != 0 { zjs_as_string(flags_v)   } else { NULL };
    // Parse the flag letters into a bitset.
    if r.flags_str != NULL {
        let fd = r.flags_str.data;
        let fn_len = r.flags_str.length;
        let i: u32 = 0;
        while i < fn_len {
            let c = fd[i];
            if c == (char)'g' { r.flags = r.flags | REGEX_FLAG_GLOBAL; }
            else if c == (char)'i' { r.flags = r.flags | REGEX_FLAG_IGNORE_CASE; }
            else if c == (char)'m' { r.flags = r.flags | REGEX_FLAG_MULTILINE; }
            else if c == (char)'s' { r.flags = r.flags | REGEX_FLAG_DOTALL; }
            else if c == (char)'u' { r.flags = r.flags | REGEX_FLAG_UNICODE; }
            else if c == (char)'y' { r.flags = r.flags | REGEX_FLAG_STICKY; }
            else if c == (char)'d' { r.flags = r.flags | REGEX_FLAG_HAS_INDICES; }
            i = i + 1;
        }
    }
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

// =====================================================================
// Promise runtime (Phase 3.10)
//
// ECMA-262 §27.2. Minimal implementation:
//   - Promise constructor with executor function
//   - Promise.resolve / Promise.reject statics
//   - .then(onFulfilled, onRejected) / .catch / .finally
//   - Microtask queue drained at the end of each zjs_eval entry
//   - Thenable assimilation when handler returns a Promise
//
// Tests-262 still skips a bunch of Promise.* statics (.all, .race,
// .allSettled, .any) and the Symbol.toStringTag tag — those are
// follow-ups.
// =====================================================================

fn promise_attach_reaction(ctx: ZjsContext*, p: ZjsPromise*,
                           on_fulfilled: ZjsValue, on_rejected: ZjsValue,
                           result_promise: ZjsValue) -> void {
    if p.reaction_count + 3 > p.reaction_cap {
        let new_cap: u32 = if p.reaction_cap == 0 { 6 } else { p.reaction_cap * 2 };
        p.reactions = realloc_n<ZjsValue>(p.reactions, (usize)p.reaction_cap, (usize)new_cap);
        p.reaction_cap = new_cap;
    }
    p.reactions[p.reaction_count] = on_fulfilled;
    p.reactions[p.reaction_count + 1] = on_rejected;
    p.reactions[p.reaction_count + 2] = result_promise;
    p.reaction_count = p.reaction_count + 3;
}

fn microtask_enqueue(ctx: ZjsContext*,
                     handler: ZjsValue, arg: ZjsValue,
                     result_promise: ZjsValue, is_fulfilled: bool) -> void {
    let slots_needed = ctx.microtask_count * 4 + 4;
    if slots_needed > ctx.microtask_cap {
        let new_cap: u32 = if ctx.microtask_cap == 0 { 16 } else { ctx.microtask_cap * 2 };
        while new_cap < slots_needed { new_cap = new_cap * 2; }
        ctx.microtask_queue = realloc_n<ZjsValue>(ctx.microtask_queue, (usize)ctx.microtask_cap, (usize)new_cap);
        ctx.microtask_cap = new_cap;
    }
    let base = ctx.microtask_count * 4;
    ctx.microtask_queue[base]     = handler;
    ctx.microtask_queue[base + 1] = arg;
    ctx.microtask_queue[base + 2] = result_promise;
    ctx.microtask_queue[base + 3] = zjs_bool(if is_fulfilled { 1 } else { 0 });
    ctx.microtask_count = ctx.microtask_count + 1;
}

fn promise_settle(ctx: ZjsContext*, pv: ZjsValue, value: ZjsValue, fulfilled: bool) -> void {
    if zjs_is_promise(pv) == 0 { return; }
    let p = zjs_as_promise(pv);
    if p.state != PROMISE_PENDING { return; }
    p.state = if fulfilled { PROMISE_FULFILLED } else { PROMISE_REJECTED };
    p.value = value;
    // Fire all attached reactions. Each entry is 3 slots
    // (onFulfilled, onRejected, resultPromise).
    let i: u32 = 0;
    while i < p.reaction_count {
        let on_f = p.reactions[i];
        let on_r = p.reactions[i + 1];
        let rp   = p.reactions[i + 2];
        let handler = if fulfilled { on_f } else { on_r };
        microtask_enqueue(ctx, handler, value, rp, fulfilled);
        i = i + 3;
    }
    // Drop the reactions buffer — they've all been queued.
    p.reaction_count = 0;
}

// ECMA-262 ResolvePromise semantics: if `value` is itself a promise,
// adopt its eventual state (attach a then-style hook); otherwise
// settle directly with the value.
fn promise_resolve_with(ctx: ZjsContext*, pv: ZjsValue, value: ZjsValue) -> void {
    if zjs_is_promise(value) != 0 {
        // Identity self-reference is a TypeError per spec.
        if zjs_cell_as_ptr(value) == zjs_cell_as_ptr(pv) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Chaining cycle detected", 23);
            promise_settle(ctx, pv, err, false);
            return;
        }
        let inner = zjs_as_promise(value);
        if inner.state == PROMISE_FULFILLED {
            promise_settle(ctx, pv, inner.value, true);
        } else if inner.state == PROMISE_REJECTED {
            promise_settle(ctx, pv, inner.value, false);
        } else {
            // Pending — attach an adopt-reaction that settles pv when inner settles.
            // We piggy-back on the standard reaction shape: a "passthrough"
            // microtask whose handler is undefined and whose result_promise
            // is pv. Both fulfilled and rejected paths feed back into pv.
            promise_attach_reaction(ctx, inner, zjs_undefined(), zjs_undefined(), pv);
        }
        return;
    }
    promise_settle(ctx, pv, value, true);
}

// Drain the microtask queue. Called at the end of zjs_eval (after the
// main script has run). Microtasks may enqueue more microtasks; keep
// draining until empty. Bounded by a safety limit to prevent runaway
// loops in misbehaving programs.
def MICROTASK_DRAIN_LIMIT: u32 = 1000000;

fn drain_microtasks(ctx: ZjsContext*) -> void {
    let safety: u32 = 0;
    while ctx.microtask_count > 0 && safety < MICROTASK_DRAIN_LIMIT {
        // Pop the first microtask: copy fields into locals, then shift.
        // Could be O(n^2) for many microtasks; acceptable for now.
        let handler = ctx.microtask_queue[0];
        let arg     = ctx.microtask_queue[1];
        let rp      = ctx.microtask_queue[2];
        let is_full = zjs_as_bool(ctx.microtask_queue[3]) != 0;
        // Shift remaining.
        let n = ctx.microtask_count - 1;
        let i: u32 = 0;
        while i < n * 4 {
            ctx.microtask_queue[i] = ctx.microtask_queue[i + 4];
            i = i + 1;
        }
        ctx.microtask_count = n;

        let callable: bool = zjs_is_function(handler) != 0
            || zjs_is_closure(handler) != 0
            || zjs_is_host_function(handler) != 0;
        if !callable {
            // Passthrough: propagate value/reason to result_promise.
            if zjs_is_promise(rp) != 0 {
                if is_full { promise_resolve_with(ctx, rp, arg); }
                else       { promise_settle(ctx, rp, arg, false); }
            }
        } else {
            // Call handler(arg). On success, resolve rp with the
            // return value (which itself may be a thenable → adoption).
            // On throw, reject rp with the thrown value.
            let arg_buf: ZjsValue[1];
            arg_buf[0] = arg;
            let argp: ZjsValue* = NULL;
            raw { argp = &arg_buf[0]; }
            // zjs_call_value_with_this signals a JS-side throw via
            // pending_throw_active, not had_error. Save/restore the
            // pending-throw channel so an in-flight throw from the
            // surrounding interpret() (if any) survives this nested
            // synchronous call and isn't lost.
            let saved_pt = ctx.pending_throw_active;
            let saved_pv = ctx.pending_throw_value;
            ctx.pending_throw_active = false;
            ctx.pending_throw_value = zjs_undefined();
            let r: ZjsValue = zjs_undefined();
            raw { r = zjs_call_value_with_this(ctx, handler, zjs_undefined(), argp, 1); }
            if ctx.pending_throw_active {
                let thrown = ctx.pending_throw_value;
                ctx.pending_throw_active = saved_pt;
                ctx.pending_throw_value = saved_pv;
                if zjs_is_promise(rp) != 0 {
                    promise_settle(ctx, rp, thrown, false);
                }
            } else {
                ctx.pending_throw_active = saved_pt;
                ctx.pending_throw_value = saved_pv;
                if zjs_is_promise(rp) != 0 {
                    promise_resolve_with(ctx, rp, r);
                }
            }
        }
        safety = safety + 1;
    }
}

// --- Host fns: Promise.resolve / Promise.reject helpers --------------

// Resume handlers wired into a pending awaited Promise's reactions.
// Both read the ZjsAsyncCont via .bound and re-enter the interpreter
// at the saved ip with the resolved value in the await's dst register
// (fulfilled path) or the rejection threaded through the throw channel
// (rejected path).
// Generator iterator methods. Each reads the iterator from
// ctx.host_this and routes through interpret_resume_generator. The
// return value of iter.next() is the body's iter-result (built by
// Op::Yield or Op::Return).
fn host_generator_next(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_generator(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Generator.prototype.next called on non-generator", 49);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let g = zjs_as_generator(this_v);
    if g.state == GEN_COMPLETED {
        let obj_v = ctx_new_object(ctx);
        let obj = zjs_as_object(obj_v);
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"value", 5), zjs_undefined());
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"done", 4), zjs_bool(1));
        return obj_v;
    }
    if g.state == GEN_RUNNING {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Generator is already running", 28);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let r: ZjsValue = zjs_undefined();
    let threw: bool = false;
    raw {
        extern InterpretResult interpret_resume_generator(ZjsContext* ctx, ZjsGenerator* gen, ZjsValue resume_value, bool is_throw);
        InterpretResult ir = interpret_resume_generator(ctx, g, arg, 0);
        r = ir.value;
        threw = ir.is_throw;
    }
    if threw {
        // Body bubbled an uncaught exception. Mark completed and
        // re-throw to the JS caller.
        g.state = GEN_COMPLETED;
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = r;
        return zjs_undefined();
    }
    return r;
}

// `iter[Symbol.iterator]()` returns the iterator itself. Spec sugar
// for generators; we expose it under both the spec key (Symbol-
// derived) and a string-key stand-in until real Symbols land.
fn host_generator_self_iter(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return ctx.host_this;
}

// Generator.prototype.return(value) — terminates the iterator and
// returns { value, done: true }. Doesn't resume the body (a real
// spec impl would feed it through try/finally; for now we just
// complete).
fn host_generator_return(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_generator(this_v) == 0 {
        return zjs_undefined();
    }
    let g = zjs_as_generator(this_v);
    g.state = GEN_COMPLETED;
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"value", 5), value);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"done", 4), zjs_bool(1));
    return obj_v;
}

fn host_generator_throw(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_generator(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Generator.prototype.throw called on non-generator", 50);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let g = zjs_as_generator(this_v);
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    if g.state == GEN_COMPLETED || g.state == GEN_INITIAL {
        // No frame to throw into — propagate immediately. Initial-
        // state .throw also marks the iterator completed.
        g.state = GEN_COMPLETED;
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = reason;
        return zjs_undefined();
    }
    let r: ZjsValue = zjs_undefined();
    let threw: bool = false;
    raw {
        extern InterpretResult interpret_resume_generator(ZjsContext* ctx, ZjsGenerator* gen, ZjsValue resume_value, bool is_throw);
        InterpretResult ir = interpret_resume_generator(ctx, g, reason, 1);
        r = ir.value;
        threw = ir.is_throw;
    }
    if threw {
        g.state = GEN_COMPLETED;
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = r;
        return zjs_undefined();
    }
    return r;
}

// =====================================================================
// Map host functions (2026-05-16). Storage = linear ZjsMapEntry array
// with tombstones; lookups are O(n). Spec semantics: insertion-order
// iteration, SameValueZero key comparison, .size excludes tombstones.
// =====================================================================

fn map_find_slot(m: ZjsMap*, key: ZjsValue) -> i32 {
    let i: u32 = 0;
    while i < m.count {
        let e = m.entries + i;
        if !e.deleted && zjs_same_value_zero(e.key, key) != 0 {
            return (i32)i;
        }
        i = i + 1;
    }
    return -1;
}

fn map_ensure_cap(m: ZjsMap*, want: u32) -> void {
    if want <= m.cap { return; }
    let new_cap: u32 = if m.cap == 0 { 8 } else { m.cap * 2 };
    while new_cap < want { new_cap = new_cap * 2; }
    m.entries = realloc_n<ZjsMapEntry>(m.entries, (usize)m.cap, (usize)new_cap);
    m.cap = new_cap;
}

// ECMA-262 CanonicalizeKeyedCollectionKey — folds -0 to +0 so the
// observable key in Map/Set ops (forEach, iterator value, callback
// args, getOrInsertComputed's callback) matches what the spec says.
// Anything else is returned unchanged.
fn canonicalize_collection_key(key: ZjsValue) -> ZjsValue {
    if zjs_is_double(key) != 0 {
        let d = zjs_as_double(key);
        let is_neg_zero: int = 0;
        raw { is_neg_zero = (d == 0.0 && signbit(d)) ? 1 : 0; }
        if is_neg_zero != 0 { return zjs_double(0.0); }
    }
    return key;
}

fn map_set_entry(m: ZjsMap*, key: ZjsValue, val: ZjsValue) -> void {
    let ck = canonicalize_collection_key(key);
    let slot = map_find_slot(m, ck);
    if slot >= 0 {
        m.entries[(u32)slot].value = val;
        return;
    }
    map_ensure_cap(m, m.count + 1);
    m.entries[m.count] = ZjsMapEntry{ key: ck, value: val, deleted: false };
    m.count = m.count + 1;
    m.size = m.size + 1;
}

fn map_require_this(ctx: ZjsContext*) -> ZjsMap* {
    let this_v = ctx.host_this;
    if zjs_is_map(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Map method called on non-Map", 28);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return NULL;
    }
    return zjs_as_map(this_v);
}

fn host_map_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = zjs_map_new();
    ctx_register_cell(ctx, (void*)m);
    let m_v = zjs_cell_from_ptr((void*)m);
    // Optional iterable arg — each entry must itself be an iterable of
    // [key, value].
    if argc > 0 && zjs_is_undefined(args[0]) == 0 && zjs_is_null(args[0]) == 0 {
        let iter = iter_get(ctx, args[0]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        ctx_push_temp_root(ctx, m_v);
        let safety: u32 = 0;
        while safety < 100000000 {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            if step.done { break; }
            // Pull [key, value] off step.value via property indexing.
            // Spec requires Object coercion; we use property_get which
            // handles arrays directly.
            let k = property_get(ctx, step.value, zjs_int32(0));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            let v = property_get(ctx, step.value, zjs_int32(1));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            map_set_entry(m, k, v);
            safety = safety + 1;
        }
        ctx_pop_temp_root(ctx);
    }
    return m_v;
}

fn host_map_get(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_undefined(); }
    let slot = map_find_slot(m, args[0]);
    if slot < 0 { return zjs_undefined(); }
    return m.entries[(u32)slot].value;
}

fn host_map_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    let k = if argc > 0 { args[0] } else { zjs_undefined() };
    let v = if argc > 1 { args[1] } else { zjs_undefined() };
    map_set_entry(m, k, v);
    return ctx.host_this;
}

fn host_map_has(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = map_find_slot(m, args[0]);
    if slot < 0 { return zjs_bool(false); }
    return zjs_bool(true);
}

fn host_map_delete(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = map_find_slot(m, args[0]);
    if slot < 0 { return zjs_bool(false); }
    m.entries[(u32)slot].deleted = true;
    m.entries[(u32)slot].key = zjs_undefined();
    m.entries[(u32)slot].value = zjs_undefined();
    m.size = m.size - 1;
    return zjs_bool(true);
}

// ES2026 Map.prototype.getOrInsert(key, defaultValue) — returns the
// existing value if `key` is already in the map; otherwise inserts
// (key, defaultValue) and returns defaultValue.
fn host_map_get_or_insert(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    let k = if argc > 0 { args[0] } else { zjs_undefined() };
    let v = if argc > 1 { args[1] } else { zjs_undefined() };
    let slot = map_find_slot(m, k);
    if slot >= 0 { return m.entries[(u32)slot].value; }
    map_set_entry(m, k, v);
    return v;
}

// ES2026 Map.prototype.getOrInsertComputed(key, callbackfn) — returns
// the existing value if present; otherwise calls callbackfn(key),
// stores (key, result), and returns result. Spec requires the
// callback to be callable.
fn host_map_get_or_insert_computed(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    let k = if argc > 0 { args[0] } else { zjs_undefined() };
    let cb = if argc > 1 { args[1] } else { zjs_undefined() };
    let cb_callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb) != 0
        || zjs_is_host_function(cb) != 0;
    if !cb_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Map.prototype.getOrInsertComputed callbackfn is not callable", 60);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let slot = map_find_slot(m, k);
    if slot >= 0 { return m.entries[(u32)slot].value; }
    let cb_args: ZjsValue[1];
    cb_args[0] = canonicalize_collection_key(k);
    let cap: ZjsValue* = NULL; raw { cap = &cb_args[0]; }
    let result = zjs_call_value(ctx, cb, cap, 1);
    if ctx.pending_throw_active { return zjs_undefined(); }
    // Spec quirk: re-check after the callback in case it mutated the
    // map for this key. Insert only if still absent; otherwise return
    // whatever's now stored.
    let slot2 = map_find_slot(m, k);
    if slot2 >= 0 { return m.entries[(u32)slot2].value; }
    map_set_entry(m, k, result);
    return result;
}

fn host_map_clear(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    m.count = 0;
    m.size = 0;
    return zjs_undefined();
}

fn host_map_size_getter(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    return zjs_int32((i32)m.size);
}

fn host_map_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    if argc == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Map.prototype.forEach requires a callback", 41);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let cb = args[0];
    let this_arg = if argc > 1 { args[1] } else { zjs_undefined() };
    let nullp: ZjsValue* = NULL;
    let map_v = ctx.host_this;
    let i: u32 = 0;
    while i < m.count {
        let e = m.entries + i;
        if !e.deleted {
            // Build a small arg buffer: (value, key, map).
            let local_args: ZjsValue[3];
            local_args[0] = e.value;
            local_args[1] = e.key;
            local_args[2] = map_v;
            let lp: ZjsValue* = NULL;
            raw { lp = &local_args[0]; }
            zjs_call_value_with_this(ctx, cb, this_arg, lp, 3);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        i = i + 1;
    }
    return zjs_undefined();
}

// Build an iterator over the map's live entries. `kind`:
//   0 = keys, 1 = values, 2 = entries [k,v]
fn build_map_iterator(ctx: ZjsContext*, m_v: ZjsValue, kind: u32) -> ZjsValue {
    let it = ctx_new_object(ctx);
    let o = zjs_as_object(it);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_map", 4), m_v);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_i", 2),   zjs_int32(0));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_kind", 5), zjs_int32((i32)kind));
    let next_ptr: void* = NULL; raw { next_ptr = (void*)host_map_iter_next; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"next", 4),
               ctx_make_host_function(ctx, (char*)"next", next_ptr));
    let self_ptr: void* = NULL; raw { self_ptr = (void*)host_self_iter; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"@@iterator", 10),
               ctx_make_host_function(ctx, (char*)"[Symbol.iterator]", self_ptr));
    return it;
}

fn host_map_iter_next(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    if zjs_is_object(recv) == 0 {
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let m_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_map", 4)));
    let i_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_i",   2)));
    let k_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_kind",5)));
    if zjs_is_map(m_v) == 0 { return build_iter_result_helper(ctx, zjs_undefined(), true); }
    let m = zjs_as_map(m_v);
    let i: u32 = if zjs_is_int32(i_v) != 0 { (u32)zjs_as_int32(i_v) } else { 0 };
    let kind: u32 = if zjs_is_int32(k_v) != 0 { (u32)zjs_as_int32(k_v) } else { 2 };
    while i < m.count {
        let e = m.entries + i;
        i = i + 1;
        if e.deleted { continue; }
        object_set(ctx, zjs_as_object(recv),
                   ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)i));
        if kind == 0 { return build_iter_result_helper(ctx, e.key, false); }
        if kind == 1 { return build_iter_result_helper(ctx, e.value, false); }
        // entries — pair as a fresh array.
        let pair = ctx_new_array(ctx, 2);
        let pa = zjs_as_array(pair);
        pa.elements[0] = e.key;
        pa.elements[1] = e.value;
        pa.length = 2;
        return build_iter_result_helper(ctx, pair, false);
    }
    object_set(ctx, zjs_as_object(recv),
               ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)m.count));
    return build_iter_result_helper(ctx, zjs_undefined(), true);
}

fn host_map_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if map_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_map_iterator(ctx, ctx.host_this, 0);
}

fn host_map_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if map_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_map_iterator(ctx, ctx.host_this, 1);
}

fn host_map_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if map_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_map_iterator(ctx, ctx.host_this, 2);
}

// =====================================================================
// Set host functions (2026-05-16). Same storage shape minus the value.
// =====================================================================

fn set_find_slot(s: ZjsSet*, v: ZjsValue) -> i32 {
    let i: u32 = 0;
    while i < s.count {
        let e = s.entries + i;
        if !e.deleted && zjs_same_value_zero(e.value, v) != 0 {
            return (i32)i;
        }
        i = i + 1;
    }
    return -1;
}

fn set_ensure_cap(s: ZjsSet*, want: u32) -> void {
    if want <= s.cap { return; }
    let new_cap: u32 = if s.cap == 0 { 8 } else { s.cap * 2 };
    while new_cap < want { new_cap = new_cap * 2; }
    s.entries = realloc_n<ZjsSetEntry>(s.entries, (usize)s.cap, (usize)new_cap);
    s.cap = new_cap;
}

fn set_add_entry(s: ZjsSet*, v: ZjsValue) -> void {
    let cv = canonicalize_collection_key(v);
    let slot = set_find_slot(s, cv);
    if slot >= 0 { return; }
    set_ensure_cap(s, s.count + 1);
    s.entries[s.count] = ZjsSetEntry{ value: cv, deleted: false };
    s.count = s.count + 1;
    s.size = s.size + 1;
}

fn set_require_this(ctx: ZjsContext*) -> ZjsSet* {
    let this_v = ctx.host_this;
    if zjs_is_set(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set method called on non-Set", 28);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return NULL;
    }
    return zjs_as_set(this_v);
}

fn host_set_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = zjs_set_new();
    ctx_register_cell(ctx, (void*)s);
    let s_v = zjs_cell_from_ptr((void*)s);
    if argc > 0 && zjs_is_undefined(args[0]) == 0 && zjs_is_null(args[0]) == 0 {
        let iter = iter_get(ctx, args[0]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        ctx_push_temp_root(ctx, s_v);
        let safety: u32 = 0;
        while safety < 100000000 {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            if step.done { break; }
            set_add_entry(s, step.value);
            safety = safety + 1;
        }
        ctx_pop_temp_root(ctx);
    }
    return s_v;
}

fn host_set_add(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    let v = if argc > 0 { args[0] } else { zjs_undefined() };
    set_add_entry(s, v);
    return ctx.host_this;
}

fn host_set_has(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = set_find_slot(s, args[0]);
    if slot < 0 { return zjs_bool(false); }
    return zjs_bool(true);
}

fn host_set_delete(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = set_find_slot(s, args[0]);
    if slot < 0 { return zjs_bool(false); }
    s.entries[(u32)slot].deleted = true;
    s.entries[(u32)slot].value = zjs_undefined();
    s.size = s.size - 1;
    return zjs_bool(true);
}

fn host_set_clear(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    s.count = 0;
    s.size = 0;
    return zjs_undefined();
}

fn host_set_size_getter(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    return zjs_int32((i32)s.size);
}

fn host_set_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    if argc == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.forEach requires a callback", 41);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let cb = args[0];
    let this_arg = if argc > 1 { args[1] } else { zjs_undefined() };
    let set_v = ctx.host_this;
    let i: u32 = 0;
    while i < s.count {
        let e = s.entries + i;
        if !e.deleted {
            let local_args: ZjsValue[3];
            // Spec: forEach passes (value, value, set) — value duplicated
            // to match Map's (value, key, map) shape.
            local_args[0] = e.value;
            local_args[1] = e.value;
            local_args[2] = set_v;
            let lp: ZjsValue* = NULL;
            raw { lp = &local_args[0]; }
            zjs_call_value_with_this(ctx, cb, this_arg, lp, 3);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        i = i + 1;
    }
    return zjs_undefined();
}

fn build_set_iterator(ctx: ZjsContext*, s_v: ZjsValue, kind: u32) -> ZjsValue {
    let it = ctx_new_object(ctx);
    let o = zjs_as_object(it);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_set", 4), s_v);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_i", 2),   zjs_int32(0));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_kind", 5), zjs_int32((i32)kind));
    let next_ptr: void* = NULL; raw { next_ptr = (void*)host_set_iter_next; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"next", 4),
               ctx_make_host_function(ctx, (char*)"next", next_ptr));
    let self_ptr: void* = NULL; raw { self_ptr = (void*)host_self_iter; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"@@iterator", 10),
               ctx_make_host_function(ctx, (char*)"[Symbol.iterator]", self_ptr));
    return it;
}

fn host_set_iter_next(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    if zjs_is_object(recv) == 0 {
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let s_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_set", 4)));
    let i_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_i",   2)));
    let k_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_kind",5)));
    if zjs_is_set(s_v) == 0 { return build_iter_result_helper(ctx, zjs_undefined(), true); }
    let s = zjs_as_set(s_v);
    let i: u32 = if zjs_is_int32(i_v) != 0 { (u32)zjs_as_int32(i_v) } else { 0 };
    let kind: u32 = if zjs_is_int32(k_v) != 0 { (u32)zjs_as_int32(k_v) } else { 1 };
    while i < s.count {
        let e = s.entries + i;
        i = i + 1;
        if e.deleted { continue; }
        object_set(ctx, zjs_as_object(recv),
                   ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)i));
        if kind == 2 {
            // entries — [value, value] pair (Set has no separate key).
            let pair = ctx_new_array(ctx, 2);
            let pa = zjs_as_array(pair);
            pa.elements[0] = e.value;
            pa.elements[1] = e.value;
            pa.length = 2;
            return build_iter_result_helper(ctx, pair, false);
        }
        return build_iter_result_helper(ctx, e.value, false);
    }
    object_set(ctx, zjs_as_object(recv),
               ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)s.count));
    return build_iter_result_helper(ctx, zjs_undefined(), true);
}

fn host_set_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if set_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_set_iterator(ctx, ctx.host_this, 0);
}

fn host_set_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if set_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_set_iterator(ctx, ctx.host_this, 1);
}

fn host_set_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if set_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_set_iterator(ctx, ctx.host_this, 2);
}

// =====================================================================
// ES2024 group-by + ES2025 Set composition (2026-05-18).
// =====================================================================

// Shared groupBy core: walks the iterable, applies callback(value, k),
// and routes each (key, value) pair through `bucket_set`.
// `bucket_storage` is the wrapper-specific accumulator (a ZjsMap* or
// a ZjsObject* — passed as opaque void* so this helper doesn't know
// which is which). `bucket_set` is the per-pair hook.
//
// Returns false on error (pending throw left active). True on success.
fn group_by_walk(ctx: ZjsContext*, items: ZjsValue, cb: ZjsValue,
                 bucket: void*,
                 bucket_set_into_map: bool) -> bool {
    let iter = iter_get(ctx, items);
    if ctx.pending_throw_active { return false; }
    let k: u32 = 0;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return false; }
        if step.done { break; }
        let cb_args: ZjsValue[2];
        cb_args[0] = step.value;
        cb_args[1] = zjs_int32((i32)k);
        let cap: ZjsValue* = NULL; raw { cap = &cb_args[0]; }
        let key_v: ZjsValue = zjs_undefined();
        raw { key_v = zjs_call_value_with_this(ctx, cb, zjs_undefined(), cap, 2); }
        if ctx.pending_throw_active { return false; }
        if bucket_set_into_map {
            // Map.groupBy — SameValueZero on the raw key, value is an
            // array of items grouped under it.
            let m: ZjsMap* = NULL;
            raw { m = (ZjsMap*)bucket; }
            let slot = map_find_slot(m, key_v);
            if slot < 0 {
                let arr_v = ctx_new_array(ctx, 0);
                array_set(zjs_as_array(arr_v), 0, step.value);
                map_set_entry(m, key_v, arr_v);
            } else {
                let arr_v = m.entries[(u32)slot].value;
                if zjs_is_array(arr_v) != 0 {
                    let a = zjs_as_array(arr_v);
                    array_set(a, a.length, step.value);
                }
            }
        } else {
            // Object.groupBy — key is ToPropertyKey'd (string or symbol).
            let o: ZjsObject* = NULL;
            raw { o = (ZjsObject*)bucket; }
            // For our purposes, stringify if not already a string.
            let key_s: ZjsValue =
                if zjs_is_string(key_v) != 0 { key_v }
                else { zjs_to_string(ctx, key_v) };
            if ctx.pending_throw_active { return false; }
            let key_atom = zjs_as_string(key_s);
            // Does the object already have a bucket under this name?
            let slot = class_find_slot(o.cls, key_atom);
            if slot < 0 || zjs_is_deleted(o.slots[(u32)slot]) != 0 {
                let arr_v = ctx_new_array(ctx, 0);
                array_set(zjs_as_array(arr_v), 0, step.value);
                object_set(ctx, o, key_atom, arr_v);
            } else {
                let arr_v = o.slots[(u32)slot];
                if zjs_is_array(arr_v) != 0 {
                    let a = zjs_as_array(arr_v);
                    array_set(a, a.length, step.value);
                }
            }
        }
        k = k + 1;
    }
    return true;
}

fn host_map_group_by(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let items = if argc > 0 { args[0] } else { zjs_undefined() };
    let cb    = if argc > 1 { args[1] } else { zjs_undefined() };
    let cb_callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb) != 0
        || zjs_is_host_function(cb) != 0;
    if !cb_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Map.groupBy callbackfn is not callable", 38);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let m = zjs_map_new();
    ctx_register_cell(ctx, (void*)m);
    let bucket: void* = NULL; raw { bucket = (void*)m; }
    if !group_by_walk(ctx, items, cb, bucket, true) { return zjs_undefined(); }
    return zjs_cell_from_ptr((void*)m);
}

fn host_object_group_by(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let items = if argc > 0 { args[0] } else { zjs_undefined() };
    let cb    = if argc > 1 { args[1] } else { zjs_undefined() };
    let cb_callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb) != 0
        || zjs_is_host_function(cb) != 0;
    if !cb_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object.groupBy callbackfn is not callable", 41);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let o_v = ctx_new_object(ctx);
    let o = zjs_as_object(o_v);
    // Spec: the returned object has a null prototype. We don't have
    // an easy "null proto" mode (objects come from ctx_new_object
    // wired to object_proto); set it explicitly.
    o.proto = NULL;
    let bucket: void* = NULL; raw { bucket = (void*)o; }
    if !group_by_walk(ctx, items, cb, bucket, false) { return zjs_undefined(); }
    return o_v;
}

// --- Set composition (2026-05-25 / ES2025) ---------------------------

// Internal: produce a stream of values from a "set-like" — a real Set
// (fast path: walk internal entries) or any object with a callable
// keys() method returning an iterator. `callback_fp` is a raw C
// function pointer (`bool (*)(void*, ZjsValue)`) passed as `void*`
// since Zen-c's function-type-as-param doesn't accept plain C
// pointers. Returning `true` from the callback aborts iteration
// early. Returns false on error (pending throw active); true on
// normal completion / early abort.
fn iterate_set_like(ctx: ZjsContext*, other: ZjsValue,
                    callback_fp: void*, state: void*) -> bool {
    if zjs_is_set(other) != 0 {
        let s = zjs_as_set(other);
        let i: u32 = 0;
        while i < s.count {
            let e = s.entries + i;
            if !e.deleted {
                let stop: bool = false;
                raw {
                    typedef bool (*SetCb)(void*, ZjsValue);
                    SetCb fp = (SetCb)callback_fp;
                    stop = fp(state, e->value);
                }
                if stop { return true; }
            }
            i = i + 1;
        }
        return true;
    }
    // Generic set-like: read keys, iterate via the protocol.
    let keys_atom = ctx_intern_atom(ctx, (char*)"keys", 4);
    let keys_fn = property_get(ctx, other, zjs_cell_from_ptr((void*)keys_atom));
    if ctx.pending_throw_active { return false; }
    let nullp: ZjsValue* = NULL;
    let iter: ZjsValue = zjs_undefined();
    raw { iter = zjs_call_value_with_this(ctx, keys_fn, other, nullp, 0); }
    if ctx.pending_throw_active { return false; }
    if !value_is_js_object(iter) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"set-like.keys() did not return an object", 41);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return false;
    }
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return false; }
        if step.done { break; }
        let stop: bool = false;
        raw {
            typedef bool (*SetCb)(void*, ZjsValue);
            SetCb fp = (SetCb)callback_fp;
            stop = fp(state, step.value);
        }
        if stop { return true; }
    }
    return true;
}

// `has` probe on a set-like: delegates to internal slot for real Sets
// or calls .has(value) for generic set-likes.
fn set_like_has(ctx: ZjsContext*, other: ZjsValue, v: ZjsValue) -> bool {
    if zjs_is_set(other) != 0 {
        let s = zjs_as_set(other);
        return set_find_slot(s, v) >= 0;
    }
    let has_atom = ctx_intern_atom(ctx, (char*)"has", 3);
    let has_fn = property_get(ctx, other, zjs_cell_from_ptr((void*)has_atom));
    if ctx.pending_throw_active { return false; }
    let nullp: ZjsValue* = NULL;
    let arg_buf: ZjsValue[1]; arg_buf[0] = v;
    let argp: ZjsValue* = NULL; raw { argp = &arg_buf[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, has_fn, other, argp, 1); }
    if ctx.pending_throw_active { return false; }
    return zjs_to_bool_coerce(r) != 0;
}

// Build a fresh empty Set wrapper (registered for GC, returned by
// reference for use as `out` in the helpers below).
fn make_new_set(ctx: ZjsContext*) -> ZjsSet* {
    let s = zjs_set_new();
    ctx_register_cell(ctx, (void*)s);
    return s;
}

// Callback states + free-fn callbacks for iterate_set_like (Zen-c
// doesn't allow nested fn definitions, so these live at file scope).
struct SetUnionState   { out: ZjsSet*; }
struct SetSymDiffState { self_s: ZjsSet*; out: ZjsSet*; }
struct SetSupOrDjState { self_s: ZjsSet*; flag: bool; }

fn set_union_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetUnionState* = NULL; raw { st = (SetUnionState*)state; }
    set_add_entry(st.out, v);
    return false;
}

fn set_symdiff_other_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetSymDiffState* = NULL; raw { st = (SetSymDiffState*)state; }
    if set_find_slot(st.self_s, v) < 0 { set_add_entry(st.out, v); }
    return false;
}

fn set_superset_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetSupOrDjState* = NULL; raw { st = (SetSupOrDjState*)state; }
    if set_find_slot(st.self_s, v) < 0 {
        st.flag = false;
        return true;
    }
    return false;
}

fn set_disjoint_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetSupOrDjState* = NULL; raw { st = (SetSupOrDjState*)state; }
    if set_find_slot(st.self_s, v) >= 0 {
        st.flag = false;
        return true;
    }
    return false;
}

// Set.prototype.difference(other) — entries in `this` that aren't in
// `other`. Walks `this`, probes other.has(value).
fn host_set_difference(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    if argc == 0 || !value_is_js_object(args[0]) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.difference requires an object", 43);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let other = args[0];
    let out = make_new_set(ctx);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let i: u32 = 0;
    while i < self_s.count {
        let e = self_s.entries + i;
        if !e.deleted {
            let in_other = set_like_has(ctx, other, e.value);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if !in_other { set_add_entry(out, e.value); }
        }
        i = i + 1;
    }
    return out_v;
}

fn host_set_intersection(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    if argc == 0 || !value_is_js_object(args[0]) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.intersection requires an object", 45);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let other = args[0];
    let out = make_new_set(ctx);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let i: u32 = 0;
    while i < self_s.count {
        let e = self_s.entries + i;
        if !e.deleted {
            let in_other = set_like_has(ctx, other, e.value);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if in_other { set_add_entry(out, e.value); }
        }
        i = i + 1;
    }
    return out_v;
}

fn host_set_union(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    if argc == 0 || !value_is_js_object(args[0]) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.union requires an object", 38);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let other = args[0];
    let out = make_new_set(ctx);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let i: u32 = 0;
    while i < self_s.count {
        let e = self_s.entries + i;
        if !e.deleted { set_add_entry(out, e.value); }
        i = i + 1;
    }
    // Add each value from `other`. Captures `out` via state struct.
    let us: SetUnionState; us.out = out;
    let state: void* = NULL; raw { state = (void*)&us; }
    let fp: void* = NULL; raw { fp = (void*)set_union_cb; }
    if !iterate_set_like(ctx, other, fp, state) { return zjs_undefined(); }
    return out_v;
}

fn host_set_symmetric_difference(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    if argc == 0 || !value_is_js_object(args[0]) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.symmetricDifference requires an object", 52);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let other = args[0];
    let out = make_new_set(ctx);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    // Values from this NOT in other.
    let i: u32 = 0;
    while i < self_s.count {
        let e = self_s.entries + i;
        if !e.deleted {
            let in_other = set_like_has(ctx, other, e.value);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if !in_other { set_add_entry(out, e.value); }
        }
        i = i + 1;
    }
    // Values from other NOT in this.
    let sd: SetSymDiffState; sd.self_s = self_s; sd.out = out;
    let sp: void* = NULL; raw { sp = (void*)&sd; }
    let fp: void* = NULL; raw { fp = (void*)set_symdiff_other_cb; }
    if !iterate_set_like(ctx, other, fp, sp) {
        return zjs_undefined();
    }
    return out_v;
}

fn host_set_is_subset_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    if argc == 0 || !value_is_js_object(args[0]) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.isSubsetOf requires an object", 43);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let other = args[0];
    let i: u32 = 0;
    while i < self_s.count {
        let e = self_s.entries + i;
        if !e.deleted {
            let in_other = set_like_has(ctx, other, e.value);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if !in_other { return zjs_bool(0); }
        }
        i = i + 1;
    }
    return zjs_bool(1);
}

fn host_set_is_superset_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    if argc == 0 || !value_is_js_object(args[0]) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.isSupersetOf requires an object", 45);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let other = args[0];
    let ss: SetSupOrDjState; ss.self_s = self_s; ss.flag = true;
    let sp: void* = NULL; raw { sp = (void*)&ss; }
    let fp: void* = NULL; raw { fp = (void*)set_superset_cb; }
    if !iterate_set_like(ctx, other, fp, sp) {
        return zjs_undefined();
    }
    return zjs_bool(if ss.flag { 1 } else { 0 });
}

fn host_set_is_disjoint_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    if argc == 0 || !value_is_js_object(args[0]) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set.prototype.isDisjointFrom requires an object", 47);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let other = args[0];
    let ds: SetSupOrDjState; ds.self_s = self_s; ds.flag = true;
    let sp: void* = NULL; raw { sp = (void*)&ds; }
    let fp: void* = NULL; raw { fp = (void*)set_disjoint_cb; }
    if !iterate_set_like(ctx, other, fp, sp) {
        return zjs_undefined();
    }
    return zjs_bool(if ds.flag { 1 } else { 0 });
}

// =====================================================================
// Date host functions (2026-05-16). Stores ms since UTC epoch as f64.
// Year math goes through the C library (gmtime/timegm). Locale-aware
// formatting is left for an Intl follow-up.
// =====================================================================

fn host_date_now_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ms: f64 = 0.0;
    raw {
        struct timespec ts;
        clock_gettime(CLOCK_REALTIME, &ts);
        ms = (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
    }
    return zjs_double(ms);
}

// Format a Date as ISO 8601 — `YYYY-MM-DDTHH:MM:SS.sssZ`. Used by
// host_date_to_iso_string and toJSON.
fn format_iso_string(ctx: ZjsContext*, ms: f64) -> ZjsValue {
    let buf: char[40];
    raw {
        if (ms != ms) {  // NaN check
            snprintf(buf, sizeof(buf), "Invalid Date");
        } else {
            int64_t total_ms = (int64_t)ms;
            int millis = (int)(total_ms % 1000);
            if (millis < 0) millis += 1000;
            time_t secs = (time_t)(total_ms / 1000);
            if (millis != 0 && total_ms < 0) secs -= 1;
            struct tm tm_utc;
            gmtime_r(&secs, &tm_utc);
            snprintf(buf, sizeof(buf),
                "%04d-%02d-%02dT%02d:%02d:%02d.%03dZ",
                tm_utc.tm_year + 1900,
                tm_utc.tm_mon + 1,
                tm_utc.tm_mday,
                tm_utc.tm_hour,
                tm_utc.tm_min,
                tm_utc.tm_sec,
                millis);
        }
    }
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let len: u32 = 0;
    raw { len = (uint32_t)strlen(bp); }
    return ctx_intern_string(ctx, bp, len);
}

// Compose ms since epoch from broken-down UTC components. Matches
// the spec's MakeDay / MakeTime / MakeDate. Falls through to NaN for
// out-of-range inputs.
fn date_compose_utc_ms(year: f64, month: f64, day: f64,
                       hour: f64, minute: f64, second: f64,
                       ms_part: f64) -> f64 {
    let result: f64 = 0.0;
    raw {
        // Spec: year < 100 maps to 1900-relative. ECMA-262 §21.4.1.13.
        double yr = year;
        if (yr >= 0.0 && yr <= 99.0) yr += 1900.0;
        struct tm t;
        memset(&t, 0, sizeof(t));
        t.tm_year = (int)yr - 1900;
        t.tm_mon  = (int)month;
        t.tm_mday = (int)day;
        t.tm_hour = (int)hour;
        t.tm_min  = (int)minute;
        t.tm_sec  = (int)second;
        time_t secs = timegm(&t);
        if (secs == (time_t)-1) {
            result = 0.0/0.0;   // NaN
        } else {
            result = (double)secs * 1000.0 + ms_part;
        }
    }
    return result;
}

fn host_date_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ms: f64 = 0.0;
    if argc == 0 {
        raw {
            struct timespec ts;
            clock_gettime(CLOCK_REALTIME, &ts);
            ms = (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
        }
    } else if argc == 1 {
        let v = args[0];
        if zjs_is_string(v) != 0 {
            // Spec Date.parse — only handle the canonical ISO subset.
            let s = zjs_as_string(v);
            let parsed: f64 = 0.0;
            raw {
                int Y, Mo, D, H = 0, Mn = 0, S = 0, Ms = 0;
                int n = sscanf(s->data, "%d-%d-%dT%d:%d:%d.%dZ", &Y, &Mo, &D, &H, &Mn, &S, &Ms);
                if (n < 3) {
                    n = sscanf(s->data, "%d-%d-%d", &Y, &Mo, &D);
                    H = Mn = S = Ms = 0;
                }
                if (n >= 3) {
                    struct tm t;
                    memset(&t, 0, sizeof(t));
                    t.tm_year = Y - 1900;
                    t.tm_mon  = Mo - 1;
                    t.tm_mday = D;
                    t.tm_hour = H;
                    t.tm_min  = Mn;
                    t.tm_sec  = S;
                    time_t secs = timegm(&t);
                    parsed = (double)secs * 1000.0 + (double)Ms;
                } else {
                    parsed = 0.0/0.0;
                }
            }
            ms = parsed;
        } else {
            ms = zjs_to_double(v);
        }
    } else {
        let y = zjs_to_double(args[0]);
        let mo = zjs_to_double(args[1]);
        let d = if argc > 2 { zjs_to_double(args[2]) } else { 1.0 };
        let h = if argc > 3 { zjs_to_double(args[3]) } else { 0.0 };
        let mi = if argc > 4 { zjs_to_double(args[4]) } else { 0.0 };
        let se = if argc > 5 { zjs_to_double(args[5]) } else { 0.0 };
        let ml = if argc > 6 { zjs_to_double(args[6]) } else { 0.0 };
        ms = date_compose_utc_ms(y, mo, d, h, mi, se, ml);
    }
    let d = zjs_date_new(ms);
    ctx_register_cell(ctx, (void*)d);
    return zjs_cell_from_ptr((void*)d);
}

fn host_date_parse_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0/0.0); }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    let parsed: f64 = 0.0;
    raw {
        int Y, Mo, D, H = 0, Mn = 0, S = 0, Ms = 0;
        int n = sscanf(s->data, "%d-%d-%dT%d:%d:%d.%dZ", &Y, &Mo, &D, &H, &Mn, &S, &Ms);
        if (n < 3) {
            n = sscanf(s->data, "%d-%d-%d", &Y, &Mo, &D);
            H = Mn = S = Ms = 0;
        }
        if (n >= 3) {
            struct tm t;
            memset(&t, 0, sizeof(t));
            t.tm_year = Y - 1900;
            t.tm_mon  = Mo - 1;
            t.tm_mday = D;
            t.tm_hour = H;
            t.tm_min  = Mn;
            t.tm_sec  = S;
            time_t secs = timegm(&t);
            parsed = (double)secs * 1000.0 + (double)Ms;
        } else {
            parsed = 0.0/0.0;
        }
    }
    return zjs_double(parsed);
}

fn host_date_utc_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let y = if argc > 0 { zjs_to_double(args[0]) } else { 0.0/0.0 };
    let mo = if argc > 1 { zjs_to_double(args[1]) } else { 0.0 };
    let d = if argc > 2 { zjs_to_double(args[2]) } else { 1.0 };
    let h = if argc > 3 { zjs_to_double(args[3]) } else { 0.0 };
    let mi = if argc > 4 { zjs_to_double(args[4]) } else { 0.0 };
    let se = if argc > 5 { zjs_to_double(args[5]) } else { 0.0 };
    let ml = if argc > 6 { zjs_to_double(args[6]) } else { 0.0 };
    return zjs_double(date_compose_utc_ms(y, mo, d, h, mi, se, ml));
}

fn date_require_this(ctx: ZjsContext*) -> ZjsDate* {
    let this_v = ctx.host_this;
    if zjs_is_date(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Date method called on non-Date", 30);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return NULL;
    }
    return zjs_as_date(this_v);
}

fn host_date_get_time(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(d.time_ms);
}

fn host_date_set_time(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let ms = if argc > 0 { zjs_to_double(args[0]) } else { 0.0/0.0 };
    d.time_ms = ms;
    return zjs_double(ms);
}

fn host_date_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_date_get_time(ctx, args, argc);
}

fn host_date_to_iso_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    if d.time_ms != d.time_ms {   // NaN
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"Invalid time value", 18);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return format_iso_string(ctx, d.time_ms);
}

fn host_date_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    // toString is locale-formatted in the spec; we emit the ISO form
    // as a serviceable stand-in until Intl lands.
    if d.time_ms != d.time_ms {
        return ctx_intern_string(ctx, (char*)"Invalid Date", 12);
    }
    return format_iso_string(ctx, d.time_ms);
}

fn host_date_to_json(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    if d.time_ms != d.time_ms { return zjs_null(); }
    return format_iso_string(ctx, d.time_ms);
}

// Helper for getter methods. Decomposes ms into the requested UTC
// component (year, month, ...). `field`:
//   0=fullYear  1=month  2=date  3=day(weekday)  4=hours
//   5=minutes   6=seconds  7=milliseconds
fn date_extract_utc(time_ms: f64, field: u32) -> f64 {
    if time_ms != time_ms { return 0.0/0.0; }
    let r: f64 = 0.0;
    raw {
        int64_t total_ms = (int64_t)time_ms;
        int millis = (int)(total_ms % 1000);
        if (millis < 0) millis += 1000;
        time_t secs = (time_t)(total_ms / 1000);
        if (millis != 0 && total_ms < 0) secs -= 1;
        struct tm tm_utc;
        gmtime_r(&secs, &tm_utc);
        switch (field) {
            case 0: r = (double)(tm_utc.tm_year + 1900); break;
            case 1: r = (double)tm_utc.tm_mon;           break;
            case 2: r = (double)tm_utc.tm_mday;          break;
            case 3: r = (double)tm_utc.tm_wday;          break;
            case 4: r = (double)tm_utc.tm_hour;          break;
            case 5: r = (double)tm_utc.tm_min;           break;
            case 6: r = (double)tm_utc.tm_sec;           break;
            case 7: r = (double)millis;                   break;
            default: r = 0.0/0.0;                         break;
        }
    }
    return r;
}

fn host_date_get_year(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 0));
}
fn host_date_get_month(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 1));
}
fn host_date_get_date(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 2));
}
fn host_date_get_day(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 3));
}
fn host_date_get_hours(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 4));
}
fn host_date_get_minutes(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 5));
}
fn host_date_get_seconds(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 6));
}
fn host_date_get_millis(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 7));
}
fn host_date_get_tzoffset(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    // We're UTC-only — spec returns the offset in minutes that UTC
    // is ahead of local. With local=UTC, that's 0.
    return zjs_int32(0);
}

// =====================================================================
// Symbol host functions (2026-05-16). User-created Symbols get a unique
// `key` string ("@@sym:<id>") derived from ctx.symbol_counter; the
// engine internals use that string when the Symbol is used as a
// property key. Well-known symbols (Symbol.iterator, ...) reuse the
// "@@iterator"-style sentinels the engine already understands.
// =====================================================================

fn ctx_alloc_symbol(ctx: ZjsContext*, description: ZjsString*, key: ZjsString*) -> ZjsValue {
    let s = zjs_symbol_new(description, key);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

fn ctx_fresh_symbol_key(ctx: ZjsContext*) -> ZjsString* {
    ctx.symbol_counter = ctx.symbol_counter + 1;
    let buf: char[32];
    raw { snprintf(buf, sizeof(buf), "@@sym:%u", (unsigned)ctx->symbol_counter); }
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let len: u32 = 0; raw { len = (uint32_t)strlen(bp); }
    return ctx_intern_atom(ctx, bp, len);
}

fn host_symbol_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262: `new Symbol()` throws TypeError, plain call returns
    // a fresh primitive. We don't distinguish here yet — both work.
    let desc: ZjsString* = NULL;
    if argc > 0 && zjs_is_undefined(args[0]) == 0 {
        let dv = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
        if zjs_is_string(dv) != 0 { desc = zjs_as_string(dv); }
    }
    let key = ctx_fresh_symbol_key(ctx);
    return ctx_alloc_symbol(ctx, desc, key);
}

fn host_symbol_for(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let kv = if argc > 0 { args[0] } else { zjs_undefined() };
    if zjs_is_string(kv) == 0 { kv = zjs_to_string(ctx, kv); }
    let key_str = zjs_as_string(kv);
    let i: u32 = 0;
    while i < ctx.symbol_for_count {
        if zjs_string_equals(ctx.symbol_for_keys[i], key_str) != 0 {
            return zjs_cell_from_ptr((void*)ctx.symbol_for_syms[i]);
        }
        i = i + 1;
    }
    // Symbol.for-created symbols are user-visible under the supplied
    // key, but their internal property-key (for `obj[Symbol.for("x")]`
    // round-trips) needs to be the same string used downstream. Use
    // the registry key directly as the property key — same key implies
    // same Symbol instance per spec.
    let sym = zjs_symbol_new(key_str, key_str);
    ctx_register_cell(ctx, (void*)sym);
    if ctx.symbol_for_count >= ctx.symbol_for_cap {
        let new_cap: u32 = if ctx.symbol_for_cap == 0 { 8 } else { ctx.symbol_for_cap * 2 };
        ctx.symbol_for_keys = realloc_n<ZjsString*>(ctx.symbol_for_keys, (usize)ctx.symbol_for_cap, (usize)new_cap);
        ctx.symbol_for_syms = realloc_n<ZjsSymbol*>(ctx.symbol_for_syms, (usize)ctx.symbol_for_cap, (usize)new_cap);
        ctx.symbol_for_cap = new_cap;
    }
    ctx.symbol_for_keys[ctx.symbol_for_count] = key_str;
    ctx.symbol_for_syms[ctx.symbol_for_count] = sym;
    ctx.symbol_for_count = ctx.symbol_for_count + 1;
    return zjs_cell_from_ptr((void*)sym);
}

fn host_symbol_keyfor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 || zjs_is_symbol(args[0]) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Symbol.keyFor expects a Symbol", 30);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let sym = zjs_as_symbol(args[0]);
    let i: u32 = 0;
    while i < ctx.symbol_for_count {
        if ctx.symbol_for_syms[i] == sym {
            return zjs_cell_from_ptr((void*)ctx.symbol_for_keys[i]);
        }
        i = i + 1;
    }
    return zjs_undefined();
}

fn host_symbol_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_symbol(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Symbol.prototype.toString called on non-Symbol", 46);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let sym = zjs_as_symbol(this_v);
    let desc_len: u32 = if sym.description != NULL { sym.description.length } else { 0 };
    let desc_ptr: char* = NULL;
    if sym.description != NULL { desc_ptr = sym.description.data; }
    let total: u32 = desc_len + 8;   // "Symbol(" + desc + ")"
    let buf = alloc_n<char>((usize)(total + 1));
    raw {
        if (desc_ptr) {
            snprintf(buf, total + 1, "Symbol(%.*s)", (int)desc_len, desc_ptr);
        } else {
            snprintf(buf, total + 1, "Symbol()");
        }
    }
    let actual_len: u32 = 0;
    raw { actual_len = (uint32_t)strlen(buf); }
    return ctx_intern_string_take(ctx, buf, actual_len);
}

fn host_symbol_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_symbol(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Symbol.prototype.valueOf called on non-Symbol", 45);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return this_v;
}

fn host_async_resume_fulfilled(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let cont_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        cont_v = hf.bound;
    }
    if zjs_is_async_cont(cont_v) == 0 { return zjs_undefined(); }
    let cont = zjs_as_async_cont(cont_v);
    let val = if argc >= 1 { args[0] } else { zjs_undefined() };
    let is_throw_out: bool = false;
    let thrown_val:   ZjsValue = zjs_undefined();
    raw {
        extern InterpretResult interpret_resume(ZjsContext* ctx, ZjsAsyncCont* cont, ZjsValue v, bool is_throw);
        InterpretResult r = interpret_resume(ctx, cont, val, 0);
        is_throw_out = r.is_throw;
        thrown_val   = r.value;
    }
    if is_throw_out {
        promise_settle(ctx, cont.outer_promise, thrown_val, false);
    }
    return zjs_undefined();
}

fn host_async_resume_rejected(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let cont_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        cont_v = hf.bound;
    }
    if zjs_is_async_cont(cont_v) == 0 { return zjs_undefined(); }
    let cont = zjs_as_async_cont(cont_v);
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    let is_throw_out: bool = false;
    let thrown_val:   ZjsValue = zjs_undefined();
    raw {
        extern InterpretResult interpret_resume(ZjsContext* ctx, ZjsAsyncCont* cont, ZjsValue v, bool is_throw);
        InterpretResult r = interpret_resume(ctx, cont, reason, 1);
        is_throw_out = r.is_throw;
        thrown_val   = r.value;
    }
    if is_throw_out {
        promise_settle(ctx, cont.outer_promise, thrown_val, false);
    }
    return zjs_undefined();
}

fn host_promise_resolve_fn(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Per-instance bound = the target promise.
    let target_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        target_v = hf.bound;
    }
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    promise_resolve_with(ctx, target_v, value);
    return zjs_undefined();
}

fn host_promise_reject_fn(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        target_v = hf.bound;
    }
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    promise_settle(ctx, target_v, reason, false);
    return zjs_undefined();
}

// Promise.withResolvers() — ECMA-262 §27.2.4.7. Returns
// `{ promise, resolve, reject }` where promise is a fresh pending
// Promise and resolve/reject are the bound capability functions.
// Used by code that needs to externalize resolve/reject (sometimes
// called a "deferred" pattern).
// Promise.try(callback, ...args) — call callback synchronously,
// wrap return value in a promise (or reject with the thrown error
// on synchronous throw).
fn host_promise_try(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"try", 3) { return zjs_undefined(); }
    let cb = if argc >= 1 { args[0] } else { zjs_undefined() };
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    let is_callable = zjs_is_function(cb) != 0
                     || zjs_is_closure(cb) != 0
                     || zjs_is_host_function(cb) != 0;
    if !is_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.try callback is not callable", 36);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let rest: ZjsValue* = NULL;
    let rest_n: u32 = if argc > 1 { argc - 1 } else { 0 };
    if rest_n > 0 { raw { rest = &args[1]; } }
    let saved_pt = ctx.pending_throw_active;
    let saved_pv = ctx.pending_throw_value;
    ctx.pending_throw_active = false;
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, cb, zjs_undefined(), rest, rest_n); }
    if ctx.pending_throw_active {
        let thrown = ctx.pending_throw_value;
        ctx.pending_throw_active = saved_pt;
        ctx.pending_throw_value = saved_pv;
        promise_settle(ctx, pv, thrown, false);
        return pv;
    }
    promise_resolve_with(ctx, pv, r);
    return pv;
}

fn host_promise_with_resolvers(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"withResolvers", 13) { return zjs_undefined(); }
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    ctx_push_temp_root(ctx, pv);
    defer ctx_pop_temp_root(ctx);

    let resolve_ptr: void* = NULL; raw { resolve_ptr = (void*)host_promise_resolve_fn; }
    let reject_ptr:  void* = NULL; raw { reject_ptr  = (void*)host_promise_reject_fn; }
    let resolve_fn = ctx_make_host_function_arity(ctx, (char*)"resolve", resolve_ptr, 1);
    let reject_fn  = ctx_make_host_function_arity(ctx, (char*)"reject",  reject_ptr, 1);
    zjs_as_host_function(resolve_fn).bound = pv;
    zjs_as_host_function(reject_fn).bound  = pv;

    let r_v = ctx_new_object(ctx);
    let r = zjs_as_object(r_v);
    object_set(ctx, r, ctx_intern_atom(ctx, (char*)"promise", 7), pv);
    object_set(ctx, r, ctx_intern_atom(ctx, (char*)"resolve", 7), resolve_fn);
    object_set(ctx, r, ctx_intern_atom(ctx, (char*)"reject",  6), reject_fn);
    return r_v;
}

// new Promise(executor) — allocates a pending promise, builds bound
// resolve/reject closures, and runs the executor synchronously.
// If the executor throws, the promise is rejected with the thrown value.
fn host_promise_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §27.2.3.1 step 1: throw TypeError if NewTarget is
    // undefined — i.e. Promise(...) called without `new`.
    if !ctx.new_target_active {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise constructor cannot be invoked without 'new'", 51);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let executor = if argc >= 1 { args[0] } else { zjs_undefined() };
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    if ctx.promise_ctor_proto != NULL {
        // Allow `new Promise()` to set up proto chain. The cell itself
        // doesn't carry .proto (promises aren't ZjsObject), so
        // property_get for promise instances must intercept on
        // ctx.promise_ctor_proto. Handled below in property_get.
    }
    let pv = zjs_cell_from_ptr((void*)p);
    ctx_push_temp_root(ctx, pv);
    defer ctx_pop_temp_root(ctx);

    // Build resolve/reject bound closures.
    let resolve_ptr: void* = NULL; raw { resolve_ptr = (void*)host_promise_resolve_fn; }
    let reject_ptr:  void* = NULL; raw { reject_ptr  = (void*)host_promise_reject_fn; }
    let resolve_fn = ctx_make_host_function(ctx, (char*)"resolve", resolve_ptr);
    let reject_fn  = ctx_make_host_function(ctx, (char*)"reject",  reject_ptr);
    zjs_as_host_function(resolve_fn).bound = pv;
    zjs_as_host_function(reject_fn).bound  = pv;

    let callable = zjs_is_function(executor) != 0
        || zjs_is_closure(executor) != 0
        || zjs_is_host_function(executor) != 0;
    if !callable {
        // ECMA-262 §27.2.3.1 step 2 — synchronous TypeError, not a
        // rejected promise.
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise resolver is not a function", 34);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let exec_args: ZjsValue[2];
    exec_args[0] = resolve_fn;
    exec_args[1] = reject_fn;
    let exec_argp: ZjsValue* = NULL;
    raw { exec_argp = &exec_args[0]; }
    let saved_pt = ctx.pending_throw_active;
    let saved_pv = ctx.pending_throw_value;
    ctx.pending_throw_active = false;
    ctx.pending_throw_value = zjs_undefined();
    raw { (void)zjs_call_value_with_this(ctx, executor, zjs_undefined(), exec_argp, 2); }
    if ctx.pending_throw_active {
        // Executor threw — reject (unless already settled).
        let thrown = ctx.pending_throw_value;
        ctx.pending_throw_active = saved_pt;
        ctx.pending_throw_value = saved_pv;
        promise_settle(ctx, pv, thrown, false);
    }
    return pv;
}

// Promise.resolve(value) — if value is already a promise, return it;
// else create a fulfilled one.
// ECMA-262 §27.2.4.6 (and §27.2.4.5): Promise.resolve / Promise.reject
// require `this` to be an Object (a constructor). Tests in the
// `Promise/{resolve,reject}/ctx-*` clusters call these with a custom
// `this` and assert TypeError when it isn't.
fn require_promise_constructor_this(ctx: ZjsContext*, fn_name: char*, fn_name_len: u32) -> bool {
    let t = ctx.host_this;
    // User functions and closures are always constructible. Host
    // functions are constructible if they were registered with a
    // .prototype (the marker we use for the few real built-in ctors
    // like Promise / RegExp / Error / Number / etc.); plain helper
    // host fns (eval, parseInt, ...) leave it NULL.
    let t_ok: bool = false;
    if zjs_is_function(t) != 0 || zjs_is_closure(t) != 0 {
        t_ok = true;
    } else if zjs_is_host_function(t) != 0 {
        let hf = zjs_as_host_function(t);
        if hf.prototype != NULL { t_ok = true; }
    }
    if !t_ok {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"this is not a constructor", 25);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return false;
    }
    return true;
}

fn host_promise_resolve_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"resolve", 7) { return zjs_undefined(); }
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_promise(v) != 0 { return v; }
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    promise_resolve_with(ctx, pv, v);
    return pv;
}

// Promise.reject(reason) — always a new rejected promise.
fn host_promise_reject_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"reject", 6) { return zjs_undefined(); }
    let r = if argc >= 1 { args[0] } else { zjs_undefined() };
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    promise_settle(ctx, pv, r, false);
    return pv;
}

// Promise.prototype.then(onFulfilled, onRejected)
fn host_promise_then(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_promise(this_val) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.prototype.then called on non-promise", 44);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let on_f = if argc >= 1 { args[0] } else { zjs_undefined() };
    let on_r = if argc >= 2 { args[1] } else { zjs_undefined() };
    let p = zjs_as_promise(this_val);
    let result = zjs_promise_new();
    ctx_register_cell(ctx, (void*)result);
    let rp = zjs_cell_from_ptr((void*)result);
    if p.state == PROMISE_FULFILLED {
        microtask_enqueue(ctx, on_f, p.value, rp, true);
    } else if p.state == PROMISE_REJECTED {
        microtask_enqueue(ctx, on_r, p.value, rp, false);
    } else {
        promise_attach_reaction(ctx, p, on_f, on_r, rp);
    }
    return rp;
}

// Internal: { promise, results, remaining, idx } per-element binding
// used by Promise.all to track which slot to fill. Re-uses
// __zjs_primitive__ trick: we stash a small descriptor object via
// hidden keys on the on-fulfilled host function.
def PA_PROMISE_KEY: char* = (char*)"__zjs_pa_p__";
def PA_RESULTS_KEY: char* = (char*)"__zjs_pa_r__";
def PA_REM_KEY:     char* = (char*)"__zjs_pa_n__";
def PA_IDX_KEY:     char* = (char*)"__zjs_pa_i__";

fn host_promise_all_on_fulfill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Per-element state shape:
    //   __zjs_pa_p__: result promise (rp)
    //   __zjs_pa_r__: results array
    //   __zjs_pa_n__: shared-state object (whose own __zjs_pa_n__
    //                  is the int remaining counter)
    //   __zjs_pa_i__: this element's index
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    let p_v   = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let res_v = object_get(per, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12));
    let shared_v = object_get(per, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let idx_v = object_get(per, ctx_intern_atom(ctx, PA_IDX_KEY, 12));
    if zjs_is_object(shared_v) == 0 { return zjs_undefined(); }
    let shared = zjs_as_object(shared_v);

    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_array(res_v) != 0 && zjs_is_int32(idx_v) != 0 {
        let arr = zjs_as_array(res_v);
        array_set(arr, (u32)zjs_as_int32(idx_v), value);
    }
    let rem_v = object_get(shared, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem = zjs_as_int32(rem_v) - 1;
    object_set(ctx, shared, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem));
    if rem == 0 && zjs_is_promise(p_v) != 0 {
        promise_resolve_with(ctx, p_v, res_v);
    }
    return zjs_undefined();
}

fn host_promise_all(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"all", 3) { return zjs_undefined(); }
    let result = zjs_promise_new();
    ctx_register_cell(ctx, (void*)result);
    let rp = zjs_cell_from_ptr((void*)result);
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);

    // Drive the input via the iterator protocol so any iterable
    // (Set, Map, generator, custom @@iterator) settles correctly.
    // iter_get throws on null/undefined or non-iterable; surface that
    // as the rejection of `rp` to match Promise.all's "reject on
    // GetIterator throw" semantics.
    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, rp, err, false);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    // Results grow as we pull items; index i is the slot.
    let results_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, results_v);
    defer ctx_pop_temp_root(ctx);

    // Remaining-counter dance: start at 1 (the "iteration still running"
    // sentinel), bump by 1 per pulled item, decrement once after the
    // pull loop finishes. Each per-element callback decrements; whoever
    // drops it to 0 settles `rp`. The +1/-1 around iteration prevents
    // an all-synchronous-fulfilled input from settling mid-pull.
    let state_v = ctx_new_object(ctx);
    let state = zjs_as_object(state_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), rp);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(1));

    let reject_ptr: void* = NULL; raw { reject_ptr = (void*)host_promise_reject_fn; }
    let reject_fn = ctx_make_host_function(ctx, (char*)"reject", reject_ptr);
    zjs_as_host_function(reject_fn).bound = rp;

    let onf_ptr: void* = NULL; raw { onf_ptr = (void*)host_promise_all_on_fulfill; }
    let i: u32 = 0;
    let iter_throw: bool = false;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active {
            // iter.next() threw — reject rp with that throw. The
            // iterator is already done (iter_step sets done on throw),
            // so iter_close would no-op.
            iter_throw = true;
            break;
        }
        if step.done { break; }
        let item = step.value;

        // Bump the remaining counter for this slot.
        let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
        object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12),
                   zjs_int32(zjs_as_int32(rem_v) + 1));

        let per_state_v = ctx_new_object(ctx);
        let per_state = zjs_as_object(per_state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), rp);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_REM_KEY, 12), state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_IDX_KEY, 12), zjs_int32((i32)i));

        let onf = ctx_make_host_function(ctx, (char*)"all_onf", onf_ptr);
        zjs_as_host_function(onf).bound = per_state_v;

        let item_pv = if zjs_is_promise(item) != 0 { item } else {
            let pp = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp);
            let ppv = zjs_cell_from_ptr((void*)pp);
            promise_resolve_with(ctx, ppv, item);
            ppv
        };
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, onf, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, reject_fn, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, onf, reject_fn, zjs_undefined());
        }

        i = i + 1;
    }
    if iter_throw {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, rp, err, false);
        return rp;
    }

    // End-of-iteration decrement. If nothing was queued (empty
    // iterable) or every queued item already settled synchronously,
    // this is the last decrement and resolves `rp` immediately.
    let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem_after = zjs_as_int32(rem_v) - 1;
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem_after));
    if rem_after == 0 {
        promise_resolve_with(ctx, rp, results_v);
    }
    return rp;
}

// Re-read the shared remaining counter via state's PA_REM_KEY ->
// state_v. Patch the on-fulfill helper to read from there.
// (Already done — host_promise_all_on_fulfill reads through `state`.)

fn host_promise_race(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"race", 4) { return zjs_undefined(); }
    let result = zjs_promise_new();
    ctx_register_cell(ctx, (void*)result);
    let rp = zjs_cell_from_ptr((void*)result);
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);

    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, rp, err, false);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    let resolve_ptr: void* = NULL; raw { resolve_ptr = (void*)host_promise_resolve_fn; }
    let reject_ptr:  void* = NULL; raw { reject_ptr  = (void*)host_promise_reject_fn; }
    let resolve_fn = ctx_make_host_function(ctx, (char*)"resolve", resolve_ptr);
    let reject_fn  = ctx_make_host_function(ctx, (char*)"reject", reject_ptr);
    zjs_as_host_function(resolve_fn).bound = rp;
    zjs_as_host_function(reject_fn).bound  = rp;

    // race has no counter — the first item that settles wins via its
    // bound resolve/reject. An empty iterable leaves `rp` pending
    // forever (spec-correct: race([]) never settles).
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active {
            let err = consume_pending_throw(ctx);
            promise_settle(ctx, rp, err, false);
            return rp;
        }
        if step.done { break; }
        let item = step.value;
        let item_pv = if zjs_is_promise(item) != 0 { item } else {
            let pp = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp);
            let ppv = zjs_cell_from_ptr((void*)pp);
            promise_resolve_with(ctx, ppv, item);
            ppv
        };
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, resolve_fn, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, reject_fn, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, resolve_fn, reject_fn, zjs_undefined());
        }
    }
    return rp;
}

// Promise.allSettled: like .all but always fulfills, with an array
// of { status: 'fulfilled', value } | { status: 'rejected', reason }.
fn host_promise_all_settled_on_settle(ctx: ZjsContext*, args: ZjsValue*, argc: u32, fulfilled: bool) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    let p_v   = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let res_v = object_get(per, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12));
    let shared_v = object_get(per, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let idx_v = object_get(per, ctx_intern_atom(ctx, PA_IDX_KEY, 12));
    if zjs_is_object(shared_v) == 0 { return zjs_undefined(); }
    let shared = zjs_as_object(shared_v);

    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    // Build { status, value/reason }.
    let entry_v = ctx_new_object(ctx);
    let entry = zjs_as_object(entry_v);
    let status_key = ctx_intern_atom(ctx, (char*)"status", 6);
    if fulfilled {
        object_set(ctx, entry, status_key, ctx_intern_string(ctx, (char*)"fulfilled", 9));
        object_set(ctx, entry, ctx_intern_atom(ctx, (char*)"value", 5), v);
    } else {
        object_set(ctx, entry, status_key, ctx_intern_string(ctx, (char*)"rejected", 8));
        object_set(ctx, entry, ctx_intern_atom(ctx, (char*)"reason", 6), v);
    }
    if zjs_is_array(res_v) != 0 && zjs_is_int32(idx_v) != 0 {
        let arr = zjs_as_array(res_v);
        array_set(arr, (u32)zjs_as_int32(idx_v), entry_v);
    }
    let rem_v = object_get(shared, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem = zjs_as_int32(rem_v) - 1;
    object_set(ctx, shared, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem));
    if rem == 0 && zjs_is_promise(p_v) != 0 {
        promise_resolve_with(ctx, p_v, res_v);
    }
    return zjs_undefined();
}

fn host_promise_all_settled_on_fulfill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_promise_all_settled_on_settle(ctx, args, argc, true);
}
fn host_promise_all_settled_on_reject(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_promise_all_settled_on_settle(ctx, args, argc, false);
}

fn host_promise_all_settled(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"allSettled", 10) { return zjs_undefined(); }
    let result = zjs_promise_new();
    ctx_register_cell(ctx, (void*)result);
    let rp = zjs_cell_from_ptr((void*)result);
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);

    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, rp, err, false);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    let results_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, results_v);
    defer ctx_pop_temp_root(ctx);

    let state_v = ctx_new_object(ctx);
    let state = zjs_as_object(state_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), rp);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(1));

    let onf_ptr: void* = NULL; raw { onf_ptr = (void*)host_promise_all_settled_on_fulfill; }
    let onr_ptr: void* = NULL; raw { onr_ptr = (void*)host_promise_all_settled_on_reject; }
    let i: u32 = 0;
    let iter_throw: bool = false;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { iter_throw = true; break; }
        if step.done { break; }
        let item = step.value;

        let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
        object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12),
                   zjs_int32(zjs_as_int32(rem_v) + 1));

        let per_state_v = ctx_new_object(ctx);
        let per_state = zjs_as_object(per_state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), rp);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_REM_KEY, 12), state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_IDX_KEY, 12), zjs_int32((i32)i));
        let onf = ctx_make_host_function(ctx, (char*)"allSettled_onf", onf_ptr);
        let onr = ctx_make_host_function(ctx, (char*)"allSettled_onr", onr_ptr);
        zjs_as_host_function(onf).bound = per_state_v;
        zjs_as_host_function(onr).bound = per_state_v;

        let item_pv = if zjs_is_promise(item) != 0 { item } else {
            let pp = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp);
            let ppv = zjs_cell_from_ptr((void*)pp);
            promise_resolve_with(ctx, ppv, item);
            ppv
        };
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, onf, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, onr, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, onf, onr, zjs_undefined());
        }
        i = i + 1;
    }
    if iter_throw {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, rp, err, false);
        return rp;
    }

    let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem_after = zjs_as_int32(rem_v) - 1;
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem_after));
    if rem_after == 0 {
        promise_resolve_with(ctx, rp, results_v);
    }
    return rp;
}

// Promise.any: settles fulfilled with the first fulfillment. If every
// input rejects, settles rejected with an AggregateError-shaped object
// carrying the reasons. (We don't have true AggregateError; a plain
// Error with the right shape covers test262's structural assertions.)
fn host_promise_any_on_fulfill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    let p_v = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_promise(p_v) != 0 {
        let p = zjs_as_promise(p_v);
        if p.state == PROMISE_PENDING {
            promise_resolve_with(ctx, p_v, v);
        }
    }
    return zjs_undefined();
}

fn host_promise_any_on_reject(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    let p_v   = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let errs_v = object_get(per, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12));
    let shared_v = object_get(per, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let idx_v = object_get(per, ctx_intern_atom(ctx, PA_IDX_KEY, 12));
    if zjs_is_object(shared_v) == 0 { return zjs_undefined(); }
    let shared = zjs_as_object(shared_v);
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_array(errs_v) != 0 && zjs_is_int32(idx_v) != 0 {
        let arr = zjs_as_array(errs_v);
        array_set(arr, (u32)zjs_as_int32(idx_v), reason);
    }
    let rem_v = object_get(shared, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem = zjs_as_int32(rem_v) - 1;
    object_set(ctx, shared, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem));
    if rem == 0 && zjs_is_promise(p_v) != 0 {
        let p = zjs_as_promise(p_v);
        if p.state == PROMISE_PENDING {
            let agg = build_typed_error(ctx, (char*)"AggregateError", 14,
                                        (char*)"All promises were rejected", 26);
            if zjs_is_object(agg) != 0 {
                let ao = zjs_as_object(agg);
                object_set(ctx, ao, ctx_intern_atom(ctx, (char*)"errors", 6), errs_v);
            }
            promise_settle(ctx, p_v, agg, false);
        }
    }
    return zjs_undefined();
}

fn host_promise_any(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"any", 3) { return zjs_undefined(); }
    let result = zjs_promise_new();
    ctx_register_cell(ctx, (void*)result);
    let rp = zjs_cell_from_ptr((void*)result);
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);

    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, rp, err, false);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    let errs_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, errs_v);
    defer ctx_pop_temp_root(ctx);

    let state_v = ctx_new_object(ctx);
    let state = zjs_as_object(state_v);
    // The on-reject helper looks up the result promise + errors array
    // through PA_*_KEYS the same way .all does; stash them here too.
    object_set(ctx, state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), rp);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), errs_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(1));

    let onf_ptr: void* = NULL; raw { onf_ptr = (void*)host_promise_any_on_fulfill; }
    let onr_ptr: void* = NULL; raw { onr_ptr = (void*)host_promise_any_on_reject; }
    let i: u32 = 0;
    let iter_throw: bool = false;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { iter_throw = true; break; }
        if step.done { break; }
        let item = step.value;

        let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
        object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12),
                   zjs_int32(zjs_as_int32(rem_v) + 1));

        let per_state_v = ctx_new_object(ctx);
        let per_state = zjs_as_object(per_state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), rp);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), errs_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_REM_KEY, 12), state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_IDX_KEY, 12), zjs_int32((i32)i));
        let onf = ctx_make_host_function(ctx, (char*)"any_onf", onf_ptr);
        let onr = ctx_make_host_function(ctx, (char*)"any_onr", onr_ptr);
        zjs_as_host_function(onf).bound = per_state_v;
        zjs_as_host_function(onr).bound = per_state_v;

        let item_pv = if zjs_is_promise(item) != 0 { item } else {
            let pp = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp);
            let ppv = zjs_cell_from_ptr((void*)pp);
            promise_resolve_with(ctx, ppv, item);
            ppv
        };
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, onf, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, onr, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, onf, onr, zjs_undefined());
        }
        i = i + 1;
    }
    if iter_throw {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, rp, err, false);
        return rp;
    }

    // End-of-iteration decrement. If we never bumped (empty iterable)
    // or every input already rejected synchronously, reject rp with
    // an AggregateError carrying the collected reasons.
    let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem_after = zjs_as_int32(rem_v) - 1;
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem_after));
    if rem_after == 0 {
        let p = zjs_as_promise(rp);
        if p.state == PROMISE_PENDING {
            let agg = build_typed_error(ctx, (char*)"AggregateError", 14,
                                        (char*)"All promises were rejected", 26);
            if zjs_is_object(agg) != 0 {
                let ao = zjs_as_object(agg);
                object_set(ctx, ao, ctx_intern_atom(ctx, (char*)"errors", 6), errs_v);
            }
            promise_settle(ctx, rp, agg, false);
        }
    }
    return rp;
}

// Promise.prototype.catch(onRejected) ≡ this.then(undefined, onRejected).
fn host_promise_catch(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §27.2.5.1: Return ? Invoke(this, "then", «undefined, onRejected»).
    // Generic over the receiver — any thenable works.
    let this_val = ctx.host_this;
    let on_r = if argc >= 1 { args[0] } else { zjs_undefined() };
    let then_atom = ctx_intern_atom(ctx, (char*)"then", 4);
    let then_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)then_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_callable = zjs_is_function(then_v) != 0
                     || zjs_is_closure(then_v) != 0
                     || zjs_is_host_function(then_v) != 0;
    if !is_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.prototype.catch: receiver has no callable then", 54);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let two_args: ZjsValue[2];
    two_args[0] = zjs_undefined();
    two_args[1] = on_r;
    let argp: ZjsValue* = NULL;
    raw { argp = &two_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, then_v, this_val, argp, 2); }
    return r;
}

// Promise.prototype.finally(onFinally): calls onFinally with no args
// regardless of outcome, then propagates the original settlement.
// onFinally's return value is mostly ignored (but if it's a thenable,
// we await it before settling — simplification: just resolve through
// the synchronous case).
fn host_promise_finally_helper(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // bound stores { handler, value, is_fulfilled } as a small descriptor
    // object. (We can't easily distinguish fulfilled vs rejected at
    // call-time, so we encode it on the wrapper.)
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let desc_v = hf.bound;
    if zjs_is_object(desc_v) == 0 { return zjs_undefined(); }
    let desc = zjs_as_object(desc_v);
    let handler = object_get(desc, ctx_intern_atom(ctx, (char*)"__zjs_h__", 9));
    let is_f_v  = object_get(desc, ctx_intern_atom(ctx, (char*)"__zjs_f__", 9));
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };

    // Run onFinally with no args. Ignore its return (per spec the
    // settlement propagates from the original value).
    let callable: bool = zjs_is_function(handler) != 0
        || zjs_is_closure(handler) != 0
        || zjs_is_host_function(handler) != 0;
    if callable {
        let nullp: ZjsValue* = NULL;
        raw { (void)zjs_call_value_with_this(ctx, handler, zjs_undefined(), nullp, 0); }
    }
    // Propagate. The microtask drain treats our return as the
    // resolution value, so on rejection we need to re-throw — the
    // surrounding reaction loop reads pending_throw_active to
    // distinguish "fulfilled with v" from "rejected with v".
    if zjs_is_bool(is_f_v) != 0 && zjs_as_bool(is_f_v) != 0 {
        return value;
    }
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = value;
    return zjs_undefined();
}

fn host_promise_finally(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §27.2.5.3: Invoke(this, "then", «onFinally', onFinally'»).
    // Generic over the receiver — any thenable works.
    let this_val = ctx.host_this;
    let then_atom = ctx_intern_atom(ctx, (char*)"then", 4);
    let then_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)then_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_callable = zjs_is_function(then_v) != 0
                     || zjs_is_closure(then_v) != 0
                     || zjs_is_host_function(then_v) != 0;
    if !is_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.prototype.finally: receiver has no callable then", 56);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let handler = if argc >= 1 { args[0] } else { zjs_undefined() };
    // Build a descriptor for both paths and synthesize wrapper hosts.
    let desc_f_v = ctx_new_object(ctx);
    let desc_r_v = ctx_new_object(ctx);
    let h_atom = ctx_intern_atom(ctx, (char*)"__zjs_h__", 9);
    let f_atom = ctx_intern_atom(ctx, (char*)"__zjs_f__", 9);
    object_set(ctx, zjs_as_object(desc_f_v), h_atom, handler);
    object_set(ctx, zjs_as_object(desc_f_v), f_atom, zjs_bool(1));
    object_set(ctx, zjs_as_object(desc_r_v), h_atom, handler);
    object_set(ctx, zjs_as_object(desc_r_v), f_atom, zjs_bool(0));
    let fh_ptr: void* = NULL; raw { fh_ptr = (void*)host_promise_finally_helper; }
    let wrap_f = ctx_make_host_function(ctx, (char*)"finally_f", fh_ptr);
    let wrap_r = ctx_make_host_function(ctx, (char*)"finally_r", fh_ptr);
    zjs_as_host_function(wrap_f).bound = desc_f_v;
    zjs_as_host_function(wrap_r).bound = desc_r_v;
    let two: ZjsValue[2];
    two[0] = wrap_f; two[1] = wrap_r;
    let argp: ZjsValue* = NULL;
    raw { argp = &two[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, then_v, this_val, argp, 2); }
    return r;
}

// --- console.log (Phase 3.8a) -------------------------------------
//
// Minimum console implementation: log / info / warn / error all print
// their args space-separated to stdout (warn/error to stderr) followed
// by a newline. Formatting roughly matches the CLI's `eval` printer.

raw {
    #include <stdio.h>
}

fn console_write_value(ctx: ZjsContext*, v: ZjsValue, stream_is_stderr: bool) -> void {
    if zjs_is_undefined(v) != 0 {
        raw {
            if (stream_is_stderr) fputs("undefined", stderr);
            else fputs("undefined", stdout);
        }
        return;
    }
    if zjs_is_null(v) != 0 {
        raw {
            if (stream_is_stderr) fputs("null", stderr);
            else fputs("null", stdout);
        }
        return;
    }
    if zjs_is_bool(v) != 0 {
        let b = zjs_as_bool(v);
        raw {
            if (stream_is_stderr) fputs(b ? "true" : "false", stderr);
            else fputs(b ? "true" : "false", stdout);
        }
        return;
    }
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw {
            if (stream_is_stderr) fprintf(stderr, "%d", (int)n);
            else fprintf(stdout, "%d", (int)n);
        }
        return;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        raw {
            if (stream_is_stderr) fprintf(stderr, "%g", d);
            else fprintf(stdout, "%g", d);
        }
        return;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let sd = s.data;
        let sn = s.length;
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            fwrite(sd, 1, sn, out);
        }
        return;
    }
    // For arrays/objects, defer to JSON.stringify-style output.
    // Simplest path: produce JSON output (skips functions). Reuses
    // json_stringify_value with a fresh buf so we don't fight the
    // CLI's pretty printer.
    if zjs_is_array(v) != 0 || zjs_is_object(v) != 0 {
        let b: JsonBuf;
        b.data = NULL; b.len = 0; b.cap = 0;
        let nojc: JsonCtx;
        nojc.replacer_fn = zjs_undefined();
        nojc.replacer_arr = zjs_undefined();
        nojc.indent_str = NULL;
        nojc.indent_len = 0;
        nojc.depth = 0;
        nojc.stack_depth = 0;
        // Pass the real ctx — json_stringify_value reaches into the
        // atom table (toJSON dispatch, wrapper unboxing) and calls
        // ToPrimitive on Number/String wrappers.
        json_stringify_value(ctx, &nojc, &b, v);
        let bd = b.data;
        let bn = b.len;
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            if (bd && bn) fwrite(bd, 1, bn, out);
            free(bd);
        }
        return;
    }
    if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            fputs("[function]", out);
        }
        return;
    }
    raw {
        FILE* out = stream_is_stderr ? stderr : stdout;
        fputs("[unknown]", out);
    }
}

fn console_emit(ctx: ZjsContext*, args: ZjsValue*, argc: u32, stderr_stream: bool) -> ZjsValue {
    let i: u32 = 0;
    while i < argc {
        if i > 0 {
            raw {
                if (stderr_stream) fputc(' ', stderr);
                else fputc(' ', stdout);
            }
        }
        console_write_value(ctx, args[i], stderr_stream);
        i = i + 1;
    }
    raw {
        if (stderr_stream) fputc('\n', stderr);
        else fputc('\n', stdout);
    }
    return zjs_undefined();
}

fn host_console_log(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}

fn host_console_info(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}

fn host_console_warn(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, true);
}

fn host_console_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, true);
}

// Build a synthetic { name, message } error object — used to surface
// parse / compile / lookup failures as JS-visible throws. Also wires
// the object's proto to the same `<Type>.prototype` the user-callable
// constructor uses, so `e instanceof ReferenceError` works for our
// internally-thrown errors.
fn build_typed_error(ctx: ZjsContext*, type_name: char*, type_len: u32, msg: char*, msg_len: u32) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    // Defensive rooting: obj_v lives across multiple cell-allocating
    // helper calls below (intern, object_set with possible class
    // transitions, intern_string). Today GC only fires at interp
    // boundaries so we're not at real risk, but this insulates us
    // when item 1 (GC-in-allocator) lands — and from any future
    // refactor that adds a JS callback to this path.
    ctx_push_temp_root(ctx, obj_v);
    defer ctx_pop_temp_root(ctx);
    let obj = zjs_as_object(obj_v);
    // Set proto from the matching global error constructor's prototype.
    let ctor_slot = ctx_intern_global(ctx, type_name, type_len);
    let ctor_v = ctx.globals[ctor_slot].value;
    if zjs_is_host_function(ctor_v) != 0 {
        let hf = zjs_as_host_function(ctor_v);
        if hf.prototype == NULL {
            let pv = ctx_new_object(ctx);
            hf.prototype = zjs_as_object(pv);
        }
        obj.proto = hf.prototype;
    }
    let name_atom = ctx_intern_atom(ctx, (char*)"name", 4);
    let msg_atom  = ctx_intern_atom(ctx, (char*)"message", 7);
    let name_val_str = ctx_intern_atom(ctx, type_name, type_len);
    object_set(ctx, obj, name_atom, zjs_cell_from_ptr((void*)name_val_str));
    let msg_str = ctx_intern_string(ctx, msg, msg_len);
    object_set(ctx, obj, msg_atom, msg_str);
    return obj_v;
}

fn build_syntax_error(ctx: ZjsContext*, msg: char*) -> ZjsValue {
    let msg_len: u32 = 0;
    raw { msg_len = (uint32_t)strlen(msg); }
    return build_typed_error(ctx, (char*)"SyntaxError", 11, msg, msg_len);
}

fn build_reference_error(ctx: ZjsContext*, name: char*, name_len: u32) -> ZjsValue {
    let buf: char[256];
    let written: int = 0;
    let bp: char* = NULL;
    raw {
        bp = &buf[0];
        int n = (int)name_len; if (n > 200) n = 200;
        written = snprintf(bp, 256, "%.*s is not defined", n, name);
    }
    return build_typed_error(ctx, (char*)"ReferenceError", 14, bp, (u32)written);
}

fn build_type_error(ctx: ZjsContext*, msg: char*) -> ZjsValue {
    let msg_len: u32 = 0;
    raw { msg_len = (uint32_t)strlen(msg); }
    return build_typed_error(ctx, (char*)"TypeError", 9, msg, msg_len);
}

// --- Object.prototype methods (Phase 3.8c) -------------------------

// Object.prototype.hasOwnProperty(key) — checks own properties only,
// not the proto chain. Reads ctx.host_this for the receiver.
// Object.prototype.propertyIsEnumerable(V): true if `V` (as a string
// key) is an own property of `this` AND is enumerable. Walks only
// own slots — no prototype chain.
fn host_property_is_enumerable(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_val = ctx.host_this;
    let key = args[0];
    if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
    let name = zjs_as_string(key);
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let slot = class_find_slot(o.cls, name);
        if slot >= 0 && zjs_is_deleted(o.slots[(u32)slot]) == 0 {
            let attrs = object_get_attrs(o, (u32)slot);
            if (attrs & PROP_ENUMERABLE) != 0 { return zjs_bool(1); }
        }
        return zjs_bool(0);
    }
    if zjs_is_array(this_val) != 0 {
        let a = zjs_as_array(this_val);
        let idx = zjs_to_array_index(key);
        if idx >= 0 && array_has_index(a, (u32)idx) != 0 { return zjs_bool(1); }
        if a.props != NULL {
            let slot = class_find_slot(a.props.cls, name);
            if slot >= 0 && zjs_is_deleted(a.props.slots[(u32)slot]) == 0 {
                let attrs = object_get_attrs(a.props, (u32)slot);
                if (attrs & PROP_ENUMERABLE) != 0 { return zjs_bool(1); }
            }
        }
    }
    return zjs_bool(0);
}

// Object.prototype.isPrototypeOf(V): walk V's prototype chain looking
// for `this`. Returns true if found, false otherwise. Non-object V
// always returns false.
fn host_is_prototype_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_val = ctx.host_this;
    let v = args[0];
    // We need a way to compare `this_val` (a ZjsObject) against each
    // proto in V's chain. Only object-ish `this` can be a proto.
    let proto_target: ZjsObject* = NULL;
    if zjs_is_object(this_val) != 0 { proto_target = zjs_as_object(this_val); }
    else { return zjs_bool(0); }
    // V must have a proto chain we can walk — objects/arrays are
    // covered uniformly via getPrototypeOf-style logic.
    let cur: ZjsObject* = NULL;
    if zjs_is_object(v) != 0 {
        cur = zjs_as_object(v).proto;
    } else if zjs_is_array(v) != 0 {
        cur = ctx.array_proto;
    } else {
        return zjs_bool(0);
    }
    while cur != NULL {
        if cur == proto_target { return zjs_bool(1); }
        cur = cur.proto;
    }
    return zjs_bool(0);
}

fn host_has_own_property(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_val = ctx.host_this;
    let key = args[0];
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let name = if zjs_is_string(key) != 0 { zjs_as_string(key) }
                   else                       { zjs_as_string(zjs_to_string(ctx, key)) };
        let slot = class_find_slot(o.cls, name);
        if slot >= 0 && zjs_is_deleted(o.slots[(u32)slot]) == 0 { return zjs_bool(1); }
        return zjs_bool(0);
    }
    if zjs_is_array(this_val) != 0 {
        let a = zjs_as_array(this_val);
        let idx = zjs_to_array_index(key);
        // Holes report as absent (HasOwnProperty is false for them).
        if idx >= 0 && array_has_index(a, (u32)idx) != 0 { return zjs_bool(1); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_length: int = 0;
            raw { is_length = (kn == 6 && memcmp(kd, "length", 6) == 0) ? 1 : 0; }
            if is_length != 0 { return zjs_bool(1); }
            // Expando bag (e.g. `let a = []; a.foo = 1;`).
            if a.props != NULL {
                let slot = class_find_slot(a.props.cls, ks);
                if slot >= 0 && zjs_is_deleted(a.props.slots[(u32)slot]) == 0 { return zjs_bool(1); }
            }
        }
        return zjs_bool(0);
    }
    if zjs_is_host_function(this_val) != 0 && zjs_is_string(key) != 0 {
        // Built-in functions own length + name (and prototype if we've
        // ever read it). Other names fall through to .props.
        let ks = zjs_as_string(key);
        let kd = ks.data;
        let kn = ks.length;
        let m: int = 0;
        raw {
            m = ((kn == 6 && memcmp(kd, "length", 6) == 0)
              || (kn == 4 && memcmp(kd, "name",   4) == 0)) ? 1 : 0;
        }
        if m != 0 { return zjs_bool(1); }
        let hf = zjs_as_host_function(this_val);
        if hf.props != NULL {
            let name = ks;
            let slot = class_find_slot(hf.props.cls, name);
            if slot >= 0 && zjs_is_deleted(hf.props.slots[(u32)slot]) == 0 { return zjs_bool(1); }
        }
        return zjs_bool(0);
    }
    return zjs_bool(0);
}

// Object.isExtensible / isFrozen / isSealed — we don't track those
// flags yet, so report "extensible / not frozen / not sealed" for
// any object. ES2015+: returns false for non-object arguments.
fn host_object_is_extensible(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_bool(0); }
    let v = args[0];
    if zjs_is_object(v) != 0 || zjs_is_array(v) != 0
       || zjs_is_function(v) != 0 || zjs_is_closure(v) != 0
       || zjs_is_host_function(v) != 0 {
        return zjs_bool(1);
    }
    return zjs_bool(0);
}

fn host_object_is_frozen(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_bool(1); }
    let v = args[0];
    if zjs_is_object(v) != 0       { return zjs_bool(if zjs_as_object(v).frozen { 1 } else { 0 }); }
    if zjs_is_array(v) != 0        { return zjs_bool(if zjs_as_array(v).frozen  { 1 } else { 0 }); }
    if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        // Function objects aren't trackable yet; assume not frozen.
        return zjs_bool(0);
    }
    // Primitives are spec-frozen (no own properties to mutate).
    return zjs_bool(1);
}

fn host_object_is_sealed(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_object_is_frozen(ctx, args, argc);
}

// Object.preventExtensions / freeze / seal. Toggles the frozen flag
// on the input (objects + arrays). Strict-mode TypeError on writes
// against frozen targets isn't yet wired through the assignment
// machinery — sloppy mode silently drops writes.
fn host_object_prevent_extensions(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_undefined(); }
    return args[0];
}

fn host_object_freeze(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    if zjs_is_object(v) != 0 { zjs_as_object(v).frozen = true; }
    else if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        a.frozen = true;
        if a.props != NULL { a.props.frozen = true; }
    }
    return v;
}

fn host_object_seal(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_object_freeze(ctx, args, argc);
}

// Object.prototype.valueOf() — returns the boxed receiver per spec.
// ToObject(this) would be more correct, but ctx.host_this is already
// the object form for non-primitive receivers; primitive receivers
// reach here only through wrappers, which the existing host_wrapper_*
// helpers handle directly.
fn host_object_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    let _u2 = args;
    let _u3 = argc;
    return ctx.host_this;
}

// Object.prototype.toString() — returns "[object Object]" for most
// receivers. Cheap implementation.
fn host_object_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    let label: char* = (char*)"[object Object]";
    let label_len: u32 = 15;
    if zjs_is_undefined(this_val) != 0 { label = (char*)"[object Undefined]"; label_len = 18; }
    else if zjs_is_null(this_val) != 0 { label = (char*)"[object Null]";      label_len = 13; }
    else if zjs_is_array(this_val) != 0 { label = (char*)"[object Array]";    label_len = 14; }
    else if zjs_is_string(this_val) != 0 { label = (char*)"[object String]";  label_len = 15; }
    else if zjs_is_function(this_val) != 0 || zjs_is_closure(this_val) != 0 || zjs_is_host_function(this_val) != 0 {
        label = (char*)"[object Function]"; label_len = 17;
    }
    else if zjs_is_object(this_val) != 0 {
        // Check for our internal tag (Math/JSON/Arguments) — gives
        // `[object Math]` etc. Look up own prop only; the tag is
        // never inherited so a fast own-slot check is enough.
        let o = zjs_as_object(this_val);
        let tag_atom = ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN);
        let s = class_find_slot(o.cls, tag_atom);
        if s >= 0 {
            let tv = o.slots[(u32)s];
            if zjs_is_string(tv) != 0 {
                let tag_str = zjs_as_string(tv);
                let prefix = (char*)"[object ";
                let prefix_len: u32 = 8;
                let suffix_len: u32 = 1;
                let total = prefix_len + tag_str.length + suffix_len;
                let buf = alloc_n<char>((usize)(total + 1));
                mem_copy<char>(buf, prefix, (usize)prefix_len);
                let tail: char* = NULL;
                raw { tail = &buf[prefix_len]; }
                mem_copy<char>(tail, tag_str.data, (usize)tag_str.length);
                buf[prefix_len + tag_str.length] = ']';
                buf[total] = (char)0;
                return ctx_intern_string_take(ctx, buf, total);
            }
        }
    }
    return ctx_intern_string(ctx, label, label_len);
}

// --- Array constructor + helpers (Phase 3.8c) ---------------------

fn host_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Array() / new Array() → []
    if argc == 0 { return ctx_new_array(ctx, 0); }
    // Array(N) where N is a non-negative integer → array of length N.
    if argc == 1 {
        let v = args[0];
        if zjs_is_int32(v) != 0 {
            let n = zjs_as_int32(v);
            if n < 0 {
                // ECMA-262: RangeError; MVP returns empty.
                return ctx_new_array(ctx, 0);
            }
            let arr_v = ctx_new_array(ctx, (u32)n);
            let arr = zjs_as_array(arr_v);
            arr.length = (u32)n;
            return arr_v;
        }
        if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let n2 = (i64)d;
            if (f64)n2 == d && n2 >= 0 {
                let arr_v = ctx_new_array(ctx, (u32)n2);
                let arr = zjs_as_array(arr_v);
                arr.length = (u32)n2;
                return arr_v;
            }
            return ctx_new_array(ctx, 0);
        }
        // Single non-numeric arg → array containing that value.
        let arr_v = ctx_new_array(ctx, 1);
        let arr = zjs_as_array(arr_v);
        arr.elements[0] = v;
        arr.length = 1;
        return arr_v;
    }
    // Variadic — copy args into a fresh array.
    let arr_v = ctx_new_array(ctx, argc);
    let arr = zjs_as_array(arr_v);
    let i: u32 = 0;
    while i < argc {
        arr.elements[i] = args[i];
        i = i + 1;
    }
    arr.length = argc;
    return arr_v;
}

fn host_array_is_array(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    return zjs_bool(zjs_is_array(args[0]));
}

// --- Function.prototype.{call, apply} (Phase 3.8d) -----------------
//
// `f.call(thisArg, ...args)` and `f.apply(thisArg, argArray)` are
// dispatched as MethodInvoke on f. ctx.host_this at entry is `f`
// itself (the receiver of `.call`/`.apply`). We extract the caller-
// supplied `this` (args[0]) and dispatch the original `f` with it.

raw {
    extern ZjsValue zjs_call_value_with_this(ZjsContext* ctx, ZjsValue callee, ZjsValue this_val, ZjsValue* args, uint32_t argc);
}

fn host_function_call(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target = ctx.host_this;
    let new_this: ZjsValue = zjs_undefined();
    let new_args_ptr: ZjsValue* = NULL;
    let new_argc: u32 = 0;
    if argc >= 1 { new_this = args[0]; }
    if argc >= 2 {
        raw { new_args_ptr = &args[1]; }
        new_argc = argc - 1;
    }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, target, new_this, new_args_ptr, new_argc); }
    return r;
}

fn host_function_apply(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target = ctx.host_this;
    let new_this: ZjsValue = zjs_undefined();
    if argc >= 1 { new_this = args[0]; }
    // Second arg is an array (or null/undefined for no args).
    let new_argc: u32 = 0;
    let new_args_ptr: ZjsValue* = NULL;
    if argc >= 2 && zjs_is_array(args[1]) != 0 {
        let a = zjs_as_array(args[1]);
        new_argc = a.length;
        new_args_ptr = a.elements;
    }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, target, new_this, new_args_ptr, new_argc); }
    return r;
}

// --- Coercion-style constructors (Phase 3.8c) ----------------------
//
// MVP: `Boolean(x)` / `Number(x)` / `String(x)` perform the standard
// ToX coercion. `new Boolean(x)` etc. would normally create a wrapper
// object; we don't model wrapper objects and return the primitive
// instead — close enough for the conformance tests that call them.

// Hidden slot used by the wrapper-object form (`new Number(x)` etc.)
// to stash the primitive value behind a property name that user code
// won't bump into. Read by the prototype's valueOf / toString.
def WRAPPER_VALUE_KEY: char* = (char*)"__zjs_primitive__";
def WRAPPER_VALUE_KEY_LEN: u32 = 17;

// Hidden slot used by closure envs to chain to the enclosing
// function's env. Used by deeply-nested closures to walk past their
// immediate parent (Phase 3.9j).
def OUTER_ENV_KEY: char* = (char*)"__zjs_outer_env__";
def OUTER_ENV_KEY_LEN: u32 = 17;

// Internal class-name tag used by Object.prototype.toString to return
// `[object Math]` / `[object JSON]` / `[object Arguments]` for the
// few specific built-in objects that have a fixed toString tag in the
// spec but aren't a distinct cell type in our taxonomy. Symbol-keyed
// `Symbol.toStringTag` will replace this once we have Symbols.
def TAG_NAME_KEY: char* = (char*)"__zjs_tag__";
def TAG_NAME_KEY_LEN: u32 = 11;

// ECMA-262 §7.1.18 ToObject. Wraps primitives in their corresponding
// wrapper objects (so `Array.prototype.X.call(true, ...)` sees an
// object). For null/undefined, arms a JS-visible TypeError via
// pending_throw_active and returns undefined — callers must check
// pending_throw_active (or simply propagate the undefined and let
// the interpreter's post-host-call epilogue unwind).
//
// Already-object values (object/array/function/closure/host-function)
// pass through unchanged.
fn ctx_to_object(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    if zjs_is_object(v) != 0 { return v; }
    if zjs_is_array(v) != 0 { return v; }
    if zjs_is_function(v) != 0 { return v; }
    if zjs_is_closure(v) != 0 { return v; }
    if zjs_is_host_function(v) != 0 { return v; }
    if zjs_is_regexp(v) != 0 { return v; }
    if zjs_is_promise(v) != 0 { return v; }
    // Host instance types — already "objects" per spec; the
    // generic-Array-method tests rely on `Array.prototype.map.call(
    // someDate, cb)` walking the date as ToObject(date), which is
    // just the date itself.
    if zjs_is_date(v) != 0 { return v; }
    if zjs_is_map(v) != 0 { return v; }
    if zjs_is_set(v) != 0 { return v; }
    if zjs_is_symbol(v) != 0 { return v; }

    if zjs_is_null(v) != 0 || zjs_is_undefined(v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }

    // Primitive — wrap it. Pick the right prototype based on tag.
    let proto: ZjsObject* = NULL;
    if zjs_is_bool(v) != 0 {
        // Boolean.prototype via the Boolean host function's .prototype.
        let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
        if bool_g >= 0 {
            let bv = ctx.globals[bool_g].value;
            if zjs_is_host_function(bv) != 0 {
                proto = zjs_as_host_function(bv).prototype;
            }
        }
    } else if zjs_is_int32(v) != 0 || zjs_is_double(v) != 0 {
        let num_g = ctx_find_global(ctx, (char*)"Number", 6);
        if num_g >= 0 {
            let nv = ctx.globals[num_g].value;
            if zjs_is_host_function(nv) != 0 {
                proto = zjs_as_host_function(nv).prototype;
            }
        }
    } else if zjs_is_string(v) != 0 {
        proto = ctx.string_proto;
    }

    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    obj.proto = proto;
    let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
    object_set(ctx, obj, key, v);
    return obj_v;
}

fn wrap_primitive_if_new(ctx: ZjsContext*, primitive: ZjsValue) -> ZjsValue {
    // If invoked via `new`, NewInvoke set ctx.host_this to a fresh
    // object with proto = ctor.prototype. Attach the primitive as a
    // hidden own property and return the wrapper. Otherwise return
    // the primitive directly (plain call).
    if zjs_is_object(ctx.host_this) != 0 {
        let obj = zjs_as_object(ctx.host_this);
        let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        object_set(ctx, obj, key, primitive);
        return ctx.host_this;
    }
    return primitive;
}

fn host_boolean(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc == 0 { zjs_bool(0) } else { zjs_bool(zjs_to_bool_coerce(args[0])) };
    return wrap_primitive_if_new(ctx, v);
}

fn host_number(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let n: ZjsValue = zjs_int32(0);
    if argc > 0 {
        let d = zjs_to_double(args[0]);
        let as_int = (i32)d;
        if (f64)as_int == d { n = zjs_int32(as_int); }
        else { n = zjs_double(d); }
    }
    return wrap_primitive_if_new(ctx, n);
}

fn host_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §22.1.1.1 String(value): the call form short-circuits
    // Symbol via SymbolDescriptiveString rather than the generic
    // ToString (which throws on Symbol). The `new String(symbol)`
    // construct path STILL throws — but we don't currently distinguish
    // call vs construct on host fns, and the common case the tests
    // care about is the call form.
    let s: ZjsValue;
    if argc == 0 {
        s = ctx_intern_string(ctx, (char*)"", 0);
    } else if zjs_is_symbol(args[0]) != 0 {
        let sym = zjs_as_symbol(args[0]);
        let desc_d: char* = NULL;
        let desc_n: u32 = 0;
        if sym.description != NULL {
            desc_d = sym.description.data;
            desc_n = sym.description.length;
        }
        let buf = alloc_n<char>((usize)(desc_n + 9));
        buf[0] = 'S'; buf[1] = 'y'; buf[2] = 'm'; buf[3] = 'b';
        buf[4] = 'o'; buf[5] = 'l'; buf[6] = '(';
        let i: u32 = 0;
        while i < desc_n { buf[7 + i] = desc_d[i]; i = i + 1; }
        buf[7 + desc_n] = ')'; buf[8 + desc_n] = (char)0;
        s = ctx_intern_string_take(ctx, buf, desc_n + 8);
    } else {
        s = zjs_to_string(ctx, args[0]);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    return wrap_primitive_if_new(ctx, s);
}

// Prototype methods that unwrap the boxed primitive. Read host_this's
// hidden slot if it's a wrapper object; otherwise return host_this as-is
// (so e.g. `(123).valueOf()` would also work once we auto-box later).
fn host_wrapper_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        let v = object_get(o, key);
        if zjs_is_undefined(v) == 0 { return v; }
    }
    return this_val;
}

fn host_wrapper_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = host_wrapper_value_of(ctx, args, argc);
    if zjs_is_string(v) != 0 { return v; }
    return zjs_to_string(ctx, v);
}

// String.raw(strings, ...subs) — tagged-template helper that joins
// strings.raw entries with the substitutions verbatim. Spec §22.1.2.4.
fn host_string_raw(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"String.raw requires a template object", 37);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let strings = args[0];
    let raw_key = ctx_intern_atom(ctx, (char*)"raw", 3);
    let raw_v = property_get(ctx, strings, zjs_cell_from_ptr((void*)raw_key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    // raw must be array-like; we read its length and indexed slots.
    let len_key = ctx_intern_atom(ctx, (char*)"length", 6);
    let len_v = property_get(ctx, raw_v, zjs_cell_from_ptr((void*)len_key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let len_d = zjs_to_double(len_v);
    let is_nan: int = 0; raw { is_nan = isnan(len_d) ? 1 : 0; }
    if is_nan != 0 || len_d <= 0.0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let len: u32 = (u32)len_d;

    // Build the result by concatenating: raw[0] + sub[0] + raw[1] + ...
    // For each segment we do a string_concat. argc-1 subs are
    // available (args[1..argc)); spec wraps trailing missing ones as
    // empty string.
    let result = property_get(ctx, raw_v, zjs_int32(0));
    if ctx.pending_throw_active { return zjs_undefined(); }
    if zjs_is_string(result) == 0 { result = zjs_to_string(ctx, result); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    let i: u32 = 1;
    while i < len {
        // Substitution at position i-1 in args[1..].
        let sub: ZjsValue = if i < argc { args[i] } else { ctx_intern_string(ctx, (char*)"", 0) };
        if zjs_is_string(sub) == 0 {
            sub = zjs_to_string(ctx, sub);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        result = zjs_string_concat(ctx, result, sub);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let next = property_get(ctx, raw_v, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_is_string(next) == 0 {
            next = zjs_to_string(ctx, next);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        result = zjs_string_concat(ctx, result, next);
        if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    return result;
}

// String.fromCharCode(...codes) — build a string from numeric char codes.
// MVP: ASCII only, takes each arg's truncated u8.
fn host_string_from_char_code(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let n = argc;
    let buf = alloc_n<char>((usize)(n + 1));
    let i: u32 = 0;
    while i < argc {
        let cu = (u8)((u32)zjs_to_double(args[i]) & 255);
        buf[i] = (char)cu;
        i = i + 1;
    }
    buf[n] = (char)0;
    return ctx_intern_string_take(ctx, buf, argc);
}

// --- Error subtypes (Phase 3.8c) ----------------------------------
//
// ReferenceError / TypeError / RangeError — each builds an object
// shaped like Error but with a different `.name`. Used both as
// constructors in tests and as the second arg to `assert.throws`.

fn make_named_error(ctx: ZjsContext*, name: char*, name_len: u32, args: ZjsValue*, argc: u32) -> ZjsValue {
    // When invoked via `new Foo(...)`, NewInvoke has already allocated
    // a fresh object with `proto = Foo.prototype` and bound it as
    // ctx.host_this. Decorating that object preserves the proto link
    // so `instanceof Foo` works.
    //
    // When called as a plain function (`Error(...)` / `TypeError(...)`),
    // ECMA-262 still requires the result to be a proper Error subclass
    // instance. Look up the constructor by name and seed obj.proto so
    // `err instanceof TypeError` works for the non-new form too.
    let obj_v: ZjsValue = ctx.host_this;
    if zjs_is_object(obj_v) == 0 {
        obj_v = ctx_new_object(ctx);
        let ctor_slot = ctx_find_global(ctx, name, name_len);
        if ctor_slot >= 0 {
            let ctor_v = ctx.globals[ctor_slot].value;
            if zjs_is_host_function(ctor_v) != 0 {
                let hf = zjs_as_host_function(ctor_v);
                if hf.prototype != NULL {
                    zjs_as_object(obj_v).proto = hf.prototype;
                }
            }
        }
    }
    // Defensive rooting: obj_v is either ctx.host_this (already rooted)
    // or a fresh object held across several cell-allocating calls
    // below. Pushing in both cases is safe and one-liner — host_this is
    // already on the temp_roots path conceptually.
    ctx_push_temp_root(ctx, obj_v);
    defer ctx_pop_temp_root(ctx);
    let obj = zjs_as_object(obj_v);
    // Spec: only set `message` when explicitly provided. An omitted
    // message stays inherited (Error.prototype.message = "" by spec,
    // which our toString defaults sensibly).
    if argc > 0 && zjs_is_undefined(args[0]) == 0 {
        let msg = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"message", 7), msg);
    }
    let name_str = ctx_intern_atom(ctx, name, name_len);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"name", 4),
               zjs_cell_from_ptr((void*)name_str));
    return obj_v;
}

fn host_reference_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"ReferenceError", 14, args, argc);
}
fn host_type_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"TypeError", 9, args, argc);
}
fn host_range_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"RangeError", 10, args, argc);
}
fn host_syntax_error_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"SyntaxError", 11, args, argc);
}
fn host_uri_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"URIError", 8, args, argc);
}
fn host_eval_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"EvalError", 9, args, argc);
}

// Stub for `eval` — we don't implement runtime eval; return undefined.
// Many tests reference `eval` only for environment checks.
fn host_eval_stub(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Minimal indirect-eval: parse + interpret the source in a fresh
    // top-level program. Does NOT see surrounding locals (matches the
    // spec for indirect eval; direct-eval is a separate feature
    // gate). Lexer now recognizes the full ECMA-262 WhiteSpace +
    // LineTerminator set so the source-text edge tests work.
    if argc == 0 { return zjs_undefined(); }
    let src = args[0];
    if zjs_is_string(src) == 0 { return src; }
    let s = zjs_as_string(src);
    let buf = alloc_n<char>((usize)(s.length + 1));
    if s.length > 0 { mem_copy<char>(buf, s.data, (usize)s.length); }
    buf[s.length] = (char)0;
    let r = zjs_eval(ctx, buf);
    dealloc(buf);
    if ctx.had_error {
        let err = ctx.last_error;
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return r;
}

// new Function(p1, p2, ..., body) — compile a function whose
// parameter list is the leading args and whose body is the last arg.
// Top-level Function() and `new Function()` share semantics here
// (we ignore `this`). Per spec the function's [[Environment]] is the
// global environment, which matches our "no closure capture" model
// for compiled-at-runtime code.
fn host_function_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Stringify each argument; collect into a single source buffer
    // shaped like `(function anonymous(p1, p2) {\n body \n})`.
    let body_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    if argc >= 1 {
        body_v = args[argc - 1];
        if zjs_is_string(body_v) == 0 {
            body_v = zjs_to_string(ctx, body_v);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
    }
    let body_s = zjs_as_string(body_v);

    // Build parameter list (concat by ",").
    let comma = ctx_intern_string(ctx, (char*)",", 1);
    let params_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    let i: u32 = 0;
    let pn: u32 = if argc > 0 { argc - 1 } else { 0 };
    while i < pn {
        let av = args[i];
        if zjs_is_string(av) == 0 {
            av = zjs_to_string(ctx, av);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        if i > 0 {
            params_v = zjs_string_concat(ctx, params_v, comma);
        }
        params_v = zjs_string_concat(ctx, params_v, av);
        i = i + 1;
    }
    let params_s = zjs_as_string(params_v);

    // Build the source. Total: "(function anonymous(" + params + "){\n" + body + "\n})\0"
    let prefix_len: u32 = 20;     // "(function anonymous("
    let mid_len: u32    = 3;      // "){\n"
    let suffix_len: u32 = 3;      // "\n})"
    let total: u32 = prefix_len + params_s.length + mid_len + body_s.length + suffix_len + 1;
    let buf = alloc_n<char>((usize)total);
    let cursor: u32 = 0;
    raw {
        memcpy(buf + cursor, "(function anonymous(", 20);
    }
    cursor = cursor + prefix_len;
    if params_s.length > 0 {
        let pd = params_s.data;
        mem_copy<char>(buf + cursor, pd, (usize)params_s.length);
        cursor = cursor + params_s.length;
    }
    raw {
        memcpy(buf + cursor, "){\n", 3);
    }
    cursor = cursor + mid_len;
    if body_s.length > 0 {
        let bd = body_s.data;
        mem_copy<char>(buf + cursor, bd, (usize)body_s.length);
        cursor = cursor + body_s.length;
    }
    raw {
        memcpy(buf + cursor, "\n})", 3);
    }
    cursor = cursor + suffix_len;
    buf[cursor] = (char)0;

    // zjs_eval the wrapped expression. The function value is its result.
    let result = zjs_eval(ctx, buf);
    dealloc(buf);
    // zjs_eval routes parse / compile errors through ctx.had_error +
    // ctx.last_error. Convert them to the JS-visible throw channel.
    if ctx.had_error {
        let err = ctx.last_error;
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return result;
}

// --- Global Number-coercion helpers (Phase 3.8b) -------------------

fn host_is_nan(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(1); }
    let d = zjs_to_double(args[0]);
    let is_nan: int = 0;
    raw { is_nan = (d != d) ? 1 : 0; }
    return zjs_bool(is_nan);
}

fn host_is_finite(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let d = zjs_to_double(args[0]);
    let is_fin: int = 0;
    raw { is_fin = isfinite(d) ? 1 : 0; }
    return zjs_bool(is_fin);
}

fn host_parse_float(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    let sd = s.data;
    let parsed: f64 = 0.0;
    let n_consumed: int = 0;
    raw {
        char* endp = NULL;
        parsed = strtod(sd, &endp);
        n_consumed = (int)(endp - sd);
    }
    if n_consumed == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let as_int = (i32)parsed;
    if (f64)as_int == parsed { return zjs_int32(as_int); }
    return zjs_double(parsed);
}

fn host_parse_int(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    // ECMA-262: if radix is 0/undefined AND the string starts with 0x,
    // radix is 16; else 10. Start at 0 ("unset") and resolve below.
    let radix: int = 0;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let r = (i32)zjs_to_double(args[1]);
        if r != 0 { radix = (int)r; }
    }
    let sd = s.data;
    let parsed: i64 = 0;
    let n_consumed: int = 0;
    raw {
        char* endp = NULL;
        // Skip leading whitespace.
        const char* p = sd;
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' || *p == '\v' || *p == '\f') p++;
        // Optional sign.
        int neg = 0;
        if (*p == '-') { neg = 1; p++; }
        else if (*p == '+') p++;
        // 0x / 0X prefix selects hex.
        int rdx = radix;
        if ((rdx == 0 || rdx == 16) && p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
            p += 2;
            rdx = 16;
        }
        if (rdx == 0) rdx = 10;
        parsed = strtoll(p, &endp, rdx);
        n_consumed = (int)(endp - p);
        if (neg) parsed = -parsed;
    }
    if n_consumed == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    if parsed >= -2147483648 && parsed <= 2147483647 {
        return zjs_int32((i32)parsed);
    }
    return zjs_double((f64)parsed);
}

fn ctx_init_builtins(ctx: ZjsContext*) -> void {
    // --- Function.prototype.{call, apply} cached helpers (Phase 3.8d)
    let fcall_ptr:  void* = NULL; raw { fcall_ptr  = (void*)host_function_call; }
    let fapply_ptr: void* = NULL; raw { fapply_ptr = (void*)host_function_apply; }
    ctx.fn_call_v  = ctx_make_host_function(ctx, (char*)"call",  fcall_ptr);
    ctx.fn_apply_v = ctx_make_host_function(ctx, (char*)"apply", fapply_ptr);

    // --- Object.prototype (Phase 3.8c) ---
    // Bootstrap order: create this FIRST so every later ctx_new_object
    // call gets it as a default proto. ctx_new_object short-circuits
    // for the object_proto itself (whose proto stays NULL).
    let obj_proto_v = ctx_new_object(ctx);
    ctx.object_proto = zjs_as_object(obj_proto_v);
    let hop_ptr: void* = NULL; raw { hop_ptr = (void*)host_has_own_property; }
    let ipo_ptr: void* = NULL; raw { ipo_ptr = (void*)host_is_prototype_of; }
    let pie_ptr: void* = NULL; raw { pie_ptr = (void*)host_property_is_enumerable; }
    let ots_ptr: void* = NULL; raw { ots_ptr = (void*)host_object_to_string; }
    let ovo_ptr: void* = NULL; raw { ovo_ptr = (void*)host_object_value_of; }
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"hasOwnProperty", 14),
               ctx_make_host_function_arity(ctx, (char*)"hasOwnProperty", hop_ptr, 1));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"isPrototypeOf", 13),
               ctx_make_host_function_arity(ctx, (char*)"isPrototypeOf", ipo_ptr, 1));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"propertyIsEnumerable", 20),
               ctx_make_host_function_arity(ctx, (char*)"propertyIsEnumerable", pie_ptr, 1));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"toString", 8),
               ctx_make_host_function(ctx, (char*)"toString", ots_ptr));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"valueOf", 7),
               ctx_make_host_function(ctx, (char*)"valueOf", ovo_ptr));

    // --- Function.prototype (2026-05-15) ---
    // The [[Prototype]] for every callable. Carries the already-built
    // call/apply helpers so `Function.prototype.call` is reachable AND
    // a prototype-chain walk from any callable finds them.
    let function_proto_v = ctx_new_object(ctx);
    ctx.function_proto = zjs_as_object(function_proto_v);
    object_set(ctx, ctx.function_proto,
               ctx_intern_atom(ctx, (char*)"call", 4),  ctx.fn_call_v);
    object_set(ctx, ctx.function_proto,
               ctx_intern_atom(ctx, (char*)"apply", 5), ctx.fn_apply_v);

    // --- globalThis (2026-05-15) ---
    // Top-level `this` resolves to this object; property reads on it
    // fall through to the globals table (handled in property_get).
    // Tests like `var g = this; g.foo` rely on this.
    let global_this_v = ctx_new_object(ctx);
    ctx.global_this_obj = zjs_as_object(global_this_v);
    let gt_slot = ctx_intern_global(ctx, (char*)"globalThis", 10);
    ctx.globals[gt_slot].value = global_this_v;
    ctx.globals[gt_slot].defined = true;

    // --- Error ---
    let err_ptr: void* = NULL;
    raw { err_ptr = (void*)host_error; }
    ctx_register_host_function(ctx, (char*)"Error", err_ptr);

    // --- Numeric global constants (Phase 3.8b) ---
    let nan_d: f64 = 0.0;
    raw { nan_d = (double)NAN; }
    let nan_slot = ctx_intern_global(ctx, (char*)"NaN", 3);
    ctx.globals[nan_slot].value = zjs_double(nan_d);
    ctx.globals[nan_slot].defined = true;
    let inf_d: f64 = 0.0;
    raw { inf_d = (double)INFINITY; }
    let inf_slot = ctx_intern_global(ctx, (char*)"Infinity", 8);
    ctx.globals[inf_slot].value = zjs_double(inf_d);
    ctx.globals[inf_slot].defined = true;
    let undef_slot = ctx_intern_global(ctx, (char*)"undefined", 9);
    ctx.globals[undef_slot].value = zjs_undefined();
    ctx.globals[undef_slot].defined = true;

    // --- Global Number-coercion functions ---
    let isnan_ptr:   void* = NULL; raw { isnan_ptr   = (void*)host_is_nan; }
    let isfin_ptr:   void* = NULL; raw { isfin_ptr   = (void*)host_is_finite; }
    let pflt_ptr:    void* = NULL; raw { pflt_ptr    = (void*)host_parse_float; }
    let pint_ptr:    void* = NULL; raw { pint_ptr    = (void*)host_parse_int; }
    ctx_register_host_function(ctx, (char*)"isNaN",      isnan_ptr);
    ctx_register_host_function(ctx, (char*)"isFinite",   isfin_ptr);
    ctx_register_host_function(ctx, (char*)"parseFloat", pflt_ptr);
    ctx_register_host_function(ctx, (char*)"parseInt",   pint_ptr);

    // --- Array constructor + Array.isArray (Phase 3.8c) ---
    let arr_ctor_ptr: void* = NULL; raw { arr_ctor_ptr = (void*)host_array_ctor; }
    let arr_ctor_v = ctx_register_host_function(ctx, (char*)"Array", arr_ctor_ptr);
    let arr_ctor = zjs_as_host_function(arr_ctor_v);
    let arr_is_ptr: void* = NULL; raw { arr_is_ptr = (void*)host_array_is_array; }
    let is_array_v = ctx_make_host_function(ctx, (char*)"isArray", arr_is_ptr);
    // Attach isArray to Array via the host function's `props` bag.
    let isarray_atom = ctx_intern_atom(ctx, (char*)"isArray", 7);
    let props_v = ctx_new_object(ctx);
    arr_ctor.props = zjs_as_object(props_v);
    object_set(ctx, arr_ctor.props, isarray_atom, is_array_v);
    // Array.prototype is unified with ctx.array_proto below, after
    // the prototype object is fully populated.

    // --- Coercion-style constructors + Error subtypes (Phase 3.8c) ---
    let bool_ptr:    void* = NULL; raw { bool_ptr    = (void*)host_boolean; }
    let num_ptr:     void* = NULL; raw { num_ptr     = (void*)host_number; }
    let str_ptr:     void* = NULL; raw { str_ptr     = (void*)host_string; }
    let referr_ptr:  void* = NULL; raw { referr_ptr  = (void*)host_reference_error; }
    let typerr_ptr:  void* = NULL; raw { typerr_ptr  = (void*)host_type_error; }
    let rngerr_ptr:  void* = NULL; raw { rngerr_ptr  = (void*)host_range_error; }
    let eval_ptr:    void* = NULL; raw { eval_ptr    = (void*)host_eval_stub; }
    let bool_full = ctx_register_host_function(ctx, (char*)"Boolean", bool_ptr);
    let num_full  = ctx_register_host_function(ctx, (char*)"Number",  num_ptr);
    let strv_full = ctx_register_host_function(ctx, (char*)"String",  str_ptr);
    // Attach String.fromCharCode via .props on the constructor.
    let strv_hf = zjs_as_host_function(strv_full);
    let fcc_ptr: void* = NULL; raw { fcc_ptr = (void*)host_string_from_char_code; }
    let fcc_v = ctx_make_host_function(ctx, (char*)"fromCharCode", fcc_ptr);
    if strv_hf.props == NULL {
        let pv = ctx_new_object(ctx);
        strv_hf.props = zjs_as_object(pv);
    }
    object_set(ctx, strv_hf.props,
               ctx_intern_atom(ctx, (char*)"fromCharCode", 12), fcc_v);
    let raw_ptr: void* = NULL; raw { raw_ptr = (void*)host_string_raw; }
    let raw_v = ctx_make_host_function_arity(ctx, (char*)"raw", raw_ptr, 1);
    object_set(ctx, strv_hf.props,
               ctx_intern_atom(ctx, (char*)"raw", 3), raw_v);
    // Phase 3.8i — wrapper-object prototypes.
