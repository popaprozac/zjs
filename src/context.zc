    let s  = temporal_int_arg(args, argc, 2, 0, &ok);
    let ms = temporal_int_arg(args, argc, 3, 0, &ok);
    let us = temporal_int_arg(args, argc, 4, 0, &ok);
    let ns = temporal_int_arg(args, argc, 5, 0, &ok);
    if ok == 0 { return temporal_range_error(ctx, (char*)"PlainTime fields must be integers", 32); }
    if !temporal_time_valid(h, mi, s, ms, us, ns) { return temporal_range_error(ctx, (char*)"invalid time", 12); }
    let t = zjs_temporal_new(TMP_PLAIN_TIME);
    t.hour = (i32)h; t.minute = (i32)mi; t.second = (i32)s;
    t.millisecond = (i32)ms; t.microsecond = (i32)us; t.nanosecond = (i32)ns;
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

