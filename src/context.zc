    // === Headers / Response / fetch — web-API Phase D.0 (2026-05-18). ===
    let h_ctor_ptr: void* = NULL; raw { h_ctor_ptr = (void*)host_headers_ctor; }
    let h_ctor_v = ctx_register_host_function(ctx, (char*)"Headers", h_ctor_ptr);
    let h_proto_v = ctx_new_object(ctx);
    ctx.headers_proto = zjs_as_object(h_proto_v);
    zjs_as_host_function(h_ctor_v).prototype = ctx.headers_proto;
    object_set(ctx, ctx.headers_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), h_ctor_v);
    // Iteration default is entries (Headers walks name/value pairs).
    // `append` combines values with ", "; `set` replaces (spec
    // distinction — the WinterTC suite caught us aliasing them earlier).
    let h_table_p: void* = NULL;
    let h_table_n: usize = 0;
    raw {
        static const ZjsBuiltinSpec headers_proto_specs[] = {
            {"get",         3, (void*)host_headers_get,       1},
            {"set",         3, (void*)host_headers_set,       2},
            {"has",         3, (void*)host_headers_has,       1},
            {"append",      6, (void*)host_headers_append,    2},
            {"delete",      6, (void*)host_headers_delete,    1},
            {"forEach",     7, (void*)host_headers_for_each,  1},
            {"keys",        4, (void*)host_headers_keys,     -1},
            {"values",      6, (void*)host_headers_values,   -1},
            {"entries",     7, (void*)host_headers_entries,  -1},
            {"@@iterator", 10, (void*)host_headers_entries,  -1},
        };
        h_table_p = (void*)headers_proto_specs;
        h_table_n = sizeof(headers_proto_specs) / sizeof(headers_proto_specs[0]);
    }
    zjs_install_methods(ctx, ctx.headers_proto, h_table_p, h_table_n);

    let r_status_ptr:   void* = NULL; raw { r_status_ptr   = (void*)host_response_status; }
    let r_ok_ptr:       void* = NULL; raw { r_ok_ptr       = (void*)host_response_ok; }
    let r_stext_ptr:    void* = NULL; raw { r_stext_ptr    = (void*)host_response_status_text; }
    let r_url_ptr:      void* = NULL; raw { r_url_ptr      = (void*)host_response_url; }
    let r_hdrs_ptr:     void* = NULL; raw { r_hdrs_ptr     = (void*)host_response_headers_acc; }
    let r_text_ptr:     void* = NULL; raw { r_text_ptr     = (void*)host_response_text; }
    let r_ab_ptr:       void* = NULL; raw { r_ab_ptr       = (void*)host_response_array_buffer; }
    let r_json_ptr:     void* = NULL; raw { r_json_ptr     = (void*)host_response_json; }
