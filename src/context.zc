    let pall_ptr:  void* = NULL; raw { pall_ptr  = (void*)host_promise_all; }
    let prace_ptr: void* = NULL; raw { prace_ptr = (void*)host_promise_race; }
    object_set(ctx, promise_hf.props, ctx_intern_atom(ctx, (char*)"all", 3),
