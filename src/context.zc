    let fetch_ptr: void* = NULL; raw { fetch_ptr = (void*)host_fetch; }
    ctx_register_host_function(ctx, (char*)"fetch", fetch_ptr);
    ctx_register_host_function(ctx, (char*)"WeakRef",           eval_ptr);
    ctx_register_host_function(ctx, (char*)"FinalizationRegistry", eval_ptr);
    let synerr_ptr:  void* = NULL; raw { synerr_ptr  = (void*)host_syntax_error_ctor; }
    let urierr_ptr:  void* = NULL; raw { urierr_ptr  = (void*)host_uri_error; }
    let evlerr_ptr:  void* = NULL; raw { evlerr_ptr  = (void*)host_eval_error; }
    let aggerr_ptr:  void* = NULL; raw { aggerr_ptr  = (void*)host_aggregate_error_ctor; }
    let evlerr_v = ctx_register_host_function(ctx, (char*)"EvalError",   evlerr_ptr);
    let urierr_v = ctx_register_host_function(ctx, (char*)"URIError",    urierr_ptr);
    let synerr_v = ctx_register_host_function(ctx, (char*)"SyntaxError", synerr_ptr);
    let aggerr_v = ctx_register_host_function(ctx, (char*)"AggregateError", aggerr_ptr);
    // Chain these *Error.prototype → Error.prototype as well.
    let err_slot2 = ctx_find_global(ctx, (char*)"Error", 5);
    if err_slot2 >= 0 {
        let err_v2 = ctx.globals[err_slot2].value;
        if zjs_is_host_function(err_v2) != 0 {
            let err_hf2 = zjs_as_host_function(err_v2);
            if err_hf2.prototype != NULL {
                let extras: ZjsValue[4];
                extras[0] = evlerr_v; extras[1] = urierr_v; extras[2] = synerr_v;
                extras[3] = aggerr_v;
                let i: u32 = 0;
                while i < 4 {
                    let hv = extras[i];
                    if zjs_is_host_function(hv) != 0 {
                        let hf = zjs_as_host_function(hv);
                        if hf.prototype == NULL {
                            let pp_v = ctx_new_object(ctx);
                            hf.prototype = zjs_as_object(pp_v);
                        }
                        hf.prototype.proto = err_hf2.prototype;
                        hf.proto_override = err_v2;
                        // Same constructor self-link as the first
                        // *Error block — (new SyntaxError()).constructor
                        // === SyntaxError, etc.
                        object_set(ctx, hf.prototype,
                                   ctx_intern_atom(ctx, (char*)"constructor", 11), hv);
                    }
                    i = i + 1;
                }
            }
        }
    }
    // $262 — test262's per-context helper object. We don't implement
    // any of its methods; register as a plain empty object.
    let t262_v = ctx_new_object(ctx);
    let t262_slot = ctx_intern_global(ctx, (char*)"$262", 4);
    ctx.globals[t262_slot].value = t262_v;
    ctx.globals[t262_slot].defined = true;

