    object_set(ctx, ctx.temporal_monthday_proto, ctx_intern_atom(ctx, (char*)"equals", 6),
               ctx_make_host_function(ctx, (char*)"equals", mdeq_ptr));
    object_set(ctx, ctx.temporal_monthday_proto, ctx_intern_atom(ctx, (char*)"toPlainDate", 11),
               ctx_make_host_function(ctx, (char*)"toPlainDate", md2d_ptr));
    object_set(ctx, ctx.temporal_monthday_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), md_ctor);
    let mdfrom_ptr: void* = NULL; raw { mdfrom_ptr = (void*)host_temporal_monthday_from; }
    property_set(ctx, md_ctor, ctx_intern_string(ctx, (char*)"from", 4),
                 ctx_make_host_function(ctx, (char*)"from", mdfrom_ptr));
    object_set(ctx, temporal_o, ctx_intern_atom(ctx, (char*)"PlainMonthDay", 13), md_ctor);

    // --- Temporal.ZonedDateTime ---
    let zdt_ctor_ptr: void* = NULL; raw { zdt_ctor_ptr = (void*)host_temporal_zoneddatetime_ctor; }
    let zdt_ctor = ctx_make_host_function(ctx, (char*)"ZonedDateTime", zdt_ctor_ptr);
    let zdt_proto_v = ctx_new_object(ctx);
    ctx.temporal_zoneddatetime_proto = zjs_as_object(zdt_proto_v);
    zjs_as_host_function(zdt_ctor).prototype = ctx.temporal_zoneddatetime_proto;
    let zts_ptr: void* = NULL; raw { zts_ptr = (void*)host_temporal_zdt_to_string; }
    let zti_ptr: void* = NULL; raw { zti_ptr = (void*)host_temporal_zdt_to_instant; }
    let ztd_ptr: void* = NULL; raw { ztd_ptr = (void*)host_temporal_zdt_to_plain_datetime; }
    let zeq_ptr: void* = NULL; raw { zeq_ptr = (void*)host_temporal_zdt_equals; }
    let zts_fn = ctx_make_host_function(ctx, (char*)"toString", zts_ptr);
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"toString", 8), zts_fn);
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"toJSON", 6), zts_fn);
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"toInstant", 9),
               ctx_make_host_function(ctx, (char*)"toInstant", zti_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"toPlainDateTime", 15),
               ctx_make_host_function(ctx, (char*)"toPlainDateTime", ztd_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"equals", 6),
               ctx_make_host_function(ctx, (char*)"equals", zeq_ptr));
    let zadd_ptr: void* = NULL; raw { zadd_ptr = (void*)host_temporal_zdt_add; }
    let zsub_ptr: void* = NULL; raw { zsub_ptr = (void*)host_temporal_zdt_subtract; }
    let zwith_ptr: void* = NULL; raw { zwith_ptr = (void*)host_temporal_zdt_with; }
    let zrnd_ptr: void* = NULL; raw { zrnd_ptr = (void*)host_temporal_zdt_round; }
    let zunt_ptr: void* = NULL; raw { zunt_ptr = (void*)host_temporal_zdt_until; }
    let zsin_ptr: void* = NULL; raw { zsin_ptr = (void*)host_temporal_zdt_since; }
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"add", 3),
               ctx_make_host_function(ctx, (char*)"add", zadd_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"subtract", 8),
               ctx_make_host_function(ctx, (char*)"subtract", zsub_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"with", 4),
               ctx_make_host_function(ctx, (char*)"with", zwith_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"round", 5),
               ctx_make_host_function(ctx, (char*)"round", zrnd_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"until", 5),
               ctx_make_host_function(ctx, (char*)"until", zunt_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"since", 5),
               ctx_make_host_function(ctx, (char*)"since", zsin_ptr));
    object_set(ctx, ctx.temporal_zoneddatetime_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), zdt_ctor);
    let zcmp_ptr: void* = NULL; raw { zcmp_ptr = (void*)host_temporal_zdt_compare; }
    let zfrom_ptr: void* = NULL; raw { zfrom_ptr = (void*)host_temporal_zdt_from; }
    property_set(ctx, zdt_ctor, ctx_intern_string(ctx, (char*)"compare", 7),
                 ctx_make_host_function(ctx, (char*)"compare", zcmp_ptr));
    property_set(ctx, zdt_ctor, ctx_intern_string(ctx, (char*)"from", 4),
                 ctx_make_host_function(ctx, (char*)"from", zfrom_ptr));
    object_set(ctx, temporal_o, ctx_intern_atom(ctx, (char*)"ZonedDateTime", 13), zdt_ctor);

    // --- Temporal.Now ---
    let now_v = ctx_new_object(ctx);
    let now_o = zjs_as_object(now_v);
    object_set(ctx, now_o, ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN),
               ctx_intern_string(ctx, (char*)"Now", 3));
    let now_inst_ptr: void* = NULL; raw { now_inst_ptr = (void*)host_temporal_now_instant; }
    let now_tz_ptr: void* = NULL; raw { now_tz_ptr = (void*)host_temporal_now_timezone_id; }
    object_set(ctx, now_o, ctx_intern_atom(ctx, (char*)"instant", 7),
               ctx_make_host_function(ctx, (char*)"instant", now_inst_ptr));
    object_set(ctx, now_o, ctx_intern_atom(ctx, (char*)"timeZoneId", 10),
               ctx_make_host_function(ctx, (char*)"timeZoneId", now_tz_ptr));
    let now_pdt_ptr: void* = NULL; raw { now_pdt_ptr = (void*)host_temporal_now_plaindatetime_iso; }
    let now_pd_ptr: void* = NULL; raw { now_pd_ptr = (void*)host_temporal_now_plaindate_iso; }
    let now_pt_ptr: void* = NULL; raw { now_pt_ptr = (void*)host_temporal_now_plaintime_iso; }
    object_set(ctx, now_o, ctx_intern_atom(ctx, (char*)"plainDateTimeISO", 16),
               ctx_make_host_function(ctx, (char*)"plainDateTimeISO", now_pdt_ptr));
    object_set(ctx, now_o, ctx_intern_atom(ctx, (char*)"plainDateISO", 12),
               ctx_make_host_function(ctx, (char*)"plainDateISO", now_pd_ptr));
    object_set(ctx, now_o, ctx_intern_atom(ctx, (char*)"plainTimeISO", 12),
               ctx_make_host_function(ctx, (char*)"plainTimeISO", now_pt_ptr));
    let now_zdt_ptr: void* = NULL; raw { now_zdt_ptr = (void*)host_temporal_now_zoneddatetime_iso; }
    object_set(ctx, now_o, ctx_intern_atom(ctx, (char*)"zonedDateTimeISO", 16),
               ctx_make_host_function(ctx, (char*)"zonedDateTimeISO", now_zdt_ptr));
    object_set(ctx, temporal_o, ctx_intern_atom(ctx, (char*)"Now", 3), now_v);

    let temporal_slot = ctx_intern_global(ctx, (char*)"Temporal", 8);
    ctx.globals[temporal_slot].value = temporal_v;
    ctx.globals[temporal_slot].defined = true;
}

fn ctx_init_builtins(ctx: ZjsContext*) -> void {
    // --- Function.prototype.{call, apply} cached helpers (Phase 3.8d)
    let fcall_ptr:  void* = NULL; raw { fcall_ptr  = (void*)host_function_call; }
    let fapply_ptr: void* = NULL; raw { fapply_ptr = (void*)host_function_apply; }
    ctx.fn_call_v  = ctx_make_host_function(ctx, (char*)"call",  fcall_ptr);
    ctx.fn_apply_v = ctx_make_host_function(ctx, (char*)"apply", fapply_ptr);

    // --- Object.prototype (Phase 3.8c) ---
    // Bootstrap order: create this FIRST so every later ctx_new_object
    // call gets it as a default proto. ctx_new_object short-circuits
    // for the object_proto itself (whose proto stays NULL).
    let obj_proto_v = ctx_new_object(ctx);
    ctx.object_proto = zjs_as_object(obj_proto_v);
    let hop_ptr: void* = NULL; raw { hop_ptr = (void*)host_has_own_property; }
    let ipo_ptr: void* = NULL; raw { ipo_ptr = (void*)host_is_prototype_of; }
    let pie_ptr: void* = NULL; raw { pie_ptr = (void*)host_property_is_enumerable; }
    let ots_ptr: void* = NULL; raw { ots_ptr = (void*)host_object_to_string; }
    let ovo_ptr: void* = NULL; raw { ovo_ptr = (void*)host_object_value_of; }
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"hasOwnProperty", 14),
               ctx_make_host_function_arity(ctx, (char*)"hasOwnProperty", hop_ptr, 1));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"isPrototypeOf", 13),
               ctx_make_host_function_arity(ctx, (char*)"isPrototypeOf", ipo_ptr, 1));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"propertyIsEnumerable", 20),
               ctx_make_host_function_arity(ctx, (char*)"propertyIsEnumerable", pie_ptr, 1));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"toString", 8),
               ctx_make_host_function(ctx, (char*)"toString", ots_ptr));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"valueOf", 7),
               ctx_make_host_function(ctx, (char*)"valueOf", ovo_ptr));

    // --- Function.prototype (2026-05-15) ---
    // The [[Prototype]] for every callable. Carries the already-built
    // call/apply helpers so `Function.prototype.call` is reachable AND
    // a prototype-chain walk from any callable finds them.
    let function_proto_v = ctx_new_object(ctx);
    ctx.function_proto = zjs_as_object(function_proto_v);
    object_set(ctx, ctx.function_proto,
               ctx_intern_atom(ctx, (char*)"call", 4),  ctx.fn_call_v);
    object_set(ctx, ctx.function_proto,
               ctx_intern_atom(ctx, (char*)"apply", 5), ctx.fn_apply_v);
    let fbind_ptr: void* = NULL; raw { fbind_ptr = (void*)host_function_bind; }
    object_set(ctx, ctx.function_proto,
               ctx_intern_atom(ctx, (char*)"bind", 4),
               ctx_make_host_function_arity(ctx, (char*)"bind", fbind_ptr, 1));
    let fts_ptr: void* = NULL; raw { fts_ptr = (void*)host_function_to_string; }
    object_set(ctx, ctx.function_proto,
               ctx_intern_atom(ctx, (char*)"toString", 8),
               ctx_make_host_function_arity(ctx, (char*)"toString", fts_ptr, 0));

    // --- globalThis (2026-05-15) ---
    // Top-level `this` resolves to this object; property reads on it
    // fall through to the globals table (handled in property_get).
    // Tests like `var g = this; g.foo` rely on this.
    let global_this_v = ctx_new_object(ctx);
    ctx.global_this_obj = zjs_as_object(global_this_v);
    let gt_slot = ctx_intern_global(ctx, (char*)"globalThis", 10);
    ctx.globals[gt_slot].value = global_this_v;
    ctx.globals[gt_slot].defined = true;

    // --- Error ---
    let err_ptr: void* = NULL;
    raw { err_ptr = (void*)host_error; }
    ctx_register_host_function(ctx, (char*)"Error", err_ptr);

    // --- Numeric global constants (Phase 3.8b) ---
    let nan_d: f64 = 0.0;
    raw { nan_d = (double)NAN; }
    let nan_slot = ctx_intern_global(ctx, (char*)"NaN", 3);
    ctx.globals[nan_slot].value = zjs_double(nan_d);
    ctx.globals[nan_slot].defined = true;
    let inf_d: f64 = 0.0;
    raw { inf_d = (double)INFINITY; }
    let inf_slot = ctx_intern_global(ctx, (char*)"Infinity", 8);
    ctx.globals[inf_slot].value = zjs_double(inf_d);
    ctx.globals[inf_slot].defined = true;
    let undef_slot = ctx_intern_global(ctx, (char*)"undefined", 9);
    ctx.globals[undef_slot].value = zjs_undefined();
    ctx.globals[undef_slot].defined = true;

    // --- Global Number-coercion functions ---
    let isnan_ptr:   void* = NULL; raw { isnan_ptr   = (void*)host_is_nan; }
    let isfin_ptr:   void* = NULL; raw { isfin_ptr   = (void*)host_is_finite; }
    let pflt_ptr:    void* = NULL; raw { pflt_ptr    = (void*)host_parse_float; }
    let pint_ptr:    void* = NULL; raw { pint_ptr    = (void*)host_parse_int; }
    ctx_register_host_function(ctx, (char*)"isNaN",      isnan_ptr);
    ctx_register_host_function(ctx, (char*)"isFinite",   isfin_ptr);
    ctx_register_host_function(ctx, (char*)"parseFloat", pflt_ptr);
    ctx_register_host_function(ctx, (char*)"parseInt",   pint_ptr);

    // --- Array constructor + Array.isArray (Phase 3.8c) ---
    let arr_ctor_ptr: void* = NULL; raw { arr_ctor_ptr = (void*)host_array_ctor; }
    let arr_ctor_v = ctx_register_host_function(ctx, (char*)"Array", arr_ctor_ptr);
    let arr_ctor = zjs_as_host_function(arr_ctor_v);
    let arr_is_ptr: void* = NULL; raw { arr_is_ptr = (void*)host_array_is_array; }
    let is_array_v = ctx_make_host_function(ctx, (char*)"isArray", arr_is_ptr);
    // Attach isArray to Array via the host function's `props` bag.
    let isarray_atom = ctx_intern_atom(ctx, (char*)"isArray", 7);
    let props_v = ctx_new_object(ctx);
    arr_ctor.props = zjs_as_object(props_v);
    object_set(ctx, arr_ctor.props, isarray_atom, is_array_v);
    // Array.prototype is unified with ctx.array_proto below, after
    // the prototype object is fully populated.

    // --- Coercion-style constructors + Error subtypes (Phase 3.8c) ---
    let bool_ptr:    void* = NULL; raw { bool_ptr    = (void*)host_boolean; }
    let num_ptr:     void* = NULL; raw { num_ptr     = (void*)host_number; }
    let str_ptr:     void* = NULL; raw { str_ptr     = (void*)host_string; }
    let referr_ptr:  void* = NULL; raw { referr_ptr  = (void*)host_reference_error; }
    let typerr_ptr:  void* = NULL; raw { typerr_ptr  = (void*)host_type_error; }
    let rngerr_ptr:  void* = NULL; raw { rngerr_ptr  = (void*)host_range_error; }
    let eval_ptr:    void* = NULL; raw { eval_ptr    = (void*)host_eval_stub; }
    let bool_full = ctx_register_host_function(ctx, (char*)"Boolean", bool_ptr);
    let num_full  = ctx_register_host_function(ctx, (char*)"Number",  num_ptr);
    let strv_full = ctx_register_host_function(ctx, (char*)"String",  str_ptr);
    // Attach String.fromCharCode via .props on the constructor.
    let strv_hf = zjs_as_host_function(strv_full);
    let fcc_ptr: void* = NULL; raw { fcc_ptr = (void*)host_string_from_char_code; }
    let fcc_v = ctx_make_host_function(ctx, (char*)"fromCharCode", fcc_ptr);
    if strv_hf.props == NULL {
        let pv = ctx_new_object(ctx);
        strv_hf.props = zjs_as_object(pv);
    }
    object_set(ctx, strv_hf.props,
               ctx_intern_atom(ctx, (char*)"fromCharCode", 12), fcc_v);
    let raw_ptr: void* = NULL; raw { raw_ptr = (void*)host_string_raw; }
    let raw_v = ctx_make_host_function_arity(ctx, (char*)"raw", raw_ptr, 1);
    object_set(ctx, strv_hf.props,
               ctx_intern_atom(ctx, (char*)"raw", 3), raw_v);
    // Phase 3.8i — wrapper-object prototypes.
    //   new Number(x)  → { __zjs_primitive__: x } with proto = Number.prototype.
    // The prototype carries valueOf / toString that unwrap the slot,
    // so `new Number(1) + 1` triggers ToPrimitive → valueOf → 1 → 2.
    let wv_ptr: void* = NULL; raw { wv_ptr = (void*)host_wrapper_value_of; }
    let wt_ptr: void* = NULL; raw { wt_ptr = (void*)host_wrapper_to_string; }
    let bool_hf = zjs_as_host_function(bool_full);
    let num_hf  = zjs_as_host_function(num_full);
    let valueof_atom  = ctx_intern_atom(ctx, (char*)"valueOf",  7);
    let tostring_atom = ctx_intern_atom(ctx, (char*)"toString", 8);
    // Boolean.prototype
    let bp = ctx_new_object(ctx);
    bool_hf.prototype = zjs_as_object(bp);
    object_set(ctx, bool_hf.prototype, ctx_intern_atom(ctx, (char*)"constructor", 11), bool_full);
    object_set(ctx, bool_hf.prototype, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, bool_hf.prototype, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));
    // Number.prototype
    let np = ctx_new_object(ctx);
    num_hf.prototype = zjs_as_object(np);
    object_set(ctx, num_hf.prototype, ctx_intern_atom(ctx, (char*)"constructor", 11), num_full);
    object_set(ctx, num_hf.prototype, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    // Number.prototype.toString takes a radix argument, unlike the
    // shared wrapper toString used by Boolean/String.
    let nts_ptr: void* = NULL; raw { nts_ptr = (void*)host_number_to_string; }
    object_set(ctx, num_hf.prototype, tostring_atom,
               ctx_make_host_function_arity(ctx, (char*)"toString", nts_ptr, 1));
    let ntf_ptr: void* = NULL; raw { ntf_ptr = (void*)host_number_to_fixed; }
    object_set(ctx, num_hf.prototype, ctx_intern_atom(ctx, (char*)"toFixed", 7),
               ctx_make_host_function_arity(ctx, (char*)"toFixed", ntf_ptr, 1));
    // Number.* static constants (ECMA-262 §21.1.2).
    if num_hf.props == NULL {
        let pv = ctx_new_object(ctx);
        num_hf.props = zjs_as_object(pv);
    }
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MAX_VALUE",         9),
               zjs_double(1.7976931348623157e+308));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MIN_VALUE",         9),
               zjs_double(5e-324));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"POSITIVE_INFINITY", 17),
               zjs_double(1.0 / 0.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"NEGATIVE_INFINITY", 17),
               zjs_double(-1.0 / 0.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"NaN",                3),
               zjs_double(0.0 / 0.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"EPSILON",            7),
               zjs_double(2.220446049250313e-16));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MAX_SAFE_INTEGER",  16),
               zjs_double(9007199254740991.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MIN_SAFE_INTEGER",  16),
               zjs_double(-9007199254740991.0));
    // String.prototype (existing one — keep its methods, add valueOf/toString)
    if strv_hf.prototype == NULL {
        let sp = ctx_new_object(ctx);
        strv_hf.prototype = zjs_as_object(sp);
    }
    object_set(ctx, strv_hf.prototype, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, strv_hf.prototype, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));
    let referr_v = ctx_register_host_function(ctx, (char*)"ReferenceError", referr_ptr);
    let typerr_v = ctx_register_host_function(ctx, (char*)"TypeError",      typerr_ptr);
    let rngerr_v = ctx_register_host_function(ctx, (char*)"RangeError",     rngerr_ptr);

    // Chain *Error.prototype → Error.prototype so `new TypeError instanceof Error` etc.
    // Lazily create each prototype, then set its proto.
    let err_slot = ctx_find_global(ctx, (char*)"Error", 5);
    if err_slot >= 0 {
        let err_v = ctx.globals[err_slot].value;
        if zjs_is_host_function(err_v) != 0 {
            let err_hf = zjs_as_host_function(err_v);
            if err_hf.prototype == NULL {
                let p_v = ctx_new_object(ctx);
                err_hf.prototype = zjs_as_object(p_v);
            }
            let err_proto = err_hf.prototype;
            // Error.prototype.constructor / .toString.
            object_set(ctx, err_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), err_v);
            let ets_ptr: void* = NULL; raw { ets_ptr = (void*)host_error_to_string; }
            object_set(ctx, err_proto, ctx_intern_atom(ctx, (char*)"toString", 8),
                       ctx_make_host_function(ctx, (char*)"toString", ets_ptr));
            // Subclass each *Error.prototype to inherit from Error.prototype,
            // AND set [[Prototype]] = Error so `Object.getPrototypeOf(TypeError)
            // === Error` per spec.
            let subs: ZjsValue[3];
            subs[0] = referr_v; subs[1] = typerr_v; subs[2] = rngerr_v;
            let i: u32 = 0;
            while i < 3 {
                let hv = subs[i];
                if zjs_is_host_function(hv) != 0 {
                    let hf = zjs_as_host_function(hv);
                    if hf.prototype == NULL {
                        let pp_v = ctx_new_object(ctx);
                        hf.prototype = zjs_as_object(pp_v);
                    }
                    hf.prototype.proto = err_proto;
                    hf.proto_override = err_v;
                    // <Subclass>.prototype.constructor = <Subclass>, so
                    // `(new TypeError).constructor === TypeError` per
                    // spec — and so test262's assert.throws can
                    // discriminate against the constructor.
                    object_set(ctx, hf.prototype,
                               ctx_intern_atom(ctx, (char*)"constructor", 11), hv);
                }
                i = i + 1;
            }
        }
    }
    ctx_register_host_function(ctx, (char*)"eval",           eval_ptr);

    // Stub globals for unsupported features. Their tests use the
    // names without expecting full semantics — registering them as
    // host-function no-ops at least avoids ReferenceError-on-load.
    // Function constructor: runtime-compile the body string into a
    // real callable, with [[Prototype]] = Function.prototype so
    // `Object.getPrototypeOf(<any callable>) === Function.prototype`.
    let fn_ctor_ptr: void* = NULL; raw { fn_ctor_ptr = (void*)host_function_ctor; }
    let function_ctor_v = ctx_register_host_function(ctx, (char*)"Function", fn_ctor_ptr);
    let function_ctor_hf = zjs_as_host_function(function_ctor_v);
    function_ctor_hf.prototype = ctx.function_proto;
    if ctx.function_proto != NULL {
        object_set(ctx, ctx.function_proto,
                   ctx_intern_atom(ctx, (char*)"constructor", 11), function_ctor_v);
    }
    // Date (2026-05-16). UTC-only ms-since-epoch; locale-aware
    // formatting deferred to Intl.
    let date_ctor_ptr:  void* = NULL; raw { date_ctor_ptr  = (void*)host_date_ctor; }
    let date_now_ptr:   void* = NULL; raw { date_now_ptr   = (void*)host_date_now_static; }
    let date_parse_ptr: void* = NULL; raw { date_parse_ptr = (void*)host_date_parse_static; }
    let date_utc_ptr:   void* = NULL; raw { date_utc_ptr   = (void*)host_date_utc_static; }
    let date_ctor_v = ctx_register_host_function(ctx, (char*)"Date", date_ctor_ptr);
    let date_hf = zjs_as_host_function(date_ctor_v);
    // ECMA-262 §21.4.2 — Date constructor's `length` is 7.
    date_hf.arity = 7;
    // Statics on Date itself (Date.now / Date.parse / Date.UTC).
    if date_hf.props == NULL {
        let pv = ctx_new_object(ctx);
        date_hf.props = zjs_as_object(pv);
    }
    object_set(ctx, date_hf.props, ctx_intern_atom(ctx, (char*)"now", 3),
               ctx_make_host_function_arity(ctx, (char*)"now",   date_now_ptr,   0));
    object_set(ctx, date_hf.props, ctx_intern_atom(ctx, (char*)"parse", 5),
               ctx_make_host_function_arity(ctx, (char*)"parse", date_parse_ptr, 1));
    object_set(ctx, date_hf.props, ctx_intern_atom(ctx, (char*)"UTC", 3),
               ctx_make_host_function_arity(ctx, (char*)"UTC",   date_utc_ptr,   7));
    // Prototype.
    let date_proto_v = ctx_new_object(ctx);
    ctx.date_proto = zjs_as_object(date_proto_v);
    date_hf.prototype = ctx.date_proto;
    object_set(ctx, ctx.date_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), date_ctor_v);
    // Date.prototype methods (table-driven — see zjs_install_methods).
    // Pragmatic v0.1: all toX-String / toLocaleX-String methods alias to
    // toString (ISO format). The host-fn presence is what most test262
    // tests probe — these aliases satisfy hasOwnProperty + call-through.
    let date_table_p: void* = NULL;
