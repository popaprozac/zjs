    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"includes", 8),
               ctx_make_host_function_arity(ctx, (char*)"includes", sinc_ptr, 1));
    // String.prototype[Symbol.iterator] — character iteration via the
