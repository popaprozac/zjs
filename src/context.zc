    let json_slot = ctx_intern_global(ctx, (char*)"JSON", 4);
    ctx.globals[json_slot].value = json_v;
    ctx.globals[json_slot].defined = true;

    // --- console (Phase 3.8a) ---
    let console_v = ctx_new_object(ctx);
    let console_o = zjs_as_object(console_v);
    let log_ptr:   void* = NULL; raw { log_ptr   = (void*)host_console_log; }
    let info_ptr:  void* = NULL; raw { info_ptr  = (void*)host_console_info; }
    let warn_ptr:  void* = NULL; raw { warn_ptr  = (void*)host_console_warn; }
    let cerr_ptr:  void* = NULL; raw { cerr_ptr  = (void*)host_console_error; }
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"log", 3),
               ctx_make_host_function(ctx, (char*)"log", log_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"info", 4),
               ctx_make_host_function(ctx, (char*)"info", info_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"warn", 4),
               ctx_make_host_function(ctx, (char*)"warn", warn_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"error", 5),
               ctx_make_host_function(ctx, (char*)"error", cerr_ptr));
    let console_slot = ctx_intern_global(ctx, (char*)"console", 7);
    ctx.globals[console_slot].value = console_v;
    ctx.globals[console_slot].defined = true;

    // Mark every property on every built-in prototype as
    // non-enumerable. Per spec, ALL methods on Object.prototype,
    // Array.prototype, String.prototype, etc. — and Math's constants
    // like PI / E — are { writable: true, configurable: true,
    // enumerable: FALSE }. Our bootstrap installs them via plain
    // object_set which gives PROP_DEFAULT (enumerable=true). Sweep
    // those bits off in one pass so Object.keys / for-in / the
    // descriptor walk in Object.create({}, SomeProto) all see them
    // as non-enumerable.
    proto_mark_nonenum(ctx.object_proto);
    proto_mark_nonenum(ctx.array_proto);
    proto_mark_nonenum(ctx.string_proto);
    proto_mark_nonenum(ctx.regexp_proto);
    proto_mark_nonenum(ctx.promise_ctor_proto);
    // Prototype methods are not constructors per spec — `new
    // Array.prototype.push()` should throw TypeError. Mark them now
    // that the method tables are installed.
    mark_proto_methods_non_constructor(ctx, ctx.object_proto);
    mark_proto_methods_non_constructor(ctx, ctx.array_proto);
    mark_proto_methods_non_constructor(ctx, ctx.string_proto);
    mark_proto_methods_non_constructor(ctx, ctx.regexp_proto);
    mark_proto_methods_non_constructor(ctx, ctx.promise_ctor_proto);
    mark_proto_methods_non_constructor(ctx, ctx.generator_proto);
    mark_proto_methods_non_constructor(ctx, ctx.map_proto);
    mark_proto_methods_non_constructor(ctx, ctx.set_proto);
    mark_proto_methods_non_constructor(ctx, ctx.date_proto);
    mark_proto_methods_non_constructor(ctx, ctx.symbol_proto);
    // Wrapper prototypes (Number.prototype, Boolean.prototype) and
    // Math live as the .prototype of their constructor or as a plain
    // global. Walk via the global table.
    let num_g = ctx_find_global(ctx, (char*)"Number", 6);
    if num_g >= 0 {
        let nv = ctx.globals[num_g].value;
        if zjs_is_host_function(nv) != 0 {
            proto_mark_nonenum(zjs_as_host_function(nv).prototype);
            mark_proto_methods_non_constructor(ctx, zjs_as_host_function(nv).prototype);
        }
    }
    let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
    if bool_g >= 0 {
        let bv = ctx.globals[bool_g].value;
        if zjs_is_host_function(bv) != 0 {
            proto_mark_nonenum(zjs_as_host_function(bv).prototype);
            mark_proto_methods_non_constructor(ctx, zjs_as_host_function(bv).prototype);
        }
    }
    let math_g = ctx_find_global(ctx, (char*)"Math", 4);
    if math_g >= 0 {
        let mv = ctx.globals[math_g].value;
        if zjs_is_object(mv) != 0 {
            proto_mark_nonenum(zjs_as_object(mv));
            mark_proto_methods_non_constructor(ctx, zjs_as_object(mv));
        }
    }
    let json_g = ctx_find_global(ctx, (char*)"JSON", 4);
    if json_g >= 0 {
        let jv = ctx.globals[json_g].value;
        if zjs_is_object(jv) != 0 {
            proto_mark_nonenum(zjs_as_object(jv));
            mark_proto_methods_non_constructor(ctx, zjs_as_object(jv));
        }
    }
}

fn proto_mark_nonenum(proto: ZjsObject*) -> void {
    if proto == NULL { return; }
    if proto.attrs == NULL { return; }
    let cls = proto.cls;
    while cls != NULL && cls.parent != NULL {
        let slot = cls.transition_slot;
        if slot < proto.slot_cap {
            proto.attrs[slot] = proto.attrs[slot] & ~PROP_ENUMERABLE;
        }
        cls = cls.parent;
    }
}

// --- Error inspection (public ABI) ----------------------------------

fn zjs_had_error(ctx: ZjsContext*) -> int {
    if ctx == NULL { return 0; }
    if ctx.had_error { return 1; }
    return 0;
}

fn zjs_get_error(ctx: ZjsContext*) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    return ctx.last_error;
}

// =====================================================================
// ToString — produces a string ZjsValue from any input. Allocates on
// the context's cell list. Lives here (not in value.zc) because it
// needs to allocate cells via ctx_intern_string.
// =====================================================================

fn zjs_to_string(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    if zjs_is_string(v) != 0 { return v; }

    let buf: char[64];
    let len: usize = 0;

    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw { len = (size_t)snprintf(buf, 64, "%d", (int)n); }
    } else if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        // ECMA-262 §7.1.17 Number::toString: NaN -> "NaN",
        // ±Infinity -> "Infinity" / "-Infinity"; integral doubles in
        // range get printed without a decimal point. printf("%g") would
        // emit lowercase "nan" / "inf" — wrong tag for JS observers.
        raw {
            if (isnan(d)) {
                len = (size_t)snprintf(buf, 64, "NaN");
            } else if (isinf(d)) {
                len = (size_t)snprintf(buf, 64, d > 0 ? "Infinity" : "-Infinity");
            } else if (d == (double)(int64_t)d && d >= -1e15 && d <= 1e15) {
                // Integral path within 53-bit range — exact integer print.
                len = (size_t)snprintf(buf, 64, "%lld", (long long)d);
            } else if (d == floor(d) && fabs(d) < 1e21) {
                // ECMA-262 NumberToString: integral doubles up to 10^21
                // print as integers (no scientific). %.0f respects the
                // IEEE-double rounding for values past 2^53.
                len = (size_t)snprintf(buf, 64, "%.0f", d);
            } else {
                // Spec wants the shortest string that round-trips
                // through strtod back to the same double. Try
                // increasing precision (1..17) and pick the first
                // that does. Worst case is %.17g; common values
                // settle around 1-6 sig figs.
                int found = 0;
                for (int prec = 1; prec <= 17 && !found; prec++) {
                    char tmp[64];
                    size_t n = (size_t)snprintf(tmp, 64, "%.*g", prec, d);
                    char* end = NULL;
                    double rt = strtod(tmp, &end);
                    if (rt == d) {
                        memcpy(buf, tmp, n + 1);
                        len = n;
                        found = 1;
                    }
                }
                if (!found) {
                    len = (size_t)snprintf(buf, 64, "%.17g", d);
                }
            }
        }
    } else if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { raw { len = (size_t)snprintf(buf, 64, "true"); } }
        else                    { raw { len = (size_t)snprintf(buf, 64, "false"); } }
    } else if zjs_is_null(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "null"); }
    } else if zjs_is_undefined(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "undefined"); }
    } else if zjs_is_object(v) != 0 {
        // ECMA-262 §7.1.17/§7.1.18: ToPrimitive(O, "string") tries
        // toString then valueOf. Fetch each via property_get so
        // accessor getters fire (and their throws propagate).
        let ts_v = property_get(ctx, v, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"toString", 8)));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_is_function(ts_v) != 0 || zjs_is_closure(ts_v) != 0 || zjs_is_host_function(ts_v) != 0 {
            let nullp: ZjsValue* = NULL;
            let r: ZjsValue = zjs_call_value_with_this(ctx, ts_v, v, nullp, 0);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_is_string(r) != 0 { return r; }
            if zjs_is_object(r) == 0 && zjs_is_array(r) == 0 {
                return zjs_to_string(ctx, r);
            }
        }
        let vo_v = property_get(ctx, v, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"valueOf", 7)));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_is_function(vo_v) != 0 || zjs_is_closure(vo_v) != 0 || zjs_is_host_function(vo_v) != 0 {
            let nullp: ZjsValue* = NULL;
            let r2: ZjsValue = zjs_call_value_with_this(ctx, vo_v, v, nullp, 0);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_is_object(r2) == 0 { return zjs_to_string(ctx, r2); }
        }
        raw { len = (size_t)snprintf(buf, 64, "[object Object]"); }
    } else if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        // ECMA-262 leaves Function.prototype.toString.host_call_target
        // implementation-defined for built-ins; the [object Function]
        // form matches what Object.prototype.toString.call(fn) returns
        // and keeps `fn + ""` consistent with `fn.toString() + ""`.
        raw { len = (size_t)snprintf(buf, 64, "[object Function]"); }
    } else if zjs_is_array(v) != 0 {
        // Array → comma-joined elements, no surrounding []. Spec's
        // Array.prototype.toString delegates to Array.prototype.join.
        // We don't have join inlined here, so build it locally.
        // Holes / undefined / null contribute "" to the join.
        let arr = zjs_as_array(v);
        let total: u32 = 0;
        let i_a: u32 = 0;
        // First pass: total byte count.
        while i_a < arr.length {
            if i_a > 0 { total = total + 1; } // comma
            let el = array_get(arr, i_a);  // hole → undefined
            if zjs_is_undefined(el) == 0 && zjs_is_null(el) == 0 {
                let es = zjs_to_string(ctx, el);
                if zjs_is_string(es) != 0 {
                    total = total + zjs_as_string(es).length;
                }
            }
            i_a = i_a + 1;
        }
        let big = alloc_n<char>((usize)(total + 1));
        let off: u32 = 0;
        let i_b: u32 = 0;
        while i_b < arr.length {
            if i_b > 0 {
                big[off] = ',';
                off = off + 1;
            }
            let el = array_get(arr, i_b);
            if zjs_is_undefined(el) == 0 && zjs_is_null(el) == 0 {
                let es = zjs_to_string(ctx, el);
                if zjs_is_string(es) != 0 {
                    let s = zjs_as_string(es);
                    let dst: char* = NULL;
                    raw { dst = &big[off]; }
                    mem_copy<char>(dst, s.data, (usize)s.length);
                    off = off + s.length;
                }
            }
            i_b = i_b + 1;
        }
        big[total] = (char)0;
        return ctx_intern_string_take(ctx, big, total);
    } else {
        raw { len = (size_t)snprintf(buf, 64, "[object]"); }
    }

    return ctx_intern_string(ctx, &buf[0], (u32)len);
}

// String concatenation: a + b where at least one is a string. Both
// operands are coerced to strings; result is a fresh interned string
// on the context.
fn zjs_string_concat(ctx: ZjsContext*, a: ZjsValue, b: ZjsValue) -> ZjsValue {
    let sa_val = zjs_to_string(ctx, a);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let sb_val = zjs_to_string(ctx, b);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let sa = zjs_as_string(sa_val);
    let sb = zjs_as_string(sb_val);
    let total = sa.length + sb.length;
    let buf = alloc_n<char>((usize)(total + 1));
    mem_copy<char>(buf, sa.data, (usize)sa.length);
    let tail: char* = NULL;
    raw { tail = &buf[sa->length]; }
    mem_copy<char>(tail, sb.data, (usize)sb.length);
    buf[total] = (char)0;
    return ctx_intern_string_take(ctx, buf, total);
}

// Find an existing global by name. Returns -1 if not found (i32 so we
// can use a sentinel).
fn ctx_find_global(ctx: ZjsContext*, name: char*, name_len: u32) -> i32 {
    let i: u32 = 0;
    while i < ctx.global_count {
        if ctx.globals[i].name_len == name_len {
            let ent_name = ctx.globals[i].name;
            let eq: int = 0;
            raw { eq = (memcmp(ent_name, name, name_len) == 0) ? 1 : 0; }
            if eq != 0 { return (i32)i; }
        }
        i = i + 1;
    }
    return -1;
}

// Intern a global name: return its slot index, creating a fresh slot
// (with value = undefined) if it doesn't exist yet.
fn ctx_intern_global(ctx: ZjsContext*, name: char*, name_len: u32) -> u32 {
    let existing = ctx_find_global(ctx, name, name_len);
    if existing >= 0 { return (u32)existing; }

    // Grow the table if needed. realloc_n already zero-inits the new
    // bytes, so we don't need a separate memset for the new tail.
    if ctx.global_count >= ctx.global_cap {
        let new_cap: u32 = if ctx.global_cap == 0 { 16 } else { ctx.global_cap * 2 };
        ctx.globals = realloc_n<GlobalEntry>(ctx.globals, (usize)ctx.global_cap, (usize)new_cap);
        ctx.global_cap = new_cap;
    }

    // Allocate + copy the name (it's a slice of caller's source).
    let name_copy = alloc_n<char>((usize)(name_len + 1));
    mem_copy<char>(name_copy, name, (usize)name_len);
    name_copy[name_len] = (char)0;

    let idx = ctx.global_count;
    ctx.globals[idx].name = name_copy;
    ctx.globals[idx].name_len = name_len;
    ctx.globals[idx].value = zjs_undefined();
    ctx.global_count = ctx.global_count + 1;
    return idx;
}

// =====================================================================
// ES modules — file-based loader.
// =====================================================================

// Path-resolution helper. `spec` is the literal specifier from
// `import ... from 'spec'`. If it starts with './' or '../', resolve
// against the *directory* of `base_abs_path`; otherwise treat as
// already-absolute (extension-only resolution can come later). Returns
// a freshly-interned ZjsString*; NULL on out-of-bounds buffer.
fn module_resolve_specifier(ctx: ZjsContext*, base_abs_path: ZjsString*, spec: ZjsString*) -> ZjsString* {
    if spec == NULL { return NULL; }
    let sd = spec.data;
    let sl = spec.length;
    let is_relative: bool = false;
    raw {
        is_relative = (sl >= 2 && sd[0] == '.' && (sd[1] == '/' || (sd[1] == '.' && sl >= 3 && sd[2] == '/'))) ? true : false;
    }
    if !is_relative {
        // Treat as already a usable path. Real ESM resolution (URL
        // schemes, package.json, node_modules) is out of scope for now.
        return spec;
    }
    if base_abs_path == NULL {
        // Relative spec with no base: assume cwd (rare; only happens
        // when the entry module's own abs_path wasn't set).
        return spec;
    }
    // Dirname of base.
    let bd = base_abs_path.data;
    let bl = base_abs_path.length;
    let dir_len: u32 = bl;
    raw {
        while (dir_len > 0 && bd[dir_len - 1] != '/') { dir_len--; }
    }
    let total: u32 = dir_len + sl;
    let buf = alloc_n<char>((usize)(total + 1));
    raw {
        memcpy(buf, bd, dir_len);
        memcpy(buf + dir_len, sd, sl);
        buf[total] = 0;
        // Normalize `./` and `../` segments in place.
        char* out = buf;
        char* in_ = buf;
        while (*in_) {
            if (in_[0] == '/' && in_[1] == '.' && in_[2] == '/') {
                in_ += 2;        // skip the "./" — the leading slash stays at *out
                continue;
            }
            if (in_[0] == '/' && in_[1] == '.' && in_[2] == '.' && (in_[3] == '/' || in_[3] == 0)) {
                // Roll output back to the previous '/' to drop the prior segment.
                if (out > buf) out--;
                while (out > buf && *(out - 1) != '/') out--;
                in_ += 3;
                continue;
            }
            *out++ = *in_++;
        }
        *out = 0;
        total = (uint32_t)(out - buf);
    }
    let s = ctx_intern_atom_take(ctx, buf, total);
    return s;
}

fn module_cache_find(ctx: ZjsContext*, abs_path: ZjsString*) -> ZjsModuleRecord* {
    let i: u32 = 0;
    while i < ctx.module_cache_count {
        let m = ctx.module_cache[i];
        if m.abs_path == abs_path { return m; }
        // Atom-interning should have already deduped — but fall back
        // to a byte compare for safety.
        if m.abs_path != NULL && abs_path != NULL
           && m.abs_path.length == abs_path.length {
            let eq: bool = true;
            raw {
                if (memcmp(m->abs_path->data, abs_path->data, abs_path->length) != 0) eq = false;
            }
            if eq { return m; }
        }
        i = i + 1;
    }
    return NULL;
}

fn module_cache_push(ctx: ZjsContext*, m: ZjsModuleRecord*) -> void {
    if ctx.module_cache_count >= ctx.module_cache_cap {
        let new_cap: u32 = if ctx.module_cache_cap == 0 { 8 } else { ctx.module_cache_cap * 2 };
        ctx.module_cache = realloc_n<ZjsModuleRecord*>(ctx.module_cache, (usize)ctx.module_cache_cap, (usize)new_cap);
        ctx.module_cache_cap = new_cap;
    }
    ctx.module_cache[ctx.module_cache_count] = m;
    ctx.module_cache_count = ctx.module_cache_count + 1;
}

fn read_file_to_string(path: char*) -> char* {
    let out: char* = NULL;
    raw {
        FILE* f = fopen(path, "rb");
        if (!f) return NULL;
        fseek(f, 0, SEEK_END);
        long sz = ftell(f);
        if (sz < 0) { fclose(f); return NULL; }
        fseek(f, 0, SEEK_SET);
        out = (char*)malloc((size_t)sz + 1);
        if (!out) { fclose(f); return NULL; }
        size_t n = fread(out, 1, (size_t)sz, f);
        out[n] = 0;
        fclose(f);
    }
    return out;
}

// The bytecode compiler + interpreter live in sibling .zc files; the
// loader needs to call into them. Forward-declare with extern.
raw {
    extern Function* compile_program(ZjsContext* ctx, char* source, AstNode* root);
    extern InterpretResult interpret(ZjsContext* ctx, Function* entry_f, ZjsValue* args, uint32_t arg_count);
    extern ParseResult parse_module(char* source, size_t source_len);
    extern void parser_free_result(ParseResult pr);
}

// Load + (recursively) evaluate the module at `abs_path`. Returns the
// cached record on subsequent calls.
fn ctx_load_module(ctx: ZjsContext*, abs_path: ZjsString*) -> ZjsModuleRecord* {
    if abs_path == NULL { return NULL; }
    let existing = module_cache_find(ctx, abs_path);
    if existing != NULL {
        if existing.state == MODULE_STATE_EVALUATED { return existing; }
        if existing.state == MODULE_STATE_EVALUATING {
            // Circular import — surface a real error once cycle support
            // lands. For MVP, return the (partially populated) record;
            // the in-flight body sees `undefined` for not-yet-set names.
            return existing;
        }
        if existing.state == MODULE_STATE_ERRORED {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = existing.error;
            return existing;
        }
    }

    // Read file.
    let path_c: char* = NULL;
    let path_buf = alloc_n<char>((usize)(abs_path.length + 1));
    raw {
        memcpy(path_buf, abs_path->data, abs_path->length);
        path_buf[abs_path->length] = 0;
        path_c = path_buf;
    }
    let src = read_file_to_string(path_c);
    dealloc(path_buf);
    if src == NULL {
        let err = build_typed_error(ctx, (char*)"Error", 5,
                                    (char*)"module not found", 16);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return NULL;
    }

    // Parse + compile.
    let src_len: usize = 0;
    raw { src_len = strlen(src); }
    let parse: ParseResult = parse_module(src, src_len);
    if parse.had_error {
        raw { parser_free_result(parse); free(src); }
        let err = build_typed_error(ctx, (char*)"SyntaxError", 11,
                                    (char*)"module parse error", 18);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return NULL;
    }
    let f: Function* = NULL;
    raw {
        void* root_v = parse.root;
        f = compile_program(ctx, src, root_v);
        parser_free_result(parse);
    }
    if f == NULL {
        raw { free(src); }
        let err = build_typed_error(ctx, (char*)"SyntaxError", 11,
                                    (char*)"module compile error", 20);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return NULL;
    }
    // NOTE: leak src buffer — Function holds offsets into it. A real
    // module record would adopt the buffer; tracking ownership is a
    // follow-up. For MVP, accept the per-module leak.

    // Construct + register the record BEFORE evaluating so circular
    // imports can find the in-flight record (cycle detection then
    // resolves names via partial exports).
    let m = alloc<ZjsModuleRecord>();
    m.abs_path = abs_path;
    m.function = f;
    m.exports  = zjs_as_object(ctx_new_object(ctx));
    m.state    = MODULE_STATE_EVALUATING;
    m.error    = zjs_undefined();
    module_cache_push(ctx, m);

    // Evaluate the body with current_module pointed at it so the
    // ImportBind / ExportBind ops route to the right cache + exports.
    let saved_cm = ctx.current_module;
    let saved_th = ctx.host_this;
    ctx.current_module = m;
    if ctx.global_this_obj != NULL {
        ctx.host_this = zjs_cell_from_ptr((void*)ctx.global_this_obj);
    }
    let r: InterpretResult = zjs_undefined_result();
    raw {
        InterpretResult ir = interpret(ctx, f, NULL, 0);
        r = ir;
    }
    ctx.current_module = saved_cm;
    ctx.host_this = saved_th;
    if r.is_throw {
        m.state = MODULE_STATE_ERRORED;
        m.error = r.value;
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = r.value;
        return m;
    }
    m.state = MODULE_STATE_EVALUATED;
    return m;
}

// Called from Op::ImportBind. Returns the value of source.exports[name]
// — or, when name is "*", the exports object itself (namespace import).
// On error, sets ctx.pending_throw and returns undefined.
fn ctx_module_import_value(ctx: ZjsContext*, spec_v: ZjsValue, name_v: ZjsValue) -> ZjsValue {
    if zjs_is_string(spec_v) == 0 || zjs_is_string(name_v) == 0 {
        return zjs_undefined();
    }
    let spec = zjs_as_string(spec_v);
    let name = zjs_as_string(name_v);
    let base = if ctx.current_module != NULL { ctx.current_module.abs_path } else { NULL };
    let resolved = module_resolve_specifier(ctx, base, spec);
    if resolved == NULL {
        let err = build_typed_error(ctx, (char*)"Error", 5,
                                    (char*)"could not resolve module specifier", 35);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let m = ctx_load_module(ctx, resolved);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if m == NULL { return zjs_undefined(); }
    // Namespace import: hand back the exports object directly.
    if name.length == 1 {
        let nd = name.data;
        let star_match: bool = false;
        raw { star_match = (nd[0] == '*') ? true : false; }
        if star_match {
            return zjs_cell_from_ptr((void*)m.exports);
        }
    }
    // Named: look up in exports.
    let slot = class_find_slot(m.exports.cls, name);
    if slot < 0 {
        // Missing export — surface as TypeError for now (spec says
        // SyntaxError on link; we don't have a true link phase).
        let buf: char[128];
        let n: int = 0;
        let nm_d = name.data;
        let nm_l = name.length;
        raw {
            n = snprintf(&buf[0], 128, "export '%.*s' not found in module",
                         (int)(nm_l > 64 ? 64 : nm_l), nm_d);
        }
        let bp: char* = NULL; raw { bp = &buf[0]; }
        let err = build_typed_error(ctx, (char*)"SyntaxError", 11, bp, (u32)n);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    return m.exports.slots[(u32)slot];
}

// Helper used in InterpretResult-returning extern paths.
fn zjs_undefined_result() -> InterpretResult {
    return InterpretResult{ is_throw: false, value: zjs_undefined() };
}
