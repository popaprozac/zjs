    let pdt2d_ptr: void* = NULL; raw { pdt2d_ptr = (void*)host_temporal_plaindatetime_to_plain_date; }
    let pdt2t_ptr: void* = NULL; raw { pdt2t_ptr = (void*)host_temporal_plaindatetime_to_plain_time; }
    let pdtts_fn = ctx_make_host_function(ctx, (char*)"toString", pdtts_ptr);
    object_set(ctx, ctx.temporal_plaindatetime_proto, ctx_intern_atom(ctx, (char*)"toString", 8), pdtts_fn);
    object_set(ctx, ctx.temporal_plaindatetime_proto, ctx_intern_atom(ctx, (char*)"toJSON", 6), pdtts_fn);
    object_set(ctx, ctx.temporal_plaindatetime_proto, ctx_intern_atom(ctx, (char*)"equals", 6),
               ctx_make_host_function(ctx, (char*)"equals", pdteq_ptr));
    object_set(ctx, ctx.temporal_plaindatetime_proto, ctx_intern_atom(ctx, (char*)"toPlainDate", 11),
