    // Promise.resolve / Promise.reject statics on .props.
    let presolve_ptr: void* = NULL; raw { presolve_ptr = (void*)host_promise_resolve_static; }
    let preject_ptr:  void* = NULL; raw { preject_ptr  = (void*)host_promise_reject_static; }
    if promise_hf.props == NULL {
