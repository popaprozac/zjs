    // breaks for-of and array-destructure per spec.
    let aiter_ptr: void* = NULL; raw { aiter_ptr = (void*)host_array_at_iterator; }
    let array_iter_v = ctx_make_host_function_arity(ctx, (char*)"[Symbol.iterator]", aiter_ptr, 0);
