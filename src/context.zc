    promise_hf.prototype = zjs_as_object(pp_v);
    ctx.promise_ctor_proto = promise_hf.prototype;
    object_set(ctx, promise_hf.prototype, ctx_intern_atom(ctx, (char*)"constructor", 11), promise_v);
    let pthen_ptr:  void* = NULL; raw { pthen_ptr  = (void*)host_promise_then; }
    let pcatch_ptr: void* = NULL; raw { pcatch_ptr = (void*)host_promise_catch; }
    object_set(ctx, promise_hf.prototype, ctx_intern_atom(ctx, (char*)"then", 4),
