    // unified prototype.
    object_set(ctx, string_proto, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, string_proto, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));

    // --- JSON namespace (Phase 3.5b) ---
    let json_v = ctx_new_object(ctx);
    let json_o = zjs_as_object(json_v);
    object_set(ctx, json_o, ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN),
               ctx_intern_string(ctx, (char*)"JSON", 4));
    let stringify_ptr: void* = NULL; raw { stringify_ptr = (void*)host_json_stringify; }
    let parse_ptr:     void* = NULL; raw { parse_ptr     = (void*)host_json_parse; }
    object_set(ctx, json_o, ctx_intern_atom(ctx, (char*)"stringify", 9),
               ctx_make_host_function_arity(ctx, (char*)"stringify", stringify_ptr, 3));
    object_set(ctx, json_o, ctx_intern_atom(ctx, (char*)"parse", 5),
               ctx_make_host_function_arity(ctx, (char*)"parse", parse_ptr, 2));
    let json_slot = ctx_intern_global(ctx, (char*)"JSON", 4);
    ctx.globals[json_slot].value = json_v;
    ctx.globals[json_slot].defined = true;

    // --- Temporal namespace (behind ZJS_NO_TEMPORAL) ---
    raw {
        #ifndef ZJS_NO_TEMPORAL
        ctx_init_temporal(ctx);
        #endif
    }

    // --- console (Phase 3.8a + web-API quick wins 2026-05-18) ---
    let console_v = ctx_new_object(ctx);
    let console_o = zjs_as_object(console_v);
    let log_ptr:   void* = NULL; raw { log_ptr   = (void*)host_console_log; }
    let info_ptr:  void* = NULL; raw { info_ptr  = (void*)host_console_info; }
    let warn_ptr:  void* = NULL; raw { warn_ptr  = (void*)host_console_warn; }
    let cerr_ptr:  void* = NULL; raw { cerr_ptr  = (void*)host_console_error; }
    let debug_ptr: void* = NULL; raw { debug_ptr = (void*)host_console_debug; }
    let trace_ptr: void* = NULL; raw { trace_ptr = (void*)host_console_trace; }
    let dir_ptr:   void* = NULL; raw { dir_ptr   = (void*)host_console_dir; }
    let grp_ptr:   void* = NULL; raw { grp_ptr   = (void*)host_console_group; }
    let gpe_ptr:   void* = NULL; raw { gpe_ptr   = (void*)host_console_group_end; }
    let asrt_ptr:  void* = NULL; raw { asrt_ptr  = (void*)host_console_assert; }
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"log", 3),
               ctx_make_host_function(ctx, (char*)"log", log_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"info", 4),
               ctx_make_host_function(ctx, (char*)"info", info_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"warn", 4),
               ctx_make_host_function(ctx, (char*)"warn", warn_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"error", 5),
               ctx_make_host_function(ctx, (char*)"error", cerr_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"debug", 5),
               ctx_make_host_function(ctx, (char*)"debug", debug_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"trace", 5),
               ctx_make_host_function(ctx, (char*)"trace", trace_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"dir", 3),
               ctx_make_host_function(ctx, (char*)"dir", dir_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"group", 5),
               ctx_make_host_function(ctx, (char*)"group", grp_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"groupCollapsed", 14),
               ctx_make_host_function(ctx, (char*)"groupCollapsed", grp_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"groupEnd", 8),
               ctx_make_host_function(ctx, (char*)"groupEnd", gpe_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"assert", 6),
               ctx_make_host_function(ctx, (char*)"assert", asrt_ptr));
    let console_slot = ctx_intern_global(ctx, (char*)"console", 7);
    ctx.globals[console_slot].value = console_v;
    ctx.globals[console_slot].defined = true;

    // queueMicrotask(fn) — web-platform global.
    let qmt_ptr: void* = NULL; raw { qmt_ptr = (void*)host_queue_microtask; }
    ctx_register_host_function(ctx, (char*)"queueMicrotask", qmt_ptr);

    // performance.now() — monotonic high-res clock as a global.
    // timeOrigin is captured at context-init time (Unix epoch ms).
    let perf_v = ctx_new_object(ctx);
    let perf_now_ptr: void* = NULL; raw { perf_now_ptr = (void*)host_performance_now; }
    object_set(ctx, zjs_as_object(perf_v), ctx_intern_atom(ctx, (char*)"now", 3),
               ctx_make_host_function(ctx, (char*)"now", perf_now_ptr));
    let origin_ms: f64 = 0.0;
    raw {
        struct timespec ts;
        clock_gettime(CLOCK_REALTIME, &ts);
        origin_ms = (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
    }
    object_set(ctx, zjs_as_object(perf_v), ctx_intern_atom(ctx, (char*)"timeOrigin", 10),
               zjs_double(origin_ms));
    let perf_slot = ctx_intern_global(ctx, (char*)"performance", 11);
    ctx.globals[perf_slot].value = perf_v;
    ctx.globals[perf_slot].defined = true;

    // User Timing Level 3 — pure-JS layer on top of performance.now().
    // Adds mark / measure / clearMarks / clearMeasures / getEntries /
    // getEntriesByName / getEntriesByType. Entries are PerformanceMark /
    // PerformanceMeasure objects (POJOs with the spec'd shape).
    //
    // The JS source lives in `src/stdlib/perf_user_timing.js`; the
    // .gen.h is produced by tools/embed_js.py at build time (see
    // Makefile's stdlib-embed rule).
    let perf_user_timing_src: char* = NULL;
    raw {
        #include "stdlib/perf_user_timing.gen.h"
        perf_user_timing_src = (char*)PERF_USER_TIMING_SOURCE;
    }
    zjs_eval(ctx, perf_user_timing_src);
    if ctx.had_error {
        raw { fprintf(stderr, "[stdlib] performance User Timing bootstrap failed\n"); }
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
    }

    // atob / btoa — base64 (Latin-1 binary strings).
    let btoa_ptr: void* = NULL; raw { btoa_ptr = (void*)host_btoa; }
    let atob_ptr: void* = NULL; raw { atob_ptr = (void*)host_atob; }
    ctx_register_host_function(ctx, (char*)"btoa", btoa_ptr);
    ctx_register_host_function(ctx, (char*)"atob", atob_ptr);

    // escape / unescape — Annex B legacy globals. uuid's v5 path uses
    // escape() to byte-encode the name input before hashing.
    let esc_ptr:   void* = NULL; raw { esc_ptr   = (void*)host_escape; }
    let unesc_ptr: void* = NULL; raw { unesc_ptr = (void*)host_unescape; }
    ctx_register_host_function(ctx, (char*)"escape",   esc_ptr);
    ctx_register_host_function(ctx, (char*)"unescape", unesc_ptr);

    // encodeURI / encodeURIComponent / decodeURI / decodeURIComponent.
    let enu_ptr:  void* = NULL; raw { enu_ptr  = (void*)host_encode_uri; }
    let enuc_ptr: void* = NULL; raw { enuc_ptr = (void*)host_encode_uri_component; }
    let deu_ptr:  void* = NULL; raw { deu_ptr  = (void*)host_decode_uri; }
    let deuc_ptr: void* = NULL; raw { deuc_ptr = (void*)host_decode_uri_component; }
    ctx_register_host_function(ctx, (char*)"encodeURI",          enu_ptr);
    ctx_register_host_function(ctx, (char*)"encodeURIComponent", enuc_ptr);
    ctx_register_host_function(ctx, (char*)"decodeURI",          deu_ptr);
    ctx_register_host_function(ctx, (char*)"decodeURIComponent", deuc_ptr);

    // reportError — WinterTC-required global for surfacing errors
    // that no JS frame caught (typically from microtask queues).
    let rep_err_ptr: void* = NULL; raw { rep_err_ptr = (void*)host_report_error; }
    ctx_register_host_function(ctx, (char*)"reportError", rep_err_ptr);

    // Timers — web-API Phase B. Backing infrastructure lives in
    // zjs_next_timer_ms / zjs_run_pending_timers; these globals
    // install / cancel reservations.
    let st_ptr:  void* = NULL; raw { st_ptr  = (void*)host_set_timeout; }
    // Named `siv_ptr` (not `si_ptr`) to dodge musl <signal.h>'s
    // `si_ptr` macro — picked up when node:child_process pulls in
    // <signal.h> at TU scope, then collides with this local on the
    // cross-musl build path. Functionally arbitrary identifier.
    let siv_ptr: void* = NULL; raw { siv_ptr = (void*)host_set_interval; }
    let ct_ptr:  void* = NULL; raw { ct_ptr  = (void*)host_clear_timeout; }
    ctx_register_host_function(ctx, (char*)"setTimeout",   st_ptr);
    ctx_register_host_function(ctx, (char*)"setInterval",  siv_ptr);
    ctx_register_host_function(ctx, (char*)"clearTimeout", ct_ptr);
    // clearInterval is the same operation as clearTimeout (both
    // dispatch on id); aliasing matches what browsers and Node do.
    ctx_register_host_function(ctx, (char*)"clearInterval", ct_ptr);

    // === Phase C: TextEncoder / TextDecoder + crypto ===
    let te_ctor_ptr: void* = NULL; raw { te_ctor_ptr = (void*)host_text_encoder_ctor; }
    let te_enc_ptr:  void* = NULL; raw { te_enc_ptr  = (void*)host_text_encoder_encode; }
    let te_v = ctx_register_host_function(ctx, (char*)"TextEncoder", te_ctor_ptr);
    let te_proto_v = ctx_new_object(ctx);
    let te_proto = zjs_as_object(te_proto_v);
    zjs_as_host_function(te_v).prototype = te_proto;
    object_set(ctx, te_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), te_v);
    object_set(ctx, te_proto, ctx_intern_atom(ctx, (char*)"encode", 6),
               ctx_make_host_function_arity(ctx, (char*)"encode", te_enc_ptr, 1));

    let td_ctor_ptr: void* = NULL; raw { td_ctor_ptr = (void*)host_text_decoder_ctor; }
    let td_dec_ptr:  void* = NULL; raw { td_dec_ptr  = (void*)host_text_decoder_decode; }
    let td_v = ctx_register_host_function(ctx, (char*)"TextDecoder", td_ctor_ptr);
    let td_proto_v = ctx_new_object(ctx);
    let td_proto = zjs_as_object(td_proto_v);
    zjs_as_host_function(td_v).prototype = td_proto;
    object_set(ctx, td_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), td_v);
    object_set(ctx, td_proto, ctx_intern_atom(ctx, (char*)"decode", 6),
               ctx_make_host_function_arity(ctx, (char*)"decode", td_dec_ptr, 1));

    // crypto global (web-platform-style; not Node's `require('crypto')`).
    // v0.1: randomUUID + getRandomValues. crypto.subtle deferred.
    let crypto_v = ctx_new_object(ctx);
    let crypto_o = zjs_as_object(crypto_v);
    let cru_ptr: void* = NULL; raw { cru_ptr = (void*)host_crypto_random_uuid; }
    let crg_ptr: void* = NULL; raw { crg_ptr = (void*)host_crypto_get_random_values; }
    object_set(ctx, crypto_o, ctx_intern_atom(ctx, (char*)"randomUUID", 10),
               ctx_make_host_function(ctx, (char*)"randomUUID", cru_ptr));
    object_set(ctx, crypto_o, ctx_intern_atom(ctx, (char*)"getRandomValues", 15),
               ctx_make_host_function_arity(ctx, (char*)"getRandomValues", crg_ptr, 1));
    // crypto.subtle.digest — Apple CommonCrypto / Linux libcrypto /
    // Windows BCrypt via zjs_digest_oneshot.
    let subtle_v = ctx_new_object(ctx);
    let subtle_o = zjs_as_object(subtle_v);
    let csd_ptr: void* = NULL; raw { csd_ptr = (void*)host_crypto_subtle_digest; }
    let cik_ptr: void* = NULL; raw { cik_ptr = (void*)host_crypto_subtle_import_key; }
    let csi_ptr: void* = NULL; raw { csi_ptr = (void*)host_crypto_subtle_sign; }
    let csv_ptr: void* = NULL; raw { csv_ptr = (void*)host_crypto_subtle_verify; }
    let cse_ptr: void* = NULL; raw { cse_ptr = (void*)host_crypto_subtle_encrypt; }
    let csx_ptr: void* = NULL; raw { csx_ptr = (void*)host_crypto_subtle_decrypt; }
    let csg_ptr: void* = NULL; raw { csg_ptr = (void*)host_crypto_subtle_generate_key; }
    let csp_ptr: void* = NULL; raw { csp_ptr = (void*)host_crypto_subtle_export_key; }
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"digest", 6),
               ctx_make_host_function_arity(ctx, (char*)"digest", csd_ptr, 2));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"importKey", 9),
               ctx_make_host_function_arity(ctx, (char*)"importKey", cik_ptr, 5));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"sign", 4),
               ctx_make_host_function_arity(ctx, (char*)"sign", csi_ptr, 3));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"verify", 6),
               ctx_make_host_function_arity(ctx, (char*)"verify", csv_ptr, 4));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"encrypt", 7),
               ctx_make_host_function_arity(ctx, (char*)"encrypt", cse_ptr, 3));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"decrypt", 7),
               ctx_make_host_function_arity(ctx, (char*)"decrypt", csx_ptr, 3));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"generateKey", 11),
               ctx_make_host_function_arity(ctx, (char*)"generateKey", csg_ptr, 3));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"exportKey", 9),
               ctx_make_host_function_arity(ctx, (char*)"exportKey", csp_ptr, 2));
    let cdb_ptr: void* = NULL; raw { cdb_ptr = (void*)host_crypto_subtle_derive_bits; }
    let cdk_ptr: void* = NULL; raw { cdk_ptr = (void*)host_crypto_subtle_derive_key; }
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"deriveBits", 10),
               ctx_make_host_function_arity(ctx, (char*)"deriveBits", cdb_ptr, 3));
    object_set(ctx, subtle_o, ctx_intern_atom(ctx, (char*)"deriveKey", 9),
               ctx_make_host_function_arity(ctx, (char*)"deriveKey", cdk_ptr, 5));
    object_set(ctx, crypto_o, ctx_intern_atom(ctx, (char*)"subtle", 6), subtle_v);
    let crypto_slot = ctx_intern_global(ctx, (char*)"crypto", 6);
    ctx.globals[crypto_slot].value = crypto_v;
    ctx.globals[crypto_slot].defined = true;
    // Internal zlib codec backing node:zlib + CompressionStream.
    let zlib_ptr: void* = NULL; raw { zlib_ptr = (void*)host_zlib_codec; }
    let zlib_slot = ctx_intern_global(ctx, (char*)"__zjs_zlib", 10);
    ctx.globals[zlib_slot].value = ctx_make_host_function_arity(ctx, (char*)"__zjs_zlib", zlib_ptr, 4);
    ctx.globals[zlib_slot].defined = true;

    // Mark every property on every built-in prototype as
    // non-enumerable. Per spec, ALL methods on Object.prototype,
    // Array.prototype, String.prototype, etc. — and Math's constants
    // like PI / E — are { writable: true, configurable: true,
    // enumerable: FALSE }. Our bootstrap installs them via plain
    // object_set which gives PROP_DEFAULT (enumerable=true). Sweep
    // those bits off in one pass so Object.keys / for-in / the
    // descriptor walk in Object.create({}, SomeProto) all see them
    // as non-enumerable.
    proto_mark_nonenum(ctx.object_proto);
    proto_mark_nonenum(ctx.array_proto);
    proto_mark_nonenum(ctx.string_proto);
    proto_mark_nonenum(ctx.regexp_proto);
    proto_mark_nonenum(ctx.promise_ctor_proto);
    // Prototype methods are not constructors per spec — `new
    // Array.prototype.push()` should throw TypeError. Mark them now
    // that the method tables are installed.
    mark_proto_methods_non_constructor(ctx, ctx.object_proto);
    mark_proto_methods_non_constructor(ctx, ctx.array_proto);
    mark_proto_methods_non_constructor(ctx, ctx.string_proto);
    mark_proto_methods_non_constructor(ctx, ctx.regexp_proto);
    mark_proto_methods_non_constructor(ctx, ctx.promise_ctor_proto);
    mark_proto_methods_non_constructor(ctx, ctx.generator_proto);
    mark_proto_methods_non_constructor(ctx, ctx.map_proto);
    mark_proto_methods_non_constructor(ctx, ctx.set_proto);
    mark_proto_methods_non_constructor(ctx, ctx.date_proto);
    mark_proto_methods_non_constructor(ctx, ctx.symbol_proto);
    // Wrapper prototypes (Number.prototype, Boolean.prototype) and
    // Math live as the .prototype of their constructor or as a plain
    // global. Walk via the global table.
    let num_g = ctx_find_global(ctx, (char*)"Number", 6);
    if num_g >= 0 {
        let nv = ctx.globals[num_g].value;
        if zjs_is_host_function(nv) != 0 {
            proto_mark_nonenum(zjs_as_host_function(nv).prototype);
            mark_proto_methods_non_constructor(ctx, zjs_as_host_function(nv).prototype);
        }
    }
    let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
    if bool_g >= 0 {
        let bv = ctx.globals[bool_g].value;
        if zjs_is_host_function(bv) != 0 {
            proto_mark_nonenum(zjs_as_host_function(bv).prototype);
            mark_proto_methods_non_constructor(ctx, zjs_as_host_function(bv).prototype);
        }
    }
    let math_g = ctx_find_global(ctx, (char*)"Math", 4);
    if math_g >= 0 {
        let mv = ctx.globals[math_g].value;
        if zjs_is_object(mv) != 0 {
            proto_mark_nonenum(zjs_as_object(mv));
            mark_proto_methods_non_constructor(ctx, zjs_as_object(mv));
        }
    }
    let json_g = ctx_find_global(ctx, (char*)"JSON", 4);
    if json_g >= 0 {
        let jv = ctx.globals[json_g].value;
        if zjs_is_object(jv) != 0 {
            proto_mark_nonenum(zjs_as_object(jv));
            mark_proto_methods_non_constructor(ctx, zjs_as_object(jv));
        }
    }

    // Ring-1 / Ring-2 stdlib extensions live in their own helper
    // (zjs_install_stdlib_extensions). They're NOT called from here —
    // ctx_init_builtins finishes only the ES-core surface. The default
    // entry point zjs_new_context invokes the helper after this
    // returns; zjs_new_minimal_context skips it.
}

// Tiered stdlib: Ring-1 (web globals via JS bootstrap) + Ring-2 (node:
// modules via the loader). Called by the full-context bootstrap; an
// embedder wanting a smaller engine builds with a minimal context and
// then opts in to whichever pieces they need.
fn zjs_install_stdlib_extensions(ctx: ZjsContext*) -> void {
    // === Standard library — Ring 1 builtin modules (task #190) ===
    // See docs/stdlib-design.md. Each module's populate() callback
    // runs lazily on first `import 'node:foo'`.
    //
    // Each install call below is gated by a ZJS_NO_* preprocessor
    // macro. When defined at build time (see Makefile ZJS_TIER /
    // ZJS_FEATURE_DEFINES), the call is preprocessed out, the impl
    // becomes unreferenced from the engine, and link-time -dead_strip
    // drops it. Per-function sections keep the dead-strip granular.
    raw {
        #ifndef ZJS_NO_NODE_MODULES
        ctx_register_stdlib_modules(ctx);
        #endif

        // Pure-JS WinterTC web globals (EventTarget, Event, CustomEvent,
        // DOMException). Bootstrap snippet runs JS now that classes,
        // Map, Object.defineProperty etc. are all in place.
        #ifndef ZJS_NO_WEB_EVENTS
        zjs_install_web_events(ctx);
        #endif
        // AbortController / AbortSignal — depends on EventTarget +
        // DOMException above. Dropping web_events must drop web_abort.
        #ifndef ZJS_NO_WEB_ABORT
        zjs_install_web_abort(ctx);
        #endif
        // structuredClone — depends on Map / DOMException, no event dep.
        #ifndef ZJS_NO_WEB_CLONE
        zjs_install_web_clone(ctx);
        #endif
        // Blob / File / FormData — depends on TextEncoder + Uint8Array.
        #ifndef ZJS_NO_WEB_BLOB
        zjs_install_web_blob(ctx);
        #endif
        // node:buffer global Buffer — depends on TextEncoder / Uint8Array
        // (per-instance proto) / atob / btoa / DataView, all installed above.
        #ifndef ZJS_NO_NODE_BUFFER
        zjs_install_node_buffer(ctx);
        #endif
        // WHATWG Streams — the largest of the web-globals bootstraps
        // (~50KB of source). Skip if the embedder doesn't need them.
        #ifndef ZJS_NO_WEB_STREAMS
        zjs_install_web_streams(ctx);
        #endif
        // CompressionStream / DecompressionStream — depends on
        // TransformStream (web_streams) + the native __zjs_zlib codec.
        #ifndef ZJS_NO_WEB_COMPRESSION
        zjs_install_web_compression(ctx);
        #endif
        // node:net native host-fn globals (__zjs_net_*).
        #ifndef ZJS_NO_NODE_NET
        zjs_install_node_net_globals(ctx);
        #endif
    }
}

fn proto_mark_nonenum(proto: ZjsObject*) -> void {
    if proto == NULL { return; }
    if proto.attrs == NULL { return; }
    let cls = proto.cls;
    while cls != NULL && cls.parent != NULL {
        let slot = cls.transition_slot;
        if slot < proto.slot_cap {
            proto.attrs[slot] = proto.attrs[slot] & ~PROP_ENUMERABLE;
        }
        cls = cls.parent;
    }
}

// --- Error inspection (public ABI) ----------------------------------

fn zjs_had_error(ctx: ZjsContext*) -> int {
    if ctx == NULL { return 0; }
    if ctx.had_error { return 1; }
    return 0;
}

fn zjs_get_error(ctx: ZjsContext*) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    return ctx.last_error;
}

// =====================================================================
// ToString — produces a string ZjsValue from any input. Allocates on
// the context's cell list. Lives here (not in value.zc) because it
// needs to allocate cells via ctx_intern_string.
// =====================================================================

fn zjs_to_string(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    if zjs_is_string(v) != 0 { return v; }
    // ECMA-262 §7.1.17: abstract ToString on a Symbol throws TypeError.
    // Explicit Symbol.prototype.toString and the String() call form
    // bypass this (they call SymbolDescriptiveString directly).
    if zjs_is_symbol(v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert a Symbol value to a string", 41);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    // BigInt → decimal string (no `n` suffix), ECMA-262 §6.1.6.2.23.
    if zjs_is_bigint(v) != 0 {
        let b = zjs_as_bigint(v);
        let blen: u32 = 0;
        let bs = bigint_to_decimal_cstring(b, &blen);
        let s = ctx_intern_string(ctx, bs, blen);
        dealloc(bs);
        return s;
    }

    let buf: char[64];
    let len: usize = 0;

    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw { len = (size_t)snprintf(buf, 64, "%d", (int)n); }
    } else if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        // ECMA-262 §7.1.17 Number::toString: NaN -> "NaN",
        // ±Infinity -> "Infinity" / "-Infinity"; integral doubles in
        // range get printed without a decimal point. printf("%g") would
        // emit lowercase "nan" / "inf" — wrong tag for JS observers.
        raw {
            if (isnan(d)) {
                len = (size_t)snprintf(buf, 64, "NaN");
            } else if (isinf(d)) {
                len = (size_t)snprintf(buf, 64, d > 0 ? "Infinity" : "-Infinity");
            } else if (d == (double)(int64_t)d && d >= -1e15 && d <= 1e15) {
                // Integral path within 53-bit range — exact integer print.
                len = (size_t)snprintf(buf, 64, "%lld", (long long)d);
            } else if (d == floor(d) && fabs(d) < 1e21) {
                // ECMA-262 NumberToString: integral doubles up to 10^21
                // print as integers (no scientific). %.0f respects the
                // IEEE-double rounding for values past 2^53.
                len = (size_t)snprintf(buf, 64, "%.0f", d);
            } else {
                // Spec wants the shortest string that round-trips
                // through strtod back to the same double. Try
                // increasing precision (1..17) and pick the first
                // that does. Worst case is %.17g; common values
                // settle around 1-6 sig figs.
                int found = 0;
                for (int prec = 1; prec <= 17 && !found; prec++) {
                    char tmp[64];
                    size_t n = (size_t)snprintf(tmp, 64, "%.*g", prec, d);
                    char* end = NULL;
                    double rt = strtod(tmp, &end);
                    if (rt == d) {
                        memcpy(buf, tmp, n + 1);
                        len = n;
                        found = 1;
                    }
                }
                if (!found) {
                    len = (size_t)snprintf(buf, 64, "%.17g", d);
                }
            }
        }
    } else if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { raw { len = (size_t)snprintf(buf, 64, "true"); } }
        else                    { raw { len = (size_t)snprintf(buf, 64, "false"); } }
    } else if zjs_is_null(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "null"); }
    } else if zjs_is_undefined(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "undefined"); }
    } else if zjs_is_object(v) != 0 || zjs_is_uint8_array(v) != 0 {
        // ECMA-262 §7.1.17/§7.1.18: ToPrimitive(O, "string") tries
        // toString then valueOf. Fetch each via property_get so
        // accessor getters fire (and their throws propagate). Uint8Array
        // (and Buffer, which subclasses it) is a distinct cell tag, not a
        // plain object — route it here too so `String(buf)` / `${buf}`
        // invoke its inherited toString (-> "65,66" / decoded text)
        // instead of falling through to the "[object]" sink. #328.
        let ts_v = property_get(ctx, v, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"toString", 8)));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_is_function(ts_v) != 0 || zjs_is_closure(ts_v) != 0 || zjs_is_host_function(ts_v) != 0 {
            let nullp: ZjsValue* = NULL;
            let r: ZjsValue = zjs_call_value_with_this(ctx, ts_v, v, nullp, 0);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_is_string(r) != 0 { return r; }
            if zjs_is_object(r) == 0 && zjs_is_array(r) == 0 {
                return zjs_to_string(ctx, r);
            }
        }
        let vo_v = property_get(ctx, v, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"valueOf", 7)));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_is_function(vo_v) != 0 || zjs_is_closure(vo_v) != 0 || zjs_is_host_function(vo_v) != 0 {
            let nullp: ZjsValue* = NULL;
            let r2: ZjsValue = zjs_call_value_with_this(ctx, vo_v, v, nullp, 0);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_is_object(r2) == 0 { return zjs_to_string(ctx, r2); }
        }
        raw { len = (size_t)snprintf(buf, 64, "[object Object]"); }
    } else if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        // ECMA-262 §22.2.5.13 (Function.prototype.toString):
        // - For built-in functions: "function NAME() { [native code] }".
        //   Spec doesn't pin the exact body, but the shape — `function`
        //   keyword, name, parens, body containing `[native code]` —
        //   is what lodash / underscore / debug / runtime-detection
        //   helpers across npm regex-test against to decide whether
        //   a probed value is a real native binding. Returning
        //   `[object Function]` previously caused lodash to misclassify
        //   Object.create, Map, etc. as non-native and fall back to
        //   broken empty-array paths (#292).
        // - For user functions / closures: same shape but with
        //   "[user code]" since we don't keep the original source.
        let nm: char* = NULL;
        let nm_len: u32 = 0;
        let body: char* = (char*)"[native code]";
        let body_len: u32 = 13;
        if zjs_is_host_function(v) != 0 {
            let hf = zjs_as_host_function(v);
            if hf.name != NULL {
                nm = hf.name;
                raw { nm_len = (uint32_t)strlen(nm); }
            }
        } else if zjs_is_function(v) != 0 {
            let fp = zjs_cell_as_ptr(v);
            let f: Function* = NULL;
            raw { f = (Function*)fp; }
            body = (char*)"[user code]";
            body_len = 11;
            if f.props != NULL {
                let nm_atom = ctx_intern_atom(ctx, (char*)"name", 4);
                let slot = class_find_slot(f.props.cls, nm_atom);
                if slot >= 0 {
                    let nv: ZjsValue = f.props.slots[(u32)slot];
                    if zjs_is_string(nv) != 0 {
                        let ns = zjs_as_string(nv);
                        nm = ns.data; nm_len = ns.length;
                    }
                }
            }
        } else if zjs_is_closure(v) != 0 {
            let cl = zjs_as_closure(v);
            body = (char*)"[user code]";
            body_len = 11;
            let fp2 = cl.function;
            let f2: Function* = NULL;
            raw { f2 = (Function*)fp2; }
            if f2.props != NULL {
                let nm_atom = ctx_intern_atom(ctx, (char*)"name", 4);
                let slot = class_find_slot(f2.props.cls, nm_atom);
                if slot >= 0 {
                    let nv: ZjsValue = f2.props.slots[(u32)slot];
                    if zjs_is_string(nv) != 0 {
                        let ns = zjs_as_string(nv);
                        nm = ns.data; nm_len = ns.length;
                    }
                }
            }
        }
        // Build: "function <name>() { <body> }"
        // Fixed parts: "function "(9) + "() { "(5) + " }"(2) = 16 bytes.
        let total: u32 = 9 + nm_len + 5 + body_len + 2;
        let out_buf = alloc_n<char>((usize)(total + 1));
        let off: u32 = 0;
        raw {
            memcpy(out_buf + off, "function ", 9);
        }
        off = off + 9;
        if nm_len > 0 {
            raw { memcpy(out_buf + off, nm, nm_len); }
            off = off + nm_len;
        }
        raw {
            memcpy(out_buf + off, "() { ", 5);
        }
        off = off + 5;
        raw { memcpy(out_buf + off, body, body_len); }
        off = off + body_len;
        raw { memcpy(out_buf + off, " }", 2); }
        off = off + 2;
        out_buf[off] = (char)0;
        let r = ctx_intern_string(ctx, out_buf, total);
        dealloc(out_buf);
        return r;
    } else if zjs_is_array(v) != 0 {
        // Array → comma-joined elements, no surrounding []. Spec's
        // Array.prototype.toString delegates to Array.prototype.join.
        // We don't have join inlined here, so build it locally.
        // Holes / undefined / null contribute "" to the join.
        let arr = zjs_as_array(v);
        let total: u32 = 0;
        let i_a: u32 = 0;
        // First pass: total byte count.
        while i_a < arr.length {
            if i_a > 0 { total = total + 1; } // comma
            let el = array_get(arr, i_a);  // hole → undefined
            if zjs_is_undefined(el) == 0 && zjs_is_null(el) == 0 {
                let es = zjs_to_string(ctx, el);
                if zjs_is_string(es) != 0 {
                    total = total + zjs_as_string(es).length;
                }
            }
            i_a = i_a + 1;
        }
        let big = alloc_n<char>((usize)(total + 1));
        let off: u32 = 0;
        let i_b: u32 = 0;
        while i_b < arr.length {
            if i_b > 0 {
                big[off] = ',';
                off = off + 1;
            }
            let el = array_get(arr, i_b);
            if zjs_is_undefined(el) == 0 && zjs_is_null(el) == 0 {
                let es = zjs_to_string(ctx, el);
                if zjs_is_string(es) != 0 {
                    let s = zjs_as_string(es);
                    let dst: char* = NULL;
                    raw { dst = &big[off]; }
                    mem_copy<char>(dst, s.data, (usize)s.length);
                    off = off + s.length;
                }
            }
            i_b = i_b + 1;
        }
        big[total] = (char)0;
        return ctx_intern_string_take(ctx, big, total);
    } else {
        raw { len = (size_t)snprintf(buf, 64, "[object]"); }
    }

    return ctx_intern_string(ctx, &buf[0], (u32)len);
}

// String concatenation: a + b where at least one is a string. Both
// operands are coerced to strings; result is a fresh interned string
// on the context.
fn zjs_string_concat(ctx: ZjsContext*, a: ZjsValue, b: ZjsValue) -> ZjsValue {
    let sa_val = zjs_to_string(ctx, a);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let sb_val = zjs_to_string(ctx, b);
    if ctx.pending_throw_active { return zjs_undefined(); }

    // O(1) length lookup — works for both flat strings and ropes.
    let la = zjs_string_length(sa_val);
    let lb = zjs_string_length(sb_val);
    let total = la + lb;

    // Empty-side fast paths.
    if la == 0 { return sb_val; }
    if lb == 0 { return sa_val; }

    // Build a rope for non-trivial concatenations. Threshold (32
    // chars) avoids rope-tree overhead for the common short-string
    // case where the flat memcpy is cheaper than the lazy traversal.
    // For the `s = s + 'x'` build-up pattern this kicks in after a
    // few iterations and gives us O(n) total instead of O(n²).
    if total >= 32 {
        let r = zjs_string_rope_new(sa_val, sb_val, total);
        ctx_register_cell(ctx, (void*)r);
        return zjs_cell_from_ptr((void*)r);
    }

    // Short-string flat concat. Resolves any rope inputs once.
    let sa = zjs_as_string(sa_val);
    let sb = zjs_as_string(sb_val);
    let buf: char* = NULL;
    raw { buf = (char*)malloc((size_t)(total + 1)); }
    mem_copy<char>(buf, sa.data, (usize)sa.length);
    let tail: char* = NULL;
    raw { tail = &buf[sa->length]; }
    mem_copy<char>(tail, sb.data, (usize)sb.length);
    buf[total] = (char)0;
    return ctx_intern_string_take(ctx, buf, total);
}

// Find an existing global by name. Returns -1 if not found (i32 so we
// can use a sentinel).
fn ctx_find_global(ctx: ZjsContext*, name: char*, name_len: u32) -> i32 {
    let i: u32 = 0;
    while i < ctx.global_count {
        if ctx.globals[i].name_len == name_len {
            let ent_name = ctx.globals[i].name;
            let eq: int = 0;
            raw { eq = (memcmp(ent_name, name, name_len) == 0) ? 1 : 0; }
            if eq != 0 { return (i32)i; }
        }
        i = i + 1;
    }
    return -1;
}

// Intern a global name: return its slot index, creating a fresh slot
// (with value = undefined) if it doesn't exist yet. Decodes any
// `\uXXXX` / `\u{...}` escapes in the source slice so identifier
// references and declarations land in the same slot.
fn ctx_intern_global(ctx: ZjsContext*, name: char*, name_len: u32) -> u32 {
    let has_escape: bool = false;
    let i: u32 = 0;
    while i + 1 < name_len {
        if name[i] == (char)'\\' && name[i+1] == (char)'u' { has_escape = true; break; }
        i = i + 1;
    }
    if has_escape {
        let buf = alloc_n<char>((usize)(name_len + 1));
        let dec_len = decode_ident_escapes(name, name_len, buf);
        buf[dec_len] = (char)0;
        let existing = ctx_find_global(ctx, buf, dec_len);
        if existing >= 0 { dealloc(buf); return (u32)existing; }
        if ctx.global_count >= ctx.global_cap {
            let new_cap: u32 = if ctx.global_cap == 0 { 16 } else { ctx.global_cap * 2 };
            ctx.globals = realloc_n<GlobalEntry>(ctx.globals, (usize)ctx.global_cap, (usize)new_cap);
            ctx.global_cap = new_cap;
        }
        let idx = ctx.global_count;
        ctx.globals[idx].name = buf;
        ctx.globals[idx].name_len = dec_len;
        ctx.globals[idx].value = zjs_undefined();
        ctx.global_count = ctx.global_count + 1;
        return idx;
    }
    let existing = ctx_find_global(ctx, name, name_len);
    if existing >= 0 { return (u32)existing; }

    // Grow the table if needed. realloc_n already zero-inits the new
    // bytes, so we don't need a separate memset for the new tail.
    if ctx.global_count >= ctx.global_cap {
        let new_cap: u32 = if ctx.global_cap == 0 { 16 } else { ctx.global_cap * 2 };
        ctx.globals = realloc_n<GlobalEntry>(ctx.globals, (usize)ctx.global_cap, (usize)new_cap);
        ctx.global_cap = new_cap;
    }

    // Allocate + copy the name (it's a slice of caller's source).
    let name_copy = alloc_n<char>((usize)(name_len + 1));
    mem_copy<char>(name_copy, name, (usize)name_len);
    name_copy[name_len] = (char)0;

    let idx = ctx.global_count;
    ctx.globals[idx].name = name_copy;
    ctx.globals[idx].name_len = name_len;
    ctx.globals[idx].value = zjs_undefined();
    ctx.global_count = ctx.global_count + 1;
    return idx;
}

// =====================================================================
// ES modules — file-based loader.
// =====================================================================

// Path-resolution helper. `spec` is the literal specifier from
// `import ... from 'spec'`. If it starts with './' or '../', resolve
// against the *directory* of `base_abs_path`; otherwise treat as
// already-absolute (extension-only resolution can come later). Returns
// a freshly-interned ZjsString*; NULL on out-of-bounds buffer.
fn module_resolve_specifier(ctx: ZjsContext*, base_abs_path: ZjsString*, spec: ZjsString*) -> ZjsString* {
    if spec == NULL { return NULL; }
    let sd = spec.data;
    let sl = spec.length;
    let is_relative: bool = false;
    let is_file_url: bool = false;
    raw {
        is_relative = (sl >= 2 && sd[0] == '.' && (sd[1] == '/' || (sd[1] == '.' && sl >= 3 && sd[2] == '/'))) ? true : false;
        // file:// URL scheme — common for tooling that hands paths as URLs
        // (Bun, deno, modern Node ESM). Strip the prefix and treat the
        // remainder as an absolute path.
        is_file_url = (sl >= 7 && sd[0] == 'f' && sd[1] == 'i' && sd[2] == 'l' && sd[3] == 'e'
                       && sd[4] == ':' && sd[5] == '/' && sd[6] == '/') ? true : false;
    }
    if is_file_url {
        // file:///abs/path: strip "file://", keep the leading "/" of
        // the abs path. That makes "file:///tmp/x.js" → "/tmp/x.js"
        // and "file://localhost/tmp/x.js" → "localhost/tmp/x.js" which
        // will fail to read (we don't support remote file authorities).
        let off: u32 = 7;
        let new_len: u32 = sl - off;
        let buf = alloc_n<char>((usize)(new_len + 1));
        raw { memcpy(buf, sd + off, new_len); buf[new_len] = 0; }
        return ctx_intern_atom_take(ctx, buf, new_len);
    }
    if !is_relative {
        // Treat as already a usable path. https:// + npm: + bare specifiers
        // (node_modules-style) aren't supported — they'll fall through to
        // ctx_load_module's file-read and surface "module not found".
        return spec;
    }
    if base_abs_path == NULL {
        // Relative spec with no base: assume cwd (rare; only happens
        // when the entry module's own abs_path wasn't set).
        return spec;
    }
    // Dirname of base.
    let bd = base_abs_path.data;
    let bl = base_abs_path.length;
    let dir_len: u32 = bl;
    raw {
        while (dir_len > 0 && bd[dir_len - 1] != '/') { dir_len--; }
    }
    let total: u32 = dir_len + sl;
    let buf = alloc_n<char>((usize)(total + 1));
    raw {
        memcpy(buf, bd, dir_len);
        memcpy(buf + dir_len, sd, sl);
        buf[total] = 0;
        // Normalize `./` and `../` segments in place.
        char* out = buf;
        char* in_ = buf;
        while (*in_) {
            if (in_[0] == '/' && in_[1] == '.' && in_[2] == '/') {
                in_ += 2;        // skip the "./" — the leading slash stays at *out
                continue;
            }
            if (in_[0] == '/' && in_[1] == '.' && in_[2] == '.' && (in_[3] == '/' || in_[3] == 0)) {
                // Roll output back to the previous '/' to drop the prior segment.
                if (out > buf) out--;
                while (out > buf && *(out - 1) != '/') out--;
                in_ += 3;
                continue;
            }
            *out++ = *in_++;
        }
        *out = 0;
        total = (uint32_t)(out - buf);
    }
    let s = ctx_intern_atom_take(ctx, buf, total);
    return s;
}

// Grow + claim a fresh slot in the builtin_modules array, return a
// pointer for the caller to fill. Internal helper.
fn ctx_alloc_builtin_module(ctx: ZjsContext*, name: char*) -> ZjsBuiltinModule* {
    if ctx.builtin_module_count >= ctx.builtin_module_cap {
        let new_cap: u32 = if ctx.builtin_module_cap == 0 { 8 } else { ctx.builtin_module_cap * 2 };
        ctx.builtin_modules = realloc_n<ZjsBuiltinModule>(
            ctx.builtin_modules, (usize)ctx.builtin_module_cap, (usize)new_cap);
        ctx.builtin_module_cap = new_cap;
    }
    let nlen: u32 = 0;
    raw { nlen = (uint32_t)strlen(name); }
    let nm = ctx_intern_atom(ctx, name, nlen);
    let entry: ZjsBuiltinModule* = NULL;
    raw { entry = &ctx->builtin_modules[ctx->builtin_module_count]; }
    entry.name       = nm;
    entry.populate   = NULL;
    entry.source     = NULL;
    entry.source_len = 0;
    entry.record     = NULL;
    ctx.builtin_module_count = ctx.builtin_module_count + 1;
    return entry;
}

// Register a native built-in module under `name`. `populate` is a C
// callback `void (*)(ZjsContext*, ZjsObject* exports)` — called once
// on first import to attach host functions / values.
fn ctx_register_builtin_module(ctx: ZjsContext*, name: char*, populate: void*) -> void {
    let e = ctx_alloc_builtin_module(ctx, name);
    e.populate = populate;
}

// Register a pure-JS built-in module under `name`. `source` is a
// pointer to static JS source; `source_len` is its byte length. On
// first import the source is compiled + evaluated as an ES module.
fn ctx_register_builtin_module_source(ctx: ZjsContext*, name: char*,
                                      source: char*, source_len: u32) -> void {
    let e = ctx_alloc_builtin_module(ctx, name);
    e.source     = source;
    e.source_len = source_len;
}

fn builtin_module_find(ctx: ZjsContext*, name: ZjsString*) -> ZjsBuiltinModule* {
    if name == NULL { return NULL; }
    let i: u32 = 0;
    while i < ctx.builtin_module_count {
        let m: ZjsBuiltinModule* = NULL;
        raw { m = &ctx->builtin_modules[i]; }
        if m.name == name { return m; }
        // Atom interning should dedupe, but fall back to byte compare.
        if m.name != NULL && m.name.length == name.length {
            let eq: bool = true;
            raw {
                if (memcmp(m->name->data, name->data, name->length) != 0) eq = false;
            }
            if eq { return m; }
        }
        i = i + 1;
    }
    return NULL;
}

// Entry point — registers every Ring-1 builtin module the engine
// knows about. Default `zjs_new_context()` calls this. Embedders
// wanting a minimal engine can either skip it or selectively call
// the per-module helpers (zjs_register_node_path, ...) after a
// future zjs_new_minimal_context().
//
// Per-module registrations live alongside their populate / source
// functions (e.g. zjs_register_node_path in src/stdlib/node_path.zc).
fn ctx_register_stdlib_modules(ctx: ZjsContext*) -> void {
    zjs_register_node_path(ctx);
    zjs_register_node_fs(ctx);
    zjs_register_node_process(ctx);
    zjs_register_node_os(ctx);
    zjs_register_node_buffer(ctx);
    zjs_register_node_tty(ctx);
    zjs_register_node_dx(ctx);
    zjs_register_node_stream(ctx);
    zjs_register_node_url(ctx);
    zjs_register_node_zlib(ctx);
    zjs_register_node_child_process(ctx);
    zjs_register_node_net(ctx);
    zjs_register_node_http(ctx);
}

fn module_cache_find(ctx: ZjsContext*, abs_path: ZjsString*) -> ZjsModuleRecord* {
    let i: u32 = 0;
    while i < ctx.module_cache_count {
        let m = ctx.module_cache[i];
        if m.abs_path == abs_path { return m; }
        // Atom-interning should have already deduped — but fall back
        // to a byte compare for safety.
        if m.abs_path != NULL && abs_path != NULL
           && m.abs_path.length == abs_path.length {
            let eq: bool = true;
            raw {
                if (memcmp(m->abs_path->data, abs_path->data, abs_path->length) != 0) eq = false;
            }
            if eq { return m; }
        }
        i = i + 1;
    }
    return NULL;
}

fn module_cache_push(ctx: ZjsContext*, m: ZjsModuleRecord*) -> void {
    if ctx.module_cache_count >= ctx.module_cache_cap {
        let new_cap: u32 = if ctx.module_cache_cap == 0 { 8 } else { ctx.module_cache_cap * 2 };
        ctx.module_cache = realloc_n<ZjsModuleRecord*>(ctx.module_cache, (usize)ctx.module_cache_cap, (usize)new_cap);
        ctx.module_cache_cap = new_cap;
    }
    ctx.module_cache[ctx.module_cache_count] = m;
    ctx.module_cache_count = ctx.module_cache_count + 1;
}

fn read_file_to_string(path: char*) -> char* {
    let out: char* = NULL;
    raw {
        FILE* f = fopen(path, "rb");
        if (!f) return NULL;
        fseek(f, 0, SEEK_END);
        long sz = ftell(f);
        if (sz < 0) { fclose(f); return NULL; }
        fseek(f, 0, SEEK_SET);
        out = (char*)malloc((size_t)sz + 1);
        if (!out) { fclose(f); return NULL; }
        size_t n = fread(out, 1, (size_t)sz, f);
        out[n] = 0;
        fclose(f);
    }
    return out;
}

// The bytecode compiler + interpreter live in sibling .zc files; the
// loader needs to call into them. Forward-declare with extern.
raw {
    extern Function* compile_program(ZjsContext* ctx, char* source, AstNode* root);
    extern InterpretResult interpret(ZjsContext* ctx, Function* entry_f, ZjsValue* args, uint32_t arg_count);
    extern ParseResult parse_module(char* source, size_t source_len);
    extern void parser_free_result(ParseResult pr);
}

// Load + (recursively) evaluate the module at `abs_path`. Returns the
// cached record on subsequent calls.
// Internal helper: parse + compile + register + evaluate a module
// from an already-owned source buffer. The caller is responsible for
// reading the source (from disk, from a passed-in string, etc.) and
// passing in the abs_path atom that becomes the module's cache key.
//
// `src` must be a heap-allocated NUL-terminated buffer; this function
// retains it (Functions hold offsets into the source). Caller must NOT
// free it after the call.
//
// On parse/compile/evaluation failure, sets ctx.pending_throw and
// returns either NULL (couldn't even build a record) or the errored
// module record. The src buffer is freed in the parse/compile-failure
// paths since no Function ends up owning it.
fn ctx_eval_module_with_source(ctx: ZjsContext*, abs_path: ZjsString*, src: char*) -> ZjsModuleRecord* {
    let src_len: usize = 0;
    raw { src_len = strlen(src); }
    let parse: ParseResult = parse_module(src, src_len);
    if parse.had_error {
        raw { parser_free_result(parse); free(src); }
        let err = build_typed_error(ctx, (char*)"SyntaxError", 11,
                                    (char*)"module parse error", 18);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return NULL;
    }
    let f: Function* = NULL;
    raw {
        void* root_v = parse.root;
        f = compile_program(ctx, src, root_v);
        parser_free_result(parse);
    }
    if f == NULL {
        raw { free(src); }
        let err = build_typed_error(ctx, (char*)"SyntaxError", 11,
                                    (char*)"module compile error", 20);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return NULL;
    }
    // NOTE: leak src buffer — Function holds offsets into it. A real
    // module record would adopt the buffer; tracking ownership is a
    // follow-up. For MVP, accept the per-module leak.

    // Construct + register the record BEFORE evaluating so circular
    // imports can find the in-flight record (cycle detection then
    // resolves names via partial exports).
    let m = alloc<ZjsModuleRecord>();
    m.abs_path = abs_path;
    m.function = f;
    m.exports  = zjs_as_object(ctx_new_object(ctx));
    m.state    = MODULE_STATE_EVALUATING;
    m.error    = zjs_undefined();
    module_cache_push(ctx, m);

    // Evaluate the body with current_module pointed at it so the
    // ImportBind / ExportBind ops route to the right cache + exports.
    let saved_cm = ctx.current_module;
    let saved_th = ctx.host_this;
    ctx.current_module = m;
    if ctx.global_this_obj != NULL {
        ctx.host_this = zjs_cell_from_ptr((void*)ctx.global_this_obj);
    }
    let r: InterpretResult = zjs_undefined_result();
    raw {
        InterpretResult ir = interpret(ctx, f, NULL, 0);
        r = ir;
    }
    ctx.current_module = saved_cm;
    ctx.host_this = saved_th;
    if r.is_throw {
        m.state = MODULE_STATE_ERRORED;
        m.error = r.value;
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = r.value;
        return m;
    }
    m.state = MODULE_STATE_EVALUATED;
    return m;
}

fn ctx_load_module(ctx: ZjsContext*, abs_path: ZjsString*) -> ZjsModuleRecord* {
    if abs_path == NULL { return NULL; }
    let existing = module_cache_find(ctx, abs_path);
    if existing != NULL {
        if existing.state == MODULE_STATE_EVALUATED { return existing; }
        if existing.state == MODULE_STATE_EVALUATING {
            // Circular import — surface a real error once cycle support
            // lands. For MVP, return the (partially populated) record;
            // the in-flight body sees `undefined` for not-yet-set names.
            return existing;
        }
        if existing.state == MODULE_STATE_ERRORED {
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = existing.error;
            return existing;
        }
    }

    // Built-in (synthetic) module shortcut — `node:fs`, `node:path`,
    // etc. Skips file I/O entirely.
    let bm = builtin_module_find(ctx, abs_path);
    if bm != NULL {
        if bm.record != NULL { return bm.record; }
        // Source variant — compile + evaluate as a normal ES module.
        // ctx_eval_module_with_source registers the record + pushes
        // it to the cache itself, so we just cache the result back
        // onto the builtin entry.
        if bm.source != NULL {
            let copy: char* = NULL;
            raw {
                copy = (char*)malloc((size_t)bm->source_len + 1);
                memcpy(copy, bm->source, bm->source_len);
                copy[bm->source_len] = 0;
            }
            let m = ctx_eval_module_with_source(ctx, abs_path, copy);
            if m != NULL { bm.record = m; }
            return m;
        }
        // Native variant — hand an empty exports object to the
        // populate callback.
        let exp_v = ctx_new_object(ctx);
        let m = alloc<ZjsModuleRecord>();
        m.abs_path = abs_path;
        m.function = NULL;
        m.exports  = zjs_as_object(exp_v);
        m.state    = MODULE_STATE_EVALUATED;
        m.error    = zjs_undefined();
        bm.record = m;
        module_cache_push(ctx, m);
        let pop_ptr = bm.populate;
        if pop_ptr != NULL {
            raw {
                ((void (*)(ZjsContext*, ZjsObject*))pop_ptr)(ctx, m->exports);
            }
        }
        // CJS-interop default export. ESM `import X from 'node:foo'`
        // requires a "default" binding. Node's convention (and the
        // shape bundlers like esbuild / bun / rollup emit when they
        // leave node: imports external) is: the entire exports
        // object IS the default. Wire it here unless the populate
        // callback set its own explicit default (rare — node_process
        // does it manually to point at the live globalThis.process).
        let dflt_atom = ctx_intern_atom(ctx, (char*)"default", 7);
        let existing_dflt_slot = class_find_slot(m.exports.cls, dflt_atom);
        if existing_dflt_slot < 0 {
            object_set(ctx, m.exports, dflt_atom, zjs_cell_from_ptr((void*)m.exports));
        }
        return m;
    }

    // Read file.
    let path_c: char* = NULL;
    let path_buf = alloc_n<char>((usize)(abs_path.length + 1));
    raw {
        memcpy(path_buf, abs_path->data, abs_path->length);
        path_buf[abs_path->length] = 0;
        path_c = path_buf;
    }
    let src = read_file_to_string(path_c);
    dealloc(path_buf);
    if src == NULL {
        // Diagnose the common "couldn't resolve" cases with a hint —
        // a bare specifier (`react`) or an https:/npm: URL won't read
        // as a local file, so make that explicit rather than the
        // generic "module not found" which suggests a missing file.
        let sd = abs_path.data;
        let sl = abs_path.length;
        let looks_like_url: bool = false;
        let looks_like_bare: bool = false;
        raw {
            looks_like_url =
                (sl >= 8 && sd[0] == 'h' && sd[1] == 't' && sd[2] == 't' && sd[3] == 'p'
                 && (sd[4] == 's' || sd[4] == ':')) ||
                (sl >= 4 && sd[0] == 'n' && sd[1] == 'p' && sd[2] == 'm' && sd[3] == ':');
            // "bare specifier" = no slash and not starting with . — looks
            // like `react`, `lodash`, etc. We don't walk node_modules.
            int has_slash = 0;
            for (uint32_t i = 0; i < sl; i++) { if (sd[i] == '/') { has_slash = 1; break; } }
            looks_like_bare = !has_slash && sl > 0 && sd[0] != '.';
        }
        let msg: char* = (char*)"module not found";
        let mlen: u32 = 16;
        if looks_like_url {
            msg = (char*)"unsupported module URL scheme (only file:// and node: are resolved)";
            mlen = 67;
        } else if looks_like_bare {
            msg = (char*)"bare specifier not resolved (use ./relative or node:builtin)";
            mlen = 60;
        }
        let err = build_typed_error(ctx, (char*)"Error", 5, msg, mlen);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return NULL;
    }
    return ctx_eval_module_with_source(ctx, abs_path, src);
}

// Called from Op::ImportBind. Returns the value of source.exports[name]
// — or, when name is "*", the exports object itself (namespace import).
// On error, sets ctx.pending_throw and returns undefined.
fn ctx_module_import_value(ctx: ZjsContext*, spec_v: ZjsValue, name_v: ZjsValue) -> ZjsValue {
    if zjs_is_string(spec_v) == 0 || zjs_is_string(name_v) == 0 {
        return zjs_undefined();
    }
    let spec = zjs_as_string(spec_v);
    let name = zjs_as_string(name_v);
    let base = if ctx.current_module != NULL { ctx.current_module.abs_path } else { NULL };
    let resolved = module_resolve_specifier(ctx, base, spec);
    if resolved == NULL {
        let err = build_typed_error(ctx, (char*)"Error", 5,
                                    (char*)"could not resolve module specifier", 35);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let m = ctx_load_module(ctx, resolved);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if m == NULL { return zjs_undefined(); }
    // Namespace import: hand back the exports object directly.
    if name.length == 1 {
        let nd = name.data;
        let star_match: bool = false;
        raw { star_match = (nd[0] == '*') ? true : false; }
        if star_match {
            return zjs_cell_from_ptr((void*)m.exports);
        }
    }
    // Named: look up in exports.
    let slot = class_find_slot(m.exports.cls, name);
    if slot < 0 {
        // Missing export — surface as TypeError for now (spec says
        // SyntaxError on link; we don't have a true link phase).
        let buf: char[128];
        let n: int = 0;
        let nm_d = name.data;
        let nm_l = name.length;
        raw {
            n = snprintf(&buf[0], 128, "export '%.*s' not found in module",
                         (int)(nm_l > 64 ? 64 : nm_l), nm_d);
        }
        let bp: char* = NULL; raw { bp = &buf[0]; }
        let err = build_typed_error(ctx, (char*)"SyntaxError", 11, bp, (u32)n);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    return m.exports.slots[(u32)slot];
}

// Helper used in InterpretResult-returning extern paths.
fn zjs_undefined_result() -> InterpretResult {
    return InterpretResult{ is_throw: false, value: zjs_undefined() };
}
