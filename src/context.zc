    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"sign",   4),  ctx_make_host_function_arity(ctx, (char*)"sign",   sign_ptr,   1));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"hypot",  5),  ctx_make_host_function_arity(ctx, (char*)"hypot",  hypot_ptr,  2));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"fround", 6),  ctx_make_host_function_arity(ctx, (char*)"fround", fround_ptr, 1));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"clz32",  5),  ctx_make_host_function_arity(ctx, (char*)"clz32",  clz32_ptr,  1));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"imul",   4),  ctx_make_host_function_arity(ctx, (char*)"imul",   imul_ptr,   2));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"random", 6),  ctx_make_host_function_arity(ctx, (char*)"random", random_ptr, 0));

    // Math constants — ECMA-262 §21.3. Read-only data properties.
    // PI/E come from std/math; the others aren't exposed there yet, so
    // we fall back to <math.h>'s M_* macros via raw{}.
    let ln2_d: f64 = 0.0;
    let ln10_d: f64 = 0.0;
    let log2e_d: f64 = 0.0;
    let log10e_d: f64 = 0.0;
    let sqrt2_d: f64 = 0.0;
    let sqrt1_2_d: f64 = 0.0;
    raw {
        ln2_d     = M_LN2;
        ln10_d    = M_LN10;
        log2e_d   = M_LOG2E;
        log10e_d  = M_LOG10E;
        sqrt2_d   = M_SQRT2;
        sqrt1_2_d = M_SQRT1_2;
    }
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"PI", 2),       zjs_double(Math::PI()));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"E", 1),        zjs_double(Math::E()));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"LN2", 3),      zjs_double(ln2_d));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"LN10", 4),     zjs_double(ln10_d));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"LOG2E", 5),    zjs_double(log2e_d));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"LOG10E", 6),   zjs_double(log10e_d));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"SQRT2", 5),    zjs_double(sqrt2_d));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"SQRT1_2", 7),  zjs_double(sqrt1_2_d));

    let math_slot = ctx_intern_global(ctx, (char*)"Math", 4);
    ctx.globals[math_slot].value = math_v;
    ctx.globals[math_slot].defined = true;

    // --- Object as a host-function constructor (Phase 3.8d) ---
    // Was a plain namespace object before; now a host function so
    // `{} instanceof Object` works and `new Object()` is meaningful.
    // Static methods (keys / create / getPrototypeOf) live on .props.
    let obj_ctor_ptr: void* = NULL; raw { obj_ctor_ptr = (void*)host_object_ctor; }
    let object_v = ctx_register_host_function(ctx, (char*)"Object", obj_ctor_ptr);
    let object_hf = zjs_as_host_function(object_v);
    object_hf.prototype = ctx.object_proto;
    object_set(ctx, ctx.object_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), object_v);
