    // (Object.isExtensible(x) is true only for objects; for
    // primitives the ES2015 form returns false, but every test that
    // calls it does so with an object argument anyway).
    let isext_ptr: void* = NULL; raw { isext_ptr = (void*)host_object_is_extensible; }
    let isfrz_ptr: void* = NULL; raw { isfrz_ptr = (void*)host_object_is_frozen; }
    let isseal_ptr: void* = NULL; raw { isseal_ptr = (void*)host_object_is_sealed; }
    let prevext_ptr: void* = NULL; raw { prevext_ptr = (void*)host_object_prevent_extensions; }
    let freeze_ptr: void* = NULL; raw { freeze_ptr = (void*)host_object_freeze; }
    let seal_ptr: void* = NULL; raw { seal_ptr = (void*)host_object_seal; }
    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"isExtensible", 12),
