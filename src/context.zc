    object_set(ctx, temporal_o, ctx_intern_atom(ctx, (char*)"PlainDateTime", 13), pdt_ctor);

    // --- Temporal.PlainYearMonth ---
    let ym_ctor_ptr: void* = NULL; raw { ym_ctor_ptr = (void*)host_temporal_yearmonth_ctor; }
    let ym_ctor = ctx_make_host_function(ctx, (char*)"PlainYearMonth", ym_ctor_ptr);
