    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"acosh",  5),  ctx_make_host_function_arity(ctx, (char*)"acosh",  acosh_ptr,  1));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"atanh",  5),  ctx_make_host_function_arity(ctx, (char*)"atanh",  atanh_ptr,  1));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"cbrt",   4),  ctx_make_host_function_arity(ctx, (char*)"cbrt",   cbrt_ptr,   1));
