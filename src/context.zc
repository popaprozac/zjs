        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let f: i64[10];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    let ok: int = 1;
    temporal_read_duration(ctx, if argc >= 1 { args[0] } else { zjs_undefined() }, fp, &ok);
    if ok == 0 { let e = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"invalid duration", 16);
        ctx.pending_throw_active = true; ctx.pending_throw_value = e; return zjs_undefined(); }
    if sign < 0 { temporal_negate_dur(fp); }
    let w: i64[7];
    let wp: i64* = NULL; raw { wp = &w[0]; }
    let off: i64 = 0;
    zdt_decompose(s, wp, &off);
    // date part → new wall date (calendar add with clamp)
    let outd: i64[3];
    let odp: i64* = NULL; raw { odp = &outd[0]; }
    temporal_add_to_date(w[0], w[1], w[2], f[0], f[1], f[2], f[3], odp);
    // re-anchor the wall clock to an instant in the zone
    let inter = zdt_epoch_ns_from_wall(s.timezone, outd[0], outd[1], outd[2], w[3], w[4], w[5], w[6]);
    // exact time part
    let result = inter + temporal_duration_time_ns(fp);
    return zdt_make(ctx, result, s.timezone);
}
fn host_temporal_zdt_add(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return zdt_add_impl(ctx, 1, args, argc);
}
fn host_temporal_zdt_subtract(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return zdt_add_impl(ctx, -1, args, argc);
}

// ZonedDateTime.with({ year?, month?, ... }) — override wall-clock
// fields, re-anchor through the zone.
fn host_temporal_zdt_with(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_ZONED_DATETIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.ZonedDateTime", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_object(arg) == 0 { return temporal_range_error(ctx, (char*)"with() expects an object", 24); }
    let w: i64[7];
    let wp: i64* = NULL; raw { wp = &w[0]; }
    let off: i64 = 0;
    zdt_decompose(s, wp, &off);
    let fields = (char*)"year"; let _u = fields;
    let yv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"year", 4));
    let mv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"month", 5));
    let dv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"day", 3));
    let hv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"hour", 4));
    let miv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"minute", 6));
    let sv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"second", 6));
    let y  = if zjs_is_undefined(yv)  != 0 { w[0] } else { (i64)zjs_to_double(yv) };
    let mo = if zjs_is_undefined(mv)  != 0 { w[1] } else { (i64)zjs_to_double(mv) };
    let d  = if zjs_is_undefined(dv)  != 0 { w[2] } else { (i64)zjs_to_double(dv) };
    let h  = if zjs_is_undefined(hv)  != 0 { w[3] } else { (i64)zjs_to_double(hv) };
    let mi = if zjs_is_undefined(miv) != 0 { w[4] } else { (i64)zjs_to_double(miv) };
    let sc = if zjs_is_undefined(sv)  != 0 { w[5] } else { (i64)zjs_to_double(sv) };
    let cc: i64[3];
    let cp: i64* = NULL; raw { cp = &cc[0]; }
    temporal_constrain_date(y, mo, d, cp);
    let ep = zdt_epoch_ns_from_wall(s.timezone, cc[0], cc[1], cc[2], h, mi, sc, w[6]);
    return zdt_make(ctx, ep, s.timezone);
}

// ZonedDateTime.round(options) — rounds the local wall clock (day..ns)
// then re-anchors.
fn host_temporal_zdt_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_ZONED_DATETIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.ZonedDateTime", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let unit_ns: i64 = 0; let inc: i64 = 1; let mode: int = ROUND_HALF_EXPAND; let ok: int = 1;
    temporal_rounding_opts(ctx, if argc >= 1 { args[0] } else { zjs_undefined() },
                           ROUND_HALF_EXPAND, &unit_ns, &inc, &mode, &ok);
    if ok == 0 || unit_ns == 0 { return temporal_range_error(ctx, (char*)"invalid smallestUnit", 20); }
    let s = zjs_as_temporal(this_v);
    let w: i64[7];
    let wp: i64* = NULL; raw { wp = &w[0]; }
    let off: i64 = 0;
    zdt_decompose(s, wp, &off);
    let days = iso_days_from_civil(w[0], w[1], w[2]);
    let tod = ((w[3] * 60 + w[4]) * 60 + w[5]) * 1000000000 + w[6];
    let total = days * 86400000000000 + tod;
    let rounded = temporal_round_i64(total, inc * unit_ns, mode);
    let out_days = i64_floordiv(rounded, 86400000000000);
    let rtod = i64_floormod(rounded, 86400000000000);
    let od: i64[3];
    let odp: i64* = NULL; raw { odp = &od[0]; }
    iso_civil_from_days(out_days, odp);
    let hh = rtod / 3600000000000;
    let mm = (rtod / 60000000000) % 60;
    let ss = (rtod / 1000000000) % 60;
    let subns = rtod % 1000000000;
    let ep = zdt_epoch_ns_from_wall(s.timezone, od[0], od[1], od[2], hh, mm, ss, subns);
    return zdt_make(ctx, ep, s.timezone);
}

// ZonedDateTime.until/since → Duration (time units; rounding honored).
// dir +1 until, -1 since. Calendar-unit largestUnit deferred.
fn zdt_diff_impl(ctx: ZjsContext*, dir: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_ZONED_DATETIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.ZonedDateTime", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let other = if argc >= 1 { args[0] } else { zjs_undefined() };
    // Coerce a string / property-bag argument via ZonedDateTime.from.
    if zjs_is_temporal_kind(other, TMP_ZONED_DATETIME) == 0 {
        let oa: ZjsValue[1]; oa[0] = other; let oap: ZjsValue* = NULL; raw { oap = &oa[0]; }
        other = host_temporal_zdt_from(ctx, oap, 1);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    let a = zjs_as_temporal(this_v); let b = zjs_as_temporal(other);
    let na = bigint_to_i64(zjs_as_bigint(a.epoch_ns));
    let nb = bigint_to_i64(zjs_as_bigint(b.epoch_ns));
    let largest = temporal_parse_largest_unit(ctx, if argc >= 2 { args[1] } else { zjs_undefined() }, -1);
    if largest < 0 {
        // time-unit difference: exact epoch delta, balanced into time units.
        let diff = (nb - na) * dir;
        let optarg = if argc >= 2 { args[1] } else { zjs_undefined() };
        // Round only when a smallestUnit is actually supplied.
        let has_su = if zjs_is_object(optarg) != 0 {
            zjs_is_string(property_get(ctx, optarg, ctx_intern_string(ctx, (char*)"smallestUnit", 12)))
        } else { 0 };
        if has_su != 0 {
            let unit_ns: i64 = 0; let inc: i64 = 1; let mode: int = ROUND_TRUNC; let ok: int = 1;
            temporal_rounding_opts(ctx, optarg, ROUND_TRUNC, &unit_ns, &inc, &mode, &ok);
            if ok == 0 || unit_ns == 0 { return temporal_range_error(ctx, (char*)"invalid smallestUnit", 20); }
            if unit_ns == 86400000000000 { return temporal_range_error(ctx, (char*)"ZonedDateTime time-diff cannot use days", 39); }
            diff = temporal_round_i64(diff, inc * unit_ns, mode);
        }
        let t = zjs_temporal_new(TMP_DURATION);
        temporal_balance_time(t, diff, largest);
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    // calendar / day units: require matching time zones, then re-anchor the
    // candidate date duration through the zone and read the exact remainder
    // (so days reflect real elapsed time across DST, not a nominal 24h).
    if a.timezone == NULL || b.timezone == NULL || zjs_string_equals(a.timezone, b.timezone) == 0 {
        return temporal_range_error(ctx, (char*)"ZonedDateTime calendar diff needs matching time zones", 53);
    }
    let tz = if dir > 0 { a.timezone } else { b.timezone };
    let end_ep = if dir > 0 { nb } else { na };
    let ws: i64[7]; let wsp: i64* = NULL; raw { wsp = &ws[0]; } let offs: i64 = 0;
    let we: i64[7]; let wep: i64* = NULL; raw { wep = &we[0]; } let offe: i64 = 0;
    zdt_decompose(if dir > 0 { a } else { b }, wsp, &offs);
    zdt_decompose(if dir > 0 { b } else { a }, wep, &offe);
    let start_tod = ((ws[3] * 60 + ws[4]) * 60 + ws[5]) * 1000000000 + ws[6];
    let end_tod   = ((we[3] * 60 + we[4]) * 60 + we[5]) * 1000000000 + we[6];
    let days1 = iso_days_from_civil(ws[0], ws[1], ws[2]);
    let days2 = iso_days_from_civil(we[0], we[1], we[2]);
    let time_delta = end_tod - start_tod;
    let ey = we[0]; let emo = we[1]; let ed = we[2];
    let date_sign: i64 = if days2 > days1 { 1 } else { if days2 < days1 { -1 } else { 0 } };
    if date_sign > 0 && time_delta < 0 {
        let od: i64[3]; let odp: i64* = NULL; raw { odp = &od[0]; }
        iso_civil_from_days(days2 - 1, odp); ey = od[0]; emo = od[1]; ed = od[2];
    } else if date_sign < 0 && time_delta > 0 {
        let od: i64[3]; let odp: i64* = NULL; raw { odp = &od[0]; }
        iso_civil_from_days(days2 + 1, odp); ey = od[0]; emo = od[1]; ed = od[2];
    }
    let date_dur = temporal_diff_iso_date(ctx, ws[0], ws[1], ws[2], ey, emo, ed, largest);
    let dd = zjs_as_temporal(date_dur);
    let outd: i64[3]; let odp2: i64* = NULL; raw { odp2 = &outd[0]; }
    temporal_add_to_date(ws[0], ws[1], ws[2], dd.d_years, dd.d_months, dd.d_weeks, dd.d_days, odp2);
    let inter = zdt_epoch_ns_from_wall(tz, outd[0], outd[1], outd[2], ws[3], ws[4], ws[5], ws[6]);
    let remainder = end_ep - inter;
    temporal_balance_time(dd, remainder, -1);
    return date_dur;
}
fn host_temporal_zdt_until(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return zdt_diff_impl(ctx, 1, args, argc);
}
fn host_temporal_zdt_since(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return zdt_diff_impl(ctx, -1, args, argc);
}

// ZonedDateTime.from({ timeZone, year, month, day, hour?, ... }).
fn host_temporal_zdt_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_temporal_kind(v, TMP_ZONED_DATETIME) != 0 {
        let s = zjs_as_temporal(v);
        let t = zjs_temporal_new(TMP_ZONED_DATETIME);
        t.epoch_ns = s.epoch_ns; t.timezone = s.timezone;
        t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let p: TmpIso; let pp: TmpIso* = NULL; raw { pp = &p; }
        temporal_parse_iso(s.data, s.length, pp);
        if p.ok == 0 || p.has_date == 0 || p.has_tz == 0 {
            return temporal_range_error(ctx, (char*)"ZonedDateTime.from needs a date-time with [TimeZone] annotation", 63);
        }
        if !temporal_date_valid(p.year, p.month, p.day) {
            return temporal_range_error(ctx, (char*)"invalid ISO date", 16);
        }
        if !temporal_time_valid(p.hour, p.minute, p.second, p.ms, p.us, p.ns) {
            return temporal_range_error(ctx, (char*)"invalid time", 12);
        }
        let tzptr: char* = NULL; raw { tzptr = s->data + p.tz_off; }
        let tzname = zjs_as_string(ctx_intern_string(ctx, tzptr, p.tz_len));
        let subns = p.ms * 1000000 + p.us * 1000 + p.ns;
        let ep = zdt_epoch_ns_from_wall(tzname, p.year, p.month, p.day,
                                        p.hour, p.minute, p.second, subns);
        return zdt_make(ctx, ep, tzname);
    }
    if zjs_is_object(v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"ZonedDateTime.from expects an object", 36);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let tzv = property_get(ctx, v, ctx_intern_string(ctx, (char*)"timeZone", 8));
    if zjs_is_string(tzv) == 0 { return temporal_range_error(ctx, (char*)"ZonedDateTime.from needs a timeZone", 35); }
    let yv = property_get(ctx, v, ctx_intern_string(ctx, (char*)"year", 4));
    let mv = property_get(ctx, v, ctx_intern_string(ctx, (char*)"month", 5));
    let dv = property_get(ctx, v, ctx_intern_string(ctx, (char*)"day", 3));
    if zjs_is_undefined(yv) != 0 || zjs_is_undefined(mv) != 0 || zjs_is_undefined(dv) != 0 {
        return temporal_range_error(ctx, (char*)"ZonedDateTime.from needs year, month, day", 41);
    }
    let hv = property_get(ctx, v, ctx_intern_string(ctx, (char*)"hour", 4));
    let miv = property_get(ctx, v, ctx_intern_string(ctx, (char*)"minute", 6));
    let sv = property_get(ctx, v, ctx_intern_string(ctx, (char*)"second", 6));
    let y = (i64)zjs_to_double(yv); let mo = (i64)zjs_to_double(mv); let d = (i64)zjs_to_double(dv);
    let h  = if zjs_is_undefined(hv)  != 0 { 0 } else { (i64)zjs_to_double(hv) };
    let mi = if zjs_is_undefined(miv) != 0 { 0 } else { (i64)zjs_to_double(miv) };
    let sc = if zjs_is_undefined(sv)  != 0 { 0 } else { (i64)zjs_to_double(sv) };
    if !temporal_date_valid(y, mo, d) { return temporal_range_error(ctx, (char*)"invalid ISO date", 16); }
    let ep = zdt_epoch_ns_from_wall(zjs_as_string(tzv), y, mo, d, h, mi, sc, 0);
    return zdt_make(ctx, ep, zjs_as_string(tzv));
}

// Name-match helper for the Temporal computed-getter switch.
fn tmp_name_is(name: ZjsString*, lit: char*, len: u32) -> bool {
    if name.length != len { return false; }
    let m: int = 1;
    let nd = name.data;
    raw { m = memcmp(nd, lit, len); }
    return m == 0;
}

// Computed (accessor-style) own properties of a Temporal value. Returns
// the value, or zjs_deleted() as a sentinel meaning "not a computed
// property of this kind — fall through to the prototype methods".
fn temporal_get_computed(ctx: ZjsContext*, t: ZjsTemporal*, name: ZjsString*) -> ZjsValue {
    let k = t.kind;
    if k == TMP_DURATION {
        if tmp_name_is(name, (char*)"years", 5)        { return zjs_double((f64)t.d_years); }
        if tmp_name_is(name, (char*)"months", 6)       { return zjs_double((f64)t.d_months); }
        if tmp_name_is(name, (char*)"weeks", 5)        { return zjs_double((f64)t.d_weeks); }
        if tmp_name_is(name, (char*)"days", 4)         { return zjs_double((f64)t.d_days); }
        if tmp_name_is(name, (char*)"hours", 5)        { return zjs_double((f64)t.d_hours); }
        if tmp_name_is(name, (char*)"minutes", 7)      { return zjs_double((f64)t.d_minutes); }
        if tmp_name_is(name, (char*)"seconds", 7)      { return zjs_double((f64)t.d_seconds); }
        if tmp_name_is(name, (char*)"milliseconds", 12){ return zjs_double((f64)t.d_ms); }
        if tmp_name_is(name, (char*)"microseconds", 12){ return zjs_double((f64)t.d_us); }
        if tmp_name_is(name, (char*)"nanoseconds", 11) { return zjs_double((f64)t.d_ns); }
        if tmp_name_is(name, (char*)"sign", 4)         { return zjs_int32(temporal_duration_sign(t)); }
        if tmp_name_is(name, (char*)"blank", 5)        { return zjs_bool(if temporal_duration_sign(t) == 0 { 1 } else { 0 }); }
    }
    // Date getters apply to PlainDate + PlainDateTime.
    if k == TMP_PLAIN_DATE || k == TMP_PLAIN_DATETIME {
        if tmp_name_is(name, (char*)"year", 4)  { return zjs_int32(t.year); }
        if tmp_name_is(name, (char*)"month", 5) { return zjs_int32(t.month); }
        if tmp_name_is(name, (char*)"day", 3)   { return zjs_int32(t.day); }
        if tmp_name_is(name, (char*)"monthCode", 9) {
            let mc: char[4];
            raw { snprintf(mc, sizeof(mc), "M%02d", (int)t->month); }
            let mp: char* = NULL; raw { mp = &mc[0]; }
            return ctx_intern_string(ctx, mp, 3);
        }
        if tmp_name_is(name, (char*)"dayOfWeek", 9)   { return zjs_int32((i32)iso_day_of_week((i64)t.year, (i64)t.month, (i64)t.day)); }
        if tmp_name_is(name, (char*)"dayOfYear", 9)   { return zjs_int32((i32)iso_day_of_year((i64)t.year, (i64)t.month, (i64)t.day)); }
        if tmp_name_is(name, (char*)"daysInMonth", 11){ return zjs_int32((i32)iso_days_in_month((i64)t.year, (i64)t.month)); }
        if tmp_name_is(name, (char*)"daysInYear", 10) { return zjs_int32(if iso_is_leap((i64)t.year) { 366 } else { 365 }); }
        if tmp_name_is(name, (char*)"monthsInYear", 12) { return zjs_int32(12); }
        if tmp_name_is(name, (char*)"inLeapYear", 10) { return zjs_bool(if iso_is_leap((i64)t.year) { 1 } else { 0 }); }
        if tmp_name_is(name, (char*)"calendarId", 10) { return ctx_intern_string(ctx, (char*)"iso8601", 7); }
    }
    // Time getters apply to PlainTime + PlainDateTime.
    if k == TMP_PLAIN_TIME || k == TMP_PLAIN_DATETIME {
        if tmp_name_is(name, (char*)"hour", 4)        { return zjs_int32(t.hour); }
        if tmp_name_is(name, (char*)"minute", 6)      { return zjs_int32(t.minute); }
        if tmp_name_is(name, (char*)"second", 6)      { return zjs_int32(t.second); }
        if tmp_name_is(name, (char*)"millisecond", 11){ return zjs_int32(t.millisecond); }
        if tmp_name_is(name, (char*)"microsecond", 11){ return zjs_int32(t.microsecond); }
        if tmp_name_is(name, (char*)"nanosecond", 10) { return zjs_int32(t.nanosecond); }
    }
    if k == TMP_PLAIN_YEARMONTH {
        if tmp_name_is(name, (char*)"year", 4)  { return zjs_int32(t.year); }
        if tmp_name_is(name, (char*)"month", 5) { return zjs_int32(t.month); }
        if tmp_name_is(name, (char*)"monthCode", 9) {
            let mc: char[4];
            raw { snprintf(mc, sizeof(mc), "M%02d", (int)t->month); }
            let mp: char* = NULL; raw { mp = &mc[0]; }
            return ctx_intern_string(ctx, mp, 3);
        }
        if tmp_name_is(name, (char*)"daysInMonth", 11) { return zjs_int32((i32)iso_days_in_month((i64)t.year, (i64)t.month)); }
        if tmp_name_is(name, (char*)"daysInYear", 10)  { return zjs_int32(if iso_is_leap((i64)t.year) { 366 } else { 365 }); }
        if tmp_name_is(name, (char*)"monthsInYear", 12){ return zjs_int32(12); }
        if tmp_name_is(name, (char*)"inLeapYear", 10)  { return zjs_bool(if iso_is_leap((i64)t.year) { 1 } else { 0 }); }
        if tmp_name_is(name, (char*)"calendarId", 10)  { return ctx_intern_string(ctx, (char*)"iso8601", 7); }
    }
    if k == TMP_PLAIN_MONTHDAY {
        if tmp_name_is(name, (char*)"day", 3) { return zjs_int32(t.day); }
        if tmp_name_is(name, (char*)"monthCode", 9) {
            let mc: char[4];
            raw { snprintf(mc, sizeof(mc), "M%02d", (int)t->month); }
            let mp: char* = NULL; raw { mp = &mc[0]; }
            return ctx_intern_string(ctx, mp, 3);
        }
        if tmp_name_is(name, (char*)"calendarId", 10) { return ctx_intern_string(ctx, (char*)"iso8601", 7); }
    }
    if k == TMP_INSTANT {
        if tmp_name_is(name, (char*)"epochNanoseconds", 16) { return t.epoch_ns; }
        if tmp_name_is(name, (char*)"epochMilliseconds", 17) {
            let ms: f64 = 0.0;
            if zjs_is_bigint(t.epoch_ns) != 0 {
                ms = bigint_to_f64(zjs_as_bigint(t.epoch_ns)) / 1000000.0;
                raw { ms = floor(ms); }
            }
            return zjs_double(ms);
        }
    }
    if k == TMP_ZONED_DATETIME {
        if tmp_name_is(name, (char*)"epochNanoseconds", 16) { return t.epoch_ns; }
        if tmp_name_is(name, (char*)"epochMilliseconds", 17) {
            let ms: f64 = 0.0;
            if zjs_is_bigint(t.epoch_ns) != 0 { ms = bigint_to_f64(zjs_as_bigint(t.epoch_ns)) / 1000000.0; raw { ms = floor(ms); } }
            return zjs_double(ms);
        }
        if tmp_name_is(name, (char*)"timeZoneId", 10) {
            if t.timezone != NULL { return zjs_cell_from_ptr((void*)t.timezone); }
            return ctx_intern_string(ctx, (char*)"UTC", 3);
        }
        if tmp_name_is(name, (char*)"calendarId", 10) { return ctx_intern_string(ctx, (char*)"iso8601", 7); }
        // Remaining getters derive from the local wall clock.
        let f: i64[7];
        let fp: i64* = NULL; raw { fp = &f[0]; }
        let off: i64 = 0;
        zdt_decompose(t, fp, &off);
        if tmp_name_is(name, (char*)"year", 4)   { return zjs_int32((i32)f[0]); }
        if tmp_name_is(name, (char*)"month", 5)  { return zjs_int32((i32)f[1]); }
        if tmp_name_is(name, (char*)"day", 3)    { return zjs_int32((i32)f[2]); }
        if tmp_name_is(name, (char*)"hour", 4)   { return zjs_int32((i32)f[3]); }
        if tmp_name_is(name, (char*)"minute", 6) { return zjs_int32((i32)f[4]); }
        if tmp_name_is(name, (char*)"second", 6) { return zjs_int32((i32)f[5]); }
        if tmp_name_is(name, (char*)"millisecond", 11){ return zjs_int32((i32)(f[6] / 1000000)); }
        if tmp_name_is(name, (char*)"microsecond", 11){ return zjs_int32((i32)((f[6] / 1000) % 1000)); }
        if tmp_name_is(name, (char*)"nanosecond", 10) { return zjs_int32((i32)(f[6] % 1000)); }
        if tmp_name_is(name, (char*)"offsetNanoseconds", 17) { return zjs_double((f64)(off * 1000000000)); }
        if tmp_name_is(name, (char*)"offset", 6) {
            let ob: char[8]; let obp: char* = NULL; raw { obp = &ob[0]; }
            temporal_format_offset(off, obp, 8);
            let on: u32 = 0; raw { on = (uint32_t)strlen(obp); }
            return ctx_intern_string(ctx, obp, on);
        }
        if tmp_name_is(name, (char*)"dayOfWeek", 9)   { return zjs_int32((i32)iso_day_of_week(f[0], f[1], f[2])); }
        if tmp_name_is(name, (char*)"dayOfYear", 9)   { return zjs_int32((i32)iso_day_of_year(f[0], f[1], f[2])); }
        if tmp_name_is(name, (char*)"daysInMonth", 11){ return zjs_int32((i32)iso_days_in_month(f[0], f[1])); }
        if tmp_name_is(name, (char*)"daysInYear", 10) { return zjs_int32(if iso_is_leap(f[0]) { 366 } else { 365 }); }
        if tmp_name_is(name, (char*)"inLeapYear", 10) { return zjs_bool(if iso_is_leap(f[0]) { 1 } else { 0 }); }
        if tmp_name_is(name, (char*)"monthCode", 9) {
            let mc: char[4]; raw { snprintf(mc, sizeof(mc), "M%02d", (int)f[1]); }
            let mp: char* = NULL; raw { mp = &mc[0]; }
            return ctx_intern_string(ctx, mp, 3);
        }
    }
    return zjs_deleted();
}

// Build the Temporal namespace + Duration / Instant / Now. Called from
// ctx_init_builtins under #ifndef ZJS_NO_TEMPORAL.
fn ctx_init_temporal(ctx: ZjsContext*) -> void {
    let temporal_v = ctx_new_object(ctx);
    let temporal_o = zjs_as_object(temporal_v);
    object_set(ctx, temporal_o, ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN),
               ctx_intern_string(ctx, (char*)"Temporal", 8));

    // --- Temporal.Duration ---
    let dur_ctor_ptr: void* = NULL; raw { dur_ctor_ptr = (void*)host_temporal_duration_ctor; }
    let dur_ctor = ctx_make_host_function(ctx, (char*)"Duration", dur_ctor_ptr);
    let dur_proto_v = ctx_new_object(ctx);
    ctx.temporal_duration_proto = zjs_as_object(dur_proto_v);
    zjs_as_host_function(dur_ctor).prototype = ctx.temporal_duration_proto;
    let dts_ptr: void* = NULL; raw { dts_ptr = (void*)host_temporal_duration_to_string; }
    let dneg_ptr: void* = NULL; raw { dneg_ptr = (void*)host_temporal_duration_negated; }
    let dabs_ptr: void* = NULL; raw { dabs_ptr = (void*)host_temporal_duration_abs; }
    let dts_fn = ctx_make_host_function(ctx, (char*)"toString", dts_ptr);
    object_set(ctx, ctx.temporal_duration_proto, ctx_intern_atom(ctx, (char*)"toString", 8), dts_fn);
    object_set(ctx, ctx.temporal_duration_proto, ctx_intern_atom(ctx, (char*)"toJSON", 6), dts_fn);
    object_set(ctx, ctx.temporal_duration_proto, ctx_intern_atom(ctx, (char*)"negated", 7),
               ctx_make_host_function(ctx, (char*)"negated", dneg_ptr));
    object_set(ctx, ctx.temporal_duration_proto, ctx_intern_atom(ctx, (char*)"abs", 3),
               ctx_make_host_function(ctx, (char*)"abs", dabs_ptr));
    object_set(ctx, ctx.temporal_duration_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), dur_ctor);
    let dfrom_ptr: void* = NULL; raw { dfrom_ptr = (void*)host_temporal_duration_from; }
    property_set(ctx, dur_ctor, ctx_intern_string(ctx, (char*)"from", 4),
                 ctx_make_host_function(ctx, (char*)"from", dfrom_ptr));
    object_set(ctx, temporal_o, ctx_intern_atom(ctx, (char*)"Duration", 8), dur_ctor);

    // --- Temporal.Instant ---
    let inst_ctor_ptr: void* = NULL; raw { inst_ctor_ptr = (void*)host_temporal_instant_ctor; }
    let inst_ctor = ctx_make_host_function(ctx, (char*)"Instant", inst_ctor_ptr);
    let inst_proto_v = ctx_new_object(ctx);
    ctx.temporal_instant_proto = zjs_as_object(inst_proto_v);
    zjs_as_host_function(inst_ctor).prototype = ctx.temporal_instant_proto;
    let its_ptr: void* = NULL; raw { its_ptr = (void*)host_temporal_instant_to_string; }
    let its_fn = ctx_make_host_function(ctx, (char*)"toString", its_ptr);
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"toString", 8), its_fn);
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"toJSON", 6), its_fn);
    let iadd_ptr: void* = NULL; raw { iadd_ptr = (void*)host_temporal_instant_add; }
    let isub_ptr: void* = NULL; raw { isub_ptr = (void*)host_temporal_instant_subtract; }
    let iunt_ptr: void* = NULL; raw { iunt_ptr = (void*)host_temporal_instant_until; }
    let isin_ptr: void* = NULL; raw { isin_ptr = (void*)host_temporal_instant_since; }
    let ieq_ptr:  void* = NULL; raw { ieq_ptr  = (void*)host_temporal_instant_equals; }
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"add", 3),
               ctx_make_host_function(ctx, (char*)"add", iadd_ptr));
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"subtract", 8),
               ctx_make_host_function(ctx, (char*)"subtract", isub_ptr));
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"until", 5),
               ctx_make_host_function(ctx, (char*)"until", iunt_ptr));
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"since", 5),
               ctx_make_host_function(ctx, (char*)"since", isin_ptr));
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"equals", 6),
               ctx_make_host_function(ctx, (char*)"equals", ieq_ptr));
    let irnd_ptr: void* = NULL; raw { irnd_ptr = (void*)host_temporal_instant_round; }
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"round", 5),
               ctx_make_host_function(ctx, (char*)"round", irnd_ptr));
    object_set(ctx, ctx.temporal_instant_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), inst_ctor);
    let ifem_ptr: void* = NULL; raw { ifem_ptr = (void*)host_temporal_instant_from_epoch_ms; }
    let ifen_ptr: void* = NULL; raw { ifen_ptr = (void*)host_temporal_instant_from_epoch_ns; }
    let icmp_ptr: void* = NULL; raw { icmp_ptr = (void*)host_temporal_instant_compare; }
    property_set(ctx, inst_ctor, ctx_intern_string(ctx, (char*)"fromEpochMilliseconds", 21),
