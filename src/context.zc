    let s = zjs_as_temporal(this_v);
    let t = zjs_temporal_new(TMP_PLAIN_DATE);
    t.year = s.year; t.month = s.month; t.day = s.day;
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

fn host_temporal_plaindatetime_to_plain_time(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATETIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainDateTime", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let t = zjs_temporal_new(TMP_PLAIN_TIME);
    t.hour = s.hour; t.minute = s.minute; t.second = s.second;
    t.millisecond = s.millisecond; t.microsecond = s.microsecond; t.nanosecond = s.nanosecond;
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// largestUnit code: 0=day (default), 1=week, 2=month, 3=year.
fn temporal_parse_date_largest(ctx: ZjsContext*, optarg: ZjsValue, dflt: int) -> int {
    if zjs_is_object(optarg) == 0 { return dflt; }
    let lu = property_get(ctx, optarg, ctx_intern_string(ctx, (char*)"largestUnit", 11));
    if zjs_is_string(lu) == 0 { return dflt; }
    let s = zjs_as_string(lu);
    if tmp_name_is(s, (char*)"day", 3)   { return 0; }
    if tmp_name_is(s, (char*)"days", 4)  { return 0; }
    if tmp_name_is(s, (char*)"week", 4)  { return 1; }
    if tmp_name_is(s, (char*)"weeks", 5) { return 1; }
    if tmp_name_is(s, (char*)"month", 5) { return 2; }
    if tmp_name_is(s, (char*)"months", 6){ return 2; }
    if tmp_name_is(s, (char*)"year", 4)  { return 3; }
    if tmp_name_is(s, (char*)"years", 5) { return 3; }
    if tmp_name_is(s, (char*)"auto", 4)  { return dflt; }
    return dflt;
}

// ISO calendar date difference → Duration (DifferenceISODate). largest:
// 0=day 1=week 2=month 3=year. Result carries the correct sign.
fn temporal_diff_iso_date(ctx: ZjsContext*, y1: i64, m1: i64, d1: i64,
                          y2: i64, m2: i64, d2: i64, largest: int) -> ZjsValue {
    let e1 = iso_days_from_civil(y1, m1, d1);
    let e2 = iso_days_from_civil(y2, m2, d2);
    let t = zjs_temporal_new(TMP_DURATION);
    if e1 == e2 { ctx_register_cell(ctx, (void*)t); return zjs_cell_from_ptr((void*)t); }
    if largest <= 1 {
        let total = e2 - e1;          // signed days
        if largest == 1 {
            t.d_weeks = total / 7;
            t.d_days  = total % 7;
        } else {
            t.d_days = total;
        }
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    // month / year: walk from the earlier date toward the later.
    let sign: i64 = if e2 > e1 { 1 } else { -1 };
    let ay = if sign > 0 { y1 } else { y2 };
    let am = if sign > 0 { m1 } else { m2 };
    let ad = if sign > 0 { d1 } else { d2 };
    let by = if sign > 0 { y2 } else { y1 };
    let bm = if sign > 0 { m2 } else { m1 };
    let bd = if sign > 0 { d2 } else { d1 };
    let M = (by - ay) * 12 + (bm - am);
    let cand: i64[3];
    let cp: i64* = NULL; raw { cp = &cand[0]; }
    temporal_add_to_date(ay, am, ad, 0, M, 0, 0, cp);
    let eb = iso_days_from_civil(by, bm, bd);
    if iso_days_from_civil(cand[0], cand[1], cand[2]) > eb {
        M = M - 1;
        temporal_add_to_date(ay, am, ad, 0, M, 0, 0, cp);
    }
    let days = eb - iso_days_from_civil(cand[0], cand[1], cand[2]);
    if largest == 3 {
        t.d_years  = (M / 12) * sign;
        t.d_months = (M % 12) * sign;
    } else {
        t.d_months = M * sign;
    }
    t.d_days = days * sign;
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// PlainDate.until(other[,opts]) / since. dir +1 until, -1 since.
fn temporal_plaindate_diff_impl(ctx: ZjsContext*, dir: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    let other = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATE) == 0 || zjs_is_temporal_kind(other, TMP_PLAIN_DATE) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"expects two PlainDates", 22);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let largest = temporal_parse_date_largest(ctx, if argc >= 2 { args[1] } else { zjs_undefined() }, 0);
    let a = zjs_as_temporal(this_v); let b = zjs_as_temporal(other);
    // until: this → other; since: other → this (negate by swapping).
    let r: ZjsValue;
    if dir > 0 {
        r = temporal_diff_iso_date(ctx, (i64)a.year, (i64)a.month, (i64)a.day,
                                        (i64)b.year, (i64)b.month, (i64)b.day, largest);
    } else {
        r = temporal_diff_iso_date(ctx, (i64)b.year, (i64)b.month, (i64)b.day,
                                        (i64)a.year, (i64)a.month, (i64)a.day, largest);
    }
    return r;
}
fn host_temporal_plaindate_until(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaindate_diff_impl(ctx, 1, args, argc);
}
fn host_temporal_plaindate_since(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaindate_diff_impl(ctx, -1, args, argc);
}

// largestUnit parser including time units. Codes: 3=year, 2=month,
// 1=week, 0=day, -1=hour, -2=minute, -3=second, -4=ms, -5=us, -6=ns.
// 'auto' / missing → dflt.
fn temporal_parse_largest_unit(ctx: ZjsContext*, optarg: ZjsValue, dflt: int) -> int {
    if zjs_is_object(optarg) == 0 { return dflt; }
    let lu = property_get(ctx, optarg, ctx_intern_string(ctx, (char*)"largestUnit", 11));
    if zjs_is_string(lu) == 0 { return dflt; }
    let s = zjs_as_string(lu);
    if tmp_name_is(s, (char*)"year", 4)   { return 3; }
    if tmp_name_is(s, (char*)"years", 5)  { return 3; }
    if tmp_name_is(s, (char*)"month", 5)  { return 2; }
    if tmp_name_is(s, (char*)"months", 6) { return 2; }
    if tmp_name_is(s, (char*)"week", 4)   { return 1; }
    if tmp_name_is(s, (char*)"weeks", 5)  { return 1; }
    if tmp_name_is(s, (char*)"day", 3)    { return 0; }
    if tmp_name_is(s, (char*)"days", 4)   { return 0; }
    if tmp_name_is(s, (char*)"hour", 4)        { return -1; }
    if tmp_name_is(s, (char*)"hours", 5)       { return -1; }
    if tmp_name_is(s, (char*)"minute", 6)      { return -2; }
    if tmp_name_is(s, (char*)"minutes", 7)     { return -2; }
    if tmp_name_is(s, (char*)"second", 6)      { return -3; }
    if tmp_name_is(s, (char*)"seconds", 7)     { return -3; }
    if tmp_name_is(s, (char*)"millisecond", 11){ return -4; }
    if tmp_name_is(s, (char*)"milliseconds", 12){ return -4; }
    if tmp_name_is(s, (char*)"microsecond", 11){ return -5; }
    if tmp_name_is(s, (char*)"microseconds", 12){ return -5; }
    if tmp_name_is(s, (char*)"nanosecond", 10) { return -6; }
    if tmp_name_is(s, (char*)"nanoseconds", 11){ return -6; }
    if tmp_name_is(s, (char*)"auto", 4)   { return dflt; }
    return dflt;
}

// Balance a signed nanosecond total into the time fields (hours..ns) of
// duration `t`, with `top` the largest time-unit code (-1 hour .. -6 ns).
// Units above `top` are skipped (so the top unit can exceed its usual
// modulus, e.g. minutes-only → minutes may be ≥ 60). All components take
// the sign of `total` (C integer division truncates toward zero).
fn temporal_balance_time(t: ZjsTemporal*, total: i64, top: int) -> void {
    let rem = total;
    if top >= -1 { t.d_hours = rem / 3600000000000; rem = rem - t.d_hours * 3600000000000; }
    if top >= -2 { t.d_minutes = rem / 60000000000; rem = rem - t.d_minutes * 60000000000; }
    if top >= -3 { t.d_seconds = rem / 1000000000;  rem = rem - t.d_seconds * 1000000000; }
    if top >= -4 { t.d_ms = rem / 1000000;          rem = rem - t.d_ms * 1000000; }
    if top >= -5 { t.d_us = rem / 1000;             rem = rem - t.d_us * 1000; }
    t.d_ns = rem;
}

// Difference between two ISO date-times (start → end), returning a
// Duration. For a time-unit largestUnit the whole span is balanced into
// time units; otherwise the date portion uses calendar arithmetic and
// the sub-day remainder is balanced into hours..ns (with a one-day
// borrow when the time-of-day runs backwards relative to the dates).
fn temporal_diff_iso_datetime(ctx: ZjsContext*,
        y1: i64, mo1: i64, d1: i64, tod1: i64,
        y2: i64, mo2: i64, d2: i64, tod2: i64, largest: int) -> ZjsValue {
    let days1 = iso_days_from_civil(y1, mo1, d1);
    let days2 = iso_days_from_civil(y2, mo2, d2);
    if largest < 0 {
        let total = (days2 - days1) * 86400000000000 + (tod2 - tod1);
        let t = zjs_temporal_new(TMP_DURATION);
        temporal_balance_time(t, total, largest);
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    let time_delta = tod2 - tod1;
    let ey = y2; let emo = mo2; let ed = d2;
    let date_sign: i64 = if days2 > days1 { 1 } else { if days2 < days1 { -1 } else { 0 } };
    if date_sign > 0 && time_delta < 0 {
        let od: i64[3]; let odp: i64* = NULL; raw { odp = &od[0]; }
        iso_civil_from_days(days2 - 1, odp);
        ey = od[0]; emo = od[1]; ed = od[2];
        time_delta = time_delta + 86400000000000;
    } else if date_sign < 0 && time_delta > 0 {
        let od: i64[3]; let odp: i64* = NULL; raw { odp = &od[0]; }
        iso_civil_from_days(days2 + 1, odp);
        ey = od[0]; emo = od[1]; ed = od[2];
        time_delta = time_delta - 86400000000000;
    }
    let r = temporal_diff_iso_date(ctx, y1, mo1, d1, ey, emo, ed, largest);
    temporal_balance_time(zjs_as_temporal(r), time_delta, -1);
    return r;
}

// PlainDateTime.until/since(other[,opts]) → Duration. dir +1 until, -1 since.
fn temporal_pdt_diff_impl(ctx: ZjsContext*, dir: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATETIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainDateTime", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let other = if argc >= 1 { args[0] } else { zjs_undefined() };
    // Coerce a string / property-bag argument via PlainDateTime.from.
    if zjs_is_temporal_kind(other, TMP_PLAIN_DATETIME) == 0 {
        let oa: ZjsValue[1]; oa[0] = other; let oap: ZjsValue* = NULL; raw { oap = &oa[0]; }
        other = host_temporal_plaindatetime_from(ctx, oap, 1);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    let largest = temporal_parse_largest_unit(ctx, if argc >= 2 { args[1] } else { zjs_undefined() }, 0);
    let a = zjs_as_temporal(this_v); let b = zjs_as_temporal(other);
    // until: a → b; since: b → a.
    let sy: i64; let smo: i64; let sd: i64; let stod: i64;
    let ey: i64; let emo: i64; let ed: i64; let etod: i64;
    if dir > 0 {
        sy = (i64)a.year; smo = (i64)a.month; sd = (i64)a.day; stod = temporal_time_total_ns(a);
        ey = (i64)b.year; emo = (i64)b.month; ed = (i64)b.day; etod = temporal_time_total_ns(b);
    } else {
        sy = (i64)b.year; smo = (i64)b.month; sd = (i64)b.day; stod = temporal_time_total_ns(b);
        ey = (i64)a.year; emo = (i64)a.month; ed = (i64)a.day; etod = temporal_time_total_ns(a);
    }
    return temporal_diff_iso_datetime(ctx, sy, smo, sd, stod, ey, emo, ed, etod, largest);
}
fn host_temporal_plaindatetime_until(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_pdt_diff_impl(ctx, 1, args, argc);
}
fn host_temporal_plaindatetime_since(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_pdt_diff_impl(ctx, -1, args, argc);
}

// PlainDate.prototype.add/subtract(durationLike). sign=+1 add, -1 sub.
fn temporal_plaindate_add_impl(ctx: ZjsContext*, sign: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATE) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainDate", 24);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let f: i64[10];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    let ok: int = 1;
    temporal_read_duration(ctx, if argc >= 1 { args[0] } else { zjs_undefined() }, fp, &ok);
    if ok == 0 { let e = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"invalid duration", 16);
        ctx.pending_throw_active = true; ctx.pending_throw_value = e; return zjs_undefined(); }
    if sign < 0 { temporal_negate_dur(fp); }
    // Balance the time part to whole days (truncate toward zero).
    let extra_days = temporal_duration_time_ns(fp) / 86400000000000;
    let out: i64[3];
    let op: i64* = NULL; raw { op = &out[0]; }
    temporal_add_to_date((i64)s.year, (i64)s.month, (i64)s.day, f[0], f[1], f[2], f[3] + extra_days, op);
    if !temporal_date_valid(out[0], out[1], out[2]) { return temporal_range_error(ctx, (char*)"result out of range", 19); }
    let t = zjs_temporal_new(TMP_PLAIN_DATE);
    t.year = (i32)out[0]; t.month = (i32)out[1]; t.day = (i32)out[2];
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}
fn host_temporal_plaindate_add(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaindate_add_impl(ctx, 1, args, argc);
}
fn host_temporal_plaindate_subtract(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaindate_add_impl(ctx, -1, args, argc);
}

// PlainTime.prototype.add/subtract — wraps within a 24h day; the
// duration's date components are ignored (per spec).
fn temporal_plaintime_add_impl(ctx: ZjsContext*, sign: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_TIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainTime", 24);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let f: i64[10];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    let ok: int = 1;
    temporal_read_duration(ctx, if argc >= 1 { args[0] } else { zjs_undefined() }, fp, &ok);
    if ok == 0 { let e = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"invalid duration", 16);
        ctx.pending_throw_active = true; ctx.pending_throw_value = e; return zjs_undefined(); }
    let delta = sign * temporal_duration_time_ns(fp);
    let total = i64_floormod(temporal_time_total_ns(s) + delta, 86400000000000);
    let t = zjs_temporal_new(TMP_PLAIN_TIME);
    temporal_set_time_from_ns(t, total);
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}
fn host_temporal_plaintime_add(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaintime_add_impl(ctx, 1, args, argc);
}
fn host_temporal_plaintime_subtract(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaintime_add_impl(ctx, -1, args, argc);
}

// PlainDateTime.prototype.add/subtract — date part (constrain) plus
// time part with carry into days.
fn temporal_plaindatetime_add_impl(ctx: ZjsContext*, sign: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATETIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainDateTime", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let f: i64[10];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    let ok: int = 1;
    temporal_read_duration(ctx, if argc >= 1 { args[0] } else { zjs_undefined() }, fp, &ok);
    if ok == 0 { let e = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"invalid duration", 16);
        ctx.pending_throw_active = true; ctx.pending_throw_value = e; return zjs_undefined(); }
    if sign < 0 { temporal_negate_dur(fp); }
    // time total + carry into days
    let time_total = temporal_time_total_ns(s) + temporal_duration_time_ns(fp);
    let day_carry = i64_floordiv(time_total, 86400000000000);
    let time_rem = i64_floormod(time_total, 86400000000000);
    let out: i64[3];
    let op: i64* = NULL; raw { op = &out[0]; }
    temporal_add_to_date((i64)s.year, (i64)s.month, (i64)s.day, f[0], f[1], f[2], f[3] + day_carry, op);
    if !temporal_date_valid(out[0], out[1], out[2]) { return temporal_range_error(ctx, (char*)"result out of range", 19); }
    let t = zjs_temporal_new(TMP_PLAIN_DATETIME);
    t.year = (i32)out[0]; t.month = (i32)out[1]; t.day = (i32)out[2];
    temporal_set_time_from_ns(t, time_rem);
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}
fn host_temporal_plaindatetime_add(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaindatetime_add_impl(ctx, 1, args, argc);
}
fn host_temporal_plaindatetime_subtract(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_plaindatetime_add_impl(ctx, -1, args, argc);
}

// --- Temporal.PlainYearMonth ---
// Stored as year + month (+ reference day 1 in t.day).
fn host_temporal_yearmonth_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ok: int = 1;
    let y = temporal_int_arg(args, argc, 0, 0, &ok);
    let m = temporal_int_arg(args, argc, 1, 0, &ok);
    if ok == 0 { return temporal_range_error(ctx, (char*)"PlainYearMonth fields must be integers", 37); }
    if m < 1 || m > 12 || y < -271821 || y > 275760 { return temporal_range_error(ctx, (char*)"invalid year-month", 18); }
    let t = zjs_temporal_new(TMP_PLAIN_YEARMONTH);
    t.year = (i32)y; t.month = (i32)m; t.day = 1;
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

fn host_temporal_yearmonth_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let p: TmpIso; let pp: TmpIso* = NULL; raw { pp = &p; }
        temporal_parse_iso(s.data, s.length, pp);
        if p.ok == 0 || p.has_date == 0 {
            return temporal_range_error(ctx, (char*)"invalid ISO 8601 year-month string", 34);
        }
        if !temporal_date_valid(p.year, p.month, 1) {
            return temporal_range_error(ctx, (char*)"invalid ISO date", 16);
        }
        let t = zjs_temporal_new(TMP_PLAIN_YEARMONTH);
        t.year = (i32)p.year; t.month = (i32)p.month; t.day = 1;
        t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    if zjs_is_temporal_kind(v, TMP_PLAIN_YEARMONTH) != 0 {
        let s = zjs_as_temporal(v);
        let t = zjs_temporal_new(TMP_PLAIN_YEARMONTH);
        t.year = s.year; t.month = s.month; t.day = 1;
        t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    if zjs_is_object(v) != 0 {
        let argbuf: ZjsValue[2];
        argbuf[0] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"year", 4));
        argbuf[1] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"month", 5));
        if zjs_is_undefined(argbuf[0]) != 0 || zjs_is_undefined(argbuf[1]) != 0 {
            return temporal_range_error(ctx, (char*)"PlainYearMonth.from needs year and month", 40);
        }
        let ap: ZjsValue* = NULL; raw { ap = &argbuf[0]; }
        return host_temporal_yearmonth_ctor(ctx, ap, 2);
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"PlainYearMonth.from expects an object", 37);
