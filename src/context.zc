    ctx_register_host_function(ctx, (char*)"ArrayBuffer", eval_ptr);
    ctx_register_host_function(ctx, (char*)"Uint8Array",  eval_ptr);
    ctx_register_host_function(ctx, (char*)"Int8Array",   eval_ptr);
