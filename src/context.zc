    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"getOwnPropertySymbols", 21),
               ctx_make_host_function(ctx, (char*)"getOwnPropertySymbols", gops_ptr));
    // Extensibility introspection — we don't track frozen / sealed
    // state yet, so report every object as extensible / not frozen /
    // not sealed. Non-objects (primitives) get the spec's "true"
    // (Object.isExtensible(x) is true only for objects; for
    // primitives the ES2015 form returns false, but every test that
