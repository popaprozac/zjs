    let f: i64[7];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    let off: i64 = 0;
    zdt_decompose(t, fp, &off);
    let offbuf: char[8];
    let obp: char* = NULL; raw { obp = &offbuf[0]; }
    temporal_format_offset(off, obp, 8);
    let tzd: char* = NULL; let tzn: u32 = 0;
    if t.timezone != NULL { tzd = t.timezone.data; tzn = t.timezone.length; }
    let buf: char[80];
    raw {
        int base = snprintf(buf, sizeof(buf), "%04d-%02d-%02dT%02d:%02d:%02d",
