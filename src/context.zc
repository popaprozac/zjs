// Engine context — Phase 3.0a.
//
// One context = one isolated JS world. Holds the global variable table
// and (later) the heap + GC + symbol table. Globals are referenced by
// integer slot index in compiled bytecode; the compiler and the runtime
// share the same context so slot indices match up by construction.

import "stdlib.h" as libc;
import "std/time.zc";

// Cross-platform shims (realpath / gmtime_r / timegm / random / RSS).
// Single source of `#ifdef _WIN32` so the rest of the engine stays
// platform-agnostic.
raw {
    #include "../src/platform/portability.h"
}

// Platform-native HTTP backend — see src/platform/http_native.h
// and src/platform/http_apple.m. Declared as raw C extern so we
// don't depend on zen-c's header-import resolution.
raw {
    typedef struct {
        const char* method;
        const char* url;
        const char** req_headers;
        size_t req_header_count;
        const char* body;
        size_t body_len;
        int timeout_seconds;
    } ZjsHttpRequest;

    typedef struct {
        int status;
        char* body;
        size_t body_len;
        char** resp_headers;
        size_t resp_header_count;
    } ZjsHttpResponse;

    int zjs_http_request_sync(const ZjsHttpRequest* req,
                              ZjsHttpResponse* resp,
                              char** err_out);
    void zjs_http_response_free(ZjsHttpResponse* resp);

    // Async HTTP — see src/platform/http_native.h.
    typedef struct ZjsHttpHandle ZjsHttpHandle;
    ZjsHttpHandle* zjs_http_request_start(const ZjsHttpRequest* req);
    int  zjs_http_request_poll(ZjsHttpHandle* h, ZjsHttpResponse* out_resp, char** err_out);
    void zjs_http_request_destroy(ZjsHttpHandle* h);

    // WebSocket native shim — see src/platform/ws_native.h.
    typedef struct ZjsWsHandle ZjsWsHandle;
    typedef struct {
        int kind;
        char* text;
        size_t text_len;
        uint8_t* binary;
        size_t binary_len;
        int code;
    } ZjsWsEvent;
    ZjsWsHandle* zjs_ws_connect(const char* url,
                                const char** protocols,
                                size_t protocol_count,
                                int timeout_seconds);
    int  zjs_ws_send_text(ZjsWsHandle* h, const char* text, size_t len);
    int  zjs_ws_send_binary(ZjsWsHandle* h, const uint8_t* bytes, size_t len);
    int  zjs_ws_close(ZjsWsHandle* h, int code, const char* reason);
    int  zjs_ws_poll(ZjsWsHandle* h, ZjsWsEvent* out_event);
    void zjs_ws_destroy(ZjsWsHandle* h);
}
import "./value.zc";
import "std/mem.zc"
import "std/math.zc"
import "std/regex.zc"

raw {
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    #include <time.h>
    // Forward decl — defined in eval.zc; lets host_function_ctor /
    // similar runtime-compile paths reach it without a circular import.
    typedef struct ZjsValue ZjsValue;
    typedef struct ZjsContext ZjsContext;
    ZjsValue zjs_eval(ZjsContext* ctx, char* source);
}

struct GlobalEntry {
    name:     char*;    // owned (calloc'd, copied from source); freed on ctx free
    name_len: u32;
    value:    ZjsValue;
    // Phase 3.8c: true once a definition (var/let/const/function/class/
    // host registration) has populated `value`. LoadGlobal throws
    // ReferenceError if false; `typeof` uses a separate opcode that
    // returns "undefined" without throwing.
    defined:  bool;
}

struct GcRootFrame {
    regs:      ZjsValue*;
    reg_count: u32;
}

// Phase 3.9h scaffolding. Each CallFrame owns a slice of reg_stack
// laid out as [args | regs]: args[0..argc] then regs[0..reg_count].
// Storing args separately (rather than just copying into regs[0..]) so
// `arguments[k]` for k >= param_count still works when more args are
// passed than declared.
struct CallFrame {
    f:                      Function*;
    ip:                     usize;
    args_base:              u32;   // offset into ctx.reg_stack
    argc:                   u32;   // how many slots at args_base hold passed args
    regs_base:              u32;   // = args_base + argc
    reg_count:              u32;
    return_dst:             u8;
    saved_host_this:        ZjsValue;
    saved_current_closure:  ZjsClosure*;
    try_depth_at_entry:     u32;
    // True when this frame is a derived-class constructor that has
    // called super() (so `this` is bound). Pre-super reads of `this`
    // and a return-without-super both throw ReferenceError per spec.
    super_called:           bool;
    // Async function machinery (2026-05-15). Holds the outer Promise
    // that this async fn returns to its caller. Op::Return / implicit
    // return / throw-unwinding settles it; Op::Await on a pending
    // Promise suspends the frame and returns this Promise's cell
    // (already written to the caller's dst at call time).
    // Plain TAG_UNDEFINED for non-async frames.
    outer_promise:          ZjsValue;
    // Generator iterator the frame belongs to (NULL when not a
    // generator frame). Op::Yield saves the frame snapshot here;
    // Op::Return wraps the return value in { value, done: true }.
    generator:              ZjsGenerator*;
}

// Phase 3.9h. Shared across all CallFrames once the migration lands —
// each TryFrame carries the frame_index it lives in so unwinding can
// pop above it without per-frame try arrays.
struct CtxTryFrame {
    frame_index: u32;
    catch_ip:    usize;
    catch_reg:   u8;
}

struct ZjsTimer {
    id:        u32;       // monotonic, unique for the lifetime of the ctx
    due_ms:    f64;       // CLOCK_MONOTONIC ms when it next fires
    period_ms: f64;       // 0 for setTimeout, > 0 for setInterval
    cancelled: bool;
    handler:   ZjsValue;  // callable
    argc:      u32;       // count of args slice below
    args:      ZjsValue*; // owned heap array (NULL if argc == 0)
}

def CTX_MAX_TRY_DEPTH:  u32 = 256;
def CTX_INVOKE_ARG_CAP: u32 = 256;   // matches u8 argc range

// Open-addressed hash-table entry. NULL `str` = empty slot.
// We never delete atoms, so no tombstones needed.
struct AtomEntry {
    str:  ZjsString*;
    hash: u32;
}

struct ZjsContext {
    // Root empty hidden class — every fresh {} starts here.
    empty_class:    ZjsHiddenClass*;

    globals:        GlobalEntry*;
    global_count:   u32;
    global_cap:     u32;

    // All heap-allocated cells owned by the context (Functions,
    // Strings, Objects, Arrays, HostFunctions). Each cell starts with
    // a CellHeader whose type_tag drives the free dispatch. The mark
    // bit drives GC reachability.
    //
    // Generational scaffolding (2026-05-18, Session 2 of the GC
    // experiment — see docs/gc-experiment.md). New cells land in
    // `young_cells`; survivors of a minor collection are appended to
    // `cells` (the "old gen"). Without a write barrier yet the mark
    // phase still walks the full reachable graph, so a minor only
    // wins us "cheap sweep of newly-dead garbage" — not a pause-time
    // win on benches with a large persistent live set. Session 3
    // adds the barrier + remembered set to make minor truly fast.
    cells:          void**;
    cell_count:     u32;
    cell_cap:       u32;
    young_cells:    void**;
    young_count:    u32;
    young_cap:      u32;
    young_threshold: u32;
    cells_since_minor: u32;

    // Remembered set — old cells that hold a pointer to a young cell.
    // Populated by gc_write_barrier on every old.slot=young store and
    // at promotion time (walking the new-old cell's slots). Each entry
    // is the old-cell pointer; minor GC re-scans the cell's slots to
    // follow the young descendants. Duplicates are tolerated (the
    // mark check inside gc_mark_value early-returns on already-marked
    // cells), so we don't bother deduping the list — just append.
    rem_set:        void**;
    rem_count:      u32;
    rem_cap:        u32;

    // Set by zjs_eval when the program ends with an uncaught throw.
    // Public ABI: zjs_had_error / zjs_get_error.
    had_error:      bool;
    last_error:     ZjsValue;

    // Currently-executing closure (Phase 3.3). Push/pop'd by Invoke;
    // LoadEnv reads ctx.current_closure.env.
    current_closure: ZjsClosure*;

    // Implicit `this` for the currently-running host function (Phase 3.5).
    // Set by Op::MethodInvoke before dispatch and restored after. Host
    // builtins like Array.prototype.push read it via zjs_get_host_this().
    host_this: ZjsValue;
    // Op::NewInvoke sets this to true before calling the constructor;
    // plain Invoke / MethodInvoke leave it false. Host functions can
    // read it to distinguish `new F(...)` from `F(...)` / `F.call(...)`
    // and throw TypeError on the latter when spec requires it.
    new_target_active: bool;
    // ECMA-262 [[NewTarget]]: the actual constructor function the
    // current call entered through. Op::LoadNewTarget reads this when
    // new_target_active is set. Stored as a ZjsValue so callees (and
    // arrow-funcs inheriting from their enclosing ctor) can return it
    // unchanged. Reset to undefined when new_target_active is false.
    new_target_value:  ZjsValue;

    // Cached "prototype" objects for built-in cell types (Phase 3.5).
    // Lazily populated by ctx_init_builtins. property_get on TAG_ARRAY
    // falls back to array_proto for unrecognized method names; same for
    // TAG_STRING / string_proto. Phase 3.6 will replace this with a real
    // hidden-class-driven proto chain.
    array_proto:    ZjsObject*;
    string_proto:   ZjsObject*;
    // Phase 3.8c — the default proto for every {} created via
    // ctx_new_object. Carries hasOwnProperty + toString.
    object_proto:   ZjsObject*;

    // Phase 3.8d — cached Function.prototype.{call, apply} host
    // helpers. property_get on Function/Closure/HostFunction returns
    // these when key == "call" / "apply" so f.call(thisArg, ...) works.
    fn_call_v:      ZjsValue;
    fn_apply_v:     ZjsValue;
    // 2026-05-15 — real Function.prototype. Every callable's
    // [[Prototype]] resolves to this object; `Function.prototype`
    // returns it; property_get on a callable walks it before
    // object_proto. Created in ctx_init_builtins.
    function_proto: ZjsObject*;
    // Top-level `this` (and the `globalThis` global). Property
    // reads / writes go through the existing globals table; this
    // object serves as a JS-visible handle to the global scope.
    global_this_obj: ZjsObject*;

    // Phase 3.5b — temp-root stack. Host functions that invoke JS
    // callbacks (Array.prototype.map / forEach) need to keep
    // intermediate ZjsValues alive across the inner interpret() call,
    // which may trigger GC. Use ctx_push_temp_root / ctx_pop_temp_root.
    temp_roots:      ZjsValue*;
    temp_root_count: u32;
    temp_root_cap:   u32;

    // --- GC state ---
    root_frames:    GcRootFrame*;     // grown geometrically
    root_depth:     u32;              // # of active interpret() frames
    root_cap:       u32;
    cells_since_gc: u32;              // allocations since last collection
    gc_threshold:   u32;              // run GC when cells_since_gc >= this

    // GC instrumentation (2026-05-18). All counters are cumulative
    // for the lifetime of the context; reset on context creation.
    gc_collections:    u32;          // # of GC runs (minor + major)
    gc_pause_ns_total: u64;          // sum of all pauses (nanoseconds)
    gc_pause_ns_max:   u64;          // worst single pause
    gc_cells_freed:    u32;          // cells reclaimed across all runs
    gc_cells_kept:     u32;          // cells surviving the most recent run
    gc_minors:         u32;          // # of minor (young-only sweep) GCs
    gc_majors:         u32;          // # of major (full sweep) GCs
    gc_promoted:       u32;          // total cells promoted young → old

    // --- Phase 3.9h scaffolding (unused until interpret() converts) ---
    // Single contiguous register stack; CallFrames take slices.
    reg_stack:        ZjsValue*;
    reg_stack_top:    u32;
    reg_stack_cap:    u32;

    frames:           CallFrame*;
    frame_count:      u32;
    frame_cap:        u32;

    // Shared try stack (replaces per-frame TryFrame[32] once migration
    // lands). Sized once at first use up to CTX_MAX_TRY_DEPTH.
    ctx_try_stack:    CtxTryFrame*;
    ctx_try_depth:    u32;
    ctx_try_cap:      u32;

    // Scratch buffer for arg-copy on Op::Invoke. The interpreter copies
    // args from the caller's regs into this buffer BEFORE calling
    // push_call_frame (which may realloc reg_stack and invalidate
    // caller-reg pointers). Reused across Invokes — overwritten each
    // call. Lazily sized to CTX_INVOKE_ARG_CAP at first use.
    invoke_arg_buffer:     ZjsValue*;
    invoke_arg_buffer_cap: u32;

    // Phase 3.10 — Promises.
    // Currently-executing host function (set by Op::Invoke right
    // before calling the C fn_ptr). Host fns that need per-instance
    // state (Promise resolve/reject closures) read .bound from here.
    current_host_fn: void*;
    // Pending throw bridge — when a JS callback fired from a host
    // helper (zjs_to_primitive's valueOf/toString, Array.prototype.map's
    // user callback, etc.) raises an exception, the recursive
    // interpret() can't propagate it directly because the host frame
    // sits in between. zjs_call_value{,_with_this} set these fields
    // instead; the outer interpret() inspects pending_throw_active at
    // the end of each instruction and converts it back into a local
    // throw (`throwing = true; thrown = pending_throw_value`).
    pending_throw_active: bool;
    pending_throw_value:  ZjsValue;
    // Microtask queue. Each microtask is 4 consecutive slots:
    //   handler (callable or undefined), arg, result_promise, is_fulfilled_path.
    microtask_queue: ZjsValue*;
    microtask_count: u32;
    microtask_cap:   u32;
    // Bound ctor for Promise — used by the .then path to construct
    // the result promise. Cached at init.
    promise_ctor_proto: ZjsObject*;

    // RegExp.prototype — carries .test / .exec / .source / .flags.
    // property_get on TAG_REGEXP walks this chain.
    regexp_proto:       ZjsObject*;

    // Generator iterator prototype — carries .next / .return / .throw
    // and the well-known Symbol.iterator self-reference (under a
    // stand-in string key since real Symbols aren't implemented yet).
    // property_get on TAG_GENERATOR walks this chain.
    generator_proto:    ZjsObject*;

    // Map / Set prototypes (2026-05-16). property_get on TAG_MAP /
    // TAG_SET walks these chains.
    map_proto:          ZjsObject*;
    set_proto:          ZjsObject*;
    date_proto:         ZjsObject*;
    symbol_proto:       ZjsObject*;
    url_proto:          ZjsObject*;
    usp_proto:          ZjsObject*;
    uint8_array_proto:        ZjsObject*;
    int8_array_proto:         ZjsObject*;
    uint8_clamped_array_proto: ZjsObject*;
    int16_array_proto:        ZjsObject*;
    uint16_array_proto:       ZjsObject*;
    int32_array_proto:        ZjsObject*;
    uint32_array_proto:       ZjsObject*;
    float32_array_proto:      ZjsObject*;
    float64_array_proto:      ZjsObject*;
    array_buffer_proto:       ZjsObject*;
    data_view_proto:          ZjsObject*;
    websocket_proto:          ZjsObject*;
    headers_proto:            ZjsObject*;
    response_proto:           ZjsObject*;

    // Live WebSocket cells — polled on each event-loop tick. Owned
    // by ZjsContext (GC marks them so handlers stay reachable across
    // collections even when JS user code has dropped its only ref).
    websockets:      ZjsWebSocket**;
    websocket_count: u32;
    websocket_cap:   u32;

    // In-flight async fetch() requests. Parallel arrays — each
    // index pairs an opaque platform handle with its pending
    // Promise + the URL string used to build the Response.
    pending_fetches:        void**;
    pending_fetch_promises: ZjsValue*;
    pending_fetch_urls:     ZjsValue*;
    pending_fetch_count:    u32;
    pending_fetch_cap:      u32;

    // Timer queue (2026-05-18, web-API Phase B). Each entry represents
    // a setTimeout / setInterval reservation. `due_ms` is the
    // monotonic-clock ms when it next fires. `period_ms` is 0 for
    // setTimeout (one-shot, deleted after firing) and > 0 for
    // setInterval (re-armed on each fire). `cancelled` is set by
    // clearTimeout/clearInterval; compaction happens lazily on the
    // next sweep. Embedders observe pending work via the new ABI
    // (zjs_next_timer_ms / zjs_run_pending_timers / zjs_has_pending_work);
    // CLI bundles a poll-based loop so `zjs run file.js` drives this
    // automatically.
    timers:         ZjsTimer*;
    timer_count:    u32;
    timer_cap:      u32;
    next_timer_id:  u32;
    // Cached pristine Array/String @@iterator host fn. Used by iter_get
    // to short-circuit to the TAG_ARRAY_ITER fast path when the lookup
    // would yield this exact function (i.e. user code hasn't overridden
    // Array.prototype[Symbol.iterator] / inserted an own @@iterator).
    array_iter_host_fn: ZjsValue;
    // Monotonic counter for fresh symbol identity (used to derive each
    // Symbol's unique internal key string).
    symbol_counter:     u32;
    // Monotonic counter for class-body lexical identity (used to
    // mangle `#name` private members per ECMA-262: each class
    // declaration gets a unique id so `#x` in class A and `#x` in
    // class B compile to different hidden keys).
    class_id_counter:   u32;
    // True once at least one Proxy has been constructed. property_get /
    // property_set hot paths use this to skip the TAG_PROXY tag check
    // entirely when no proxies exist — the common case. host_proxy_ctor
    // flips it on first ctor call.
    any_proxy_alive:    bool;
    // Symbol.for / Symbol.keyFor registry. Two parallel lists:
    // symbol_for_keys[i] is the user-visible key string, symbol_for_syms[i]
    // is the interned Symbol value. Linear scan for now.
    symbol_for_keys:    ZjsString**;
    symbol_for_syms:    ZjsSymbol**;
    symbol_for_count:   u32;
    symbol_for_cap:     u32;

    // --- Atom table (interned strings) ---
    // Open-addressed hash table, power-of-2 capacity. Used for
    // property names + source-code string literals. Atoms are GC
    // roots so they live for the context's lifetime; that's fine for
    // names/literals that are inherently shared.
    atoms:          AtomEntry*;
    atom_count:     u32;
    atom_cap:       u32;

    // ES modules (2026-05-15). Linear array of cached records keyed
    // by absolute path. Small N — most programs touch a handful of
    // modules — so linear scan is fine for now.
    module_cache:       ZjsModuleRecord**;
    module_cache_count: u32;
    module_cache_cap:   u32;
    // Module currently being evaluated. Imports resolve specifiers
    // relative to this module's abs_path; exports write into this
    // module's exports object. NULL when not in a module body.
    current_module:     ZjsModuleRecord*;
}

def MODULE_STATE_UNRESOLVED: u8 = 0;
def MODULE_STATE_LOADING:    u8 = 1;
def MODULE_STATE_EVALUATING: u8 = 2;
def MODULE_STATE_EVALUATED:  u8 = 3;
def MODULE_STATE_ERRORED:    u8 = 4;

struct ZjsModuleRecord {
    abs_path:  ZjsString*;       // canonical key for the cache
    function:  Function*;        // compiled module body (NULL until compiled)
    exports:   ZjsObject*;       // populated by Op-emitted export calls
    state:     u8;
    error:     ZjsValue;         // when state == ERRORED
}

fn zjs_new_context() -> ZjsContext* {
    let result = alloc<ZjsContext>();
    if result != NULL {
        // GC initial threshold: collect after the first 4096 cell allocations,
        // then adapt to 2× live count after each collection.
        result.gc_threshold = 4096;
        // Instrumentation counters — calloc gave us zeros, but be
        // explicit so the field meanings are visible at the call site.
        result.gc_collections    = 0;
        result.gc_pause_ns_total = 0;
        result.gc_pause_ns_max   = 0;
        result.gc_cells_freed    = 0;
        result.gc_cells_kept     = 0;
        result.gc_minors         = 0;
        result.gc_majors         = 0;
        result.gc_promoted       = 0;
        // Young-generation scaffolding. Fire a minor GC every ~1024
        // young allocations until tuning says otherwise; small enough
        // to keep pauses tight, large enough that the per-minor
        // overhead doesn't dominate.
        result.young_threshold   = 1024;
        result.cells_since_minor = 0;
        // calloc gave us {bits: 0}; explicitly initialize the implicit
        // host receiver to JS `undefined`.
        result.host_this = zjs_undefined();

        // Pre-size the high-churn tables that ctx_init_builtins fills
        // before any user script runs. Without this, the atom and
        // globals tables grow ~5× during builtin registration, each
        // grow rehashing every prior entry.
        //   atoms: ~210 strings registered (prototype method names,
        //          builtin globals, error type names). 512 → 1 grow.
        //   globals: ~60 names (Object/Array/Math/JSON/.../WebSocket).
        //          128 → 0 grows.
        //
        // young_cells deliberately NOT pre-sized — the 8KB allocation
        // costs more in cold-page-fault time than it saves in
        // realloc growth, since young_cells starts at 64 and only
        // doubles. The atom/globals tables, by contrast, rehash all
        // prior entries on every grow, so skipping that work is the
        // real win.
        result.atoms = alloc_n<AtomEntry>(512);
        result.atom_cap = 512;
        result.globals = alloc_n<GlobalEntry>(128);
        result.global_cap = 128;

        // Root empty class — registered as a cell, kept alive via the
        // context pointer itself (we mark it during gc_mark_roots).
        let empty = zjs_hidden_class_new(NULL, NULL, 0, 0);
        ctx_register_cell(result, (void*)empty);
        result.empty_class = empty;

        ctx_init_builtins(result);
    }
    return result;
}

fn zjs_free_context(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    dealloc(ctx.root_frames);
    dealloc(ctx.atoms);
    // Free every interned global name.
    let i: u32 = 0;
    while i < ctx.global_count {
        dealloc(ctx.globals[i].name);
        i = i + 1;
    }
    dealloc(ctx.globals);

    // Free every heap cell — both generations. The dispatch by tag
    // is shared with gc_sweep_old via gc_free_one so adding a new
    // cell type only requires updating one place.
    let j: u32 = 0;
    while j < ctx.cell_count {
        gc_free_one(ctx.cells[j]);
        j = j + 1;
    }
    let jy: u32 = 0;
    while jy < ctx.young_count {
        gc_free_one(ctx.young_cells[jy]);
        jy = jy + 1;
    }
    // Free per-timer args buffers (the timer array itself is freed
    // below with the rest of the ctx-owned buffers).
    let ti: u32 = 0;
    while ti < ctx.timer_count {
        if ctx.timers[ti].args != NULL { dealloc(ctx.timers[ti].args); }
        ti = ti + 1;
    }
    let cells = ctx.cells;
    let young_cells = ctx.young_cells;
    let rem_set = ctx.rem_set;
    let temp_roots = ctx.temp_roots;
    let reg_stack = ctx.reg_stack;
    let frames = ctx.frames;
    let ctx_try_stack = ctx.ctx_try_stack;
    let invoke_arg_buffer = ctx.invoke_arg_buffer;
    let microtask_queue = ctx.microtask_queue;
    let timers = ctx.timers;
    dealloc(cells);
    dealloc(young_cells);
    dealloc(rem_set);
    dealloc(temp_roots);
    dealloc(reg_stack);
    dealloc(frames);
    dealloc(ctx_try_stack);
    dealloc(invoke_arg_buffer);
    dealloc(microtask_queue);
    dealloc(timers);
    dealloc(ctx);
}

// Push a value as a transient GC root. Used by host functions that
// allocate then invoke a JS callback — the inner interpret() may run
// GC, and the C-stack ZjsValue isn't otherwise visible. Pair with
// ctx_pop_temp_root.
fn ctx_push_temp_root(ctx: ZjsContext*, v: ZjsValue) -> void {
    if ctx.temp_root_count >= ctx.temp_root_cap {
        let new_cap: u32 = if ctx.temp_root_cap == 0 { 8 } else { ctx.temp_root_cap * 2 };
        ctx.temp_roots = realloc_n<ZjsValue>(ctx.temp_roots, (usize)ctx.temp_root_cap, (usize)new_cap);
        ctx.temp_root_cap = new_cap;
    }
    ctx.temp_roots[ctx.temp_root_count] = v;
    ctx.temp_root_count = ctx.temp_root_count + 1;
}

fn ctx_pop_temp_root(ctx: ZjsContext*) -> void {
    if ctx.temp_root_count > 0 {
        ctx.temp_root_count = ctx.temp_root_count - 1;
    }
}

// Overwrite the top temp_root slot in place. Pairs cleanly with
// `push + defer pop` for code that loops, allocating a fresh value
// each iteration that supersedes the previous one (string concat,
// array join, etc.).
fn ctx_replace_top_temp_root(ctx: ZjsContext*, v: ZjsValue) -> void {
    if ctx.temp_root_count > 0 {
        ctx.temp_roots[ctx.temp_root_count - 1] = v;
    }
}

// Append a heap cell to the context's owned-cells list. Called whenever
// a new Function / String / etc. is allocated by the compiler or
// interpreter.
// Module-level "active context" pointer. The write barrier and other
// helpers that don't naturally receive `ctx` (e.g. array_set in
// value.zc) read this to find the rem_set. Single-threaded engine —
// no contention. NULL during bootstrap (before any interpret() runs)
// is a normal state and means "no barrier needed yet" — bootstrap
// cells are allocated young and either die or get promoted on the
// first real GC.
let g_active_ctx: ZjsContext* = NULL;

fn gc_set_active_ctx(ctx: ZjsContext*) -> ZjsContext* {
    let saved = g_active_ctx;
    g_active_ctx = ctx;
    return saved;
}

// Minor-mode flag: when 1, gc_mark_value stops recursing into OLD
// cells (their pointers to YOUNG cells are tracked separately via
// the remembered set). Toggled by gc_run_minor; gc_run_major sets it
// back to 0 so a major behaves as a full reachability walk.
let g_gc_minor_mode: u8 = 0;

// Append `p` to the old-generation cell list. Used for cells that
// should bypass the nursery — atoms (pinned for the context's
// lifetime), bootstrap-time allocations (the empty hidden class,
// well-known prototypes), and survivors promoted out of the young
// list by minor GC. NOT bumped against `young_threshold` because
// these allocations don't represent program-controlled pressure.
// Stamps the cell's age to OLD so the write barrier and mark walk
// can distinguish young from old in O(1).
fn ctx_register_cell_old(ctx: ZjsContext*, p: void*) -> void {
    if ctx.cell_count >= ctx.cell_cap {
        let new_cap: u32 = if ctx.cell_cap == 0 { 16 } else { ctx.cell_cap * 2 };
        ctx.cells = realloc_n<void*>(ctx.cells, (usize)ctx.cell_cap, (usize)new_cap);
        ctx.cell_cap = new_cap;
    }
    ctx.cells[ctx.cell_count] = p;
    ctx.cell_count = ctx.cell_count + 1;
    ctx.cells_since_gc = ctx.cells_since_gc + 1;
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)p; }
    h.age = 1;
}

// Append `holder` to the remembered set. Caller has already determined
// (holder is old) AND (a value pointing into the nursery was just
// stored into one of its slots). The list dedups lazily — duplicates
// are fine because mark walks early-return on already-marked cells.
fn rem_set_add(ctx: ZjsContext*, holder: void*) -> void {
    if ctx.rem_count >= ctx.rem_cap {
        let new_cap: u32 = if ctx.rem_cap == 0 { 32 } else { ctx.rem_cap * 2 };
        ctx.rem_set = realloc_n<void*>(ctx.rem_set, (usize)ctx.rem_cap, (usize)new_cap);
        ctx.rem_cap = new_cap;
    }
    ctx.rem_set[ctx.rem_count] = holder;
    ctx.rem_count = ctx.rem_count + 1;
}

// The write barrier itself. Call this on every store of a ZjsValue
// into a heap-resident slot — the helper extracts the cell pointer
// (if any) from `value` and records the old→young edge.
//
// Fast path: both arms are cheap. Most stores are either to a young
// holder (no barrier needed) or with a primitive / old value (no
// barrier needed). Real barriers only fire when promoted long-lived
// state captures freshly-allocated data — which is exactly the
// case we need to track for minor correctness.
fn gc_write_barrier(ctx: ZjsContext*, holder: void*, value: ZjsValue) -> void {
    if holder == NULL || ctx == NULL { return; }
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)holder; }
    if h.age == 0 { return; }   // holder is young — slot can be re-scanned at promotion time
    if zjs_is_cell(value) == 0 { return; }
    let v_ptr = zjs_cell_as_ptr(value);
    if v_ptr == NULL { return; }
    let vh: CellHeader* = NULL;
    raw { vh = (CellHeader*)v_ptr; }
    if vh.age != 0 { return; }  // value is also old → no inter-gen edge
    rem_set_add(ctx, holder);
}

// Param-less variant for code paths that don't have ctx threaded
// through (e.g. array_set in value.zc). Reads from g_active_ctx,
// which interpret() sets on entry and restores on exit. A NULL
// g_active_ctx means we're outside the interpreter — typically
// during bootstrap or test setup — and the barrier safely no-ops.
fn gc_barrier(holder: void*, value: ZjsValue) -> void {
    gc_write_barrier(g_active_ctx, holder, value);
}

// New cells from program execution land here. We bump
// `cells_since_minor` and let `ctx_maybe_gc` decide when to collect
// — that check fires from the interpreter loop, not from inside the
// allocator (the prerequisite for moving GC trigger into the
// allocator is rooting all in-flight cells, tracked in
// docs/future-work.md).
fn ctx_register_cell(ctx: ZjsContext*, p: void*) -> void {
    if ctx.young_count >= ctx.young_cap {
        let new_cap: u32 = if ctx.young_cap == 0 { 64 } else { ctx.young_cap * 2 };
        ctx.young_cells = realloc_n<void*>(ctx.young_cells, (usize)ctx.young_cap, (usize)new_cap);
        ctx.young_cap = new_cap;
    }
    ctx.young_cells[ctx.young_count] = p;
    ctx.young_count = ctx.young_count + 1;
    ctx.cells_since_gc    = ctx.cells_since_gc + 1;
    ctx.cells_since_minor = ctx.cells_since_minor + 1;
}

// =====================================================================
// GC — mark-sweep, run between interpreter instructions.
// =====================================================================

fn ctx_push_root_frame(ctx: ZjsContext*, regs: ZjsValue*, reg_count: u32) -> void {
    if ctx.root_depth >= ctx.root_cap {
        let new_cap: u32 = if ctx.root_cap == 0 { 16 } else { ctx.root_cap * 2 };
        ctx.root_frames = realloc_n<GcRootFrame>(ctx.root_frames, (usize)ctx.root_cap, (usize)new_cap);
        ctx.root_cap = new_cap;
    }
    ctx.root_frames[ctx.root_depth].regs = regs;
    ctx.root_frames[ctx.root_depth].reg_count = reg_count;
    ctx.root_depth = ctx.root_depth + 1;
}

fn ctx_pop_root_frame(ctx: ZjsContext*) -> void {
    if ctx.root_depth > 0 { ctx.root_depth = ctx.root_depth - 1; }
}

// =====================================================================
// Phase 3.9h — non-recursive interpreter scaffolding.
//
// These helpers manage the explicit CallFrame stack + shared register
// stack that the next phase will use. They're correct and tested via
// build coverage now, but not yet wired into interpret() — that swap
// is Phase B. Keeping the scaffolding under its own dead-code path
// means we can land it as a no-behavior-change commit and bisect cleanly.
// =====================================================================

// Reserve room for `n` more ZjsValue slots on the register stack and
// return the base offset. Grows the stack geometrically. Caller is
// responsible for initializing the reserved slots (to undefined, or
// to actual arg values).
fn reg_stack_reserve(ctx: ZjsContext*, n: u32) -> u32 {
    let needed: u32 = ctx.reg_stack_top + n;
    if needed > ctx.reg_stack_cap {
        let new_cap: u32 = if ctx.reg_stack_cap == 0 { 256 } else { ctx.reg_stack_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        ctx.reg_stack = realloc_n<ZjsValue>(ctx.reg_stack, (usize)ctx.reg_stack_cap, (usize)new_cap);
        ctx.reg_stack_cap = new_cap;
    }
    let base = ctx.reg_stack_top;
    ctx.reg_stack_top = needed;
    return base;
}

// Release the top `n` slots from the register stack.
fn reg_stack_release(ctx: ZjsContext*, n: u32) -> void {
    if n > ctx.reg_stack_top {
        ctx.reg_stack_top = 0;
    } else {
        ctx.reg_stack_top = ctx.reg_stack_top - n;
    }
}

// Push a CallFrame for `f`. Reserves `argc + f.register_count` slots
// on the register stack: args_base[0..argc] holds the full passed-args
// list (for `arguments`), regs_base[0..register_count] is the function's
// register window. The first min(argc, param_count) args are also
// copied into regs[0..param_count]; remaining regs init to undefined
// (load-bearing — GC walks the whole window).
// Like push_call_frame, but the source args live in reg_stack at
// src_offset..src_offset+argc instead of in a separate buffer. The
// usual caller does `Op::Invoke regs[base+1..]` → push_call_frame; that
// path used to detour through ctx.invoke_arg_buffer to survive a
// realloc inside reg_stack_reserve. reg_stack_reserve preserves
// contents, so src_offset stays valid across the reserve — we can
// skip the intermediate copy entirely and write directly from the
// caller's reg window into the callee's. Saves argc stores per call.
// Caller must ensure src_offset + argc <= current reg_stack top
// BEFORE the reserve (i.e. the source is in an already-allocated
// frame); since we always APPEND a new frame above, src and dst
// regions never overlap.
fn push_call_frame_inplace(ctx: ZjsContext*, f: Function*, src_offset: u32, argc: u32, ret_dst: u8) -> u32 {
    if ctx.frame_count >= ctx.frame_cap {
        let new_cap: u32 = if ctx.frame_cap == 0 { 64 } else { ctx.frame_cap * 2 };
        ctx.frames = realloc_n<CallFrame>(ctx.frames, (usize)ctx.frame_cap, (usize)new_cap);
        ctx.frame_cap = new_cap;
    }
    let reg_count: u32 = f.register_count;
    let total: u32 = argc + reg_count;
    let args_base = reg_stack_reserve(ctx, total);
    let regs_base = args_base + argc;

    // Single-arg fast path (fib_recursive, factorial, etc — by far
    // the most common call shape). memcpy with runtime size is a
    // libc call; one direct assignment is cheaper for argc=1.
    // args_base is fresh past the old reg_stack_top so it never
    // overlaps with src_offset — plain memcpy/move is safe even
    // for the uses_arguments path.
    if f.uses_arguments || f.has_rest_param {
        if argc == 1 {
            ctx.reg_stack[args_base] = ctx.reg_stack[src_offset];
        } else if argc > 1 {
            raw {
                memcpy(&ctx->reg_stack[args_base], &ctx->reg_stack[src_offset],
                       (size_t)argc * sizeof(ZjsValue));
            }
        }
    }

    let copy_count: u32 = if argc < f.param_count { argc } else { f.param_count };
    if copy_count == 1 {
        ctx.reg_stack[regs_base] = ctx.reg_stack[src_offset];
    } else if copy_count > 1 {
        raw {
            memcpy(&ctx->reg_stack[regs_base], &ctx->reg_stack[src_offset],
                   (size_t)copy_count * sizeof(ZjsValue));
        }
    }
    // Init only up to fixed_regs: params + locals + persistent temps.
    // Scratch temps above the watermark are guaranteed written-before-
    // read by the compiler, so leaving stale stack data there is safe
    // and saves a per-call write per scratch slot.
    let undef: ZjsValue = zjs_undefined();
    let init_to: u32 = f.fixed_regs;
    if init_to > reg_count { init_to = reg_count; }
    let j: u32 = copy_count;
    while j < init_to {
        ctx.reg_stack[regs_base + j] = undef;
        j = j + 1;
    }

    let idx = ctx.frame_count;
    ctx.frames[idx].f = f;
    ctx.frames[idx].ip = 0;
    ctx.frames[idx].args_base = args_base;
    ctx.frames[idx].argc = argc;
    ctx.frames[idx].regs_base = regs_base;
    ctx.frames[idx].reg_count = reg_count;
    ctx.frames[idx].return_dst = ret_dst;
    ctx.frames[idx].saved_host_this = ctx.host_this;
    ctx.frames[idx].saved_current_closure = ctx.current_closure;
    ctx.frames[idx].try_depth_at_entry = ctx.ctx_try_depth;
    ctx.frames[idx].super_called = false;
    ctx.frames[idx].outer_promise = zjs_undefined();
    ctx.frames[idx].generator     = NULL;
    ctx.frame_count = ctx.frame_count + 1;
    return idx;
}

fn push_call_frame(ctx: ZjsContext*, f: Function*, args: ZjsValue*, argc: u32, ret_dst: u8) -> u32 {
    if ctx.frame_count >= ctx.frame_cap {
        let new_cap: u32 = if ctx.frame_cap == 0 { 64 } else { ctx.frame_cap * 2 };
        ctx.frames = realloc_n<CallFrame>(ctx.frames, (usize)ctx.frame_cap, (usize)new_cap);
        ctx.frame_cap = new_cap;
    }
    let reg_count: u32 = f.register_count;
    let total: u32 = argc + reg_count;
    let args_base = reg_stack_reserve(ctx, total);
    let regs_base = args_base + argc;

    // Copy the FULL passed args list into the args slot — but only
    // when the function will actually read it (Op::BuildArguments).
    // Most functions don't touch `arguments`, and skipping this saves
    // argc stores per call (≈3% on fib_recursive).
    if f.uses_arguments || f.has_rest_param {
        let a: u32 = 0;
        while a < argc {
            ctx.reg_stack[args_base + a] = args[a];
            a = a + 1;
        }
    }

    // Copy the first min(argc, param_count) args into regs[0..]; init
    // remaining regs (up to fixed_regs) to undefined.
    let copy_count: u32 = if argc < f.param_count { argc } else { f.param_count };
    let i: u32 = 0;
    while i < copy_count {
        ctx.reg_stack[regs_base + i] = args[i];
        i = i + 1;
    }
    let undef: ZjsValue = zjs_undefined();
    let init_to: u32 = f.fixed_regs;
    if init_to > reg_count { init_to = reg_count; }
    let j: u32 = i;
    while j < init_to {
        ctx.reg_stack[regs_base + j] = undef;
        j = j + 1;
    }

    let idx = ctx.frame_count;
    ctx.frames[idx].f = f;
    ctx.frames[idx].ip = 0;
    ctx.frames[idx].args_base = args_base;
    ctx.frames[idx].argc = argc;
    ctx.frames[idx].regs_base = regs_base;
    ctx.frames[idx].reg_count = reg_count;
    ctx.frames[idx].return_dst = ret_dst;
    ctx.frames[idx].saved_host_this = ctx.host_this;
    ctx.frames[idx].saved_current_closure = ctx.current_closure;
    ctx.frames[idx].try_depth_at_entry = ctx.ctx_try_depth;
    // Per-frame flag — Op::SuperCall sets it; Op::Return checks it
    // for derived-class ctors. Default false; non-derived ctors and
    // plain calls treat it as a no-op.
    ctx.frames[idx].super_called = false;
    ctx.frames[idx].outer_promise = zjs_undefined();
    ctx.frames[idx].generator     = NULL;
    ctx.frame_count = ctx.frame_count + 1;
    return idx;
}

// Pop the top CallFrame. Restores ctx.host_this and ctx.current_closure
// from the popped frame's saved_* fields, and shrinks the register
// stack by the frame's reg_count. Pops any try-frames the frame owned.
// Returns the popped frame's return_dst (so the caller can write the
// return value into its own regs).
fn pop_call_frame(ctx: ZjsContext*) -> u8 {
    if ctx.frame_count == 0 { return 0; }
    let idx = ctx.frame_count - 1;
    let ret_dst = ctx.frames[idx].return_dst;
    let total = ctx.frames[idx].argc + ctx.frames[idx].reg_count;
    let saved_this = ctx.frames[idx].saved_host_this;
    let saved_cl   = ctx.frames[idx].saved_current_closure;
    let try_at_entry = ctx.frames[idx].try_depth_at_entry;

    ctx.host_this = saved_this;
    ctx.current_closure = saved_cl;
    if ctx.ctx_try_depth > try_at_entry {
        ctx.ctx_try_depth = try_at_entry;
    }
    reg_stack_release(ctx, total);
    ctx.frame_count = idx;
    return ret_dst;
}

// Pop frames until frame_count == target. Used on throw unwinding and
// when interpret() returns to its entry depth.
fn pop_call_frames_to(ctx: ZjsContext*, target: u32) -> void {
    while ctx.frame_count > target {
        pop_call_frame(ctx);
    }
}

// Phase 3.9h-C — replace the top CallFrame in-place with a tail call.
// The new function returns DIRECTLY to the original caller (we
// preserve return_dst / saved_host_this / saved_current_closure /
// try_depth_at_entry from the outgoing frame). Releases the old
// frame's reg_stack slots and reserves the new function's window.
fn tail_call_frame(ctx: ZjsContext*, f: Function*, args: ZjsValue*, argc: u32) -> void {
    if ctx.frame_count == 0 { return; }
    let idx = ctx.frame_count - 1;
    let old_total: u32 = ctx.frames[idx].argc + ctx.frames[idx].reg_count;
    reg_stack_release(ctx, old_total);

    let reg_count: u32 = f.register_count;
    let new_total: u32 = argc + reg_count;
    let args_base = reg_stack_reserve(ctx, new_total);
    let regs_base = args_base + argc;

    // Per-arg or bulk copy. memcpy with runtime size is a libc call —
    // for argc=1 (fib-style) one direct assignment is faster.
    if f.uses_arguments || f.has_rest_param {
        if argc == 1 {
            ctx.reg_stack[args_base] = args[0];
        } else if argc > 1 {
            raw { memcpy(&ctx->reg_stack[args_base], args, (size_t)argc * sizeof(ZjsValue)); }
        }
    }
    let copy_count: u32 = if argc < f.param_count { argc } else { f.param_count };
    if copy_count == 1 {
        ctx.reg_stack[regs_base] = args[0];
    } else if copy_count > 1 {
        raw { memcpy(&ctx->reg_stack[regs_base], args, (size_t)copy_count * sizeof(ZjsValue)); }
    }
    let undef: ZjsValue = zjs_undefined();
    let j: u32 = copy_count;
    while j < reg_count {
        ctx.reg_stack[regs_base + j] = undef;
        j = j + 1;
    }

    ctx.frames[idx].f = f;
    ctx.frames[idx].ip = 0;
    ctx.frames[idx].args_base = args_base;
    ctx.frames[idx].argc = argc;
    ctx.frames[idx].regs_base = regs_base;
    ctx.frames[idx].reg_count = reg_count;
    // return_dst, saved_host_this, saved_current_closure,
    // try_depth_at_entry: unchanged — inherited from the outgoing frame.
}

// Push a try frame on the shared context try stack. Lazily allocates.
fn ctx_try_push(ctx: ZjsContext*, catch_ip: usize, catch_reg: u8) -> bool {
    if ctx.ctx_try_depth >= CTX_MAX_TRY_DEPTH { return false; }
    if ctx.ctx_try_stack == NULL {
        ctx.ctx_try_stack = alloc_n<CtxTryFrame>((usize)CTX_MAX_TRY_DEPTH);
        ctx.ctx_try_cap = CTX_MAX_TRY_DEPTH;
    }
    let i = ctx.ctx_try_depth;
    let cur_frame = if ctx.frame_count > 0 { ctx.frame_count - 1 } else { 0 };
    ctx.ctx_try_stack[i].frame_index = cur_frame;
    ctx.ctx_try_stack[i].catch_ip = catch_ip;
    ctx.ctx_try_stack[i].catch_reg = catch_reg;
    ctx.ctx_try_depth = ctx.ctx_try_depth + 1;
    return true;
}

fn ctx_try_pop(ctx: ZjsContext*) -> void {
    if ctx.ctx_try_depth > 0 {
        ctx.ctx_try_depth = ctx.ctx_try_depth - 1;
    }
}

// Recurse through every child reference of `p`, calling
// gc_mark_value on each. Used directly by rem-set processing in
// gc_run_minor to walk old holders without tripping the early-return
// short-circuit in gc_mark_value's minor-mode check. Recursive
// gc_mark_value calls from inside this body DO respect the
// short-circuit — that's the whole point: we want to walk THIS
// old cell's slots, but stop again at any further old descendants.
fn gc_mark_cell_children(p: void*) -> void {
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)p; }
    let tag = h.type_tag;
    if tag == TAG_STRING { return; }            // leaf

    if tag == TAG_STRING_ROPE {
        // Rope holds left + right (each a string or sub-rope) plus
        // the cached flat ZjsString*. Walk children so they survive
        // collections while this rope is alive.
        let r: ZjsStringRope* = NULL;
        raw { r = (ZjsStringRope*)p; }
        gc_mark_value(r.left);
        gc_mark_value(r.right);
        if r.flat != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)r.flat));
        }
        return;
    }

    if tag == TAG_HOST_FUNCTION {
        // Phase 3.6: host functions can carry a .prototype.
        // Phase 3.8c: and arbitrary properties via .props.
        // Phase 3.10: and a per-instance .bound value (Promise resolvers).
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)p; }
        if hf.prototype != NULL {
            let pv = zjs_cell_from_ptr((void*)hf.prototype);
            gc_mark_value(pv);
        }
        if hf.props != NULL {
            let pv = zjs_cell_from_ptr((void*)hf.props);
            gc_mark_value(pv);
        }
        gc_mark_value(hf.bound);
        gc_mark_value(hf.proto_override);
        return;
    }

    if tag == TAG_OBJECT {
        let o: ZjsObject* = NULL;
        raw { o = (ZjsObject*)p; }
        // Mark the object's class — its parent chain + transition map
        // are walked transitively.
        gc_mark_hidden_class(o.cls);
        // Mark all live slots.
        let live = if o.cls != NULL { o.cls.prop_count } else { 0 };
        let i: u32 = 0;
        while i < live {
            gc_mark_value(o.slots[i]);
            i = i + 1;
        }
        // Phase 3.6: walk the proto chain so inherited values stay alive.
        if o.proto != NULL {
            let pv = zjs_cell_from_ptr((void*)o.proto);
            gc_mark_value(pv);
        }
        return;
    }

    if tag == TAG_HIDDEN_CLASS {
        let c: ZjsHiddenClass* = NULL;
        raw { c = (ZjsHiddenClass*)p; }
        gc_mark_hidden_class(c);
        return;
    }

    if tag == TAG_CLOSURE {
        let cl: ZjsClosure* = NULL;
        raw { cl = (ZjsClosure*)p; }
        // Mark the function template — wraps a Function* cell.
        if cl.function != NULL {
            let fn_val = zjs_cell_from_ptr(cl.function);
            gc_mark_value(fn_val);
        }
        // Mark the captured env object — walks its slots transitively
        // (each captured local is reachable through env).
        if cl.env != NULL {
            let env_val = zjs_cell_from_ptr((void*)cl.env);
            gc_mark_value(env_val);
        }
        return;
    }

    if tag == TAG_ACCESSOR {
        let a: ZjsAccessor* = NULL;
        raw { a = (ZjsAccessor*)p; }
        gc_mark_value(a.get);
        gc_mark_value(a.set);
        return;
    }

    if tag == TAG_PROMISE {
        let pr: ZjsPromise* = NULL;
        raw { pr = (ZjsPromise*)p; }
        gc_mark_value(pr.value);
        let i: u32 = 0;
        while i < pr.reaction_count * 3 {
            gc_mark_value(pr.reactions[i]);
            i = i + 1;
        }
        return;
    }

    if tag == TAG_PROXY {
        let px: ZjsProxy* = NULL;
        raw { px = (ZjsProxy*)p; }
        gc_mark_value(px.target);
        gc_mark_value(px.handler);
        return;
    }

    if tag == TAG_ASYNC_CONT {
        let ac: ZjsAsyncCont* = NULL;
        raw { ac = (ZjsAsyncCont*)p; }
        gc_mark_value(ac.saved_host_this);
        gc_mark_value(ac.outer_promise);
        let i: u32 = 0;
        while i < ac.reg_count {
            gc_mark_value(ac.saved_regs[i]);
            i = i + 1;
        }
        if ac.saved_current_closure != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)ac.saved_current_closure));
        }
        // function is owned by the context's function registry — no
        // separate mark needed.
        return;
    }

    if tag == TAG_GENERATOR {
        let g: ZjsGenerator* = NULL;
        raw { g = (ZjsGenerator*)p; }
        gc_mark_value(g.saved_host_this);
        let gi: u32 = 0;
        while gi < g.reg_count {
            gc_mark_value(g.saved_regs[gi]);
            gi = gi + 1;
        }
        if g.saved_current_closure != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)g.saved_current_closure));
        }
        if g.self_iter_obj != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)g.self_iter_obj));
        }
        return;
    }

    if tag == TAG_MAP {
        let mm: ZjsMap* = NULL;
        raw { mm = (ZjsMap*)p; }
        let mi: u32 = 0;
        while mi < mm.count {
            if !mm.entries[mi].deleted {
                gc_mark_value(mm.entries[mi].key);
                gc_mark_value(mm.entries[mi].value);
            }
            mi = mi + 1;
        }
        if mm.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)mm.props));
        }
        return;
    }

    if tag == TAG_SET {
        let ss: ZjsSet* = NULL;
        raw { ss = (ZjsSet*)p; }
        let si: u32 = 0;
        while si < ss.count {
            if !ss.entries[si].deleted {
                gc_mark_value(ss.entries[si].value);
            }
            si = si + 1;
        }
        if ss.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)ss.props));
        }
        return;
    }

    if tag == TAG_DATE {
        let dd: ZjsDate* = NULL;
        raw { dd = (ZjsDate*)p; }
        if dd.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)dd.props));
        }
        return;
    }

    if tag == TAG_ARRAY_ITER {
        let ai: ZjsArrayIter* = NULL;
        raw { ai = (ZjsArrayIter*)p; }
        gc_mark_value(ai.src);
        return;
    }

    if tag == TAG_SYMBOL {
        let sym: ZjsSymbol* = NULL;
        raw { sym = (ZjsSymbol*)p; }
        // description / key are atom-pinned strings, but mark for
        // symmetry with other types.
        if sym.description != NULL { sym.description.header.mark = 1; }
        if sym.key != NULL         { sym.key.header.mark = 1; }
        if sym.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)sym.props));
        }
        return;
    }

    if tag == TAG_REGEXP {
        let r: ZjsRegExp* = NULL;
        raw { r = (ZjsRegExp*)p; }
        // source / flags_str are atom-table-pinned strings, so they
        // get marked via the atom-table root. Still walking them here
        // for symmetry with the other types — atom strings short-
        // circuit the cycle but don't hurt.
        if r.source != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)r.source));
        }
        if r.flags_str != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)r.flags_str));
        }
        if r.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)r.props));
        }
        return;
    }

    if tag == TAG_ARRAY {
        let a: ZjsArray* = NULL;
        raw { a = (ZjsArray*)p; }
        let i: u32 = 0;
        while i < a.length {
            gc_mark_value(a.elements[i]);
            i = i + 1;
        }
        if a.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)a.props));
        }
        return;
    }

    if tag == TAG_FUNCTION {
        let f: Function* = NULL;
        raw { f = (Function*)p; }
        let i: u32 = 0;
        while i < f.const_count {
            gc_mark_value(f.constants[i]);
            i = i + 1;
        }
        // Phase 3.8 note: inline-cache entries used to mark ic.class_
        // strongly, which leaked hidden classes for objects long since
        // dead. The class_ pointer is now a WEAK ref — see
        // gc_nullify_dead_ics() between mark and sweep. The atom names
        // are pinned via the atom-table root, so we don't re-mark them.
        // Phase 3.6: .prototype.
        if f.prototype != NULL {
            let pv = zjs_cell_from_ptr((void*)f.prototype);
            gc_mark_value(pv);
        }
        // Expando bag (Function.props).
        if f.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)f.props));
        }
        gc_mark_value(f.parent_ctor);
        // Tagged-template strings array cache — each entry is a
        // ZjsArray (allocated lazily on first reach of the site).
        if f.template_cache != NULL {
            let ti: u32 = 0;
            while ti < f.template_count {
                let cached: ZjsArray* = f.template_cache[ti];
                if cached != NULL {
                    gc_mark_value(zjs_cell_from_ptr((void*)cached));
                }
                ti = ti + 1;
            }
        }
        // template_cooked / template_raw strings are atoms — already
        // pinned via the atom-table root, no per-cell mark needed.
        return;
    }

    if tag == TAG_TYPED_ARRAY {
        // Views hold their backing ArrayBuffer alive.
        let ta: ZjsTypedArray* = NULL;
        raw { ta = (ZjsTypedArray*)p; }
        if ta.buffer != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)ta.buffer));
        }
        return;
    }

    if tag == TAG_DATA_VIEW {
        let dv: ZjsDataView* = NULL;
        raw { dv = (ZjsDataView*)p; }
        if dv.buffer != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)dv.buffer));
        }
        return;
    }

    // TAG_ARRAY_BUFFER is a leaf — its bytes are a plain alloc, no
    // outgoing GC references.

    if tag == TAG_WEBSOCKET {
        let w: ZjsWebSocket* = NULL;
        raw { w = (ZjsWebSocket*)p; }
        if w.url != NULL { gc_mark_value(zjs_cell_from_ptr((void*)w.url)); }
        if w.protocol != NULL { gc_mark_value(zjs_cell_from_ptr((void*)w.protocol)); }
        gc_mark_value(w.on_open);
        gc_mark_value(w.on_message);
        gc_mark_value(w.on_error);
        gc_mark_value(w.on_close);
        // EventTarget listeners — each pair is (type_str, callback);
        // both must stay reachable so future dispatch can fire them.
        if w.listeners != NULL {
            let li: u32 = 0;
            let total = w.listener_count * 2;
            while li < total {
                gc_mark_value(w.listeners[li]);
                li = li + 1;
            }
        }
        return;
    }
}

// Mark a single value's reachable graph. Idempotent — already-marked
// cells return immediately, breaking cycles. In minor-GC mode the
// old-cell short-circuit prevents recursion through old children
// (the rem-set processing handles old→young edges separately).
fn gc_mark_value(v: ZjsValue) -> void {
    if zjs_is_cell(v) == 0 { return; }
    let p = zjs_cell_as_ptr(v);
    if p == NULL { return; }
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)p; }
    if h.mark != 0 { return; }
    h.mark = 1;
    if g_gc_minor_mode != 0 && h.age != 0 { return; }
    gc_mark_cell_children(p);
}

// Per-list helper for the IC compaction below. Factored out so the
// nullify pass can walk both the old and young lists.
fn gc_nullify_dead_ics_in(arr: void**, count: u32) -> void {
    let i: u32 = 0;
    while i < count {
        let p = arr[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 && h.type_tag == TAG_FUNCTION {
            let f: Function* = NULL;
            raw { f = (Function*)p; }
            let j: u32 = 0;
            while j < f.ic_count {
                // Compact: nuke entries whose cached shape OR proto-chain
                // shape is dead, slide live ones down. The order doesn't
                // matter for correctness (we linearly probe), only for
                // cache locality — leading slots stay hot.
                let write_k: u32 = 0;
                let read_k:  u32 = 0;
                let count = (u32)f.ics[j].entry_count;
                while read_k < count {
                    let cls: ZjsHiddenClass* = f.ics[j].classes[read_k];
                    let slot_raw: u32 = f.ics[j].slots[read_k];
                    let is_proto: u32 = 0;
                    raw { is_proto = (slot_raw & 0x80000000u) ? 1u : 0u; }
                    let proto_cls: ZjsHiddenClass* = NULL;
                    if is_proto != 0 && f.ic_proto_cls != NULL {
                        proto_cls = f.ic_proto_cls[j * IC_POLY_SIZE + read_k];
                    }
                    let cls_live: bool = cls != NULL && cls.header.mark != 0;
                    // Proto entries also need their cached proto shape
                    // alive; own-slot entries (no proto flag) skip.
                    let proto_live: bool = is_proto == 0
                        || (proto_cls != NULL && proto_cls.header.mark != 0);
                    if cls_live && proto_live {
                        if write_k != read_k {
                            f.ics[j].classes[write_k] = cls;
                            f.ics[j].slots[write_k] = slot_raw;
                            if f.ic_proto_cls != NULL {
                                f.ic_proto_cls[j * IC_POLY_SIZE + write_k] = proto_cls;
                            }
                        }
                        write_k = write_k + 1;
                    }
                    read_k = read_k + 1;
                }
                // Zero out the freed tail.
                let zk: u32 = write_k;
                while zk < count {
                    f.ics[j].classes[zk] = NULL;
                    f.ics[j].slots[zk] = 0;
                    if f.ic_proto_cls != NULL {
                        f.ic_proto_cls[j * IC_POLY_SIZE + zk] = NULL;
                    }
                    zk = zk + 1;
                }
                f.ics[j].entry_count = (u8)write_k;
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// After the mark phase but before sweep, walk all live Functions'
// inline caches and null out entries whose cached HiddenClass wasn't
// independently marked alive. Without this pass, the IC keeps long-dead
// classes pinned and we slow-leak shape memory in long-running programs.
// Walks both generations — young functions also carry ICs that need
// cleaning, or the next dispatch crashes on a dangling pointer.
fn gc_nullify_dead_ics(ctx: ZjsContext*) -> void {
    gc_nullify_dead_ics_in(ctx.cells,       ctx.cell_count);
    gc_nullify_dead_ics_in(ctx.young_cells, ctx.young_count);
}

// Mark a hidden class transitively: parent (chain back to root) and
// every child transition. Idempotent. In minor mode an old class is
// marked but its parent / transition links aren't walked — those
// other classes are either also old (don't need re-marking) or are
// pointed to from young objects we'll mark via the regular walk.
fn gc_mark_hidden_class(c: ZjsHiddenClass*) -> void {
    if c == NULL { return; }
    if c.header.mark != 0 { return; }
    c.header.mark = 1;
    if g_gc_minor_mode != 0 && c.header.age != 0 { return; }
    // Names are atoms; they're already pinned via the atom-table root.
    if c.parent != NULL { gc_mark_hidden_class(c.parent); }
    let i: u32 = 0;
    while i < c.trans_count {
        gc_mark_hidden_class(c.trans_children[i]);
        i = i + 1;
    }
}

fn gc_mark_roots(ctx: ZjsContext*) -> void {
    // Root empty class
    if ctx.empty_class != NULL {
        gc_mark_hidden_class(ctx.empty_class);
    }
    // Current closure — its env must survive the GC even if it isn't
    // otherwise reachable (e.g., a closure mid-call with no caller-side ref).
    if ctx.current_closure != NULL {
        let cur_val = zjs_cell_from_ptr((void*)ctx.current_closure);
        gc_mark_value(cur_val);
    }
    // Implicit host receiver for the in-flight host call.
    gc_mark_value(ctx.host_this);
    // Built-in prototype objects (kept alive across the whole context).
    if ctx.array_proto != NULL {
        let ap_val = zjs_cell_from_ptr((void*)ctx.array_proto);
        gc_mark_value(ap_val);
    }
    if ctx.string_proto != NULL {
        let sp_val = zjs_cell_from_ptr((void*)ctx.string_proto);
        gc_mark_value(sp_val);
    }
    if ctx.object_proto != NULL {
        let op_val = zjs_cell_from_ptr((void*)ctx.object_proto);
        gc_mark_value(op_val);
    }
    if ctx.function_proto != NULL {
        let fp_val = zjs_cell_from_ptr((void*)ctx.function_proto);
        gc_mark_value(fp_val);
    }
    if ctx.global_this_obj != NULL {
        let gt_val = zjs_cell_from_ptr((void*)ctx.global_this_obj);
        gc_mark_value(gt_val);
    }
    // Phase 3.8d cached helpers
    gc_mark_value(ctx.fn_call_v);
    gc_mark_value(ctx.fn_apply_v);
    // Phase 3.5b temp roots
    let t: u32 = 0;
    while t < ctx.temp_root_count {
        gc_mark_value(ctx.temp_roots[t]);
        t = t + 1;
    }
    // Globals
    let i: u32 = 0;
    while i < ctx.global_count {
        gc_mark_value(ctx.globals[i].value);
        i = i + 1;
    }
    // Last uncaught error (so the C consumer can still inspect it)
    gc_mark_value(ctx.last_error);
    // Each active call frame (current recursive model)
    let j: u32 = 0;
    while j < ctx.root_depth {
        let frame = ctx.root_frames[j];
        let k: u32 = 0;
        while k < frame.reg_count {
            gc_mark_value(frame.regs[k]);
            k = k + 1;
        }
        j = j + 1;
    }
    // Phase 3.9h: shared reg_stack + per-frame saved host_this /
    // current_closure. Covers everything any active CallFrame might
    // reference (args + regs are contiguous on reg_stack).
    let r: u32 = 0;
    while r < ctx.reg_stack_top {
        gc_mark_value(ctx.reg_stack[r]);
        r = r + 1;
    }
    let fi: u32 = 0;
    while fi < ctx.frame_count {
        gc_mark_value(ctx.frames[fi].saved_host_this);
        gc_mark_value(ctx.frames[fi].outer_promise);
        if ctx.frames[fi].saved_current_closure != NULL {
            let cv = zjs_cell_from_ptr((void*)ctx.frames[fi].saved_current_closure);
            gc_mark_value(cv);
        }
        fi = fi + 1;
    }
    // Phase 3.10 — microtask queue + cached Promise prototype.
    let mq: u32 = 0;
    while mq < ctx.microtask_count * 4 {
        gc_mark_value(ctx.microtask_queue[mq]);
        mq = mq + 1;
    }
    if ctx.promise_ctor_proto != NULL {
        let pv = zjs_cell_from_ptr((void*)ctx.promise_ctor_proto);
        gc_mark_value(pv);
    }
    if ctx.generator_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.generator_proto));
    }
    if ctx.map_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.map_proto));
    }
    if ctx.set_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.set_proto));
    }
    if ctx.date_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.date_proto));
    }
    if ctx.symbol_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.symbol_proto));
    }
    if ctx.url_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.url_proto));
    }
    if ctx.usp_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.usp_proto));
    }
    if ctx.uint8_array_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.uint8_array_proto));
    }
    if ctx.int8_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.int8_array_proto)); }
    if ctx.uint8_clamped_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.uint8_clamped_array_proto)); }
    if ctx.int16_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.int16_array_proto)); }
    if ctx.uint16_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.uint16_array_proto)); }
    if ctx.int32_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.int32_array_proto)); }
    if ctx.uint32_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.uint32_array_proto)); }
    if ctx.float32_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.float32_array_proto)); }
    if ctx.float64_array_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.float64_array_proto)); }
    if ctx.array_buffer_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.array_buffer_proto)); }
    if ctx.data_view_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.data_view_proto)); }
    if ctx.websocket_proto != NULL { gc_mark_value(zjs_cell_from_ptr((void*)ctx.websocket_proto)); }
    // Live WebSocket cells — kept alive by the engine until close,
    // even when JS drops the last reference (a "ws.onmessage = ..."
    // handler still needs to fire).
    let wsi: u32 = 0;
    while wsi < ctx.websocket_count {
        let w = ctx.websockets[wsi];
        if w != NULL { gc_mark_value(zjs_cell_from_ptr((void*)w)); }
        wsi = wsi + 1;
    }
    if ctx.headers_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.headers_proto));
    }
    if ctx.response_proto != NULL {
        gc_mark_value(zjs_cell_from_ptr((void*)ctx.response_proto));
    }
    // In-flight fetch promises + URLs must stay alive even if user
    // code dropped the only reference — completion still needs to
    // fire .then handlers.
    let pfi: u32 = 0;
    while pfi < ctx.pending_fetch_count {
        gc_mark_value(ctx.pending_fetch_promises[pfi]);
        gc_mark_value(ctx.pending_fetch_urls[pfi]);
        pfi = pfi + 1;
    }
    // Pending timer callbacks + their captured args must stay alive
    // across collections — they're scheduled to run but not yet
    // reachable through any user code root.
    let ti: u32 = 0;
    while ti < ctx.timer_count {
        let tt = ctx.timers + ti;
        if !tt.cancelled {
            gc_mark_value(tt.handler);
            let ai: u32 = 0;
            while ai < tt.argc { gc_mark_value(tt.args[ai]); ai = ai + 1; }
        }
        ti = ti + 1;
    }
    gc_mark_value(ctx.array_iter_host_fn);
    // Symbol.for registry — both keys and the symbols themselves stay
    // alive as long as the context does.
    let sfi: u32 = 0;
    while sfi < ctx.symbol_for_count {
        if ctx.symbol_for_keys[sfi] != NULL { ctx.symbol_for_keys[sfi].header.mark = 1; }
        if ctx.symbol_for_syms[sfi] != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)ctx.symbol_for_syms[sfi]));
        }
        sfi = sfi + 1;
    }
    // Interned atoms — they live for the context's lifetime.
    let a: u32 = 0;
    while a < ctx.atom_cap {
        let s = ctx.atoms[a].str;
        if s != NULL { s.header.mark = 1; }
        a = a + 1;
    }
}

// Free a single cell by type tag. Pulled out of gc_sweep so the
// young-list sweep + zjs_free_context can share the dispatch.
// Caller must have already determined the cell is dead (or that the
// context is being torn down).
fn gc_free_one(p: void*) -> void {
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)p; }
    let tag = h.type_tag;
    if tag == TAG_FUNCTION      {
        raw { extern void function_free_void(void* f); function_free_void(p); }
    } else if tag == TAG_STRING        { string_free_void(p); }
      else if tag == TAG_OBJECT        { object_free_void(p); }
      else if tag == TAG_ARRAY         { array_free_void(p); }
      else if tag == TAG_HOST_FUNCTION { host_function_free_void(p); }
      else if tag == TAG_CLOSURE       { closure_free_void(p); }
      else if tag == TAG_ACCESSOR      { accessor_free_void(p); }
      else if tag == TAG_PROMISE       { promise_free_void(p); }
      else if tag == TAG_REGEXP        { regexp_free_void(p); }
      else if tag == TAG_ASYNC_CONT    {
          let ac: ZjsAsyncCont* = NULL;
          raw { ac = (ZjsAsyncCont*)p; }
          if ac.saved_regs != NULL { dealloc(ac.saved_regs); }
          dealloc(ac);
      }
      else if tag == TAG_GENERATOR     {
          let g: ZjsGenerator* = NULL;
          raw { g = (ZjsGenerator*)p; }
          if g.saved_regs != NULL { dealloc(g.saved_regs); }
          dealloc(g);
      }
      else if tag == TAG_MAP           {
          let mm: ZjsMap* = NULL;
          raw { mm = (ZjsMap*)p; }
          if mm.entries != NULL { dealloc(mm.entries); }
          dealloc(mm);
      }
      else if tag == TAG_SET           {
          let ss: ZjsSet* = NULL;
          raw { ss = (ZjsSet*)p; }
          if ss.entries != NULL { dealloc(ss.entries); }
          dealloc(ss);
      }
      else if tag == TAG_DATE          {
          let dd: ZjsDate* = NULL;
          raw { dd = (ZjsDate*)p; }
          dealloc(dd);
      }
      else if tag == TAG_SYMBOL        {
          let sm: ZjsSymbol* = NULL;
          raw { sm = (ZjsSymbol*)p; }
          dealloc(sm);
      }
      else if tag == TAG_ARRAY_ITER    {
          let aa: ZjsArrayIter* = NULL;
          raw { aa = (ZjsArrayIter*)p; }
          dealloc(aa);
      }
      else if tag == TAG_HIDDEN_CLASS  { hidden_class_free_void(p); }
      else if tag == TAG_UINT8_ARRAY   { uint8_array_free_void(p); }
      else if tag == TAG_TYPED_ARRAY   { typed_array_free_void(p); }
      else if tag == TAG_ARRAY_BUFFER  { array_buffer_free_void(p); }
      else if tag == TAG_DATA_VIEW     { data_view_free_void(p); }
      else if tag == TAG_WEBSOCKET     { websocket_free_void(p); }
      else if tag == TAG_STRING_ROPE   { rope_free_void(p); }
}

// Sweep the young-generation list. Marked cells are promoted to the
// old gen (appended to ctx.cells); unmarked are freed.
//
// IMPORTANT: we leave the mark bit set on promoted cells. If we
// cleared it here and a sweep_old pass ran immediately after (the
// major path), it would see the newly-promoted cells as unmarked
// and free them. Mark-clearing is the caller's responsibility:
// either sweep_old does it during its compaction, or the
// post-minor clear loop does it.
fn gc_sweep_young(ctx: ZjsContext*) -> u32 {
    let i: u32 = 0;
    let promoted: u32 = 0;
    while i < ctx.young_count {
        let p = ctx.young_cells[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 {
            ctx_register_cell_old(ctx, p);
            promoted = promoted + 1;
        } else {
            gc_free_one(p);
        }
        i = i + 1;
    }
    ctx.young_count = 0;
    ctx.cells_since_minor = 0;
    return promoted;
}

// Sweep the old-generation list. Same compaction as the original
// single-list sweep — keep marked, free unmarked, compact in place.
fn gc_sweep_old(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    let kept: u32 = 0;
    while i < ctx.cell_count {
        let p = ctx.cells[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 {
            h.mark = 0;
            ctx.cells[kept] = p;
            kept = kept + 1;
        } else {
            gc_free_one(p);
        }
        i = i + 1;
    }
    ctx.cell_count = kept;
}

// Minor: walk the live graph from roots (still touches old cells in
// this Session 2 pass — Session 3 will trim that to a remembered
// set), sweep ONLY the young list, and promote survivors into old.
// Old cells are untouched: they stay marked-as-cleared at the end of
// the cycle so the next minor's mark walk starts with mark=0
// everywhere.
//
// Caveat: without the Session-3 write barrier, the mark walk costs
// O(live), not O(young). On benches with a large persistent live
// set (e.g. splay) this makes minors *more* expensive than the
// pre-experiment single-collector path if they fire too often. We
// adapt `young_threshold` upward as old gen grows so minor frequency
// stays bounded — see the threshold update at the bottom of this
// function.
fn gc_run_minor(ctx: ZjsContext*) -> void {
    let before = ctx.young_count;
    let t0: u64 = 0;
    let t1: u64 = 0;
    raw {
        struct timespec _ts0;
        clock_gettime(CLOCK_MONOTONIC, &_ts0);
        t0 = (uint64_t)_ts0.tv_sec * 1000000000ULL + (uint64_t)_ts0.tv_nsec;
    }
    // Switch the mark walker into minor mode: old cells are marked
    // but their slots aren't re-walked. The remembered set bridges
    // the gap by enumerating each old cell that ever stored a young
    // pointer; we re-scan those cells' slots so descendants in the
    // nursery get found.
    g_gc_minor_mode = 1;
    gc_mark_roots(ctx);
    // Process remembered set: walk each old holder's child slots
    // directly via gc_mark_cell_children, bypassing the early-return
    // in gc_mark_value. The recursive gc_mark_value calls inside the
    // children walk DO respect minor mode — so we descend through
    // young descendants and stop at any further old cells.
    let ri: u32 = 0;
    while ri < ctx.rem_count {
        let rp = ctx.rem_set[ri];
        if rp != NULL {
            let rh: CellHeader* = NULL;
            raw { rh = (CellHeader*)rp; }
            rh.mark = 1;   // holder survives by virtue of being in the rem set
            gc_mark_cell_children(rp);
        }
        ri = ri + 1;
    }
    gc_nullify_dead_ics(ctx);
    let promoted = gc_sweep_young(ctx);
    g_gc_minor_mode = 0;
    // Clear marks on the old generation — they got set by the mark
    // walk above. Without this the next minor would see them already
    // "marked" and skip nothing.
    let oi: u32 = 0;
    while oi < ctx.cell_count {
        let op = ctx.cells[oi];
        let oh: CellHeader* = NULL;
        raw { oh = (CellHeader*)op; }
        oh.mark = 0;
        oi = oi + 1;
    }
    // Reset the remembered set. After a minor every reachable young
    // cell has been promoted, so no old→young edges remain. New
    // edges that arise after this minor are captured by the write
    // barrier on the next store.
    ctx.rem_count = 0;
    raw {
        struct timespec _ts1;
        clock_gettime(CLOCK_MONOTONIC, &_ts1);
        t1 = (uint64_t)_ts1.tv_sec * 1000000000ULL + (uint64_t)_ts1.tv_nsec;
    }
    let pause = t1 - t0;
    ctx.gc_collections    = ctx.gc_collections + 1;
    ctx.gc_minors         = ctx.gc_minors + 1;
    ctx.gc_pause_ns_total = ctx.gc_pause_ns_total + pause;
    if pause > ctx.gc_pause_ns_max { ctx.gc_pause_ns_max = pause; }
    let freed: u32 = if before > promoted { before - promoted } else { 0 };
    ctx.gc_cells_freed    = ctx.gc_cells_freed + freed;
    ctx.gc_cells_kept     = ctx.cell_count;
    ctx.gc_promoted       = ctx.gc_promoted + promoted;
    // Session-3 trigger: with the write barrier in place, a minor
    // walks roots + rem_set, NOT the full old gen. Stay aggressive —
    // a small fixed threshold means short-lived garbage gets freed
    // quickly and minors are cheap.
    ctx.young_threshold = 1024;
}

// Major: full mark + sweep of both generations. Resets the major
// threshold (= 2× live old) and the cells_since_gc accumulator.
fn gc_run_major(ctx: ZjsContext*) -> void {
    let before_total = ctx.cell_count + ctx.young_count;
    let t0: u64 = 0;
    let t1: u64 = 0;
    raw {
        struct timespec _ts0;
        clock_gettime(CLOCK_MONOTONIC, &_ts0);
        t0 = (uint64_t)_ts0.tv_sec * 1000000000ULL + (uint64_t)_ts0.tv_nsec;
    }
    // Force full-reachability semantics for the mark walk — a major
    // collection sweeps both gens, so old cells need their full slot
    // graph traversed (no short-circuit on age).
    g_gc_minor_mode = 0;
    gc_mark_roots(ctx);
    gc_nullify_dead_ics(ctx);
    let promoted = gc_sweep_young(ctx);
    gc_sweep_old(ctx);
    ctx.cells_since_gc = 0;
    // After a major, every reachable cell is in old gen and rem_set
    // (which tracked old→young edges) is moot.
    ctx.rem_count = 0;
    let target: u32 = ctx.cell_count * 2;
    if target < 256 { target = 256; }
    ctx.gc_threshold = target;
    raw {
        struct timespec _ts1;
        clock_gettime(CLOCK_MONOTONIC, &_ts1);
        t1 = (uint64_t)_ts1.tv_sec * 1000000000ULL + (uint64_t)_ts1.tv_nsec;
    }
    let pause = t1 - t0;
    ctx.gc_collections    = ctx.gc_collections + 1;
    ctx.gc_majors         = ctx.gc_majors + 1;
    ctx.gc_pause_ns_total = ctx.gc_pause_ns_total + pause;
    if pause > ctx.gc_pause_ns_max { ctx.gc_pause_ns_max = pause; }
    let after_total = ctx.cell_count;  // young is now empty
    let freed: u32 = if before_total > after_total { before_total - after_total } else { 0 };
    ctx.gc_cells_freed    = ctx.gc_cells_freed + freed;
    ctx.gc_cells_kept     = ctx.cell_count;
    ctx.gc_promoted       = ctx.gc_promoted + promoted;
}

// Compatibility shim — pre-experiment callers (test262 harness, the
// embed ABI's zjs_gc) want "do a full collection now".
fn gc_run(ctx: ZjsContext*) -> void { gc_run_major(ctx); }

fn ctx_maybe_gc(ctx: ZjsContext*) -> void {
    // Generational minor path is OFF in tree (2026-05-18). The
    // write-barrier audit needed for correctness is incomplete —
    // multiple heap-pointer fields (o.proto, hf.bound, hf.prototype,
    // pr.reactions, ac.*, g.*) don't yet route through the barrier,
    // so promoting cells to old without those barriers leads to
    // use-after-free when minor sweeps young descendants prematurely.
    // The young/old split + sweep_young + sweep_old + rem-set
    // infrastructure remain in tree as scaffolding (see
    // docs/gc-experiment.md for the design); flipping the trigger
    // back on requires finishing the audit. Until then, every minor
    // attempt was producing infinite GC loops on splay-shape
    // workloads, and Session 2 measurements showed no win without
    // the barrier anyway.
    if ctx.cells_since_gc >= ctx.gc_threshold {
        gc_run_major(ctx);
    }
}

// --- Public ABI -----------------------------------------------------

fn zjs_gc(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    gc_run(ctx);
}

fn zjs_cell_count(ctx: ZjsContext*) -> u32 {
    if ctx == NULL { return 0; }
    // Returns total live cells across both generations — the public
    // ABI doesn't expose the young/old split.
    return ctx.cell_count + ctx.young_count;
}

// GC instrumentation getters (2026-05-18). Cumulative across the
// lifetime of the context. Pauses are in nanoseconds.
fn zjs_gc_collections(ctx: ZjsContext*) -> u32 {
    if ctx == NULL { return 0; }
    return ctx.gc_collections;
}
fn zjs_gc_pause_ns_total(ctx: ZjsContext*) -> u64 {
    if ctx == NULL { return 0; }
    return ctx.gc_pause_ns_total;
}
fn zjs_gc_pause_ns_max(ctx: ZjsContext*) -> u64 {
    if ctx == NULL { return 0; }
    return ctx.gc_pause_ns_max;
}
fn zjs_gc_cells_freed(ctx: ZjsContext*) -> u32 {
    if ctx == NULL { return 0; }
    return ctx.gc_cells_freed;
}

// Intern a string by copying the input bytes. The returned ZjsValue
// is a NaN-boxed cell pointer registered with the context.
//
// NOT deduplicated — every call allocates a fresh ZjsString. For
// dedup, use ctx_intern_atom. This is the right function for ToString
// results (numeric → "42") and other transient strings that don't
// benefit from dedup.
fn ctx_intern_string(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// Take ownership of an already-malloc'd buffer. Used by zjs_string_concat
// which allocates the result buffer itself. Also NOT deduplicated.
fn ctx_intern_string_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// =====================================================================
// Atom table — deduplicated strings. Used for property names and
// source-code string literals.
// =====================================================================

fn atom_hash(data: char*, length: u32) -> u32 {
    // FNV-1a 32-bit
    let h: u32 = 2166136261;
    let i: u32 = 0;
    while i < length {
        let b: u32 = (u32)(u8)data[i];
        h = h ^ b;
        h = h * 16777619;
        i = i + 1;
    }
    return h;
}

fn atom_table_insert_unchecked(ctx: ZjsContext*, s: ZjsString*, h: u32) -> void {
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        i = (i + 1) & mask;
    }
    ctx.atoms[i].str = s;
    ctx.atoms[i].hash = h;
    ctx.atom_count = ctx.atom_count + 1;
}

fn atom_table_grow(ctx: ZjsContext*) -> void {
    let old_cap = ctx.atom_cap;
    let old_atoms = ctx.atoms;

    let new_cap: u32 = if old_cap == 0 { 16 } else { old_cap * 2 };
    ctx.atoms = alloc_n<AtomEntry>((usize)new_cap);
    ctx.atom_cap = new_cap;
    ctx.atom_count = 0;

    if old_cap > 0 {
        let i: u32 = 0;
        while i < old_cap {
            if old_atoms[i].str != NULL {
                atom_table_insert_unchecked(ctx, old_atoms[i].str, old_atoms[i].hash);
            }
            i = i + 1;
        }
        dealloc(old_atoms);
    }
}

fn atom_table_lookup(ctx: ZjsContext*, data: char*, length: u32, h: u32) -> ZjsString* {
    if ctx.atom_cap == 0 { return NULL; }
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        let s = ctx.atoms[i].str;
        if ctx.atoms[i].hash == h && s.length == length {
            let s_data = s.data;
            let eq: int = 0;
            raw { eq = (memcmp(s_data, data, length) == 0) ? 1 : 0; }
            if eq != 0 { return s; }
        }
        i = (i + 1) & mask;
    }
    return NULL;
}

// Public intern: dedupe by content. Allocates only on cache miss.
fn ctx_intern_atom(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL { return existing; }

    // Grow first if needed (so insert below doesn't trip a probe through a full table).
    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Same as above, but adopts ownership of an already-malloc'd
// null-terminated buffer. Frees the buffer on dedup hit.
fn ctx_intern_atom_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL {
        // Caller's buffer is redundant — free it.
        dealloc(data);
        return existing;
    }

    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Allocate a fresh empty object and register it on the context.
// Initializes with the root empty class — fresh property additions
// will spawn transitions on first write.
fn ctx_new_object(ctx: ZjsContext*) -> ZjsValue {
    let o = zjs_object_new();
    o.cls = ctx.empty_class;
    // Default proto: every {} inherits from Object.prototype.
    // Skipped while bootstrapping object_proto itself (it's NULL then).
    if ctx.object_proto != NULL && o != ctx.object_proto {
        o.proto = ctx.object_proto;
    }
    ctx_register_cell(ctx, (void*)o);
    return zjs_cell_from_ptr((void*)o);
}

// Full object_set with hidden-class transition logic. Updates an
// existing property if present; otherwise follows or creates a
// transition edge. New properties get default attributes (writable
// + enumerable + configurable all true) — matches the ECMA-262
// behavior of `o.x = 1` going through OrdinarySet which creates a
// data property with full attributes.
fn object_set(ctx: ZjsContext*, obj: ZjsObject*, name: ZjsString*, value: ZjsValue) -> void {
    if obj.frozen { return; }
    let existing = class_find_slot(obj.cls, name);
    if existing >= 0 {
        // Existing slot — check writable.
        let attrs = if obj.attrs != NULL { obj.attrs[(u32)existing] } else { PROP_DEFAULT };
        if (attrs & PROP_WRITABLE) == 0 {
            // Strict-mode would throw; non-strict silently drops. MVP
            // takes the non-strict path everywhere.
            return;
        }
        obj.slots[(u32)existing] = value;
        gc_write_barrier(ctx, (void*)obj, value);
        return;
    }

    // Property is new. Find or create a transition.
    let parent_cls = obj.cls;
    let child = class_find_transition(parent_cls, name);
    if child == NULL {
        child = zjs_hidden_class_new(parent_cls, name,
                                      parent_cls.prop_count,
                                      parent_cls.prop_count + 1);
        ctx_register_cell(ctx, (void*)child);
        class_add_transition(parent_cls, name, child);
    }

    // Grow slots + attrs to accommodate the new property. Both arrays
    // are sized identically so the slot index doubles as an attrs
    // index — no separate cap tracking.
    let needed = child.prop_count;
    if obj.slot_cap < needed {
        let new_cap: u32 = if obj.slot_cap == 0 { 4 } else { obj.slot_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        let new_slots = realloc_n<ZjsValue>(obj.slots, (usize)obj.slot_cap, (usize)new_cap);
        let new_attrs = realloc_n<u8>(obj.attrs, (usize)obj.slot_cap, (usize)new_cap);
        let und: ZjsValue = zjs_undefined();
        let i = obj.slot_cap;
        while i < new_cap {
            new_slots[i] = und;
            new_attrs[i] = PROP_DEFAULT;
            i = i + 1;
        }
        obj.slots = new_slots;
        obj.attrs = new_attrs;
        obj.slot_cap = new_cap;
    }

    obj.slots[child.transition_slot] = value;
    obj.attrs[child.transition_slot] = PROP_DEFAULT;
    obj.cls = child;
    gc_write_barrier(ctx, (void*)obj, value);
    // Hidden-class transition: when an old object gains a new shape,
    // the freshly-allocated class is young — its mark walk only
    // reaches it through obj.cls, which is exactly the kind of
    // old→young edge the rem set tracks.
    gc_write_barrier(ctx, (void*)obj, zjs_cell_from_ptr((void*)child));
}

// Read the attribute byte for slot `idx` on `obj`. Returns
// PROP_DEFAULT if the object has no attrs array yet (lazy alloc) —
// the slot would have been freshly written via the bootstrap path
// and inherits full attributes.
fn object_get_attrs(obj: ZjsObject*, slot: u32) -> u8 {
    if obj.attrs == NULL { return PROP_DEFAULT; }
    if slot >= obj.slot_cap { return PROP_DEFAULT; }
    return obj.attrs[slot];
}

// Write the attribute byte for slot `idx`. Caller is responsible
// for ensuring the slot exists (slot < cls.prop_count). The attrs
// array is allocated lazily by object_set; this writer assumes it
// already exists since the slot does.
fn object_set_attrs(obj: ZjsObject*, slot: u32, attrs: u8) -> void {
    if obj.attrs == NULL { return; }
    if slot >= obj.slot_cap { return; }
    obj.attrs[slot] = attrs;
}

// Low-level define: write value + attrs without the writable check.
// Used by Object.defineProperty and friends — the spec entry point
// that explicitly changes attributes. Plain assignment goes through
// object_set, which DOES honor writable.
fn object_define_property_slot(ctx: ZjsContext*, obj: ZjsObject*, name: ZjsString*, value: ZjsValue, attrs: u8) -> void {
    let existing = class_find_slot(obj.cls, name);
    if existing >= 0 {
        obj.slots[(u32)existing] = value;
        if obj.attrs != NULL { obj.attrs[(u32)existing] = attrs; }
        return;
    }
    // New property: same transition logic as object_set's new-prop path.
    let parent_cls = obj.cls;
    let child = class_find_transition(parent_cls, name);
    if child == NULL {
        child = zjs_hidden_class_new(parent_cls, name,
                                      parent_cls.prop_count,
                                      parent_cls.prop_count + 1);
        ctx_register_cell(ctx, (void*)child);
        class_add_transition(parent_cls, name, child);
    }
    let needed = child.prop_count;
    if obj.slot_cap < needed {
        let new_cap: u32 = if obj.slot_cap == 0 { 4 } else { obj.slot_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        let new_slots = realloc_n<ZjsValue>(obj.slots, (usize)obj.slot_cap, (usize)new_cap);
        let new_attrs = realloc_n<u8>(obj.attrs, (usize)obj.slot_cap, (usize)new_cap);
        let und: ZjsValue = zjs_undefined();
        let i = obj.slot_cap;
        while i < new_cap {
            new_slots[i] = und;
            new_attrs[i] = PROP_DEFAULT;
            i = i + 1;
        }
        obj.slots = new_slots;
        obj.attrs = new_attrs;
        obj.slot_cap = new_cap;
    }
    obj.slots[child.transition_slot] = value;
    obj.attrs[child.transition_slot] = attrs;
    obj.cls = child;
}

// Allocate a fresh array with `length` slots, all undefined.
fn ctx_new_array(ctx: ZjsContext*, length: u32) -> ZjsValue {
    let a = zjs_array_new(length);
    ctx_register_cell(ctx, (void*)a);
    return zjs_cell_from_ptr((void*)a);
}

// =====================================================================
// Host functions + built-in registry. ctx_init_builtins is called at
// the end of zjs_new_context so every context starts with Error and
// Math available globally.
// =====================================================================

// Register a host function as a global. fn_ptr must point to a C
// function with signature:
//     ZjsValue (*)(ZjsContext*, ZjsValue*, uint32_t)
fn ctx_register_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf = alloc<ZjsHostFunction>();
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy = alloc_n<char>(name_len + 1);
    mem_copy<char>(name_copy, name, name_len + 1);
    hf.name = name_copy;
    hf.proto_override = zjs_undefined();
    hf.is_constructor = true;

    ctx_register_cell(ctx, (void*)hf);
    let val = zjs_cell_from_ptr((void*)hf);

    // Stash in a global slot.
    let slot = ctx_intern_global(ctx, name, (u32)name_len);
    ctx.globals[slot].value = val;
    ctx.globals[slot].defined = true;
    return val;
}

// Like ctx_register_host_function but doesn't create a global slot —
// used when the function is going to be attached as an object property
// (e.g. Math.abs).
fn ctx_make_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf = alloc<ZjsHostFunction>();
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy = alloc_n<char>(name_len + 1);
    mem_copy<char>(name_copy, name, name_len + 1);
    hf.name = name_copy;
    // proto_override defaults to undefined — Object.getPrototypeOf
    // then falls back to ctx.function_proto.
    hf.proto_override = zjs_undefined();
    // Default IsConstructor = true to match legacy behavior (Array,
    // Number, ... + tests that did `new f()` on user-defined host
    // wrappers). Prototype-method registrations flag themselves false
    // via a post-init sweep over each prototype object.
    hf.is_constructor = true;

    ctx_register_cell(ctx, (void*)hf);
    return zjs_cell_from_ptr((void*)hf);
}

// Mark every host-function-valued own slot on `proto` as non-
// constructor. Called after Array.prototype / String.prototype / etc
// finish wiring their method tables, so `new Array.prototype.push()` and
// friends throw TypeError per spec.
fn mark_proto_methods_non_constructor(ctx: ZjsContext*, proto: ZjsObject*) -> void {
    if proto == NULL { return; }
    let cls = proto.cls;
    if cls == NULL { return; }
    // Walk the transition chain to recover the name for each slot, so
    // we can skip "constructor" — that slot points back at the host
    // constructor itself (Array, Number, ...) which IS callable with
    // `new`.
    let cur = cls;
    while cur != NULL && cur.parent != NULL {
        let slot = cur.transition_slot;
        let nm = cur.transition_name;
        let is_ctor: int = 0;
        if nm != NULL && nm.length == 11 {
            let nm_data = nm.data;
            raw { is_ctor = (memcmp(nm_data, "constructor", 11) == 0) ? 1 : 0; }
        }
        if is_ctor == 0 {
            let v = proto.slots[slot];
            if zjs_is_host_function(v) != 0 {
                let hf = zjs_as_host_function(v);
                // Belt-and-suspenders: skip anything that already
                // looks like a constructor (has its own .prototype
                // or .props). Shared host functions (e.g. the
                // wrapper-valueOf used across Number/Boolean/String
                // prototypes) don't carry these.
                if hf.prototype == NULL && hf.props == NULL {
                    hf.is_constructor = false;
                }
            }
        }
        cur = cur.parent;
    }
}

// Variant that lets the caller set the spec-mandated arity for the
// host function's `.length` property. Used when registering built-ins
// whose formal-parameter counts matter to test262 ("the length
// property of Array.prototype.push is 1", etc.).
fn ctx_make_host_function_arity(ctx: ZjsContext*, name: char*, fn_ptr: void*, arity: u32) -> ZjsValue {
    let v = ctx_make_host_function(ctx, name, fn_ptr);
    zjs_as_host_function(v).arity = arity;
    return v;
}

// --- Built-in implementations ---------------------------------------

// Error("msg") — produces { message, name: "Error" }. Decorates the
// `new` target when invoked via `new`, so `e instanceof Error` works.
fn host_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"Error", 5, args, argc);
}

// Error.prototype.toString — ECMA-262 §20.5.3.4.
// Returns "Name: message", or "Name" if message is empty/missing, or
// "message" if name is empty. Defaults: Name="Error", message="".
fn host_error_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_object(this_val) == 0 {
        return ctx_intern_string(ctx, (char*)"Error", 5);
    }
    let name_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"name", 4)));
    let msg_v  = property_get(ctx, this_val, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"message", 7)));
    if zjs_is_undefined(name_v) != 0 { name_v = ctx_intern_string(ctx, (char*)"Error", 5); }
    else if zjs_is_string(name_v) == 0 { name_v = zjs_to_string(ctx, name_v); }
    let has_msg: bool = !zjs_is_undefined(msg_v);
    if has_msg && zjs_is_string(msg_v) == 0 { msg_v = zjs_to_string(ctx, msg_v); }

    if !has_msg { return name_v; }
    let name_s = zjs_as_string(name_v);
    let msg_s  = zjs_as_string(msg_v);
    if name_s.length == 0 { return msg_v; }
    if msg_s.length == 0 { return name_v; }
    // Concatenate "Name: msg"
    let total = name_s.length + 2 + msg_s.length;
    let buf = alloc_n<char>((usize)(total + 1));
    mem_copy<char>(buf, name_s.data, (usize)name_s.length);
    buf[name_s.length]     = ':';
    buf[name_s.length + 1] = ' ';
    let tail_off = name_s.length + 2;
    let tail: char* = NULL;
    raw { tail = &buf[tail_off]; }
    mem_copy<char>(tail, msg_s.data, (usize)msg_s.length);
    buf[total] = (char)0;
    return ctx_intern_string_take(ctx, buf, total);
}

// --- Math.* helpers -------------------------------------------------

raw {
    #include <math.h>
}

fn host_math_abs(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §21.3.2.1: no-arg → NaN. -0 → +0 (observable via
    // 1/Math.abs(-0) === Infinity).
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    let v = args[0];
    if zjs_is_int32(v) != 0 {
        let i = zjs_as_int32(v);
        if i >= 0 { return v; }
        return zjs_arith_neg(v);
    }
    let d = zjs_to_double(v);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if d == 0.0 { return zjs_double(0.0); }    // -0 → +0
    if d < 0.0 { return zjs_double(-d); }
    return zjs_double(d);
}

fn host_math_floor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    return zjs_double(Math::floor(zjs_to_double(args[0])));
}

fn host_math_ceil(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    return zjs_double(Math::ceil(zjs_to_double(args[0])));
}

fn host_math_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §21.3.2.28 Math.round (rounds half toward +∞):
    //   NaN → NaN
    //   ±Infinity / ±0 → unchanged
    //   x in (-0.5, 0)  → -0   (NOT 0)
    //   x in [0.5, ∞)   → floor(x + 0.5)
    //   else → floor(x + 0.5)
    // No-arg → NaN per ToNumber(undefined).
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    let x = zjs_to_double(args[0]);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_nan: int = 0; let is_inf: int = 0;
    raw { is_nan = isnan(x) ? 1 : 0; is_inf = isinf(x) ? 1 : 0; }
    if is_nan != 0 { return zjs_double(nan); }
    if is_inf != 0 { return zjs_double(x); }
    // Preserve -0 / +0.
    if x == 0.0 { return zjs_double(x); }
    // For x in (-0.5, 0), floor(x + 0.5) = floor(< 0.5) = 0, but spec says -0.
    if x < 0.0 && x >= -0.5 {
        let nz: f64 = 0.0; raw { nz = -0.0; }
        return zjs_double(nz);
    }
    return zjs_double(Math::floor(x + 0.5));
}

fn host_math_sqrt(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    return zjs_double(Math::sqrt(zjs_to_double(args[0])));
}

fn host_math_pow(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    let base: f64 = 0.0; raw { base = NAN; }
    let exp:  f64 = 0.0; raw { exp  = NAN; }
    if argc >= 1 { base = zjs_to_double(args[0]); if ctx.pending_throw_active { return zjs_undefined(); } }
    if argc >= 2 { exp  = zjs_to_double(args[1]); if ctx.pending_throw_active { return zjs_undefined(); } }
    // ECMA-262 §21.3.2.27: |base| === 1 and exp is ±Infinity → NaN.
    // libm's pow(-1, ±Inf) returns 1 (since (-1)^Inf is mathematically
    // ambiguous and IEEE chooses 1); JS spec mandates NaN.
    let exp_is_inf: int = 0;
    raw { exp_is_inf = isinf(exp) ? 1 : 0; }
    if exp_is_inf != 0 {
        let absb: f64 = 0.0; raw { absb = fabs(base); }
        if absb == 1.0 { return zjs_double(nan); }
    }
    return zjs_double(Math::pow(base, exp));
}

fn host_math_max(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §21.3.2.24: empty args → -Infinity. NaN propagates.
    // +0 ranks above -0 — observable via 1 / Math.max(-0, 0) === Infinity.
    if argc == 0 {
        let neg_inf: f64 = 0.0;
        raw { neg_inf = -INFINITY; }
        return zjs_double(neg_inf);
    }
    let i: u32 = 0;
    let any_nan: int = 0;
    let saw_pos_zero: int = 0;
    let best: f64 = 0.0;
    raw { best = -INFINITY; }
    while i < argc {
        let d = zjs_to_double(args[i]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let is_nan: int = 0;
        raw { is_nan = isnan(d) ? 1 : 0; }
        if is_nan != 0 { any_nan = 1; }
        else {
            if d == 0.0 {
                let bits: u64 = 0;
                raw { bits = *(uint64_t*)&d; }
                if (bits & 0x8000000000000000) == 0 { saw_pos_zero = 1; }
            }
            if d > best { best = d; }
        }
        i = i + 1;
    }
    if any_nan != 0 {
        let nv: f64 = 0.0;
        raw { nv = NAN; }
        return zjs_double(nv);
    }
    // Promote -0 result to +0 when any +0 was passed.
    if best == 0.0 && saw_pos_zero != 0 { return zjs_double(0.0); }
    return zjs_double(best);
}

fn host_math_min(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let inf: f64 = 0.0;
        raw { inf = INFINITY; }
        return zjs_double(inf);
    }
    let i: u32 = 0;
    let any_nan: int = 0;
    let saw_neg_zero: int = 0;
    let best: f64 = 0.0;
    raw { best = INFINITY; }
    while i < argc {
        let d = zjs_to_double(args[i]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let is_nan: int = 0;
        raw { is_nan = isnan(d) ? 1 : 0; }
        if is_nan != 0 { any_nan = 1; }
        else {
            if d == 0.0 {
                let bits: u64 = 0;
                raw { bits = *(uint64_t*)&d; }
                if (bits & 0x8000000000000000) != 0 { saw_neg_zero = 1; }
            }
            if d < best { best = d; }
        }
        i = i + 1;
    }
    if any_nan != 0 {
        let nv: f64 = 0.0;
        raw { nv = NAN; }
        return zjs_double(nv);
    }
    if best == 0.0 && saw_neg_zero != 0 {
        let nz: f64 = 0.0;
        raw { nz = -0.0; }
        return zjs_double(nz);
    }
    return zjs_double(best);
}

