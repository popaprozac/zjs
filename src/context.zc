    object_set(ctx, ctx.temporal_plaintime_proto, ctx_intern_atom(ctx, (char*)"subtract", 8),
               ctx_make_host_function(ctx, (char*)"subtract", ptsub_ptr));
    let ptrnd_ptr: void* = NULL; raw { ptrnd_ptr = (void*)host_temporal_plaintime_round; }
    object_set(ctx, ctx.temporal_plaintime_proto, ctx_intern_atom(ctx, (char*)"round", 5),
