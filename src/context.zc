// --- Temporal.ZonedDateTime (T5) ---
// Stored as epoch_ns (BigInt) + timezone (interned id string) +
// calendar. Wall-clock fields are derived on demand by applying the
// zone's UTC offset at that instant.

// Decompose a ZonedDateTime into local wall-clock fields. out[0..6] =
// year, month, day, hour, minute, second; out[7] = sub-second ns;
// off_secs[0] = the UTC offset (seconds, east-positive) in effect.
fn zdt_decompose(t: ZjsTemporal*, out: i64*, off_secs: i64*) -> void {
    let ns: i64 = if zjs_is_bigint(t.epoch_ns) != 0 { bigint_to_i64(zjs_as_bigint(t.epoch_ns)) } else { 0 };
    let secs = i64_floordiv(ns, 1000000000);
    let sub = i64_floormod(ns, 1000000000);
    let tzdata: char* = NULL;
    if t.timezone != NULL { tzdata = t.timezone.data; }
    let off: i64 = 0;
    raw {
        int ok = 1;
        off = (int64_t)zjs_tz_offset_seconds(tzdata, (time_t)secs, &ok);
    }
    let local = secs + off;
    raw {
        time_t lt = (time_t)local;
        struct tm tm_l;
        zjs_gmtime_r(&lt, &tm_l);   /* local broken-down via UTC of shifted secs */
        out[0] = tm_l.tm_year + 1900;
        out[1] = tm_l.tm_mon + 1;
        out[2] = tm_l.tm_mday;
        out[3] = tm_l.tm_hour;
        out[4] = tm_l.tm_min;
        out[5] = tm_l.tm_sec;
    }
    out[6] = sub;
    off_secs[0] = off;
}

// Format a UTC offset (seconds) as "+HH:MM" / "-HH:MM" into buf.
fn temporal_format_offset(off_secs: i64, buf: char*, cap: usize) -> void {
    raw {
        long o = (long)off_secs;
        char sign = o < 0 ? '-' : '+';
        if (o < 0) o = -o;
        int hh = (int)(o / 3600);
        int mm = (int)((o % 3600) / 60);
        snprintf(buf, cap, "%c%02d:%02d", sign, hh, mm);
    }
}

fn host_temporal_zoneddatetime_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
