    object_set(ctx, strv_hf.prototype, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));
    let referr_v = ctx_register_host_function(ctx, (char*)"ReferenceError", referr_ptr);
    let typerr_v = ctx_register_host_function(ctx, (char*)"TypeError",      typerr_ptr);
    let rngerr_v = ctx_register_host_function(ctx, (char*)"RangeError",     rngerr_ptr);

    // Chain *Error.prototype → Error.prototype so `new TypeError instanceof Error` etc.
    // Lazily create each prototype, then set its proto.
    let err_slot = ctx_find_global(ctx, (char*)"Error", 5);
    if err_slot >= 0 {
        let err_v = ctx.globals[err_slot].value;
        if zjs_is_host_function(err_v) != 0 {
            let err_hf = zjs_as_host_function(err_v);
            if err_hf.prototype == NULL {
                let p_v = ctx_new_object(ctx);
                err_hf.prototype = zjs_as_object(p_v);
            }
            let err_proto = err_hf.prototype;
            // Error.prototype.constructor / .toString.
            object_set(ctx, err_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), err_v);
            let ets_ptr: void* = NULL; raw { ets_ptr = (void*)host_error_to_string; }
            object_set(ctx, err_proto, ctx_intern_atom(ctx, (char*)"toString", 8),
                       ctx_make_host_function(ctx, (char*)"toString", ets_ptr));
            // Subclass each *Error.prototype to inherit from Error.prototype,
            // AND set [[Prototype]] = Error so `Object.getPrototypeOf(TypeError)
            // === Error` per spec.
            let subs: ZjsValue[3];
            subs[0] = referr_v; subs[1] = typerr_v; subs[2] = rngerr_v;
            let i: u32 = 0;
            while i < 3 {
                let hv = subs[i];
                if zjs_is_host_function(hv) != 0 {
                    let hf = zjs_as_host_function(hv);
                    if hf.prototype == NULL {
                        let pp_v = ctx_new_object(ctx);
                        hf.prototype = zjs_as_object(pp_v);
                    }
                    hf.prototype.proto = err_proto;
                    hf.proto_override = err_v;
                }
                i = i + 1;
            }
        }
    }
    ctx_register_host_function(ctx, (char*)"eval",           eval_ptr);

    // Stub globals for unsupported features. Their tests use the
    // names without expecting full semantics — registering them as
    // host-function no-ops at least avoids ReferenceError-on-load.
    // Function constructor: runtime-compile the body string into a
    // real callable, with [[Prototype]] = Function.prototype so
    // `Object.getPrototypeOf(<any callable>) === Function.prototype`.
    let fn_ctor_ptr: void* = NULL; raw { fn_ctor_ptr = (void*)host_function_ctor; }
    let function_ctor_v = ctx_register_host_function(ctx, (char*)"Function", fn_ctor_ptr);
    let function_ctor_hf = zjs_as_host_function(function_ctor_v);
    function_ctor_hf.prototype = ctx.function_proto;
    if ctx.function_proto != NULL {
