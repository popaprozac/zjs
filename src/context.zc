    let akeys_ptr:  void* = NULL; raw { akeys_ptr  = (void*)host_array_keys; }
    let avals_ptr:  void* = NULL; raw { avals_ptr  = (void*)host_array_values; }
    let aents_ptr:  void* = NULL; raw { aents_ptr  = (void*)host_array_entries; }
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"keys", 4),
               ctx_make_host_function_arity(ctx, (char*)"keys", akeys_ptr, 0));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"values", 6),
               ctx_make_host_function_arity(ctx, (char*)"values", avals_ptr, 0));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"entries", 7),
               ctx_make_host_function_arity(ctx, (char*)"entries", aents_ptr, 0));
