    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"asin",   4),  ctx_make_host_function_arity(ctx, (char*)"asin",   asin_ptr,   1));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"acos",   4),  ctx_make_host_function_arity(ctx, (char*)"acos",   acos_ptr,   1));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"atan",   4),  ctx_make_host_function_arity(ctx, (char*)"atan",   atan_ptr,   1));
