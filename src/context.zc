// Engine context — Phase 3.0a.
//
// One context = one isolated JS world. Holds the global variable table
// and (later) the heap + GC + symbol table. Globals are referenced by
// integer slot index in compiled bytecode; the compiler and the runtime
// share the same context so slot indices match up by construction.

import "stdlib.h" as libc;
import "string.h" as libc_str;
import "./value.zc";

raw {
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
}

struct GlobalEntry {
    name:     char*;    // owned (calloc'd, copied from source); freed on ctx free
    name_len: u32;
    value:    ZjsValue;
    // Phase 3.8c: true once a definition (var/let/const/function/class/
    // host registration) has populated `value`. LoadGlobal throws
    // ReferenceError if false; `typeof` uses a separate opcode that
    // returns "undefined" without throwing.
    defined:  bool;
}

struct GcRootFrame {
    regs:      ZjsValue*;
    reg_count: u32;
}

// Phase 3.9h scaffolding. Each CallFrame owns a slice of reg_stack
// laid out as [args | regs]: args[0..argc] then regs[0..reg_count].
// Storing args separately (rather than just copying into regs[0..]) so
// `arguments[k]` for k >= param_count still works when more args are
// passed than declared.
struct CallFrame {
    f:                      Function*;
    ip:                     usize;
    args_base:              u32;   // offset into ctx.reg_stack
    argc:                   u32;   // how many slots at args_base hold passed args
    regs_base:              u32;   // = args_base + argc
    reg_count:              u32;
    return_dst:             u8;
    saved_host_this:        ZjsValue;
    saved_current_closure:  ZjsClosure*;
    try_depth_at_entry:     u32;
}

// Phase 3.9h. Shared across all CallFrames once the migration lands —
// each TryFrame carries the frame_index it lives in so unwinding can
// pop above it without per-frame try arrays.
struct CtxTryFrame {
    frame_index: u32;
    catch_ip:    usize;
    catch_reg:   u8;
}

def CTX_MAX_TRY_DEPTH:  u32 = 256;
def CTX_INVOKE_ARG_CAP: u32 = 256;   // matches u8 argc range

// Open-addressed hash-table entry. NULL `str` = empty slot.
// We never delete atoms, so no tombstones needed.
struct AtomEntry {
    str:  ZjsString*;
    hash: u32;
}

struct ZjsContext {
    // Root empty hidden class — every fresh {} starts here.
    empty_class:    ZjsHiddenClass*;

    globals:        GlobalEntry*;
    global_count:   u32;
    global_cap:     u32;

    // All heap-allocated cells owned by the context (Functions,
    // Strings, Objects, Arrays, HostFunctions). Each cell starts with
    // a CellHeader whose type_tag drives the free dispatch. The mark
    // bit drives GC reachability.
    cells:          void**;
    cell_count:     u32;
    cell_cap:       u32;

    // Set by zjs_eval when the program ends with an uncaught throw.
    // Public ABI: zjs_had_error / zjs_get_error.
    had_error:      bool;
    last_error:     ZjsValue;

    // Currently-executing closure (Phase 3.3). Push/pop'd by Invoke;
    // LoadEnv reads ctx.current_closure.env.
    current_closure: ZjsClosure*;

    // Implicit `this` for the currently-running host function (Phase 3.5).
    // Set by Op::MethodInvoke before dispatch and restored after. Host
    // builtins like Array.prototype.push read it via zjs_get_host_this().
    host_this: ZjsValue;

    // Cached "prototype" objects for built-in cell types (Phase 3.5).
    // Lazily populated by ctx_init_builtins. property_get on TAG_ARRAY
    // falls back to array_proto for unrecognized method names; same for
    // TAG_STRING / string_proto. Phase 3.6 will replace this with a real
    // hidden-class-driven proto chain.
    array_proto:    ZjsObject*;
    string_proto:   ZjsObject*;
    // Phase 3.8c — the default proto for every {} created via
    // ctx_new_object. Carries hasOwnProperty + toString.
    object_proto:   ZjsObject*;

    // Phase 3.8d — cached Function.prototype.{call, apply} host
    // helpers. property_get on Function/Closure/HostFunction returns
    // these when key == "call" / "apply" so f.call(thisArg, ...) works.
    fn_call_v:      ZjsValue;
    fn_apply_v:     ZjsValue;

    // Phase 3.5b — temp-root stack. Host functions that invoke JS
    // callbacks (Array.prototype.map / forEach) need to keep
    // intermediate ZjsValues alive across the inner interpret() call,
    // which may trigger GC. Use ctx_push_temp_root / ctx_pop_temp_root.
    temp_roots:      ZjsValue*;
    temp_root_count: u32;
    temp_root_cap:   u32;

    // --- GC state ---
    root_frames:    GcRootFrame*;     // grown geometrically
    root_depth:     u32;              // # of active interpret() frames
    root_cap:       u32;
    cells_since_gc: u32;              // allocations since last collection
    gc_threshold:   u32;              // run GC when cells_since_gc >= this

    // --- Phase 3.9h scaffolding (unused until interpret() converts) ---
    // Single contiguous register stack; CallFrames take slices.
    reg_stack:        ZjsValue*;
    reg_stack_top:    u32;
    reg_stack_cap:    u32;

    frames:           CallFrame*;
    frame_count:      u32;
    frame_cap:        u32;

    // Shared try stack (replaces per-frame TryFrame[32] once migration
    // lands). Sized once at first use up to CTX_MAX_TRY_DEPTH.
    ctx_try_stack:    CtxTryFrame*;
    ctx_try_depth:    u32;
    ctx_try_cap:      u32;

    // Scratch buffer for arg-copy on Op::Invoke. The interpreter copies
    // args from the caller's regs into this buffer BEFORE calling
    // push_call_frame (which may realloc reg_stack and invalidate
    // caller-reg pointers). Reused across Invokes — overwritten each
    // call. Lazily sized to CTX_INVOKE_ARG_CAP at first use.
    invoke_arg_buffer:     ZjsValue*;
    invoke_arg_buffer_cap: u32;

    // --- Atom table (interned strings) ---
    // Open-addressed hash table, power-of-2 capacity. Used for
    // property names + source-code string literals. Atoms are GC
    // roots so they live for the context's lifetime; that's fine for
    // names/literals that are inherently shared.
    atoms:          AtomEntry*;
    atom_count:     u32;
    atom_cap:       u32;
}

fn zjs_new_context() -> ZjsContext* {
    let result: ZjsContext* = NULL;
    raw {
        result = (ZjsContext*)calloc(1, sizeof(ZjsContext));
    }
    if result != NULL {
        // GC initial threshold: collect after the first 4096 cell allocations,
        // then adapt to 2× live count after each collection.
        result.gc_threshold = 4096;
        // calloc gave us {bits: 0}; explicitly initialize the implicit
        // host receiver to JS `undefined`.
        result.host_this = zjs_undefined();

        // Root empty class — registered as a cell, kept alive via the
        // context pointer itself (we mark it during gc_mark_roots).
        let empty = zjs_hidden_class_new(NULL, NULL, 0, 0);
        ctx_register_cell(result, (void*)empty);
        result.empty_class = empty;

        ctx_init_builtins(result);
    }
    return result;
}

fn zjs_free_context(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    let root_frames = ctx.root_frames;
    raw { free(root_frames); }
    let atoms = ctx.atoms;
    raw { free(atoms); }
    // Free every interned global name.
    let i: u32 = 0;
    while i < ctx.global_count {
        let name_ptr = ctx.globals[i].name;
        raw { free(name_ptr); }
        i = i + 1;
    }
    let globals = ctx.globals;
    raw { free(globals); }

    // Free every heap cell, dispatched by its type tag.
    let j: u32 = 0;
    while j < ctx.cell_count {
        let cp = ctx.cells[j];
        let tag: u8 = 0;
        raw { tag = ((CellHeader*)cp)->type_tag; }
        if tag == TAG_FUNCTION {
            raw {
                extern void function_free_void(void* f);
                function_free_void(cp);
            }
        } else if tag == TAG_STRING {
            string_free_void(cp);
        } else if tag == TAG_OBJECT {
            object_free_void(cp);
        } else if tag == TAG_ARRAY {
            array_free_void(cp);
        } else if tag == TAG_HOST_FUNCTION {
            host_function_free_void(cp);
        } else if tag == TAG_HIDDEN_CLASS {
            hidden_class_free_void(cp);
        } else if tag == TAG_CLOSURE {
            closure_free_void(cp);
        } else if tag == TAG_ACCESSOR {
            accessor_free_void(cp);
        }
        j = j + 1;
    }
    let cells = ctx.cells;
    let temp_roots = ctx.temp_roots;
    let reg_stack = ctx.reg_stack;
    let frames = ctx.frames;
    let ctx_try_stack = ctx.ctx_try_stack;
    let invoke_arg_buffer = ctx.invoke_arg_buffer;
    raw {
        free(cells);
        free(temp_roots);
        free(reg_stack);
        free(frames);
        free(ctx_try_stack);
        free(invoke_arg_buffer);
        free(ctx);
    }
}

// Push a value as a transient GC root. Used by host functions that
// allocate then invoke a JS callback — the inner interpret() may run
// GC, and the C-stack ZjsValue isn't otherwise visible. Pair with
// ctx_pop_temp_root.
fn ctx_push_temp_root(ctx: ZjsContext*, v: ZjsValue) -> void {
    if ctx.temp_root_count >= ctx.temp_root_cap {
        let new_cap: u32 = if ctx.temp_root_cap == 0 { 8 } else { ctx.temp_root_cap * 2 };
        let old = ctx.temp_roots;
        let new_arr: ZjsValue* = NULL;
        raw { new_arr = (ZjsValue*)realloc(old, new_cap * sizeof(ZjsValue)); }
        ctx.temp_roots = new_arr;
        ctx.temp_root_cap = new_cap;
    }
    ctx.temp_roots[ctx.temp_root_count] = v;
    ctx.temp_root_count = ctx.temp_root_count + 1;
}

fn ctx_pop_temp_root(ctx: ZjsContext*) -> void {
    if ctx.temp_root_count > 0 {
        ctx.temp_root_count = ctx.temp_root_count - 1;
    }
}

// Overwrite the top temp_root slot in place. Pairs cleanly with
// `push + defer pop` for code that loops, allocating a fresh value
// each iteration that supersedes the previous one (string concat,
// array join, etc.).
fn ctx_replace_top_temp_root(ctx: ZjsContext*, v: ZjsValue) -> void {
    if ctx.temp_root_count > 0 {
        ctx.temp_roots[ctx.temp_root_count - 1] = v;
    }
}

// Append a heap cell to the context's owned-cells list. Called whenever
// a new Function / String / etc. is allocated by the compiler or
// interpreter.
fn ctx_register_cell(ctx: ZjsContext*, p: void*) -> void {
    if ctx.cell_count >= ctx.cell_cap {
        let new_cap: u32 = if ctx.cell_cap == 0 { 16 } else { ctx.cell_cap * 2 };
        let old = ctx.cells;
        let new_arr: void** = NULL;
        raw { new_arr = (void**)realloc(old, new_cap * sizeof(void*)); }
        ctx.cells = new_arr;
        ctx.cell_cap = new_cap;
    }
    ctx.cells[ctx.cell_count] = p;
    ctx.cell_count = ctx.cell_count + 1;
    ctx.cells_since_gc = ctx.cells_since_gc + 1;
}

// =====================================================================
// GC — mark-sweep, run between interpreter instructions.
// =====================================================================

fn ctx_push_root_frame(ctx: ZjsContext*, regs: ZjsValue*, reg_count: u32) -> void {
    if ctx.root_depth >= ctx.root_cap {
        let new_cap: u32 = if ctx.root_cap == 0 { 16 } else { ctx.root_cap * 2 };
        let old = ctx.root_frames;
        let new_arr: GcRootFrame* = NULL;
        raw { new_arr = (GcRootFrame*)realloc(old, new_cap * sizeof(GcRootFrame)); }
        ctx.root_frames = new_arr;
        ctx.root_cap = new_cap;
    }
    ctx.root_frames[ctx.root_depth].regs = regs;
    ctx.root_frames[ctx.root_depth].reg_count = reg_count;
    ctx.root_depth = ctx.root_depth + 1;
}

fn ctx_pop_root_frame(ctx: ZjsContext*) -> void {
    if ctx.root_depth > 0 { ctx.root_depth = ctx.root_depth - 1; }
}

// =====================================================================
// Phase 3.9h — non-recursive interpreter scaffolding.
//
// These helpers manage the explicit CallFrame stack + shared register
// stack that the next phase will use. They're correct and tested via
// build coverage now, but not yet wired into interpret() — that swap
// is Phase B. Keeping the scaffolding under its own dead-code path
// means we can land it as a no-behavior-change commit and bisect cleanly.
// =====================================================================

// Reserve room for `n` more ZjsValue slots on the register stack and
// return the base offset. Grows the stack geometrically. Caller is
// responsible for initializing the reserved slots (to undefined, or
// to actual arg values).
fn reg_stack_reserve(ctx: ZjsContext*, n: u32) -> u32 {
    let needed: u32 = ctx.reg_stack_top + n;
    if needed > ctx.reg_stack_cap {
        let new_cap: u32 = if ctx.reg_stack_cap == 0 { 256 } else { ctx.reg_stack_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        let old = ctx.reg_stack;
        let new_arr: ZjsValue* = NULL;
        raw { new_arr = (ZjsValue*)realloc(old, new_cap * sizeof(ZjsValue)); }
        ctx.reg_stack = new_arr;
        ctx.reg_stack_cap = new_cap;
    }
    let base = ctx.reg_stack_top;
    ctx.reg_stack_top = needed;
    return base;
}

// Release the top `n` slots from the register stack.
fn reg_stack_release(ctx: ZjsContext*, n: u32) -> void {
    if n > ctx.reg_stack_top {
        ctx.reg_stack_top = 0;
    } else {
        ctx.reg_stack_top = ctx.reg_stack_top - n;
    }
}

// Push a CallFrame for `f`. Reserves `argc + f.register_count` slots
// on the register stack: args_base[0..argc] holds the full passed-args
// list (for `arguments`), regs_base[0..register_count] is the function's
// register window. The first min(argc, param_count) args are also
// copied into regs[0..param_count]; remaining regs init to undefined
// (load-bearing — GC walks the whole window).
fn push_call_frame(ctx: ZjsContext*, f: Function*, args: ZjsValue*, argc: u32, ret_dst: u8) -> u32 {
    if ctx.frame_count >= ctx.frame_cap {
        let new_cap: u32 = if ctx.frame_cap == 0 { 64 } else { ctx.frame_cap * 2 };
        let old = ctx.frames;
        let new_arr: CallFrame* = NULL;
        raw { new_arr = (CallFrame*)realloc(old, new_cap * sizeof(CallFrame)); }
        ctx.frames = new_arr;
        ctx.frame_cap = new_cap;
    }
    let reg_count: u32 = f.register_count;
    let total: u32 = argc + reg_count;
    let args_base = reg_stack_reserve(ctx, total);
    let regs_base = args_base + argc;

    // Copy the FULL passed args list into the args slot.
    let a: u32 = 0;
    while a < argc {
        ctx.reg_stack[args_base + a] = args[a];
        a = a + 1;
    }

    // Copy the first min(argc, param_count) args into regs[0..]; init
    // remaining regs to undefined.
    let copy_count: u32 = if argc < f.param_count { argc } else { f.param_count };
    let i: u32 = 0;
    while i < copy_count {
        ctx.reg_stack[regs_base + i] = args[i];
        i = i + 1;
    }
    let undef: ZjsValue = zjs_undefined();
    let j: u32 = i;
    while j < reg_count {
        ctx.reg_stack[regs_base + j] = undef;
        j = j + 1;
    }

    let idx = ctx.frame_count;
    ctx.frames[idx].f = f;
    ctx.frames[idx].ip = 0;
    ctx.frames[idx].args_base = args_base;
    ctx.frames[idx].argc = argc;
    ctx.frames[idx].regs_base = regs_base;
    ctx.frames[idx].reg_count = reg_count;
    ctx.frames[idx].return_dst = ret_dst;
    ctx.frames[idx].saved_host_this = ctx.host_this;
    ctx.frames[idx].saved_current_closure = ctx.current_closure;
    ctx.frames[idx].try_depth_at_entry = ctx.ctx_try_depth;
    ctx.frame_count = ctx.frame_count + 1;
    return idx;
}

// Pop the top CallFrame. Restores ctx.host_this and ctx.current_closure
// from the popped frame's saved_* fields, and shrinks the register
// stack by the frame's reg_count. Pops any try-frames the frame owned.
// Returns the popped frame's return_dst (so the caller can write the
// return value into its own regs).
fn pop_call_frame(ctx: ZjsContext*) -> u8 {
    if ctx.frame_count == 0 { return 0; }
    let idx = ctx.frame_count - 1;
    let ret_dst = ctx.frames[idx].return_dst;
    let total = ctx.frames[idx].argc + ctx.frames[idx].reg_count;
    let saved_this = ctx.frames[idx].saved_host_this;
    let saved_cl   = ctx.frames[idx].saved_current_closure;
    let try_at_entry = ctx.frames[idx].try_depth_at_entry;

    ctx.host_this = saved_this;
    ctx.current_closure = saved_cl;
    if ctx.ctx_try_depth > try_at_entry {
        ctx.ctx_try_depth = try_at_entry;
    }
    reg_stack_release(ctx, total);
    ctx.frame_count = idx;
    return ret_dst;
}

// Pop frames until frame_count == target. Used on throw unwinding and
// when interpret() returns to its entry depth.
fn pop_call_frames_to(ctx: ZjsContext*, target: u32) -> void {
    while ctx.frame_count > target {
        pop_call_frame(ctx);
    }
}

// Phase 3.9h-C — replace the top CallFrame in-place with a tail call.
// The new function returns DIRECTLY to the original caller (we
// preserve return_dst / saved_host_this / saved_current_closure /
// try_depth_at_entry from the outgoing frame). Releases the old
// frame's reg_stack slots and reserves the new function's window.
fn tail_call_frame(ctx: ZjsContext*, f: Function*, args: ZjsValue*, argc: u32) -> void {
    if ctx.frame_count == 0 { return; }
    let idx = ctx.frame_count - 1;
    let old_total: u32 = ctx.frames[idx].argc + ctx.frames[idx].reg_count;
    reg_stack_release(ctx, old_total);

    let reg_count: u32 = f.register_count;
    let new_total: u32 = argc + reg_count;
    let args_base = reg_stack_reserve(ctx, new_total);
    let regs_base = args_base + argc;

    let a: u32 = 0;
    while a < argc {
        ctx.reg_stack[args_base + a] = args[a];
        a = a + 1;
    }
    let copy_count: u32 = if argc < f.param_count { argc } else { f.param_count };
    let i: u32 = 0;
    while i < copy_count {
        ctx.reg_stack[regs_base + i] = args[i];
        i = i + 1;
    }
    let undef: ZjsValue = zjs_undefined();
    let j: u32 = i;
    while j < reg_count {
        ctx.reg_stack[regs_base + j] = undef;
        j = j + 1;
    }

    ctx.frames[idx].f = f;
    ctx.frames[idx].ip = 0;
    ctx.frames[idx].args_base = args_base;
    ctx.frames[idx].argc = argc;
    ctx.frames[idx].regs_base = regs_base;
    ctx.frames[idx].reg_count = reg_count;
    // return_dst, saved_host_this, saved_current_closure,
    // try_depth_at_entry: unchanged — inherited from the outgoing frame.
}

// Push a try frame on the shared context try stack. Lazily allocates.
fn ctx_try_push(ctx: ZjsContext*, catch_ip: usize, catch_reg: u8) -> bool {
    if ctx.ctx_try_depth >= CTX_MAX_TRY_DEPTH { return false; }
    if ctx.ctx_try_stack == NULL {
        let new_arr: CtxTryFrame* = NULL;
        raw { new_arr = (CtxTryFrame*)calloc(CTX_MAX_TRY_DEPTH, sizeof(CtxTryFrame)); }
        ctx.ctx_try_stack = new_arr;
        ctx.ctx_try_cap = CTX_MAX_TRY_DEPTH;
    }
    let i = ctx.ctx_try_depth;
    let cur_frame = if ctx.frame_count > 0 { ctx.frame_count - 1 } else { 0 };
    ctx.ctx_try_stack[i].frame_index = cur_frame;
    ctx.ctx_try_stack[i].catch_ip = catch_ip;
    ctx.ctx_try_stack[i].catch_reg = catch_reg;
    ctx.ctx_try_depth = ctx.ctx_try_depth + 1;
    return true;
}

fn ctx_try_pop(ctx: ZjsContext*) -> void {
    if ctx.ctx_try_depth > 0 {
        ctx.ctx_try_depth = ctx.ctx_try_depth - 1;
    }
}

// Mark a single value's reachable graph. Idempotent — already-marked
// cells return immediately, breaking cycles.
fn gc_mark_value(v: ZjsValue) -> void {
    if zjs_is_cell(v) == 0 { return; }
    let p = zjs_cell_as_ptr(v);
    if p == NULL { return; }
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)p; }
    if h.mark != 0 { return; }
    h.mark = 1;

    let tag = h.type_tag;
    if tag == TAG_STRING { return; }            // leaf

    if tag == TAG_HOST_FUNCTION {
        // Phase 3.6: host functions can carry a .prototype.
        // Phase 3.8c: and arbitrary properties via .props.
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)p; }
        if hf.prototype != NULL {
            let pv = zjs_cell_from_ptr((void*)hf.prototype);
            gc_mark_value(pv);
        }
        if hf.props != NULL {
            let pv = zjs_cell_from_ptr((void*)hf.props);
            gc_mark_value(pv);
        }
        return;
    }

    if tag == TAG_OBJECT {
        let o: ZjsObject* = NULL;
        raw { o = (ZjsObject*)p; }
        // Mark the object's class — its parent chain + transition map
        // are walked transitively.
        gc_mark_hidden_class(o.cls);
        // Mark all live slots.
        let live = if o.cls != NULL { o.cls.prop_count } else { 0 };
        let i: u32 = 0;
        while i < live {
            gc_mark_value(o.slots[i]);
            i = i + 1;
        }
        // Phase 3.6: walk the proto chain so inherited values stay alive.
        if o.proto != NULL {
            let pv = zjs_cell_from_ptr((void*)o.proto);
            gc_mark_value(pv);
        }
        return;
    }

    if tag == TAG_HIDDEN_CLASS {
        let c: ZjsHiddenClass* = NULL;
        raw { c = (ZjsHiddenClass*)p; }
        gc_mark_hidden_class(c);
        return;
    }

    if tag == TAG_CLOSURE {
        let cl: ZjsClosure* = NULL;
        raw { cl = (ZjsClosure*)p; }
        // Mark the function template — wraps a Function* cell.
        if cl.function != NULL {
            let fn_val = zjs_cell_from_ptr(cl.function);
            gc_mark_value(fn_val);
        }
        // Mark the captured env object — walks its slots transitively
        // (each captured local is reachable through env).
        if cl.env != NULL {
            let env_val = zjs_cell_from_ptr((void*)cl.env);
            gc_mark_value(env_val);
        }
        return;
    }

    if tag == TAG_ACCESSOR {
        let a: ZjsAccessor* = NULL;
        raw { a = (ZjsAccessor*)p; }
        gc_mark_value(a.get);
        gc_mark_value(a.set);
        return;
    }

    if tag == TAG_ARRAY {
        let a: ZjsArray* = NULL;
        raw { a = (ZjsArray*)p; }
        let i: u32 = 0;
        while i < a.length {
            gc_mark_value(a.elements[i]);
            i = i + 1;
        }
        return;
    }

    if tag == TAG_FUNCTION {
        let f: Function* = NULL;
        raw { f = (Function*)p; }
        let i: u32 = 0;
        while i < f.const_count {
            gc_mark_value(f.constants[i]);
            i = i + 1;
        }
        // Phase 3.8 note: inline-cache entries used to mark ic.class_
        // strongly, which leaked hidden classes for objects long since
        // dead. The class_ pointer is now a WEAK ref — see
        // gc_nullify_dead_ics() between mark and sweep. The atom names
        // are pinned via the atom-table root, so we don't re-mark them.
        // Phase 3.6: .prototype.
        if f.prototype != NULL {
            let pv = zjs_cell_from_ptr((void*)f.prototype);
            gc_mark_value(pv);
        }
        return;
    }
}

// After the mark phase but before sweep, walk all live Functions'
// inline caches and null out entries whose cached HiddenClass wasn't
// independently marked alive. Without this pass, the IC keeps long-dead
// classes pinned and we slow-leak shape memory in long-running programs.
fn gc_nullify_dead_ics(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    while i < ctx.cell_count {
        let p = ctx.cells[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 && h.type_tag == TAG_FUNCTION {
            let f: Function* = NULL;
            raw { f = (Function*)p; }
            let j: u32 = 0;
            while j < f.ic_count {
                // Compact: nuke dead-class entries, slide live ones down.
                // The order doesn't matter for correctness (we linearly
                // probe), only for cache locality — leading slots stay hot.
                let write_k: u32 = 0;
                let read_k:  u32 = 0;
                let count = (u32)f.ics[j].entry_count;
                while read_k < count {
                    let cls: ZjsHiddenClass* = f.ics[j].classes[read_k];
                    if cls != NULL && cls.header.mark != 0 {
                        if write_k != read_k {
                            f.ics[j].classes[write_k] = cls;
                            f.ics[j].slots[write_k] = f.ics[j].slots[read_k];
                        }
                        write_k = write_k + 1;
                    }
                    read_k = read_k + 1;
                }
                // Zero out the freed tail.
                let zk: u32 = write_k;
                while zk < count {
                    f.ics[j].classes[zk] = NULL;
                    f.ics[j].slots[zk] = 0;
                    zk = zk + 1;
                }
                f.ics[j].entry_count = (u8)write_k;
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// Mark a hidden class transitively: parent (chain back to root) and
// every child transition. Idempotent.
fn gc_mark_hidden_class(c: ZjsHiddenClass*) -> void {
    if c == NULL { return; }
    if c.header.mark != 0 { return; }
    c.header.mark = 1;
    // Names are atoms; they're already pinned via the atom-table root.
    if c.parent != NULL { gc_mark_hidden_class(c.parent); }
    let i: u32 = 0;
    while i < c.trans_count {
        gc_mark_hidden_class(c.trans_children[i]);
        i = i + 1;
    }
}

fn gc_mark_roots(ctx: ZjsContext*) -> void {
    // Root empty class
    if ctx.empty_class != NULL {
        gc_mark_hidden_class(ctx.empty_class);
    }
    // Current closure — its env must survive the GC even if it isn't
    // otherwise reachable (e.g., a closure mid-call with no caller-side ref).
    if ctx.current_closure != NULL {
        let cur_val = zjs_cell_from_ptr((void*)ctx.current_closure);
        gc_mark_value(cur_val);
    }
    // Implicit host receiver for the in-flight host call.
    gc_mark_value(ctx.host_this);
    // Built-in prototype objects (kept alive across the whole context).
    if ctx.array_proto != NULL {
        let ap_val = zjs_cell_from_ptr((void*)ctx.array_proto);
        gc_mark_value(ap_val);
    }
    if ctx.string_proto != NULL {
        let sp_val = zjs_cell_from_ptr((void*)ctx.string_proto);
        gc_mark_value(sp_val);
    }
    if ctx.object_proto != NULL {
        let op_val = zjs_cell_from_ptr((void*)ctx.object_proto);
        gc_mark_value(op_val);
    }
    // Phase 3.8d cached helpers
    gc_mark_value(ctx.fn_call_v);
    gc_mark_value(ctx.fn_apply_v);
    // Phase 3.5b temp roots
    let t: u32 = 0;
    while t < ctx.temp_root_count {
        gc_mark_value(ctx.temp_roots[t]);
        t = t + 1;
    }
    // Globals
    let i: u32 = 0;
    while i < ctx.global_count {
        gc_mark_value(ctx.globals[i].value);
        i = i + 1;
    }
    // Last uncaught error (so the C consumer can still inspect it)
    gc_mark_value(ctx.last_error);
    // Each active call frame (current recursive model)
    let j: u32 = 0;
    while j < ctx.root_depth {
        let frame = ctx.root_frames[j];
        let k: u32 = 0;
        while k < frame.reg_count {
            gc_mark_value(frame.regs[k]);
            k = k + 1;
        }
        j = j + 1;
    }
    // Phase 3.9h: shared reg_stack + per-frame saved host_this /
    // current_closure. Covers everything any active CallFrame might
    // reference (args + regs are contiguous on reg_stack).
    let r: u32 = 0;
    while r < ctx.reg_stack_top {
        gc_mark_value(ctx.reg_stack[r]);
        r = r + 1;
    }
    let fi: u32 = 0;
    while fi < ctx.frame_count {
        gc_mark_value(ctx.frames[fi].saved_host_this);
        if ctx.frames[fi].saved_current_closure != NULL {
            let cv = zjs_cell_from_ptr((void*)ctx.frames[fi].saved_current_closure);
            gc_mark_value(cv);
        }
        fi = fi + 1;
    }
    // Interned atoms — they live for the context's lifetime.
    let a: u32 = 0;
    while a < ctx.atom_cap {
        let s = ctx.atoms[a].str;
        if s != NULL { s.header.mark = 1; }
        a = a + 1;
    }
}

fn gc_sweep(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    let kept: u32 = 0;
    while i < ctx.cell_count {
        let p = ctx.cells[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 {
            h.mark = 0;
            ctx.cells[kept] = p;
            kept = kept + 1;
        } else {
            let tag = h.type_tag;
            if tag == TAG_FUNCTION      {
                raw { extern void function_free_void(void* f); function_free_void(p); }
            } else if tag == TAG_STRING        { string_free_void(p); }
              else if tag == TAG_OBJECT        { object_free_void(p); }
              else if tag == TAG_ARRAY         { array_free_void(p); }
              else if tag == TAG_HOST_FUNCTION { host_function_free_void(p); }
              else if tag == TAG_CLOSURE       { closure_free_void(p); }
              else if tag == TAG_ACCESSOR      { accessor_free_void(p); }
        }
        i = i + 1;
    }
    ctx.cell_count = kept;
}

fn gc_run(ctx: ZjsContext*) -> void {
    gc_mark_roots(ctx);
    gc_nullify_dead_ics(ctx);
    gc_sweep(ctx);
    ctx.cells_since_gc = 0;
    // Adapt threshold to grow with the live set; minimum floor of 256.
    let target: u32 = ctx.cell_count * 2;
    if target < 256 { target = 256; }
    ctx.gc_threshold = target;
}

fn ctx_maybe_gc(ctx: ZjsContext*) -> void {
    if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
}

// --- Public ABI -----------------------------------------------------

fn zjs_gc(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    gc_run(ctx);
}

fn zjs_cell_count(ctx: ZjsContext*) -> u32 {
    if ctx == NULL { return 0; }
    return ctx.cell_count;
}

// Intern a string by copying the input bytes. The returned ZjsValue
// is a NaN-boxed cell pointer registered with the context.
//
// NOT deduplicated — every call allocates a fresh ZjsString. For
// dedup, use ctx_intern_atom. This is the right function for ToString
// results (numeric → "42") and other transient strings that don't
// benefit from dedup.
fn ctx_intern_string(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// Take ownership of an already-malloc'd buffer. Used by zjs_string_concat
// which allocates the result buffer itself. Also NOT deduplicated.
fn ctx_intern_string_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// =====================================================================
// Atom table — deduplicated strings. Used for property names and
// source-code string literals.
// =====================================================================

fn atom_hash(data: char*, length: u32) -> u32 {
    // FNV-1a 32-bit
    let h: u32 = 2166136261;
    let i: u32 = 0;
    while i < length {
        let b: u32 = (u32)(u8)data[i];
        h = h ^ b;
        h = h * 16777619;
        i = i + 1;
    }
    return h;
}

fn atom_table_insert_unchecked(ctx: ZjsContext*, s: ZjsString*, h: u32) -> void {
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        i = (i + 1) & mask;
    }
    ctx.atoms[i].str = s;
    ctx.atoms[i].hash = h;
    ctx.atom_count = ctx.atom_count + 1;
}

fn atom_table_grow(ctx: ZjsContext*) -> void {
    let old_cap = ctx.atom_cap;
    let old_atoms = ctx.atoms;

    let new_cap: u32 = if old_cap == 0 { 16 } else { old_cap * 2 };
    let new_atoms: AtomEntry* = NULL;
    raw {
        new_atoms = (AtomEntry*)calloc(new_cap, sizeof(AtomEntry));
    }
    ctx.atoms = new_atoms;
    ctx.atom_cap = new_cap;
    ctx.atom_count = 0;

    if old_cap > 0 {
        let i: u32 = 0;
        while i < old_cap {
            if old_atoms[i].str != NULL {
                atom_table_insert_unchecked(ctx, old_atoms[i].str, old_atoms[i].hash);
            }
            i = i + 1;
        }
        raw { free(old_atoms); }
    }
}

fn atom_table_lookup(ctx: ZjsContext*, data: char*, length: u32, h: u32) -> ZjsString* {
    if ctx.atom_cap == 0 { return NULL; }
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        let s = ctx.atoms[i].str;
        if ctx.atoms[i].hash == h && s.length == length {
            let s_data = s.data;
            let eq: int = 0;
            raw { eq = (memcmp(s_data, data, length) == 0) ? 1 : 0; }
            if eq != 0 { return s; }
        }
        i = (i + 1) & mask;
    }
    return NULL;
}

// Public intern: dedupe by content. Allocates only on cache miss.
fn ctx_intern_atom(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL { return existing; }

    // Grow first if needed (so insert below doesn't trip a probe through a full table).
    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Same as above, but adopts ownership of an already-malloc'd
// null-terminated buffer. Frees the buffer on dedup hit.
fn ctx_intern_atom_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL {
        // Caller's buffer is redundant — free it.
        raw { free(data); }
        return existing;
    }

    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Allocate a fresh empty object and register it on the context.
// Initializes with the root empty class — fresh property additions
// will spawn transitions on first write.
fn ctx_new_object(ctx: ZjsContext*) -> ZjsValue {
    let o = zjs_object_new();
    o.cls = ctx.empty_class;
    // Default proto: every {} inherits from Object.prototype.
    // Skipped while bootstrapping object_proto itself (it's NULL then).
    if ctx.object_proto != NULL && o != ctx.object_proto {
        o.proto = ctx.object_proto;
    }
    ctx_register_cell(ctx, (void*)o);
    return zjs_cell_from_ptr((void*)o);
}

// Full object_set with hidden-class transition logic. Updates an
// existing property if present; otherwise follows or creates a
// transition edge.
fn object_set(ctx: ZjsContext*, obj: ZjsObject*, name: ZjsString*, value: ZjsValue) -> void {
    if object_set_existing(obj, name, value) != 0 { return; }

    // Property is new. Find or create a transition.
    let parent_cls = obj.cls;
    let child = class_find_transition(parent_cls, name);
    if child == NULL {
        child = zjs_hidden_class_new(parent_cls, name,
                                      parent_cls.prop_count,
                                      parent_cls.prop_count + 1);
        ctx_register_cell(ctx, (void*)child);
        class_add_transition(parent_cls, name, child);
    }

    // Grow slots to accommodate the new property.
    let needed = child.prop_count;
    if obj.slot_cap < needed {
        let new_cap: u32 = if obj.slot_cap == 0 { 4 } else { obj.slot_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        let old = obj.slots;
        let new_slots: ZjsValue* = NULL;
        raw { new_slots = (ZjsValue*)realloc(old, new_cap * sizeof(ZjsValue)); }
        let und: ZjsValue = zjs_undefined();
        let i = obj.slot_cap;
        while i < new_cap {
            new_slots[i] = und;
            i = i + 1;
        }
        obj.slots = new_slots;
        obj.slot_cap = new_cap;
    }

    obj.slots[child.transition_slot] = value;
    obj.cls = child;
}

// Allocate a fresh array with `length` slots, all undefined.
fn ctx_new_array(ctx: ZjsContext*, length: u32) -> ZjsValue {
    let a = zjs_array_new(length);
    ctx_register_cell(ctx, (void*)a);
    return zjs_cell_from_ptr((void*)a);
}

// =====================================================================
// Host functions + built-in registry. ctx_init_builtins is called at
// the end of zjs_new_context so every context starts with Error and
// Math available globally.
// =====================================================================

// Register a host function as a global. fn_ptr must point to a C
// function with signature:
//     ZjsValue (*)(ZjsContext*, ZjsValue*, uint32_t)
fn ctx_register_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)calloc(1, sizeof(ZjsHostFunction)); }
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy: char* = NULL;
    raw {
        name_copy = (char*)malloc(name_len + 1);
        memcpy(name_copy, name, name_len + 1);
    }
    hf.name = name_copy;

    ctx_register_cell(ctx, (void*)hf);
    let val = zjs_cell_from_ptr((void*)hf);

    // Stash in a global slot.
    let slot = ctx_intern_global(ctx, name, (u32)name_len);
    ctx.globals[slot].value = val;
    ctx.globals[slot].defined = true;
    return val;
}

// Like ctx_register_host_function but doesn't create a global slot —
// used when the function is going to be attached as an object property
// (e.g. Math.abs).
fn ctx_make_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)calloc(1, sizeof(ZjsHostFunction)); }
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy: char* = NULL;
    raw {
        name_copy = (char*)malloc(name_len + 1);
        memcpy(name_copy, name, name_len + 1);
    }
    hf.name = name_copy;

    ctx_register_cell(ctx, (void*)hf);
    return zjs_cell_from_ptr((void*)hf);
}

// --- Built-in implementations ---------------------------------------

// Error("msg") — produces { message, name: "Error" }. Decorates the
// `new` target when invoked via `new`, so `e instanceof Error` works.
fn host_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"Error", 5, args, argc);
}

// --- Math.* helpers -------------------------------------------------

raw {
    #include <math.h>
}

fn host_math_abs(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let v = args[0];
    if zjs_is_int32(v) != 0 {
        let i = zjs_as_int32(v);
        if i >= 0 { return v; }
        return zjs_arith_neg(v);
    }
    let d = zjs_to_double(v);
    if d < 0.0 { return zjs_double(-d); }
    return zjs_double(d);
}

fn host_math_floor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    let r: f64 = 0.0;
    raw { r = floor(d); }
    return zjs_double(r);
}

fn host_math_ceil(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    let r: f64 = 0.0;
    raw { r = ceil(d); }
    return zjs_double(r);
}

fn host_math_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    // ECMA-262 Math.round rounds half toward +Infinity (not banker's rounding).
    let r: f64 = 0.0;
    raw { r = floor(d + 0.5); }
    return zjs_double(r);
}

fn host_math_sqrt(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    let r: f64 = 0.0;
    raw { r = sqrt(d); }
    return zjs_double(r);
}

fn host_math_pow(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let base: f64 = 1.0;
    let exp:  f64 = 1.0;
    if argc >= 1 { base = zjs_to_double(args[0]); }
    if argc >= 2 { exp  = zjs_to_double(args[1]); }
    let r: f64 = 0.0;
    raw { r = pow(base, exp); }
    return zjs_double(r);
}

fn host_math_max(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262: empty args -> -Infinity. MVP: undefined.
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = -INFINITY; }
        return zjs_double(nan);
    }
    let best = zjs_to_double(args[0]);
    let i: u32 = 1;
    while i < argc {
        let d = zjs_to_double(args[i]);
        if d > best { best = d; }
        i = i + 1;
    }
    return zjs_double(best);
}

fn host_math_min(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let inf: f64 = 0.0;
        raw { inf = INFINITY; }
        return zjs_double(inf);
    }
    let best = zjs_to_double(args[0]);
    let i: u32 = 1;
    while i < argc {
        let d = zjs_to_double(args[i]);
        if d < best { best = d; }
        i = i + 1;
    }
    return zjs_double(best);
}

// =====================================================================
// Phase 3.4 — for-in / for-of iteration prepare.
//
// `kind` 0 = for-in (own enumerable string keys of an object); 1 = for-of
// (element values; strings yield each char as a 1-char string). Non-
// iterables yield an empty array. Used by Op::IterPrepare.
// =====================================================================

fn iter_prepare(ctx: ZjsContext*, src: ZjsValue, kind: u32) -> ZjsValue {
    if kind == 0 {
        // for-in: enumerate own + inherited string keys, in insertion
        // order at each prototype level, skipping names already seen
        // at a more-specific level (own shadows inherited) and skipping
        // DELETED slots.
        //
        // We stop at ctx.object_proto so the global Object.prototype's
        // built-in methods (toString/hasOwnProperty) don't appear in
        // for-in output — those are non-enumerable per spec, and we
        // don't track enumerable flags yet. Plain objects' own props
        // are surfaced normally because their cls chain stops above
        // object_proto.
        if zjs_is_array(src) != 0 {
            // Arrays: enumerate the index keys as strings "0", "1", ...
            // Doesn't include array prototype methods (non-enumerable).
            let a = zjs_as_array(src);
            let arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, arr_v);
            defer ctx_pop_temp_root(ctx);
            let arr = zjs_as_array(arr_v);
            let i: u32 = 0;
            while i < a.length {
                let buf: char[16];
                let key_len: int = 0;
                raw { key_len = snprintf(&buf[0], 16, "%u", (unsigned)i); }
                let kp: char* = NULL;
                raw { kp = &buf[0]; }
                array_set(arr, i, ctx_intern_string(ctx, kp, (u32)key_len));
                i = i + 1;
            }
            return arr_v;
        }
        if zjs_is_object(src) != 0 {
            let arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, arr_v);
            defer ctx_pop_temp_root(ctx);
            let arr = zjs_as_array(arr_v);
            let cur: ZjsObject* = zjs_as_object(src);
            while cur != NULL && cur != ctx.object_proto {
                // Collect this level's own names in insertion order
                // (= slot index order). Then append to the result,
                // skipping shadowed names.
                let prop_count = cur.cls.prop_count;
                let scratch: ZjsString*[64];
                let scratch_del: bool[64];
                let limit: u32 = if prop_count > 64 { 64 } else { prop_count };
                let init_i: u32 = 0;
                while init_i < limit {
                    scratch[init_i] = NULL;
                    scratch_del[init_i] = false;
                    init_i = init_i + 1;
                }
                let cls = cur.cls;
                while cls != NULL && cls.parent != NULL {
                    let slot = cls.transition_slot;
                    if slot < limit {
                        scratch[slot] = cls.transition_name;
                        scratch_del[slot] = zjs_is_deleted(cur.slots[slot]) != 0;
                    }
                    cls = cls.parent;
                }
                let i: u32 = 0;
                while i < limit {
                    let nm = scratch[i];
                    if nm != NULL {
                        // Skip our internal hidden keys (`__zjs_*`) —
                        // wrapper primitives, env chain, toString tag.
                        // Spec equivalent is "non-enumerable own prop".
                        let is_internal: bool = false;
                        if nm.length >= 6 {
                            let nd = nm.data;
                            raw { is_internal = (memcmp(nd, "__zjs_", 6) == 0) ? true : false; }
                        }
                        if !is_internal {
                            // Already seen at a more-specific level?
                            let seen: bool = false;
                            let j: u32 = 0;
                            while j < arr.length {
                                if zjs_as_string(arr.elements[j]) == nm {
                                    seen = true; j = arr.length;
                                } else { j = j + 1; }
                            }
                            if !seen && !scratch_del[i] {
                                array_set(arr, arr.length, zjs_cell_from_ptr((void*)nm));
                            }
                        }
                    }
                    i = i + 1;
                }
                cur = cur.proto;
            }
            return arr_v;
        }
        return ctx_new_array(ctx, 0);
    }

    // for-of: element values.
    if zjs_is_array(src) != 0 {
        // Snapshot a copy so the user can't mutate the source mid-iteration.
        let a = zjs_as_array(src);
        let copy_v = ctx_new_array(ctx, a.length);
        let copy = zjs_as_array(copy_v);
        let i: u32 = 0;
        while i < a.length {
            copy.elements[i] = a.elements[i];
            i = i + 1;
        }
        copy.length = a.length;
        return copy_v;
    }
    if zjs_is_string(src) != 0 {
        // Split into 1-char strings. Cheap fallback — proper iterator
        // protocol arrives later.
        let s = zjs_as_string(src);
        let arr_v = ctx_new_array(ctx, s.length);
        ctx_push_temp_root(ctx, arr_v);
        let arr = zjs_as_array(arr_v);
        let sdata = s.data;
        let i: u32 = 0;
        while i < s.length {
            let buf: char* = NULL;
            let off = i;
            raw {
                buf = (char*)malloc(2);
                buf[0] = sdata[off];
                buf[1] = '\0';
            }
            let piece = ctx_intern_string_take(ctx, buf, 1);
            arr.elements[i] = piece;
            i = i + 1;
        }
        arr.length = s.length;
        ctx_pop_temp_root(ctx);
        return arr_v;
    }
    return ctx_new_array(ctx, 0);
}

// =====================================================================
// Phase 3.5 — Object / Array / String / JSON built-ins.
// =====================================================================

// Implicit receiver accessor for host functions. zjs_undefined() if the
// host was called via plain Invoke; the method-call receiver if via
// MethodInvoke.
fn zjs_get_host_this(ctx: ZjsContext*) -> ZjsValue {
    return ctx.host_this;
}

// Object() / new Object() — when called as a constructor, returns the
// (potentially boxed) primitive or a fresh object.
fn host_object_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // If invoked via `new`, ctx.host_this is the freshly-allocated obj
    // with proto = Object.prototype. Use it.
    if zjs_is_object(ctx.host_this) != 0 { return ctx.host_this; }
    if argc == 0 { return ctx_new_object(ctx); }
    let v = args[0];
    if zjs_is_undefined(v) != 0 || zjs_is_null(v) != 0 { return ctx_new_object(ctx); }
    // Otherwise return value as-is (would normally wrap-box in real JS).
    return v;
}

// Object.create(proto) — fresh empty object whose [[Prototype]] is proto.
// Phase 3.6.
// Forward — defined below.
raw {
    extern ZjsValue host_object_define_properties(ZjsContext* ctx, ZjsValue* args, uint32_t argc);
}

fn host_object_create(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    if argc > 0 {
        let p = args[0];
        if zjs_is_object(p) != 0 { obj.proto = zjs_as_object(p); }
        // null/undefined proto → top-of-chain object (already NULL).
    }
    // Phase 3.9a: second arg is a descriptor map.
    if argc >= 2 && zjs_is_object(args[1]) != 0 {
        // Protect obj_v across the descriptor walk (it's the receiver
        // of each defineProperty call which may allocate).
        ctx_push_temp_root(ctx, obj_v);
        let dp_args: ZjsValue[2];
        dp_args[0] = obj_v;
        dp_args[1] = args[1];
        let p: ZjsValue* = NULL;
        raw { p = &dp_args[0]; }
        raw { (void)host_object_define_properties(ctx, p, 2); }
        ctx_pop_temp_root(ctx);
    }
    return obj_v;
}

// Object.defineProperty(obj, key, descriptor) — Phase 3.9a.
//
// MVP: handles DATA descriptors (the `value` field). The
// writable/enumerable/configurable attributes are accepted but not
// enforced — every property is effectively configurable. Accessor
// descriptors (get/set) are recognized as "absent value" and the
// property is created with value = undefined; calling the
// accessor isn't wired up yet (Phase 3.9b).
fn host_object_define_property(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 3 { return zjs_undefined(); }
    let obj_v = args[0];
    if zjs_is_object(obj_v) == 0 { return obj_v; }
    let o = zjs_as_object(obj_v);

    let key_v = args[1];
    if zjs_is_string(key_v) == 0 { key_v = zjs_to_string(ctx, key_v); }
    let key_str = zjs_as_string(key_v);
    let key_atom = ctx_intern_atom(ctx, key_str.data, key_str.length);

    let desc_v = args[2];
    if zjs_is_object(desc_v) == 0 { return obj_v; }
    let desc = zjs_as_object(desc_v);

    let value_key  = ctx_intern_atom(ctx, (char*)"value", 5);
    let get_key    = ctx_intern_atom(ctx, (char*)"get",   3);
    let set_key    = ctx_intern_atom(ctx, (char*)"set",   3);

    let has_value = class_find_slot(desc.cls, value_key) >= 0;
    let has_get   = class_find_slot(desc.cls, get_key)   >= 0;
    let has_set   = class_find_slot(desc.cls, set_key)   >= 0;

    if has_get || has_set {
        // Accessor descriptor (Phase 3.9b). Allocate an accessor cell
        // holding the get/set callbacks (default undefined) and store
        // it directly in the slot.
        let g: ZjsValue = if has_get { object_get(desc, get_key) } else { zjs_undefined() };
        let s: ZjsValue = if has_set { object_get(desc, set_key) } else { zjs_undefined() };
        let a = zjs_accessor_new(g, s);
        ctx_register_cell(ctx, (void*)a);
        let av = zjs_cell_from_ptr((void*)a);
        object_set(ctx, o, key_atom, av);
        return obj_v;
    }

    // Data descriptor — extract `value` (default undefined if absent).
    let value: ZjsValue = if has_value { object_get(desc, value_key) } else { zjs_undefined() };
    object_set(ctx, o, key_atom, value);
    return obj_v;
}

// Object.defineProperties(obj, props) — Phase 3.9a.
// Walks props's own keys (via the hidden-class chain) and calls
// defineProperty for each.
fn host_object_define_properties(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return if argc > 0 { args[0] } else { zjs_undefined() }; }
    let obj_v = args[0];
    if zjs_is_object(obj_v) == 0 { return obj_v; }
    let props_v = args[1];
    if zjs_is_object(props_v) == 0 { return obj_v; }
    let po = zjs_as_object(props_v);

    // Walk props's own properties via the hidden-class chain.
    let cls = po.cls;
    while cls != NULL && cls.parent != NULL {
        let name = cls.transition_name;
        let slot = cls.transition_slot;
        let desc_value = po.slots[slot];
        let dp_args: ZjsValue[3];
        dp_args[0] = obj_v;
        dp_args[1] = zjs_cell_from_ptr((void*)name);
        dp_args[2] = desc_value;
        let dp_p: ZjsValue* = NULL;
        raw { dp_p = &dp_args[0]; }
        host_object_define_property(ctx, dp_p, 3);
        cls = cls.parent;
    }
    return obj_v;
}

// Object.getOwnPropertyDescriptor(obj, key) — Phase 3.9a.
// Returns a fresh descriptor object. MVP: all properties report as
// data descriptors with all three attribute bits set to true.
fn host_object_get_own_property_descriptor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    let obj_v = args[0];
    if zjs_is_object(obj_v) == 0 { return zjs_undefined(); }
    let o = zjs_as_object(obj_v);
    let key_v = args[1];
    if zjs_is_string(key_v) == 0 { key_v = zjs_to_string(ctx, key_v); }
    let key_str = zjs_as_string(key_v);
    let key_atom = ctx_intern_atom(ctx, key_str.data, key_str.length);

    let slot = class_find_slot(o.cls, key_atom);
    if slot < 0 { return zjs_undefined(); }
    let raw_v = o.slots[(u32)slot];

    let result_v = ctx_new_object(ctx);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_object(result_v);
    if zjs_is_accessor(raw_v) != 0 {
        let acc = zjs_as_accessor(raw_v);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"get", 3), acc.get);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"set", 3), acc.set);
    } else {
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"value", 5), raw_v);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(1));
    }
    object_set(ctx, result, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(1));
    object_set(ctx, result, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(1));
    return result_v;
}

// Object.getPrototypeOf(obj) — Phase 3.6.
fn host_object_get_prototype_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_null(); }
    let v = args[0];
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        if o.proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)o.proto);
    }
    return zjs_null();
}

// Object.keys(obj) — array of own enumerable string keys, in insertion
// order. We walk the hidden-class chain bottom-up; each transition_name
// goes at transition_slot. Non-object inputs return an empty array.
fn host_object_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 || zjs_is_object(args[0]) == 0 {
        return ctx_new_array(ctx, 0);
    }
    let o = zjs_as_object(args[0]);
    let cap = o.cls.prop_count;
    let arr_v = ctx_new_array(ctx, cap);
    let arr = zjs_as_array(arr_v);
    // Build a name-by-slot scratch first, then compact down to only
    // the present (non-deleted) ones in insertion order.
    let scratch: ZjsString*[64];
    let limit: u32 = if cap > 64 { 64 } else { cap };
    let init_i: u32 = 0;
    while init_i < limit { scratch[init_i] = NULL; init_i = init_i + 1; }
    let cls = o.cls;
    while cls != NULL && cls.parent != NULL {
        let slot = cls.transition_slot;
        if slot < limit && zjs_is_deleted(o.slots[slot]) == 0 {
            scratch[slot] = cls.transition_name;
        }
        cls = cls.parent;
    }
    let out: u32 = 0;
    let i: u32 = 0;
    while i < limit {
        if scratch[i] != NULL {
            // Skip our internal `__zjs_*` keys (non-enumerable in spec).
            let nm = scratch[i];
            let is_internal: bool = false;
            if nm.length >= 6 {
                let nd = nm.data;
                raw { is_internal = (memcmp(nd, "__zjs_", 6) == 0) ? true : false; }
            }
            if !is_internal {
                arr.elements[out] = zjs_cell_from_ptr((void*)nm);
                out = out + 1;
            }
        }
        i = i + 1;
    }
    arr.length = out;
    return arr_v;
}

// --- Array.prototype helpers ---------------------------------------

// Coerce `.length` to a u32. Most array-like objects have an integer
// length; ECMA-262 has more rigorous coercion rules we approximate.
fn read_length_u32(ctx: ZjsContext*, this_val: ZjsValue) -> u32 {
    if zjs_is_array(this_val) != 0 {
        return zjs_as_array(this_val).length;
    }
    if zjs_is_object(this_val) != 0 {
        // Use property_get so the proto chain is walked AND accessor
        // properties (Object.defineProperty getters) fire correctly.
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        let key_v = zjs_cell_from_ptr((void*)len_atom);
        let v = property_get(ctx, this_val, key_v);
        if zjs_is_int32(v) != 0 {
            let n = zjs_as_int32(v);
            if n > 0 { return (u32)n; }
            return 0;
        }
        if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        // String-coerce via valueOf/toString for objects-as-length
        // (the test262 cases use { valueOf: function(){ return 2 } }).
        if zjs_is_object(v) != 0 {
            let d = zjs_to_double(v);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        if zjs_is_string(v) != 0 {
            // ToNumber on the string.
            let d = zjs_to_double(v);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        return 0;
    }
    return 0;
}

// Set obj[index] = value where obj is a plain object (generic-this).
fn obj_set_indexed(ctx: ZjsContext*, o: ZjsObject*, index: u32, value: ZjsValue) -> void {
    let key_buf: char[16];
    let key_len: int = 0;
    raw {
        key_len = snprintf(&key_buf[0], 16, "%u", (unsigned)index);
    }
    let kp: char* = NULL;
    raw { kp = &key_buf[0]; }
    let key_atom = ctx_intern_atom(ctx, kp, (u32)key_len);
    object_set(ctx, o, key_atom, value);
}

fn obj_get_indexed(ctx: ZjsContext*, o: ZjsObject*, index: u32) -> ZjsValue {
    // Delegate to property_get so accessors fire and proto-chain
    // semantics (including string/array prototype intercepts) are
    // honored. The key is the integer index reformatted as a string;
    // property_get internally uses zjs_to_array_index for the fast
    // path on real arrays.
    let key_v = zjs_int32((i32)index);
    let obj_v = zjs_cell_from_ptr((void*)o);
    return property_get(ctx, obj_v, key_v);
}

fn host_array_push(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let i: u32 = 0;
        while i < argc {
            array_set(arr, arr.length, args[i]);
            i = i + 1;
        }
        return zjs_int32((i32)arr.length);
    }
    if zjs_is_object(this_val) != 0 {
        // Generic-this: walk obj.length and assign at indices.
        let o = zjs_as_object(this_val);
        let len = read_length_u32(ctx, this_val);
        let i: u32 = 0;
        while i < argc {
            obj_set_indexed(ctx, o, len + i, args[i]);
            i = i + 1;
        }
        let new_len = len + argc;
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        object_set(ctx, o, len_atom, zjs_int32((i32)new_len));
        return zjs_int32((i32)new_len);
    }
    return zjs_undefined();
}

fn host_array_pop(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        if arr.length == 0 { return zjs_undefined(); }
        let last = arr.elements[arr.length - 1];
        arr.elements[arr.length - 1] = zjs_undefined();
        arr.length = arr.length - 1;
        return last;
    }
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let len = read_length_u32(ctx, this_val);
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        if len == 0 {
            object_set(ctx, o, len_atom, zjs_int32(0));
            return zjs_undefined();
        }
        let last_idx = len - 1;
        let last_v = obj_get_indexed(ctx, o, last_idx);
        // Remove the property and update length.
        // (We don't have a proper delete — leave it as undefined.)
        obj_set_indexed(ctx, o, last_idx, zjs_undefined());
        object_set(ctx, o, len_atom, zjs_int32((i32)last_idx));
        return last_v;
    }
    return zjs_undefined();
}

fn host_array_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if argc == 0 { return zjs_int32(-1); }
    let needle = args[0];
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let i: u32 = 0;
        while i < arr.length {
            if zjs_strict_eq(arr.elements[i], needle) != 0 {
                return zjs_int32((i32)i);
            }
            i = i + 1;
        }
        return zjs_int32(-1);
    }
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let len = read_length_u32(ctx, this_val);
        let i: u32 = 0;
        while i < len {
            let v = obj_get_indexed(ctx, o, i);
            if zjs_strict_eq(v, needle) != 0 {
                return zjs_int32((i32)i);
            }
            i = i + 1;
        }
        return zjs_int32(-1);
    }
    return zjs_int32(-1);
}

// --- String.prototype helpers ---------------------------------------

// Apply ECMA-262 `O = RequireObjectCoercible(this); S = ToString(O)`
// to the calling-host's `this`. Returns undefined and sets had_error
// if `this` is null/undefined; returns a string-typed ZjsValue
// otherwise. Caller should bail on undefined.
fn coerce_string_this(ctx: ZjsContext*) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_undefined(this_val) != 0 || zjs_is_null(this_val) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.had_error = true;
        ctx.last_error = err;
        return zjs_undefined();
    }
    if zjs_is_string(this_val) != 0 { return this_val; }
    return zjs_to_string(ctx, this_val);
}

fn host_string_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_int32(-1); }
    if argc == 0 { return zjs_int32(-1); }
    let needle_v = args[0];
    if zjs_is_string(needle_v) == 0 { needle_v = zjs_to_string(ctx, needle_v); }
    let hay = zjs_as_string(str_v);
    if zjs_is_string(needle_v) == 0 { return zjs_int32(-1); }
    let nee = zjs_as_string(needle_v);
    if nee.length == 0 { return zjs_int32(0); }
    if hay.length < nee.length { return zjs_int32(-1); }
    let hay_d = hay.data;
    let hay_n = hay.length;
    let nee_d = nee.data;
    let nee_n = nee.length;
    let result: i32 = -1;
    raw {
        for (uint32_t i = 0; i + nee_n <= hay_n; i++) {
            if (memcmp(hay_d + i, nee_d, nee_n) == 0) {
                result = (int32_t)i;
                break;
            }
        }
    }
    return zjs_int32(result);
}

// Clamp + normalize a slice endpoint (negatives count from end).
fn slice_clamp(v: ZjsValue, len: u32, default_val: i32) -> i32 {
    if zjs_is_undefined(v) != 0 { return default_val; }
    let n = (i32)zjs_to_double(v);
    if n < 0 { n = (i32)len + n; }
    if n < 0 { n = 0; }
    if n > (i32)len { n = (i32)len; }
    return n;
}

fn host_string_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let start = if argc >= 1 { slice_clamp(args[0], s.length, 0) }
                else         { 0 };
    let end_default: i32 = (i32)s.length;
    let end = if argc >= 2 { slice_clamp(args[1], s.length, end_default) }
              else         { end_default };
    if end < start { end = start; }
    let outlen = (u32)(end - start);
    let buf: char* = NULL;
    let src = s.data;
    let src_off = (u32)start;
    raw {
        buf = (char*)malloc((size_t)outlen + 1);
        if (outlen > 0) memcpy(buf, src + src_off, outlen);
        buf[outlen] = '\0';
    }
    return ctx_intern_string_take(ctx, buf, outlen);
}

fn host_string_char_at(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let idx: i32 = 0;
    if argc >= 1 { idx = (i32)zjs_to_double(args[0]); }
    if idx < 0 || (u32)idx >= s.length {
        return ctx_intern_string(ctx, (char*)"", 0);
    }
    let buf: char* = NULL;
    let off = (u32)idx;
    let sd = s.data;
    raw {
        buf = (char*)malloc(2);
        buf[0] = sd[off];
        buf[1] = '\0';
    }
    return ctx_intern_string_take(ctx, buf, 1);
}

fn host_string_char_code_at(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 {
        let nan: f64 = 0.0; raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let s = zjs_as_string(str_v);
    let idx: i32 = 0;
    if argc >= 1 { idx = (i32)zjs_to_double(args[0]); }
    if idx < 0 || (u32)idx >= s.length {
        let nan: f64 = 0.0; raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let c = (u8)s.data[(u32)idx];
    return zjs_int32((i32)c);
}

fn host_string_to_upper_case(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let buf: char* = NULL;
    let n = s.length;
    let sd = s.data;
    raw {
        buf = (char*)malloc(n + 1);
        for (uint32_t i = 0; i < n; i++) {
            char c = sd[i];
            buf[i] = (c >= 'a' && c <= 'z') ? (char)(c - 32) : c;
        }
        buf[n] = '\0';
    }
    return ctx_intern_string_take(ctx, buf, n);
}

fn host_string_to_lower_case(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let buf: char* = NULL;
    let n = s.length;
    let sd = s.data;
    raw {
        buf = (char*)malloc(n + 1);
        for (uint32_t i = 0; i < n; i++) {
            char c = sd[i];
            buf[i] = (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c;
        }
        buf[n] = '\0';
    }
    return ctx_intern_string_take(ctx, buf, n);
}

fn host_string_concat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let result = this_val;
    // Defensive rooting: `result` is held across loop iterations of
    // zjs_string_concat (which allocates). `other` is also briefly
    // held across the concat call and rooted just for that span.
    ctx_push_temp_root(ctx, result);
    defer ctx_pop_temp_root(ctx);
    let i: u32 = 0;
    while i < argc {
        let other = args[i];
        if zjs_is_string(other) == 0 { other = zjs_to_string(ctx, other); }
        ctx_push_temp_root(ctx, other);
        result = zjs_string_concat(ctx, result, other);
        ctx_pop_temp_root(ctx);
        ctx_replace_top_temp_root(ctx, result);
        i = i + 1;
    }
    return result;
}

fn host_string_split(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return ctx_new_array(ctx, 0); }
    let s = zjs_as_string(this_val);
    // If no separator, return [s].
    if argc == 0 || zjs_is_undefined(args[0]) != 0 {
        let one = ctx_new_array(ctx, 1);
        let one_arr = zjs_as_array(one);
        one_arr.elements[0] = this_val;
        one_arr.length = 1;
        return one;
    }
    let sep_v = args[0];
    if zjs_is_string(sep_v) == 0 { sep_v = zjs_to_string(ctx, sep_v); }
    let sep = zjs_as_string(sep_v);
    let result_v = ctx_new_array(ctx, 0);
    let result = zjs_as_array(result_v);

    // Empty separator: split into individual characters.
    if sep.length == 0 {
        let i: u32 = 0;
        let sdata = s.data;
        while i < s.length {
            let buf: char* = NULL;
            let off = i;
            raw {
                buf = (char*)malloc(2);
                buf[0] = sdata[off];
                buf[1] = '\0';
            }
            let piece = ctx_intern_string_take(ctx, buf, 1);
            array_set(result, result.length, piece);
            i = i + 1;
        }
        return result_v;
    }

    let hay_d  = s.data;
    let hay_n  = s.length;
    let nee_d  = sep.data;
    let nee_n  = sep.length;
    let cursor: u32 = 0;
    let i: u32 = 0;
    while i + nee_n <= hay_n {
        let matches: int = 0;
        let off = i;
        raw { matches = (memcmp(hay_d + off, nee_d, nee_n) == 0) ? 1 : 0; }
        if matches != 0 {
            let piece_len = i - cursor;
            let buf: char* = NULL;
            let src_off = cursor;
            let plen = piece_len;
            raw {
                buf = (char*)malloc((size_t)plen + 1);
                if (plen > 0) memcpy(buf, hay_d + src_off, plen);
                buf[plen] = '\0';
            }
            let piece = ctx_intern_string_take(ctx, buf, piece_len);
            array_set(result, result.length, piece);
            cursor = i + nee_n;
            i = cursor;
        } else {
            i = i + 1;
        }
    }
    // Trailing remainder
    let tail_len = hay_n - cursor;
    let tail_buf: char* = NULL;
    let tail_src = cursor;
    let tlen = tail_len;
    raw {
        tail_buf = (char*)malloc((size_t)tlen + 1);
        if (tlen > 0) memcpy(tail_buf, hay_d + tail_src, tlen);
        tail_buf[tlen] = '\0';
    }
    let tail = ctx_intern_string_take(ctx, tail_buf, tail_len);
    array_set(result, result.length, tail);
    return result_v;
}

// --- Higher-order array methods (Phase 3.5b) ----------------------
//
// These call a user-provided JS callback. We use ctx_push_temp_root to
// protect the result accumulator across the inner interpret() call,
// which may GC. The callback receives (element, index, array) — the
// standard JS prototype-method signature.

raw {
    extern ZjsValue zjs_call_value(ZjsContext* ctx, ZjsValue callee, ZjsValue* args, uint32_t argc);
}

fn host_array_map(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if argc == 0 { return ctx_new_array(ctx, 0); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };

    // Determine length and source-element accessor.
    let len: u32 = 0;
    if zjs_is_array(this_val) != 0 { len = zjs_as_array(this_val).length; }
    else if zjs_is_object(this_val) != 0 { len = read_length_u32(ctx, this_val); }
    else { return ctx_new_array(ctx, 0); }

    let result_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_array(result_v);

    let i: u32 = 0;
    while i < len {
        let src: ZjsValue = zjs_undefined();
        if zjs_is_array(this_val) != 0 {
            src = zjs_as_array(this_val).elements[i];
        } else {
            src = obj_get_indexed(ctx, zjs_as_object(this_val), i);
        }
        let cb_args: ZjsValue[3];
        cb_args[0] = src;
        cb_args[1] = zjs_int32((i32)i);
        cb_args[2] = this_val;
        let cb_args_ptr: ZjsValue* = NULL;
        raw { cb_args_ptr = &cb_args[0]; }
        let mapped: ZjsValue = zjs_undefined();
        raw { mapped = zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
        if ctx.had_error { return result_v; }
        array_set(result, i, mapped);
        i = i + 1;
    }
    result.length = len;
    return result_v;
}

fn host_array_join(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let sep_v: ZjsValue = ctx_intern_string(ctx, (char*)",", 1);
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        sep_v = args[0];
        if zjs_is_string(sep_v) == 0 { sep_v = zjs_to_string(ctx, sep_v); }
    }
    if len == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    // Build the joined string by repeated zjs_string_concat. O(n^2)
    // worst case — fine for the test262 inputs we care about.
    let result: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    // Defensive rooting: result + sep_v are held across many
    // allocations (string concat per element, possibly ToString of
    // each element). Push both; release after the loop.
    ctx_push_temp_root(ctx, sep_v);
    ctx_push_temp_root(ctx, result);
    defer ctx_pop_temp_root(ctx);
    defer ctx_pop_temp_root(ctx);
    let arr: ZjsArray* = NULL;
    if zjs_is_array(this_val) != 0 { arr = zjs_as_array(this_val); }
    let i: u32 = 0;
    while i < len {
        if i > 0 {
            result = zjs_string_concat(ctx, result, sep_v);
            ctx_replace_top_temp_root(ctx, result);
        }
        let elem: ZjsValue = zjs_undefined();
        if arr != NULL { elem = arr.elements[i]; }
        else if zjs_is_object(this_val) != 0 { elem = obj_get_indexed(ctx, zjs_as_object(this_val), i); }
        if zjs_is_undefined(elem) == 0 && zjs_is_null(elem) == 0 {
            if zjs_is_string(elem) == 0 { elem = zjs_to_string(ctx, elem); }
            // Protect `elem` across the concat allocation.
            ctx_push_temp_root(ctx, elem);
            result = zjs_string_concat(ctx, result, elem);
            ctx_pop_temp_root(ctx);
            ctx_replace_top_temp_root(ctx, result);
        }
        i = i + 1;
    }
    return result;
}

fn host_array_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    let len = read_length_u32(ctx, this_val);
    let start: i32 = 0;
    let end: i32 = (i32)len;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        start = (i32)zjs_to_double(args[0]);
        if start < 0 { start = (i32)len + start; if start < 0 { start = 0; } }
        if start > (i32)len { start = (i32)len; }
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        end = (i32)zjs_to_double(args[1]);
        if end < 0 { end = (i32)len + end; if end < 0 { end = 0; } }
        if end > (i32)len { end = (i32)len; }
    }
    if end < start { end = start; }
    let count = (u32)(end - start);
    let out_v = ctx_new_array(ctx, count);
    let out = zjs_as_array(out_v);
    let arr: ZjsArray* = NULL;
    if zjs_is_array(this_val) != 0 { arr = zjs_as_array(this_val); }
    let i: u32 = 0;
    while i < count {
        let src_idx = (u32)(start) + i;
        if arr != NULL {
            if src_idx < arr.length { out.elements[i] = arr.elements[src_idx]; }
        } else if zjs_is_object(this_val) != 0 {
            out.elements[i] = obj_get_indexed(ctx, zjs_as_object(this_val), src_idx);
        }
        i = i + 1;
    }
    out.length = count;
    return out_v;
}

fn host_array_concat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    // First pass: compute total length.
    let total: u32 = read_length_u32(ctx, this_val);
    let i: u32 = 0;
    while i < argc {
        let a = args[i];
        if zjs_is_array(a) != 0 { total = total + zjs_as_array(a).length; }
        else { total = total + 1; }
        i = i + 1;
    }
    let out_v = ctx_new_array(ctx, total);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let cursor: u32 = 0;
    // Copy this.
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let k: u32 = 0;
        while k < arr.length { out.elements[cursor + k] = arr.elements[k]; k = k + 1; }
        cursor = cursor + arr.length;
    } else if zjs_is_object(this_val) != 0 {
        let len = read_length_u32(ctx, this_val);
        let k: u32 = 0;
        while k < len {
            out.elements[cursor + k] = obj_get_indexed(ctx, zjs_as_object(this_val), k);
            k = k + 1;
        }
        cursor = cursor + len;
    }
    // Then each arg.
    i = 0;
    while i < argc {
        let a = args[i];
        if zjs_is_array(a) != 0 {
            let arr = zjs_as_array(a);
            let k: u32 = 0;
            while k < arr.length { out.elements[cursor + k] = arr.elements[k]; k = k + 1; }
            cursor = cursor + arr.length;
        } else {
            out.elements[cursor] = a;
            cursor = cursor + 1;
        }
        i = i + 1;
    }
    out.length = total;
    return out_v;
}

fn host_array_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if argc == 0 { return zjs_undefined(); }
    let cb = args[0];
    // ECMA-262 §22.1.3.12: forEach(callbackfn, thisArg). Second arg
    // becomes `this` in the callback. Pass undefined when absent.
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };

    // Fast path: real array — direct .elements[] access.
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let len = arr.length;
        let i: u32 = 0;
        while i < len {
            let cb_args: ZjsValue[3];
            cb_args[0] = arr.elements[i];
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { (void)zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.had_error { return zjs_undefined(); }
            i = i + 1;
        }
        return zjs_undefined();
    }

    // Generic-this path: ToObject(this), then iterate via length /
    // indexed reads. Spec §22.1.3.12.
    let obj_val = ctx_to_object(ctx, this_val);
    if ctx.had_error { return zjs_undefined(); }
    ctx_push_temp_root(ctx, obj_val);
    defer ctx_pop_temp_root(ctx);

    if zjs_is_object(obj_val) != 0 {
        let o = zjs_as_object(obj_val);
        let len = read_length_u32(ctx, obj_val);
        let i: u32 = 0;
        while i < len {
            let v = obj_get_indexed(ctx, o, i);
            let cb_args: ZjsValue[3];
            cb_args[0] = v;
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = obj_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { (void)zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.had_error { return zjs_undefined(); }
            i = i + 1;
        }
    }
    return zjs_undefined();
}

// --- JSON.stringify (Phase 3.5b) -----------------------------------
//
// Walks the value and appends JSON to a growable buffer. No `space`,
// no `replacer`, no `toJSON()`. Cycles overflow the stack — not a
// concern for the test workloads we care about now.

struct JsonBuf {
    data: char*;
    len:  u32;
    cap:  u32;
}

fn json_buf_grow(b: JsonBuf*, need: u32) -> void {
    if b.len + need <= b.cap { return; }
    let new_cap: u32 = if b.cap == 0 { 64 } else { b.cap * 2 };
    while new_cap < b.len + need { new_cap = new_cap * 2; }
    let old = b.data;
    let new_buf: char* = NULL;
    raw { new_buf = (char*)realloc(old, new_cap); }
    b.data = new_buf;
    b.cap = new_cap;
}

fn json_buf_putc(b: JsonBuf*, ch: char) -> void {
    json_buf_grow(b, 1);
    b.data[b.len] = ch;
    b.len = b.len + 1;
}

fn json_buf_puts(b: JsonBuf*, s: char*, n: u32) -> void {
    json_buf_grow(b, n);
    let src = s;
    let dst_base = b.data;
    let off = b.len;
    let count = n;
    raw { memcpy(dst_base + off, src, count); }
    b.len = b.len + n;
}

fn json_emit_string(b: JsonBuf*, s: char*, n: u32) -> void {
    json_buf_putc(b, '"');
    let i: u32 = 0;
    while i < n {
        let c: char = s[i];
        let cu = (u8)c;
        if cu == 34 {           // "
            json_buf_putc(b, '\\'); json_buf_putc(b, '"');
        } else if cu == 92 {    // \
            json_buf_putc(b, '\\'); json_buf_putc(b, '\\');
        } else if cu == 8 {     // \b
            json_buf_putc(b, '\\'); json_buf_putc(b, 'b');
        } else if cu == 9 {     // \t
            json_buf_putc(b, '\\'); json_buf_putc(b, 't');
        } else if cu == 10 {    // \n
            json_buf_putc(b, '\\'); json_buf_putc(b, 'n');
        } else if cu == 12 {    // \f
            json_buf_putc(b, '\\'); json_buf_putc(b, 'f');
        } else if cu == 13 {    // \r
            json_buf_putc(b, '\\'); json_buf_putc(b, 'r');
        } else if cu < 32 {
            // \u00XX
            let hex_lookup: char* = NULL;
            raw { hex_lookup = (char*)"0123456789abcdef"; }
            json_buf_putc(b, '\\');
            json_buf_putc(b, 'u');
            json_buf_putc(b, '0');
            json_buf_putc(b, '0');
            json_buf_putc(b, hex_lookup[(cu >> 4) & 15]);
            json_buf_putc(b, hex_lookup[cu & 15]);
        } else {
            json_buf_putc(b, c);
        }
        i = i + 1;
    }
    json_buf_putc(b, '"');
}

fn json_stringify_value(ctx: ZjsContext*, b: JsonBuf*, v: ZjsValue) -> void {
    if zjs_is_undefined(v) != 0 {
        // JSON.stringify(undefined) is `undefined` in JS (not a string).
        // At the top level the caller handles this by returning undefined;
        // inside an array we'd emit null. For simplicity here, emit null.
        json_buf_puts(b, (char*)"null", 4);
        return;
    }
    if zjs_is_null(v) != 0 { json_buf_puts(b, (char*)"null", 4); return; }
    if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { json_buf_puts(b, (char*)"true", 4); }
        else                   { json_buf_puts(b, (char*)"false", 5); }
        return;
    }
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        let tmp: char[32];
        let written: int = 0;
        let tp: char* = NULL;
        raw { tp = &tmp[0]; written = snprintf(tp, 32, "%d", (int)n); }
        json_buf_puts(b, tp, (u32)written);
        return;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        // NaN / Infinity become null per ECMA-262.
        let is_finite: int = 0;
        raw { is_finite = isfinite(d) ? 1 : 0; }
        if is_finite == 0 { json_buf_puts(b, (char*)"null", 4); return; }
        let tmp: char[32];
        let written: int = 0;
        let tp: char* = NULL;
        raw { tp = &tmp[0]; written = snprintf(tp, 32, "%g", d); }
        json_buf_puts(b, tp, (u32)written);
        return;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        json_emit_string(b, s.data, s.length);
        return;
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        json_buf_putc(b, '[');
        let i: u32 = 0;
        while i < a.length {
            if i > 0 { json_buf_putc(b, ','); }
            json_stringify_value(ctx, b, a.elements[i]);
            i = i + 1;
        }
        json_buf_putc(b, ']');
        return;
    }
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        // Enumerate own property names in insertion order by walking
        // the hidden-class chain bottom-up (same approach as Object.keys).
        let count = o.cls.prop_count;
        json_buf_putc(b, '{');
        // First gather names by slot.
        let names: ZjsString*[64];          // MVP: 64-prop cap per object
        let names_ptr: ZjsString** = NULL;
        raw { names_ptr = &names[0]; }
        let limit: u32 = if count > 64 { 64 } else { count };
        let init_i: u32 = 0;
        while init_i < limit { names_ptr[init_i] = NULL; init_i = init_i + 1; }
        let cls = o.cls;
        while cls != NULL && cls.parent != NULL {
            let slot = cls.transition_slot;
            if slot < limit { names_ptr[slot] = cls.transition_name; }
            cls = cls.parent;
        }
        let i: u32 = 0;
        let emitted: u32 = 0;
        while i < limit {
            let n = names_ptr[i];
            if n != NULL {
                if emitted > 0 { json_buf_putc(b, ','); }
                json_emit_string(b, n.data, n.length);
                json_buf_putc(b, ':');
                json_stringify_value(ctx, b, o.slots[i]);
                emitted = emitted + 1;
            }
            i = i + 1;
        }
        json_buf_putc(b, '}');
        return;
    }
    // Functions, closures, host functions, hidden classes — not
    // serializable. Real JSON.stringify returns undefined for these at
    // top level; inside containers it emits null. MVP: emit null.
    json_buf_puts(b, (char*)"null", 4);
}

fn host_json_stringify(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    // Top-level undefined / functions return undefined (per spec).
    if zjs_is_undefined(v) != 0 { return zjs_undefined(); }
    let t = zjs_cell_tag(v);
    if t == TAG_FUNCTION || t == TAG_CLOSURE || t == TAG_HOST_FUNCTION {
        return zjs_undefined();
    }
    let b: JsonBuf;
    b.data = NULL; b.len = 0; b.cap = 0;
    json_stringify_value(ctx, &b, v);
    // Null-terminate for safety; ctx_intern_string_take only reads `len`.
    json_buf_putc(&b, '\0');
    b.len = b.len - 1;
    return ctx_intern_string_take(ctx, b.data, b.len);
}

// --- JSON.parse (Phase 3.5b) ---------------------------------------

struct JsonParser {
    src:  char*;
    len:  u32;
    pos:  u32;
    fail: bool;
}

fn jp_peek(p: JsonParser*) -> char {
    if p.pos >= p.len { return (char)0; }
    return p.src[p.pos];
}

fn jp_skip_ws(p: JsonParser*) -> void {
    while p.pos < p.len {
        let c = p.src[p.pos];
        let cu = (u8)c;
        if cu == 32 || cu == 9 || cu == 10 || cu == 13 { p.pos = p.pos + 1; }
        else { return; }
    }
}

fn jp_match_word(p: JsonParser*, word: char*, n: u32) -> bool {
    if p.pos + n > p.len { return false; }
    let src = p.src;
    let off = p.pos;
    let eq: int = 0;
    raw { eq = (memcmp(src + off, word, n) == 0) ? 1 : 0; }
    if eq == 0 { return false; }
    p.pos = p.pos + n;
    return true;
}

fn jp_parse_value(ctx: ZjsContext*, p: JsonParser*) -> ZjsValue {
    jp_skip_ws(p);
    if p.pos >= p.len { p.fail = true; return zjs_undefined(); }
    let c = p.src[p.pos];
    let cu = (u8)c;

    if cu == 110 {              // 'n' — null
        if jp_match_word(p, (char*)"null", 4) { return zjs_null(); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 116 {              // 't' — true
        if jp_match_word(p, (char*)"true", 4) { return zjs_bool(1); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 102 {              // 'f' — false
        if jp_match_word(p, (char*)"false", 5) { return zjs_bool(0); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 34 {               // '"' — string
        p.pos = p.pos + 1;
        let buf_cap: u32 = 16;
        let buf: char* = NULL;
        let bc = buf_cap;
        raw { buf = (char*)malloc(bc); }
        let blen: u32 = 0;
        let bcap = buf_cap;
        let ok = true;
        while p.pos < p.len {
            let ch = p.src[p.pos];
            let chu = (u8)ch;
            if chu == 34 { p.pos = p.pos + 1; break; }
            if chu == 92 {      // '\'
                p.pos = p.pos + 1;
                if p.pos >= p.len { ok = false; break; }
                let esc = p.src[p.pos];
                let eu = (u8)esc;
                let out: u8 = 0;
                let used_u: bool = false;
                if eu == 34 { out = 34; }
                else if eu == 92 { out = 92; }
                else if eu == 47 { out = 47; }
                else if eu == 98 { out = 8; }      // \b
                else if eu == 102 { out = 12; }    // \f
                else if eu == 110 { out = 10; }    // \n
                else if eu == 114 { out = 13; }    // \r
                else if eu == 116 { out = 9; }     // \t
                else if eu == 117 {                // \uXXXX
                    used_u = true;
                    if p.pos + 4 >= p.len { ok = false; break; }
                    p.pos = p.pos + 1;
                    let cp: u32 = 0;
                    let hi: u32 = 0;
                    while hi < 4 {
                        let hc = p.src[p.pos + hi];
                        let hu = (u8)hc;
                        let digit: u32 = 0;
                        if hu >= 48 && hu <= 57 { digit = (u32)(hu - 48); }
                        else if hu >= 97 && hu <= 102 { digit = (u32)(hu - 97) + 10; }
                        else if hu >= 65 && hu <= 70 { digit = (u32)(hu - 65) + 10; }
                        else { ok = false; }
                        cp = (cp << 4) | digit;
                        hi = hi + 1;
                    }
                    if !ok { break; }
                    p.pos = p.pos + 3;
                    // MVP: encode as UTF-8 (BMP only, no surrogate joining).
                    if cp < 128 {
                        if blen + 1 > bcap { bcap = bcap * 2; let oldp = buf; let bp: char* = NULL; raw { bp = (char*)realloc(oldp, bcap); } buf = bp; }
                        buf[blen] = (char)cp;
                        blen = blen + 1;
                    } else if cp < 2048 {
                        if blen + 2 > bcap { bcap = bcap * 2; let oldp = buf; let bp: char* = NULL; raw { bp = (char*)realloc(oldp, bcap); } buf = bp; }
                        buf[blen]     = (char)(192 | (cp >> 6));
                        buf[blen + 1] = (char)(128 | (cp & 63));
                        blen = blen + 2;
                    } else {
                        if blen + 3 > bcap { bcap = bcap * 2; let oldp = buf; let bp: char* = NULL; raw { bp = (char*)realloc(oldp, bcap); } buf = bp; }
                        buf[blen]     = (char)(224 | (cp >> 12));
                        buf[blen + 1] = (char)(128 | ((cp >> 6) & 63));
                        buf[blen + 2] = (char)(128 | (cp & 63));
                        blen = blen + 3;
                    }
                } else {
                    ok = false; break;
                }
                if !used_u {
                    if blen + 1 > bcap { bcap = bcap * 2; let oldp = buf; let bp: char* = NULL; raw { bp = (char*)realloc(oldp, bcap); } buf = bp; }
                    buf[blen] = (char)out;
                    blen = blen + 1;
                }
                p.pos = p.pos + 1;
            } else {
                if blen + 1 > bcap { bcap = bcap * 2; let oldp = buf; let bp: char* = NULL; raw { bp = (char*)realloc(oldp, bcap); } buf = bp; }
                buf[blen] = ch;
                blen = blen + 1;
                p.pos = p.pos + 1;
            }
        }
        if !ok { raw { free(buf); } p.fail = true; return zjs_undefined(); }
        // Ensure null terminator slot.
        if blen + 1 > bcap { bcap = blen + 1; let oldp = buf; let bp: char* = NULL; raw { bp = (char*)realloc(oldp, bcap); } buf = bp; }
        buf[blen] = '\0';
        return ctx_intern_string_take(ctx, buf, blen);
    }
    if cu == 91 {               // '[' — array
        p.pos = p.pos + 1;
        let arr_v = ctx_new_array(ctx, 0);
        ctx_push_temp_root(ctx, arr_v);
        let arr = zjs_as_array(arr_v);
        jp_skip_ws(p);
        if jp_peek(p) == ']' { p.pos = p.pos + 1; ctx_pop_temp_root(ctx); return arr_v; }
        while true {
            jp_skip_ws(p);
            let elem = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            array_set(arr, arr.length, elem);
            jp_skip_ws(p);
            let cc = jp_peek(p);
            if cc == ',' { p.pos = p.pos + 1; }
            else if cc == ']' { p.pos = p.pos + 1; break; }
            else { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
        }
        ctx_pop_temp_root(ctx);
        return arr_v;
    }
    if cu == 123 {              // '{' — object
        p.pos = p.pos + 1;
        let obj_v = ctx_new_object(ctx);
        ctx_push_temp_root(ctx, obj_v);
        let obj = zjs_as_object(obj_v);
        jp_skip_ws(p);
        if jp_peek(p) == '}' { p.pos = p.pos + 1; ctx_pop_temp_root(ctx); return obj_v; }
        while true {
            jp_skip_ws(p);
            // Key must be string.
            if jp_peek(p) != '"' { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
            let k_v = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            jp_skip_ws(p);
            if jp_peek(p) != ':' { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
            p.pos = p.pos + 1;
            jp_skip_ws(p);
            let val = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            // Use atom-interned key for property name (matches the
            // hidden-class convention).
            let ks = zjs_as_string(k_v);
            let key_atom = ctx_intern_atom(ctx, ks.data, ks.length);
            object_set(ctx, obj, key_atom, val);
            jp_skip_ws(p);
            let cc = jp_peek(p);
            if cc == ',' { p.pos = p.pos + 1; }
            else if cc == '}' { p.pos = p.pos + 1; break; }
            else { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
        }
        ctx_pop_temp_root(ctx);
        return obj_v;
    }
    // Number — optional '-', integer part, optional fraction, optional exponent.
    let is_negative = false;
    if cu == 45 { is_negative = true; p.pos = p.pos + 1; }
    let num_start = p.pos;
    let has_dot = false;
    let has_exp = false;
    while p.pos < p.len {
        let nc = p.src[p.pos];
        let nu = (u8)nc;
        if nu >= 48 && nu <= 57 { p.pos = p.pos + 1; }
        else if nu == 46 && !has_dot { has_dot = true; p.pos = p.pos + 1; }
        else if (nu == 101 || nu == 69) && !has_exp {
            has_exp = true; p.pos = p.pos + 1;
            if p.pos < p.len {
                let sn = (u8)p.src[p.pos];
                if sn == 43 || sn == 45 { p.pos = p.pos + 1; }
            }
        }
        else { break; }
    }
    if p.pos == num_start { p.fail = true; return zjs_undefined(); }
    // strtod the slice via a stack-buffered C string.
    let slice_len = p.pos - num_start;
    let parsed: f64 = 0.0;
    let src = p.src;
    let off = num_start;
    let sl = slice_len;
    raw {
        char buf[64];
        size_t n = sl < 63 ? sl : 63;
        memcpy(buf, src + off, n);
        buf[n] = '\0';
        parsed = strtod(buf, NULL);
    }
    if is_negative { parsed = -parsed; }
    // Prefer int32 representation if it fits.
    let as_int = (i32)parsed;
    if (f64)as_int == parsed { return zjs_int32(as_int); }
    return zjs_double(parsed);
}

fn host_json_parse(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    let p: JsonParser;
    p.src = s.data; p.len = s.length; p.pos = 0; p.fail = false;
    let result = jp_parse_value(ctx, &p);
    if p.fail { return zjs_undefined(); }
    jp_skip_ws(&p);
    if p.pos != s.length { return zjs_undefined(); }
    return result;
}

// --- console.log (Phase 3.8a) -------------------------------------
//
// Minimum console implementation: log / info / warn / error all print
// their args space-separated to stdout (warn/error to stderr) followed
// by a newline. Formatting roughly matches the CLI's `eval` printer.

raw {
    #include <stdio.h>
}

fn console_write_value(v: ZjsValue, stream_is_stderr: bool) -> void {
    if zjs_is_undefined(v) != 0 {
        raw {
            if (stream_is_stderr) fputs("undefined", stderr);
            else fputs("undefined", stdout);
        }
        return;
    }
    if zjs_is_null(v) != 0 {
        raw {
            if (stream_is_stderr) fputs("null", stderr);
            else fputs("null", stdout);
        }
        return;
    }
    if zjs_is_bool(v) != 0 {
        let b = zjs_as_bool(v);
        raw {
            if (stream_is_stderr) fputs(b ? "true" : "false", stderr);
            else fputs(b ? "true" : "false", stdout);
        }
        return;
    }
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw {
            if (stream_is_stderr) fprintf(stderr, "%d", (int)n);
            else fprintf(stdout, "%d", (int)n);
        }
        return;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        raw {
            if (stream_is_stderr) fprintf(stderr, "%g", d);
            else fprintf(stdout, "%g", d);
        }
        return;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let sd = s.data;
        let sn = s.length;
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            fwrite(sd, 1, sn, out);
        }
        return;
    }
    // For arrays/objects, defer to JSON.stringify-style output.
    // Simplest path: produce JSON output (skips functions). Reuses
    // json_stringify_value with a fresh buf so we don't fight the
    // CLI's pretty printer.
    if zjs_is_array(v) != 0 || zjs_is_object(v) != 0 {
        let b: JsonBuf;
        b.data = NULL; b.len = 0; b.cap = 0;
        // We need a context for atom interning during stringify. The
        // value isn't context-tagged, but json_stringify_value only
        // reads ctx for ToString of doubles inside numbers — none of
        // which happen for plain dump. Pass NULL and rely on the
        // cell-shape walk being self-contained.
        let nullctx: ZjsContext* = NULL;
        json_stringify_value(nullctx, &b, v);
        let bd = b.data;
        let bn = b.len;
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            if (bd && bn) fwrite(bd, 1, bn, out);
            free(bd);
        }
        return;
    }
    if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            fputs("[function]", out);
        }
        return;
    }
    raw {
        FILE* out = stream_is_stderr ? stderr : stdout;
        fputs("[unknown]", out);
    }
}

fn console_emit(ctx: ZjsContext*, args: ZjsValue*, argc: u32, stderr_stream: bool) -> ZjsValue {
    let i: u32 = 0;
    while i < argc {
        if i > 0 {
            raw {
                if (stderr_stream) fputc(' ', stderr);
                else fputc(' ', stdout);
            }
        }
        console_write_value(args[i], stderr_stream);
        i = i + 1;
    }
    raw {
        if (stderr_stream) fputc('\n', stderr);
        else fputc('\n', stdout);
    }
    return zjs_undefined();
}

fn host_console_log(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}

fn host_console_info(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}

fn host_console_warn(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, true);
}

fn host_console_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, true);
}

// Build a synthetic { name, message } error object — used to surface
// parse / compile / lookup failures as JS-visible throws. Also wires
// the object's proto to the same `<Type>.prototype` the user-callable
// constructor uses, so `e instanceof ReferenceError` works for our
// internally-thrown errors.
fn build_typed_error(ctx: ZjsContext*, type_name: char*, type_len: u32, msg: char*, msg_len: u32) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    // Defensive rooting: obj_v lives across multiple cell-allocating
    // helper calls below (intern, object_set with possible class
    // transitions, intern_string). Today GC only fires at interp
    // boundaries so we're not at real risk, but this insulates us
    // when item 1 (GC-in-allocator) lands — and from any future
    // refactor that adds a JS callback to this path.
    ctx_push_temp_root(ctx, obj_v);
    defer ctx_pop_temp_root(ctx);
    let obj = zjs_as_object(obj_v);
    // Set proto from the matching global error constructor's prototype.
    let ctor_slot = ctx_intern_global(ctx, type_name, type_len);
    let ctor_v = ctx.globals[ctor_slot].value;
    if zjs_is_host_function(ctor_v) != 0 {
        let hf = zjs_as_host_function(ctor_v);
        if hf.prototype == NULL {
            let pv = ctx_new_object(ctx);
            hf.prototype = zjs_as_object(pv);
        }
        obj.proto = hf.prototype;
    }
    let name_atom = ctx_intern_atom(ctx, (char*)"name", 4);
    let msg_atom  = ctx_intern_atom(ctx, (char*)"message", 7);
    let name_val_str = ctx_intern_atom(ctx, type_name, type_len);
    object_set(ctx, obj, name_atom, zjs_cell_from_ptr((void*)name_val_str));
    let msg_str = ctx_intern_string(ctx, msg, msg_len);
    object_set(ctx, obj, msg_atom, msg_str);
    return obj_v;
}

fn build_syntax_error(ctx: ZjsContext*, msg: char*) -> ZjsValue {
    let msg_len: u32 = 0;
    raw { msg_len = (uint32_t)strlen(msg); }
    return build_typed_error(ctx, (char*)"SyntaxError", 11, msg, msg_len);
}

fn build_reference_error(ctx: ZjsContext*, name: char*, name_len: u32) -> ZjsValue {
    let buf: char[256];
    let written: int = 0;
    let bp: char* = NULL;
    raw {
        bp = &buf[0];
        int n = (int)name_len; if (n > 200) n = 200;
        written = snprintf(bp, 256, "%.*s is not defined", n, name);
    }
    return build_typed_error(ctx, (char*)"ReferenceError", 14, bp, (u32)written);
}

fn build_type_error(ctx: ZjsContext*, msg: char*) -> ZjsValue {
    let msg_len: u32 = 0;
    raw { msg_len = (uint32_t)strlen(msg); }
    return build_typed_error(ctx, (char*)"TypeError", 9, msg, msg_len);
}

// --- Object.prototype methods (Phase 3.8c) -------------------------

// Object.prototype.hasOwnProperty(key) — checks own properties only,
// not the proto chain. Reads ctx.host_this for the receiver.
fn host_has_own_property(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_val = ctx.host_this;
    let key = args[0];
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let name = if zjs_is_string(key) != 0 { zjs_as_string(key) }
                   else                       { zjs_as_string(zjs_to_string(ctx, key)) };
        let slot = class_find_slot(o.cls, name);
        if slot >= 0 && zjs_is_deleted(o.slots[(u32)slot]) == 0 { return zjs_bool(1); }
        return zjs_bool(0);
    }
    if zjs_is_array(this_val) != 0 {
        let a = zjs_as_array(this_val);
        let idx = zjs_to_array_index(key);
        if idx >= 0 && (u32)idx < a.length { return zjs_bool(1); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_length: int = 0;
            raw { is_length = (kn == 6 && memcmp(kd, "length", 6) == 0) ? 1 : 0; }
            if is_length != 0 { return zjs_bool(1); }
        }
        return zjs_bool(0);
    }
    return zjs_bool(0);
}

// Object.prototype.toString() — returns "[object Object]" for most
// receivers. Cheap implementation.
fn host_object_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    let label: char* = (char*)"[object Object]";
    let label_len: u32 = 15;
    if zjs_is_undefined(this_val) != 0 { label = (char*)"[object Undefined]"; label_len = 18; }
    else if zjs_is_null(this_val) != 0 { label = (char*)"[object Null]";      label_len = 13; }
    else if zjs_is_array(this_val) != 0 { label = (char*)"[object Array]";    label_len = 14; }
    else if zjs_is_string(this_val) != 0 { label = (char*)"[object String]";  label_len = 15; }
    else if zjs_is_function(this_val) != 0 || zjs_is_closure(this_val) != 0 || zjs_is_host_function(this_val) != 0 {
        label = (char*)"[object Function]"; label_len = 17;
    }
    else if zjs_is_object(this_val) != 0 {
        // Check for our internal tag (Math/JSON/Arguments) — gives
        // `[object Math]` etc. Look up own prop only; the tag is
        // never inherited so a fast own-slot check is enough.
        let o = zjs_as_object(this_val);
        let tag_atom = ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN);
        let s = class_find_slot(o.cls, tag_atom);
        if s >= 0 {
            let tv = o.slots[(u32)s];
            if zjs_is_string(tv) != 0 {
                let tag_str = zjs_as_string(tv);
                let prefix = (char*)"[object ";
                let prefix_len: u32 = 8;
                let suffix_len: u32 = 1;
                let total = prefix_len + tag_str.length + suffix_len;
                let buf: char* = NULL;
                let td = tag_str.data;
                let tn = tag_str.length;
                raw {
                    buf = (char*)malloc(total + 1);
                    memcpy(buf, prefix, prefix_len);
                    memcpy(buf + prefix_len, td, tn);
                    buf[prefix_len + tn] = ']';
                    buf[total] = 0;
                }
                return ctx_intern_string_take(ctx, buf, total);
            }
        }
    }
    return ctx_intern_string(ctx, label, label_len);
}

// --- Array constructor + helpers (Phase 3.8c) ---------------------

fn host_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Array() / new Array() → []
    if argc == 0 { return ctx_new_array(ctx, 0); }
    // Array(N) where N is a non-negative integer → array of length N.
    if argc == 1 {
        let v = args[0];
        if zjs_is_int32(v) != 0 {
            let n = zjs_as_int32(v);
            if n < 0 {
                // ECMA-262: RangeError; MVP returns empty.
                return ctx_new_array(ctx, 0);
            }
            let arr_v = ctx_new_array(ctx, (u32)n);
            let arr = zjs_as_array(arr_v);
            arr.length = (u32)n;
            return arr_v;
        }
        if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let n2 = (i64)d;
            if (f64)n2 == d && n2 >= 0 {
                let arr_v = ctx_new_array(ctx, (u32)n2);
                let arr = zjs_as_array(arr_v);
                arr.length = (u32)n2;
                return arr_v;
            }
            return ctx_new_array(ctx, 0);
        }
        // Single non-numeric arg → array containing that value.
        let arr_v = ctx_new_array(ctx, 1);
        let arr = zjs_as_array(arr_v);
        arr.elements[0] = v;
        arr.length = 1;
        return arr_v;
    }
    // Variadic — copy args into a fresh array.
    let arr_v = ctx_new_array(ctx, argc);
    let arr = zjs_as_array(arr_v);
    let i: u32 = 0;
    while i < argc {
        arr.elements[i] = args[i];
        i = i + 1;
    }
    arr.length = argc;
    return arr_v;
}

fn host_array_is_array(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    return zjs_bool(zjs_is_array(args[0]));
}

// --- Function.prototype.{call, apply} (Phase 3.8d) -----------------
//
// `f.call(thisArg, ...args)` and `f.apply(thisArg, argArray)` are
// dispatched as MethodInvoke on f. ctx.host_this at entry is `f`
// itself (the receiver of `.call`/`.apply`). We extract the caller-
// supplied `this` (args[0]) and dispatch the original `f` with it.

raw {
    extern ZjsValue zjs_call_value_with_this(ZjsContext* ctx, ZjsValue callee, ZjsValue this_val, ZjsValue* args, uint32_t argc);
}

fn host_function_call(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target = ctx.host_this;
    let new_this: ZjsValue = zjs_undefined();
    let new_args_ptr: ZjsValue* = NULL;
    let new_argc: u32 = 0;
    if argc >= 1 { new_this = args[0]; }
    if argc >= 2 {
        raw { new_args_ptr = &args[1]; }
        new_argc = argc - 1;
    }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, target, new_this, new_args_ptr, new_argc); }
    return r;
}

fn host_function_apply(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target = ctx.host_this;
    let new_this: ZjsValue = zjs_undefined();
    if argc >= 1 { new_this = args[0]; }
    // Second arg is an array (or null/undefined for no args).
    let new_argc: u32 = 0;
    let new_args_ptr: ZjsValue* = NULL;
    if argc >= 2 && zjs_is_array(args[1]) != 0 {
        let a = zjs_as_array(args[1]);
        new_argc = a.length;
        new_args_ptr = a.elements;
    }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, target, new_this, new_args_ptr, new_argc); }
    return r;
}

// --- Coercion-style constructors (Phase 3.8c) ----------------------
//
// MVP: `Boolean(x)` / `Number(x)` / `String(x)` perform the standard
// ToX coercion. `new Boolean(x)` etc. would normally create a wrapper
// object; we don't model wrapper objects and return the primitive
// instead — close enough for the conformance tests that call them.

// Hidden slot used by the wrapper-object form (`new Number(x)` etc.)
// to stash the primitive value behind a property name that user code
// won't bump into. Read by the prototype's valueOf / toString.
def WRAPPER_VALUE_KEY: char* = (char*)"__zjs_primitive__";
def WRAPPER_VALUE_KEY_LEN: u32 = 17;

// Hidden slot used by closure envs to chain to the enclosing
// function's env. Used by deeply-nested closures to walk past their
// immediate parent (Phase 3.9j).
def OUTER_ENV_KEY: char* = (char*)"__zjs_outer_env__";
def OUTER_ENV_KEY_LEN: u32 = 17;

// Internal class-name tag used by Object.prototype.toString to return
// `[object Math]` / `[object JSON]` / `[object Arguments]` for the
// few specific built-in objects that have a fixed toString tag in the
// spec but aren't a distinct cell type in our taxonomy. Symbol-keyed
// `Symbol.toStringTag` will replace this once we have Symbols.
def TAG_NAME_KEY: char* = (char*)"__zjs_tag__";
def TAG_NAME_KEY_LEN: u32 = 11;

// ECMA-262 §7.1.18 ToObject. Wraps primitives in their corresponding
// wrapper objects (so `Array.prototype.X.call(true, ...)` sees an
// object). For null/undefined, sets ctx.had_error and returns
// undefined — callers should propagate as TypeError.
//
// Already-object values (object/array/function/closure/host-function)
// pass through unchanged.
fn ctx_to_object(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    if zjs_is_object(v) != 0 { return v; }
    if zjs_is_array(v) != 0 { return v; }
    if zjs_is_function(v) != 0 { return v; }
    if zjs_is_closure(v) != 0 { return v; }
    if zjs_is_host_function(v) != 0 { return v; }

    if zjs_is_null(v) != 0 || zjs_is_undefined(v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.had_error = true;
        ctx.last_error = err;
        return zjs_undefined();
    }

    // Primitive — wrap it. Pick the right prototype based on tag.
    let proto: ZjsObject* = NULL;
    if zjs_is_bool(v) != 0 {
        // Boolean.prototype via the Boolean host function's .prototype.
        let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
        if bool_g >= 0 {
            let bv = ctx.globals[bool_g].value;
            if zjs_is_host_function(bv) != 0 {
                proto = zjs_as_host_function(bv).prototype;
            }
        }
    } else if zjs_is_int32(v) != 0 || zjs_is_double(v) != 0 {
        let num_g = ctx_find_global(ctx, (char*)"Number", 6);
        if num_g >= 0 {
            let nv = ctx.globals[num_g].value;
            if zjs_is_host_function(nv) != 0 {
                proto = zjs_as_host_function(nv).prototype;
            }
        }
    } else if zjs_is_string(v) != 0 {
        proto = ctx.string_proto;
    }

    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    obj.proto = proto;
    let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
    object_set(ctx, obj, key, v);
    return obj_v;
}

fn wrap_primitive_if_new(ctx: ZjsContext*, primitive: ZjsValue) -> ZjsValue {
    // If invoked via `new`, NewInvoke set ctx.host_this to a fresh
    // object with proto = ctor.prototype. Attach the primitive as a
    // hidden own property and return the wrapper. Otherwise return
    // the primitive directly (plain call).
    if zjs_is_object(ctx.host_this) != 0 {
        let obj = zjs_as_object(ctx.host_this);
        let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        object_set(ctx, obj, key, primitive);
        return ctx.host_this;
    }
    return primitive;
}

fn host_boolean(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc == 0 { zjs_bool(0) } else { zjs_bool(zjs_to_bool_coerce(args[0])) };
    return wrap_primitive_if_new(ctx, v);
}

fn host_number(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let n: ZjsValue = zjs_int32(0);
    if argc > 0 {
        let d = zjs_to_double(args[0]);
        let as_int = (i32)d;
        if (f64)as_int == d { n = zjs_int32(as_int); }
        else { n = zjs_double(d); }
    }
    return wrap_primitive_if_new(ctx, n);
}

fn host_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s: ZjsValue = if argc == 0 { ctx_intern_string(ctx, (char*)"", 0) }
                      else         { zjs_to_string(ctx, args[0]) };
    return wrap_primitive_if_new(ctx, s);
}

// Prototype methods that unwrap the boxed primitive. Read host_this's
// hidden slot if it's a wrapper object; otherwise return host_this as-is
// (so e.g. `(123).valueOf()` would also work once we auto-box later).
fn host_wrapper_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        let v = object_get(o, key);
        if zjs_is_undefined(v) == 0 { return v; }
    }
    return this_val;
}

fn host_wrapper_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = host_wrapper_value_of(ctx, args, argc);
    if zjs_is_string(v) != 0 { return v; }
    return zjs_to_string(ctx, v);
}

// String.fromCharCode(...codes) — build a string from numeric char codes.
// MVP: ASCII only, takes each arg's truncated u8.
fn host_string_from_char_code(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let buf: char* = NULL;
    let n = argc;
    raw { buf = (char*)malloc(n + 1); }
    let i: u32 = 0;
    while i < argc {
        let cu = (u8)((u32)zjs_to_double(args[i]) & 255);
        buf[i] = (char)cu;
        i = i + 1;
    }
    raw { buf[n] = 0; }
    return ctx_intern_string_take(ctx, buf, argc);
}

// --- Error subtypes (Phase 3.8c) ----------------------------------
//
// ReferenceError / TypeError / RangeError — each builds an object
// shaped like Error but with a different `.name`. Used both as
// constructors in tests and as the second arg to `assert.throws`.

fn make_named_error(ctx: ZjsContext*, name: char*, name_len: u32, args: ZjsValue*, argc: u32) -> ZjsValue {
    // When invoked via `new Foo(...)`, NewInvoke has already allocated
    // a fresh object with `proto = Foo.prototype` and bound it as
    // ctx.host_this. Decorating that object preserves the proto link
    // so `instanceof Foo` works.
    //
    // When called as a plain function (`Error(...)` / `TypeError(...)`),
    // ECMA-262 still requires the result to be a proper Error subclass
    // instance. Look up the constructor by name and seed obj.proto so
    // `err instanceof TypeError` works for the non-new form too.
    let obj_v: ZjsValue = ctx.host_this;
    if zjs_is_object(obj_v) == 0 {
        obj_v = ctx_new_object(ctx);
        let ctor_slot = ctx_find_global(ctx, name, name_len);
        if ctor_slot >= 0 {
            let ctor_v = ctx.globals[ctor_slot].value;
            if zjs_is_host_function(ctor_v) != 0 {
                let hf = zjs_as_host_function(ctor_v);
                if hf.prototype != NULL {
                    zjs_as_object(obj_v).proto = hf.prototype;
                }
            }
        }
    }
    // Defensive rooting: obj_v is either ctx.host_this (already rooted)
    // or a fresh object held across several cell-allocating calls
    // below. Pushing in both cases is safe and one-liner — host_this is
    // already on the temp_roots path conceptually.
    ctx_push_temp_root(ctx, obj_v);
    defer ctx_pop_temp_root(ctx);
    let obj = zjs_as_object(obj_v);
    let msg: ZjsValue = zjs_undefined();
    if argc > 0 { msg = args[0]; }
    if zjs_is_string(msg) == 0 { msg = zjs_to_string(ctx, msg); }
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"message", 7), msg);
    let name_str = ctx_intern_atom(ctx, name, name_len);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"name", 4),
               zjs_cell_from_ptr((void*)name_str));
    return obj_v;
}

fn host_reference_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"ReferenceError", 14, args, argc);
}
fn host_type_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"TypeError", 9, args, argc);
}
fn host_range_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"RangeError", 10, args, argc);
}
fn host_syntax_error_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"SyntaxError", 11, args, argc);
}
fn host_uri_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"URIError", 8, args, argc);
}
fn host_eval_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"EvalError", 9, args, argc);
}

// Stub for `eval` — we don't implement runtime eval; return undefined.
// Many tests reference `eval` only for environment checks.
fn host_eval_stub(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return zjs_undefined();
}

// --- Global Number-coercion helpers (Phase 3.8b) -------------------

fn host_is_nan(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(1); }
    let d = zjs_to_double(args[0]);
    let is_nan: int = 0;
    raw { is_nan = (d != d) ? 1 : 0; }
    return zjs_bool(is_nan);
}

fn host_is_finite(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let d = zjs_to_double(args[0]);
    let is_fin: int = 0;
    raw { is_fin = isfinite(d) ? 1 : 0; }
    return zjs_bool(is_fin);
}

fn host_parse_float(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    let sd = s.data;
    let parsed: f64 = 0.0;
    let n_consumed: int = 0;
    raw {
        char* endp = NULL;
        parsed = strtod(sd, &endp);
        n_consumed = (int)(endp - sd);
    }
    if n_consumed == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let as_int = (i32)parsed;
    if (f64)as_int == parsed { return zjs_int32(as_int); }
    return zjs_double(parsed);
}

fn host_parse_int(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    // ECMA-262: if radix is 0/undefined AND the string starts with 0x,
    // radix is 16; else 10. Start at 0 ("unset") and resolve below.
    let radix: int = 0;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let r = (i32)zjs_to_double(args[1]);
        if r != 0 { radix = (int)r; }
    }
    let sd = s.data;
    let parsed: i64 = 0;
    let n_consumed: int = 0;
    raw {
        char* endp = NULL;
        // Skip leading whitespace.
        const char* p = sd;
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' || *p == '\v' || *p == '\f') p++;
        // Optional sign.
        int neg = 0;
        if (*p == '-') { neg = 1; p++; }
        else if (*p == '+') p++;
        // 0x / 0X prefix selects hex.
        int rdx = radix;
        if ((rdx == 0 || rdx == 16) && p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
            p += 2;
            rdx = 16;
        }
        if (rdx == 0) rdx = 10;
        parsed = strtoll(p, &endp, rdx);
        n_consumed = (int)(endp - p);
        if (neg) parsed = -parsed;
    }
    if n_consumed == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    if parsed >= -2147483648 && parsed <= 2147483647 {
        return zjs_int32((i32)parsed);
    }
    return zjs_double((f64)parsed);
}

fn ctx_init_builtins(ctx: ZjsContext*) -> void {
    // --- Function.prototype.{call, apply} cached helpers (Phase 3.8d)
    let fcall_ptr:  void* = NULL; raw { fcall_ptr  = (void*)host_function_call; }
    let fapply_ptr: void* = NULL; raw { fapply_ptr = (void*)host_function_apply; }
    ctx.fn_call_v  = ctx_make_host_function(ctx, (char*)"call",  fcall_ptr);
    ctx.fn_apply_v = ctx_make_host_function(ctx, (char*)"apply", fapply_ptr);

    // --- Object.prototype (Phase 3.8c) ---
    // Bootstrap order: create this FIRST so every later ctx_new_object
    // call gets it as a default proto. ctx_new_object short-circuits
    // for the object_proto itself (whose proto stays NULL).
    let obj_proto_v = ctx_new_object(ctx);
    ctx.object_proto = zjs_as_object(obj_proto_v);
    let hop_ptr: void* = NULL; raw { hop_ptr = (void*)host_has_own_property; }
    let ots_ptr: void* = NULL; raw { ots_ptr = (void*)host_object_to_string; }
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"hasOwnProperty", 14),
               ctx_make_host_function(ctx, (char*)"hasOwnProperty", hop_ptr));
    object_set(ctx, ctx.object_proto,
               ctx_intern_atom(ctx, (char*)"toString", 8),
               ctx_make_host_function(ctx, (char*)"toString", ots_ptr));

    // --- Error ---
    let err_ptr: void* = NULL;
    raw { err_ptr = (void*)host_error; }
    ctx_register_host_function(ctx, (char*)"Error", err_ptr);

    // --- Numeric global constants (Phase 3.8b) ---
    let nan_d: f64 = 0.0;
    raw { nan_d = (double)NAN; }
    let nan_slot = ctx_intern_global(ctx, (char*)"NaN", 3);
    ctx.globals[nan_slot].value = zjs_double(nan_d);
    ctx.globals[nan_slot].defined = true;
    let inf_d: f64 = 0.0;
    raw { inf_d = (double)INFINITY; }
    let inf_slot = ctx_intern_global(ctx, (char*)"Infinity", 8);
    ctx.globals[inf_slot].value = zjs_double(inf_d);
    ctx.globals[inf_slot].defined = true;
    let undef_slot = ctx_intern_global(ctx, (char*)"undefined", 9);
    ctx.globals[undef_slot].value = zjs_undefined();
    ctx.globals[undef_slot].defined = true;

    // --- Global Number-coercion functions ---
    let isnan_ptr:   void* = NULL; raw { isnan_ptr   = (void*)host_is_nan; }
    let isfin_ptr:   void* = NULL; raw { isfin_ptr   = (void*)host_is_finite; }
    let pflt_ptr:    void* = NULL; raw { pflt_ptr    = (void*)host_parse_float; }
    let pint_ptr:    void* = NULL; raw { pint_ptr    = (void*)host_parse_int; }
    ctx_register_host_function(ctx, (char*)"isNaN",      isnan_ptr);
    ctx_register_host_function(ctx, (char*)"isFinite",   isfin_ptr);
    ctx_register_host_function(ctx, (char*)"parseFloat", pflt_ptr);
    ctx_register_host_function(ctx, (char*)"parseInt",   pint_ptr);

    // --- Array constructor + Array.isArray (Phase 3.8c) ---
    let arr_ctor_ptr: void* = NULL; raw { arr_ctor_ptr = (void*)host_array_ctor; }
    let arr_ctor_v = ctx_register_host_function(ctx, (char*)"Array", arr_ctor_ptr);
    let arr_ctor = zjs_as_host_function(arr_ctor_v);
    let arr_is_ptr: void* = NULL; raw { arr_is_ptr = (void*)host_array_is_array; }
    let is_array_v = ctx_make_host_function(ctx, (char*)"isArray", arr_is_ptr);
    // Attach isArray to Array via the host function's `props` bag.
    let isarray_atom = ctx_intern_atom(ctx, (char*)"isArray", 7);
    let props_v = ctx_new_object(ctx);
    arr_ctor.props = zjs_as_object(props_v);
    object_set(ctx, arr_ctor.props, isarray_atom, is_array_v);
    // Array.prototype is unified with ctx.array_proto below, after
    // the prototype object is fully populated.

    // --- Coercion-style constructors + Error subtypes (Phase 3.8c) ---
    let bool_ptr:    void* = NULL; raw { bool_ptr    = (void*)host_boolean; }
    let num_ptr:     void* = NULL; raw { num_ptr     = (void*)host_number; }
    let str_ptr:     void* = NULL; raw { str_ptr     = (void*)host_string; }
    let referr_ptr:  void* = NULL; raw { referr_ptr  = (void*)host_reference_error; }
    let typerr_ptr:  void* = NULL; raw { typerr_ptr  = (void*)host_type_error; }
    let rngerr_ptr:  void* = NULL; raw { rngerr_ptr  = (void*)host_range_error; }
    let eval_ptr:    void* = NULL; raw { eval_ptr    = (void*)host_eval_stub; }
    let bool_full = ctx_register_host_function(ctx, (char*)"Boolean", bool_ptr);
    let num_full  = ctx_register_host_function(ctx, (char*)"Number",  num_ptr);
    let strv_full = ctx_register_host_function(ctx, (char*)"String",  str_ptr);
    // Attach String.fromCharCode via .props on the constructor.
    let strv_hf = zjs_as_host_function(strv_full);
    let fcc_ptr: void* = NULL; raw { fcc_ptr = (void*)host_string_from_char_code; }
    let fcc_v = ctx_make_host_function(ctx, (char*)"fromCharCode", fcc_ptr);
    if strv_hf.props == NULL {
        let pv = ctx_new_object(ctx);
        strv_hf.props = zjs_as_object(pv);
    }
    object_set(ctx, strv_hf.props,
               ctx_intern_atom(ctx, (char*)"fromCharCode", 12), fcc_v);
    // Phase 3.8i — wrapper-object prototypes.
    //   new Number(x)  → { __zjs_primitive__: x } with proto = Number.prototype.
    // The prototype carries valueOf / toString that unwrap the slot,
    // so `new Number(1) + 1` triggers ToPrimitive → valueOf → 1 → 2.
    let wv_ptr: void* = NULL; raw { wv_ptr = (void*)host_wrapper_value_of; }
    let wt_ptr: void* = NULL; raw { wt_ptr = (void*)host_wrapper_to_string; }
    let bool_hf = zjs_as_host_function(bool_full);
    let num_hf  = zjs_as_host_function(num_full);
    let valueof_atom  = ctx_intern_atom(ctx, (char*)"valueOf",  7);
    let tostring_atom = ctx_intern_atom(ctx, (char*)"toString", 8);
    // Boolean.prototype
    let bp = ctx_new_object(ctx);
    bool_hf.prototype = zjs_as_object(bp);
    object_set(ctx, bool_hf.prototype, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, bool_hf.prototype, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));
    // Number.prototype
    let np = ctx_new_object(ctx);
    num_hf.prototype = zjs_as_object(np);
    object_set(ctx, num_hf.prototype, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, num_hf.prototype, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));
    // Number.* static constants (ECMA-262 §21.1.2).
    if num_hf.props == NULL {
        let pv = ctx_new_object(ctx);
        num_hf.props = zjs_as_object(pv);
    }
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MAX_VALUE",         9),
               zjs_double(1.7976931348623157e+308));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MIN_VALUE",         9),
               zjs_double(5e-324));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"POSITIVE_INFINITY", 17),
               zjs_double(1.0 / 0.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"NEGATIVE_INFINITY", 17),
               zjs_double(-1.0 / 0.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"NaN",                3),
               zjs_double(0.0 / 0.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"EPSILON",            7),
               zjs_double(2.220446049250313e-16));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MAX_SAFE_INTEGER",  16),
               zjs_double(9007199254740991.0));
    object_set(ctx, num_hf.props, ctx_intern_atom(ctx, (char*)"MIN_SAFE_INTEGER",  16),
               zjs_double(-9007199254740991.0));
    // String.prototype (existing one — keep its methods, add valueOf/toString)
    if strv_hf.prototype == NULL {
        let sp = ctx_new_object(ctx);
        strv_hf.prototype = zjs_as_object(sp);
    }
    object_set(ctx, strv_hf.prototype, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, strv_hf.prototype, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));
    let referr_v = ctx_register_host_function(ctx, (char*)"ReferenceError", referr_ptr);
    let typerr_v = ctx_register_host_function(ctx, (char*)"TypeError",      typerr_ptr);
    let rngerr_v = ctx_register_host_function(ctx, (char*)"RangeError",     rngerr_ptr);

    // Chain *Error.prototype → Error.prototype so `new TypeError instanceof Error` etc.
    // Lazily create each prototype, then set its proto.
    let err_slot = ctx_find_global(ctx, (char*)"Error", 5);
    if err_slot >= 0 {
        let err_v = ctx.globals[err_slot].value;
        if zjs_is_host_function(err_v) != 0 {
            let err_hf = zjs_as_host_function(err_v);
            if err_hf.prototype == NULL {
                let p_v = ctx_new_object(ctx);
                err_hf.prototype = zjs_as_object(p_v);
            }
            let err_proto = err_hf.prototype;
            // Subclass each *Error.prototype to inherit from Error.prototype.
            let subs: ZjsValue[3];
            subs[0] = referr_v; subs[1] = typerr_v; subs[2] = rngerr_v;
            let i: u32 = 0;
            while i < 3 {
                let hv = subs[i];
                if zjs_is_host_function(hv) != 0 {
                    let hf = zjs_as_host_function(hv);
                    if hf.prototype == NULL {
                        let pp_v = ctx_new_object(ctx);
                        hf.prototype = zjs_as_object(pp_v);
                    }
                    hf.prototype.proto = err_proto;
                }
                i = i + 1;
            }
        }
    }
    ctx_register_host_function(ctx, (char*)"eval",           eval_ptr);

    // Stub globals for unsupported features. Their tests use the
    // names without expecting full semantics — registering them as
    // host-function no-ops at least avoids ReferenceError-on-load.
    ctx_register_host_function(ctx, (char*)"Function",   eval_ptr);
    ctx_register_host_function(ctx, (char*)"Date",       eval_ptr);
    ctx_register_host_function(ctx, (char*)"RegExp",     eval_ptr);
    ctx_register_host_function(ctx, (char*)"Symbol",     eval_ptr);
    ctx_register_host_function(ctx, (char*)"Map",        eval_ptr);
    ctx_register_host_function(ctx, (char*)"Set",        eval_ptr);
    ctx_register_host_function(ctx, (char*)"WeakMap",    eval_ptr);
    ctx_register_host_function(ctx, (char*)"WeakSet",    eval_ptr);
    ctx_register_host_function(ctx, (char*)"Promise",    eval_ptr);
    ctx_register_host_function(ctx, (char*)"Proxy",      eval_ptr);
    ctx_register_host_function(ctx, (char*)"ArrayBuffer", eval_ptr);
    ctx_register_host_function(ctx, (char*)"Uint8Array",  eval_ptr);
    ctx_register_host_function(ctx, (char*)"Int8Array",   eval_ptr);
    ctx_register_host_function(ctx, (char*)"Uint16Array", eval_ptr);
    ctx_register_host_function(ctx, (char*)"Int16Array",  eval_ptr);
    ctx_register_host_function(ctx, (char*)"Uint32Array", eval_ptr);
    ctx_register_host_function(ctx, (char*)"Int32Array",  eval_ptr);
    ctx_register_host_function(ctx, (char*)"Float32Array", eval_ptr);
    ctx_register_host_function(ctx, (char*)"Float64Array", eval_ptr);
    ctx_register_host_function(ctx, (char*)"BigInt",      eval_ptr);
    ctx_register_host_function(ctx, (char*)"Uint8ClampedArray", eval_ptr);
    ctx_register_host_function(ctx, (char*)"BigInt64Array",     eval_ptr);
    ctx_register_host_function(ctx, (char*)"BigUint64Array",    eval_ptr);
    ctx_register_host_function(ctx, (char*)"DataView",          eval_ptr);
    ctx_register_host_function(ctx, (char*)"WeakRef",           eval_ptr);
    ctx_register_host_function(ctx, (char*)"FinalizationRegistry", eval_ptr);
    let synerr_ptr:  void* = NULL; raw { synerr_ptr  = (void*)host_syntax_error_ctor; }
    let urierr_ptr:  void* = NULL; raw { urierr_ptr  = (void*)host_uri_error; }
    let evlerr_ptr:  void* = NULL; raw { evlerr_ptr  = (void*)host_eval_error; }
    ctx_register_host_function(ctx, (char*)"EvalError",   evlerr_ptr);
    ctx_register_host_function(ctx, (char*)"URIError",    urierr_ptr);
    ctx_register_host_function(ctx, (char*)"SyntaxError", synerr_ptr);
    // $262 — test262's per-context helper object. We don't implement
    // any of its methods; register as a plain empty object.
    let t262_v = ctx_new_object(ctx);
    let t262_slot = ctx_intern_global(ctx, (char*)"$262", 4);
    ctx.globals[t262_slot].value = t262_v;
    ctx.globals[t262_slot].defined = true;

    // --- Math object with several method properties ---
    let math_v = ctx_new_object(ctx);
    let math   = zjs_as_object(math_v);
    // Tag so Object.prototype.toString.call(Math) returns "[object Math]".
    object_set(ctx, math, ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN),
               ctx_intern_string(ctx, (char*)"Math", 4));

    let abs_ptr:   void* = NULL; raw { abs_ptr   = (void*)host_math_abs; }
    let floor_ptr: void* = NULL; raw { floor_ptr = (void*)host_math_floor; }
    let ceil_ptr:  void* = NULL; raw { ceil_ptr  = (void*)host_math_ceil; }
    let round_ptr: void* = NULL; raw { round_ptr = (void*)host_math_round; }
    let sqrt_ptr:  void* = NULL; raw { sqrt_ptr  = (void*)host_math_sqrt; }
    let pow_ptr:   void* = NULL; raw { pow_ptr   = (void*)host_math_pow; }
    let max_ptr:   void* = NULL; raw { max_ptr   = (void*)host_math_max; }
    let min_ptr:   void* = NULL; raw { min_ptr   = (void*)host_math_min; }

    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"abs", 3),
               ctx_make_host_function(ctx, (char*)"abs", abs_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"floor", 5),
               ctx_make_host_function(ctx, (char*)"floor", floor_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"ceil", 4),
               ctx_make_host_function(ctx, (char*)"ceil", ceil_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"round", 5),
               ctx_make_host_function(ctx, (char*)"round", round_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"sqrt", 4),
               ctx_make_host_function(ctx, (char*)"sqrt", sqrt_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"pow", 3),
               ctx_make_host_function(ctx, (char*)"pow", pow_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"max", 3),
               ctx_make_host_function(ctx, (char*)"max", max_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"min", 3),
               ctx_make_host_function(ctx, (char*)"min", min_ptr));

    let math_slot = ctx_intern_global(ctx, (char*)"Math", 4);
    ctx.globals[math_slot].value = math_v;
    ctx.globals[math_slot].defined = true;

    // --- Object as a host-function constructor (Phase 3.8d) ---
    // Was a plain namespace object before; now a host function so
    // `{} instanceof Object` works and `new Object()` is meaningful.
    // Static methods (keys / create / getPrototypeOf) live on .props.
    let obj_ctor_ptr: void* = NULL; raw { obj_ctor_ptr = (void*)host_object_ctor; }
    let object_v = ctx_register_host_function(ctx, (char*)"Object", obj_ctor_ptr);
    let object_hf = zjs_as_host_function(object_v);
    object_hf.prototype = ctx.object_proto;
    let keys_ptr:   void* = NULL; raw { keys_ptr   = (void*)host_object_keys; }
    let create_ptr: void* = NULL; raw { create_ptr = (void*)host_object_create; }
    let gpo_ptr:    void* = NULL; raw { gpo_ptr    = (void*)host_object_get_prototype_of; }
    let obj_props_v = ctx_new_object(ctx);
    object_hf.props = zjs_as_object(obj_props_v);
    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"keys", 4),
               ctx_make_host_function(ctx, (char*)"keys", keys_ptr));
    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"create", 6),
               ctx_make_host_function(ctx, (char*)"create", create_ptr));
    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"getPrototypeOf", 14),
               ctx_make_host_function(ctx, (char*)"getPrototypeOf", gpo_ptr));
    // Phase 3.9a — Object.defineProperty / defineProperties /
    // getOwnPropertyDescriptor.
    let dp_ptr:   void* = NULL; raw { dp_ptr   = (void*)host_object_define_property; }
    let dps_ptr:  void* = NULL; raw { dps_ptr  = (void*)host_object_define_properties; }
    let gopd_ptr: void* = NULL; raw { gopd_ptr = (void*)host_object_get_own_property_descriptor; }
    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"defineProperty", 14),
               ctx_make_host_function(ctx, (char*)"defineProperty", dp_ptr));
    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"defineProperties", 16),
               ctx_make_host_function(ctx, (char*)"defineProperties", dps_ptr));
    object_set(ctx, object_hf.props, ctx_intern_atom(ctx, (char*)"getOwnPropertyDescriptor", 24),
               ctx_make_host_function(ctx, (char*)"getOwnPropertyDescriptor", gopd_ptr));

    // --- Array.prototype intercept (Phase 3.5) ---
    let array_proto_v = ctx_new_object(ctx);
    let array_proto = zjs_as_object(array_proto_v);
    let push_ptr:  void* = NULL; raw { push_ptr  = (void*)host_array_push; }
    let pop_ptr:   void* = NULL; raw { pop_ptr   = (void*)host_array_pop; }
    let aidx_ptr:  void* = NULL; raw { aidx_ptr  = (void*)host_array_index_of; }
    let map_ptr:   void* = NULL; raw { map_ptr   = (void*)host_array_map; }
    let fe_ptr:    void* = NULL; raw { fe_ptr    = (void*)host_array_for_each; }
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"push", 4),
               ctx_make_host_function(ctx, (char*)"push", push_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"pop", 3),
               ctx_make_host_function(ctx, (char*)"pop", pop_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"indexOf", 7),
               ctx_make_host_function(ctx, (char*)"indexOf", aidx_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"map", 3),
               ctx_make_host_function(ctx, (char*)"map", map_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"forEach", 7),
               ctx_make_host_function(ctx, (char*)"forEach", fe_ptr));
    let join_ptr:   void* = NULL; raw { join_ptr   = (void*)host_array_join; }
    let aslice_ptr: void* = NULL; raw { aslice_ptr = (void*)host_array_slice; }
    let aconc_ptr:  void* = NULL; raw { aconc_ptr  = (void*)host_array_concat; }
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"join", 4),
               ctx_make_host_function(ctx, (char*)"join", join_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"slice", 5),
               ctx_make_host_function(ctx, (char*)"slice", aslice_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"concat", 6),
               ctx_make_host_function(ctx, (char*)"concat", aconc_ptr));
    ctx.array_proto = array_proto;
    // Unify with the Array constructor's .prototype (set lazily here so
    // `Array.prototype.push.call(arr, x)` and similar find our method
    // table).
    arr_ctor.prototype = array_proto;

    // --- String.prototype intercept (Phase 3.5) ---
    let string_proto_v = ctx_new_object(ctx);
    let string_proto = zjs_as_object(string_proto_v);
    let sidx_ptr:   void* = NULL; raw { sidx_ptr   = (void*)host_string_index_of; }
    let slice_ptr:  void* = NULL; raw { slice_ptr  = (void*)host_string_slice; }
    let split_ptr:  void* = NULL; raw { split_ptr  = (void*)host_string_split; }
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"indexOf", 7),
               ctx_make_host_function(ctx, (char*)"indexOf", sidx_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"slice", 5),
               ctx_make_host_function(ctx, (char*)"slice", slice_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"split", 5),
               ctx_make_host_function(ctx, (char*)"split", split_ptr));
    let scat_ptr:   void* = NULL; raw { scat_ptr   = (void*)host_string_concat; }
    let scha_ptr:   void* = NULL; raw { scha_ptr   = (void*)host_string_char_at; }
    let scca_ptr:   void* = NULL; raw { scca_ptr   = (void*)host_string_char_code_at; }
    let suc_ptr:    void* = NULL; raw { suc_ptr    = (void*)host_string_to_upper_case; }
    let slc_ptr:    void* = NULL; raw { slc_ptr    = (void*)host_string_to_lower_case; }
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"concat", 6),
               ctx_make_host_function(ctx, (char*)"concat", scat_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"charAt", 6),
               ctx_make_host_function(ctx, (char*)"charAt", scha_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"charCodeAt", 10),
               ctx_make_host_function(ctx, (char*)"charCodeAt", scca_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"toUpperCase", 11),
               ctx_make_host_function(ctx, (char*)"toUpperCase", suc_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"toLowerCase", 11),
               ctx_make_host_function(ctx, (char*)"toLowerCase", slc_ptr));
    ctx.string_proto = string_proto;
    // Unify with the String constructor's .prototype so
    // `new String(x).slice(...)` reaches the same methods as a
    // primitive string's `.slice(...)`.
    strv_hf.prototype = string_proto;
    // Re-attach valueOf/toString (the host_wrapper_* funcs) onto the
    // unified prototype.
    object_set(ctx, string_proto, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, string_proto, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));

    // --- JSON namespace (Phase 3.5b) ---
    let json_v = ctx_new_object(ctx);
    let json_o = zjs_as_object(json_v);
    object_set(ctx, json_o, ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN),
               ctx_intern_string(ctx, (char*)"JSON", 4));
    let stringify_ptr: void* = NULL; raw { stringify_ptr = (void*)host_json_stringify; }
    let parse_ptr:     void* = NULL; raw { parse_ptr     = (void*)host_json_parse; }
    object_set(ctx, json_o, ctx_intern_atom(ctx, (char*)"stringify", 9),
               ctx_make_host_function(ctx, (char*)"stringify", stringify_ptr));
    object_set(ctx, json_o, ctx_intern_atom(ctx, (char*)"parse", 5),
               ctx_make_host_function(ctx, (char*)"parse", parse_ptr));
    let json_slot = ctx_intern_global(ctx, (char*)"JSON", 4);
    ctx.globals[json_slot].value = json_v;
    ctx.globals[json_slot].defined = true;

    // --- console (Phase 3.8a) ---
    let console_v = ctx_new_object(ctx);
    let console_o = zjs_as_object(console_v);
    let log_ptr:   void* = NULL; raw { log_ptr   = (void*)host_console_log; }
    let info_ptr:  void* = NULL; raw { info_ptr  = (void*)host_console_info; }
    let warn_ptr:  void* = NULL; raw { warn_ptr  = (void*)host_console_warn; }
    let cerr_ptr:  void* = NULL; raw { cerr_ptr  = (void*)host_console_error; }
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"log", 3),
               ctx_make_host_function(ctx, (char*)"log", log_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"info", 4),
               ctx_make_host_function(ctx, (char*)"info", info_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"warn", 4),
               ctx_make_host_function(ctx, (char*)"warn", warn_ptr));
    object_set(ctx, console_o, ctx_intern_atom(ctx, (char*)"error", 5),
               ctx_make_host_function(ctx, (char*)"error", cerr_ptr));
    let console_slot = ctx_intern_global(ctx, (char*)"console", 7);
    ctx.globals[console_slot].value = console_v;
    ctx.globals[console_slot].defined = true;
}

// --- Error inspection (public ABI) ----------------------------------

fn zjs_had_error(ctx: ZjsContext*) -> int {
    if ctx == NULL { return 0; }
    if ctx.had_error { return 1; }
    return 0;
}

fn zjs_get_error(ctx: ZjsContext*) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    return ctx.last_error;
}

// =====================================================================
// ToString — produces a string ZjsValue from any input. Allocates on
// the context's cell list. Lives here (not in value.zc) because it
// needs to allocate cells via ctx_intern_string.
// =====================================================================

fn zjs_to_string(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    if zjs_is_string(v) != 0 { return v; }

    let buf: char[64];
    let len: usize = 0;

    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw { len = (size_t)snprintf(buf, 64, "%d", (int)n); }
    } else if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        // ECMA-262 §7.1.17 Number::toString: NaN -> "NaN",
        // ±Infinity -> "Infinity" / "-Infinity"; integral doubles in
        // range get printed without a decimal point. printf("%g") would
        // emit lowercase "nan" / "inf" — wrong tag for JS observers.
        raw {
            if (isnan(d)) {
                len = (size_t)snprintf(buf, 64, "NaN");
            } else if (isinf(d)) {
                len = (size_t)snprintf(buf, 64, d > 0 ? "Infinity" : "-Infinity");
            } else if (d == (double)(int64_t)d && d >= -1e15 && d <= 1e15) {
                // Integral path — no trailing ".0".
                len = (size_t)snprintf(buf, 64, "%lld", (long long)d);
            } else {
                // %g default (6 sig figs) — matches common JS toString
                // for typical decimals. Not the spec's shortest-round-
                // trip algorithm, but close enough for most workloads.
                len = (size_t)snprintf(buf, 64, "%g", d);
            }
        }
    } else if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { raw { len = (size_t)snprintf(buf, 64, "true"); } }
        else                    { raw { len = (size_t)snprintf(buf, 64, "false"); } }
    } else if zjs_is_null(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "null"); }
    } else if zjs_is_undefined(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "undefined"); }
    } else if zjs_is_object(v) != 0 {
        // ECMA-262 §7.1.18: ToPrimitive(O, "string") tries toString
        // then valueOf. We invoke .toString() if it's a callable
        // prototype method; if that returns a string, use it.
        // Fallback is the spec's "[object Object]" form.
        let o = zjs_as_object(v);
        let ts_atom = ctx_intern_atom(ctx, (char*)"toString", 8);
        let cur = o;
        let ts_fn: ZjsValue = zjs_undefined();
        while cur != NULL {
            let slot = class_find_slot(cur.cls, ts_atom);
            if slot >= 0 {
                let raw_v = cur.slots[(u32)slot];
                if zjs_is_deleted(raw_v) == 0 {
                    ts_fn = raw_v;
                    cur = NULL;
                } else {
                    cur = cur.proto;
                }
            } else {
                cur = cur.proto;
            }
        }
        if zjs_is_function(ts_fn) != 0 || zjs_is_closure(ts_fn) != 0 || zjs_is_host_function(ts_fn) != 0 {
            let nullp: ZjsValue* = NULL;
            let r: ZjsValue = zjs_call_value_with_this(ctx, ts_fn, v, nullp, 0);
            if zjs_is_string(r) != 0 { return r; }
            // toString returned a non-string; try valueOf as fallback.
        }
        // valueOf fallback for objects whose toString is missing or
        // returned non-string.
        let vo_atom = ctx_intern_atom(ctx, (char*)"valueOf", 7);
        let cur2 = o;
        let vo_fn: ZjsValue = zjs_undefined();
        while cur2 != NULL {
            let slot = class_find_slot(cur2.cls, vo_atom);
            if slot >= 0 {
                let raw_v = cur2.slots[(u32)slot];
                if zjs_is_deleted(raw_v) == 0 {
                    vo_fn = raw_v;
                    cur2 = NULL;
                } else {
                    cur2 = cur2.proto;
                }
            } else {
                cur2 = cur2.proto;
            }
        }
        if zjs_is_function(vo_fn) != 0 || zjs_is_closure(vo_fn) != 0 || zjs_is_host_function(vo_fn) != 0 {
            let nullp: ZjsValue* = NULL;
            let r2: ZjsValue = zjs_call_value_with_this(ctx, vo_fn, v, nullp, 0);
            // If valueOf returned a primitive, recurse.
            if zjs_is_object(r2) == 0 { return zjs_to_string(ctx, r2); }
        }
        raw { len = (size_t)snprintf(buf, 64, "[object Object]"); }
    } else {
        raw { len = (size_t)snprintf(buf, 64, "[object]"); }
    }

    return ctx_intern_string(ctx, &buf[0], (u32)len);
}

// String concatenation: a + b where at least one is a string. Both
// operands are coerced to strings; result is a fresh interned string
// on the context.
fn zjs_string_concat(ctx: ZjsContext*, a: ZjsValue, b: ZjsValue) -> ZjsValue {
    let sa_val = zjs_to_string(ctx, a);
    let sb_val = zjs_to_string(ctx, b);
    let sa = zjs_as_string(sa_val);
    let sb = zjs_as_string(sb_val);
    let total = sa.length + sb.length;
    let buf: char* = NULL;
    let sa_data = sa.data;
    let sb_data = sb.data;
    let sa_len = sa.length;
    let sb_len = sb.length;
    raw {
        buf = (char*)malloc(total + 1);
        memcpy(buf, sa_data, sa_len);
        memcpy(buf + sa_len, sb_data, sb_len);
        buf[total] = 0;
    }
    return ctx_intern_string_take(ctx, buf, total);
}

// Find an existing global by name. Returns -1 if not found (i32 so we
// can use a sentinel).
fn ctx_find_global(ctx: ZjsContext*, name: char*, name_len: u32) -> i32 {
    let i: u32 = 0;
    while i < ctx.global_count {
        if ctx.globals[i].name_len == name_len {
            let ent_name = ctx.globals[i].name;
            let eq: int = 0;
            raw { eq = (memcmp(ent_name, name, name_len) == 0) ? 1 : 0; }
            if eq != 0 { return (i32)i; }
        }
        i = i + 1;
    }
    return -1;
}

// Intern a global name: return its slot index, creating a fresh slot
// (with value = undefined) if it doesn't exist yet.
fn ctx_intern_global(ctx: ZjsContext*, name: char*, name_len: u32) -> u32 {
    let existing = ctx_find_global(ctx, name, name_len);
    if existing >= 0 { return (u32)existing; }

    // Grow the table if needed.
    if ctx.global_count >= ctx.global_cap {
        let new_cap: u32 = if ctx.global_cap == 0 { 16 } else { ctx.global_cap * 2 };
        let old_g = ctx.globals;
        let new_g: GlobalEntry* = NULL;
        raw {
            new_g = (GlobalEntry*)realloc(old_g, new_cap * sizeof(GlobalEntry));
            // Zero the new tail so we have a defined starting state.
            memset(&new_g[ctx->global_cap], 0, (new_cap - ctx->global_cap) * sizeof(GlobalEntry));
        }
        ctx.globals = new_g;
        ctx.global_cap = new_cap;
    }

    // Allocate + copy the name (it's a slice of caller's source).
    let name_copy: char* = NULL;
    raw {
        name_copy = (char*)malloc(name_len + 1);
        memcpy(name_copy, name, name_len);
        name_copy[name_len] = 0;
    }

    let idx = ctx.global_count;
    ctx.globals[idx].name = name_copy;
    ctx.globals[idx].name_len = name_len;
    ctx.globals[idx].value = zjs_undefined();
    ctx.global_count = ctx.global_count + 1;
    return idx;
}
