// Engine context — Phase 3.0a.
//
// One context = one isolated JS world. Holds the global variable table
// and (later) the heap + GC + symbol table. Globals are referenced by
// integer slot index in compiled bytecode; the compiler and the runtime
// share the same context so slot indices match up by construction.

import "stdlib.h" as libc;
import "string.h" as libc_str;
import "./value.zc";
import "std/mem.zc"
import "std/math.zc"
import "std/regex.zc"

raw {
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
    // Forward decl — defined in eval.zc; lets host_function_ctor /
    // similar runtime-compile paths reach it without a circular import.
    typedef struct ZjsValue ZjsValue;
    typedef struct ZjsContext ZjsContext;
    ZjsValue zjs_eval(ZjsContext* ctx, char* source);
}

struct GlobalEntry {
    name:     char*;    // owned (calloc'd, copied from source); freed on ctx free
    name_len: u32;
    value:    ZjsValue;
    // Phase 3.8c: true once a definition (var/let/const/function/class/
    // host registration) has populated `value`. LoadGlobal throws
    // ReferenceError if false; `typeof` uses a separate opcode that
    // returns "undefined" without throwing.
    defined:  bool;
}

struct GcRootFrame {
    regs:      ZjsValue*;
    reg_count: u32;
}

// Phase 3.9h scaffolding. Each CallFrame owns a slice of reg_stack
// laid out as [args | regs]: args[0..argc] then regs[0..reg_count].
// Storing args separately (rather than just copying into regs[0..]) so
// `arguments[k]` for k >= param_count still works when more args are
// passed than declared.
struct CallFrame {
    f:                      Function*;
    ip:                     usize;
    args_base:              u32;   // offset into ctx.reg_stack
    argc:                   u32;   // how many slots at args_base hold passed args
    regs_base:              u32;   // = args_base + argc
    reg_count:              u32;
    return_dst:             u8;
    saved_host_this:        ZjsValue;
    saved_current_closure:  ZjsClosure*;
    try_depth_at_entry:     u32;
}

// Phase 3.9h. Shared across all CallFrames once the migration lands —
// each TryFrame carries the frame_index it lives in so unwinding can
// pop above it without per-frame try arrays.
struct CtxTryFrame {
    frame_index: u32;
    catch_ip:    usize;
    catch_reg:   u8;
}

def CTX_MAX_TRY_DEPTH:  u32 = 256;
def CTX_INVOKE_ARG_CAP: u32 = 256;   // matches u8 argc range

// Open-addressed hash-table entry. NULL `str` = empty slot.
// We never delete atoms, so no tombstones needed.
struct AtomEntry {
    str:  ZjsString*;
    hash: u32;
}

struct ZjsContext {
    // Root empty hidden class — every fresh {} starts here.
    empty_class:    ZjsHiddenClass*;

    globals:        GlobalEntry*;
    global_count:   u32;
    global_cap:     u32;

    // All heap-allocated cells owned by the context (Functions,
    // Strings, Objects, Arrays, HostFunctions). Each cell starts with
    // a CellHeader whose type_tag drives the free dispatch. The mark
    // bit drives GC reachability.
    cells:          void**;
    cell_count:     u32;
    cell_cap:       u32;

    // Set by zjs_eval when the program ends with an uncaught throw.
    // Public ABI: zjs_had_error / zjs_get_error.
    had_error:      bool;
    last_error:     ZjsValue;

    // Currently-executing closure (Phase 3.3). Push/pop'd by Invoke;
    // LoadEnv reads ctx.current_closure.env.
    current_closure: ZjsClosure*;

    // Implicit `this` for the currently-running host function (Phase 3.5).
    // Set by Op::MethodInvoke before dispatch and restored after. Host
    // builtins like Array.prototype.push read it via zjs_get_host_this().
    host_this: ZjsValue;
    // Op::NewInvoke sets this to true before calling the constructor;
    // plain Invoke / MethodInvoke leave it false. Host functions can
    // read it to distinguish `new F(...)` from `F(...)` / `F.call(...)`
    // and throw TypeError on the latter when spec requires it.
    new_target_active: bool;

    // Cached "prototype" objects for built-in cell types (Phase 3.5).
    // Lazily populated by ctx_init_builtins. property_get on TAG_ARRAY
    // falls back to array_proto for unrecognized method names; same for
    // TAG_STRING / string_proto. Phase 3.6 will replace this with a real
    // hidden-class-driven proto chain.
    array_proto:    ZjsObject*;
    string_proto:   ZjsObject*;
    // Phase 3.8c — the default proto for every {} created via
    // ctx_new_object. Carries hasOwnProperty + toString.
    object_proto:   ZjsObject*;

    // Phase 3.8d — cached Function.prototype.{call, apply} host
    // helpers. property_get on Function/Closure/HostFunction returns
    // these when key == "call" / "apply" so f.call(thisArg, ...) works.
    fn_call_v:      ZjsValue;
    fn_apply_v:     ZjsValue;
    // 2026-05-15 — real Function.prototype. Every callable's
    // [[Prototype]] resolves to this object; `Function.prototype`
    // returns it; property_get on a callable walks it before
    // object_proto. Created in ctx_init_builtins.
    function_proto: ZjsObject*;

    // Phase 3.5b — temp-root stack. Host functions that invoke JS
    // callbacks (Array.prototype.map / forEach) need to keep
    // intermediate ZjsValues alive across the inner interpret() call,
    // which may trigger GC. Use ctx_push_temp_root / ctx_pop_temp_root.
    temp_roots:      ZjsValue*;
    temp_root_count: u32;
    temp_root_cap:   u32;

    // --- GC state ---
    root_frames:    GcRootFrame*;     // grown geometrically
    root_depth:     u32;              // # of active interpret() frames
    root_cap:       u32;
    cells_since_gc: u32;              // allocations since last collection
    gc_threshold:   u32;              // run GC when cells_since_gc >= this

    // --- Phase 3.9h scaffolding (unused until interpret() converts) ---
    // Single contiguous register stack; CallFrames take slices.
    reg_stack:        ZjsValue*;
    reg_stack_top:    u32;
    reg_stack_cap:    u32;

    frames:           CallFrame*;
    frame_count:      u32;
    frame_cap:        u32;

    // Shared try stack (replaces per-frame TryFrame[32] once migration
    // lands). Sized once at first use up to CTX_MAX_TRY_DEPTH.
    ctx_try_stack:    CtxTryFrame*;
    ctx_try_depth:    u32;
    ctx_try_cap:      u32;

    // Scratch buffer for arg-copy on Op::Invoke. The interpreter copies
    // args from the caller's regs into this buffer BEFORE calling
    // push_call_frame (which may realloc reg_stack and invalidate
    // caller-reg pointers). Reused across Invokes — overwritten each
    // call. Lazily sized to CTX_INVOKE_ARG_CAP at first use.
    invoke_arg_buffer:     ZjsValue*;
    invoke_arg_buffer_cap: u32;

    // Phase 3.10 — Promises.
    // Currently-executing host function (set by Op::Invoke right
    // before calling the C fn_ptr). Host fns that need per-instance
    // state (Promise resolve/reject closures) read .bound from here.
    current_host_fn: void*;
    // Pending throw bridge — when a JS callback fired from a host
    // helper (zjs_to_primitive's valueOf/toString, Array.prototype.map's
    // user callback, etc.) raises an exception, the recursive
    // interpret() can't propagate it directly because the host frame
    // sits in between. zjs_call_value{,_with_this} set these fields
    // instead; the outer interpret() inspects pending_throw_active at
    // the end of each instruction and converts it back into a local
    // throw (`throwing = true; thrown = pending_throw_value`).
    pending_throw_active: bool;
    pending_throw_value:  ZjsValue;
    // Microtask queue. Each microtask is 4 consecutive slots:
    //   handler (callable or undefined), arg, result_promise, is_fulfilled_path.
    microtask_queue: ZjsValue*;
    microtask_count: u32;
    microtask_cap:   u32;
    // Bound ctor for Promise — used by the .then path to construct
    // the result promise. Cached at init.
    promise_ctor_proto: ZjsObject*;

    // RegExp.prototype — carries .test / .exec / .source / .flags.
    // property_get on TAG_REGEXP walks this chain.
    regexp_proto:       ZjsObject*;

    // --- Atom table (interned strings) ---
    // Open-addressed hash table, power-of-2 capacity. Used for
    // property names + source-code string literals. Atoms are GC
    // roots so they live for the context's lifetime; that's fine for
    // names/literals that are inherently shared.
    atoms:          AtomEntry*;
    atom_count:     u32;
    atom_cap:       u32;
}

fn zjs_new_context() -> ZjsContext* {
    let result = alloc<ZjsContext>();
    if result != NULL {
        // GC initial threshold: collect after the first 4096 cell allocations,
        // then adapt to 2× live count after each collection.
        result.gc_threshold = 4096;
        // calloc gave us {bits: 0}; explicitly initialize the implicit
        // host receiver to JS `undefined`.
        result.host_this = zjs_undefined();

        // Root empty class — registered as a cell, kept alive via the
        // context pointer itself (we mark it during gc_mark_roots).
        let empty = zjs_hidden_class_new(NULL, NULL, 0, 0);
        ctx_register_cell(result, (void*)empty);
        result.empty_class = empty;

        ctx_init_builtins(result);
    }
    return result;
}

fn zjs_free_context(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    dealloc(ctx.root_frames);
    dealloc(ctx.atoms);
    // Free every interned global name.
    let i: u32 = 0;
    while i < ctx.global_count {
        dealloc(ctx.globals[i].name);
        i = i + 1;
    }
    dealloc(ctx.globals);

    // Free every heap cell, dispatched by its type tag.
    let j: u32 = 0;
    while j < ctx.cell_count {
        let cp = ctx.cells[j];
        let tag: u8 = 0;
        raw { tag = ((CellHeader*)cp)->type_tag; }
        if tag == TAG_FUNCTION {
            raw {
                extern void function_free_void(void* f);
                function_free_void(cp);
            }
        } else if tag == TAG_STRING {
            string_free_void(cp);
        } else if tag == TAG_OBJECT {
            object_free_void(cp);
        } else if tag == TAG_ARRAY {
            array_free_void(cp);
        } else if tag == TAG_HOST_FUNCTION {
            host_function_free_void(cp);
        } else if tag == TAG_HIDDEN_CLASS {
            hidden_class_free_void(cp);
        } else if tag == TAG_CLOSURE {
            closure_free_void(cp);
        } else if tag == TAG_ACCESSOR {
            accessor_free_void(cp);
        } else if tag == TAG_PROMISE {
            promise_free_void(cp);
        } else if tag == TAG_REGEXP {
            regexp_free_void(cp);
        }
        j = j + 1;
    }
    let cells = ctx.cells;
    let temp_roots = ctx.temp_roots;
    let reg_stack = ctx.reg_stack;
    let frames = ctx.frames;
    let ctx_try_stack = ctx.ctx_try_stack;
    let invoke_arg_buffer = ctx.invoke_arg_buffer;
    let microtask_queue = ctx.microtask_queue;
    dealloc(cells);
    dealloc(temp_roots);
    dealloc(reg_stack);
    dealloc(frames);
    dealloc(ctx_try_stack);
    dealloc(invoke_arg_buffer);
    dealloc(microtask_queue);
    dealloc(ctx);
}

// Push a value as a transient GC root. Used by host functions that
// allocate then invoke a JS callback — the inner interpret() may run
// GC, and the C-stack ZjsValue isn't otherwise visible. Pair with
// ctx_pop_temp_root.
fn ctx_push_temp_root(ctx: ZjsContext*, v: ZjsValue) -> void {
    if ctx.temp_root_count >= ctx.temp_root_cap {
        let new_cap: u32 = if ctx.temp_root_cap == 0 { 8 } else { ctx.temp_root_cap * 2 };
        ctx.temp_roots = realloc_n<ZjsValue>(ctx.temp_roots, (usize)ctx.temp_root_cap, (usize)new_cap);
        ctx.temp_root_cap = new_cap;
    }
    ctx.temp_roots[ctx.temp_root_count] = v;
    ctx.temp_root_count = ctx.temp_root_count + 1;
}

fn ctx_pop_temp_root(ctx: ZjsContext*) -> void {
    if ctx.temp_root_count > 0 {
        ctx.temp_root_count = ctx.temp_root_count - 1;
    }
}

// Overwrite the top temp_root slot in place. Pairs cleanly with
// `push + defer pop` for code that loops, allocating a fresh value
// each iteration that supersedes the previous one (string concat,
// array join, etc.).
fn ctx_replace_top_temp_root(ctx: ZjsContext*, v: ZjsValue) -> void {
    if ctx.temp_root_count > 0 {
        ctx.temp_roots[ctx.temp_root_count - 1] = v;
    }
}

// Append a heap cell to the context's owned-cells list. Called whenever
// a new Function / String / etc. is allocated by the compiler or
// interpreter.
fn ctx_register_cell(ctx: ZjsContext*, p: void*) -> void {
    if ctx.cell_count >= ctx.cell_cap {
        let new_cap: u32 = if ctx.cell_cap == 0 { 16 } else { ctx.cell_cap * 2 };
        ctx.cells = realloc_n<void*>(ctx.cells, (usize)ctx.cell_cap, (usize)new_cap);
        ctx.cell_cap = new_cap;
    }
    ctx.cells[ctx.cell_count] = p;
    ctx.cell_count = ctx.cell_count + 1;
    ctx.cells_since_gc = ctx.cells_since_gc + 1;
}

// =====================================================================
// GC — mark-sweep, run between interpreter instructions.
// =====================================================================

fn ctx_push_root_frame(ctx: ZjsContext*, regs: ZjsValue*, reg_count: u32) -> void {
    if ctx.root_depth >= ctx.root_cap {
        let new_cap: u32 = if ctx.root_cap == 0 { 16 } else { ctx.root_cap * 2 };
        ctx.root_frames = realloc_n<GcRootFrame>(ctx.root_frames, (usize)ctx.root_cap, (usize)new_cap);
        ctx.root_cap = new_cap;
    }
    ctx.root_frames[ctx.root_depth].regs = regs;
    ctx.root_frames[ctx.root_depth].reg_count = reg_count;
    ctx.root_depth = ctx.root_depth + 1;
}

fn ctx_pop_root_frame(ctx: ZjsContext*) -> void {
    if ctx.root_depth > 0 { ctx.root_depth = ctx.root_depth - 1; }
}

// =====================================================================
// Phase 3.9h — non-recursive interpreter scaffolding.
//
// These helpers manage the explicit CallFrame stack + shared register
// stack that the next phase will use. They're correct and tested via
// build coverage now, but not yet wired into interpret() — that swap
// is Phase B. Keeping the scaffolding under its own dead-code path
// means we can land it as a no-behavior-change commit and bisect cleanly.
// =====================================================================

// Reserve room for `n` more ZjsValue slots on the register stack and
// return the base offset. Grows the stack geometrically. Caller is
// responsible for initializing the reserved slots (to undefined, or
// to actual arg values).
fn reg_stack_reserve(ctx: ZjsContext*, n: u32) -> u32 {
    let needed: u32 = ctx.reg_stack_top + n;
    if needed > ctx.reg_stack_cap {
        let new_cap: u32 = if ctx.reg_stack_cap == 0 { 256 } else { ctx.reg_stack_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        ctx.reg_stack = realloc_n<ZjsValue>(ctx.reg_stack, (usize)ctx.reg_stack_cap, (usize)new_cap);
        ctx.reg_stack_cap = new_cap;
    }
    let base = ctx.reg_stack_top;
    ctx.reg_stack_top = needed;
    return base;
}

// Release the top `n` slots from the register stack.
fn reg_stack_release(ctx: ZjsContext*, n: u32) -> void {
    if n > ctx.reg_stack_top {
        ctx.reg_stack_top = 0;
    } else {
        ctx.reg_stack_top = ctx.reg_stack_top - n;
    }
}

// Push a CallFrame for `f`. Reserves `argc + f.register_count` slots
// on the register stack: args_base[0..argc] holds the full passed-args
// list (for `arguments`), regs_base[0..register_count] is the function's
// register window. The first min(argc, param_count) args are also
// copied into regs[0..param_count]; remaining regs init to undefined
// (load-bearing — GC walks the whole window).
fn push_call_frame(ctx: ZjsContext*, f: Function*, args: ZjsValue*, argc: u32, ret_dst: u8) -> u32 {
    if ctx.frame_count >= ctx.frame_cap {
        let new_cap: u32 = if ctx.frame_cap == 0 { 64 } else { ctx.frame_cap * 2 };
        ctx.frames = realloc_n<CallFrame>(ctx.frames, (usize)ctx.frame_cap, (usize)new_cap);
        ctx.frame_cap = new_cap;
    }
    let reg_count: u32 = f.register_count;
    let total: u32 = argc + reg_count;
    let args_base = reg_stack_reserve(ctx, total);
    let regs_base = args_base + argc;

    // Copy the FULL passed args list into the args slot.
    let a: u32 = 0;
    while a < argc {
        ctx.reg_stack[args_base + a] = args[a];
        a = a + 1;
    }

    // Copy the first min(argc, param_count) args into regs[0..]; init
    // remaining regs to undefined.
    let copy_count: u32 = if argc < f.param_count { argc } else { f.param_count };
    let i: u32 = 0;
    while i < copy_count {
        ctx.reg_stack[regs_base + i] = args[i];
        i = i + 1;
    }
    let undef: ZjsValue = zjs_undefined();
    let j: u32 = i;
    while j < reg_count {
        ctx.reg_stack[regs_base + j] = undef;
        j = j + 1;
    }

    let idx = ctx.frame_count;
    ctx.frames[idx].f = f;
    ctx.frames[idx].ip = 0;
    ctx.frames[idx].args_base = args_base;
    ctx.frames[idx].argc = argc;
    ctx.frames[idx].regs_base = regs_base;
    ctx.frames[idx].reg_count = reg_count;
    ctx.frames[idx].return_dst = ret_dst;
    ctx.frames[idx].saved_host_this = ctx.host_this;
    ctx.frames[idx].saved_current_closure = ctx.current_closure;
    ctx.frames[idx].try_depth_at_entry = ctx.ctx_try_depth;
    ctx.frame_count = ctx.frame_count + 1;
    return idx;
}

// Pop the top CallFrame. Restores ctx.host_this and ctx.current_closure
// from the popped frame's saved_* fields, and shrinks the register
// stack by the frame's reg_count. Pops any try-frames the frame owned.
// Returns the popped frame's return_dst (so the caller can write the
// return value into its own regs).
fn pop_call_frame(ctx: ZjsContext*) -> u8 {
    if ctx.frame_count == 0 { return 0; }
    let idx = ctx.frame_count - 1;
    let ret_dst = ctx.frames[idx].return_dst;
    let total = ctx.frames[idx].argc + ctx.frames[idx].reg_count;
    let saved_this = ctx.frames[idx].saved_host_this;
    let saved_cl   = ctx.frames[idx].saved_current_closure;
    let try_at_entry = ctx.frames[idx].try_depth_at_entry;

    ctx.host_this = saved_this;
    ctx.current_closure = saved_cl;
    if ctx.ctx_try_depth > try_at_entry {
        ctx.ctx_try_depth = try_at_entry;
    }
    reg_stack_release(ctx, total);
    ctx.frame_count = idx;
    return ret_dst;
}

// Pop frames until frame_count == target. Used on throw unwinding and
// when interpret() returns to its entry depth.
fn pop_call_frames_to(ctx: ZjsContext*, target: u32) -> void {
    while ctx.frame_count > target {
        pop_call_frame(ctx);
    }
}

// Phase 3.9h-C — replace the top CallFrame in-place with a tail call.
// The new function returns DIRECTLY to the original caller (we
// preserve return_dst / saved_host_this / saved_current_closure /
// try_depth_at_entry from the outgoing frame). Releases the old
// frame's reg_stack slots and reserves the new function's window.
fn tail_call_frame(ctx: ZjsContext*, f: Function*, args: ZjsValue*, argc: u32) -> void {
    if ctx.frame_count == 0 { return; }
    let idx = ctx.frame_count - 1;
    let old_total: u32 = ctx.frames[idx].argc + ctx.frames[idx].reg_count;
    reg_stack_release(ctx, old_total);

    let reg_count: u32 = f.register_count;
    let new_total: u32 = argc + reg_count;
    let args_base = reg_stack_reserve(ctx, new_total);
    let regs_base = args_base + argc;

    let a: u32 = 0;
    while a < argc {
        ctx.reg_stack[args_base + a] = args[a];
        a = a + 1;
    }
    let copy_count: u32 = if argc < f.param_count { argc } else { f.param_count };
    let i: u32 = 0;
    while i < copy_count {
        ctx.reg_stack[regs_base + i] = args[i];
        i = i + 1;
    }
    let undef: ZjsValue = zjs_undefined();
    let j: u32 = i;
    while j < reg_count {
        ctx.reg_stack[regs_base + j] = undef;
        j = j + 1;
    }

    ctx.frames[idx].f = f;
    ctx.frames[idx].ip = 0;
    ctx.frames[idx].args_base = args_base;
    ctx.frames[idx].argc = argc;
    ctx.frames[idx].regs_base = regs_base;
    ctx.frames[idx].reg_count = reg_count;
    // return_dst, saved_host_this, saved_current_closure,
    // try_depth_at_entry: unchanged — inherited from the outgoing frame.
}

// Push a try frame on the shared context try stack. Lazily allocates.
fn ctx_try_push(ctx: ZjsContext*, catch_ip: usize, catch_reg: u8) -> bool {
    if ctx.ctx_try_depth >= CTX_MAX_TRY_DEPTH { return false; }
    if ctx.ctx_try_stack == NULL {
        ctx.ctx_try_stack = alloc_n<CtxTryFrame>((usize)CTX_MAX_TRY_DEPTH);
        ctx.ctx_try_cap = CTX_MAX_TRY_DEPTH;
    }
    let i = ctx.ctx_try_depth;
    let cur_frame = if ctx.frame_count > 0 { ctx.frame_count - 1 } else { 0 };
    ctx.ctx_try_stack[i].frame_index = cur_frame;
    ctx.ctx_try_stack[i].catch_ip = catch_ip;
    ctx.ctx_try_stack[i].catch_reg = catch_reg;
    ctx.ctx_try_depth = ctx.ctx_try_depth + 1;
    return true;
}

fn ctx_try_pop(ctx: ZjsContext*) -> void {
    if ctx.ctx_try_depth > 0 {
        ctx.ctx_try_depth = ctx.ctx_try_depth - 1;
    }
}

// Mark a single value's reachable graph. Idempotent — already-marked
// cells return immediately, breaking cycles.
fn gc_mark_value(v: ZjsValue) -> void {
    if zjs_is_cell(v) == 0 { return; }
    let p = zjs_cell_as_ptr(v);
    if p == NULL { return; }
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)p; }
    if h.mark != 0 { return; }
    h.mark = 1;

    let tag = h.type_tag;
    if tag == TAG_STRING { return; }            // leaf

    if tag == TAG_HOST_FUNCTION {
        // Phase 3.6: host functions can carry a .prototype.
        // Phase 3.8c: and arbitrary properties via .props.
        // Phase 3.10: and a per-instance .bound value (Promise resolvers).
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)p; }
        if hf.prototype != NULL {
            let pv = zjs_cell_from_ptr((void*)hf.prototype);
            gc_mark_value(pv);
        }
        if hf.props != NULL {
            let pv = zjs_cell_from_ptr((void*)hf.props);
            gc_mark_value(pv);
        }
        gc_mark_value(hf.bound);
        gc_mark_value(hf.proto_override);
        return;
    }

    if tag == TAG_OBJECT {
        let o: ZjsObject* = NULL;
        raw { o = (ZjsObject*)p; }
        // Mark the object's class — its parent chain + transition map
        // are walked transitively.
        gc_mark_hidden_class(o.cls);
        // Mark all live slots.
        let live = if o.cls != NULL { o.cls.prop_count } else { 0 };
        let i: u32 = 0;
        while i < live {
            gc_mark_value(o.slots[i]);
            i = i + 1;
        }
        // Phase 3.6: walk the proto chain so inherited values stay alive.
        if o.proto != NULL {
            let pv = zjs_cell_from_ptr((void*)o.proto);
            gc_mark_value(pv);
        }
        return;
    }

    if tag == TAG_HIDDEN_CLASS {
        let c: ZjsHiddenClass* = NULL;
        raw { c = (ZjsHiddenClass*)p; }
        gc_mark_hidden_class(c);
        return;
    }

    if tag == TAG_CLOSURE {
        let cl: ZjsClosure* = NULL;
        raw { cl = (ZjsClosure*)p; }
        // Mark the function template — wraps a Function* cell.
        if cl.function != NULL {
            let fn_val = zjs_cell_from_ptr(cl.function);
            gc_mark_value(fn_val);
        }
        // Mark the captured env object — walks its slots transitively
        // (each captured local is reachable through env).
        if cl.env != NULL {
            let env_val = zjs_cell_from_ptr((void*)cl.env);
            gc_mark_value(env_val);
        }
        return;
    }

    if tag == TAG_ACCESSOR {
        let a: ZjsAccessor* = NULL;
        raw { a = (ZjsAccessor*)p; }
        gc_mark_value(a.get);
        gc_mark_value(a.set);
        return;
    }

    if tag == TAG_PROMISE {
        let pr: ZjsPromise* = NULL;
        raw { pr = (ZjsPromise*)p; }
        gc_mark_value(pr.value);
        let i: u32 = 0;
        while i < pr.reaction_count * 3 {
            gc_mark_value(pr.reactions[i]);
            i = i + 1;
        }
        return;
    }

    if tag == TAG_REGEXP {
        let r: ZjsRegExp* = NULL;
        raw { r = (ZjsRegExp*)p; }
        // source / flags_str are atom-table-pinned strings, so they
        // get marked via the atom-table root. Still walking them here
        // for symmetry with the other types — atom strings short-
        // circuit the cycle but don't hurt.
        if r.source != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)r.source));
        }
        if r.flags_str != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)r.flags_str));
        }
        if r.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)r.props));
        }
        return;
    }

    if tag == TAG_ARRAY {
        let a: ZjsArray* = NULL;
        raw { a = (ZjsArray*)p; }
        let i: u32 = 0;
        while i < a.length {
            gc_mark_value(a.elements[i]);
            i = i + 1;
        }
        if a.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)a.props));
        }
        return;
    }

    if tag == TAG_FUNCTION {
        let f: Function* = NULL;
        raw { f = (Function*)p; }
        let i: u32 = 0;
        while i < f.const_count {
            gc_mark_value(f.constants[i]);
            i = i + 1;
        }
        // Phase 3.8 note: inline-cache entries used to mark ic.class_
        // strongly, which leaked hidden classes for objects long since
        // dead. The class_ pointer is now a WEAK ref — see
        // gc_nullify_dead_ics() between mark and sweep. The atom names
        // are pinned via the atom-table root, so we don't re-mark them.
        // Phase 3.6: .prototype.
        if f.prototype != NULL {
            let pv = zjs_cell_from_ptr((void*)f.prototype);
            gc_mark_value(pv);
        }
        // Expando bag (Function.props).
        if f.props != NULL {
            gc_mark_value(zjs_cell_from_ptr((void*)f.props));
        }
        return;
    }
}

// After the mark phase but before sweep, walk all live Functions'
// inline caches and null out entries whose cached HiddenClass wasn't
// independently marked alive. Without this pass, the IC keeps long-dead
// classes pinned and we slow-leak shape memory in long-running programs.
fn gc_nullify_dead_ics(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    while i < ctx.cell_count {
        let p = ctx.cells[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 && h.type_tag == TAG_FUNCTION {
            let f: Function* = NULL;
            raw { f = (Function*)p; }
            let j: u32 = 0;
            while j < f.ic_count {
                // Compact: nuke dead-class entries, slide live ones down.
                // The order doesn't matter for correctness (we linearly
                // probe), only for cache locality — leading slots stay hot.
                let write_k: u32 = 0;
                let read_k:  u32 = 0;
                let count = (u32)f.ics[j].entry_count;
                while read_k < count {
                    let cls: ZjsHiddenClass* = f.ics[j].classes[read_k];
                    if cls != NULL && cls.header.mark != 0 {
                        if write_k != read_k {
                            f.ics[j].classes[write_k] = cls;
                            f.ics[j].slots[write_k] = f.ics[j].slots[read_k];
                        }
                        write_k = write_k + 1;
                    }
                    read_k = read_k + 1;
                }
                // Zero out the freed tail.
                let zk: u32 = write_k;
                while zk < count {
                    f.ics[j].classes[zk] = NULL;
                    f.ics[j].slots[zk] = 0;
                    zk = zk + 1;
                }
                f.ics[j].entry_count = (u8)write_k;
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// Mark a hidden class transitively: parent (chain back to root) and
// every child transition. Idempotent.
fn gc_mark_hidden_class(c: ZjsHiddenClass*) -> void {
    if c == NULL { return; }
    if c.header.mark != 0 { return; }
    c.header.mark = 1;
    // Names are atoms; they're already pinned via the atom-table root.
    if c.parent != NULL { gc_mark_hidden_class(c.parent); }
    let i: u32 = 0;
    while i < c.trans_count {
        gc_mark_hidden_class(c.trans_children[i]);
        i = i + 1;
    }
}

fn gc_mark_roots(ctx: ZjsContext*) -> void {
    // Root empty class
    if ctx.empty_class != NULL {
        gc_mark_hidden_class(ctx.empty_class);
    }
    // Current closure — its env must survive the GC even if it isn't
    // otherwise reachable (e.g., a closure mid-call with no caller-side ref).
    if ctx.current_closure != NULL {
        let cur_val = zjs_cell_from_ptr((void*)ctx.current_closure);
        gc_mark_value(cur_val);
    }
    // Implicit host receiver for the in-flight host call.
    gc_mark_value(ctx.host_this);
    // Built-in prototype objects (kept alive across the whole context).
    if ctx.array_proto != NULL {
        let ap_val = zjs_cell_from_ptr((void*)ctx.array_proto);
        gc_mark_value(ap_val);
    }
    if ctx.string_proto != NULL {
        let sp_val = zjs_cell_from_ptr((void*)ctx.string_proto);
        gc_mark_value(sp_val);
    }
    if ctx.object_proto != NULL {
        let op_val = zjs_cell_from_ptr((void*)ctx.object_proto);
        gc_mark_value(op_val);
    }
    if ctx.function_proto != NULL {
        let fp_val = zjs_cell_from_ptr((void*)ctx.function_proto);
        gc_mark_value(fp_val);
    }
    // Phase 3.8d cached helpers
    gc_mark_value(ctx.fn_call_v);
    gc_mark_value(ctx.fn_apply_v);
    // Phase 3.5b temp roots
    let t: u32 = 0;
    while t < ctx.temp_root_count {
        gc_mark_value(ctx.temp_roots[t]);
        t = t + 1;
    }
    // Globals
    let i: u32 = 0;
    while i < ctx.global_count {
        gc_mark_value(ctx.globals[i].value);
        i = i + 1;
    }
    // Last uncaught error (so the C consumer can still inspect it)
    gc_mark_value(ctx.last_error);
    // Each active call frame (current recursive model)
    let j: u32 = 0;
    while j < ctx.root_depth {
        let frame = ctx.root_frames[j];
        let k: u32 = 0;
        while k < frame.reg_count {
            gc_mark_value(frame.regs[k]);
            k = k + 1;
        }
        j = j + 1;
    }
    // Phase 3.9h: shared reg_stack + per-frame saved host_this /
    // current_closure. Covers everything any active CallFrame might
    // reference (args + regs are contiguous on reg_stack).
    let r: u32 = 0;
    while r < ctx.reg_stack_top {
        gc_mark_value(ctx.reg_stack[r]);
        r = r + 1;
    }
    let fi: u32 = 0;
    while fi < ctx.frame_count {
        gc_mark_value(ctx.frames[fi].saved_host_this);
        if ctx.frames[fi].saved_current_closure != NULL {
            let cv = zjs_cell_from_ptr((void*)ctx.frames[fi].saved_current_closure);
            gc_mark_value(cv);
        }
        fi = fi + 1;
    }
    // Phase 3.10 — microtask queue + cached Promise prototype.
    let mq: u32 = 0;
    while mq < ctx.microtask_count * 4 {
        gc_mark_value(ctx.microtask_queue[mq]);
        mq = mq + 1;
    }
    if ctx.promise_ctor_proto != NULL {
        let pv = zjs_cell_from_ptr((void*)ctx.promise_ctor_proto);
        gc_mark_value(pv);
    }
    // Interned atoms — they live for the context's lifetime.
    let a: u32 = 0;
    while a < ctx.atom_cap {
        let s = ctx.atoms[a].str;
        if s != NULL { s.header.mark = 1; }
        a = a + 1;
    }
}

fn gc_sweep(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    let kept: u32 = 0;
    while i < ctx.cell_count {
        let p = ctx.cells[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 {
            h.mark = 0;
            ctx.cells[kept] = p;
            kept = kept + 1;
        } else {
            let tag = h.type_tag;
            if tag == TAG_FUNCTION      {
                raw { extern void function_free_void(void* f); function_free_void(p); }
            } else if tag == TAG_STRING        { string_free_void(p); }
              else if tag == TAG_OBJECT        { object_free_void(p); }
              else if tag == TAG_ARRAY         { array_free_void(p); }
              else if tag == TAG_HOST_FUNCTION { host_function_free_void(p); }
              else if tag == TAG_CLOSURE       { closure_free_void(p); }
              else if tag == TAG_ACCESSOR      { accessor_free_void(p); }
              else if tag == TAG_PROMISE       { promise_free_void(p); }
              else if tag == TAG_REGEXP        { regexp_free_void(p); }
        }
        i = i + 1;
    }
    ctx.cell_count = kept;
}

fn gc_run(ctx: ZjsContext*) -> void {
    gc_mark_roots(ctx);
    gc_nullify_dead_ics(ctx);
    gc_sweep(ctx);
    ctx.cells_since_gc = 0;
    // Adapt threshold to grow with the live set; minimum floor of 256.
    let target: u32 = ctx.cell_count * 2;
    if target < 256 { target = 256; }
    ctx.gc_threshold = target;
}

fn ctx_maybe_gc(ctx: ZjsContext*) -> void {
    if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
}

// --- Public ABI -----------------------------------------------------

fn zjs_gc(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    gc_run(ctx);
}

fn zjs_cell_count(ctx: ZjsContext*) -> u32 {
    if ctx == NULL { return 0; }
    return ctx.cell_count;
}

// Intern a string by copying the input bytes. The returned ZjsValue
// is a NaN-boxed cell pointer registered with the context.
//
// NOT deduplicated — every call allocates a fresh ZjsString. For
// dedup, use ctx_intern_atom. This is the right function for ToString
// results (numeric → "42") and other transient strings that don't
// benefit from dedup.
fn ctx_intern_string(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// Take ownership of an already-malloc'd buffer. Used by zjs_string_concat
// which allocates the result buffer itself. Also NOT deduplicated.
fn ctx_intern_string_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// =====================================================================
// Atom table — deduplicated strings. Used for property names and
// source-code string literals.
// =====================================================================

fn atom_hash(data: char*, length: u32) -> u32 {
    // FNV-1a 32-bit
    let h: u32 = 2166136261;
    let i: u32 = 0;
    while i < length {
        let b: u32 = (u32)(u8)data[i];
        h = h ^ b;
        h = h * 16777619;
        i = i + 1;
    }
    return h;
}

fn atom_table_insert_unchecked(ctx: ZjsContext*, s: ZjsString*, h: u32) -> void {
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        i = (i + 1) & mask;
    }
    ctx.atoms[i].str = s;
    ctx.atoms[i].hash = h;
    ctx.atom_count = ctx.atom_count + 1;
}

fn atom_table_grow(ctx: ZjsContext*) -> void {
    let old_cap = ctx.atom_cap;
    let old_atoms = ctx.atoms;

    let new_cap: u32 = if old_cap == 0 { 16 } else { old_cap * 2 };
    ctx.atoms = alloc_n<AtomEntry>((usize)new_cap);
    ctx.atom_cap = new_cap;
    ctx.atom_count = 0;

    if old_cap > 0 {
        let i: u32 = 0;
        while i < old_cap {
            if old_atoms[i].str != NULL {
                atom_table_insert_unchecked(ctx, old_atoms[i].str, old_atoms[i].hash);
            }
            i = i + 1;
        }
        dealloc(old_atoms);
    }
}

fn atom_table_lookup(ctx: ZjsContext*, data: char*, length: u32, h: u32) -> ZjsString* {
    if ctx.atom_cap == 0 { return NULL; }
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        let s = ctx.atoms[i].str;
        if ctx.atoms[i].hash == h && s.length == length {
            let s_data = s.data;
            let eq: int = 0;
            raw { eq = (memcmp(s_data, data, length) == 0) ? 1 : 0; }
            if eq != 0 { return s; }
        }
        i = (i + 1) & mask;
    }
    return NULL;
}

// Public intern: dedupe by content. Allocates only on cache miss.
fn ctx_intern_atom(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL { return existing; }

    // Grow first if needed (so insert below doesn't trip a probe through a full table).
    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Same as above, but adopts ownership of an already-malloc'd
// null-terminated buffer. Frees the buffer on dedup hit.
fn ctx_intern_atom_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL {
        // Caller's buffer is redundant — free it.
        dealloc(data);
        return existing;
    }

    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Allocate a fresh empty object and register it on the context.
// Initializes with the root empty class — fresh property additions
// will spawn transitions on first write.
fn ctx_new_object(ctx: ZjsContext*) -> ZjsValue {
    let o = zjs_object_new();
    o.cls = ctx.empty_class;
    // Default proto: every {} inherits from Object.prototype.
    // Skipped while bootstrapping object_proto itself (it's NULL then).
    if ctx.object_proto != NULL && o != ctx.object_proto {
        o.proto = ctx.object_proto;
    }
    ctx_register_cell(ctx, (void*)o);
    return zjs_cell_from_ptr((void*)o);
}

// Full object_set with hidden-class transition logic. Updates an
// existing property if present; otherwise follows or creates a
// transition edge. New properties get default attributes (writable
// + enumerable + configurable all true) — matches the ECMA-262
// behavior of `o.x = 1` going through OrdinarySet which creates a
// data property with full attributes.
fn object_set(ctx: ZjsContext*, obj: ZjsObject*, name: ZjsString*, value: ZjsValue) -> void {
    let existing = class_find_slot(obj.cls, name);
    if existing >= 0 {
        // Existing slot — check writable.
        let attrs = if obj.attrs != NULL { obj.attrs[(u32)existing] } else { PROP_DEFAULT };
        if (attrs & PROP_WRITABLE) == 0 {
            // Strict-mode would throw; non-strict silently drops. MVP
            // takes the non-strict path everywhere.
            return;
        }
        obj.slots[(u32)existing] = value;
        return;
    }

    // Property is new. Find or create a transition.
    let parent_cls = obj.cls;
    let child = class_find_transition(parent_cls, name);
    if child == NULL {
        child = zjs_hidden_class_new(parent_cls, name,
                                      parent_cls.prop_count,
                                      parent_cls.prop_count + 1);
        ctx_register_cell(ctx, (void*)child);
        class_add_transition(parent_cls, name, child);
    }

    // Grow slots + attrs to accommodate the new property. Both arrays
    // are sized identically so the slot index doubles as an attrs
    // index — no separate cap tracking.
    let needed = child.prop_count;
    if obj.slot_cap < needed {
        let new_cap: u32 = if obj.slot_cap == 0 { 4 } else { obj.slot_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        let new_slots = realloc_n<ZjsValue>(obj.slots, (usize)obj.slot_cap, (usize)new_cap);
        let new_attrs = realloc_n<u8>(obj.attrs, (usize)obj.slot_cap, (usize)new_cap);
        let und: ZjsValue = zjs_undefined();
        let i = obj.slot_cap;
        while i < new_cap {
            new_slots[i] = und;
            new_attrs[i] = PROP_DEFAULT;
            i = i + 1;
        }
        obj.slots = new_slots;
        obj.attrs = new_attrs;
        obj.slot_cap = new_cap;
    }

    obj.slots[child.transition_slot] = value;
    obj.attrs[child.transition_slot] = PROP_DEFAULT;
    obj.cls = child;
}

// Read the attribute byte for slot `idx` on `obj`. Returns
// PROP_DEFAULT if the object has no attrs array yet (lazy alloc) —
// the slot would have been freshly written via the bootstrap path
// and inherits full attributes.
fn object_get_attrs(obj: ZjsObject*, slot: u32) -> u8 {
    if obj.attrs == NULL { return PROP_DEFAULT; }
    if slot >= obj.slot_cap { return PROP_DEFAULT; }
    return obj.attrs[slot];
}

// Write the attribute byte for slot `idx`. Caller is responsible
// for ensuring the slot exists (slot < cls.prop_count). The attrs
// array is allocated lazily by object_set; this writer assumes it
// already exists since the slot does.
fn object_set_attrs(obj: ZjsObject*, slot: u32, attrs: u8) -> void {
    if obj.attrs == NULL { return; }
    if slot >= obj.slot_cap { return; }
    obj.attrs[slot] = attrs;
}

// Low-level define: write value + attrs without the writable check.
// Used by Object.defineProperty and friends — the spec entry point
// that explicitly changes attributes. Plain assignment goes through
// object_set, which DOES honor writable.
fn object_define_property_slot(ctx: ZjsContext*, obj: ZjsObject*, name: ZjsString*, value: ZjsValue, attrs: u8) -> void {
    let existing = class_find_slot(obj.cls, name);
    if existing >= 0 {
        obj.slots[(u32)existing] = value;
        if obj.attrs != NULL { obj.attrs[(u32)existing] = attrs; }
        return;
    }
    // New property: same transition logic as object_set's new-prop path.
    let parent_cls = obj.cls;
    let child = class_find_transition(parent_cls, name);
    if child == NULL {
        child = zjs_hidden_class_new(parent_cls, name,
                                      parent_cls.prop_count,
                                      parent_cls.prop_count + 1);
        ctx_register_cell(ctx, (void*)child);
        class_add_transition(parent_cls, name, child);
    }
    let needed = child.prop_count;
    if obj.slot_cap < needed {
        let new_cap: u32 = if obj.slot_cap == 0 { 4 } else { obj.slot_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        let new_slots = realloc_n<ZjsValue>(obj.slots, (usize)obj.slot_cap, (usize)new_cap);
        let new_attrs = realloc_n<u8>(obj.attrs, (usize)obj.slot_cap, (usize)new_cap);
        let und: ZjsValue = zjs_undefined();
        let i = obj.slot_cap;
        while i < new_cap {
            new_slots[i] = und;
            new_attrs[i] = PROP_DEFAULT;
            i = i + 1;
        }
        obj.slots = new_slots;
        obj.attrs = new_attrs;
        obj.slot_cap = new_cap;
    }
    obj.slots[child.transition_slot] = value;
    obj.attrs[child.transition_slot] = attrs;
    obj.cls = child;
}

// Allocate a fresh array with `length` slots, all undefined.
fn ctx_new_array(ctx: ZjsContext*, length: u32) -> ZjsValue {
    let a = zjs_array_new(length);
    ctx_register_cell(ctx, (void*)a);
    return zjs_cell_from_ptr((void*)a);
}

// =====================================================================
// Host functions + built-in registry. ctx_init_builtins is called at
// the end of zjs_new_context so every context starts with Error and
// Math available globally.
// =====================================================================

// Register a host function as a global. fn_ptr must point to a C
// function with signature:
//     ZjsValue (*)(ZjsContext*, ZjsValue*, uint32_t)
fn ctx_register_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf = alloc<ZjsHostFunction>();
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy = alloc_n<char>(name_len + 1);
    mem_copy<char>(name_copy, name, name_len + 1);
    hf.name = name_copy;
    hf.proto_override = zjs_undefined();

    ctx_register_cell(ctx, (void*)hf);
    let val = zjs_cell_from_ptr((void*)hf);

    // Stash in a global slot.
    let slot = ctx_intern_global(ctx, name, (u32)name_len);
    ctx.globals[slot].value = val;
    ctx.globals[slot].defined = true;
    return val;
}

// Like ctx_register_host_function but doesn't create a global slot —
// used when the function is going to be attached as an object property
// (e.g. Math.abs).
fn ctx_make_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf = alloc<ZjsHostFunction>();
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy = alloc_n<char>(name_len + 1);
    mem_copy<char>(name_copy, name, name_len + 1);
    hf.name = name_copy;
    // proto_override defaults to undefined — Object.getPrototypeOf
    // then falls back to ctx.function_proto.
    hf.proto_override = zjs_undefined();

    ctx_register_cell(ctx, (void*)hf);
    return zjs_cell_from_ptr((void*)hf);
}

// Variant that lets the caller set the spec-mandated arity for the
// host function's `.length` property. Used when registering built-ins
// whose formal-parameter counts matter to test262 ("the length
// property of Array.prototype.push is 1", etc.).
fn ctx_make_host_function_arity(ctx: ZjsContext*, name: char*, fn_ptr: void*, arity: u32) -> ZjsValue {
    let v = ctx_make_host_function(ctx, name, fn_ptr);
    zjs_as_host_function(v).arity = arity;
    return v;
}

// --- Built-in implementations ---------------------------------------

// Error("msg") — produces { message, name: "Error" }. Decorates the
// `new` target when invoked via `new`, so `e instanceof Error` works.
fn host_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"Error", 5, args, argc);
}

// Error.prototype.toString — ECMA-262 §20.5.3.4.
// Returns "Name: message", or "Name" if message is empty/missing, or
// "message" if name is empty. Defaults: Name="Error", message="".
fn host_error_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_object(this_val) == 0 {
        return ctx_intern_string(ctx, (char*)"Error", 5);
    }
    let name_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"name", 4)));
    let msg_v  = property_get(ctx, this_val, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"message", 7)));
    if zjs_is_undefined(name_v) != 0 { name_v = ctx_intern_string(ctx, (char*)"Error", 5); }
    else if zjs_is_string(name_v) == 0 { name_v = zjs_to_string(ctx, name_v); }
    let has_msg: bool = !zjs_is_undefined(msg_v);
    if has_msg && zjs_is_string(msg_v) == 0 { msg_v = zjs_to_string(ctx, msg_v); }

    if !has_msg { return name_v; }
    let name_s = zjs_as_string(name_v);
    let msg_s  = zjs_as_string(msg_v);
    if name_s.length == 0 { return msg_v; }
    if msg_s.length == 0 { return name_v; }
    // Concatenate "Name: msg"
    let total = name_s.length + 2 + msg_s.length;
    let buf = alloc_n<char>((usize)(total + 1));
    mem_copy<char>(buf, name_s.data, (usize)name_s.length);
    buf[name_s.length]     = ':';
    buf[name_s.length + 1] = ' ';
    let tail_off = name_s.length + 2;
    let tail: char* = NULL;
    raw { tail = &buf[tail_off]; }
    mem_copy<char>(tail, msg_s.data, (usize)msg_s.length);
    buf[total] = (char)0;
    return ctx_intern_string_take(ctx, buf, total);
}

// --- Math.* helpers -------------------------------------------------

raw {
    #include <math.h>
}

fn host_math_abs(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §21.3.2.1: no-arg → NaN. -0 → +0 (observable via
    // 1/Math.abs(-0) === Infinity).
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    let v = args[0];
    if zjs_is_int32(v) != 0 {
        let i = zjs_as_int32(v);
        if i >= 0 { return v; }
        return zjs_arith_neg(v);
    }
    let d = zjs_to_double(v);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if d == 0.0 { return zjs_double(0.0); }    // -0 → +0
    if d < 0.0 { return zjs_double(-d); }
    return zjs_double(d);
}

fn host_math_floor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    return zjs_double(Math::floor(zjs_to_double(args[0])));
}

fn host_math_ceil(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    return zjs_double(Math::ceil(zjs_to_double(args[0])));
}

fn host_math_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §21.3.2.28 Math.round (rounds half toward +∞):
    //   NaN → NaN
    //   ±Infinity / ±0 → unchanged
    //   x in (-0.5, 0)  → -0   (NOT 0)
    //   x in [0.5, ∞)   → floor(x + 0.5)
    //   else → floor(x + 0.5)
    // No-arg → NaN per ToNumber(undefined).
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    let x = zjs_to_double(args[0]);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_nan: int = 0; let is_inf: int = 0;
    raw { is_nan = isnan(x) ? 1 : 0; is_inf = isinf(x) ? 1 : 0; }
    if is_nan != 0 { return zjs_double(nan); }
    if is_inf != 0 { return zjs_double(x); }
    // Preserve -0 / +0.
    if x == 0.0 { return zjs_double(x); }
    // For x in (-0.5, 0), floor(x + 0.5) = floor(< 0.5) = 0, but spec says -0.
    if x < 0.0 && x >= -0.5 {
        let nz: f64 = 0.0; raw { nz = -0.0; }
        return zjs_double(nz);
    }
    return zjs_double(Math::floor(x + 0.5));
}

fn host_math_sqrt(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    if argc == 0 { return zjs_double(nan); }
    return zjs_double(Math::sqrt(zjs_to_double(args[0])));
}

fn host_math_pow(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nan: f64 = 0.0; raw { nan = NAN; }
    let base: f64 = 0.0; raw { base = NAN; }
    let exp:  f64 = 0.0; raw { exp  = NAN; }
    if argc >= 1 { base = zjs_to_double(args[0]); if ctx.pending_throw_active { return zjs_undefined(); } }
    if argc >= 2 { exp  = zjs_to_double(args[1]); if ctx.pending_throw_active { return zjs_undefined(); } }
    // ECMA-262 §21.3.2.27: |base| === 1 and exp is ±Infinity → NaN.
    // libm's pow(-1, ±Inf) returns 1 (since (-1)^Inf is mathematically
    // ambiguous and IEEE chooses 1); JS spec mandates NaN.
    let exp_is_inf: int = 0;
    raw { exp_is_inf = isinf(exp) ? 1 : 0; }
    if exp_is_inf != 0 {
        let absb: f64 = 0.0; raw { absb = fabs(base); }
        if absb == 1.0 { return zjs_double(nan); }
    }
    return zjs_double(Math::pow(base, exp));
}

fn host_math_max(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §21.3.2.24: empty args → -Infinity. NaN propagates.
    // +0 ranks above -0 — observable via 1 / Math.max(-0, 0) === Infinity.
    if argc == 0 {
        let neg_inf: f64 = 0.0;
        raw { neg_inf = -INFINITY; }
        return zjs_double(neg_inf);
    }
    let i: u32 = 0;
    let any_nan: int = 0;
    let saw_pos_zero: int = 0;
    let best: f64 = 0.0;
    raw { best = -INFINITY; }
    while i < argc {
        let d = zjs_to_double(args[i]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let is_nan: int = 0;
        raw { is_nan = isnan(d) ? 1 : 0; }
        if is_nan != 0 { any_nan = 1; }
        else {
            if d == 0.0 {
                let bits: u64 = 0;
                raw { bits = *(uint64_t*)&d; }
                if (bits & 0x8000000000000000) == 0 { saw_pos_zero = 1; }
            }
            if d > best { best = d; }
        }
        i = i + 1;
    }
    if any_nan != 0 {
        let nv: f64 = 0.0;
        raw { nv = NAN; }
        return zjs_double(nv);
    }
    // Promote -0 result to +0 when any +0 was passed.
    if best == 0.0 && saw_pos_zero != 0 { return zjs_double(0.0); }
    return zjs_double(best);
}

fn host_math_min(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let inf: f64 = 0.0;
        raw { inf = INFINITY; }
        return zjs_double(inf);
    }
    let i: u32 = 0;
    let any_nan: int = 0;
    let saw_neg_zero: int = 0;
    let best: f64 = 0.0;
    raw { best = INFINITY; }
    while i < argc {
        let d = zjs_to_double(args[i]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let is_nan: int = 0;
        raw { is_nan = isnan(d) ? 1 : 0; }
        if is_nan != 0 { any_nan = 1; }
        else {
            if d == 0.0 {
                let bits: u64 = 0;
                raw { bits = *(uint64_t*)&d; }
                if (bits & 0x8000000000000000) != 0 { saw_neg_zero = 1; }
            }
            if d < best { best = d; }
        }
        i = i + 1;
    }
    if any_nan != 0 {
        let nv: f64 = 0.0;
        raw { nv = NAN; }
        return zjs_double(nv);
    }
    if best == 0.0 && saw_neg_zero != 0 {
        let nz: f64 = 0.0;
        raw { nz = -0.0; }
        return zjs_double(nz);
    }
    return zjs_double(best);
}

// One-argument Math wrappers — delegate to C math.h. NaN/Infinity
// propagation, domain errors → NaN, etc. are all handled by libm so
