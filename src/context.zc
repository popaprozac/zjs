// Engine context — Phase 3.0a.
//
// One context = one isolated JS world. Holds the global variable table
// and (later) the heap + GC + symbol table. Globals are referenced by
// integer slot index in compiled bytecode; the compiler and the runtime
// share the same context so slot indices match up by construction.

import "stdlib.h" as libc;
import "string.h" as libc_str;
import "./value.zc";

raw {
    #include <stdio.h>
    #include <stdlib.h>
    #include <string.h>
}

struct GlobalEntry {
    name:     char*;    // owned (calloc'd, copied from source); freed on ctx free
    name_len: u32;
    value:    ZjsValue;
}

struct GcRootFrame {
    regs:      ZjsValue*;
    reg_count: u32;
}

// Open-addressed hash-table entry. NULL `str` = empty slot.
// We never delete atoms, so no tombstones needed.
struct AtomEntry {
    str:  ZjsString*;
    hash: u32;
}

struct ZjsContext {
    // Root empty hidden class — every fresh {} starts here.
    empty_class:    ZjsHiddenClass*;

    globals:        GlobalEntry*;
    global_count:   u32;
    global_cap:     u32;

    // All heap-allocated cells owned by the context (Functions,
    // Strings, Objects, Arrays, HostFunctions). Each cell starts with
    // a CellHeader whose type_tag drives the free dispatch. The mark
    // bit drives GC reachability.
    cells:          void**;
    cell_count:     u32;
    cell_cap:       u32;

    // Set by zjs_eval when the program ends with an uncaught throw.
    // Public ABI: zjs_had_error / zjs_get_error.
    had_error:      bool;
    last_error:     ZjsValue;

    // Currently-executing closure (Phase 3.3). Push/pop'd by Invoke;
    // LoadEnv reads ctx.current_closure.env.
    current_closure: ZjsClosure*;

    // Implicit `this` for the currently-running host function (Phase 3.5).
    // Set by Op::MethodInvoke before dispatch and restored after. Host
    // builtins like Array.prototype.push read it via zjs_get_host_this().
    host_this: ZjsValue;

    // Cached "prototype" objects for built-in cell types (Phase 3.5).
    // Lazily populated by ctx_init_builtins. property_get on TAG_ARRAY
    // falls back to array_proto for unrecognized method names; same for
    // TAG_STRING / string_proto. Phase 3.6 will replace this with a real
    // hidden-class-driven proto chain.
    array_proto:    ZjsObject*;
    string_proto:   ZjsObject*;

    // --- GC state ---
    root_frames:    GcRootFrame*;     // grown geometrically
    root_depth:     u32;              // # of active interpret() frames
    root_cap:       u32;
    cells_since_gc: u32;              // allocations since last collection
    gc_threshold:   u32;              // run GC when cells_since_gc >= this

    // --- Atom table (interned strings) ---
    // Open-addressed hash table, power-of-2 capacity. Used for
    // property names + source-code string literals. Atoms are GC
    // roots so they live for the context's lifetime; that's fine for
    // names/literals that are inherently shared.
    atoms:          AtomEntry*;
    atom_count:     u32;
    atom_cap:       u32;
}

fn zjs_new_context() -> ZjsContext* {
    let result: ZjsContext* = NULL;
    raw {
        result = (ZjsContext*)calloc(1, sizeof(ZjsContext));
    }
    if result != NULL {
        // GC initial threshold: collect after the first 4096 cell allocations,
        // then adapt to 2× live count after each collection.
        result.gc_threshold = 4096;
        // calloc gave us {bits: 0}; explicitly initialize the implicit
        // host receiver to JS `undefined`.
        result.host_this = zjs_undefined();

        // Root empty class — registered as a cell, kept alive via the
        // context pointer itself (we mark it during gc_mark_roots).
        let empty = zjs_hidden_class_new(NULL, NULL, 0, 0);
        ctx_register_cell(result, (void*)empty);
        result.empty_class = empty;

        ctx_init_builtins(result);
    }
    return result;
}

fn zjs_free_context(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    let root_frames = ctx.root_frames;
    raw { free(root_frames); }
    let atoms = ctx.atoms;
    raw { free(atoms); }
    // Free every interned global name.
    let i: u32 = 0;
    while i < ctx.global_count {
        let name_ptr = ctx.globals[i].name;
        raw { free(name_ptr); }
        i = i + 1;
    }
    let globals = ctx.globals;
    raw { free(globals); }

    // Free every heap cell, dispatched by its type tag.
    let j: u32 = 0;
    while j < ctx.cell_count {
        let cp = ctx.cells[j];
        let tag: u8 = 0;
        raw { tag = ((CellHeader*)cp)->type_tag; }
        if tag == TAG_FUNCTION {
            raw {
                extern void function_free_void(void* f);
                function_free_void(cp);
            }
        } else if tag == TAG_STRING {
            string_free_void(cp);
        } else if tag == TAG_OBJECT {
            object_free_void(cp);
        } else if tag == TAG_ARRAY {
            array_free_void(cp);
        } else if tag == TAG_HOST_FUNCTION {
            host_function_free_void(cp);
        } else if tag == TAG_HIDDEN_CLASS {
            hidden_class_free_void(cp);
        } else if tag == TAG_CLOSURE {
            closure_free_void(cp);
        }
        j = j + 1;
    }
    let cells = ctx.cells;
    raw {
        free(cells);
        free(ctx);
    }
}

// Append a heap cell to the context's owned-cells list. Called whenever
// a new Function / String / etc. is allocated by the compiler or
// interpreter.
fn ctx_register_cell(ctx: ZjsContext*, p: void*) -> void {
    if ctx.cell_count >= ctx.cell_cap {
        let new_cap: u32 = if ctx.cell_cap == 0 { 16 } else { ctx.cell_cap * 2 };
        let old = ctx.cells;
        let new_arr: void** = NULL;
        raw { new_arr = (void**)realloc(old, new_cap * sizeof(void*)); }
        ctx.cells = new_arr;
        ctx.cell_cap = new_cap;
    }
    ctx.cells[ctx.cell_count] = p;
    ctx.cell_count = ctx.cell_count + 1;
    ctx.cells_since_gc = ctx.cells_since_gc + 1;
}

// =====================================================================
// GC — mark-sweep, run between interpreter instructions.
// =====================================================================

fn ctx_push_root_frame(ctx: ZjsContext*, regs: ZjsValue*, reg_count: u32) -> void {
    if ctx.root_depth >= ctx.root_cap {
        let new_cap: u32 = if ctx.root_cap == 0 { 16 } else { ctx.root_cap * 2 };
        let old = ctx.root_frames;
        let new_arr: GcRootFrame* = NULL;
        raw { new_arr = (GcRootFrame*)realloc(old, new_cap * sizeof(GcRootFrame)); }
        ctx.root_frames = new_arr;
        ctx.root_cap = new_cap;
    }
    ctx.root_frames[ctx.root_depth].regs = regs;
    ctx.root_frames[ctx.root_depth].reg_count = reg_count;
    ctx.root_depth = ctx.root_depth + 1;
}

fn ctx_pop_root_frame(ctx: ZjsContext*) -> void {
    if ctx.root_depth > 0 { ctx.root_depth = ctx.root_depth - 1; }
}

// Mark a single value's reachable graph. Idempotent — already-marked
// cells return immediately, breaking cycles.
fn gc_mark_value(v: ZjsValue) -> void {
    if zjs_is_cell(v) == 0 { return; }
    let p = zjs_cell_as_ptr(v);
    if p == NULL { return; }
    let h: CellHeader* = NULL;
    raw { h = (CellHeader*)p; }
    if h.mark != 0 { return; }
    h.mark = 1;

    let tag = h.type_tag;
    if tag == TAG_STRING        { return; }     // leaf
    if tag == TAG_HOST_FUNCTION { return; }     // leaf

    if tag == TAG_OBJECT {
        let o: ZjsObject* = NULL;
        raw { o = (ZjsObject*)p; }
        // Mark the object's class — its parent chain + transition map
        // are walked transitively.
        gc_mark_hidden_class(o.cls);
        // Mark all live slots.
        let live = if o.cls != NULL { o.cls.prop_count } else { 0 };
        let i: u32 = 0;
        while i < live {
            gc_mark_value(o.slots[i]);
            i = i + 1;
        }
        return;
    }

    if tag == TAG_HIDDEN_CLASS {
        let c: ZjsHiddenClass* = NULL;
        raw { c = (ZjsHiddenClass*)p; }
        gc_mark_hidden_class(c);
        return;
    }

    if tag == TAG_CLOSURE {
        let cl: ZjsClosure* = NULL;
        raw { cl = (ZjsClosure*)p; }
        // Mark the function template — wraps a Function* cell.
        if cl.function != NULL {
            let fn_val = zjs_cell_from_ptr(cl.function);
            gc_mark_value(fn_val);
        }
        // Mark the captured env object — walks its slots transitively
        // (each captured local is reachable through env).
        if cl.env != NULL {
            let env_val = zjs_cell_from_ptr((void*)cl.env);
            gc_mark_value(env_val);
        }
        return;
    }

    if tag == TAG_ARRAY {
        let a: ZjsArray* = NULL;
        raw { a = (ZjsArray*)p; }
        let i: u32 = 0;
        while i < a.length {
            gc_mark_value(a.elements[i]);
            i = i + 1;
        }
        return;
    }

    if tag == TAG_FUNCTION {
        let f: Function* = NULL;
        raw { f = (Function*)p; }
        let i: u32 = 0;
        while i < f.const_count {
            gc_mark_value(f.constants[i]);
            i = i + 1;
        }
        // Walk inline-cache entries — each carries a HiddenClass* that
        // must stay alive while this Function is reachable. Atom names
        // are pinned via the atom-table root, so we don't re-mark them.
        let j: u32 = 0;
        while j < f.ic_count {
            let c = f.ics[j].class_;
            if c != NULL { gc_mark_hidden_class(c); }
            j = j + 1;
        }
        return;
    }
}

// Mark a hidden class transitively: parent (chain back to root) and
// every child transition. Idempotent.
fn gc_mark_hidden_class(c: ZjsHiddenClass*) -> void {
    if c == NULL { return; }
    if c.header.mark != 0 { return; }
    c.header.mark = 1;
    // Names are atoms; they're already pinned via the atom-table root.
    if c.parent != NULL { gc_mark_hidden_class(c.parent); }
    let i: u32 = 0;
    while i < c.trans_count {
        gc_mark_hidden_class(c.trans_children[i]);
        i = i + 1;
    }
}

fn gc_mark_roots(ctx: ZjsContext*) -> void {
    // Root empty class
    if ctx.empty_class != NULL {
        gc_mark_hidden_class(ctx.empty_class);
    }
    // Current closure — its env must survive the GC even if it isn't
    // otherwise reachable (e.g., a closure mid-call with no caller-side ref).
    if ctx.current_closure != NULL {
        let cur_val = zjs_cell_from_ptr((void*)ctx.current_closure);
        gc_mark_value(cur_val);
    }
    // Implicit host receiver for the in-flight host call.
    gc_mark_value(ctx.host_this);
    // Built-in prototype objects (kept alive across the whole context).
    if ctx.array_proto != NULL {
        let ap_val = zjs_cell_from_ptr((void*)ctx.array_proto);
        gc_mark_value(ap_val);
    }
    if ctx.string_proto != NULL {
        let sp_val = zjs_cell_from_ptr((void*)ctx.string_proto);
        gc_mark_value(sp_val);
    }
    // Globals
    let i: u32 = 0;
    while i < ctx.global_count {
        gc_mark_value(ctx.globals[i].value);
        i = i + 1;
    }
    // Last uncaught error (so the C consumer can still inspect it)
    gc_mark_value(ctx.last_error);
    // Each active call frame
    let j: u32 = 0;
    while j < ctx.root_depth {
        let frame = ctx.root_frames[j];
        let k: u32 = 0;
        while k < frame.reg_count {
            gc_mark_value(frame.regs[k]);
            k = k + 1;
        }
        j = j + 1;
    }
    // Interned atoms — they live for the context's lifetime.
    let a: u32 = 0;
    while a < ctx.atom_cap {
        let s = ctx.atoms[a].str;
        if s != NULL { s.header.mark = 1; }
        a = a + 1;
    }
}

fn gc_sweep(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    let kept: u32 = 0;
    while i < ctx.cell_count {
        let p = ctx.cells[i];
        let h: CellHeader* = NULL;
        raw { h = (CellHeader*)p; }
        if h.mark != 0 {
            h.mark = 0;
            ctx.cells[kept] = p;
            kept = kept + 1;
        } else {
            let tag = h.type_tag;
            if tag == TAG_FUNCTION      {
                raw { extern void function_free_void(void* f); function_free_void(p); }
            } else if tag == TAG_STRING        { string_free_void(p); }
              else if tag == TAG_OBJECT        { object_free_void(p); }
              else if tag == TAG_ARRAY         { array_free_void(p); }
              else if tag == TAG_HOST_FUNCTION { host_function_free_void(p); }
        }
        i = i + 1;
    }
    ctx.cell_count = kept;
}

fn gc_run(ctx: ZjsContext*) -> void {
    gc_mark_roots(ctx);
    gc_sweep(ctx);
    ctx.cells_since_gc = 0;
    // Adapt threshold to grow with the live set; minimum floor of 256.
    let target: u32 = ctx.cell_count * 2;
    if target < 256 { target = 256; }
    ctx.gc_threshold = target;
}

fn ctx_maybe_gc(ctx: ZjsContext*) -> void {
    if ctx.cells_since_gc >= ctx.gc_threshold { gc_run(ctx); }
}

// --- Public ABI -----------------------------------------------------

fn zjs_gc(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    gc_run(ctx);
}

fn zjs_cell_count(ctx: ZjsContext*) -> u32 {
    if ctx == NULL { return 0; }
    return ctx.cell_count;
}

// Intern a string by copying the input bytes. The returned ZjsValue
// is a NaN-boxed cell pointer registered with the context.
//
// NOT deduplicated — every call allocates a fresh ZjsString. For
// dedup, use ctx_intern_atom. This is the right function for ToString
// results (numeric → "42") and other transient strings that don't
// benefit from dedup.
fn ctx_intern_string(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// Take ownership of an already-malloc'd buffer. Used by zjs_string_concat
// which allocates the result buffer itself. Also NOT deduplicated.
fn ctx_intern_string_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsValue {
    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

// =====================================================================
// Atom table — deduplicated strings. Used for property names and
// source-code string literals.
// =====================================================================

fn atom_hash(data: char*, length: u32) -> u32 {
    // FNV-1a 32-bit
    let h: u32 = 2166136261;
    let i: u32 = 0;
    while i < length {
        let b: u32 = (u32)(u8)data[i];
        h = h ^ b;
        h = h * 16777619;
        i = i + 1;
    }
    return h;
}

fn atom_table_insert_unchecked(ctx: ZjsContext*, s: ZjsString*, h: u32) -> void {
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        i = (i + 1) & mask;
    }
    ctx.atoms[i].str = s;
    ctx.atoms[i].hash = h;
    ctx.atom_count = ctx.atom_count + 1;
}

fn atom_table_grow(ctx: ZjsContext*) -> void {
    let old_cap = ctx.atom_cap;
    let old_atoms = ctx.atoms;

    let new_cap: u32 = if old_cap == 0 { 16 } else { old_cap * 2 };
    let new_atoms: AtomEntry* = NULL;
    raw {
        new_atoms = (AtomEntry*)calloc(new_cap, sizeof(AtomEntry));
    }
    ctx.atoms = new_atoms;
    ctx.atom_cap = new_cap;
    ctx.atom_count = 0;

    if old_cap > 0 {
        let i: u32 = 0;
        while i < old_cap {
            if old_atoms[i].str != NULL {
                atom_table_insert_unchecked(ctx, old_atoms[i].str, old_atoms[i].hash);
            }
            i = i + 1;
        }
        raw { free(old_atoms); }
    }
}

fn atom_table_lookup(ctx: ZjsContext*, data: char*, length: u32, h: u32) -> ZjsString* {
    if ctx.atom_cap == 0 { return NULL; }
    let mask = ctx.atom_cap - 1;
    let i = h & mask;
    while ctx.atoms[i].str != NULL {
        let s = ctx.atoms[i].str;
        if ctx.atoms[i].hash == h && s.length == length {
            let s_data = s.data;
            let eq: int = 0;
            raw { eq = (memcmp(s_data, data, length) == 0) ? 1 : 0; }
            if eq != 0 { return s; }
        }
        i = (i + 1) & mask;
    }
    return NULL;
}

// Public intern: dedupe by content. Allocates only on cache miss.
fn ctx_intern_atom(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL { return existing; }

    // Grow first if needed (so insert below doesn't trip a probe through a full table).
    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Same as above, but adopts ownership of an already-malloc'd
// null-terminated buffer. Frees the buffer on dedup hit.
fn ctx_intern_atom_take(ctx: ZjsContext*, data: char*, length: u32) -> ZjsString* {
    let h = atom_hash(data, length);
    let existing = atom_table_lookup(ctx, data, length, h);
    if existing != NULL {
        // Caller's buffer is redundant — free it.
        raw { free(data); }
        return existing;
    }

    if ctx.atom_count * 10 >= ctx.atom_cap * 7 {
        atom_table_grow(ctx);
    }

    let s = zjs_string_new_take(data, length);
    ctx_register_cell(ctx, (void*)s);
    atom_table_insert_unchecked(ctx, s, h);
    return s;
}

// Allocate a fresh empty object and register it on the context.
// Initializes with the root empty class — fresh property additions
// will spawn transitions on first write.
fn ctx_new_object(ctx: ZjsContext*) -> ZjsValue {
    let o = zjs_object_new();
    o.cls = ctx.empty_class;
    ctx_register_cell(ctx, (void*)o);
    return zjs_cell_from_ptr((void*)o);
}

// Full object_set with hidden-class transition logic. Updates an
// existing property if present; otherwise follows or creates a
// transition edge.
fn object_set(ctx: ZjsContext*, obj: ZjsObject*, name: ZjsString*, value: ZjsValue) -> void {
    if object_set_existing(obj, name, value) != 0 { return; }

    // Property is new. Find or create a transition.
    let parent_cls = obj.cls;
    let child = class_find_transition(parent_cls, name);
    if child == NULL {
        child = zjs_hidden_class_new(parent_cls, name,
                                      parent_cls.prop_count,
                                      parent_cls.prop_count + 1);
        ctx_register_cell(ctx, (void*)child);
        class_add_transition(parent_cls, name, child);
    }

    // Grow slots to accommodate the new property.
    let needed = child.prop_count;
    if obj.slot_cap < needed {
        let new_cap: u32 = if obj.slot_cap == 0 { 4 } else { obj.slot_cap * 2 };
        while new_cap < needed { new_cap = new_cap * 2; }
        let old = obj.slots;
        let new_slots: ZjsValue* = NULL;
        raw { new_slots = (ZjsValue*)realloc(old, new_cap * sizeof(ZjsValue)); }
        let und: ZjsValue = zjs_undefined();
        let i = obj.slot_cap;
        while i < new_cap {
            new_slots[i] = und;
            i = i + 1;
        }
        obj.slots = new_slots;
        obj.slot_cap = new_cap;
    }

    obj.slots[child.transition_slot] = value;
    obj.cls = child;
}

// Allocate a fresh array with `length` slots, all undefined.
fn ctx_new_array(ctx: ZjsContext*, length: u32) -> ZjsValue {
    let a = zjs_array_new(length);
    ctx_register_cell(ctx, (void*)a);
    return zjs_cell_from_ptr((void*)a);
}

// =====================================================================
// Host functions + built-in registry. ctx_init_builtins is called at
// the end of zjs_new_context so every context starts with Error and
// Math available globally.
// =====================================================================

// Register a host function as a global. fn_ptr must point to a C
// function with signature:
//     ZjsValue (*)(ZjsContext*, ZjsValue*, uint32_t)
fn ctx_register_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)calloc(1, sizeof(ZjsHostFunction)); }
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy: char* = NULL;
    raw {
        name_copy = (char*)malloc(name_len + 1);
        memcpy(name_copy, name, name_len + 1);
    }
    hf.name = name_copy;

    ctx_register_cell(ctx, (void*)hf);
    let val = zjs_cell_from_ptr((void*)hf);

    // Stash in a global slot.
    let slot = ctx_intern_global(ctx, name, (u32)name_len);
    ctx.globals[slot].value = val;
    return val;
}

// Like ctx_register_host_function but doesn't create a global slot —
// used when the function is going to be attached as an object property
// (e.g. Math.abs).
fn ctx_make_host_function(ctx: ZjsContext*, name: char*, fn_ptr: void*) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)calloc(1, sizeof(ZjsHostFunction)); }
    hf.header.type_tag = TAG_HOST_FUNCTION;
    hf.fn_ptr = fn_ptr;

    let name_len: usize = 0;
    raw { name_len = strlen(name); }
    let name_copy: char* = NULL;
    raw {
        name_copy = (char*)malloc(name_len + 1);
        memcpy(name_copy, name, name_len + 1);
    }
    hf.name = name_copy;

    ctx_register_cell(ctx, (void*)hf);
    return zjs_cell_from_ptr((void*)hf);
}

// --- Built-in implementations ---------------------------------------

// Error("msg") — produces { message: <msg>, name: "Error" }.
// Same behavior whether called with `new` or as a plain call (MVP).
fn host_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);

    let msg: ZjsValue = zjs_undefined();
    if argc > 0 { msg = args[0]; }
    if zjs_is_string(msg) == 0 { msg = zjs_to_string(ctx, msg); }

    // Property keys are atoms — interned for dedup across calls.
    let msg_name  = ctx_intern_atom(ctx, (char*)"message", 7);
    let name_name = ctx_intern_atom(ctx, (char*)"name", 4);
    object_set(ctx, obj, msg_name, msg);

    // The .name value "Error" is also a small string used frequently —
    // intern it as an atom too.
    let name_val_str = ctx_intern_atom(ctx, (char*)"Error", 5);
    let name_val = zjs_cell_from_ptr((void*)name_val_str);
    object_set(ctx, obj, name_name, name_val);

    return obj_v;
}

// --- Math.* helpers -------------------------------------------------

raw {
    #include <math.h>
}

fn host_math_abs(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let v = args[0];
    if zjs_is_int32(v) != 0 {
        let i = zjs_as_int32(v);
        if i >= 0 { return v; }
        return zjs_arith_neg(v);
    }
    let d = zjs_to_double(v);
    if d < 0.0 { return zjs_double(-d); }
    return zjs_double(d);
}

fn host_math_floor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    let r: f64 = 0.0;
    raw { r = floor(d); }
    return zjs_double(r);
}

fn host_math_ceil(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    let r: f64 = 0.0;
    raw { r = ceil(d); }
    return zjs_double(r);
}

fn host_math_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    // ECMA-262 Math.round rounds half toward +Infinity (not banker's rounding).
    let r: f64 = 0.0;
    raw { r = floor(d + 0.5); }
    return zjs_double(r);
}

fn host_math_sqrt(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0); }
    let d = zjs_to_double(args[0]);
    let r: f64 = 0.0;
    raw { r = sqrt(d); }
    return zjs_double(r);
}

fn host_math_pow(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let base: f64 = 1.0;
    let exp:  f64 = 1.0;
    if argc >= 1 { base = zjs_to_double(args[0]); }
    if argc >= 2 { exp  = zjs_to_double(args[1]); }
    let r: f64 = 0.0;
    raw { r = pow(base, exp); }
    return zjs_double(r);
}

fn host_math_max(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262: empty args -> -Infinity. MVP: undefined.
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = -INFINITY; }
        return zjs_double(nan);
    }
    let best = zjs_to_double(args[0]);
    let i: u32 = 1;
    while i < argc {
        let d = zjs_to_double(args[i]);
        if d > best { best = d; }
        i = i + 1;
    }
    return zjs_double(best);
}

fn host_math_min(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let inf: f64 = 0.0;
        raw { inf = INFINITY; }
        return zjs_double(inf);
    }
    let best = zjs_to_double(args[0]);
    let i: u32 = 1;
    while i < argc {
        let d = zjs_to_double(args[i]);
        if d < best { best = d; }
        i = i + 1;
    }
    return zjs_double(best);
}

// =====================================================================
// Phase 3.5 — Object / Array / String / JSON built-ins.
// =====================================================================

// Implicit receiver accessor for host functions. zjs_undefined() if the
// host was called via plain Invoke; the method-call receiver if via
// MethodInvoke.
fn zjs_get_host_this(ctx: ZjsContext*) -> ZjsValue {
    return ctx.host_this;
}

// Object.keys(obj) — array of own enumerable string keys, in insertion
// order. We walk the hidden-class chain bottom-up; each transition_name
// goes at transition_slot. Non-object inputs return an empty array.
fn host_object_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 || zjs_is_object(args[0]) == 0 {
        return ctx_new_array(ctx, 0);
    }
    let o = zjs_as_object(args[0]);
    let count = o.cls.prop_count;
    let arr_v = ctx_new_array(ctx, count);
    let arr = zjs_as_array(arr_v);
    let cls = o.cls;
    while cls != NULL && cls.parent != NULL {
        let name = cls.transition_name;
        let slot = cls.transition_slot;
        arr.elements[slot] = zjs_cell_from_ptr((void*)name);
        cls = cls.parent;
    }
    arr.length = count;
    return arr_v;
}

// --- Array.prototype helpers ---------------------------------------

fn host_array_push(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) == 0 { return zjs_undefined(); }
    let arr = zjs_as_array(this_val);
    let i: u32 = 0;
    while i < argc {
        array_set(arr, arr.length, args[i]);
        i = i + 1;
    }
    return zjs_int32((i32)arr.length);
}

fn host_array_pop(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) == 0 { return zjs_undefined(); }
    let arr = zjs_as_array(this_val);
    if arr.length == 0 { return zjs_undefined(); }
    let last = arr.elements[arr.length - 1];
    arr.elements[arr.length - 1] = zjs_undefined();
    arr.length = arr.length - 1;
    return last;
}

fn host_array_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) == 0 { return zjs_int32(-1); }
    if argc == 0 { return zjs_int32(-1); }
    let arr = zjs_as_array(this_val);
    let needle = args[0];
    let i: u32 = 0;
    while i < arr.length {
        if zjs_strict_eq(arr.elements[i], needle) != 0 {
            return zjs_int32((i32)i);
        }
        i = i + 1;
    }
    return zjs_int32(-1);
}

// --- String.prototype helpers ---------------------------------------

fn host_string_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_string(this_val) == 0 { return zjs_int32(-1); }
    if argc == 0 { return zjs_int32(-1); }
    let needle_v = args[0];
    if zjs_is_string(needle_v) == 0 { needle_v = zjs_to_string(ctx, needle_v); }
    let hay = zjs_as_string(this_val);
    let nee = zjs_as_string(needle_v);
    if nee.length == 0 { return zjs_int32(0); }
    if hay.length < nee.length { return zjs_int32(-1); }
    let hay_d = hay.data;
    let hay_n = hay.length;
    let nee_d = nee.data;
    let nee_n = nee.length;
    let result: i32 = -1;
    raw {
        for (uint32_t i = 0; i + nee_n <= hay_n; i++) {
            if (memcmp(hay_d + i, nee_d, nee_n) == 0) {
                result = (int32_t)i;
                break;
            }
        }
    }
    return zjs_int32(result);
}

// Clamp + normalize a slice endpoint (negatives count from end).
fn slice_clamp(v: ZjsValue, len: u32, default_val: i32) -> i32 {
    if zjs_is_undefined(v) != 0 { return default_val; }
    let n = (i32)zjs_to_double(v);
    if n < 0 { n = (i32)len + n; }
    if n < 0 { n = 0; }
    if n > (i32)len { n = (i32)len; }
    return n;
}

fn host_string_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_string(this_val) == 0 {
        return ctx_intern_string(ctx, (char*)"", 0);
    }
    let s = zjs_as_string(this_val);
    let start = if argc >= 1 { slice_clamp(args[0], s.length, 0) }
                else         { 0 };
    let end_default: i32 = (i32)s.length;
    let end = if argc >= 2 { slice_clamp(args[1], s.length, end_default) }
              else         { end_default };
    if end < start { end = start; }
    let outlen = (u32)(end - start);
    let buf: char* = NULL;
    let src = s.data;
    let src_off = (u32)start;
    raw {
        buf = (char*)malloc((size_t)outlen + 1);
        if (outlen > 0) memcpy(buf, src + src_off, outlen);
        buf[outlen] = '\0';
    }
    return ctx_intern_string_take(ctx, buf, outlen);
}

fn host_string_split(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_string(this_val) == 0 {
        return ctx_new_array(ctx, 0);
    }
    let s = zjs_as_string(this_val);
    // If no separator, return [s].
    if argc == 0 || zjs_is_undefined(args[0]) != 0 {
        let one = ctx_new_array(ctx, 1);
        let one_arr = zjs_as_array(one);
        one_arr.elements[0] = this_val;
        one_arr.length = 1;
        return one;
    }
    let sep_v = args[0];
    if zjs_is_string(sep_v) == 0 { sep_v = zjs_to_string(ctx, sep_v); }
    let sep = zjs_as_string(sep_v);
    let result_v = ctx_new_array(ctx, 0);
    let result = zjs_as_array(result_v);

    // Empty separator: split into individual characters.
    if sep.length == 0 {
        let i: u32 = 0;
        let sdata = s.data;
        while i < s.length {
            let buf: char* = NULL;
            let off = i;
            raw {
                buf = (char*)malloc(2);
                buf[0] = sdata[off];
                buf[1] = '\0';
            }
            let piece = ctx_intern_string_take(ctx, buf, 1);
            array_set(result, result.length, piece);
            i = i + 1;
        }
        return result_v;
    }

    let hay_d  = s.data;
    let hay_n  = s.length;
    let nee_d  = sep.data;
    let nee_n  = sep.length;
    let cursor: u32 = 0;
    let i: u32 = 0;
    while i + nee_n <= hay_n {
        let matches: int = 0;
        let off = i;
        raw { matches = (memcmp(hay_d + off, nee_d, nee_n) == 0) ? 1 : 0; }
        if matches != 0 {
            let piece_len = i - cursor;
            let buf: char* = NULL;
            let src_off = cursor;
            let plen = piece_len;
            raw {
                buf = (char*)malloc((size_t)plen + 1);
                if (plen > 0) memcpy(buf, hay_d + src_off, plen);
                buf[plen] = '\0';
            }
            let piece = ctx_intern_string_take(ctx, buf, piece_len);
            array_set(result, result.length, piece);
            cursor = i + nee_n;
            i = cursor;
        } else {
            i = i + 1;
        }
    }
    // Trailing remainder
    let tail_len = hay_n - cursor;
    let tail_buf: char* = NULL;
    let tail_src = cursor;
    let tlen = tail_len;
    raw {
        tail_buf = (char*)malloc((size_t)tlen + 1);
        if (tlen > 0) memcpy(tail_buf, hay_d + tail_src, tlen);
        tail_buf[tlen] = '\0';
    }
    let tail = ctx_intern_string_take(ctx, tail_buf, tail_len);
    array_set(result, result.length, tail);
    return result_v;
}

fn ctx_init_builtins(ctx: ZjsContext*) -> void {
    // --- Error ---
    let err_ptr: void* = NULL;
    raw { err_ptr = (void*)host_error; }
    ctx_register_host_function(ctx, (char*)"Error", err_ptr);

    // --- Math object with several method properties ---
    let math_v = ctx_new_object(ctx);
    let math   = zjs_as_object(math_v);

    let abs_ptr:   void* = NULL; raw { abs_ptr   = (void*)host_math_abs; }
    let floor_ptr: void* = NULL; raw { floor_ptr = (void*)host_math_floor; }
    let ceil_ptr:  void* = NULL; raw { ceil_ptr  = (void*)host_math_ceil; }
    let round_ptr: void* = NULL; raw { round_ptr = (void*)host_math_round; }
    let sqrt_ptr:  void* = NULL; raw { sqrt_ptr  = (void*)host_math_sqrt; }
    let pow_ptr:   void* = NULL; raw { pow_ptr   = (void*)host_math_pow; }
    let max_ptr:   void* = NULL; raw { max_ptr   = (void*)host_math_max; }
    let min_ptr:   void* = NULL; raw { min_ptr   = (void*)host_math_min; }

    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"abs", 3),
               ctx_make_host_function(ctx, (char*)"abs", abs_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"floor", 5),
               ctx_make_host_function(ctx, (char*)"floor", floor_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"ceil", 4),
               ctx_make_host_function(ctx, (char*)"ceil", ceil_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"round", 5),
               ctx_make_host_function(ctx, (char*)"round", round_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"sqrt", 4),
               ctx_make_host_function(ctx, (char*)"sqrt", sqrt_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"pow", 3),
               ctx_make_host_function(ctx, (char*)"pow", pow_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"max", 3),
               ctx_make_host_function(ctx, (char*)"max", max_ptr));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"min", 3),
               ctx_make_host_function(ctx, (char*)"min", min_ptr));

    let math_slot = ctx_intern_global(ctx, (char*)"Math", 4);
    ctx.globals[math_slot].value = math_v;

    // --- Object namespace (Phase 3.5) ---
    let object_v = ctx_new_object(ctx);
    let object_o = zjs_as_object(object_v);
    let keys_ptr: void* = NULL; raw { keys_ptr = (void*)host_object_keys; }
    object_set(ctx, object_o, ctx_intern_atom(ctx, (char*)"keys", 4),
               ctx_make_host_function(ctx, (char*)"keys", keys_ptr));
    let object_slot = ctx_intern_global(ctx, (char*)"Object", 6);
    ctx.globals[object_slot].value = object_v;

    // --- Array.prototype intercept (Phase 3.5) ---
    let array_proto_v = ctx_new_object(ctx);
    let array_proto = zjs_as_object(array_proto_v);
    let push_ptr:  void* = NULL; raw { push_ptr  = (void*)host_array_push; }
    let pop_ptr:   void* = NULL; raw { pop_ptr   = (void*)host_array_pop; }
    let aidx_ptr:  void* = NULL; raw { aidx_ptr  = (void*)host_array_index_of; }
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"push", 4),
               ctx_make_host_function(ctx, (char*)"push", push_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"pop", 3),
               ctx_make_host_function(ctx, (char*)"pop", pop_ptr));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"indexOf", 7),
               ctx_make_host_function(ctx, (char*)"indexOf", aidx_ptr));
    ctx.array_proto = array_proto;

    // --- String.prototype intercept (Phase 3.5) ---
    let string_proto_v = ctx_new_object(ctx);
    let string_proto = zjs_as_object(string_proto_v);
    let sidx_ptr:   void* = NULL; raw { sidx_ptr   = (void*)host_string_index_of; }
    let slice_ptr:  void* = NULL; raw { slice_ptr  = (void*)host_string_slice; }
    let split_ptr:  void* = NULL; raw { split_ptr  = (void*)host_string_split; }
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"indexOf", 7),
               ctx_make_host_function(ctx, (char*)"indexOf", sidx_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"slice", 5),
               ctx_make_host_function(ctx, (char*)"slice", slice_ptr));
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"split", 5),
               ctx_make_host_function(ctx, (char*)"split", split_ptr));
    ctx.string_proto = string_proto;
}

// --- Error inspection (public ABI) ----------------------------------

fn zjs_had_error(ctx: ZjsContext*) -> int {
    if ctx == NULL { return 0; }
    if ctx.had_error { return 1; }
    return 0;
}

fn zjs_get_error(ctx: ZjsContext*) -> ZjsValue {
    if ctx == NULL { return zjs_undefined(); }
    return ctx.last_error;
}

// =====================================================================
// ToString — produces a string ZjsValue from any input. Allocates on
// the context's cell list. Lives here (not in value.zc) because it
// needs to allocate cells via ctx_intern_string.
// =====================================================================

fn zjs_to_string(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    if zjs_is_string(v) != 0 { return v; }

    let buf: char[64];
    let len: usize = 0;

    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw { len = (size_t)snprintf(buf, 64, "%d", (int)n); }
    } else if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        raw { len = (size_t)snprintf(buf, 64, "%g", d); }
    } else if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { raw { len = (size_t)snprintf(buf, 64, "true"); } }
        else                    { raw { len = (size_t)snprintf(buf, 64, "false"); } }
    } else if zjs_is_null(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "null"); }
    } else if zjs_is_undefined(v) != 0 {
        raw { len = (size_t)snprintf(buf, 64, "undefined"); }
    } else {
        raw { len = (size_t)snprintf(buf, 64, "[object]"); }
    }

    return ctx_intern_string(ctx, &buf[0], (u32)len);
}

// String concatenation: a + b where at least one is a string. Both
// operands are coerced to strings; result is a fresh interned string
// on the context.
fn zjs_string_concat(ctx: ZjsContext*, a: ZjsValue, b: ZjsValue) -> ZjsValue {
    let sa_val = zjs_to_string(ctx, a);
    let sb_val = zjs_to_string(ctx, b);
    let sa = zjs_as_string(sa_val);
    let sb = zjs_as_string(sb_val);
    let total = sa.length + sb.length;
    let buf: char* = NULL;
    let sa_data = sa.data;
    let sb_data = sb.data;
    let sa_len = sa.length;
    let sb_len = sb.length;
    raw {
        buf = (char*)malloc(total + 1);
        memcpy(buf, sa_data, sa_len);
        memcpy(buf + sa_len, sb_data, sb_len);
        buf[total] = 0;
    }
    return ctx_intern_string_take(ctx, buf, total);
}

// Find an existing global by name. Returns -1 if not found (i32 so we
// can use a sentinel).
fn ctx_find_global(ctx: ZjsContext*, name: char*, name_len: u32) -> i32 {
    let i: u32 = 0;
    while i < ctx.global_count {
        if ctx.globals[i].name_len == name_len {
            let ent_name = ctx.globals[i].name;
            let eq: int = 0;
            raw { eq = (memcmp(ent_name, name, name_len) == 0) ? 1 : 0; }
            if eq != 0 { return (i32)i; }
        }
        i = i + 1;
    }
    return -1;
}

// Intern a global name: return its slot index, creating a fresh slot
// (with value = undefined) if it doesn't exist yet.
fn ctx_intern_global(ctx: ZjsContext*, name: char*, name_len: u32) -> u32 {
    let existing = ctx_find_global(ctx, name, name_len);
    if existing >= 0 { return (u32)existing; }

    // Grow the table if needed.
    if ctx.global_count >= ctx.global_cap {
        let new_cap: u32 = if ctx.global_cap == 0 { 16 } else { ctx.global_cap * 2 };
        let old_g = ctx.globals;
        let new_g: GlobalEntry* = NULL;
        raw {
            new_g = (GlobalEntry*)realloc(old_g, new_cap * sizeof(GlobalEntry));
            // Zero the new tail so we have a defined starting state.
            memset(&new_g[ctx->global_cap], 0, (new_cap - ctx->global_cap) * sizeof(GlobalEntry));
        }
        ctx.globals = new_g;
        ctx.global_cap = new_cap;
    }

    // Allocate + copy the name (it's a slice of caller's source).
    let name_copy: char* = NULL;
    raw {
        name_copy = (char*)malloc(name_len + 1);
        memcpy(name_copy, name, name_len);
        name_copy[name_len] = 0;
    }

    let idx = ctx.global_count;
    ctx.globals[idx].name = name_copy;
    ctx.globals[idx].name_len = name_len;
    ctx.globals[idx].value = zjs_undefined();
    ctx.global_count = ctx.global_count + 1;
    return idx;
}
