               ctx_make_host_function(ctx, (char*)"subtract", pdsub_ptr));
    let pduntil_ptr: void* = NULL; raw { pduntil_ptr = (void*)host_temporal_plaindate_until; }
    let pdsince_ptr: void* = NULL; raw { pdsince_ptr = (void*)host_temporal_plaindate_since; }
