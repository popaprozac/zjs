// Resolve a wall-clock (in tz) to epoch nanoseconds (i64), DST-
// 'compatible' via the platform mktime helper.
fn zdt_epoch_ns_from_wall(tz: ZjsString*, y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, sub_ns: i64) -> i64 {
    let tzdata: char* = NULL;
    if tz != NULL { tzdata = tz.data; }
    let secs: i64 = 0;
    raw { secs = (int64_t)zjs_tz_epoch_from_local(tzdata, (int)y, (int)mo, (int)d, (int)h, (int)mi, (int)s); }
    return secs * 1000000000 + sub_ns;
}

// Build a ZonedDateTime from an epoch-ns i64 + tz id.
fn zdt_make(ctx: ZjsContext*, epoch_ns: i64, tz: ZjsString*) -> ZjsValue {
    let bi = zjs_bigint_from_i64(epoch_ns);
