    object_set(ctx, ctx.temporal_yearmonth_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), ym_ctor);
    let ymfrom_ptr: void* = NULL; raw { ymfrom_ptr = (void*)host_temporal_yearmonth_from; }
