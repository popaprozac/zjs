    }
    ctx_register_host_function(ctx, (char*)"Date",       eval_ptr);
    // RegExp — real constructor + prototype carrying .test (.exec next
    // commit). property_get on TAG_REGEXP walks ctx.regexp_proto.
    let regexp_ctor_ptr: void* = NULL; raw { regexp_ctor_ptr = (void*)host_regexp_ctor; }
    let regexp_v = ctx_register_host_function(ctx, (char*)"RegExp", regexp_ctor_ptr);
    let regexp_hf = zjs_as_host_function(regexp_v);
    regexp_hf.arity = 2;
    let rp_v = ctx_new_object(ctx);
    regexp_hf.prototype = zjs_as_object(rp_v);
    ctx.regexp_proto = regexp_hf.prototype;
    object_set(ctx, regexp_hf.prototype,
               ctx_intern_atom(ctx, (char*)"constructor", 11), regexp_v);
    let rtest_ptr: void* = NULL; raw { rtest_ptr = (void*)host_regexp_test; }
    object_set(ctx, regexp_hf.prototype, ctx_intern_atom(ctx, (char*)"test", 4),
               ctx_make_host_function_arity(ctx, (char*)"test", rtest_ptr, 1));
    let rexec_ptr: void* = NULL; raw { rexec_ptr = (void*)host_regexp_exec; }
    object_set(ctx, regexp_hf.prototype, ctx_intern_atom(ctx, (char*)"exec", 4),
               ctx_make_host_function_arity(ctx, (char*)"exec", rexec_ptr, 1));
    ctx_register_host_function(ctx, (char*)"Symbol",     eval_ptr);
    ctx_register_host_function(ctx, (char*)"Map",        eval_ptr);
    ctx_register_host_function(ctx, (char*)"Set",        eval_ptr);
    ctx_register_host_function(ctx, (char*)"WeakMap",    eval_ptr);
    ctx_register_host_function(ctx, (char*)"WeakSet",    eval_ptr);
    // Phase 3.10 — real Promise constructor.
    let promise_ptr: void* = NULL; raw { promise_ptr = (void*)host_promise_ctor; }
    let promise_v = ctx_register_host_function(ctx, (char*)"Promise", promise_ptr);
    let promise_hf = zjs_as_host_function(promise_v);
    promise_hf.arity = 1;
    // Promise.prototype — instance methods.
