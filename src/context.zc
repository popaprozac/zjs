    let ssub_ptr:   void* = NULL; raw { ssub_ptr   = (void*)host_string_substring; }
    let strim_ptr:  void* = NULL; raw { strim_ptr  = (void*)host_string_trim; }
    let srep_ptr:   void* = NULL; raw { srep_ptr   = (void*)host_string_repeat; }
    let ssw_ptr:    void* = NULL; raw { ssw_ptr    = (void*)host_string_starts_with; }
