    property_set(ctx, inst_ctor, ctx_intern_string(ctx, (char*)"compare", 7),
                 ctx_make_host_function(ctx, (char*)"compare", icmp_ptr));
    let ifrom_ptr: void* = NULL; raw { ifrom_ptr = (void*)host_temporal_instant_from; }
    property_set(ctx, inst_ctor, ctx_intern_string(ctx, (char*)"from", 4),
                 ctx_make_host_function(ctx, (char*)"from", ifrom_ptr));
    object_set(ctx, temporal_o, ctx_intern_atom(ctx, (char*)"Instant", 7), inst_ctor);

    // --- Temporal.PlainDate ---
    let pd_ctor_ptr: void* = NULL; raw { pd_ctor_ptr = (void*)host_temporal_plaindate_ctor; }
    let pd_ctor = ctx_make_host_function(ctx, (char*)"PlainDate", pd_ctor_ptr);
