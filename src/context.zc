    // Math constants — ECMA-262 §21.3. Read-only data properties.
    // PI/E come from std/math; the others aren't exposed there yet, so
    // we fall back to <math.h>'s M_* macros via raw{}.
    let ln2_d: f64 = 0.0;
    let ln10_d: f64 = 0.0;
    let log2e_d: f64 = 0.0;
    let log10e_d: f64 = 0.0;
    let sqrt2_d: f64 = 0.0;
    let sqrt1_2_d: f64 = 0.0;
    raw {
        ln2_d     = M_LN2;
        ln10_d    = M_LN10;
        log2e_d   = M_LOG2E;
        log10e_d  = M_LOG10E;
        sqrt2_d   = M_SQRT2;
        sqrt1_2_d = M_SQRT1_2;
    }
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"PI", 2),       zjs_double(Math::PI()));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"E", 1),        zjs_double(Math::E()));
    object_set(ctx, math, ctx_intern_atom(ctx, (char*)"LN2", 3),      zjs_double(ln2_d));
