    // --- Array.prototype intercept (Phase 3.5) ---
    let array_proto_v = ctx_new_object(ctx);
    let array_proto = zjs_as_object(array_proto_v);
    let push_ptr:  void* = NULL; raw { push_ptr  = (void*)host_array_push; }
    let pop_ptr:   void* = NULL; raw { pop_ptr   = (void*)host_array_pop; }
    let aidx_ptr:  void* = NULL; raw { aidx_ptr  = (void*)host_array_index_of; }
    let map_ptr:   void* = NULL; raw { map_ptr   = (void*)host_array_map; }
    let fe_ptr:    void* = NULL; raw { fe_ptr    = (void*)host_array_for_each; }
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"push", 4),
               ctx_make_host_function_arity(ctx, (char*)"push", push_ptr, 1));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"pop", 3),
               ctx_make_host_function_arity(ctx, (char*)"pop", pop_ptr, 0));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"indexOf", 7),
               ctx_make_host_function_arity(ctx, (char*)"indexOf", aidx_ptr, 1));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"map", 3),
               ctx_make_host_function_arity(ctx, (char*)"map", map_ptr, 1));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"forEach", 7),
               ctx_make_host_function_arity(ctx, (char*)"forEach", fe_ptr, 1));
    let join_ptr:   void* = NULL; raw { join_ptr   = (void*)host_array_join; }
    // Array.prototype.toString delegates to .join() with comma separator
    // (or Object.prototype.toString if join isn't callable, but our
    // arrays always have join). Use the join host fn directly — it
    // already handles empty-separator default = ",".
    let aslice_ptr: void* = NULL; raw { aslice_ptr = (void*)host_array_slice; }
    let aconc_ptr:  void* = NULL; raw { aconc_ptr  = (void*)host_array_concat; }
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"join", 4),
               ctx_make_host_function_arity(ctx, (char*)"join", join_ptr, 1));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"toString", 8),
               ctx_make_host_function_arity(ctx, (char*)"toString", join_ptr, 0));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"slice", 5),
               ctx_make_host_function_arity(ctx, (char*)"slice", aslice_ptr, 2));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"concat", 6),
               ctx_make_host_function_arity(ctx, (char*)"concat", aconc_ptr, 1));
    // Array iterator methods (snapshot — see host_array_keys docs).
    let akeys_ptr:  void* = NULL; raw { akeys_ptr  = (void*)host_array_keys; }
    let avals_ptr:  void* = NULL; raw { avals_ptr  = (void*)host_array_values; }
    let aents_ptr:  void* = NULL; raw { aents_ptr  = (void*)host_array_entries; }
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"keys", 4),
               ctx_make_host_function_arity(ctx, (char*)"keys", akeys_ptr, 0));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"values", 6),
               ctx_make_host_function_arity(ctx, (char*)"values", avals_ptr, 0));
    object_set(ctx, array_proto, ctx_intern_atom(ctx, (char*)"entries", 7),
               ctx_make_host_function_arity(ctx, (char*)"entries", aents_ptr, 0));
