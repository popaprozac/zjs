    }
    return zjs_int32(r);
}
fn host_math_random(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // [0,1) — coarse: rand() / (RAND_MAX + 1.0). Engine-quality
    // PRNG is a separate concern.
    let r: f64 = 0.0;
    raw { r = (double)rand() / ((double)RAND_MAX + 1.0); }
    return zjs_double(r);
}

// =====================================================================
// Phase 3.4 — for-in / for-of iteration prepare.
//
// `kind` 0 = for-in (own enumerable string keys of an object); 1 = for-of
// (element values; strings yield each char as a 1-char string). Non-
// iterables yield an empty array. Used by Op::IterPrepare.
// =====================================================================

fn iter_prepare(ctx: ZjsContext*, src: ZjsValue, kind: u32) -> ZjsValue {
    if kind == 0 {
        // for-in: enumerate own + inherited string keys, in insertion
        // order at each prototype level, skipping names already seen
        // at a more-specific level (own shadows inherited) and skipping
        // DELETED slots.
        //
        // We stop at ctx.object_proto so the global Object.prototype's
        // built-in methods (toString/hasOwnProperty) don't appear in
        // for-in output — those are non-enumerable per spec, and we
        // don't track enumerable flags yet. Plain objects' own props
        // are surfaced normally because their cls chain stops above
        // object_proto.
        if zjs_is_array(src) != 0 {
            // Arrays: enumerate the present index keys as strings
            // "0", "1", ... (skips holes per spec — for-in iterates
            // own enumerable string keys, and a hole is not "own").
            let a = zjs_as_array(src);
            let arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, arr_v);
            defer ctx_pop_temp_root(ctx);
            let arr = zjs_as_array(arr_v);
            let i: u32 = 0;
            while i < a.length {
                if zjs_is_deleted(a.elements[i]) == 0 {
                    let buf: char[16];
                    let key_len: int = 0;
                    raw { key_len = snprintf(&buf[0], 16, "%u", (unsigned)i); }
                    let kp: char* = NULL;
                    raw { kp = &buf[0]; }
                    array_set(arr, arr.length, ctx_intern_string(ctx, kp, (u32)key_len));
                }
                i = i + 1;
            }
            return arr_v;
        }
        if zjs_is_object(src) != 0 {
            let arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, arr_v);
            defer ctx_pop_temp_root(ctx);
            // Track all own names seen across the proto walk — used to
            // shadow ancestor entries even when the closer level's
            // entry was non-enumerable (spec). Separate from `arr`
            // which only collects the emitted enumerable keys.
            let shadowed_arr_v = ctx_new_array(ctx, 0);
            ctx_push_temp_root(ctx, shadowed_arr_v);
            defer ctx_pop_temp_root(ctx);
            let shadowed_v = zjs_as_array(shadowed_arr_v);
            let arr = zjs_as_array(arr_v);
            let cur: ZjsObject* = zjs_as_object(src);
            while cur != NULL && cur != ctx.object_proto {
                // Collect this level's own names in insertion order
                // (= slot index order). Then append to the result,
                // skipping shadowed names.
                let prop_count = cur.cls.prop_count;
                // Heap-allocate the scratch so it scales with object
                // size. Lodash UMD attaches 270+ methods to its `_`
                // function; a fixed cap of 64 here would silently
                // drop names past the cap. Manually dealloc'd at
                // the end of each iteration (we can't `defer` inside
                // the loop — Zen-c's defer is function-scoped).
                let limit: u32 = prop_count;
                let scratch = alloc_n<ZjsString*>((usize)limit);
                let scratch_del = alloc_n<bool>((usize)limit);
                let init_i: u32 = 0;
                while init_i < limit {
                    scratch[init_i] = NULL;
                    scratch_del[init_i] = false;
                    init_i = init_i + 1;
                }
                let cls = cur.cls;
                while cls != NULL && cls.parent != NULL {
                    let slot = cls.transition_slot;
                    if slot < limit {
                        // for-in yields only enumerable own keys per
                        // spec; non-enumerable slots are silently
                        // skipped (the `scratch_del` flag handles
                        // both holes and non-enumerable as "absent").
                        let a = object_get_attrs(cur, slot);
                        let enumerable = (a & PROP_ENUMERABLE) != 0;
                        scratch[slot] = cls.transition_name;
                        scratch_del[slot] =
                            zjs_is_deleted(cur.slots[slot]) != 0
                            || !enumerable;
                    }
                    cls = cls.parent;
                }
                let i: u32 = 0;
                while i < limit {
                    let nm = scratch[i];
                    if nm != NULL {
                        // Skip internal (`__zjs_*`) and Symbol-shim (`@@*`)
                        // hidden keys. See string_is_hidden_key.
                        let is_internal = string_is_hidden_key(nm);
                        if !is_internal {
                            // Shadowed by an earlier (more-specific)
                            // level? Important: even an own
                            // non-enumerable own prop shadows the
                            // ancestor's enumerable one, so we track
                            // shadowing via `shadowed_v`, separate
                            // from the emit list.
                            let seen: bool = false;
                            let j: u32 = 0;
                            while j < shadowed_v.length {
                                if zjs_as_string(shadowed_v.elements[j]) == nm {
                                    seen = true; j = shadowed_v.length;
                                } else { j = j + 1; }
                            }
                            if !seen {
                                array_set(shadowed_v, shadowed_v.length, zjs_cell_from_ptr((void*)nm));
                                if !scratch_del[i] {
                                    array_set(arr, arr.length, zjs_cell_from_ptr((void*)nm));
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
                dealloc(scratch);
                dealloc(scratch_del);
                cur = cur.proto;
            }
            return arr_v;
        }
        return ctx_new_array(ctx, 0);
    }

    // for-of on null/undefined throws TypeError per ECMA-262
    // §14.7.5.5 (GetIterator → RequireObjectCoercible).
    if zjs_is_null(src) != 0 || zjs_is_undefined(src) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"for-of on null or undefined", 27);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return ctx_new_array(ctx, 0);
    }
    // for-of: element values. Spec: %ArrayIteratorPrototype%.next does
    // Get(O, ToString(k)) on each step — holes surface as undefined to
    // the loop, and **mutations during iteration are observed** (pops
    // shorten the run, pushes extend it). Return the live array; the
    // for-of bytecode re-reads ArrayLength on every iteration to pick
    // up length changes.
    if zjs_is_array(src) != 0 {
        return src;
    }
    if zjs_is_string(src) != 0 {
        // Split into 1-char strings. Cheap fallback — proper iterator
        // protocol arrives later.
        let s = zjs_as_string(src);
        let arr_v = ctx_new_array(ctx, s.length);
        ctx_push_temp_root(ctx, arr_v);
        let arr = zjs_as_array(arr_v);
        let sdata = s.data;
        let i: u32 = 0;
        while i < s.length {
            let buf = alloc_n<char>((usize)2);
            buf[0] = sdata[i];
            buf[1] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, 1);
            arr.elements[i] = piece;
            i = i + 1;
        }
        arr.length = s.length;
        ctx_pop_temp_root(ctx);
        return arr_v;
    }
    // ECMA-262 GetIterator: pull the iterator via [@@iterator] (we
    // stand in for Symbol.iterator with the string key "@@iterator"
    // until real Symbols ship). Generators have it on their proto;
    // user code can install it on plain objects to make them iterable.
    let iter_key = ctx_intern_atom(ctx, (char*)"@@iterator", 10);
    let iter_key_v = zjs_cell_from_ptr((void*)iter_key);
    let getter = property_get(ctx, src, iter_key_v);
    if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
    let getter_callable: bool =
        zjs_is_function(getter) != 0
        || zjs_is_closure(getter) != 0
        || zjs_is_host_function(getter) != 0;
    if getter_callable {
        let nullp: ZjsValue* = NULL;
        let iter: ZjsValue = zjs_undefined();
        raw { iter = zjs_call_value_with_this(ctx, getter, src, nullp, 0); }
        if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        // Drive iter.next() until done. Pre-collect into an array — we
        // don't have a lazy for-of yet.
        let next_atom = ctx_intern_atom(ctx, (char*)"next", 4);
        let value_atom = ctx_intern_atom(ctx, (char*)"value", 5);
        let done_atom  = ctx_intern_atom(ctx, (char*)"done", 4);
        let coll = ctx_new_array(ctx, 0);
        ctx_push_temp_root(ctx, coll);
        let coll_arr = zjs_as_array(coll);
        let safety: u32 = 0;
        while safety < 100000000 {
            let next_fn = property_get(ctx, iter, zjs_cell_from_ptr((void*)next_atom));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            let result_v: ZjsValue = zjs_undefined();
            raw { result_v = zjs_call_value_with_this(ctx, next_fn, iter, nullp, 0); }
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            let d_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)done_atom));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            let done: bool = false;
            if zjs_is_bool(d_v) != 0 { done = zjs_as_bool(d_v) != 0; }
            if done { break; }
            let v_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)value_atom));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return coll; }
            array_set(coll_arr, coll_arr.length, v_v);
            safety = safety + 1;
        }
        ctx_pop_temp_root(ctx);
        return coll;
    }
    // Sloppy fallback for an iterable-shaped plain object without
    // @@iterator: a `length` property + numeric keys.
    if zjs_is_object(src) != 0 {
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        let lv = property_get(ctx, src, zjs_cell_from_ptr((void*)len_atom));
        if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        if zjs_is_undefined(lv) == 0 {
            return src;   // walk by index (array-like)
        }
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"for-of on non-iterable value", 28);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return ctx_new_array(ctx, 0);
}

// =====================================================================
// Live iterator helpers (2026-05-16). Backing for array destructuring
// and (future) lazy for-of. iter_prepare above eagerly materializes;
// these three step through one .next() at a time, observe iter.return()
// when needed, and propagate abrupt completions.
// =====================================================================

struct IterStep {
    value: ZjsValue;
    done:  bool;
}

// In JS, "Object" means "anything that isn't a primitive". For the
// iterator protocol's GetIterator / IteratorStep checks the engine
// needs to be precise: arrays, functions, closures, host functions,
// arguments, generators all qualify; numbers / booleans / strings /
// null / undefined / symbols do not.
fn value_is_js_object(v: ZjsValue) -> bool {
    if zjs_is_undefined(v) != 0 { return false; }
    if zjs_is_null(v)      != 0 { return false; }
    if zjs_is_bool(v)      != 0 { return false; }
    if zjs_is_int32(v)     != 0 { return false; }
    if zjs_is_double(v)    != 0 { return false; }
    if zjs_is_string(v)    != 0 { return false; }
    return true;
}

// Equivalent of spec's GetIterator(src, sync). Returns the iterator
// object — calling src[@@iterator]() with src as `this`. On error
// (non-callable @@iterator, throw from the call) sets
// ctx.pending_throw_active and returns undefined. Arrays carry an
// implicit iterator backed by .length + index walk; we materialize
// that into a generator-shaped object lazily here when src has no
// own/inherited @@iterator (matches our string stand-in for
// Symbol.iterator).
fn iter_get(ctx: ZjsContext*, src: ZjsValue) -> ZjsValue {
    // Coerce null/undefined explicitly — every caller already runs
    // RequireObjectCoercible, so a direct TypeError here would mask
    // the more specific destructure_pattern message. Treat as empty.
    if zjs_is_undefined(src) != 0 || zjs_is_null(src) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"value is not iterable", 21);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    // TypedArrays don't carry @@iterator on their prototype but the
    // spec wires them up to the same %ArrayIteratorPrototype%. Build
    // a TAG_ARRAY_ITER directly — iter_step recognizes the typed-
    // array source and loads via ta_load. Same trick is used for
    // pristine Array / String above.
    let src_tag = zjs_cell_tag(src);
    if src_tag == TAG_UINT8_ARRAY || src_tag == TAG_TYPED_ARRAY {
        let ai = zjs_array_iter_new(src);
        ctx_register_cell(ctx, (void*)ai);
        return zjs_cell_from_ptr((void*)ai);
    }
    let iter_key = ctx_intern_atom(ctx, (char*)"@@iterator", 10);
    let getter = property_get(ctx, src, zjs_cell_from_ptr((void*)iter_key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let getter_callable: bool =
        zjs_is_function(getter) != 0
        || zjs_is_closure(getter) != 0
        || zjs_is_host_function(getter) != 0;
    if getter_callable {
        // Fast path: pristine Array / String iterator. The @@iterator
        // lookup resolved to our cached host fn AND src is the right
        // shape — skip the wrapper-object dance and just hand back a
        // TAG_ARRAY_ITER, which iter_step indexes directly.
        if getter.bits == ctx.array_iter_host_fn.bits
           && (zjs_is_array(src) != 0 || zjs_is_string(src) != 0) {
            let ai = zjs_array_iter_new(src);
            ctx_register_cell(ctx, (void*)ai);
            return zjs_cell_from_ptr((void*)ai);
        }
        let nullp: ZjsValue* = NULL;
        let iter: ZjsValue = zjs_undefined();
        raw { iter = zjs_call_value_with_this(ctx, getter, src, nullp, 0); }
        if ctx.pending_throw_active { return zjs_undefined(); }
        // Spec GetIterator step "If Type(iterator) is not Object, throw
        // a TypeError exception." Without this check we'd hand a
        // primitive back to iter_step, which would silently no-op the
        // next() call and loop forever. Surfaces as TypeError so the
        // outer combinator can reject its promise normally.
        if !value_is_js_object(iter) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"iterator result is not an object", 32);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        return iter;
    }
    // No callable @@iterator — including the case where user code
    // explicitly deleted it (`delete Array.prototype[Symbol.iterator]`).
    // Per spec: TypeError, full stop. Earlier impls fell back to a
    // synthetic wrapper here; that path is dead now that Array.prototype
    // and String.prototype carry @@iterator.
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"value is not iterable", 21);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return zjs_undefined();
}

// Async-aware GetIterator. Spec §7.4.5: prefer `@@asyncIterator`;
// fall back to `@@iterator` (sync) — the caller (for-await loop)
// awaits each result so a sync iter yielding plain {value, done}
// works fine here.
fn iter_get_async(ctx: ZjsContext*, src: ZjsValue) -> ZjsValue {
    if zjs_is_undefined(src) != 0 || zjs_is_null(src) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"value is not async iterable", 27);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let key = ctx_intern_atom(ctx, (char*)"@@asyncIterator", 15);
    let getter = property_get(ctx, src, zjs_cell_from_ptr((void*)key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let callable: bool =
        zjs_is_function(getter) != 0
        || zjs_is_closure(getter) != 0
        || zjs_is_host_function(getter) != 0;
    if callable {
        let nullp: ZjsValue* = NULL;
        let iter: ZjsValue = zjs_undefined();
        raw { iter = zjs_call_value_with_this(ctx, getter, src, nullp, 0); }
        if ctx.pending_throw_active { return zjs_undefined(); }
        if !value_is_js_object(iter) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"async iterator result is not an object", 38);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        return iter;
    }
    // Fall back to sync @@iterator. The for-await loop awaits every
    // next() result via Op::Await, so a sync iter's plain {value,
    // done} return is awaited (no-op for non-Promise values).
    return iter_get(ctx, src);
}

// Spec IteratorStep: calls iter.next(); returns {value, done}. On
// abrupt completion sets ctx.pending_throw_active and returns
// {undefined, true} (treat as done so callers stop).
fn iter_step(ctx: ZjsContext*, iter: ZjsValue) -> IterStep {
    // Fast path for the pristine-array iterator. Index walk, no
    // property_get, no host call. Recovers the ~3x array_iterate
    // regression introduced by switching for-of to the live protocol.
    if zjs_is_array_iter(iter) != 0 {
        let ai = zjs_as_array_iter(iter);
        if ai.done { return IterStep{ value: zjs_undefined(), done: true }; }
        if zjs_is_array(ai.src) != 0 {
            let arr = zjs_as_array(ai.src);
            if ai.index >= arr.length {
                ai.done = true;
                return IterStep{ value: zjs_undefined(), done: true };
            }
            // Expando bag present → an indexed accessor may be defined
            // for this slot (e.g. defineProperty on "0" with a getter).
            // Route through property_get so the getter fires; otherwise
            // the spec-required side effects on iteration are silently
            // skipped. Plain dense arrays (no props) keep the fast path.
            if arr.props != NULL {
                let idx_key = zjs_int32((i32)ai.index);
                let v_slow = property_get(ctx, ai.src, idx_key);
                if ctx.pending_throw_active {
                    return IterStep{ value: zjs_undefined(), done: true };
                }
                ai.index = ai.index + 1;
                return IterStep{ value: v_slow, done: false };
            }
            let v = arr.elements[ai.index];
            if zjs_is_deleted(v) != 0 { v = zjs_undefined(); }
            ai.index = ai.index + 1;
            return IterStep{ value: v, done: false };
        }
        if zjs_is_string(ai.src) != 0 {
            let s = zjs_as_string(ai.src);
            if ai.index >= s.length {
                ai.done = true;
                return IterStep{ value: zjs_undefined(), done: true };
            }
            let buf = alloc_n<char>((usize)2);
            buf[0] = s.data[ai.index];
            buf[1] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, 1);
            ai.index = ai.index + 1;
            return IterStep{ value: piece, done: false };
        }
        // TypedArray: load via ta_load (per-kind reinterpretation).
        let src_tag = zjs_cell_tag(ai.src);
        if src_tag == TAG_UINT8_ARRAY || src_tag == TAG_TYPED_ARRAY {
            let ta = zjs_as_typed_array(ai.src);
            if ai.index >= ta.length {
                ai.done = true;
                return IterStep{ value: zjs_undefined(), done: true };
            }
            let v = ta_load(ta, ai.index);
            ai.index = ai.index + 1;
            return IterStep{ value: v, done: false };
        }
        // Shouldn't happen, but fall through to done.
        ai.done = true;
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let nullp: ZjsValue* = NULL;
    let next_atom = ctx_intern_atom(ctx, (char*)"next", 4);
    let next_fn = property_get(ctx, iter, zjs_cell_from_ptr((void*)next_atom));
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    // Spec IteratorNext: next must be callable. Without this our
    // zjs_call_value_with_this silently returns undefined when handed
    // a non-callable, and the loop spins forever interpreting `{ done:
    // undefined }` as "keep going".
    let next_callable: bool =
        zjs_is_function(next_fn) != 0
        || zjs_is_closure(next_fn) != 0
        || zjs_is_host_function(next_fn) != 0;
    if !next_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"iterator.next is not callable", 29);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let result_v: ZjsValue = zjs_undefined();
    raw { result_v = zjs_call_value_with_this(ctx, next_fn, iter, nullp, 0); }
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    // Spec IteratorNext: result must be an Object. Otherwise the
    // protocol can't trust .done / .value and we'd loop or read holes.
    if !value_is_js_object(result_v) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"iterator result is not an object", 32);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let done_atom  = ctx_intern_atom(ctx, (char*)"done", 4);
    let value_atom = ctx_intern_atom(ctx, (char*)"value", 5);
    let d_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)done_atom));
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    let done: bool = false;
    if zjs_is_bool(d_v) != 0 { done = zjs_as_bool(d_v) != 0; }
    else if zjs_is_undefined(d_v) == 0 { done = true; }   // spec: ToBoolean
    if done {
        return IterStep{ value: zjs_undefined(), done: true };
    }
    let v_v = property_get(ctx, result_v, zjs_cell_from_ptr((void*)value_atom));
    if ctx.pending_throw_active { return IterStep{ value: zjs_undefined(), done: true }; }
    return IterStep{ value: v_v, done: false };
}

// Call iter.next() and return the raw result without splitting into
// {value, done}. for-await uses this — per ECMA-262 §14.7.5.3, the
// next() result must be awaited BEFORE the .done / .value reads
// (async iterators return a Promise that resolves to the iterator
// result; sync iterators return the result object directly and the
// await is a no-op pass-through).
fn iter_call_next_raw(ctx: ZjsContext*, iter: ZjsValue) -> ZjsValue {
    // Fast-path TAG_ARRAY_ITER: iter_step handles this internally
    // without going through property_get / call. Replicate it here and
    // synthesize a fresh { value, done } result object so the for-await
    // sequence (Await + LoadProp .value/.done) sees the same shape it
    // would from a user-defined async iterator.
    if zjs_is_array_iter(iter) != 0 {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let obj_v = ctx_new_object(ctx);
        let obj = zjs_as_object(obj_v);
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"value", 5), step.value);
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"done",  4), zjs_bool(step.done));
        return obj_v;
    }
    let nullp: ZjsValue* = NULL;
    let next_atom = ctx_intern_atom(ctx, (char*)"next", 4);
    let next_fn = property_get(ctx, iter, zjs_cell_from_ptr((void*)next_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let next_callable: bool =
        zjs_is_function(next_fn) != 0
        || zjs_is_closure(next_fn) != 0
        || zjs_is_host_function(next_fn) != 0;
    if !next_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"iterator.next is not callable", 29);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let result_v: ZjsValue = zjs_undefined();
    raw { result_v = zjs_call_value_with_this(ctx, next_fn, iter, nullp, 0); }
    return result_v;
}

// Spec IteratorClose with normal completion: calls iter.return() if
// the iterator has one. Spec also has a "with abrupt" variant that
// rethrows the original completion if return() throws — for now we
// don't distinguish; a throwing return() surfaces directly.
fn iter_close(ctx: ZjsContext*, iter: ZjsValue) -> void {
    if zjs_is_undefined(iter) != 0 || zjs_is_null(iter) != 0 { return; }
    // Fast-path iterators have no .return() — nothing to do.
    if zjs_is_array_iter(iter) != 0 { return; }
    let nullp: ZjsValue* = NULL;
    let ret_atom = ctx_intern_atom(ctx, (char*)"return", 6);
    let ret_fn = property_get(ctx, iter, zjs_cell_from_ptr((void*)ret_atom));
    if ctx.pending_throw_active { return; }
    if zjs_is_undefined(ret_fn) != 0 || zjs_is_null(ret_fn) != 0 { return; }
    let callable: bool =
        zjs_is_function(ret_fn) != 0
        || zjs_is_closure(ret_fn) != 0
        || zjs_is_host_function(ret_fn) != 0;
    if !callable { return; }
    let _result: ZjsValue = zjs_undefined();
    raw { _result = zjs_call_value_with_this(ctx, ret_fn, iter, nullp, 0); }
    // Pending throw (if any) is left active so the caller propagates.
}

// `this[@@iterator]()` for arrays and strings — returns the synthetic
// `{ _src, _i, next }` wrapper. Installed on Array.prototype /
// String.prototype below so user code (and our own iter_get) sees
// arrays as natively iterable.
fn host_array_at_iterator(ctx: ZjsContext*) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    let wrapper = ctx_new_object(ctx);
    let w = zjs_as_object(wrapper);
    let i_atom = ctx_intern_atom(ctx, (char*)"_i", 2);
    let src_atom = ctx_intern_atom(ctx, (char*)"_src", 4);
    object_set(ctx, w, i_atom, zjs_int32(0));
    object_set(ctx, w, src_atom, recv);
    let next_fn = ctx_make_host_function(ctx, (char*)"next", (void*)host_array_iter_next);
    let next_atom = ctx_intern_atom(ctx, (char*)"next", 4);
    object_set(ctx, w, next_atom, next_fn);
    // %ArrayIteratorPrototype% has @@iterator returning self, so user
    // code can do `for (const v of arr[Symbol.iterator]())`. Install
    // it on the wrapper itself for now — a real prototype chain is
    // overkill until iterators grow more shape.
    let self_iter_fn = ctx_make_host_function(ctx, (char*)"[Symbol.iterator]", (void*)host_self_iter);
    object_set(ctx, w, ctx_intern_atom(ctx, (char*)"@@iterator", 10), self_iter_fn);
    return wrapper;
}

// `function() { return this; }` — used as @@iterator on iterators
// (per spec, iterators are themselves iterable, returning themselves).
fn host_self_iter(ctx: ZjsContext*) -> ZjsValue {
    return zjs_get_host_this(ctx);
}

// Host-side next() for the synthetic array/string iterator built by
// iter_get. `this` carries _src + _i; bump _i, return { value, done }.
fn host_array_iter_next(ctx: ZjsContext*) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    if zjs_is_object(recv) == 0 {
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let i_atom = ctx_intern_atom(ctx, (char*)"_i", 2);
    let src_atom = ctx_intern_atom(ctx, (char*)"_src", 4);
    let i_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)i_atom));
    let src = property_get(ctx, recv, zjs_cell_from_ptr((void*)src_atom));
    let i: u32 = 0;
    if zjs_is_int32(i_v) != 0 { i = (u32)zjs_as_int32(i_v); }
    if zjs_is_array(src) != 0 {
        let a = zjs_as_array(src);
        if i >= a.length { return build_iter_result_helper(ctx, zjs_undefined(), true); }
        let v = a.elements[i];
        if zjs_is_deleted(v) != 0 { v = zjs_undefined(); }
        object_set(ctx, zjs_as_object(recv), i_atom, zjs_int32((i32)(i + 1)));
        return build_iter_result_helper(ctx, v, false);
    }
    if zjs_is_string(src) != 0 {
        let s = zjs_as_string(src);
        if i >= s.length { return build_iter_result_helper(ctx, zjs_undefined(), true); }
        let buf = alloc_n<char>((usize)2);
        buf[0] = s.data[i];
        buf[1] = (char)0;
        let piece = ctx_intern_string_take(ctx, buf, 1);
        object_set(ctx, zjs_as_object(recv), i_atom, zjs_int32((i32)(i + 1)));
        return build_iter_result_helper(ctx, piece, false);
    }
    return build_iter_result_helper(ctx, zjs_undefined(), true);
}

// Construct an `{ value, done }` result object — separate from the
// interpreter's local helper so this file can build them too.
fn build_iter_result_helper(ctx: ZjsContext*, value: ZjsValue, done: bool) -> ZjsValue {
    let r = ctx_new_object(ctx);
    let ro = zjs_as_object(r);
    object_set(ctx, ro, ctx_intern_atom(ctx, (char*)"value", 5), value);
    object_set(ctx, ro, ctx_intern_atom(ctx, (char*)"done",  4), zjs_bool(done));
    return r;
}

// =====================================================================
// Phase 3.5 — Object / Array / String / JSON built-ins.
// =====================================================================

// Implicit receiver accessor for host functions. zjs_undefined() if the
// host was called via plain Invoke; the method-call receiver if via
// MethodInvoke.
fn zjs_get_host_this(ctx: ZjsContext*) -> ZjsValue {
    return ctx.host_this;
}

// Object() / new Object() — when called as a constructor, returns the
// (potentially boxed) primitive or a fresh object.
fn host_object_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §20.1.1.1: Object(value) returns a wrapped version of
    // primitives, and the value itself if it's already an object.
    // For `new Object()` with no args, returns a fresh {}.
    if argc == 0 {
        if zjs_is_object(ctx.host_this) != 0 { return ctx.host_this; }
        return ctx_new_object(ctx);
    }
    let v = args[0];
    if zjs_is_undefined(v) != 0 || zjs_is_null(v) != 0 {
        if zjs_is_object(ctx.host_this) != 0 { return ctx.host_this; }
        return ctx_new_object(ctx);
    }
    if zjs_is_object(v) != 0 || zjs_is_array(v) != 0
       || zjs_is_function(v) != 0 || zjs_is_closure(v) != 0
       || zjs_is_host_function(v) != 0 || zjs_is_promise(v) != 0 {
        return v;
    }
    // Primitive — wrap via ToObject (yields Boolean/Number/String wrapper
    // with the appropriate prototype chain).
    let wrapped = ctx_to_object(ctx, v);
    if ctx.pending_throw_active { return zjs_undefined(); }
    return wrapped;
}

// Object.create(proto) — fresh empty object whose [[Prototype]] is proto.
// Phase 3.6.
// Forward — defined below.
raw {
    extern ZjsValue host_object_define_properties(ZjsContext* ctx, ZjsValue* args, uint32_t argc);
}

fn host_object_create(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §20.1.2.2 — Object.create(O, Properties): O must be an
    // Object or null, else throw TypeError. argc==0 is treated as O =
    // undefined per spec semantics.
    let proto_v = if argc > 0 { args[0] } else { zjs_undefined() };
    let proto_ok: bool =
           zjs_is_object(proto_v) != 0
        || zjs_is_null(proto_v) != 0;
    if !proto_ok {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object prototype may only be an Object or null", 47);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    if zjs_is_object(proto_v) != 0 {
        obj.proto = zjs_as_object(proto_v);
    }
    // null proto stays as top-of-chain (obj.proto = NULL).
    // Phase 3.9a: second arg is a descriptor map. Accept any object-y
    // value (plain object, array with expandos, host/user function
    // with .props) — host_object_define_properties knows how to walk
    // each shape.
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let p1 = args[1];
        // ECMA-262 §20.1.2.3.1: Properties argument must be coercible
        // to an Object. null and other primitives throw. Strings are
        // wrapped (they coerce to a String object whose enumerable
        // chars become descriptor names → which then fail
        // ToPropertyDescriptor for the single-char descriptor values).
        // We model that as "throw TypeError" for both null and
        // primitives — the inner test would throw anyway.
        // ECMA-262 ToObject(props) accepts any object-coercible value.
        // For zjs that means any cell value EXCEPT a primitive string
        // (a string here would coerce to String wrapper but its own
        // enumerable keys are character indices, none of which are
        // valid descriptors — net effect = no descriptors applied, no
        // error). null/undefined are the actual reject case.
        let p1_objlike: bool =
               zjs_is_object(p1) != 0
            || zjs_is_array(p1) != 0
            || zjs_is_function(p1) != 0
            || zjs_is_host_function(p1) != 0
            || zjs_is_regexp(p1) != 0
            || zjs_is_date(p1) != 0
            || zjs_is_map(p1) != 0
            || zjs_is_set(p1) != 0
            || zjs_is_symbol(p1) != 0;
        if !p1_objlike {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Object.create properties must be an Object", 42);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        if p1_objlike {
            ctx_push_temp_root(ctx, obj_v);
            let dp_args: ZjsValue[2];
            dp_args[0] = obj_v;
            dp_args[1] = p1;
            let p: ZjsValue* = NULL;
            raw { p = &dp_args[0]; }
            raw { (void)host_object_define_properties(ctx, p, 2); }
            ctx_pop_temp_root(ctx);
        }
    }
    return obj_v;
}

// Object.defineProperty(obj, key, descriptor) — Phase 3.9a.
//
// MVP: handles DATA descriptors (the `value` field). The
// writable/enumerable/configurable attributes are accepted but not
// enforced — every property is effectively configurable. Accessor
// descriptors (get/set) are recognized as "absent value" and the
// property is created with value = undefined; calling the
// accessor isn't wired up yet (Phase 3.9b).
// Resolve the receiver to the ZjsObject* where named properties go.
// Plain objects ARE the receiver. Arrays / functions / host fns /
// regex carry their named props in a sub-object (lazy-created via
// the .props field). Returns NULL if the receiver isn't supported
// (e.g. primitives — defineProperty silently no-ops there).
fn resolve_define_receiver(ctx: ZjsContext*, obj_v: ZjsValue) -> ZjsObject* {
    if zjs_is_object(obj_v) != 0 { return zjs_as_object(obj_v); }
    if zjs_is_array(obj_v) != 0 {
        let arr = zjs_as_array(obj_v);
        if arr.props == NULL {
            let pv = ctx_new_object(ctx);
            arr.props = zjs_as_object(pv);
        }
        return arr.props;
    }
    if zjs_is_function(obj_v) != 0 {
        let fp = zjs_cell_as_ptr(obj_v);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if f.props == NULL {
            let pv = ctx_new_object(ctx);
            f.props = zjs_as_object(pv);
        }
        return f.props;
    }
    // Closure-wrapped function (class ctor with outer captures, or
    // any captured-scope function). Route to the closure's OWN .props
    // bag — every closure value gets its own. The previous code aimed
    // at the underlying Function*.props, which is shared across every
    // closure that points at the same Function — so two separate
    // closures (e.g. zod's $constructor returning a fresh `_` per
    // call) would scribble over each other's `.name` / `.init` etc.
    // Falling back to Function*.props would also defeat per-instance
    // semantics; we just allocate on demand here.
    if zjs_is_closure(obj_v) != 0 {
        let cl = zjs_as_closure(obj_v);
        if cl.props == NULL {
            let pv = ctx_new_object(ctx);
            cl.props = zjs_as_object(pv);
        }
        return cl.props;
    }
    if zjs_is_host_function(obj_v) != 0 {
        let hf = zjs_as_host_function(obj_v);
        if hf.props == NULL {
            let pv = ctx_new_object(ctx);
            hf.props = zjs_as_object(pv);
        }
        return hf.props;
    }
    if zjs_is_regexp(obj_v) != 0 {
        let r = zjs_as_regexp(obj_v);
        if r.props == NULL {
            let pv = ctx_new_object(ctx);
            r.props = zjs_as_object(pv);
        }
        return r.props;
    }
    if zjs_is_date(obj_v) != 0 {
        let d = zjs_as_date(obj_v);
        if d.props == NULL {
            let pv = ctx_new_object(ctx);
            d.props = zjs_as_object(pv);
        }
        return d.props;
    }
    if zjs_is_map(obj_v) != 0 {
        let m = zjs_as_map(obj_v);
        if m.props == NULL {
            let pv = ctx_new_object(ctx);
            m.props = zjs_as_object(pv);
        }
        return m.props;
    }
    if zjs_is_set(obj_v) != 0 {
        let s = zjs_as_set(obj_v);
        if s.props == NULL {
            let pv = ctx_new_object(ctx);
            s.props = zjs_as_object(pv);
        }
        return s.props;
    }
    if zjs_is_symbol(obj_v) != 0 {
        let sym = zjs_as_symbol(obj_v);
        if sym.props == NULL {
            let pv = ctx_new_object(ctx);
            sym.props = zjs_as_object(pv);
        }
        return sym.props;
    }
    return NULL;
}

// ECMA-262 HasProperty(desc, name): walks the descriptor's proto
// chain for plain objects, plus checks the expando bag for
// array / function / host-fn / regex descriptors. Used by
// defineProperty's partial-merge logic — ToPropertyDescriptor
// queries HasProperty rather than [[GetOwnProperty]], so inherited
// fields participate.
fn descriptor_has_own(desc: ZjsValue, name: ZjsString*) -> bool {
    if zjs_is_object(desc) != 0 {
        let cur = zjs_as_object(desc);
        while cur != NULL {
            let slot = class_find_slot(cur.cls, name);
            if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 {
                return true;
            }
            cur = cur.proto;
        }
        return false;
    }
    let bag: ZjsObject* = NULL;
    if zjs_is_array(desc) != 0 {
        let a = zjs_as_array(desc);
        bag = a.props;
    } else if zjs_is_function(desc) != 0 {
        let fp = zjs_cell_as_ptr(desc);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        bag = f.props;
    } else if zjs_is_host_function(desc) != 0 {
        bag = zjs_as_host_function(desc).props;
    } else if zjs_is_regexp(desc) != 0 {
        bag = zjs_as_regexp(desc).props;
    } else {
        return false;
    }
    if bag == NULL { return false; }
    let cur = bag;
    while cur != NULL {
        let slot = class_find_slot(cur.cls, name);
        if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 {
            return true;
        }
        cur = cur.proto;
    }
    return false;
}

fn host_object_define_property(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 3 { return zjs_undefined(); }
    let obj_v = args[0];
    let o = resolve_define_receiver(ctx, obj_v);
    if o == NULL { return obj_v; }

    let key_v = args[1];
    // Symbol keys coerce to their canonical atom ("@@toPrimitive",
    // "@@iterator", "@@sym:N") so the slot matches what property_get
    // / property_set use internally. ToString'ing a Symbol would
    // produce "Symbol(toPrimitive)" — a different key entirely.
    key_v = symbol_key_coerce(key_v);
    if zjs_is_string(key_v) == 0 { key_v = zjs_to_string(ctx, key_v); }
    let key_str = zjs_as_string(key_v);
    let key_atom = ctx_intern_atom(ctx, key_str.data, key_str.length);

    // ECMA-262 §10.4.2.4 ArraySetLength: if obj is an Array and key
    // names a numeric index, bump array.length to max(length, idx+1).
    // Tests rely on this so a for-of over an array that only had
    // defineProperty install a key visits it.
    if zjs_is_array(obj_v) != 0 {
        let idx = zjs_to_array_index(key_v);
        if idx >= 0 {
            let arr = zjs_as_array(obj_v);
            let need = (u32)idx + 1;
            if need > arr.length { arr.length = need; }
        }
    }

    // Descriptor may be a plain object OR an array (whose expando bag
    // holds the value/get/set keys) OR a host/user function with
    // .props. Use property_get to read named slots through whichever
    // shape is present.
    let desc_v = args[2];
    let desc_objlike: bool =
           zjs_is_object(desc_v) != 0
        || zjs_is_array(desc_v) != 0
        || zjs_is_function(desc_v) != 0
        || zjs_is_host_function(desc_v) != 0
        || zjs_is_regexp(desc_v) != 0;
    if !desc_objlike { return obj_v; }

    let value_key  = ctx_intern_atom(ctx, (char*)"value", 5);
    let get_key    = ctx_intern_atom(ctx, (char*)"get",   3);
    let set_key    = ctx_intern_atom(ctx, (char*)"set",   3);

    let value_key_v = zjs_cell_from_ptr((void*)value_key);
    let get_key_v   = zjs_cell_from_ptr((void*)get_key);
    let set_key_v   = zjs_cell_from_ptr((void*)set_key);

    let value_lookup = property_get(ctx, desc_v, value_key_v);
    let get_lookup   = property_get(ctx, desc_v, get_key_v);
    let set_lookup   = property_get(ctx, desc_v, set_key_v);

    // ECMA-262 §6.2.5 ToPropertyDescriptor: a get/set that is present
    // (non-undefined) but not callable, or a descriptor that mixes a
    // data field (value) with an accessor field (get/set), is a
    // TypeError. property_get returns undefined for missing properties,
    // so a `get: undefined` (or absent `get`) reads as undefined and is
    // a valid "no getter" — only non-undefined non-callable throws.
    let get_present = zjs_is_undefined(get_lookup) == 0;
    let set_present = zjs_is_undefined(set_lookup) == 0;
    let get_callable = zjs_is_function(get_lookup) != 0 || zjs_is_closure(get_lookup) != 0 || zjs_is_host_function(get_lookup) != 0;
    let set_callable = zjs_is_function(set_lookup) != 0 || zjs_is_closure(set_lookup) != 0 || zjs_is_host_function(set_lookup) != 0;
    if get_present && !get_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Getter must be a function or undefined", 38);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    if set_present && !set_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Setter must be a function or undefined", 38);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let has_value = zjs_is_undefined(value_lookup) == 0;
    let has_get   = get_callable;
    let has_set   = set_callable;
    if has_value && (get_present || set_present) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot both specify accessors and a value or writable attribute", 64);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }

    // Read attribute fields. ECMA-262 §6.2.5 ToPropertyDescriptor:
    // when defineProperty/Properties is given a descriptor, ABSENT
    // attributes default to FALSE — stricter than plain assignment
    // (`o.x = 1`) which uses PROP_DEFAULT (all true). When
    // redefining an existing property we'd merge with the existing
    // descriptor, but MVP defines unconditionally with whatever's
    // present (or false).
    // ECMA-262 §6.2.5.1 ToPropertyDescriptor + 9.1.6.3
    // ValidateAndApplyPropertyDescriptor: when redefining an existing
    // own property, fields absent from the new descriptor inherit
    // from the existing one. Detect "has X" by walking the
    // descriptor's own keys (not via property_get, which can't tell
    // missing from undefined-valued).
    let wri_key = ctx_intern_atom(ctx, (char*)"writable",     8);
    let enu_key = ctx_intern_atom(ctx, (char*)"enumerable",   10);
    let cfg_key = ctx_intern_atom(ctx, (char*)"configurable", 12);
    let value_atom_str = ctx_intern_atom(ctx, (char*)"value", 5);
    let has_value_field = descriptor_has_own(desc_v, value_atom_str);
    let has_wri_field   = descriptor_has_own(desc_v, wri_key);
    let has_enu_field   = descriptor_has_own(desc_v, enu_key);
    let has_cfg_field   = descriptor_has_own(desc_v, cfg_key);
    let wri_lookup = property_get(ctx, desc_v, zjs_cell_from_ptr((void*)wri_key));
    let enu_lookup = property_get(ctx, desc_v, zjs_cell_from_ptr((void*)enu_key));
    let cfg_lookup = property_get(ctx, desc_v, zjs_cell_from_ptr((void*)cfg_key));

    // Compute attrs. Existing slot? Start from its current attrs and
    // override only the bits the new descriptor explicitly specifies.
    // No existing slot → defineProperty defaults (all false) per spec.
    let existing_slot = class_find_slot(o.cls, key_atom);
    let attrs: u8 = 0;
    if existing_slot >= 0 {
        attrs = object_get_attrs(o, (u32)existing_slot);
    }
    if has_wri_field {
        if zjs_to_bool_coerce(wri_lookup) != 0 { attrs = attrs | PROP_WRITABLE; }
        else                                   { attrs = attrs & ~PROP_WRITABLE; }
    }
    if has_enu_field {
        if zjs_to_bool_coerce(enu_lookup) != 0 { attrs = attrs | PROP_ENUMERABLE; }
        else                                   { attrs = attrs & ~PROP_ENUMERABLE; }
    }
    if has_cfg_field {
        if zjs_to_bool_coerce(cfg_lookup) != 0 { attrs = attrs | PROP_CONFIGURABLE; }
        else                                   { attrs = attrs & ~PROP_CONFIGURABLE; }
    }

    // Descriptor kind by field presence (ECMA-262 §6.2.5): an explicit
    // `get`/`set` field — even `undefined` — makes it an accessor desc.
    let has_get_field = descriptor_has_own(desc_v, get_key);
    let has_set_field = descriptor_has_own(desc_v, set_key);
    let new_is_acc = has_get_field || has_set_field;
    let cur_is_acc = existing_slot >= 0 && zjs_is_accessor(o.slots[(u32)existing_slot]) != 0;

    // ECMA-262 §10.1.6.3 ValidateAndApplyPropertyDescriptor — reject
    // illegal redefinition of a NON-configurable existing property.
    if existing_slot >= 0 {
        let cur_attrs = object_get_attrs(o, (u32)existing_slot);
        if (cur_attrs & PROP_CONFIGURABLE) == 0 {
            let cur_raw = o.slots[(u32)existing_slot];
            let new_is_data = has_value_field || has_wri_field;
            let reject = false;
            if has_cfg_field && zjs_to_bool_coerce(cfg_lookup) != 0 { reject = true; }
            if has_enu_field {
                let cur_enum = (cur_attrs & PROP_ENUMERABLE) != 0;
                let new_enum = zjs_to_bool_coerce(enu_lookup) != 0;
                if new_enum != cur_enum { reject = true; }
            }
            if !reject {
                if new_is_acc && cur_is_acc == false { reject = true; }
                else if new_is_data && cur_is_acc { reject = true; }
                else if cur_is_acc {
                    let acc0 = zjs_as_accessor(cur_raw);
                    if has_get_field && zjs_same_value_zero(get_lookup, acc0.get) == 0 { reject = true; }
                    if has_set_field && zjs_same_value_zero(set_lookup, acc0.set) == 0 { reject = true; }
                } else if (cur_attrs & PROP_WRITABLE) == 0 {
                    if has_wri_field && zjs_to_bool_coerce(wri_lookup) != 0 { reject = true; }
                    if has_value_field && zjs_same_value_zero(value_lookup, cur_raw) == 0 { reject = true; }
                }
            }
            if reject {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Cannot redefine property", 24);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return zjs_undefined();
            }
        }
    }

    if new_is_acc || (cur_is_acc && has_value_field == false && has_wri_field == false) {
        // Accessor result. When redefining, fields absent from the new
        // descriptor inherit from the existing accessor (spec merge).
        let cur_get: ZjsValue = zjs_undefined();
        let cur_set: ZjsValue = zjs_undefined();
        if cur_is_acc {
            let ca = zjs_as_accessor(o.slots[(u32)existing_slot]);
            cur_get = ca.get; cur_set = ca.set;
        }
        let g: ZjsValue = if has_get_field { get_lookup } else { cur_get };
        let s: ZjsValue = if has_set_field { set_lookup } else { cur_set };
        let acc = zjs_accessor_new(g, s);
        ctx_register_cell(ctx, (void*)acc);
        let av = zjs_cell_from_ptr((void*)acc);
        let acc_attrs = attrs & (PROP_ENUMERABLE | PROP_CONFIGURABLE);
        object_define_property_slot(ctx, o, key_atom, av, acc_attrs);
        return obj_v;
    }

    // Data descriptor — extract `value`. If the descriptor doesn't
    // carry a `value` field AND the slot already exists (as a data
    // prop), keep the existing value (only attrs change).
    let value: ZjsValue = zjs_undefined();
    if has_value_field {
        value = value_lookup;
    } else if existing_slot >= 0 && cur_is_acc == false {
        value = o.slots[(u32)existing_slot];
    }
    object_define_property_slot(ctx, o, key_atom, value, attrs);
    return obj_v;
}

// Object.defineProperties(obj, props) — Phase 3.9a.
// Walks props's own keys (via the hidden-class chain) and calls
// defineProperty for each.
fn host_object_define_properties(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return if argc > 0 { args[0] } else { zjs_undefined() }; }
    let obj_v = args[0];
    // ECMA-262 §19.1.2.3 step 1: receiver must be an Object. "Object"
    // here includes callables (functions, closures, host functions) —
    // chalk's `Object.defineProperties(() => {}, {...})` pattern. Route
    // the descriptor writes via resolve_define_receiver so they land
    // in the callable's .props bag (same place defineProperty stores).
    // Previously we early-returned on non-plain-object receivers, so
    // defineProperties silently no-op'd for callable targets (#290).
    let recv_o: ZjsObject* = NULL;
    if zjs_is_object(obj_v) != 0
       || zjs_is_function(obj_v) != 0
       || zjs_is_closure(obj_v) != 0
       || zjs_is_host_function(obj_v) != 0
       || zjs_is_array(obj_v) != 0 {
        recv_o = resolve_define_receiver(ctx, obj_v);
    }
    if recv_o == NULL { return obj_v; }
    let props_v = args[1];
    // ECMA-262 §19.1.2.3 step 2: props is ToObject'd. Plain objects
    // use their own hidden class. Arrays / functions / host fns /
    // regex carry their named-property expando in a sub-object —
    // walk THAT for the descriptors, but call property_get on the
    // ORIGINAL receiver so accessor `this` is the function / array
    // / regex itself.
    let cls_root: ZjsHiddenClass* = NULL;
    let cls_owner_v: ZjsValue = zjs_undefined();
    if zjs_is_array(props_v) != 0 {
        let pa = zjs_as_array(props_v);
        if pa.props == NULL { return obj_v; }
        cls_root = pa.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_function(props_v) != 0 {
        let fp = zjs_cell_as_ptr(props_v);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if f.props == NULL { return obj_v; }
        cls_root = f.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_host_function(props_v) != 0 {
        let hf = zjs_as_host_function(props_v);
        if hf.props == NULL { return obj_v; }
        cls_root = hf.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_regexp(props_v) != 0 {
        let r = zjs_as_regexp(props_v);
        if r.props == NULL { return obj_v; }
        cls_root = r.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_date(props_v) != 0 {
        let dd = zjs_as_date(props_v);
        if dd.props == NULL { return obj_v; }
        cls_root = dd.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_map(props_v) != 0 {
        let mm = zjs_as_map(props_v);
        if mm.props == NULL { return obj_v; }
        cls_root = mm.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_set(props_v) != 0 {
        let ss = zjs_as_set(props_v);
        if ss.props == NULL { return obj_v; }
        cls_root = ss.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_symbol(props_v) != 0 {
        let symv = zjs_as_symbol(props_v);
        if symv.props == NULL { return obj_v; }
        cls_root = symv.props.cls;
        cls_owner_v = props_v;
    } else if zjs_is_object(props_v) != 0 {
        cls_root = zjs_as_object(props_v).cls;
        cls_owner_v = props_v;
    } else {
        return obj_v;
    }

    // Walk props's own properties via the hidden-class chain. For each
    // enumerable property, read its value via property_get so accessor
    // getters fire (with `this = props_v`) — required by ECMA-262
    // §20.1.2.3.1 step 5.b.
    let cls = cls_root;
    while cls != NULL && cls.parent != NULL {
        let name = cls.transition_name;
        let slot = cls.transition_slot;
        // Skip internal (`__zjs_*`) and Symbol-shim (`@@*`) hidden keys.
        let is_internal = string_is_hidden_key(name);
        if !is_internal {
            // Spec: only ENUMERABLE own props of `props` become
            // descriptor entries. The hidden-class walker visits all
            // slots regardless; skip non-enumerable ones here. Critical
            // for `Object.create({}, Math)` — Math has non-enumerable
            // `PI` (a number) which would otherwise trip the
            // "descriptor must be an object" throw.
            let owner_obj: ZjsObject* = NULL;
            if zjs_is_object(cls_owner_v) != 0 {
                owner_obj = zjs_as_object(cls_owner_v);
            } else if zjs_is_array(cls_owner_v) != 0 {
                let oa = zjs_as_array(cls_owner_v);
                if oa.props != NULL { owner_obj = oa.props; }
            } else if zjs_is_function(cls_owner_v) != 0 {
                let fp = zjs_cell_as_ptr(cls_owner_v);
                let f: Function* = NULL;
                raw { f = (Function*)fp; }
                if f.props != NULL { owner_obj = f.props; }
            } else if zjs_is_host_function(cls_owner_v) != 0 {
                let hf = zjs_as_host_function(cls_owner_v);
                if hf.props != NULL { owner_obj = hf.props; }
            } else if zjs_is_regexp(cls_owner_v) != 0 {
                let r = zjs_as_regexp(cls_owner_v);
                if r.props != NULL { owner_obj = r.props; }
            } else if zjs_is_date(cls_owner_v) != 0 {
                let dd = zjs_as_date(cls_owner_v);
                if dd.props != NULL { owner_obj = dd.props; }
            } else if zjs_is_map(cls_owner_v) != 0 {
                let mm = zjs_as_map(cls_owner_v);
                if mm.props != NULL { owner_obj = mm.props; }
            } else if zjs_is_set(cls_owner_v) != 0 {
                let ss = zjs_as_set(cls_owner_v);
                if ss.props != NULL { owner_obj = ss.props; }
            } else if zjs_is_symbol(cls_owner_v) != 0 {
                let symv = zjs_as_symbol(cls_owner_v);
                if symv.props != NULL { owner_obj = symv.props; }
            }
            let prop_attrs: u8 = if owner_obj != NULL { object_get_attrs(owner_obj, slot) } else { PROP_DEFAULT };
            if (prop_attrs & PROP_ENUMERABLE) == 0 {
                cls = cls.parent;
                continue;
            }
            let key_v = zjs_cell_from_ptr((void*)name);
            // Read through cls_owner so accessor getters fire on the
            // right receiver. For an array-backed props bag this is
            // the array's expando object (a real ZjsObject).
            let desc_value = property_get(ctx, cls_owner_v, key_v);
            // ECMA-262 §19.1.2.3.1 step 5.c: ToPropertyDescriptor on a
            // non-object descriptor throws TypeError. Most commonly this
            // surfaces when the props bag holds an accessor-only entry
            // (set without get) — reading it returns undefined.
            let dv_objlike: bool =
                   zjs_is_object(desc_value) != 0
                || zjs_is_array(desc_value) != 0
                || zjs_is_function(desc_value) != 0
                || zjs_is_host_function(desc_value) != 0
                || zjs_is_regexp(desc_value) != 0;
            if !dv_objlike {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Property descriptor must be an object", 37);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return zjs_undefined();
            }
            let dp_args: ZjsValue[3];
            dp_args[0] = obj_v;
            dp_args[1] = key_v;
            dp_args[2] = desc_value;
            let dp_p: ZjsValue* = NULL;
            raw { dp_p = &dp_args[0]; }
            host_object_define_property(ctx, dp_p, 3);
            // define_property may have thrown a descriptor-validation
            // TypeError — bubble it out so the caller's invocation
            // epilogue picks it up.
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        cls = cls.parent;
    }
    return obj_v;
}

// Object.getOwnPropertyDescriptor(obj, key) — Phase 3.9a.
// Returns a fresh descriptor object. MVP: all properties report as
// data descriptors with all three attribute bits set to true.
fn host_object_get_own_property_descriptor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    let obj_v = args[0];
    let key_v = args[1];
    if zjs_is_string(key_v) == 0 { key_v = zjs_to_string(ctx, key_v); }

    // Array fast path: numeric indices and "length".
    if zjs_is_array(obj_v) != 0 {
        let arr = zjs_as_array(obj_v);
        let key_str_a = zjs_as_string(key_v);
        // "length"?
        if key_str_a.length == 6 {
            let kd = key_str_a.data;
            let is_len: int = 0;
            raw { is_len = (memcmp(kd, "length", 6) == 0) ? 1 : 0; }
            if is_len != 0 {
                let r_v = ctx_new_object(ctx);
                let r = zjs_as_object(r_v);
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"value", 5), zjs_int32((i32)arr.length));
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(1));
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(0));
                object_set(ctx, r, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(0));
                return r_v;
            }
        }
        let idx = zjs_to_array_index(key_v);
        if idx >= 0 && (u32)idx < arr.length {
            // Spec: getOwnPropertyDescriptor on a hole returns undefined.
            if zjs_is_deleted(arr.elements[(u32)idx]) != 0 {
                return zjs_undefined();
            }
            let r_v = ctx_new_object(ctx);
            let r = zjs_as_object(r_v);
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"value", 5), arr.elements[(u32)idx]);
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(1));
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(1));
            object_set(ctx, r, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(1));
            return r_v;
        }
        // Named (non-index) own property — arrays store these in arr.props,
        // same as plain objects. defineProperty / getOwnPropertyNames already
        // route through it; mirror that here so the descriptor is visible.
        if arr.props != NULL {
            let o2 = arr.props;
            let katom = ctx_intern_atom(ctx, key_str_a.data, key_str_a.length);
            let slot2 = class_find_slot(o2.cls, katom);
            if slot2 >= 0 {
                let raw2 = o2.slots[(u32)slot2];
                let dv = ctx_new_object(ctx);
                ctx_push_temp_root(ctx, dv);
                defer ctx_pop_temp_root(ctx);
                let dobj = zjs_as_object(dv);
                let at2 = object_get_attrs(o2, (u32)slot2);
                if zjs_is_accessor(raw2) != 0 {
                    let acc = zjs_as_accessor(raw2);
                    object_set(ctx, dobj, ctx_intern_atom(ctx, (char*)"get", 3), acc.get);
                    object_set(ctx, dobj, ctx_intern_atom(ctx, (char*)"set", 3), acc.set);
                } else {
                    object_set(ctx, dobj, ctx_intern_atom(ctx, (char*)"value", 5), raw2);
                    object_set(ctx, dobj, ctx_intern_atom(ctx, (char*)"writable", 8),
                               zjs_bool(if (at2 & PROP_WRITABLE) != 0 { 1 } else { 0 }));
                }
                object_set(ctx, dobj, ctx_intern_atom(ctx, (char*)"enumerable", 10),
                           zjs_bool(if (at2 & PROP_ENUMERABLE) != 0 { 1 } else { 0 }));
                object_set(ctx, dobj, ctx_intern_atom(ctx, (char*)"configurable", 12),
                           zjs_bool(if (at2 & PROP_CONFIGURABLE) != 0 { 1 } else { 0 }));
                return dv;
            }
        }
        return zjs_undefined();
    }

    // Function / closure / host-fn special "prototype" / "name" /
    // "length" keys first.
    let key_str_pre = zjs_as_string(key_v);
    let is_prototype_k: int = 0;
    let is_name_k: int = 0;
    let is_length_k: int = 0;
    let ksd = key_str_pre.data;
    let ksn = key_str_pre.length;
    raw {
        is_prototype_k = (ksn == 9 && memcmp(ksd, "prototype", 9) == 0) ? 1 : 0;
        is_name_k      = (ksn == 4 && memcmp(ksd, "name",      4) == 0) ? 1 : 0;
        is_length_k    = (ksn == 6 && memcmp(ksd, "length",    6) == 0) ? 1 : 0;
    }
    if is_prototype_k != 0
       && (zjs_is_function(obj_v) != 0 || zjs_is_closure(obj_v) != 0 || zjs_is_host_function(obj_v) != 0) {
        let proto_v = property_get(ctx, obj_v, key_v);
        if zjs_is_undefined(proto_v) != 0 { return zjs_undefined(); }
        let r_v = ctx_new_object(ctx);
        let r = zjs_as_object(r_v);
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"value", 5), proto_v);
        // For class constructors the prototype is non-writable +
        // non-configurable; regular function ctors are writable +
        // configurable. is_class_constructor only exists on Function*,
        // not closures / host fns — treat host fns as regular ctors.
        let is_class: bool = false;
        if zjs_is_function(obj_v) != 0 {
            let fp = zjs_cell_as_ptr(obj_v);
            let ff: Function* = NULL;
            raw { ff = (Function*)fp; }
            is_class = ff.is_class_constructor;
        }
        let writable: int = if is_class { 0 } else { 1 };
        let configurable: int = if is_class { 0 } else { 1 };
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(writable));
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(0));
        object_set(ctx, r, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(configurable));
        return r_v;
    }

    // Function / closure / host-fn intrinsics: synthesize spec-mandated
    // descriptors for `name` / `length` BEFORE routing to .props. These
    // intrinsics are computed lazily and never installed as real slots,
    // so the slot lookup below would fall through to undefined.
    //
    //   .name  : { value, writable: false, enumerable: false, configurable: true }
    //   .length: { value, writable: false, enumerable: false, configurable: true }
    if (is_name_k != 0 || is_length_k != 0)
       && (zjs_is_function(obj_v) != 0 || zjs_is_closure(obj_v) != 0 || zjs_is_host_function(obj_v) != 0) {
        let v = property_get(ctx, obj_v, key_v);
        // If the function exposed a per-instance override via .props
        // (e.g. fn.name = "...", Function.prototype.bind), property_get
        // returns that; we still wrap it in the spec descriptor shape.
        if zjs_is_undefined(v) == 0 {
            let r2_v = ctx_new_object(ctx);
            let r2 = zjs_as_object(r2_v);
            object_set(ctx, r2, ctx_intern_atom(ctx, (char*)"value", 5), v);
            object_set(ctx, r2, ctx_intern_atom(ctx, (char*)"writable", 8), zjs_bool(0));
            object_set(ctx, r2, ctx_intern_atom(ctx, (char*)"enumerable", 10), zjs_bool(0));
            object_set(ctx, r2, ctx_intern_atom(ctx, (char*)"configurable", 12), zjs_bool(1));
            return r2_v;
        }
    }

    // Function / closure / host-fn receivers: route to their .props
    // expando (where static methods, F.x = ..., etc. live).
    let o: ZjsObject* = NULL;
    if zjs_is_object(obj_v) != 0 {
        o = zjs_as_object(obj_v);
    } else if zjs_is_function(obj_v) != 0 {
        let fp = zjs_cell_as_ptr(obj_v);
        let ff: Function* = NULL;
        raw { ff = (Function*)fp; }
        if ff.props != NULL { o = ff.props; }
    } else if zjs_is_closure(obj_v) != 0 {
        let cl = zjs_as_closure(obj_v);
        let fp2 = cl.function;
        let ff2: Function* = NULL;
        raw { ff2 = (Function*)fp2; }
        if ff2.props != NULL { o = ff2.props; }
    } else if zjs_is_host_function(obj_v) != 0 {
        let hf = zjs_as_host_function(obj_v);
        if hf.props != NULL { o = hf.props; }
    }
    if o == NULL { return zjs_undefined(); }
    let key_str = zjs_as_string(key_v);
    let key_atom = ctx_intern_atom(ctx, key_str.data, key_str.length);

    let slot = class_find_slot(o.cls, key_atom);
    if slot < 0 { return zjs_undefined(); }
    let raw_v = o.slots[(u32)slot];

    let result_v = ctx_new_object(ctx);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_object(result_v);
    let pattrs = object_get_attrs(o, (u32)slot);
    if zjs_is_accessor(raw_v) != 0 {
        let acc = zjs_as_accessor(raw_v);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"get", 3), acc.get);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"set", 3), acc.set);
    } else {
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"value", 5), raw_v);
        object_set(ctx, result, ctx_intern_atom(ctx, (char*)"writable", 8),
                   zjs_bool(if (pattrs & PROP_WRITABLE) != 0 { 1 } else { 0 }));
    }
    object_set(ctx, result, ctx_intern_atom(ctx, (char*)"enumerable", 10),
               zjs_bool(if (pattrs & PROP_ENUMERABLE) != 0 { 1 } else { 0 }));
    object_set(ctx, result, ctx_intern_atom(ctx, (char*)"configurable", 12),
               zjs_bool(if (pattrs & PROP_CONFIGURABLE) != 0 { 1 } else { 0 }));
    return result_v;
}

// Object.getOwnPropertyDescriptors(obj) — returns an object mapping
// every own string key to its full descriptor. (Symbol keys are a
// documented follow-up — they need symbol-keyed result-object stores.)
fn host_object_get_own_property_descriptors(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let result_v = ctx_new_object(ctx);
    if argc < 1 { return result_v; }
    let names_v = host_object_get_own_property_names(ctx, args, argc);
    if ctx.pending_throw_active { return zjs_undefined(); }
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_object(result_v);
    if zjs_is_array(names_v) == 0 { return result_v; }
    let names = zjs_as_array(names_v);
    let n = names.length;
    let i: u32 = 0;
    while i < n {
        let key = names.elements[i];
        if zjs_is_deleted(key) == 0 && zjs_is_string(key) != 0 {
            let da: ZjsValue[2]; da[0] = args[0]; da[1] = key;
            let dap: ZjsValue* = NULL; raw { dap = &da[0]; }
            let desc = host_object_get_own_property_descriptor(ctx, dap, 2);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_is_undefined(desc) == 0 {
                let ks = zjs_as_string(key);
                object_set(ctx, result, ctx_intern_atom(ctx, ks.data, ks.length), desc);
            }
        }
        i = i + 1;
    }
    return result_v;
}

// Object.getPrototypeOf(obj) — Phase 3.6.
// ECMA-262 ToObject for Object.{keys, values, entries, getPrototypeOf,
// Enumeration filter — covers two unrelated cases of "internal" keys
// that should not surface to user code via Object.keys / for-in /
// JSON.stringify / Object.getOwnPropertyNames:
//
//   1. `__zjs_*` — engine-internal slots (wrapper primitives, env
//      chain link, toString tag) that we store on user objects.
//
//   2. `@@*`     — the canonical-key shim for Symbol-keyed properties.
//      Since we don't have a separate symbol-key bucket yet, Symbol
//      property access stores under `@@sym:N` (user-created) or
//      `@@iterator` etc. (well-known). The spec requires Object.keys
//      / getOwnPropertyNames / for-in to enumerate only string keys —
//      Symbol keys come back via Object.getOwnPropertySymbols. The
//      filter catches both shapes.
//
// Edge case (accepted, documented): if user code writes `obj["@@x"] =
// 1` with a literal "@@x" string key, that property will also be
// filtered from enumeration. The risk is small in practice (no test262
// test we've found relies on this) and removing the false positive
// requires a separate Symbol-keyed property bucket, which is a much
// larger structural change.
fn string_is_hidden_key(s: ZjsString*) -> bool {
    if s == NULL { return false; }
    let d = s.data;
    let n = s.length;
    if n >= 6 {
        let m: int = 1;
        raw { m = memcmp(d, "__zjs_", 6); }
        if m == 0 { return true; }
    }
    if n >= 2 {
        let m: int = 1;
        raw { m = memcmp(d, "@@", 2); }
        if m == 0 { return true; }
    }
    return false;
}

// getOwnPropertyNames, ...}: null and undefined throw TypeError per ES2015+.
// Returns true if the argument is suitable; false (with a pending throw
// armed) if the caller must bail.
fn require_object_keys_arg(ctx: ZjsContext*, v: ZjsValue) -> bool {
    if zjs_is_null(v) != 0 || zjs_is_undefined(v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return false;
    }
    return true;
}

// Object.is(a, b) — ECMA-262 §7.2.10 SameValue. Like ===, except
// NaN equals NaN, and +0 doesn't equal -0.
fn host_object_is(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let a = if argc >= 1 { args[0] } else { zjs_undefined() };
    let b = if argc >= 2 { args[1] } else { zjs_undefined() };
    // NaN handling first — Object.is(NaN, NaN) is true.
    if zjs_is_number(a) != 0 && zjs_is_number(b) != 0 {
        let da = zjs_to_double(a);
        let db = zjs_to_double(b);
        let na_nan: int = 0;
        let nb_nan: int = 0;
        raw {
            na_nan = isnan(da) ? 1 : 0;
            nb_nan = isnan(db) ? 1 : 0;
        }
        if na_nan != 0 && nb_nan != 0 { return zjs_bool(1); }
        if na_nan != 0 || nb_nan != 0 { return zjs_bool(0); }
        // ±0 distinction: 1/+0 = +Infinity, 1/-0 = -Infinity.
        if da == 0.0 && db == 0.0 {
            let sa: int = 0;
            let sb: int = 0;
            raw {
                sa = signbit(da) ? 1 : 0;
                sb = signbit(db) ? 1 : 0;
            }
            return zjs_bool(if sa == sb { 1 } else { 0 });
        }
        return zjs_bool(if da == db { 1 } else { 0 });
    }
    return zjs_bool(zjs_strict_eq(a, b));
}

// Object.setPrototypeOf(O, proto) — Phase 3.9.
// Spec: O must be coercible; proto must be Object or null. Sets
// O.[[Prototype]] and returns O. Primitives are returned unchanged
// after the type-validation step (no wrapper materialization needed).
fn host_object_set_prototype_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let obj_v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_undefined(obj_v) != 0 || zjs_is_null(obj_v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object.setPrototypeOf called on null or undefined", 49);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let proto_v = if argc >= 2 { args[1] } else { zjs_undefined() };
    // ECMA-262 §20.1.2.21: Type(proto) must be Object or Null. Type()
    // includes callables (functions are objects). chalk uses
    //   var proto = Object.defineProperties(() => {}, {...});
    //   Object.setPrototypeOf(builder, proto);
    // We accept callable protos by extracting the callable's `.props`
    // expando bag and treating IT as the proto. The bag holds every
    // descriptor the user installed via defineProperty / defineProperties,
    // so chain-walk + accessor invocation work normally; getters fire
    // with `this = original receiver` per spec. Limitation:
    // Object.getPrototypeOf returns the .props ZjsObject, not the
    // callable, so `getPrototypeOf(builder) === origProto` is false.
    // No real-world npm package observed checks for that identity (#290).
    let proto_ok: bool = zjs_is_null(proto_v) != 0
                      || zjs_is_object(proto_v) != 0
                      || zjs_is_closure(proto_v) != 0
                      || zjs_is_function(proto_v) != 0
                      || zjs_is_host_function(proto_v) != 0;
    if !proto_ok {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object prototype may only be an Object or null", 47);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    // For callable protos: route to the bag where defineProperty
    // actually stores descriptors. Closures route to function.props
    // (resolve_define_receiver), not cl.props — so we extract the
    // SAME bag here so chain-walks find what defineProperty wrote.
    if zjs_is_closure(proto_v) != 0 {
        let cl_p = zjs_as_closure(proto_v);
        let fp_p = cl_p.function;
        let f_p: Function* = NULL;
        raw { f_p = (Function*)fp_p; }
        if f_p.props == NULL {
            let pv = ctx_new_object(ctx);
            f_p.props = zjs_as_object(pv);
        }
        proto_v = zjs_cell_from_ptr((void*)f_p.props);
    } else if zjs_is_function(proto_v) != 0 {
        let fp_p = zjs_cell_as_ptr(proto_v);
        let f_p: Function* = NULL;
        raw { f_p = (Function*)fp_p; }
        if f_p.props == NULL {
            let pv = ctx_new_object(ctx);
            f_p.props = zjs_as_object(pv);
        }
        proto_v = zjs_cell_from_ptr((void*)f_p.props);
    } else if zjs_is_host_function(proto_v) != 0 {
        let hf_p = zjs_as_host_function(proto_v);
        if hf_p.props == NULL {
            let pv = ctx_new_object(ctx);
            hf_p.props = zjs_as_object(pv);
        }
        proto_v = zjs_cell_from_ptr((void*)hf_p.props);
    }
    if zjs_is_object(obj_v) != 0 {
        let o = zjs_as_object(obj_v);
        if zjs_is_null(proto_v) != 0 {
            o.proto = NULL;
        } else {
            let new_proto = zjs_as_object(proto_v);
            // Cycle check (ECMA-262 OrdinarySetPrototypeOf step 8). Walk
            // the proposed proto chain; if we reach `o`, the assignment
            // would create a cycle — throw TypeError. Skip when the new
            // proto IS the existing one (identity assign is a no-op).
            if new_proto != o.proto {
                let p = new_proto;
                while p != NULL {
                    if p == o {
                        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                                    (char*)"cyclic __proto__ value", 22);
                        ctx.pending_throw_active = true;
                        ctx.pending_throw_value = err;
                        return zjs_undefined();
                    }
                    p = p.proto;
                }
            }
            o.proto = new_proto;
        }
    } else if zjs_is_closure(obj_v) != 0 {
        // Closure path (#287). chalk and many class-polyfill bundles do
        //   const f = (...) => ...;
        //   Object.setPrototypeOf(f, SomeClass.prototype);
        // and then expect `f.method` to resolve via SomeClass.prototype.
        // Store the override on the closure itself; property_get for
        // TAG_CLOSURE walks it before falling back to Function.prototype.
        let cl = zjs_as_closure(obj_v);
        if zjs_is_null(proto_v) != 0 {
            cl.proto_override = NULL;
        } else {
            cl.proto_override = zjs_as_object(proto_v);
        }
    } else if zjs_is_function(obj_v) != 0 {
        // Bare Function path — same idea as closure but on Function*.
        // Hits when the user setPrototypeOf's a non-capturing arrow /
        // function decl (which our compiler leaves as a bare Function
        // because there's no env to capture). See Function.proto_override
        // comment in bytecode.zc for the per-source-location caveat.
        let fp = zjs_cell_as_ptr(obj_v);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        if zjs_is_null(proto_v) != 0 {
            f.proto_override = NULL;
        } else {
            f.proto_override = zjs_as_object(proto_v);
        }
    } else if zjs_is_host_function(obj_v) != 0 {
        // Host-fn path. proto_override here is a ZjsValue (the field
        // pre-dated this commit, exposed via getPrototypeOf only).
        // setPrototypeOf now writes it; property_get consults it too.
        let hf = zjs_as_host_function(obj_v);
        if zjs_is_null(proto_v) != 0 {
            hf.proto_override = zjs_undefined();
        } else {
            hf.proto_override = proto_v;
        }
    } else if zjs_is_uint8_array(obj_v) != 0 {
        // Uint8Array per-instance proto (node:buffer's Buffer.prototype).
        // property_get's TAG_UINT8_ARRAY path walks this chain.
        let u = zjs_as_uint8_array(obj_v);
        if zjs_is_null(proto_v) != 0 {
            u.proto = NULL;
        } else {
            u.proto = zjs_as_object(proto_v);
        }
    }
    // Other non-object/non-callable receivers: spec returns the original
    // value unchanged.
    return obj_v;
}

fn host_object_get_prototype_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if !require_object_keys_arg(ctx, v) { return zjs_undefined(); }
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        if o.proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)o.proto);
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        if a.proto != NULL { return zjs_cell_from_ptr((void*)a.proto); }
        if ctx.array_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.array_proto);
    }
    if zjs_is_uint8_array(v) != 0 {
        let u = zjs_as_uint8_array(v);
        if u.proto != NULL { return zjs_cell_from_ptr((void*)u.proto); }
        if ctx.uint8_array_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.uint8_array_proto);
    }
    if zjs_is_host_function(v) != 0 {
        // Host fns may carry an explicit override (used for error
        // subclasses whose [[Prototype]] is Error itself). Otherwise
        // every callable's [[Prototype]] is Function.prototype.
        let hf = zjs_as_host_function(v);
        if zjs_is_undefined(hf.proto_override) == 0 { return hf.proto_override; }
        if ctx.function_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.function_proto);
    }
    if zjs_is_function(v) != 0 {
        let fp = zjs_cell_as_ptr(v);
        let ff: Function* = NULL;
        raw { ff = (Function*)fp; }
        // Per-instance setPrototypeOf override wins.
        if ff.proto_override != NULL {
            return zjs_cell_from_ptr((void*)ff.proto_override);
        }
        if zjs_is_undefined(ff.parent_ctor) == 0 { return ff.parent_ctor; }
        if ctx.function_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.function_proto);
    }
    if zjs_is_closure(v) != 0 {
        let cl = zjs_as_closure(v);
        // Per-instance override (Object.setPrototypeOf) takes precedence.
        if cl.proto_override != NULL {
            return zjs_cell_from_ptr((void*)cl.proto_override);
        }
        let fp2 = cl.function;
        let ff2: Function* = NULL;
        raw { ff2 = (Function*)fp2; }
        if zjs_is_undefined(ff2.parent_ctor) == 0 { return ff2.parent_ctor; }
        if ctx.function_proto == NULL { return zjs_null(); }
        return zjs_cell_from_ptr((void*)ctx.function_proto);
    }
    if zjs_is_regexp(v) != 0 {
        let rr = zjs_as_regexp(v);
        if rr.proto != NULL { return zjs_cell_from_ptr((void*)rr.proto); }
        if ctx.regexp_proto != NULL { return zjs_cell_from_ptr((void*)ctx.regexp_proto); }
    }
    if zjs_is_map(v) != 0 {
        let mm = zjs_as_map(v);
        if mm.proto != NULL { return zjs_cell_from_ptr((void*)mm.proto); }
        if ctx.map_proto != NULL { return zjs_cell_from_ptr((void*)ctx.map_proto); }
    }
    if zjs_is_set(v) != 0 {
        let ss = zjs_as_set(v);
        if ss.proto != NULL { return zjs_cell_from_ptr((void*)ss.proto); }
        if ctx.set_proto != NULL { return zjs_cell_from_ptr((void*)ctx.set_proto); }
    }
    if zjs_is_date(v) != 0 {
        let dd = zjs_as_date(v);
        if dd.proto != NULL { return zjs_cell_from_ptr((void*)dd.proto); }
        if ctx.date_proto != NULL { return zjs_cell_from_ptr((void*)ctx.date_proto); }
    }
    if zjs_is_promise(v) != 0 {
        let pp = zjs_as_promise(v);
        if pp.proto != NULL { return zjs_cell_from_ptr((void*)pp.proto); }
        if ctx.promise_ctor_proto != NULL {
            return zjs_cell_from_ptr((void*)ctx.promise_ctor_proto);
        }
    }
    if zjs_is_generator(v) != 0 && ctx.generator_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.generator_proto);
    }
    if zjs_is_uint8_array(v) != 0 && ctx.uint8_array_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.uint8_array_proto);
    }
    if zjs_is_typed_array(v) != 0 {
        let p = ta_proto_for(ctx, zjs_as_typed_array(v).kind);
        if p != NULL { return zjs_cell_from_ptr((void*)p); }
    }
    if zjs_is_array_buffer(v) != 0 && ctx.array_buffer_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.array_buffer_proto);
    }
    if zjs_is_data_view(v) != 0 && ctx.data_view_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.data_view_proto);
    }
    if zjs_is_websocket(v) != 0 && ctx.websocket_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.websocket_proto);
    }
    // Primitives — ToObject(v) would wrap, then get its prototype.
    // Surface the matching prototype chain root directly; that's the
    // observable result.
    if zjs_is_string(v) != 0 && ctx.string_proto != NULL {
        return zjs_cell_from_ptr((void*)ctx.string_proto);
    }
    if zjs_is_bool(v) != 0 {
        let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
        if bool_g >= 0 {
            let bv = ctx.globals[bool_g].value;
            if zjs_is_host_function(bv) != 0 {
                let proto = zjs_as_host_function(bv).prototype;
                if proto != NULL { return zjs_cell_from_ptr((void*)proto); }
            }
        }
        return zjs_null();
    }
    if zjs_is_number(v) != 0 {
        let num_g = ctx_find_global(ctx, (char*)"Number", 6);
        if num_g >= 0 {
            let nv = ctx.globals[num_g].value;
            if zjs_is_host_function(nv) != 0 {
                let proto = zjs_as_host_function(nv).prototype;
                if proto != NULL { return zjs_cell_from_ptr((void*)proto); }
            }
        }
        return zjs_null();
    }
    return zjs_null();
}

// Object.keys(obj) — array of own enumerable string keys, in insertion
// order. We walk the hidden-class chain bottom-up; each transition_name
// goes at transition_slot. Non-object inputs return an empty array.
// Object.getOwnPropertyNames(o) — like Object.keys but spec-wise it
// also lists non-enumerable own properties. We don't track
// enumerability, so the two agree on plain objects + arrays. For a
// host function we additionally surface `length` and `name` to match
// the "built-in property order" tests (length before name).
fn host_object_get_own_property_names(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_new_array(ctx, 0); }
    let v = args[0];
    if zjs_is_host_function(v) != 0 {
        let hf = zjs_as_host_function(v);
        let out_v = ctx_new_array(ctx, 4);
        let out_arr = zjs_as_array(out_v);
        let cursor: u32 = 0;
        // Spec-mandated order: "length" then "name".
        out_arr.elements[cursor] = ctx_intern_string(ctx, (char*)"length", 6);
        cursor = cursor + 1;
        out_arr.elements[cursor] = ctx_intern_string(ctx, (char*)"name", 4);
        cursor = cursor + 1;
        if hf.props != NULL {
            let cls = hf.props.cls;
            while cls != NULL && cls.parent != NULL {
                let nm = cls.transition_name;
                let slot = cls.transition_slot;
                let is_internal = string_is_hidden_key(nm);
                if !is_internal && zjs_is_deleted(hf.props.slots[slot]) == 0 {
                    if cursor >= out_arr.cap {
                        // Grow if more than the default 4-prep got
                        // exceeded — array_set handles growth for us.
                        array_set(out_arr, cursor, zjs_cell_from_ptr((void*)nm));
                    } else {
                        out_arr.elements[cursor] = zjs_cell_from_ptr((void*)nm);
                    }
                    cursor = cursor + 1;
                }
                cls = cls.parent;
            }
        }
        out_arr.length = cursor;
        return out_v;
    }
    // Other receivers — same collector but WITHOUT the enumerable
    // filter (getOwnPropertyNames lists non-enumerable own keys too).
    return object_keys_impl(ctx, args, argc, false);
}

// Linear sweep of both cell pools (young + old) for a live ZjsSymbol
// whose `.key` is the given interned atom. Returns NULL if no live
// Symbol exists for that key (e.g. the Symbol was GC'd because no
// roots referenced it — its property-key string survives on the host
// object, but the Symbol cell itself doesn't).
fn lookup_symbol_by_key(ctx: ZjsContext*, key: ZjsString*) -> ZjsSymbol* {
    let ci: u32 = 0;
    while ci < ctx.young_count {
        let p = ctx.young_cells[ci];
        if p != NULL {
            let h: CellHeader* = NULL;
            raw { h = (CellHeader*)p; }
            if h.type_tag == TAG_SYMBOL {
                let sm: ZjsSymbol* = NULL;
                raw { sm = (ZjsSymbol*)p; }
                if sm.key == key { return sm; }
            }
        }
        ci = ci + 1;
    }
    let ci2: u32 = 0;
    while ci2 < ctx.cell_count {
        let p = ctx.cells[ci2];
        if p != NULL {
            let h: CellHeader* = NULL;
            raw { h = (CellHeader*)p; }
            if h.type_tag == TAG_SYMBOL {
                let sm: ZjsSymbol* = NULL;
                raw { sm = (ZjsSymbol*)p; }
                if sm.key == key { return sm; }
            }
        }
        ci2 = ci2 + 1;
    }
    return NULL;
}

// Object.getOwnPropertySymbols(o) — returns an Array of the Symbol-
// valued own keys of `o`. The current Symbol shim stores Symbol-keyed
// properties under their canonical key string (`@@sym:N` for user-
// created, `@@iterator` etc. for well-known); this function maps those
// strings back to ZjsSymbol* cells by sweeping ctx.cells for live
// Symbols and matching their `.key` field.
//
// Known limitation: a Symbol that's only referenced via a property
// key (the user dropped their local binding) can be GC'd between the
// set and the read, since the canonical-key string doesn't pin the
// Symbol cell. For tests where the Symbol is still live in scope this
// works; for "create Symbol, set on obj, drop binding, getOwnPropertySymbols"
// the Symbol is gone. Fixing this requires a Symbol-keyed property
// bucket on objects (separate from the string-keyed slots) — bigger
// refactor.
fn host_object_get_own_property_symbols(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let arg0 = if argc >= 1 { args[0] } else { zjs_undefined() };
    if !require_object_keys_arg(ctx, arg0) { return zjs_undefined(); }
    // Build atom-string → ZjsSymbol* lookup from live cells. Cheap
    // enough; this function isn't a hot path.
    let v = args[0];
    let receiver_obj: ZjsObject* = NULL;
    if zjs_is_object(v) != 0 {
        receiver_obj = zjs_as_object(v);
    } else if zjs_is_array(v) != 0 {
        // Array .props expando is where any non-index keys live.
        let a = zjs_as_array(v);
        receiver_obj = a.props;
    } else if zjs_is_function(v) != 0 {
        let fp = zjs_cell_as_ptr(v);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        receiver_obj = f.props;
    } else if zjs_is_closure(v) != 0 {
        let cl = zjs_as_closure(v);
        let fp2 = cl.function;
        let f2: Function* = NULL;
        raw { f2 = (Function*)fp2; }
        receiver_obj = f2.props;
    } else if zjs_is_host_function(v) != 0 {
        receiver_obj = zjs_as_host_function(v).props;
    } else if zjs_is_regexp(v) != 0 {
        receiver_obj = zjs_as_regexp(v).props;
    }
    if receiver_obj == NULL || receiver_obj.cls == NULL {
        return ctx_new_array(ctx, 0);
    }
    let o = receiver_obj;
    let out_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out_arr = zjs_as_array(out_v);
    // Walk hidden-class chain in slot order. For each @@-prefixed key
    // that's still present + enumerable-or-not (spec returns all Symbol
    // keys, not just enumerable), look up the corresponding Symbol.
    let cap = o.cls.prop_count;
    // Heap scratch (sized to cap) so objects with > 64 properties don't
    // get their Symbol-keyed slots silently dropped. defer dealloc.
    let limit: u32 = cap;
    let scratch = alloc_n<ZjsString*>((usize)limit);
    defer dealloc(scratch);
    let i: u32 = 0;
    while i < limit { scratch[i] = NULL; i = i + 1; }
    let cls = o.cls;
    while cls != NULL && cls.parent != NULL {
        let slot = cls.transition_slot;
        if slot < limit && zjs_is_deleted(o.slots[slot]) == 0 {
            scratch[slot] = cls.transition_name;
        }
        cls = cls.parent;
    }
    let j: u32 = 0;
    while j < limit {
        let nm = scratch[j];
        if nm != NULL && nm.length >= 2 {
            // Match `@@` prefix — both user-created (`@@sym:N`) and
            // well-known (`@@iterator`, etc.) live there.
            let is_sym_key: bool = false;
            let nd = nm.data;
            raw { is_sym_key = (memcmp(nd, "@@", 2) == 0) ? true : false; }
            if is_sym_key {
                // Linear sweep of both cell pools for a ZjsSymbol with
                // matching key. Generational scaffolding splits storage
                // between young_cells (nursery) and cells (old gen); we
                // walk both. O(cells) per slot; acceptable for a non-hot
                // API. Replace with a back-reference on ZjsString or a
                // side-table when this becomes a measurable cost.
                let found = lookup_symbol_by_key(ctx, nm);
                if found != NULL {
                    array_set(out_arr, out_arr.length, zjs_cell_from_ptr((void*)found));
                }
            }
        }
        j = j + 1;
    }
    return out_v;
}

// Object.assign(target, ...sources) — copy own enumerable string-
// keyed properties from each source to target. Symbol keys are also
// copied (the codebase's Object.keys already includes them in the
// generic-object path). null/undefined sources are silently skipped;
// a null/undefined target throws TypeError per spec.
fn host_object_assign(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 || zjs_is_undefined(args[0]) != 0 || zjs_is_null(args[0]) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert undefined or null to object", 43);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let target = ctx_to_object(ctx, args[0]);
    if ctx.pending_throw_active { return zjs_undefined(); }
    ctx_push_temp_root(ctx, target);
    defer ctx_pop_temp_root(ctx);
    let s: u32 = 1;
    while s < argc {
        let src = args[s];
        if zjs_is_undefined(src) == 0 && zjs_is_null(src) == 0 {
            // Lean on Object.keys to enumerate own enumerable keys
            // (incl. integer-string keys + Symbol keys per the
            // existing implementation). The "from" arg shape mirrors
            // Object.keys's signature: argv[0] is the receiver.
            let keys_args: ZjsValue[1];
            keys_args[0] = src;
            let ka_ptr: ZjsValue* = NULL;
            raw { ka_ptr = &keys_args[0]; }
            let keys_v = host_object_keys(ctx, ka_ptr, 1);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_is_array(keys_v) != 0 {
                let karr = zjs_as_array(keys_v);
                let i: u32 = 0;
                while i < karr.length {
                    let k = karr.elements[i];
                    let v = property_get(ctx, src, k);
                    if ctx.pending_throw_active { return zjs_undefined(); }
                    property_set(ctx, target, k, v);
                    if ctx.pending_throw_active { return zjs_undefined(); }
                    i = i + 1;
                }
            }
        }
        s = s + 1;
    }
    return target;
}

fn host_object_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return object_keys_impl(ctx, args, argc, true);
}

// Shared collector for Object.keys (enum_only = true) and
// Object.getOwnPropertyNames (enum_only = false, which also emits
// non-enumerable own string keys + an array's "length").
fn object_keys_impl(ctx: ZjsContext*, args: ZjsValue*, argc: u32, enum_only: bool) -> ZjsValue {
    let arg0 = if argc >= 1 { args[0] } else { zjs_undefined() };
    if !require_object_keys_arg(ctx, arg0) { return zjs_undefined(); }
    // Array path: enumerate present indices as string keys. Holes and
    // out-of-length slots stay invisible. Length itself is
    // non-enumerable so it's omitted.
    if zjs_is_array(args[0]) != 0 {
        let a = zjs_as_array(args[0]);
        let n = a.length;
        let out_v = ctx_new_array(ctx, n);
        ctx_push_temp_root(ctx, out_v);
        defer ctx_pop_temp_root(ctx);
        let out_arr = zjs_as_array(out_v);
        let out_idx: u32 = 0;
        let i: u32 = 0;
        let dense_limit: u32 = if a.cap < n { a.cap } else { n };
        while i < dense_limit {
            // Skip holes — Object.keys reports only present indices.
            if zjs_is_deleted(a.elements[i]) == 0 {
                let buf: char[16];
                let blen: int = 0;
                raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)i); }
                let bp: char* = NULL; raw { bp = &buf[0]; }
                array_set(out_arr, out_idx, ctx_intern_string(ctx, bp, (u32)blen));
                out_idx = out_idx + 1;
            }
            i = i + 1;
        }
        // Indexed entries past arr.cap live on the .props expando — pick
        // them up by walking the expando's hidden class.
        if a.props != NULL {
            let cls = a.props.cls;
            while cls != NULL && cls.parent != NULL {
                let nm = cls.transition_name;
                let slot = cls.transition_slot;
                if slot < a.props.cls.prop_count {
                    let raw_v = a.props.slots[slot];
                    let attrs = object_get_attrs(a.props, slot);
                    if zjs_is_deleted(raw_v) == 0 && (enum_only == false || (attrs & PROP_ENUMERABLE) != 0) {
                        // Skip internal (`__zjs_*`) and Symbol-shim (`@@*`)
                        // hidden keys. Numeric keys past arr.cap AND string
                        // keys (e.g. a defineProperty'd named prop on an
                        // array) both land here.
                        let is_internal = string_is_hidden_key(nm);
                        if !is_internal {
                            array_set(out_arr, out_idx, zjs_cell_from_ptr((void*)nm));
                            out_idx = out_idx + 1;
                        }
                    }
                }
                cls = cls.parent;
            }
        }
        // getOwnPropertyNames includes the non-enumerable "length".
        if enum_only == false {
            array_set(out_arr, out_idx, ctx_intern_string(ctx, (char*)"length", 6));
            out_idx = out_idx + 1;
        }
        out_arr.length = out_idx;
        return out_v;
    }
    // Function / host-function / regex receivers: walk the .props
    // expando if any. Closure shares the underlying Function*.
    let receiver_obj: ZjsObject* = NULL;
    if zjs_is_function(args[0]) != 0 {
        let fp = zjs_cell_as_ptr(args[0]);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        receiver_obj = f.props;
    } else if zjs_is_closure(args[0]) != 0 {
        let cl = zjs_as_closure(args[0]);
        let fp2 = cl.function;
        let f2: Function* = NULL;
        raw { f2 = (Function*)fp2; }
        // Class ctors share statics on Function*.props; generic
        // closures expose their per-instance bag.
        if f2.is_class_constructor {
            receiver_obj = f2.props;
        } else if cl.props != NULL {
            receiver_obj = cl.props;
        } else {
            receiver_obj = f2.props;
        }
    } else if zjs_is_host_function(args[0]) != 0 {
        let hf = zjs_as_host_function(args[0]);
        receiver_obj = hf.props;
    } else if zjs_is_regexp(args[0]) != 0 {
        let r = zjs_as_regexp(args[0]);
        receiver_obj = r.props;
    } else if zjs_is_object(args[0]) != 0 {
        receiver_obj = zjs_as_object(args[0]);
    } else {
        return ctx_new_array(ctx, 0);
    }
    if receiver_obj == NULL {
        return ctx_new_array(ctx, 0);
    }
    let o = receiver_obj;
    let cap = o.cls.prop_count;
    let arr_v = ctx_new_array(ctx, cap);
    let arr = zjs_as_array(arr_v);
    // Build a name-by-slot scratch first, then compact down to only
    // the present (non-deleted) ones in insertion order. Heap-allocated
    // so we scale with the object — lodash's `_` function has 270+
    // own-named methods; a static 64-cap would silently drop them.
    let limit: u32 = cap;
    let scratch = alloc_n<ZjsString*>((usize)limit);
    defer dealloc(scratch);
    let init_i: u32 = 0;
    while init_i < limit { scratch[init_i] = NULL; init_i = init_i + 1; }
    let cls = o.cls;
    while cls != NULL && cls.parent != NULL {
        let slot = cls.transition_slot;
        // Object.keys reports own enumerable string-keyed properties:
        // skip deleted slots AND skip non-enumerable slots.
        if slot < limit && zjs_is_deleted(o.slots[slot]) == 0 {
            let a = object_get_attrs(o, slot);
            if enum_only == false || (a & PROP_ENUMERABLE) != 0 {
                scratch[slot] = cls.transition_name;
            }
        }
        cls = cls.parent;
    }
    // ECMA-262 OrdinaryOwnPropertyKeys: array-index keys first, in
    // ascending numeric order, then string keys in insertion order.
    // Two-pass: separate integer-index keys, sort, emit; then string
    // keys in slot (= creation) order.
    let int_keys = alloc_n<u32>((usize)limit);
    let int_names = alloc_n<ZjsString*>((usize)limit);
    defer dealloc(int_keys);
    defer dealloc(int_names);
    let int_count: u32 = 0;
    let i: u32 = 0;
    while i < limit {
        let nm = scratch[i];
        if nm != NULL {
            let is_internal = string_is_hidden_key(nm);
            if !is_internal {
                let idx_v: i64 = string_as_array_index(nm);
                if idx_v >= 0 && int_count < limit {
                    int_keys[int_count] = (u32)idx_v;
                    int_names[int_count] = nm;
                    int_count = int_count + 1;
                    scratch[i] = NULL; // consumed
                }
            }
        }
        i = i + 1;
    }
    // Insertion sort int_keys by numeric value.
    let si: u32 = 1;
    while si < int_count {
        let kv = int_keys[si];
        let nv = int_names[si];
        let sj: i32 = (i32)si - 1;
        while sj >= 0 && int_keys[(u32)sj] > kv {
            int_keys[(u32)(sj + 1)] = int_keys[(u32)sj];
            int_names[(u32)(sj + 1)] = int_names[(u32)sj];
            sj = sj - 1;
        }
        int_keys[(u32)(sj + 1)] = kv;
        int_names[(u32)(sj + 1)] = nv;
        si = si + 1;
    }
    let out: u32 = 0;
    let ii: u32 = 0;
    while ii < int_count {
        arr.elements[out] = zjs_cell_from_ptr((void*)int_names[ii]);
        out = out + 1;
        ii = ii + 1;
    }
    let j: u32 = 0;
    while j < limit {
        if scratch[j] != NULL {
            let nm2 = scratch[j];
            if !string_is_hidden_key(nm2) {
                arr.elements[out] = zjs_cell_from_ptr((void*)nm2);
                out = out + 1;
            }
        }
        j = j + 1;
    }
    arr.length = out;
    return arr_v;
}

// Object.values(o) — ECMA-262 §20.1.2.22.
// Object.entries(o) — ECMA-262 §20.1.2.5.
// Both reuse host_object_keys to get the enumerable own keys in
// canonical order, then walk that array reading each value (and for
// entries, packaging [key, value]). Lets chalk, lodash, debug, and a
// thousand other npm packages that iterate via Object.entries work.
fn object_values_or_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32, want_entries: bool) -> ZjsValue {
    let arg0 = if argc >= 1 { args[0] } else { zjs_undefined() };
    let keys_v = host_object_keys(ctx, args, argc);
    if zjs_is_array(keys_v) == 0 { return ctx_new_array(ctx, 0); }
    let keys = zjs_as_array(keys_v);
    let n = keys.length;
    ctx_push_temp_root(ctx, keys_v);
    defer ctx_pop_temp_root(ctx);
    let out_v = ctx_new_array(ctx, n);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < n {
        let key_v = keys.elements[i];
        let val_v = property_get(ctx, arg0, key_v);
        if want_entries {
            let pair_v = ctx_new_array(ctx, 2);
            let pair = zjs_as_array(pair_v);
            array_set(pair, 0, key_v);
            array_set(pair, 1, val_v);
            pair.length = 2;
            array_set(out, i, pair_v);
        } else {
            array_set(out, i, val_v);
        }
        i = i + 1;
    }
    out.length = n;
    return out_v;
}

fn host_object_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return object_values_or_entries(ctx, args, argc, false);
}

fn host_object_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return object_values_or_entries(ctx, args, argc, true);
}

// Object.fromEntries(iterable) — inverse of Object.entries. Accepts
// any iterable of [key, value] pairs (Map.entries(), an array of
// arrays, etc.). MVP: only handles Array of pair-Arrays; the full
// iterable protocol path lands when GetIterator surfaces a real need.
fn host_object_from_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let out_v = ctx_new_object(ctx);
    let out = zjs_as_object(out_v);
    if argc < 1 { return out_v; }
    let src = args[0];
    if zjs_is_array(src) == 0 {
        // TODO: full iterable protocol. Map.prototype.entries() returns
        // an iterator that needs to be walked via next() — the
        // GetIterator/IteratorStep path. For now plain Maps fall through
        // here as the array case (Array.from-style coerce) which works
        // because Map carries an entries-array fast path internally.
        if zjs_is_map(src) != 0 {
            let m = zjs_as_map(src);
            let i: u32 = 0;
            while i < m.count {
                let e = m.entries + i;
                if !e.deleted {
                    let k = e.key;
                    let v = e.value;
                    if zjs_is_string(k) != 0 {
                        object_set(ctx, out, zjs_as_string(k), v);
                    } else {
                        let ks_v = zjs_to_string(ctx, k);
                        if zjs_is_string(ks_v) != 0 { object_set(ctx, out, zjs_as_string(ks_v), v); }
                    }
                }
                i = i + 1;
            }
        }
        return out_v;
    }
    let a = zjs_as_array(src);
    let n = a.length;
    let i: u32 = 0;
    while i < n {
        let pair = a.elements[i];
        if zjs_is_array(pair) != 0 {
            let p = zjs_as_array(pair);
            if p.length >= 2 {
                let k = p.elements[0];
                let v = p.elements[1];
                if zjs_is_string(k) != 0 {
                    object_set(ctx, out, zjs_as_string(k), v);
                } else {
                    let ks = zjs_to_string(ctx, k);
                    if zjs_is_string(ks) != 0 { object_set(ctx, out, zjs_as_string(ks), v); }
                }
            }
        }
        i = i + 1;
    }
    return out_v;
}

// Returns the numeric value if `name` is a CanonicalNumericIndexString
// for a non-negative integer in u32 range, else -1.
fn string_as_array_index(name: ZjsString*) -> i64 {
    if name == NULL || name.length == 0 { return -1; }
    let d = name.data;
    let n = name.length;
    if n > 10 { return -1; }  // 10 digits = max u32 (4294967295)
    // Leading-zero disallowed except for the singleton "0".
    let first: u8 = (u8)d[0];
    if first == (u8)'0' {
        if n == 1 { return 0; }
        return -1;
    }
    if first < (u8)'1' || first > (u8)'9' { return -1; }
    let v: u64 = 0;
    let i: u32 = 0;
    while i < n {
        let c = (u8)d[i];
        if c < (u8)'0' || c > (u8)'9' { return -1; }
        v = v * 10 + (u64)(c - (u8)'0');
        i = i + 1;
    }
    if v > 4294967295 { return -1; }
    return (i64)v;
}

// --- Array.prototype helpers ---------------------------------------

// Coerce `.length` to a u32. Most array-like objects have an integer
// length; ECMA-262 has more rigorous coercion rules we approximate.
fn read_length_u32(ctx: ZjsContext*, this_val: ZjsValue) -> u32 {
    if zjs_is_array(this_val) != 0 {
        return zjs_as_array(this_val).length;
    }
    // Any non-array cell value (objects + function / regex / host fn /
    // wrapper primitives) routes through property_get on the receiver,
    // which handles each shape's prototype chain.
    if zjs_is_undefined(this_val) == 0 && zjs_is_null(this_val) == 0 {
        // Use property_get so the proto chain is walked AND accessor
        // properties (Object.defineProperty getters) fire correctly.
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        let key_v = zjs_cell_from_ptr((void*)len_atom);
        let v = property_get(ctx, this_val, key_v);
        if zjs_is_int32(v) != 0 {
            let n = zjs_as_int32(v);
            if n > 0 { return (u32)n; }
            return 0;
        }
        if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        // ECMA-262 ToLength: run ToPrimitive("number") first so the
        // proto-chain valueOf fires (test262 cases use a length object
        // with inherited valueOf returning the actual length).
        if zjs_is_object(v) != 0 || zjs_is_array(v) != 0 {
            let prim = zjs_to_primitive(ctx, v, false);
            if ctx.pending_throw_active { return 0; }
            let d = zjs_to_double(prim);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        if zjs_is_string(v) != 0 {
            // ToNumber on the string.
            let d = zjs_to_double(v);
            let is_finite: int = 0;
            raw { is_finite = isfinite(d) ? 1 : 0; }
            if is_finite == 0 { return 0; }
            if d <= 0.0 { return 0; }
            return (u32)d;
        }
        if zjs_is_bool(v) != 0 {
            if zjs_as_bool(v) != 0 { return 1; }
            return 0;
        }
        // ECMA-262 ToLength → ToNumber: a Symbol or BigInt length throws
        // a TypeError (and that abrupt must propagate out of the array
        // method, per the return-abrupt-from-this-length-as-symbol tests).
        if zjs_is_symbol(v) != 0 {
            raise_symbol_to_number(ctx);
            return 0;
        }
        if zjs_is_bigint(v) != 0 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Cannot convert a BigInt to a number", 35);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return 0;
        }
        return 0;
    }
    return 0;
}

// Set obj[index] = value where obj is a plain object (generic-this).
fn obj_set_indexed(ctx: ZjsContext*, o: ZjsObject*, index: u32, value: ZjsValue) -> void {
    let key_buf: char[16];
    let key_len: int = 0;
    raw {
        key_len = snprintf(&key_buf[0], 16, "%u", (unsigned)index);
    }
    let kp: char* = NULL;
    raw { kp = &key_buf[0]; }
    let key_atom = ctx_intern_atom(ctx, kp, (u32)key_len);
    object_set(ctx, o, key_atom, value);
}

fn obj_get_indexed(ctx: ZjsContext*, o: ZjsObject*, index: u32) -> ZjsValue {
    // Delegate to property_get so accessors fire and proto-chain
    // semantics (including string/array prototype intercepts) are
    // honored. The key is the integer index reformatted as a string;
    // property_get internally uses zjs_to_array_index for the fast
    // path on real arrays.
    let key_v = zjs_int32((i32)index);
    let obj_v = zjs_cell_from_ptr((void*)o);
    return property_get(ctx, obj_v, key_v);
}

// Spec HasProperty for an indexed key. Walks own props (arrays with
// or without expando bag, plain objects via the class chain) and
// then up the prototype chain. Used by Array.prototype iteration
// methods (map / forEach / filter / find / etc.) to honor the spec's
// "hole = skip callback" rule for BOTH real arrays AND generic
// array-like receivers (Array.prototype.map.call(obj, ...)).
fn value_has_index(ctx: ZjsContext*, v: ZjsValue, idx: u32) -> bool {
    // Real-array fast path: dense slot present means own. If the array
    // also has an expando bag with a stringified-index property, that
    // counts too (defineProperty(arr, "3", ...) lands there).
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        if array_has_index(a, idx) != 0 { return true; }
        // Fall through to the proto walk below — Array.prototype may
        // carry an inherited indexed property (test262 pokes these).
    }
    // Generic-object walk: stringify the index once, then look up by
    // atom in the own class and each ancestor proto's class.
    let buf: char[16];
    let n: int = 0;
    raw { n = snprintf(&buf[0], 16, "%u", (unsigned)idx); }
    let kp: char* = NULL;
    raw { kp = &buf[0]; }
    let key_atom = ctx_intern_atom(ctx, kp, (u32)n);
    if zjs_is_object(v) != 0 {
        let cur: ZjsObject* = zjs_as_object(v);
        while cur != NULL {
            let slot = class_find_slot(cur.cls, key_atom);
            if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 { return true; }
            cur = cur.proto;
        }
        // Wrapped primitive (String boxed via ToObject): indexed access
        // goes through property_get's wrapper path even though the
        // class chain has no per-char slots. For string wrappers a
        // valid in-range index counts as own per spec — exactly the
        // semantics `Array.prototype.forEach.call("abc", cb)` relies on.
        let o2 = zjs_as_object(v);
        let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        let wslot = class_find_slot(o2.cls, wkey);
        if wslot >= 0 {
            let wv = o2.slots[(u32)wslot];
            if zjs_is_string(wv) != 0 {
                let s = zjs_as_string(wv);
                if idx < s.length { return true; }
            }
        }
        return false;
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        // Expando bag: defineProperty(arr, "3", ...) goes here too.
        if a.props != NULL {
            let slot = class_find_slot(a.props.cls, key_atom);
            if slot >= 0 && zjs_is_deleted(a.props.slots[(u32)slot]) == 0 { return true; }
        }
        // Walk up the array's proto chain — Array.prototype is a
        // plain ZjsObject in our model, so the same class walk works.
        if ctx.array_proto != NULL {
            let cur: ZjsObject* = ctx.array_proto;
            while cur != NULL {
                let slot = class_find_slot(cur.cls, key_atom);
                if slot >= 0 && zjs_is_deleted(cur.slots[(u32)slot]) == 0 { return true; }
                cur = cur.proto;
            }
        }
        return false;
    }
    // Function / closure / host-fn receivers — Array.prototype.* called
    // generically with `this` = function. Indexed property goes into
    // the function's .props expando.
    let pf: ZjsObject* = NULL;
    if zjs_is_function(v) != 0 {
        let fp = zjs_cell_as_ptr(v);
        let ff: Function* = NULL;
        raw { ff = (Function*)fp; }
        pf = ff.props;
    } else if zjs_is_closure(v) != 0 {
        let cl = zjs_as_closure(v);
        let fp2 = cl.function;
        let ff2: Function* = NULL;
        raw { ff2 = (Function*)fp2; }
        pf = ff2.props;
    } else if zjs_is_host_function(v) != 0 {
        let hf = zjs_as_host_function(v);
        pf = hf.props;
    }
    if pf != NULL {
        let slot = class_find_slot(pf.cls, key_atom);
        if slot >= 0 && zjs_is_deleted(pf.slots[(u32)slot]) == 0 { return true; }
    }
    return false;
}

// ECMA-262 RequireObjectCoercible step at the top of every Array
// prototype method: `Array.prototype.X.call(undefined or null)` must
// throw TypeError. Returns `true` on accept (caller continues normally);
// returns `false` on reject after wiring a pending throw — caller must
// `return zjs_undefined()` immediately.
fn require_array_coercible_this(ctx: ZjsContext*) -> bool {
    let this_val = ctx.host_this;
    if zjs_is_undefined(this_val) == 0 && zjs_is_null(this_val) == 0 { return true; }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"Array.prototype method called on null or undefined", 51);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return false;
}

// Spec's IsCallable check for the array-method callback argument. The
// no-callback / non-callable case throws TypeError per
// ECMA-262 §22.1.3.12 (forEach), §22.1.3.18 (map), and siblings.
// Returns true on success; on failure arms the JS-visible throw and
// the caller bails with zjs_undefined().
fn require_callback_callable(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> bool {
    let cb = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_function(cb) != 0 || zjs_is_closure(cb) != 0 || zjs_is_host_function(cb) != 0 {
        return true;
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                (char*)"Callback is not a function", 26);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = err;
    return false;
}

fn host_array_push(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let i: u32 = 0;
        while i < argc {
            array_set(arr, arr.length, args[i]);
            i = i + 1;
        }
        return zjs_int32((i32)arr.length);
    }
    // Generic-this: ToObject primitive receivers (push.call(true), etc.)
    if zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let len = read_length_u32(ctx, this_val);
        let i: u32 = 0;
        while i < argc {
            obj_set_indexed(ctx, o, len + i, args[i]);
            i = i + 1;
        }
        let new_len = len + argc;
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        object_set(ctx, o, len_atom, zjs_int32((i32)new_len));
        return zjs_int32((i32)new_len);
    }
    return zjs_undefined();
}

fn host_array_pop(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        if arr.length == 0 { return zjs_undefined(); }
        // Read through array_get so the hole sentinel coerces to
        // undefined; leave the popped slot as a hole.
        let last = array_get(arr, arr.length - 1);
        arr.elements[arr.length - 1] = zjs_deleted();
        arr.length = arr.length - 1;
        return last;
    }
    if zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let len = read_length_u32(ctx, this_val);
        let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
        if len == 0 {
            object_set(ctx, o, len_atom, zjs_int32(0));
            return zjs_undefined();
        }
        let last_idx = len - 1;
        let last_v = obj_get_indexed(ctx, o, last_idx);
        // Remove the property and update length.
        // (We don't have a proper delete — leave it as undefined.)
        obj_set_indexed(ctx, o, last_idx, zjs_undefined());
        object_set(ctx, o, len_atom, zjs_int32((i32)last_idx));
        return last_v;
    }
    return zjs_undefined();
}

fn host_array_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if argc == 0 { return zjs_int32(-1); }
    let needle = args[0];

    // ECMA-262 §22.1.3.14 step 2: `O = ToObject(this)`. For primitive
    // receivers (`indexOf.call("abc", "b")`, `.call(true, target)`,
    // numbers, etc.) wrap and dispatch through the generic-object path.
    // The wrapper's prototype chain carries the indexed properties
    // (Boolean.prototype[1] = ... patterns) and the length getter.
    if zjs_is_array(this_val) == 0 && zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }

    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let len = arr.length;
        let from: u32 = 0;
        if argc >= 2 {
            let fi_v = args[1];
            // ECMA-262: fromIndex via ToInteger → ToPrimitive("number").
            // Object args must fire valueOf / toString in spec order.
            if zjs_is_object(fi_v) != 0 || zjs_is_array(fi_v) != 0 {
                fi_v = zjs_to_primitive(ctx, fi_v, false);
                if ctx.pending_throw_active { return zjs_int32(-1); }
            }
            let fi = zjs_to_double(fi_v);
            raw { if (isnan(fi)) fi = 0; }
            if fi < 0.0 {
                let nfi = (f64)len + fi;
                if nfi < 0.0 { from = 0; } else { from = (u32)nfi; }
            } else if fi >= (f64)len {
                return zjs_int32(-1);
            } else {
                from = (u32)fi;
            }
        }
        let i: u32 = from;
        while i < len {
            // Spec checks HasProperty(O, k) before the strict-equality
            // step — holes never compare equal to anything, including
            // undefined. Skip them. When arr.props exists, route
            // through property_get so installed accessors fire.
            let slot: ZjsValue = zjs_undefined();
            let present: bool = false;
            if arr.props != NULL {
                let v_pg = property_get(ctx, this_val, zjs_int32((i32)i));
                if ctx.pending_throw_active { return zjs_int32(-1); }
                slot = v_pg;
                present = true;
            } else {
                // Defensive: sparse arrays from defineProperty can have
                // length > cap; treat those slots as absent.
                if i < arr.cap {
                    let raw_v = arr.elements[i];
                    if zjs_is_deleted(raw_v) == 0 {
                        slot = raw_v;
                        present = true;
                    }
                }
            }
            if present {
                if zjs_strict_eq(slot, needle) != 0 {
                    return zjs_int32((i32)i);
                }
            }
            i = i + 1;
        }
        return zjs_int32(-1);
    }
    // Generic-this for everything else (objects, functions, closures,
    // host fns, regex). Reads via property_get so the right prototype
    // chain and accessor handling fire for each receiver kind.
    let len_atom = ctx_intern_atom(ctx, (char*)"length", 6);
    let lkv = property_get(ctx, this_val, zjs_cell_from_ptr((void*)len_atom));
    if zjs_is_object(lkv) != 0 || zjs_is_array(lkv) != 0 {
        lkv = zjs_to_primitive(ctx, lkv, false);
        if ctx.pending_throw_active { return zjs_int32(-1); }
    }
    let len_d = zjs_to_double(lkv);
    raw {
        if (!isfinite(len_d) || len_d <= 0.0) len_d = 0.0;
        else len_d = floor(len_d);   // ToLength truncates to integer
    }
    let from_d: f64 = 0.0;
    if argc >= 2 {
        let pos = args[1];
        if zjs_is_object(pos) != 0 || zjs_is_array(pos) != 0 {
            pos = zjs_to_primitive(ctx, pos, false);
            if ctx.pending_throw_active { return zjs_int32(-1); }
        }
        from_d = zjs_to_double(pos);
        raw { if (isnan(from_d)) from_d = 0; }
        if from_d < 0.0 {
            from_d = len_d + from_d;
            if from_d < 0.0 { from_d = 0.0; }
        }
    }
    if from_d >= len_d { return zjs_int32(-1); }
    let i = from_d;
    while i < len_d {
        let idx_u: u32 = (u32)i;
        // Spec: HasProperty gates the strict-eq. Without this guard,
        // missing indices read as `undefined` via property_get and
        // spuriously match `indexOf.call({length:5}, undefined)`.
        if value_has_index(ctx, this_val, idx_u) {
            let v = property_get(ctx, this_val, zjs_int32((i32)idx_u));
            if ctx.pending_throw_active { return zjs_int32(-1); }
            if zjs_strict_eq(v, needle) != 0 {
                if i <= 2147483647.0 { return zjs_int32((i32)i); }
                return zjs_double(i);
            }
        }
        i = i + 1.0;
    }
    return zjs_int32(-1);
}

// --- String.prototype helpers ---------------------------------------

// Apply ECMA-262 `O = RequireObjectCoercible(this); S = ToString(O)`
// to the calling-host's `this`. Returns undefined and arms a
// JS-visible TypeError throw via pending_throw_active if `this` is
// null/undefined; returns a string-typed ZjsValue otherwise. Callers
// bail on undefined and the interpreter's post-host-call epilogue
// observes pending_throw_active and unwinds.
fn coerce_string_this(ctx: ZjsContext*) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_undefined(this_val) != 0 || zjs_is_null(this_val) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    if zjs_is_string(this_val) != 0 { return this_val; }
    return zjs_to_string(ctx, this_val);
}

fn host_string_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_int32(-1); }
    if argc == 0 { return zjs_int32(-1); }
    let needle_v = args[0];
    if zjs_is_string(needle_v) == 0 { needle_v = zjs_to_string(ctx, needle_v); }
    if ctx.pending_throw_active { return zjs_int32(-1); }
    let hay = zjs_as_string(str_v);
    if zjs_is_string(needle_v) == 0 { return zjs_int32(-1); }
    let nee = zjs_as_string(needle_v);
    let hay_d = hay.data;
    let hay_n = hay.length;
    let nee_d = nee.data;
    let nee_n = nee.length;
    // Optional fromIndex (clamped to [0, hay_n]). ToNumber via
    // ToPrimitive so an object with valueOf is honored — tests
    // pass `{valueOf: ()=>{throw ...}}` here.
    let from: u32 = 0;
    if argc >= 2 {
        let pos_v = args[1];
        if zjs_is_object(pos_v) != 0 || zjs_is_array(pos_v) != 0 {
            pos_v = zjs_to_primitive(ctx, pos_v, false);
            if ctx.pending_throw_active { return zjs_int32(-1); }
        }
        let fi = zjs_to_double(pos_v);
        raw { if (isnan(fi)) fi = 0; }
        if fi < 0.0 { fi = 0.0; }
        if fi > (f64)hay_n { fi = (f64)hay_n; }
        from = (u32)fi;
    }
    if nee.length == 0 { return zjs_int32((i32)from); }
    if hay_n < nee_n { return zjs_int32(-1); }
    let result: i32 = -1;
    raw {
        for (uint32_t i = from; i + nee_n <= hay_n; i++) {
            if (memcmp(hay_d + i, nee_d, nee_n) == 0) {
                result = (int32_t)i;
                break;
            }
        }
    }
    return zjs_int32(result);
}

// Clamp + normalize a slice endpoint (negatives count from end).
// Runs ToNumber via ToPrimitive("number") so objects with custom
// valueOf throw or coerce as the spec requires.
fn slice_clamp(ctx: ZjsContext*, v: ZjsValue, len: u32, default_val: i32) -> i32 {
    if zjs_is_undefined(v) != 0 { return default_val; }
    if zjs_is_object(v) != 0 || zjs_is_array(v) != 0 {
        v = zjs_to_primitive(ctx, v, false);
        if ctx.pending_throw_active { return 0; }
    }
    let n = (i32)zjs_to_double(v);
    if n < 0 { n = (i32)len + n; }
    if n < 0 { n = 0; }
    if n > (i32)len { n = (i32)len; }
    return n;
}

fn host_string_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let start = if argc >= 1 { slice_clamp(ctx, args[0], s.length, 0) }
                else         { 0 };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let end_default: i32 = (i32)s.length;
    let end = if argc >= 2 { slice_clamp(ctx, args[1], s.length, end_default) }
              else         { end_default };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    if end < start { end = start; }
    let outlen = (u32)(end - start);
    let buf = alloc_n<char>((usize)(outlen + 1));
    if outlen > 0 {
        let src_at: char* = NULL;
        let src_off = (u32)start;
        raw { src_at = &s->data[src_off]; }
        mem_copy<char>(buf, src_at, (usize)outlen);
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

// String.prototype.substring(start, end): like slice but clamps
// negative args to 0 and swaps start/end if start > end.
// String.prototype.substr(start, length) — ECMA-262 Annex B §B.2.2.1.
// Legacy, kept for npm-compat (moment + ~hundreds of older packages).
// Negative `start` is offset from end; missing or NaN `length` means
// "rest of string". Result clamped to [0, len].
fn host_string_substr(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let slen: i32 = (i32)s.length;
    let start_d: f64 = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let len_d: f64 = if argc >= 2 { zjs_to_double(args[1]) } else { (f64)slen; };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let is_nan_s: int = 0; raw { is_nan_s = isnan(start_d) ? 1 : 0; }
    let is_nan_l: int = 0; raw { is_nan_l = isnan(len_d)   ? 1 : 0; }
    if is_nan_s != 0 { start_d = 0.0; }
    if is_nan_l != 0 { len_d   = 0.0; }
    // Negative start wraps from the end (Annex B step 6).
    if start_d < 0.0 {
        start_d = (f64)slen + start_d;
        if start_d < 0.0 { start_d = 0.0; }
    }
    if start_d > (f64)slen { start_d = (f64)slen; }
    if len_d < 0.0 { len_d = 0.0; }
    let start: i32 = (i32)start_d;
    let end_d:   f64 = start_d + len_d;
    if end_d > (f64)slen { end_d = (f64)slen; }
    let end:   i32 = (i32)end_d;
    if end < start { end = start; }
    let outlen = (u32)(end - start);
    let buf = alloc_n<char>((usize)(outlen + 1));
    if outlen > 0 {
        let src_at: char* = NULL;
        let src_off = (u32)start;
        raw { src_at = &s->data[src_off]; }
        mem_copy<char>(buf, src_at, (usize)outlen);
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

fn host_string_substring(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let slen: i32 = (i32)s.length;
    let start_d: f64 = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let end_d: f64 = if argc >= 2 { zjs_to_double(args[1]) } else { (f64)slen };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let is_nan_s: int = 0; raw { is_nan_s = isnan(start_d) ? 1 : 0; }
    let is_nan_e: int = 0; raw { is_nan_e = isnan(end_d)   ? 1 : 0; }
    if is_nan_s != 0 { start_d = 0.0; }
    if is_nan_e != 0 { end_d   = 0.0; }
    if start_d < 0.0 { start_d = 0.0; }
    if end_d   < 0.0 { end_d   = 0.0; }
    if start_d > (f64)slen { start_d = (f64)slen; }
    if end_d   > (f64)slen { end_d   = (f64)slen; }
    let start: i32 = (i32)start_d;
    let end:   i32 = (i32)end_d;
    if start > end { let t = start; start = end; end = t; }
    let outlen = (u32)(end - start);
    let buf = alloc_n<char>((usize)(outlen + 1));
    if outlen > 0 {
        let src_at: char* = NULL;
        let src_off = (u32)start;
        raw { src_at = &s->data[src_off]; }
        mem_copy<char>(buf, src_at, (usize)outlen);
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

// String.prototype.startsWith(searchString, position = 0)
fn host_string_starts_with(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_bool(0); }
    let s = zjs_as_string(str_v);
    if argc == 0 { return zjs_bool(0); }
    let needle = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    if ctx.pending_throw_active { return zjs_bool(0); }
    let ns = zjs_as_string(needle);
    let pos: i32 = 0;
    if argc >= 2 { pos = (i32)zjs_to_double(args[1]); }
    if pos < 0 { pos = 0; }
    if pos > (i32)s.length { return zjs_bool(ns.length == 0); }
    if pos + (i32)ns.length > (i32)s.length { return zjs_bool(0); }
    let sd = s.data; let nd = ns.data; let off = (u32)pos; let nl = ns.length;
    let eq: int = 0;
    raw { eq = (memcmp(sd + off, nd, nl) == 0) ? 1 : 0; }
    return zjs_bool(eq);
}

// String.prototype.endsWith(searchString, endPosition = length)
fn host_string_ends_with(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_bool(0); }
    let s = zjs_as_string(str_v);
    if argc == 0 { return zjs_bool(0); }
    let needle = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    if ctx.pending_throw_active { return zjs_bool(0); }
    let ns = zjs_as_string(needle);
    let endp: i32 = (i32)s.length;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        endp = (i32)zjs_to_double(args[1]);
        if endp < 0 { endp = 0; }
        if endp > (i32)s.length { endp = (i32)s.length; }
    }
    if (i32)ns.length > endp { return zjs_bool(ns.length == 0); }
    let from = endp - (i32)ns.length;
    let sd = s.data; let nd = ns.data; let off = (u32)from; let nl = ns.length;
    let eq: int = 0;
    raw { eq = (memcmp(sd + off, nd, nl) == 0) ? 1 : 0; }
    return zjs_bool(eq);
}

// String.prototype.includes(searchString, position = 0)
fn host_string_includes(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return zjs_bool(0); }
    if argc == 0 { return zjs_bool(0); }
    // Delegate to indexOf semantics (skipping the regex-as-search guard
    // since ECMA-262 forbids it; spec is detailed elsewhere).
    let need_args: ZjsValue[2];
    need_args[0] = args[0];
    if argc >= 2 { need_args[1] = args[1]; }
    let argp: ZjsValue* = NULL; raw { argp = &need_args[0]; }
    let r = host_string_index_of(ctx, argp, if argc >= 2 { 2 } else { 1 });
    if ctx.pending_throw_active { return zjs_bool(0); }
    return zjs_bool(zjs_is_int32(r) != 0 && zjs_as_int32(r) >= 0);
}

// String.prototype.trim — strip whitespace + line terminators per
// ECMA-262 §22.1.3.32.
fn host_string_trim(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let sd = s.data;
    let lo: u32 = 0;
    let hi: u32 = s.length;
    raw {
        while (lo < hi) {
            unsigned char c = (unsigned char)sd[lo];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f') lo++;
            else break;
        }
        while (hi > lo) {
            unsigned char c = (unsigned char)sd[hi - 1];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f') hi--;
            else break;
        }
    }
    let outlen = hi - lo;
    let buf = alloc_n<char>((usize)(outlen + 1));
    if outlen > 0 {
        let src_at: char* = NULL;
        let src_off = lo;
        raw { src_at = &s->data[src_off]; }
        mem_copy<char>(buf, src_at, (usize)outlen);
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

// String.prototype.repeat(count)
fn host_string_repeat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let n_d: f64 = if argc >= 1 { zjs_to_double(args[0]) } else { 0.0 };
    if ctx.pending_throw_active { return ctx_intern_string(ctx, (char*)"", 0); }
    let is_inf: int = 0; raw { is_inf = isinf(n_d) ? 1 : 0; }
    if n_d < 0.0 || is_inf != 0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"Invalid count value", 19);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let n: u32 = (u32)n_d;
    if n == 0 || s.length == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let outlen = s.length * n;
    let buf = alloc_n<char>((usize)(outlen + 1));
    let i: u32 = 0;
    while i < n {
        let dst: char* = NULL;
        let off = i * s.length;
        raw { dst = buf + off; }
        mem_copy<char>(dst, s.data, (usize)s.length);
        i = i + 1;
    }
    buf[outlen] = (char)0;
    return ctx_intern_string_take(ctx, buf, outlen);
}

fn host_string_char_at(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let idx: i32 = 0;
    if argc >= 1 { idx = (i32)zjs_to_double(args[0]); }
    if idx < 0 || (u32)idx >= s.length {
        return ctx_intern_string(ctx, (char*)"", 0);
    }
    let buf = alloc_n<char>((usize)2);
    buf[0] = s.data[(u32)idx];
    buf[1] = (char)0;
    return ctx_intern_string_take(ctx, buf, 1);
}

fn host_string_char_code_at(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 {
        let nan: f64 = 0.0; raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let s = zjs_as_string(str_v);
    let idx: i32 = 0;
    if argc >= 1 { idx = (i32)zjs_to_double(args[0]); }
    if idx < 0 || (u32)idx >= s.length {
        let nan: f64 = 0.0; raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let c = (u8)s.data[(u32)idx];
    return zjs_int32((i32)c);
}

fn host_string_to_upper_case(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let n = s.length;
    let buf = alloc_n<char>((usize)(n + 1));
    let i: u32 = 0;
    while i < n {
        let c = s.data[i];
        let cu = (u8)c;
        if cu >= 97 && cu <= 122 { buf[i] = (char)(cu - 32); }
        else                     { buf[i] = c; }
        i = i + 1;
    }
    buf[n] = (char)0;
    return ctx_intern_string_take(ctx, buf, n);
}

fn host_string_to_lower_case(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let str_v = coerce_string_this(ctx);
    if zjs_is_string(str_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let s = zjs_as_string(str_v);
    let n = s.length;
    let buf = alloc_n<char>((usize)(n + 1));
    let i: u32 = 0;
    while i < n {
        let c = s.data[i];
        let cu = (u8)c;
        if cu >= 65 && cu <= 90 { buf[i] = (char)(cu + 32); }
        else                    { buf[i] = c; }
        i = i + 1;
    }
    buf[n] = (char)0;
    return ctx_intern_string_take(ctx, buf, n);
}

fn host_string_concat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let result = this_val;
    // Defensive rooting: `result` is held across loop iterations of
    // zjs_string_concat (which allocates). `other` is also briefly
    // held across the concat call and rooted just for that span.
    ctx_push_temp_root(ctx, result);
    defer ctx_pop_temp_root(ctx);
    let i: u32 = 0;
    while i < argc {
        let other = args[i];
        if zjs_is_string(other) == 0 { other = zjs_to_string(ctx, other); }
        ctx_push_temp_root(ctx, other);
        result = zjs_string_concat(ctx, result, other);
        ctx_pop_temp_root(ctx);
        ctx_replace_top_temp_root(ctx, result);
        i = i + 1;
    }
    return result;
}

// String.prototype.replace(search, replacement). MVP support:
//   * search: string OR regex
//   * replacement: string (no `$1`/`$&` substitutions yet) OR function
// For regex search without the `g` flag, replaces only the first
// match. With `g`, replaces all non-overlapping matches.
// String.prototype.replace's $-substitution. ECMA-262 §22.1.3.18 step 11
// (GetSubstitution). Supports:
//   $$        → "$"
//   $&        → matched substring
//   $`        → portion before the match
//   $'        → portion after the match
//   $N        → capture group N (1..9). When N > total captures or
//               captures is NULL, the token is left literal (`$N`).
// Returns an allocated buffer with the expanded text; caller frees.
fn expand_replacement(rep_data: char*, rep_len: u32,
                      hay_d: char*, hay_n: u32,
                      mstart: u32, mend: u32,
                      cap_starts: i32*, cap_ends: i32*, n_caps: u32,
                      out_len_p: u32*) -> char* {
    // First pass: compute output length.
    let total: u32 = 0;
    let i: u32 = 0;
    while i < rep_len {
        if rep_data[i] == (char)'$' && i + 1 < rep_len {
            let c = rep_data[i + 1];
            if c == (char)'$'        { total = total + 1; i = i + 2; continue; }
            if c == (char)'&'        { total = total + (mend - mstart); i = i + 2; continue; }
            if c == (char)'`'        { total = total + mstart; i = i + 2; continue; }
            if c == (char)'\''       { total = total + (hay_n - mend); i = i + 2; continue; }
            let is_digit: bool = c >= (char)'0' && c <= (char)'9';
            if is_digit && cap_starts != NULL {
                let n: u32 = 0;
                raw { n = (uint32_t)(c - '0'); }
                if n >= 1 && n <= n_caps {
                    let cs = cap_starts[(u32)n];
                    let ce = cap_ends[(u32)n];
                    if cs >= 0 && ce >= cs { total = total + (u32)(ce - cs); }
                    i = i + 2; continue;
                }
            }
        }
        total = total + 1;
        i = i + 1;
    }
    // Second pass: write.
    let out = alloc_n<char>((usize)(total + 1));
    let off: u32 = 0;
    i = 0;
    while i < rep_len {
        if rep_data[i] == (char)'$' && i + 1 < rep_len {
            let c = rep_data[i + 1];
            if c == (char)'$' { out[off] = (char)'$'; off = off + 1; i = i + 2; continue; }
            if c == (char)'&' {
                if mend > mstart {
                    let src: char* = NULL;
                    raw { src = &hay_d[mstart]; }
                    mem_copy<char>(out + off, src, (usize)(mend - mstart));
                    off = off + (mend - mstart);
                }
                i = i + 2; continue;
            }
            if c == (char)'`' {
                if mstart > 0 {
                    mem_copy<char>(out + off, hay_d, (usize)mstart);
                    off = off + mstart;
                }
                i = i + 2; continue;
            }
            if c == (char)'\'' {
                let post = hay_n - mend;
                if post > 0 {
                    let src: char* = NULL;
                    raw { src = &hay_d[mend]; }
                    mem_copy<char>(out + off, src, (usize)post);
                    off = off + post;
                }
                i = i + 2; continue;
            }
            let is_digit: bool = c >= (char)'0' && c <= (char)'9';
            if is_digit && cap_starts != NULL {
                let n: u32 = 0;
                raw { n = (uint32_t)(c - '0'); }
                if n >= 1 && n <= n_caps {
                    let cs = cap_starts[(u32)n];
                    let ce = cap_ends[(u32)n];
                    if cs >= 0 && ce >= cs {
                        let src: char* = NULL;
                        raw { src = &hay_d[(uint32_t)cs]; }
                        mem_copy<char>(out + off, src, (usize)(ce - cs));
                        off = off + (u32)(ce - cs);
                    }
                    i = i + 2; continue;
                }
            }
        }
        out[off] = rep_data[i];
        off = off + 1;
        i = i + 1;
    }
    out[off] = (char)0;
    out_len_p[0] = off;
    return out;
}

fn host_string_replace(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return this_val; }
    let s = zjs_as_string(this_val);
    if argc < 2 { return this_val; }
    let search_v = args[0];
    let repl_v   = args[1];
    let repl_is_fn: bool = zjs_is_function(repl_v) != 0
        || zjs_is_closure(repl_v) != 0
        || zjs_is_host_function(repl_v) != 0;
    let repl_str_v: ZjsValue = if !repl_is_fn {
        if zjs_is_string(repl_v) != 0 { repl_v } else { zjs_to_string(ctx, repl_v) }
    } else { zjs_undefined() };

    // Builder: simple growing char buffer.
    let out_cap: u32 = s.length + 16;
    let out_buf = alloc_n<char>((usize)out_cap);
    let out_len: u32 = 0;

    let hay_d = s.data;
    let hay_n = s.length;

    if zjs_is_regexp(search_v) != 0 {
        let r = zjs_as_regexp(search_v);
        if !regex_ensure_compiled(r) {
            dealloc(out_buf);
            return this_val;
        }
        let is_global = (r.flags & REGEX_FLAG_GLOBAL) != 0;
        let preg = r.preg;
        // Capture-group count drives both the pmatch buffer size and
        // the callback's argument layout. ECMA-262 §22.1.3.18 says a
        // function replacer is called with (match, c1..cN, offset,
        // string) — passing only (match, offset, string) (the
        // pre-2026 layout) breaks lodash's stringToPath, which uses
        // `quote` / `subString` capture args to decide how to parse a
        // path token.
        let total_groups: u32 = 0;
        raw { total_groups = (uint32_t)lre_get_capture_count((const uint8_t*)preg); }
        if total_groups == 0 { total_groups = 1; }
        let pmatch_buf = alloc_n<ZRegMatch>((usize)total_groups);
        defer dealloc(pmatch_buf);
        let cursor: u32 = 0;
        let scan: u32 = 0;
        while scan <= hay_n {
            let rc: int = -1;
            raw {
                rc = lre_run(preg, hay_d, hay_n, scan, pmatch_buf, total_groups);
            }
            if rc != 0 { break; }
            // lre_run returns absolute byte offsets into hay_d.
            let mstart = (u32)pmatch_buf[0].rm_so;
            let mend   = (u32)pmatch_buf[0].rm_eo;
            // Append [cursor..mstart) verbatim.
            let pre_len = mstart - cursor;
            while out_len + pre_len + 64 > out_cap {
                let new_cap = out_cap * 2 + 64;
                out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
                out_cap = new_cap;
            }
            if pre_len > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(out_buf + out_len, src, (usize)pre_len);
                out_len = out_len + pre_len;
            }
            // Compute replacement (string or function call).
            let rep_data: char* = NULL;
            let rep_len: u32 = 0;
            let rep_str_holder: ZjsValue = zjs_undefined();
            if repl_is_fn {
                // Spec-shape: fn(match, c1, c2, ..., cN, offset, string).
                // arg count = total_groups + 2 (groups include the
                // match itself at index 0, so captures are 1..N-1).
                let cb_argc = total_groups + 2;
                let cb_args = alloc_n<ZjsValue>((usize)cb_argc);
                defer dealloc(cb_args);
                // Slot 0: the full match string.
                let mlen = mend - mstart;
                let mbuf = alloc_n<char>((usize)(mlen + 1));
                if mlen > 0 {
                    let msrc: char* = NULL;
                    raw { msrc = &hay_d[mstart]; }
                    mem_copy<char>(mbuf, msrc, (usize)mlen);
                }
                mbuf[mlen] = (char)0;
                cb_args[0] = ctx_intern_string_take(ctx, mbuf, mlen);
                // Slots 1..total_groups-1: per-capture substrings.
                // A capture that didn't participate (rm_so < 0) is
                // undefined per spec.
                let gi: u32 = 1;
                while gi < total_groups {
                    let gs = pmatch_buf[gi].rm_so;
                    let ge = pmatch_buf[gi].rm_eo;
                    if gs < 0 {
                        cb_args[gi] = zjs_undefined();
                    } else {
                        cb_args[gi] = ctx_intern_string(ctx, hay_d + (u32)gs, (u32)(ge - gs));
                    }
                    gi = gi + 1;
                }
                // Tail slots: offset, then the input string.
                cb_args[total_groups]     = zjs_int32((i32)mstart);
                cb_args[total_groups + 1] = this_val;
                let cb_argp: ZjsValue* = NULL;
                raw { cb_argp = cb_args; }
                let cb_r: ZjsValue = zjs_undefined();
                raw { cb_r = zjs_call_value_with_this(ctx, repl_v, zjs_undefined(), cb_argp, cb_argc); }
                if zjs_is_string(cb_r) == 0 { cb_r = zjs_to_string(ctx, cb_r); }
                rep_str_holder = cb_r;
                rep_data = zjs_as_string(cb_r).data;
                rep_len  = zjs_as_string(cb_r).length;
            } else {
                // String replacement — expand $&, $$, $`, $', $N tokens
                // per spec (ECMA-262 GetSubstitution). lodash's
                // `.replace(reRegExpChar, "\\$&")` to escape regex
                // metachars depends on this. semver's range parser
                // depends on $1/$2/$3 capture-group substitution.
                let tmpl_data = zjs_as_string(repl_str_v).data;
                let tmpl_len  = zjs_as_string(repl_str_v).length;
                // Build cap_starts/cap_ends from pmatch_buf so $N tokens
                // see real capture positions. pmatch_buf[0] is the full
                // match; captures are slots 1..total_groups-1, but
                // expand_replacement uses 1-based group indexing, so we
                // size n_caps = total_groups - 1 (excluding slot 0).
                let n_caps_x: u32 = if total_groups > 0 { total_groups - 1 } else { 0 };
                let cap_st = alloc_n<i32>((usize)(n_caps_x + 1));
                defer dealloc(cap_st);
                let cap_en = alloc_n<i32>((usize)(n_caps_x + 1));
                defer dealloc(cap_en);
                let ci: u32 = 1;
                while ci <= n_caps_x {
                    cap_st[ci] = (i32)pmatch_buf[ci].rm_so;
                    cap_en[ci] = (i32)pmatch_buf[ci].rm_eo;
                    ci = ci + 1;
                }
                let exp_len: u32 = 0;
                let exp_buf = expand_replacement(tmpl_data, tmpl_len,
                                                  hay_d, hay_n, mstart, mend,
                                                  cap_st, cap_en, n_caps_x,
                                                  &exp_len);
                rep_data = exp_buf;
                rep_len  = exp_len;
                // We'll dealloc exp_buf after the copy below.
                rep_str_holder = zjs_undefined();  // sentinel — caller owns exp_buf
                while out_len + rep_len + 64 > out_cap {
                    let new_cap = out_cap * 2 + 64;
                    out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
                    out_cap = new_cap;
                }
                if rep_len > 0 {
                    mem_copy<char>(out_buf + out_len, rep_data, (usize)rep_len);
                    out_len = out_len + rep_len;
                }
                dealloc(exp_buf);
                cursor = mend;
                scan = if mend > scan { mend } else { scan + 1 };
                if !is_global { break; }
                continue;
            }
            while out_len + rep_len + 64 > out_cap {
                let new_cap = out_cap * 2 + 64;
                out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
                out_cap = new_cap;
            }
            if rep_len > 0 {
                mem_copy<char>(out_buf + out_len, rep_data, (usize)rep_len);
                out_len = out_len + rep_len;
            }
            cursor = mend;
            scan = if mend > scan { mend } else { scan + 1 };
            if !is_global { break; }
        }
        // Trailing remainder.
        let tail_len = hay_n - cursor;
        while out_len + tail_len + 1 > out_cap {
            let new_cap = out_cap * 2 + 64;
            out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
            out_cap = new_cap;
        }
        if tail_len > 0 {
            let src: char* = NULL;
            raw { src = &hay_d[cursor]; }
            mem_copy<char>(out_buf + out_len, src, (usize)tail_len);
            out_len = out_len + tail_len;
        }
        out_buf[out_len] = (char)0;
        return ctx_intern_string_take(ctx, out_buf, out_len);
    }

    // String search: replace first occurrence only.
    let search_str_v = if zjs_is_string(search_v) != 0 { search_v } else { zjs_to_string(ctx, search_v) };
    let nee = zjs_as_string(search_str_v);
    let nee_d = nee.data;
    let nee_n = nee.length;
    let found_at: i32 = -1;
    let i: u32 = 0;
    while i + nee_n <= hay_n {
        let off = i;
        let eq: int = 0;
        raw { eq = (memcmp(hay_d + off, nee_d, nee_n) == 0) ? 1 : 0; }
        if eq != 0 { found_at = (i32)i; break; }
        i = i + 1;
    }
    if found_at < 0 {
        dealloc(out_buf);
        return this_val;
    }
    let mstart = (u32)found_at;
    let mend = mstart + nee_n;
    // Append prefix.
    while out_len + mstart + 64 > out_cap {
        let new_cap = out_cap * 2 + 64;
        out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
        out_cap = new_cap;
    }
    if mstart > 0 {
        mem_copy<char>(out_buf + out_len, hay_d, (usize)mstart);
        out_len = out_len + mstart;
    }
    // Replacement.
    let rep_data: char* = NULL;
    let rep_len: u32 = 0;
    if repl_is_fn {
        let cb_args: ZjsValue[3];
        cb_args[0] = search_str_v;
        cb_args[1] = zjs_int32((i32)mstart);
        cb_args[2] = this_val;
        let cb_argp: ZjsValue* = NULL;
        raw { cb_argp = &cb_args[0]; }
        let cb_r: ZjsValue = zjs_undefined();
        raw { cb_r = zjs_call_value_with_this(ctx, repl_v, zjs_undefined(), cb_argp, 3); }
        if zjs_is_string(cb_r) == 0 { cb_r = zjs_to_string(ctx, cb_r); }
        rep_data = zjs_as_string(cb_r).data;
        rep_len  = zjs_as_string(cb_r).length;
    } else {
        // String-needle replace also runs $-substitution per spec.
        let tmpl_data = zjs_as_string(repl_str_v).data;
        let tmpl_len  = zjs_as_string(repl_str_v).length;
        let exp_len: u32 = 0;
        let nullp_i32: i32* = NULL;
        let exp_buf = expand_replacement(tmpl_data, tmpl_len,
                                          hay_d, hay_n, mstart, mend,
                                          nullp_i32, nullp_i32, 0, &exp_len);
        while out_len + exp_len + (hay_n - mend) + 64 > out_cap {
            let new_cap = out_cap * 2 + 64;
            out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
            out_cap = new_cap;
        }
        if exp_len > 0 {
            mem_copy<char>(out_buf + out_len, exp_buf, (usize)exp_len);
            out_len = out_len + exp_len;
        }
        dealloc(exp_buf);
        let tail_len_s = hay_n - mend;
        if tail_len_s > 0 {
            let src_s: char* = NULL;
            raw { src_s = &hay_d[mend]; }
            mem_copy<char>(out_buf + out_len, src_s, (usize)tail_len_s);
            out_len = out_len + tail_len_s;
        }
        out_buf[out_len] = (char)0;
        return ctx_intern_string_take(ctx, out_buf, out_len);
    }
    while out_len + rep_len + (hay_n - mend) + 64 > out_cap {
        let new_cap = out_cap * 2 + 64;
        out_buf = realloc_n<char>(out_buf, (usize)out_cap, (usize)new_cap);
        out_cap = new_cap;
    }
    if rep_len > 0 {
        mem_copy<char>(out_buf + out_len, rep_data, (usize)rep_len);
        out_len = out_len + rep_len;
    }
    let tail_len = hay_n - mend;
    if tail_len > 0 {
        let src: char* = NULL;
        raw { src = &hay_d[mend]; }
        mem_copy<char>(out_buf + out_len, src, (usize)tail_len);
        out_len = out_len + tail_len;
    }
    out_buf[out_len] = (char)0;
    return ctx_intern_string_take(ctx, out_buf, out_len);
}

// String.prototype.match(regexp): if regexp has the global flag,
// return an array of all full-match strings (no captures). Else
// delegate to RegExp.prototype.exec for the single match (full +
// captures + .index/.input). Non-regexp args are coerced via
// new RegExp(arg).
fn host_string_match(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return zjs_null(); }
    // Coerce the argument to a RegExp.
    let pat_v: ZjsValue = if argc >= 1 { args[0] } else { zjs_undefined() };
    let re_v: ZjsValue = zjs_undefined();
    if zjs_is_regexp(pat_v) != 0 {
        re_v = pat_v;
    } else {
        let pat_str = if zjs_is_undefined(pat_v) != 0 {
            ctx_intern_string(ctx, (char*)"", 0)
        } else if zjs_is_string(pat_v) != 0 {
            pat_v
        } else {
            zjs_to_string(ctx, pat_v)
        };
        re_v = ctx_new_regexp(ctx, pat_str, ctx_intern_string(ctx, (char*)"", 0));
    }
    let re = zjs_as_regexp(re_v);
    let is_global = (re.flags & REGEX_FLAG_GLOBAL) != 0;
    if !is_global {
        // Spec routes through @@match → exec(thisStr). Call exec
        // directly to skip a synthetic indirection.
        let saved_host = ctx.host_this;
        ctx.host_this = re_v;
        let ex_args: ZjsValue[1];
        ex_args[0] = this_val;
        let ex_argp: ZjsValue* = NULL;
        raw { ex_argp = &ex_args[0]; }
        let r = host_regexp_exec(ctx, ex_argp, 1);
        ctx.host_this = saved_host;
        return r;
    }
    // Global: iterate exec until no match, collect full-match strings.
    if !regex_ensure_compiled(re) { return zjs_null(); }
    let s = zjs_as_string(this_val);
    let preg = re.preg;
    let hay_d = s.data;
    let hay_n = s.length;
    let result_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let arr = zjs_as_array(result_v);
    let pmatch_buf: ZRegMatch[1];
    let scan: u32 = 0;
    while scan <= hay_n {
        let rc: int = -1;
        raw {
            rc = lre_run(preg, hay_d, hay_n, scan, pmatch_buf, 1);
        }
        if rc != 0 { break; }
        let mstart = (u32)pmatch_buf[0].rm_so;
        let mend   = (u32)pmatch_buf[0].rm_eo;
        let mlen = mend - mstart;
        let mbuf = alloc_n<char>((usize)(mlen + 1));
        if mlen > 0 {
            let src: char* = NULL;
            raw { src = &hay_d[mstart]; }
            mem_copy<char>(mbuf, src, (usize)mlen);
        }
        mbuf[mlen] = (char)0;
        array_set(arr, arr.length, ctx_intern_string_take(ctx, mbuf, mlen));
        scan = if mend > scan { mend } else { scan + 1 };
    }
    re.last_index = 0;
    if arr.length == 0 { return zjs_null(); }
    return result_v;
}

fn host_string_split(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = coerce_string_this(ctx);
    if zjs_is_string(this_val) == 0 { return ctx_new_array(ctx, 0); }
    let s = zjs_as_string(this_val);
    // ECMA-262: limit is ToUint32(limit) (undefined → 2^32-1).
    // Process this BEFORE the separator-undefined check so a 0 limit
    // still short-circuits to an empty array per step 8.
    let limit_u32: u32 = 0xffffffff;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let lim_v = args[1];
        // ToUint32 → ToNumber → ToPrimitive("number"). Object args
        // route through valueOf / toString — their throws abort split.
        if zjs_is_object(lim_v) != 0 || zjs_is_array(lim_v) != 0 {
            lim_v = zjs_to_primitive(ctx, lim_v, false);
            if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        }
        let lim = zjs_to_double(lim_v);
        if ctx.pending_throw_active { return ctx_new_array(ctx, 0); }
        let is_nan_l: int = 0; raw { is_nan_l = isnan(lim) ? 1 : 0; }
        if is_nan_l != 0 { lim = 0.0; }
        // ToUint32: floor toward zero, modulo 2^32, treat NaN as 0.
        let v_d: f64 = lim;
        raw {
            if (v_d < 0) v_d = -v_d;
            v_d = floor(v_d);
            v_d = fmod(v_d, 4294967296.0);
            if (lim < 0) v_d = 4294967296.0 - v_d;
            if (v_d == 4294967296.0) v_d = 0.0;
        }
        limit_u32 = (u32)v_d;
    }
    if limit_u32 == 0 { return ctx_new_array(ctx, 0); }
    // If no separator, return [s].
    if argc == 0 || zjs_is_undefined(args[0]) != 0 {
        let one = ctx_new_array(ctx, 1);
        let one_arr = zjs_as_array(one);
        one_arr.elements[0] = this_val;
        one_arr.length = 1;
        return one;
    }
    let sep_arg = args[0];
    if zjs_is_regexp(sep_arg) != 0 {
        let r = zjs_as_regexp(sep_arg);
        let result_v = ctx_new_array(ctx, 0);
        if !regex_ensure_compiled(r) {
            let arr = zjs_as_array(result_v);
            array_set(arr, 0, this_val);
            return result_v;
        }
        let arr = zjs_as_array(result_v);
        let preg = r.preg;
        let hay_d = s.data;
        let hay_n = s.length;
        let pmatch_buf: ZRegMatch[1];
        let cursor: u32 = 0;
        let scan: u32 = 0;
        // Set when the last emitted piece came from the empty-match
        // single-char advance (so the trailing "" should be suppressed,
        // matching ECMA-262's split-into-chars semantic for an empty
        // pattern). Cleared on any normal piece emission.
        let last_was_empty_advance: bool = false;
        while scan <= hay_n && arr.length < limit_u32 {
            let rc: int = -1;
            raw {
                rc = lre_run(preg, hay_d, hay_n, scan, pmatch_buf, 1);
            }
            if rc != 0 { break; }
            let mstart = (u32)pmatch_buf[0].rm_so;
            let mend   = (u32)pmatch_buf[0].rm_eo;
            if mstart >= hay_n { break; }
            // Empty match at `cursor` is special: ECMA-262 advances one
            // input char and emits a single-char piece. This is what
            // makes `"abc".split(new RegExp())` give ["a","b","c"]
            // rather than ["", "a", "b", "c"].
            if mstart == cursor && mend == mstart {
                if cursor >= hay_n { break; }
                let pbuf = alloc_n<char>(2);
                pbuf[0] = hay_d[cursor];
                pbuf[1] = (char)0;
                array_set(arr, arr.length, ctx_intern_string_take(ctx, pbuf, 1));
                cursor = cursor + 1;
                scan = cursor;
                last_was_empty_advance = true;
                continue;
            }
            last_was_empty_advance = false;
            let piece_len = mstart - cursor;
            let pbuf = alloc_n<char>((usize)(piece_len + 1));
            if piece_len > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(pbuf, src, (usize)piece_len);
            }
            pbuf[piece_len] = (char)0;
            array_set(arr, arr.length, ctx_intern_string_take(ctx, pbuf, piece_len));
            cursor = mend;
            // Avoid infinite loops on /(?=x)/-style empty matches.
            scan = if mend > scan { mend } else { scan + 1 };
        }
        // Trailing piece. Spec emits even an empty trailing element
        // after the final non-empty match (`"abc".split(/[a-z]/)` →
        // `["", "", "", ""]`). The empty-regex / split-into-chars
        // case (`"abc".split(new RegExp())` → `["a", "b", "c"]`) is
        // the lone exception — suppress the tail when the loop exited
        // via the empty-match single-char advance branch.
        if arr.length < limit_u32 && !last_was_empty_advance {
            let tlen = hay_n - cursor;
            let tbuf = alloc_n<char>((usize)(tlen + 1));
            if tlen > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(tbuf, src, (usize)tlen);
            }
            tbuf[tlen] = (char)0;
            array_set(arr, arr.length, ctx_intern_string_take(ctx, tbuf, tlen));
        }
        return result_v;
    }
    let sep_v = sep_arg;
    if zjs_is_string(sep_v) == 0 { sep_v = zjs_to_string(ctx, sep_v); }
    let sep = zjs_as_string(sep_v);
    let result_v = ctx_new_array(ctx, 0);
    let result = zjs_as_array(result_v);

    // ECMA-262 §22.1.3.21 step 9: limit == 0 short-circuits to [].
    if limit_u32 == 0 { return result_v; }

    // Empty separator: split into individual characters, honoring limit.
    if sep.length == 0 {
        let i: u32 = 0;
        while i < s.length && result.length < limit_u32 {
            let buf = alloc_n<char>((usize)2);
            buf[0] = s.data[i];
            buf[1] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, 1);
            array_set(result, result.length, piece);
            i = i + 1;
        }
        return result_v;
    }

    let hay_d  = s.data;
    let hay_n  = s.length;
    let nee_d  = sep.data;
    let nee_n  = sep.length;
    let cursor: u32 = 0;
    let i: u32 = 0;
    while i + nee_n <= hay_n && result.length < limit_u32 {
        let matches: int = 0;
        let off = i;
        raw { matches = (memcmp(hay_d + off, nee_d, nee_n) == 0) ? 1 : 0; }
        if matches != 0 {
            let piece_len = i - cursor;
            let buf = alloc_n<char>((usize)(piece_len + 1));
            if piece_len > 0 {
                let src: char* = NULL;
                raw { src = &hay_d[cursor]; }
                mem_copy<char>(buf, src, (usize)piece_len);
            }
            buf[piece_len] = (char)0;
            let piece = ctx_intern_string_take(ctx, buf, piece_len);
            array_set(result, result.length, piece);
            cursor = i + nee_n;
            i = cursor;
        } else {
            i = i + 1;
        }
    }
    // Trailing remainder (respect limit too).
    if result.length < limit_u32 {
        let tail_len = hay_n - cursor;
        let tail_buf = alloc_n<char>((usize)(tail_len + 1));
        if tail_len > 0 {
            let src: char* = NULL;
            raw { src = &hay_d[cursor]; }
            mem_copy<char>(tail_buf, src, (usize)tail_len);
        }
        tail_buf[tail_len] = (char)0;
        let tail = ctx_intern_string_take(ctx, tail_buf, tail_len);
        array_set(result, result.length, tail);
    }
    return result_v;
}

// --- Higher-order array methods (Phase 3.5b) ----------------------
//
// These call a user-provided JS callback. We use ctx_push_temp_root to
// protect the result accumulator across the inner interpret() call,
// which may GC. The callback receives (element, index, array) — the
// standard JS prototype-method signature.

raw {
    extern ZjsValue zjs_call_value(ZjsContext* ctx, ZjsValue callee, ZjsValue* args, uint32_t argc);
}

fn host_array_map(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    // ECMA-262 §22.1.3.18 step 1: O = ToObject(this). Lift primitives
    // so `Array.prototype.map.call("abc", cb)` walks char indices via
    // the wrapper's String.prototype chain.
    if zjs_is_array(this_val) == 0 && zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    // Length via read_length_u32 — handles arrays (dense), objects
    // (property_get + ToLength), and also functions / regex / host
    // fns / wrapped primitives by walking the value's prototype.
    //
    // Spec order: a length-getter throw fires BEFORE the IsCallable
    // check on the callback, so 4-10-style tests see the original
    // Test262Error rather than a missing-callback TypeError.
    let len_atom_map = ctx_intern_atom(ctx, (char*)"length", 6);
    let len_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)len_atom_map));
    if ctx.pending_throw_active { return zjs_undefined(); }
    if zjs_is_object(len_v) != 0 || zjs_is_array(len_v) != 0 {
        len_v = zjs_to_primitive(ctx, len_v, false);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    let len_d = zjs_to_double(len_v);
    let is_nan_len: int = 0;
    raw { is_nan_len = isnan(len_d) ? 1 : 0; }
    if is_nan_len != 0 { len_d = 0.0; }
    if len_d < 0.0 { len_d = 0.0; }
    // ECMA-262 §10.4.2.4 / ArraySpeciesCreate: a Number length that
    // doesn't fit in a u32 (including +Infinity) throws RangeError
    // before any callback runs.
    if len_d > 4294967295.0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"Invalid array length", 20);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let len = (u32)len_d;
    if !require_callback_callable(ctx, args, argc) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };

    let result_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_array(result_v);

    let i: u32 = 0;
    while i < len {
        // Spec checks HasProperty before invoking callback — holes are
        // skipped entirely and the corresponding slot in the result
        // stays a hole.
        let present: bool = false;
        let src: ZjsValue = zjs_undefined();
        if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
            let arr = zjs_as_array(this_val);
            if i < arr.length && i < arr.cap {
                let raw_v = arr.elements[i];
                if zjs_is_deleted(raw_v) == 0 {
                    present = true;
                    src = raw_v;
                }
            }
        } else {
            // Generic-this (or array with expando bag — defineProperty
            // installed accessors that must fire). Spec HasProperty
            // gates the callback so missing indices stay holes in the
            // result, matching real arrays.
            if value_has_index(ctx, this_val, i) {
                present = true;
                src = property_get(ctx, this_val, zjs_int32((i32)i));
                if ctx.pending_throw_active { return result_v; }
            }
        }
        if present {
            let cb_args: ZjsValue[3];
            cb_args[0] = src;
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            let mapped: ZjsValue = zjs_undefined();
            raw { mapped = zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.pending_throw_active { return result_v; }
            array_set(result, i, mapped);
        }
        i = i + 1;
    }
    result.length = len;
    return result_v;
}

// Array.prototype.keys / values / entries — MVP returns a snapshot
// array suitable for our for-of model (which iterates by numeric
// index). Not a true Iterator object — `.next()` isn't supported, but
// `for (x of arr.keys())` works because for-of just walks length and
// indexes. Holes contribute null for entries / values too, matching
// ECMA-262 IteratorStep on a sparse array.
fn host_array_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let out_v = ctx_new_array(ctx, len);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        array_set(out, i, zjs_int32((i32)i));
        i = i + 1;
    }
    return out_v;
}

fn host_array_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let out_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        array_set(out, i, v);
        i = i + 1;
    }
    return out_v;
}

fn host_array_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let out_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        let pair_v = ctx_new_array(ctx, 2);
        let pair = zjs_as_array(pair_v);
        array_set(pair, 0, zjs_int32((i32)i));
        array_set(pair, 1, v);
        array_set(out, i, pair_v);
        i = i + 1;
    }
    return out_v;
}

fn host_array_join(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len: u32 = read_length_u32(ctx, this_val);
    let sep_v: ZjsValue = ctx_intern_string(ctx, (char*)",", 1);
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        sep_v = args[0];
        if zjs_is_string(sep_v) == 0 { sep_v = zjs_to_string(ctx, sep_v); }
    }
    if len == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    // Build the joined string by repeated zjs_string_concat. O(n^2)
    // worst case — fine for the test262 inputs we care about.
    let result: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    // Defensive rooting: result + sep_v are held across many
    // allocations (string concat per element, possibly ToString of
    // each element). Push both; release after the loop.
    ctx_push_temp_root(ctx, sep_v);
    ctx_push_temp_root(ctx, result);
    defer ctx_pop_temp_root(ctx);
    defer ctx_pop_temp_root(ctx);
    let arr: ZjsArray* = NULL;
    if zjs_is_array(this_val) != 0 { arr = zjs_as_array(this_val); }
    let i: u32 = 0;
    while i < len {
        if i > 0 {
            result = zjs_string_concat(ctx, result, sep_v);
            ctx_replace_top_temp_root(ctx, result);
        }
        let elem: ZjsValue = zjs_undefined();
        // Spec: holes / undefined / null contribute "" to the join.
        // array_get already coerces holes to undefined; we then check
        // for both undefined and null to suppress the ToString call.
        if arr != NULL { elem = array_get(arr, i); }
        else if zjs_is_object(this_val) != 0 { elem = obj_get_indexed(ctx, zjs_as_object(this_val), i); }
        if zjs_is_undefined(elem) == 0 && zjs_is_null(elem) == 0 {
            if zjs_is_string(elem) == 0 { elem = zjs_to_string(ctx, elem); }
            // Protect `elem` across the concat allocation.
            ctx_push_temp_root(ctx, elem);
            result = zjs_string_concat(ctx, result, elem);
            ctx_pop_temp_root(ctx);
            ctx_replace_top_temp_root(ctx, result);
        }
        i = i + 1;
    }
    return result;
}

fn host_array_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len = read_length_u32(ctx, this_val);
    let start: i32 = 0;
    let end: i32 = (i32)len;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        start = (i32)zjs_to_double(args[0]);
        if start < 0 { start = (i32)len + start; if start < 0 { start = 0; } }
        if start > (i32)len { start = (i32)len; }
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        end = (i32)zjs_to_double(args[1]);
        if end < 0 { end = (i32)len + end; if end < 0 { end = 0; } }
        if end > (i32)len { end = (i32)len; }
    }
    if end < start { end = start; }
    let count = (u32)(end - start);
    let out_v = ctx_new_array(ctx, count);
    let out = zjs_as_array(out_v);
    let arr: ZjsArray* = NULL;
    if zjs_is_array(this_val) != 0 { arr = zjs_as_array(this_val); }
    let i: u32 = 0;
    while i < count {
        let src_idx = (u32)(start) + i;
        if arr != NULL {
            if src_idx < arr.length { out.elements[i] = arr.elements[src_idx]; }
        } else if zjs_is_object(this_val) != 0 {
            out.elements[i] = obj_get_indexed(ctx, zjs_as_object(this_val), src_idx);
        }
        i = i + 1;
    }
    out.length = count;
    return out_v;
}

fn host_array_concat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    // First pass: compute total length.
    let total: u32 = read_length_u32(ctx, this_val);
    let i: u32 = 0;
    while i < argc {
        let a = args[i];
        if zjs_is_array(a) != 0 { total = total + zjs_as_array(a).length; }
        else { total = total + 1; }
        i = i + 1;
    }
    let out_v = ctx_new_array(ctx, total);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let cursor: u32 = 0;
    // Copy this.
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let k: u32 = 0;
        while k < arr.length { out.elements[cursor + k] = arr.elements[k]; k = k + 1; }
        cursor = cursor + arr.length;
    } else if zjs_is_object(this_val) != 0 {
        let len = read_length_u32(ctx, this_val);
        let k: u32 = 0;
        while k < len {
            out.elements[cursor + k] = obj_get_indexed(ctx, zjs_as_object(this_val), k);
            k = k + 1;
        }
        cursor = cursor + len;
    }
    // Then each arg.
    i = 0;
    while i < argc {
        let a = args[i];
        if zjs_is_array(a) != 0 {
            let arr = zjs_as_array(a);
            let k: u32 = 0;
            while k < arr.length { out.elements[cursor + k] = arr.elements[k]; k = k + 1; }
            cursor = cursor + arr.length;
        } else {
            out.elements[cursor] = a;
            cursor = cursor + 1;
        }
        i = i + 1;
    }
    out.length = total;
    return out_v;
}

fn host_array_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) == 0 && zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    // Spec order: length first, then IsCallable.
    let _len_probe = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if !require_callback_callable(ctx, args, argc) { return zjs_undefined(); }
    let cb = args[0];
    // ECMA-262 §22.1.3.12: forEach(callbackfn, thisArg). Second arg
    // becomes `this` in the callback. Pass undefined when absent.
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };

    // Fast path: real array — direct .elements[] access. Skip holes
    // per spec (HasProperty check before the callback invocation).
    // Bail to the generic-property_get path when arr.props is set
    // so defineProperty-installed accessors fire correctly.
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        let len = arr.length;
        let i: u32 = 0;
        while i < len {
            let slot = arr.elements[i];
            if zjs_is_deleted(slot) != 0 {
                i = i + 1;
                continue;
            }
            let cb_args: ZjsValue[3];
            cb_args[0] = slot;
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { (void)zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.pending_throw_active { return zjs_undefined(); }
            i = i + 1;
        }
        return zjs_undefined();
    }

    // Generic-this path: read_length_u32 + property_get on the
    // receiver value. Handles function / host-fn / regex /
    // wrapper-primitive receivers uniformly (no ZjsObject cast).
    // Spec gates the callback on HasProperty so holes / missing
    // indices skip the call entirely.
    let len = read_length_u32(ctx, this_val);
    let i: u32 = 0;
    while i < len {
        if value_has_index(ctx, this_val, i) {
            let v = property_get(ctx, this_val, zjs_int32((i32)i));
            if ctx.pending_throw_active { return zjs_undefined(); }
            let cb_args: ZjsValue[3];
            cb_args[0] = v;
            cb_args[1] = zjs_int32((i32)i);
            cb_args[2] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { (void)zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        i = i + 1;
    }
    return zjs_undefined();
}

// =====================================================================
// Native Array.prototype methods (Phase 5.1). every / some / find /
// findIndex / filter / reduce / reduceRight / includes / lastIndexOf /
// at / flat / flatMap / reverse / sort / splice / shift / unshift,
// plus Array.from / Array.of statics. Pattern mirrors host_array_map /
// host_array_for_each: spec-shape length read, IsCallable guard,
// fast-path dense-array loop, generic property_get fallback.
// =====================================================================

// Shared element-read helper. Returns true + writes to `*out` when
// index i is "present" on this_val (dense slot or HasProperty); false
// for holes. Handles array-with-props bag + arbitrary objects.
fn array_method_get(ctx: ZjsContext*, this_val: ZjsValue, i: u32, out: ZjsValue*) -> bool {
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        if i < arr.length && i < arr.cap {
            let v = arr.elements[i];
            if zjs_is_deleted(v) == 0 { out[0] = v; return true; }
        }
        return false;
    }
    if value_has_index(ctx, this_val, i) {
        out[0] = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return false; }
        return true;
    }
    return false;
}

// Coerce host_this to an indexable receiver + grab length. Returns
// true on success; on throw sets pending_throw and returns false.
// Out param: `*len_out`. Out param: `*this_out` (may rebind from a
// primitive to its ToObject wrapper). Common preamble for every
// array-iteration method.
fn array_method_prelude(ctx: ZjsContext*, args: ZjsValue*, argc: u32,
                        need_callback: bool,
                        this_out: ZjsValue*, len_out: u32*) -> bool {
    if !require_array_coercible_this(ctx) { return false; }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) == 0 && zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return false; }
    }
    let len = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return false; }
    if need_callback {
        if !require_callback_callable(ctx, args, argc) { return false; }
    }
    this_out[0] = this_val;
    len_out[0]  = len;
    return true;
}

fn array_method_call_cb(ctx: ZjsContext*, cb: ZjsValue, this_arg: ZjsValue,
                        v: ZjsValue, i: u32, this_val: ZjsValue) -> ZjsValue {
    let cb_args: ZjsValue[3];
    cb_args[0] = v;
    cb_args[1] = zjs_int32((i32)i);
    cb_args[2] = this_val;
    let cb_args_ptr: ZjsValue* = NULL;
    raw { cb_args_ptr = &cb_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, cb, this_arg, cb_args_ptr, 3); }
    return r;
}

// Array.prototype.every — true if every element satisfies the
// predicate. Per ECMA-262 §23.1.3.7: empty array → true.
fn host_array_every(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let i: u32 = 0;
    while i < len {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, i, &v) {
            if ctx.pending_throw_active { return zjs_undefined(); }
            let r = array_method_call_cb(ctx, cb, this_arg, v, i, this_val);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if !zjs_to_bool_coerce(r) { return zjs_bool(0); }
        } else if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    return zjs_bool(1);
}

fn host_array_some(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let i: u32 = 0;
    while i < len {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, i, &v) {
            if ctx.pending_throw_active { return zjs_undefined(); }
            let r = array_method_call_cb(ctx, cb, this_arg, v, i, this_val);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_to_bool_coerce(r) { return zjs_bool(1); }
        } else if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    return zjs_bool(0);
}

// find / findIndex differ from every/some by NOT skipping holes —
// spec says they read every index (undefined for holes) and pass it
// to the callback. Matches Node + V8.
fn host_array_find(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r = array_method_call_cb(ctx, cb, this_arg, v, i, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_to_bool_coerce(r) { return v; }
        i = i + 1;
    }
    return zjs_undefined();
}

fn host_array_find_index(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r = array_method_call_cb(ctx, cb, this_arg, v, i, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_to_bool_coerce(r) { return zjs_int32((i32)i); }
        i = i + 1;
    }
    return zjs_int32(-1);
}

fn host_array_filter(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let result_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_array(result_v);
    let out_i: u32 = 0;
    let i: u32 = 0;
    while i < len {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, i, &v) {
            if ctx.pending_throw_active { return result_v; }
            let r = array_method_call_cb(ctx, cb, this_arg, v, i, this_val);
            if ctx.pending_throw_active { return result_v; }
            if zjs_to_bool_coerce(r) {
                array_set(result, out_i, v);
                out_i = out_i + 1;
            }
        } else if ctx.pending_throw_active { return result_v; }
        i = i + 1;
    }
    return result_v;
}

// reduce / reduceRight share the accumulator-walk pattern. Per spec
// they throw TypeError on an empty array with no initial value.
fn host_array_reduce(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let has_init = argc >= 2;
    let acc: ZjsValue = if has_init { args[1] } else { zjs_undefined() };
    let i: u32 = 0;
    if !has_init {
        // Find the first present index; that's the seed.
        while i < len {
            let v: ZjsValue = zjs_undefined();
            if array_method_get(ctx, this_val, i, &v) {
                if ctx.pending_throw_active { return zjs_undefined(); }
                acc = v;
                i = i + 1;
                break;
            }
            if ctx.pending_throw_active { return zjs_undefined(); }
            i = i + 1;
        }
        if i == 0 || (i == len && zjs_is_undefined(acc) != 0) {
            // True empty-or-all-holes case.
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Reduce of empty array with no initial value", 43);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
    }
    while i < len {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, i, &v) {
            if ctx.pending_throw_active { return zjs_undefined(); }
            let cb_args: ZjsValue[4];
            cb_args[0] = acc;
            cb_args[1] = v;
            cb_args[2] = zjs_int32((i32)i);
            cb_args[3] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { acc = zjs_call_value_with_this(ctx, cb, zjs_undefined(), cb_args_ptr, 4); }
            if ctx.pending_throw_active { return zjs_undefined(); }
        } else if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    return acc;
}

fn host_array_reduce_right(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let has_init = argc >= 2;
    let acc: ZjsValue = if has_init { args[1] } else { zjs_undefined() };
    if len == 0 && !has_init {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Reduce of empty array with no initial value", 43);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    // Walk right-to-left. i is i32 so we can compare against -1 cleanly.
    let i: i32 = (i32)len - 1;
    if !has_init {
        while i >= 0 {
            let v: ZjsValue = zjs_undefined();
            if array_method_get(ctx, this_val, (u32)i, &v) {
                if ctx.pending_throw_active { return zjs_undefined(); }
                acc = v;
                i = i - 1;
                break;
            }
            if ctx.pending_throw_active { return zjs_undefined(); }
            i = i - 1;
        }
        if i < -1 || (i == -1 && zjs_is_undefined(acc) != 0 && len > 0 && !has_init) {
            // Saw no values at all — all holes.
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Reduce of empty array with no initial value", 43);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
    }
    while i >= 0 {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, (u32)i, &v) {
            if ctx.pending_throw_active { return zjs_undefined(); }
            let cb_args: ZjsValue[4];
            cb_args[0] = acc;
            cb_args[1] = v;
            cb_args[2] = zjs_int32(i);
            cb_args[3] = this_val;
            let cb_args_ptr: ZjsValue* = NULL;
            raw { cb_args_ptr = &cb_args[0]; }
            raw { acc = zjs_call_value_with_this(ctx, cb, zjs_undefined(), cb_args_ptr, 4); }
            if ctx.pending_throw_active { return zjs_undefined(); }
        } else if ctx.pending_throw_active { return zjs_undefined(); }
        i = i - 1;
    }
    return acc;
}

// includes uses SameValueZero (NaN === NaN, +0 === -0). Compare to
// indexOf which uses StrictEquality (NaN !== NaN).
fn same_value_zero(a: ZjsValue, b: ZjsValue) -> bool {
    if zjs_strict_eq(a, b) != 0 { return true; }
    // NaN-NaN special case.
    if zjs_is_double(a) != 0 && zjs_is_double(b) != 0 {
        let ad = zjs_as_double(a);
        let bd = zjs_as_double(b);
        let a_nan: int = 0; let b_nan: int = 0;
        raw { a_nan = isnan(ad) ? 1 : 0; b_nan = isnan(bd) ? 1 : 0; }
        if a_nan != 0 && b_nan != 0 { return true; }
    }
    return false;
}

fn host_array_includes(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &len) { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(0); }
    let target = args[0];
    let from: i32 = if argc >= 2 && zjs_is_int32(args[1]) != 0 { zjs_as_int32(args[1]) }
                    else if argc >= 2 && zjs_is_double(args[1]) != 0 { (i32)zjs_as_double(args[1]) }
                    else { 0 };
    if from < 0 { from = (i32)len + from; if from < 0 { from = 0; } }
    let i: u32 = (u32)from;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if same_value_zero(v, target) { return zjs_bool(1); }
        i = i + 1;
    }
    return zjs_bool(0);
}

fn host_array_last_index_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &len) { return zjs_undefined(); }
    if argc == 0 || len == 0 { return zjs_int32(-1); }
    let target = args[0];
    let from: i32 = (i32)len - 1;
    if argc >= 2 {
        let raw_from: i32 = if zjs_is_int32(args[1]) != 0 { zjs_as_int32(args[1]) }
                            else if zjs_is_double(args[1]) != 0 { (i32)zjs_as_double(args[1]) }
                            else { 0 };
        if raw_from < 0 { from = (i32)len + raw_from; }
        else if raw_from < (i32)len { from = raw_from; }
    }
    let i: i32 = from;
    while i >= 0 {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, (u32)i, &v) {
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_strict_eq(v, target) != 0 { return zjs_int32(i); }
        } else if ctx.pending_throw_active { return zjs_undefined(); }
        i = i - 1;
    }
    return zjs_int32(-1);
}

fn host_array_at(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &len) { return zjs_undefined(); }
    let n: i32 = if argc >= 1 && zjs_is_int32(args[0]) != 0 { zjs_as_int32(args[0]) }
                 else if argc >= 1 && zjs_is_double(args[0]) != 0 { (i32)zjs_as_double(args[0]) }
                 else { 0 };
    if n < 0 { n = (i32)len + n; }
    if n < 0 || n >= (i32)len { return zjs_undefined(); }
    return property_get(ctx, this_val, zjs_int32(n));
}

// flat — recursive walk pushing leaves into out.
fn array_flat_walk(ctx: ZjsContext*, src: ZjsValue, depth: i32,
                   out: ZjsArray*, out_i_ptr: u32*) -> void {
    let len = read_length_u32(ctx, src);
    if ctx.pending_throw_active { return; }
    let i: u32 = 0;
    while i < len {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, src, i, &v) {
            if ctx.pending_throw_active { return; }
            if depth > 0 && zjs_is_array(v) != 0 {
                array_flat_walk(ctx, v, depth - 1, out, out_i_ptr);
                if ctx.pending_throw_active { return; }
            } else {
                array_set(out, out_i_ptr[0], v);
                out_i_ptr[0] = out_i_ptr[0] + 1;
            }
        } else if ctx.pending_throw_active { return; }
        i = i + 1;
    }
}

fn host_array_flat(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let _len_unused: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &_len_unused) { return zjs_undefined(); }
    let depth: i32 = 1;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        if zjs_is_int32(args[0]) != 0 { depth = zjs_as_int32(args[0]); }
        else if zjs_is_double(args[0]) != 0 { depth = (i32)zjs_as_double(args[0]); }
    }
    let out_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let oi: u32 = 0;
    array_flat_walk(ctx, this_val, depth, out, &oi);
    if ctx.pending_throw_active { return zjs_undefined(); }
    return out_v;
}

fn host_array_flat_map(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let out_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let oi: u32 = 0;
    let i: u32 = 0;
    while i < len {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, i, &v) {
            if ctx.pending_throw_active { return out_v; }
            let mapped = array_method_call_cb(ctx, cb, this_arg, v, i, this_val);
            if ctx.pending_throw_active { return out_v; }
            // Spec: mapped is flattened by 1 level.
            if zjs_is_array(mapped) != 0 {
                let m = zjs_as_array(mapped);
                let mi: u32 = 0;
                while mi < m.length {
                    let mv: ZjsValue = zjs_undefined();
                    if array_method_get(ctx, mapped, mi, &mv) {
                        if ctx.pending_throw_active { return out_v; }
                        array_set(out, oi, mv); oi = oi + 1;
                    } else if ctx.pending_throw_active { return out_v; }
                    mi = mi + 1;
                }
            } else {
                array_set(out, oi, mapped); oi = oi + 1;
            }
        } else if ctx.pending_throw_active { return out_v; }
        i = i + 1;
    }
    return out_v;
}

// reverse — in-place. Per spec walks 0..len/2 swapping i with len-1-i.
// Holes are preserved as holes (skip swap).
fn host_array_reverse(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    // Fast path: dense array, mutate elements directly.
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        let n = arr.length;
        if n < 2 { return this_val; }
        let i: u32 = 0;
        let j: u32 = n - 1;
        while i < j {
            let tmp = arr.elements[i];
            arr.elements[i] = arr.elements[j];
            arr.elements[j] = tmp;
            i = i + 1; j = j - 1;
        }
        return this_val;
    }
    // Generic path: property_get/set per index.
    let len = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let i: u32 = 0;
    while i < len / 2 {
        let lo = i;
        let hi = len - 1 - i;
        let a: ZjsValue = zjs_undefined();
        let b: ZjsValue = zjs_undefined();
        let has_a = array_method_get(ctx, this_val, lo, &a);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let has_b = array_method_get(ctx, this_val, hi, &b);
        if ctx.pending_throw_active { return zjs_undefined(); }
        if has_a && has_b {
            property_set(ctx, this_val, zjs_int32((i32)lo), b);
            if ctx.pending_throw_active { return zjs_undefined(); }
            property_set(ctx, this_val, zjs_int32((i32)hi), a);
            if ctx.pending_throw_active { return zjs_undefined(); }
        } else if has_a {
            property_set(ctx, this_val, zjs_int32((i32)hi), a);
            if ctx.pending_throw_active { return zjs_undefined(); }
            // Drop lo by setting it deleted via Reflect.deleteProperty
            // semantics — approximate with undefined for now.
            property_set(ctx, this_val, zjs_int32((i32)lo), zjs_undefined());
        } else if has_b {
            property_set(ctx, this_val, zjs_int32((i32)lo), b);
            if ctx.pending_throw_active { return zjs_undefined(); }
            property_set(ctx, this_val, zjs_int32((i32)hi), zjs_undefined());
        }
        i = i + 1;
    }
    return this_val;
}

// In-place quicksort. Default comparator is lexicographic ToString.
fn array_sort_default_cmp(ctx: ZjsContext*, a: ZjsValue, b: ZjsValue) -> int {
    // ECMA-262 §23.1.3.30 default: undefined-sort-last, otherwise
    // String(a) vs String(b).
    let a_undef = zjs_is_undefined(a) != 0;
    let b_undef = zjs_is_undefined(b) != 0;
    if a_undef && b_undef { return 0; }
    if a_undef { return 1; }
    if b_undef { return -1; }
    let as_v = if zjs_is_string(a) != 0 { a } else { zjs_to_string(ctx, a) };
    let bs_v = if zjs_is_string(b) != 0 { b } else { zjs_to_string(ctx, b) };
    let as_s = zjs_as_string(as_v);
    let bs_s = zjs_as_string(bs_v);
    let cmp: int = 0;
    raw {
        size_t n = as_s->length < bs_s->length ? as_s->length : bs_s->length;
        int r = memcmp(as_s->data, bs_s->data, n);
        if (r < 0) cmp = -1;
        else if (r > 0) cmp = 1;
        else if (as_s->length < bs_s->length) cmp = -1;
        else if (as_s->length > bs_s->length) cmp = 1;
        else cmp = 0;
    }
    return cmp;
}

fn array_sort_call_cmp(ctx: ZjsContext*, cmp: ZjsValue, a: ZjsValue, b: ZjsValue) -> int {
    let cb_args: ZjsValue[2];
    cb_args[0] = a;
    cb_args[1] = b;
    let cb_args_ptr: ZjsValue* = NULL;
    raw { cb_args_ptr = &cb_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, cmp, zjs_undefined(), cb_args_ptr, 2); }
    if ctx.pending_throw_active { return 0; }
    let d = zjs_to_double(r);
    if d < 0.0 { return -1; }
    if d > 0.0 { return 1; }
    return 0;
}

fn array_sort_compare(ctx: ZjsContext*, cmp_v: ZjsValue, a: ZjsValue, b: ZjsValue) -> int {
    if zjs_is_undefined(cmp_v) != 0 {
        return array_sort_default_cmp(ctx, a, b);
    }
    return array_sort_call_cmp(ctx, cmp_v, a, b);
}

fn array_sort_qs(ctx: ZjsContext*, arr: ZjsArray*, cmp_v: ZjsValue, lo: i32, hi: i32) -> void {
    if lo >= hi { return; }
    let pivot = arr.elements[(u32)((lo + hi) / 2)];
    let i: i32 = lo;
    let j: i32 = hi;
    while i <= j {
        while array_sort_compare(ctx, cmp_v, arr.elements[(u32)i], pivot) < 0 {
            if ctx.pending_throw_active { return; }
            i = i + 1;
        }
        if ctx.pending_throw_active { return; }
        while array_sort_compare(ctx, cmp_v, arr.elements[(u32)j], pivot) > 0 {
            if ctx.pending_throw_active { return; }
            j = j - 1;
        }
        if ctx.pending_throw_active { return; }
        if i <= j {
            let t = arr.elements[(u32)i];
            arr.elements[(u32)i] = arr.elements[(u32)j];
            arr.elements[(u32)j] = t;
            i = i + 1; j = j - 1;
        }
    }
    array_sort_qs(ctx, arr, cmp_v, lo, j);
    if ctx.pending_throw_active { return; }
    array_sort_qs(ctx, arr, cmp_v, i, hi);
}

fn host_array_sort(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let cmp_v: ZjsValue = zjs_undefined();
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        cmp_v = args[0];
        if zjs_is_function(cmp_v) == 0 && zjs_is_closure(cmp_v) == 0 && zjs_is_host_function(cmp_v) == 0 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"The comparison function must be either a function or undefined", 64);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
    }
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        if arr.length >= 2 {
            array_sort_qs(ctx, arr, cmp_v, 0, (i32)arr.length - 1);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        return this_val;
    }
    // Generic path: copy into a buffer, sort, write back.
    let len = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if len < 2 { return this_val; }
    let tmp_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, tmp_v);
    defer ctx_pop_temp_root(ctx);
    let tmp = zjs_as_array(tmp_v);
    let i: u32 = 0;
    while i < len {
        tmp.elements[i] = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    tmp.length = len;
    array_sort_qs(ctx, tmp, cmp_v, 0, (i32)len - 1);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let j: u32 = 0;
    while j < len {
        property_set(ctx, this_val, zjs_int32((i32)j), tmp.elements[j]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        j = j + 1;
    }
    return this_val;
}

// ---------------------------------------------------------------------------
// ES2023 additions: findLast / findLastIndex + the "change array by copy"
// quartet (toReversed / toSorted / toSpliced / with). The copy variants
// never mutate `this`; they read element-by-element (array-like safe) and
// build a fresh dense array.
// ---------------------------------------------------------------------------

fn host_array_find_last(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let k: i64 = (i64)len - 1;
    while k >= 0 {
        let v = property_get(ctx, this_val, zjs_int32((i32)k));
        if ctx.pending_throw_active { return zjs_undefined(); }
        let r = array_method_call_cb(ctx, cb, this_arg, v, (u32)k, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_to_bool_coerce(r) { return v; }
        k = k - 1;
    }
    return zjs_undefined();
}

fn host_array_find_last_index(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, true, &this_val, &len) { return zjs_undefined(); }
    let cb = args[0];
    let this_arg: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let k: i64 = (i64)len - 1;
    while k >= 0 {
        let v = property_get(ctx, this_val, zjs_int32((i32)k));
        if ctx.pending_throw_active { return zjs_int32(-1); }
        let r = array_method_call_cb(ctx, cb, this_arg, v, (u32)k, this_val);
        if ctx.pending_throw_active { return zjs_int32(-1); }
        if zjs_to_bool_coerce(r) { return zjs_int32((i32)k); }
        k = k - 1;
    }
    return zjs_int32(-1);
}

fn host_array_to_reversed(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &len) { return zjs_undefined(); }
    let out_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)(len - 1 - i)));
        if ctx.pending_throw_active { return out_v; }
        array_set(out, i, v);
        i = i + 1;
    }
    out.length = len;
    return out_v;
}

fn host_array_to_sorted(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let cmp_v: ZjsValue = zjs_undefined();
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        cmp_v = args[0];
        if zjs_is_callable(cmp_v) == 0 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                (char*)"The comparison function must be either a function or undefined", 64);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
    }
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &len) { return zjs_undefined(); }
    let out_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        out.elements[i] = property_get(ctx, this_val, zjs_int32((i32)i));
        if ctx.pending_throw_active { return out_v; }
        i = i + 1;
    }
    out.length = len;
    if len >= 2 {
        array_sort_qs(ctx, out, cmp_v, 0, (i32)len - 1);
        if ctx.pending_throw_active { return out_v; }
    }
    return out_v;
}

fn host_array_with(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &len) { return zjs_undefined(); }
    let rel: i64 = if argc >= 1 && zjs_is_int32(args[0]) != 0 { (i64)zjs_as_int32(args[0]) }
                   else if argc >= 1 && zjs_is_double(args[0]) != 0 { (i64)zjs_as_double(args[0]) }
                   else { 0 };
    let actual: i64 = if rel >= 0 { rel } else { (i64)len + rel };
    if actual < 0 || actual >= (i64)len {
        let err = build_typed_error(ctx, (char*)"RangeError", 10, (char*)"Invalid index", 13);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let new_val: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let out_v = ctx_new_array(ctx, len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < len {
        if (i64)i == actual {
            array_set(out, i, new_val);
        } else {
            let v = property_get(ctx, this_val, zjs_int32((i32)i));
            if ctx.pending_throw_active { return out_v; }
            array_set(out, i, v);
        }
        i = i + 1;
    }
    out.length = len;
    return out_v;
}

fn host_array_to_spliced(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val: ZjsValue = zjs_undefined();
    let len: u32 = 0;
    if !array_method_prelude(ctx, args, argc, false, &this_val, &len) { return zjs_undefined(); }
    let start: i64 = if argc >= 1 && zjs_is_int32(args[0]) != 0 { (i64)zjs_as_int32(args[0]) }
                     else if argc >= 1 && zjs_is_double(args[0]) != 0 { (i64)zjs_as_double(args[0]) }
                     else { 0 };
    if start < 0 { start = (i64)len + start; if start < 0 { start = 0; } }
    if start > (i64)len { start = (i64)len; }
    let skip: i64 = if argc < 2 { (i64)len - start }
                    else if zjs_is_int32(args[1]) != 0 { (i64)zjs_as_int32(args[1]) }
                    else if zjs_is_double(args[1]) != 0 { (i64)zjs_as_double(args[1]) }
                    else { 0 };
    if skip < 0 { skip = 0; }
    if skip > (i64)len - start { skip = (i64)len - start; }
    let n_ins: u32 = if argc > 2 { argc - 2 } else { 0 };
    let new_len: u32 = (u32)((i64)len - skip + (i64)n_ins);
    let out_v = ctx_new_array(ctx, new_len);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);
    let oi: u32 = 0;
    let r: u32 = 0;
    while r < (u32)start {
        let v = property_get(ctx, this_val, zjs_int32((i32)r));
        if ctx.pending_throw_active { return out_v; }
        array_set(out, oi, v); oi = oi + 1; r = r + 1;
    }
    let ai: u32 = 0;
    while ai < n_ins {
        array_set(out, oi, args[2 + ai]); oi = oi + 1; ai = ai + 1;
    }
    let src: u32 = (u32)(start + skip);
    while src < len {
        let v = property_get(ctx, this_val, zjs_int32((i32)src));
        if ctx.pending_throw_active { return out_v; }
        array_set(out, oi, v); oi = oi + 1; src = src + 1;
    }
    out.length = new_len;
    return out_v;
}

// splice(start, deleteCount, ...items) — mutate in place, return
// removed slice. Dense-array fast path only; generic-object path
// falls back to read/write loops.
fn host_array_splice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let len = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return zjs_undefined(); }
    // start arg, clamped to [0, len].
    let start: i32 = if argc >= 1 && zjs_is_int32(args[0]) != 0 { zjs_as_int32(args[0]) }
                     else if argc >= 1 && zjs_is_double(args[0]) != 0 { (i32)zjs_as_double(args[0]) }
                     else { 0 };
    if start < 0 { start = (i32)len + start; if start < 0 { start = 0; } }
    if start > (i32)len { start = (i32)len; }
    let dc: i32 = if argc < 2 { (i32)len - start }
                  else if zjs_is_int32(args[1]) != 0 { zjs_as_int32(args[1]) }
                  else if zjs_is_double(args[1]) != 0 { (i32)zjs_as_double(args[1]) }
                  else { 0 };
    if dc < 0 { dc = 0; }
    if dc > (i32)len - start { dc = (i32)len - start; }
    let n_ins: u32 = if argc > 2 { argc - 2 } else { 0 };
    // Build the removed array first (per spec).
    let removed_v = ctx_new_array(ctx, (u32)dc);
    ctx_push_temp_root(ctx, removed_v);
    defer ctx_pop_temp_root(ctx);
    let removed = zjs_as_array(removed_v);
    let k: u32 = 0;
    while k < (u32)dc {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, (u32)start + k, &v) {
            if ctx.pending_throw_active { return removed_v; }
            array_set(removed, k, v);
        } else if ctx.pending_throw_active { return removed_v; }
        k = k + 1;
    }
    removed.length = (u32)dc;
    // Dense fast path — shift in place. Cache old length first:
    // array_set's grow side-effect bumps arr.length, which would
    // throw off the shift-source range.
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        let old_len: u32 = arr.length;
        let diff: i32 = (i32)n_ins - dc;
        if diff > 0 {
            let new_len = old_len + (u32)diff;
            if new_len > arr.cap { array_set(arr, new_len - 1, zjs_undefined()); }
            let p: i32 = (i32)old_len - 1;
            while p >= start + dc {
                arr.elements[(u32)(p + diff)] = arr.elements[(u32)p];
                p = p - 1;
            }
        } else if diff < 0 {
            let q: u32 = (u32)start + (u32)dc;
            while q < old_len {
                arr.elements[(u32)((i32)q + diff)] = arr.elements[q];
                q = q + 1;
            }
        }
        let ii: u32 = 0;
        while ii < n_ins {
            arr.elements[(u32)start + ii] = args[2 + ii];
            ii = ii + 1;
        }
        arr.length = (u32)((i32)old_len + diff);
        return removed_v;
    }
    // Generic-this path is rare; not building a full mutator for now.
    // Test262 will surface real misuse if needed.
    return removed_v;
}

fn host_array_shift(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        if arr.length == 0 { return zjs_undefined(); }
        let first = arr.elements[0];
        let i: u32 = 1;
        while i < arr.length {
            arr.elements[i - 1] = arr.elements[i];
            i = i + 1;
        }
        arr.length = arr.length - 1;
        return first;
    }
    let len = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if len == 0 { return zjs_undefined(); }
    let first = property_get(ctx, this_val, zjs_int32(0));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let i: u32 = 1;
    while i < len {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, i, &v) {
            if ctx.pending_throw_active { return zjs_undefined(); }
            property_set(ctx, this_val, zjs_int32((i32)(i - 1)), v);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        i = i + 1;
    }
    property_set(ctx, this_val, ctx_intern_string(ctx, (char*)"length", 6), zjs_int32((i32)(len - 1)));
    return first;
}

fn host_array_unshift(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let n = argc;
    if zjs_is_array(this_val) != 0 && zjs_as_array(this_val).props == NULL {
        let arr = zjs_as_array(this_val);
        if n == 0 { return zjs_int32((i32)arr.length); }
        let old_len: u32 = arr.length;
        let new_len = old_len + n;
        if new_len > arr.cap { array_set(arr, new_len - 1, zjs_undefined()); }
        let p: i32 = (i32)old_len - 1;
        while p >= 0 {
            arr.elements[(u32)((i32)p + (i32)n)] = arr.elements[(u32)p];
            p = p - 1;
        }
        let i: u32 = 0;
        while i < n {
            arr.elements[i] = args[i];
            i = i + 1;
        }
        arr.length = new_len;
        return zjs_int32((i32)new_len);
    }
    let len = read_length_u32(ctx, this_val);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if n == 0 { return zjs_int32((i32)len); }
    let p: i32 = (i32)len - 1;
    while p >= 0 {
        let v: ZjsValue = zjs_undefined();
        if array_method_get(ctx, this_val, (u32)p, &v) {
            if ctx.pending_throw_active { return zjs_undefined(); }
            property_set(ctx, this_val, zjs_int32(p + (i32)n), v);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        p = p - 1;
    }
    let i: u32 = 0;
    while i < n {
        property_set(ctx, this_val, zjs_int32((i32)i), args[i]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    property_set(ctx, this_val, ctx_intern_string(ctx, (char*)"length", 6), zjs_int32((i32)(len + n)));
    return zjs_int32((i32)(len + n));
}

// Array.from(iterable, mapFn?, thisArg?). Walks via the iterator
// protocol (Symbol.iterator) when present, falls back to a length+
// index walk for array-like objects.
fn host_array_from_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 || zjs_is_undefined(args[0]) != 0 || zjs_is_null(args[0]) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Array.from requires an iterable or array-like", 45);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let src = args[0];
    let map_fn: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let this_arg: ZjsValue = if argc >= 3 { args[2] } else { zjs_undefined() };
    let has_map = zjs_is_undefined(map_fn) == 0;
    if has_map {
        if zjs_is_function(map_fn) == 0 && zjs_is_closure(map_fn) == 0 && zjs_is_host_function(map_fn) == 0 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Array.from mapFn must be a function", 35);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
    }
    let out_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let out = zjs_as_array(out_v);

    // Strings: walk characters directly (avoids the iterator wrapper
    // dance for a hot path that shows up in `Array.from('abc')`).
    if zjs_is_string(src) != 0 {
        let s = zjs_as_string(src);
        let i: u32 = 0;
        while i < s.length {
            let buf: char[2];
            raw { buf[0] = s->data[i]; buf[1] = 0; }
            let bp: char* = NULL; raw { bp = &buf[0]; }
            let ch = ctx_intern_string(ctx, bp, 1);
            let v: ZjsValue = ch;
            if has_map {
                v = array_method_call_cb(ctx, map_fn, this_arg, ch, i, src);
                if ctx.pending_throw_active { return out_v; }
            }
            array_set(out, i, v);
            i = i + 1;
        }
        return out_v;
    }

    // Iterable via @@iterator (covers user iterables, Map/Set, etc.).
    let iter_key = ctx_intern_atom(ctx, (char*)"@@iterator", 10);
    let getter = property_get(ctx, src, zjs_cell_from_ptr((void*)iter_key));
    if ctx.pending_throw_active { return out_v; }
    let getter_callable: bool =
        zjs_is_function(getter) != 0
        || zjs_is_closure(getter) != 0
        || zjs_is_host_function(getter) != 0;
    if getter_callable {
        let iter = iter_get(ctx, src);
        if ctx.pending_throw_active { return out_v; }
        let oi: u32 = 0;
        let safety: u32 = 0;
        while safety < 100000000 {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { return out_v; }
            if step.done { break; }
            let v: ZjsValue = step.value;
            if has_map {
                v = array_method_call_cb(ctx, map_fn, this_arg, step.value, oi, src);
                if ctx.pending_throw_active { return out_v; }
            }
            array_set(out, oi, v);
            oi = oi + 1;
            safety = safety + 1;
        }
        return out_v;
    }

    // Array-like: read .length then walk by index.
    let len = read_length_u32(ctx, src);
    if ctx.pending_throw_active { return out_v; }
    let i: u32 = 0;
    while i < len {
        let v = property_get(ctx, src, zjs_int32((i32)i));
        if ctx.pending_throw_active { return out_v; }
        if has_map {
            v = array_method_call_cb(ctx, map_fn, this_arg, v, i, src);
            if ctx.pending_throw_active { return out_v; }
        }
        array_set(out, i, v);
        i = i + 1;
    }
    return out_v;
}

fn host_array_of_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let out_v = ctx_new_array(ctx, argc);
    let out = zjs_as_array(out_v);
    let i: u32 = 0;
    while i < argc {
        out.elements[i] = args[i];
        i = i + 1;
    }
    out.length = argc;
    return out_v;
}

// --- JSON.stringify (Phase 3.5b) -----------------------------------
//
// Walks the value and appends JSON to a growable buffer. No `space`,
// no `replacer`, no `toJSON()`. Cycles overflow the stack — not a
// concern for the test workloads we care about now.

struct JsonBuf {
    data: char*;
    len:  u32;
    cap:  u32;
}

fn json_buf_grow(b: JsonBuf*, need: u32) -> void {
    if b.len + need <= b.cap { return; }
    let new_cap: u32 = if b.cap == 0 { 64 } else { b.cap * 2 };
    while new_cap < b.len + need { new_cap = new_cap * 2; }
    b.data = realloc_n<char>(b.data, (usize)b.cap, (usize)new_cap);
    b.cap = new_cap;
}

fn json_buf_putc(b: JsonBuf*, ch: char) -> void {
    json_buf_grow(b, 1);
    b.data[b.len] = ch;
    b.len = b.len + 1;
}

fn json_buf_puts(b: JsonBuf*, s: char*, n: u32) -> void {
    json_buf_grow(b, n);
    let dst: char* = NULL;
    raw { dst = b->data + b->len; }
    mem_copy<char>(dst, s, (usize)n);
    b.len = b.len + n;
}

fn json_emit_string(b: JsonBuf*, s: char*, n: u32) -> void {
    json_buf_putc(b, '"');
    let i: u32 = 0;
    while i < n {
        let c: char = s[i];
        let cu = (u8)c;
        if cu == 34 {           // "
            json_buf_putc(b, '\\'); json_buf_putc(b, '"');
        } else if cu == 92 {    // \
            json_buf_putc(b, '\\'); json_buf_putc(b, '\\');
        } else if cu == 8 {     // \b
            json_buf_putc(b, '\\'); json_buf_putc(b, 'b');
        } else if cu == 9 {     // \t
            json_buf_putc(b, '\\'); json_buf_putc(b, 't');
        } else if cu == 10 {    // \n
            json_buf_putc(b, '\\'); json_buf_putc(b, 'n');
        } else if cu == 12 {    // \f
            json_buf_putc(b, '\\'); json_buf_putc(b, 'f');
        } else if cu == 13 {    // \r
            json_buf_putc(b, '\\'); json_buf_putc(b, 'r');
        } else if cu < 32 {
            // \u00XX
            let hex_lookup: char* = NULL;
            raw { hex_lookup = (char*)"0123456789abcdef"; }
            json_buf_putc(b, '\\');
            json_buf_putc(b, 'u');
            json_buf_putc(b, '0');
            json_buf_putc(b, '0');
            json_buf_putc(b, hex_lookup[(cu >> 4) & 15]);
            json_buf_putc(b, hex_lookup[cu & 15]);
        } else {
            json_buf_putc(b, c);
        }
        i = i + 1;
    }
    json_buf_putc(b, '"');
}

// Bundles the replacer-related state so the recursive serializer
// doesn't drag five separate parameters. `replacer_fn` is a callable
// value (function / closure / host fn) or undefined. `replacer_arr`
// is a property-name allowlist (ZjsArray of strings) or undefined.
// `replacer_fn` and `replacer_arr` are mutually exclusive per spec.
struct JsonCtx {
    replacer_fn:  ZjsValue;
    replacer_arr: ZjsValue;     // (an array) or undefined
    indent_str:   char*;        // owned char buffer or NULL = no indent
    indent_len:   u32;          // strlen(indent_str)
    depth:        u32;          // current nesting level
    // Cycle-detection stack: pointers to objects / arrays currently
    // being serialized. ECMA-262 §25.5.2.4 step 1 throws TypeError if
    // a value is already on the stack. Capped at 32 levels — beyond
    // that we'd risk the host stack anyway.
    stack:        void*[32];
    stack_depth:  u32;
}

// Emit a newline and `depth` copies of the indent string. Used by
// pretty-printing only — when indent_len is 0 this is a no-op caller
// can skip.
fn json_emit_indent(b: JsonBuf*, jc: JsonCtx*) -> void {
    if jc.indent_len == 0 { return; }
    json_buf_putc(b, '\n');
    let i: u32 = 0;
    while i < jc.depth {
        json_buf_puts(b, jc.indent_str, jc.indent_len);
        i = i + 1;
    }
}

// Apply replacer fn to (key, value), returning the value to actually
// serialize. The fn is called with `this = holder` per spec, but we
// pass an empty object for that (no test we care about checks it
// specifically). Returns undefined if the replacer signals "omit".
fn json_apply_replacer(ctx: ZjsContext*, jc: JsonCtx*, key: ZjsValue, v: ZjsValue) -> ZjsValue {
    if zjs_is_undefined(jc.replacer_fn) != 0 { return v; }
    let cb_args: ZjsValue[2];
    cb_args[0] = key;
    cb_args[1] = v;
    let argp: ZjsValue* = NULL;
    raw { argp = &cb_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, jc->replacer_fn, zjs_undefined(), argp, 2); }
    return r;
}

// ECMA-262 §25.5.2.2 SerializeJSONProperty step 2: if value is an
// object (incl. arrays / wrappers) and has a callable .toJSON method,
// invoke it with the current key and use the return value in place
// of the original. Pure no-op for primitives.
fn json_apply_to_json(ctx: ZjsContext*, key: ZjsValue, v: ZjsValue) -> ZjsValue {
    if zjs_is_object(v) == 0 && zjs_is_array(v) == 0 && zjs_is_uint8_array(v) == 0 { return v; }
    let to_json_atom = ctx_intern_atom(ctx, (char*)"toJSON", 6);
    let to_json_fn = property_get(ctx, v, zjs_cell_from_ptr((void*)to_json_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_callable = zjs_is_function(to_json_fn) != 0
                     || zjs_is_closure(to_json_fn) != 0
                     || zjs_is_host_function(to_json_fn) != 0;
    if !is_callable { return v; }
    let cb_args: ZjsValue[1];
    cb_args[0] = key;
    let argp: ZjsValue* = NULL;
    raw { argp = &cb_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, to_json_fn, v, argp, 1); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    return r;
}

// True if the property name is in the replacer-array allowlist.
// When no array filter is active, all keys pass.
fn json_key_in_filter(jc: JsonCtx*, name: ZjsString*) -> bool {
    if zjs_is_undefined(jc.replacer_arr) != 0 { return true; }
    if zjs_is_array(jc.replacer_arr) == 0 { return true; }
    let a = zjs_as_array(jc.replacer_arr);
    let i: u32 = 0;
    while i < a.length {
        let el = a.elements[i];
        if zjs_is_deleted(el) == 0 && zjs_is_string(el) != 0 {
            let s = zjs_as_string(el);
            if zjs_string_equals(s, name) != 0 { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn json_stringify_value(ctx: ZjsContext*, jc: JsonCtx*, b: JsonBuf*, v: ZjsValue) -> void {
    if zjs_is_undefined(v) != 0 {
        // JSON.stringify(undefined) is `undefined` in JS (not a string).
        // At the top level the caller handles this by returning undefined;
        // inside an array we'd emit null. For simplicity here, emit null.
        json_buf_puts(b, (char*)"null", 4);
        return;
    }
    if zjs_is_null(v) != 0 { json_buf_puts(b, (char*)"null", 4); return; }
    if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { json_buf_puts(b, (char*)"true", 4); }
        else                   { json_buf_puts(b, (char*)"false", 5); }
        return;
    }
    // JSON.stringify on a BigInt throws TypeError (ECMA-262 §25.5.2).
    if zjs_is_bigint(v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
            (char*)"Do not know how to serialize a BigInt", 37);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return;
    }
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        let tmp: char[32];
        let written: int = 0;
        let tp: char* = NULL;
        raw { tp = &tmp[0]; written = snprintf(tp, 32, "%d", (int)n); }
        json_buf_puts(b, tp, (u32)written);
        return;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        // NaN / Infinity become null per ECMA-262.
        let is_finite: int = 0;
        raw { is_finite = isfinite(d) ? 1 : 0; }
        if is_finite == 0 { json_buf_puts(b, (char*)"null", 4); return; }
        // ECMA-262 §7.1.16.1 NumberToString: +0 and -0 both serialize
        // as "0". snprintf("%g", -0.0) emits "-0" which violates that.
        if d == 0.0 { json_buf_putc(b, '0'); return; }
        let tmp: char[32];
        let written: int = 0;
        let tp: char* = NULL;
        raw {
            tp = &tmp[0];
            // Shortest round-trip: try precisions until strtod recovers
            // the same double. Same algorithm as zjs_to_string.
            int found = 0;
            for (int prec = 1; prec <= 17 && !found; prec++) {
                int n = snprintf(tp, 32, "%.*g", prec, d);
                char* end = NULL;
                double rt = strtod(tp, &end);
                if (rt == d) { written = n; found = 1; }
            }
            if (!found) { written = snprintf(tp, 32, "%.17g", d); }
        }
        json_buf_puts(b, tp, (u32)written);
        return;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        json_emit_string(b, s.data, s.length);
        return;
    }
    // ECMA-262 §25.5.2.2 SerializeJSONProperty steps 4a-d:
    // unbox Boolean / Number / String / BigInt wrapper objects.
    // Detected via the `__zjs_primitive__` internal slot we stash in
    // `new Boolean(x)` / `new Number(x)` / `new String(x)`. Boolean
    // unboxes directly (the spec reads [[BooleanData]] without
    // observable side effects); Number / String route through the
    // user-overridable ToNumber / ToString so a custom valueOf or
    // toString on the wrapper fires.
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        let prim = object_get(o, wkey);
        if zjs_is_undefined(prim) == 0 {
            let coerced: ZjsValue = prim;
            if zjs_is_bool(prim) != 0 {
                // [[BooleanData]] — read directly.
                coerced = prim;
            } else if zjs_is_string(prim) != 0 {
                coerced = zjs_to_string(ctx, v);
                if ctx.pending_throw_active { return; }
            } else {
                // Number wrapper (or any other) — ToNumber fires valueOf.
                let prim2 = zjs_to_primitive(ctx, v, false);
                if ctx.pending_throw_active { return; }
                coerced = prim2;
            }
            json_stringify_value(ctx, jc, b, coerced);
            return;
        }
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        // Cycle check before descending. ECMA-262 §25.5.2 throws
        // TypeError on a structural cycle (including indirect ones).
        let aptr: void* = (void*)a;
        let s: u32 = 0;
        while s < jc.stack_depth {
            if jc.stack[s] == aptr {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Converting circular structure to JSON", 37);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return;
            }
            s = s + 1;
        }
        if jc.stack_depth >= 32 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"JSON.stringify nesting too deep", 31);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return;
        }
        jc.stack[jc.stack_depth] = aptr;
        jc.stack_depth = jc.stack_depth + 1;
        defer { jc.stack_depth = jc.stack_depth - 1; }
        json_buf_putc(b, '[');
        if a.length == 0 { json_buf_putc(b, ']'); return; }
        jc.depth = jc.depth + 1;
        let i: u32 = 0;
        while i < a.length {
            if i > 0 { json_buf_putc(b, ','); }
            else if jc.indent_len == 0 { /* compact: nothing */ }
            json_emit_indent(b, jc);
            // ECMA-262 SerializeJSONArray: holes emit "null", not "".
            let slot = a.elements[i];
            let elem_v: ZjsValue = if zjs_is_deleted(slot) != 0 { zjs_null() } else { slot };
            // toJSON + replacer key for an array element is index-as-string.
            let buf: char[16];
            let blen: int = 0;
            raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)i); }
            let bp: char* = NULL; raw { bp = &buf[0]; }
            let key_s = ctx_intern_string(ctx, bp, (u32)blen);
            elem_v = json_apply_to_json(ctx, key_s, elem_v);
            if ctx.pending_throw_active { return; }
            if zjs_is_undefined(jc.replacer_fn) == 0 {
                elem_v = json_apply_replacer(ctx, jc, key_s, elem_v);
                if ctx.pending_throw_active { return; }
            }
            if zjs_is_undefined(elem_v) != 0 { json_buf_puts(b, (char*)"null", 4); }
            else                              { json_stringify_value(ctx, jc, b, elem_v); }
            i = i + 1;
        }
        jc.depth = jc.depth - 1;
        json_emit_indent(b, jc);
        json_buf_putc(b, ']');
        return;
    }
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        // Cycle check before descending — mirrors the array branch.
        let optr: void* = (void*)o;
        let s2: u32 = 0;
        while s2 < jc.stack_depth {
            if jc.stack[s2] == optr {
                let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                            (char*)"Converting circular structure to JSON", 37);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return;
            }
            s2 = s2 + 1;
        }
        if jc.stack_depth >= 32 {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"JSON.stringify nesting too deep", 31);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return;
        }
        jc.stack[jc.stack_depth] = optr;
        jc.stack_depth = jc.stack_depth + 1;
        defer { jc.stack_depth = jc.stack_depth - 1; }
        // Enumerate own property names in insertion order by walking
        // the hidden-class chain bottom-up (same approach as Object.keys).
        let count = o.cls.prop_count;
        json_buf_putc(b, '{');
        let saved_depth = jc.depth;
        jc.depth = jc.depth + 1;
        // First gather names by slot.
        let names: ZjsString*[64];          // MVP: 64-prop cap per object
        let names_ptr: ZjsString** = NULL;
        raw { names_ptr = &names[0]; }
        let limit: u32 = if count > 64 { 64 } else { count };
        let init_i: u32 = 0;
        while init_i < limit { names_ptr[init_i] = NULL; init_i = init_i + 1; }
        let cls = o.cls;
        while cls != NULL && cls.parent != NULL {
            let slot = cls.transition_slot;
            if slot < limit { names_ptr[slot] = cls.transition_name; }
            cls = cls.parent;
        }
        let i: u32 = 0;
        let emitted: u32 = 0;
        // If a replacer-array allowlist is active, the spec says to
        // iterate it in array order (not the object's own-key order)
        // and emit each whitelisted key that EXISTS on the object.
        // For the common test262 patterns this matters — `replacer:
        // ["b","a"]` should emit b before a, not the object's order.
        let use_filter_order = zjs_is_array(jc.replacer_arr) != 0;
        if use_filter_order {
            let fa = zjs_as_array(jc.replacer_arr);
            let fi: u32 = 0;
            while fi < fa.length {
                let kv = fa.elements[fi];
                if zjs_is_deleted(kv) == 0 && zjs_is_string(kv) != 0 {
                    let kname = zjs_as_string(kv);
                    // Find the slot for this name in the object.
                    let slot = class_find_slot(o.cls, kname);
                    if slot >= 0 {
                        let attrs = object_get_attrs(o, (u32)slot);
                        let raw_slot = o.slots[(u32)slot];
                        if (attrs & PROP_ENUMERABLE) != 0 && zjs_is_deleted(raw_slot) == 0 {
                            // Route through property_get so accessor
                            // getters fire (and their throws propagate).
                            let val = property_get(ctx, v, kv);
                            if ctx.pending_throw_active { return; }
                            val = json_apply_to_json(ctx, kv, val);
                            if ctx.pending_throw_active { return; }
                            let processed = json_apply_replacer(ctx, jc, kv, val);
                            if ctx.pending_throw_active { return; }
                            if zjs_is_undefined(processed) == 0
                               && !(zjs_cell_tag(processed) == TAG_FUNCTION
                                    || zjs_cell_tag(processed) == TAG_CLOSURE
                                    || zjs_cell_tag(processed) == TAG_HOST_FUNCTION) {
                                if emitted > 0 { json_buf_putc(b, ','); }
                                json_emit_indent(b, jc);
                                json_emit_string(b, kname.data, kname.length);
                                json_buf_putc(b, ':');
                                if jc.indent_len > 0 { json_buf_putc(b, ' '); }
                                json_stringify_value(ctx, jc, b, processed);
                                emitted = emitted + 1;
                            }
                        }
                    }
                }
                fi = fi + 1;
            }
        } else {
            while i < limit {
                let n = names_ptr[i];
                // Skip internal (`__zjs_*`) and Symbol-shim (`@@*`) keys.
                // Symbol-keyed props are spec-required to be omitted from
                // JSON.stringify; the internal-slot keys are an engine
                // implementation detail user code shouldn't see.
                if n != NULL && !string_is_hidden_key(n) {
                    let attrs = object_get_attrs(o, i);
                    if (attrs & PROP_ENUMERABLE) != 0 && zjs_is_deleted(o.slots[i]) == 0 {
                        let key_v = zjs_cell_from_ptr((void*)n);
                        // property_get fires accessors and lets their
                        // throws propagate (value-object-abrupt-style).
                        let val = property_get(ctx, v, key_v);
                        if ctx.pending_throw_active { return; }
                        val = json_apply_to_json(ctx, key_v, val);
                        if ctx.pending_throw_active { return; }
                        let processed = json_apply_replacer(ctx, jc, key_v, val);
                        if ctx.pending_throw_active { return; }
                        // Skip undefined, callable, and Symbol values (spec).
                        let is_callable: bool =
                               zjs_is_function(processed) != 0
                            || zjs_is_closure(processed) != 0
                            || zjs_is_host_function(processed) != 0;
                        let is_sym = zjs_is_symbol(processed) != 0;
                        if zjs_is_undefined(processed) == 0 && !is_callable && !is_sym {
                            if emitted > 0 { json_buf_putc(b, ','); }
                            json_emit_indent(b, jc);
                            json_emit_string(b, n.data, n.length);
                            json_buf_putc(b, ':');
                            if jc.indent_len > 0 { json_buf_putc(b, ' '); }
                            json_stringify_value(ctx, jc, b, processed);
                            emitted = emitted + 1;
                        }
                    }
                }
                i = i + 1;
            }
        }
        jc.depth = saved_depth;
        if emitted > 0 { json_emit_indent(b, jc); }
        json_buf_putc(b, '}');
        return;
    }
    // RegExp: an Object with no own enumerable string properties.
    // Emit empty-object braces — matches what real engines do. (Use
    // putc'd braces; the Zen-c lexer mistakes `{` inside a (char*)
    // literal for an expression start.)
    if zjs_is_regexp(v) != 0 {
        json_buf_putc(b, '{');
        json_buf_putc(b, '}');
        return;
    }
    // Uint8Array and the wider TypedArray family. Per spec these are
    // ordinary objects with own enumerable indexed properties — V8 /
    // SpiderMonkey emit them as `{"0":x,"1":y,...}`. (No spec-defined
    // toJSON, no special-cased fast-path output.)
    if zjs_is_uint8_array(v) != 0 {
        let u = zjs_as_uint8_array(v);
        json_buf_putc(b, '{');
        let i: u32 = 0;
        while i < u.length {
            if i > 0 { json_buf_putc(b, ','); }
            let buf: char[16];
            let blen: int = 0;
            raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)i); }
            let bp: char* = NULL; raw { bp = &buf[0]; }
            json_emit_string(b, bp, (u32)blen);
            json_buf_putc(b, ':');
            let n: int = 0;
            raw { n = (int)u->bytes[i]; }
            let tmp: char[8];
            let nlen: int = 0;
            raw { nlen = snprintf(&tmp[0], 8, "%d", n); }
            let tp: char* = NULL; raw { tp = &tmp[0]; }
            json_buf_puts(b, tp, (u32)nlen);
            i = i + 1;
        }
        json_buf_putc(b, '}');
        return;
    }
    if zjs_is_typed_array(v) != 0 {
        let ta = zjs_as_typed_array(v);
        json_buf_putc(b, '{');
        let i: u32 = 0;
        while i < ta.length {
            if i > 0 { json_buf_putc(b, ','); }
            let buf: char[16];
            let blen: int = 0;
            raw { blen = snprintf(&buf[0], 16, "%u", (unsigned)i); }
            let bp: char* = NULL; raw { bp = &buf[0]; }
            json_emit_string(b, bp, (u32)blen);
            json_buf_putc(b, ':');
            let elem_v = ta_load(ta, i);
            json_stringify_value(ctx, jc, b, elem_v);
            i = i + 1;
        }
        json_buf_putc(b, '}');
        return;
    }
    // Functions, closures, host functions, hidden classes — not
    // serializable. Real JSON.stringify returns undefined for these at
    // top level; inside containers it emits null. MVP: emit null.
    json_buf_puts(b, (char*)"null", 4);
}

fn host_json_stringify(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    // Parse the optional replacer arg (second). Either a callable or
    // an array of names; everything else is ignored. (The third
    // `space` argument is deferred — most tests passing it don't
    // observe formatting differences.)
    let jc: JsonCtx;
    jc.replacer_fn  = zjs_undefined();
    jc.replacer_arr = zjs_undefined();
    jc.indent_str   = NULL;
    jc.indent_len   = 0;
    jc.depth        = 0;
    jc.stack_depth  = 0;
    // Parse the optional `space` arg (third). Number → that many
    // spaces (clamped to 10). String → take up to first 10 chars
    // verbatim. Anything else is ignored.
    if argc >= 3 {
        let sp = args[2];
        // ECMA-262 §25.5.2.1 step 7: if space is a Number wrapper, use
        // ToNumber; if a String wrapper, use ToString. Detect wrapper
        // type via our __zjs_primitive__ slot — Number wrapper holds a
        // number, String wrapper holds a string.
        if zjs_is_object(sp) != 0 {
            let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
            let prim = object_get(zjs_as_object(sp), wkey);
            if zjs_is_string(prim) != 0 {
                // String wrapper → ToString fires toString.
                sp = zjs_to_string(ctx, sp);
                if ctx.pending_throw_active { return zjs_undefined(); }
            } else if zjs_is_number(prim) != 0 {
                // Number wrapper → ToNumber fires valueOf.
                let prim2 = zjs_to_primitive(ctx, sp, false);
                if ctx.pending_throw_active { return zjs_undefined(); }
                sp = prim2;
            }
        }
        if zjs_is_int32(sp) != 0 || zjs_is_double(sp) != 0 {
            let n = zjs_to_double(sp);
            let nclamp: u32 = 0;
            if n >= 1.0 {
                if n > 10.0 { nclamp = 10; } else { nclamp = (u32)n; }
            }
            if nclamp > 0 {
                let buf = alloc_n<char>((usize)(nclamp + 1));
                let bi: u32 = 0;
                while bi < nclamp { buf[bi] = ' '; bi = bi + 1; }
                buf[nclamp] = (char)0;
                jc.indent_str = buf;
                jc.indent_len = nclamp;
            }
        } else if zjs_is_string(sp) != 0 {
            let s = zjs_as_string(sp);
            let take: u32 = if s.length > 10 { 10 } else { s.length };
            if take > 0 {
                let buf = alloc_n<char>((usize)(take + 1));
                let bi: u32 = 0;
                while bi < take { buf[bi] = s.data[bi]; bi = bi + 1; }
                buf[take] = (char)0;
                jc.indent_str = buf;
                jc.indent_len = take;
            }
        }
    }
    if argc >= 2 {
        let r = args[1];
        if zjs_is_function(r) != 0 || zjs_is_closure(r) != 0 || zjs_is_host_function(r) != 0 {
            jc.replacer_fn = r;
        } else if zjs_is_array(r) != 0 {
            // ECMA-262 §25.5.2.1 step 4: build PropertyList from the
            // replacer array. Each item must be a String or a Number
            // (or a wrapper of either); convert Numbers via ToString;
            // skip duplicates and unsupported entries. We allocate a
            // fresh dedup'd array and use that as the filter to keep
            // the inner loop in json_stringify_value clean.
            let src = zjs_as_array(r);
            let out_v = ctx_new_array(ctx, 0);
            let out = zjs_as_array(out_v);
            let i: u32 = 0;
            while i < src.length {
                let item = src.elements[i];
                let key_str_v: ZjsValue = zjs_undefined();
                if zjs_is_string(item) != 0 {
                    key_str_v = item;
                } else if zjs_is_number(item) != 0 {
                    key_str_v = zjs_to_string(ctx, item);
                } else if zjs_is_object(item) != 0 {
                    // ECMA-262 §25.5.2.1 step 4.b.i-iv: a Number /
                    // String wrapper in the replacer array is
                    // unboxed and stringified. Detect by the
                    // __zjs_primitive__ slot we use for wrappers.
                    let wo = zjs_as_object(item);
                    let wkey = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
                    let prim = object_get(wo, wkey);
                    if zjs_is_string(prim) != 0 {
                        key_str_v = zjs_to_string(ctx, item);
                        if ctx.pending_throw_active { return zjs_undefined(); }
                    } else if zjs_is_number(prim) != 0 {
                        key_str_v = zjs_to_string(ctx, item);
                        if ctx.pending_throw_active { return zjs_undefined(); }
                    }
                }
                // Skip undefined / unsupported types (objects without
                // a String/Number internal slot).
                if zjs_is_string(key_str_v) != 0 {
                    let kname = zjs_as_string(key_str_v);
                    let seen: bool = false;
                    let j: u32 = 0;
                    while j < out.length {
                        let pj = out.elements[j];
                        if zjs_is_string(pj) != 0 {
                            if zjs_string_equals(zjs_as_string(pj), kname) != 0 {
                                seen = true; j = out.length;
                            } else { j = j + 1; }
                        } else { j = j + 1; }
                    }
                    if !seen {
                        array_set(out, out.length, key_str_v);
                    }
                }
                i = i + 1;
            }
            jc.replacer_arr = out_v;
        }
    }
    // Apply the top-level replacer call. Spec wraps the input in a
    // holder `{"": value}` and calls replacer("", value) before
    // serializing — same effect as letting json_apply_replacer fire
    // once with key="".
    let key0 = ctx_intern_string(ctx, (char*)"", 0);
    // Per spec, toJSON fires BEFORE the replacer.
    v = json_apply_to_json(ctx, key0, v);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if zjs_is_undefined(jc.replacer_fn) == 0 {
        v = json_apply_replacer(ctx, &jc, key0, v);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    // Top-level undefined / functions / Symbols return undefined per
    // ECMA-262 §25.5.2.2 (Symbols throw if inside, but are returned-
    // as-undefined at the top level per the Serialize fast paths).
    if zjs_is_undefined(v) != 0 { return zjs_undefined(); }
    let t = zjs_cell_tag(v);
    if t == TAG_FUNCTION || t == TAG_CLOSURE || t == TAG_HOST_FUNCTION
       || t == TAG_SYMBOL {
        return zjs_undefined();
    }
    let b: JsonBuf;
    b.data = NULL; b.len = 0; b.cap = 0;
    json_stringify_value(ctx, &jc, &b, v);
    if jc.indent_str != NULL { dealloc(jc.indent_str); }
    // Null-terminate for safety; ctx_intern_string_take only reads `len`.
    json_buf_putc(&b, '\0');
    b.len = b.len - 1;
    return ctx_intern_string_take(ctx, b.data, b.len);
}

// --- JSON.parse (Phase 3.5b) ---------------------------------------

struct JsonParser {
    src:  char*;
    len:  u32;
    pos:  u32;
    fail: bool;
}

fn jp_peek(p: JsonParser*) -> char {
    if p.pos >= p.len { return (char)0; }
    return p.src[p.pos];
}

fn jp_skip_ws(p: JsonParser*) -> void {
    while p.pos < p.len {
        let c = p.src[p.pos];
        let cu = (u8)c;
        if cu == 32 || cu == 9 || cu == 10 || cu == 13 { p.pos = p.pos + 1; }
        else { return; }
    }
}

fn jp_match_word(p: JsonParser*, word: char*, n: u32) -> bool {
    if p.pos + n > p.len { return false; }
    let src = p.src;
    let off = p.pos;
    let eq: int = 0;
    raw { eq = (memcmp(src + off, word, n) == 0) ? 1 : 0; }
    if eq == 0 { return false; }
    p.pos = p.pos + n;
    return true;
}

fn jp_parse_value(ctx: ZjsContext*, p: JsonParser*) -> ZjsValue {
    jp_skip_ws(p);
    if p.pos >= p.len { p.fail = true; return zjs_undefined(); }
    let c = p.src[p.pos];
    let cu = (u8)c;

    if cu == 110 {              // 'n' — null
        if jp_match_word(p, (char*)"null", 4) { return zjs_null(); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 116 {              // 't' — true
        if jp_match_word(p, (char*)"true", 4) { return zjs_bool(1); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 102 {              // 'f' — false
        if jp_match_word(p, (char*)"false", 5) { return zjs_bool(0); }
        p.fail = true; return zjs_undefined();
    }
    if cu == 34 {               // '"' — string
        p.pos = p.pos + 1;
        let buf_cap: u32 = 16;
        let buf = alloc_n<char>((usize)buf_cap);
        let blen: u32 = 0;
        let bcap = buf_cap;
        let ok = true;
        let closed = false;
        while p.pos < p.len {
            let ch = p.src[p.pos];
            let chu = (u8)ch;
            if chu == 34 { p.pos = p.pos + 1; closed = true; break; }
            // ECMA-262 §25.5.1 (JSON.parse grammar): JSONStringCharacter
            // disallows raw U+0000 through U+001F. They must be \uXXXX
            // escaped (and for the C0 controls below   even that
            // is required — most-strict reading). Reject the unescaped
            // form.
            if chu < 0x20 { ok = false; break; }
            if chu == 92 {      // '\'
                p.pos = p.pos + 1;
                if p.pos >= p.len { ok = false; break; }
                let esc = p.src[p.pos];
                let eu = (u8)esc;
                let out: u8 = 0;
                let used_u: bool = false;
                if eu == 34 { out = 34; }
                else if eu == 92 { out = 92; }
                else if eu == 47 { out = 47; }
                else if eu == 98 { out = 8; }      // \b
                else if eu == 102 { out = 12; }    // \f
                else if eu == 110 { out = 10; }    // \n
                else if eu == 114 { out = 13; }    // \r
                else if eu == 116 { out = 9; }     // \t
                else if eu == 117 {                // \uXXXX
                    used_u = true;
                    if p.pos + 4 >= p.len { ok = false; break; }
                    p.pos = p.pos + 1;
                    let cp: u32 = 0;
                    let hi: u32 = 0;
                    while hi < 4 {
                        let hc = p.src[p.pos + hi];
                        let hu = (u8)hc;
                        let digit: u32 = 0;
                        if hu >= 48 && hu <= 57 { digit = (u32)(hu - 48); }
                        else if hu >= 97 && hu <= 102 { digit = (u32)(hu - 97) + 10; }
                        else if hu >= 65 && hu <= 70 { digit = (u32)(hu - 65) + 10; }
                        else { ok = false; }
                        cp = (cp << 4) | digit;
                        hi = hi + 1;
                    }
                    if !ok { break; }
                    p.pos = p.pos + 3;
                    // MVP: encode as UTF-8 (BMP only, no surrogate joining).
                    if cp < 128 {
                        if blen + 1 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                        buf[blen] = (char)cp;
                        blen = blen + 1;
                    } else if cp < 2048 {
                        if blen + 2 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                        buf[blen]     = (char)(192 | (cp >> 6));
                        buf[blen + 1] = (char)(128 | (cp & 63));
                        blen = blen + 2;
                    } else {
                        if blen + 3 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                        buf[blen]     = (char)(224 | (cp >> 12));
                        buf[blen + 1] = (char)(128 | ((cp >> 6) & 63));
                        buf[blen + 2] = (char)(128 | (cp & 63));
                        blen = blen + 3;
                    }
                } else {
                    ok = false; break;
                }
                if !used_u {
                    if blen + 1 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                    buf[blen] = (char)out;
                    blen = blen + 1;
                }
                p.pos = p.pos + 1;
            } else {
                if blen + 1 > bcap { let oldc = bcap; bcap = bcap * 2; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
                buf[blen] = ch;
                blen = blen + 1;
                p.pos = p.pos + 1;
            }
        }
        // EOF before closing quote also fails: the spec requires a
        // matching `"` to end the string.
        if !ok || !closed { dealloc(buf); p.fail = true; return zjs_undefined(); }
        // Ensure null terminator slot.
        if blen + 1 > bcap { let oldc = bcap; bcap = blen + 1; buf = realloc_n<char>(buf, (usize)oldc, (usize)bcap); }
        buf[blen] = '\0';
        return ctx_intern_string_take(ctx, buf, blen);
    }
    if cu == 91 {               // '[' — array
        p.pos = p.pos + 1;
        let arr_v = ctx_new_array(ctx, 0);
        ctx_push_temp_root(ctx, arr_v);
        let arr = zjs_as_array(arr_v);
        jp_skip_ws(p);
        if jp_peek(p) == ']' { p.pos = p.pos + 1; ctx_pop_temp_root(ctx); return arr_v; }
        while true {
            jp_skip_ws(p);
            let elem = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            array_set(arr, arr.length, elem);
            jp_skip_ws(p);
            let cc = jp_peek(p);
            if cc == ',' { p.pos = p.pos + 1; }
            else if cc == ']' { p.pos = p.pos + 1; break; }
            else { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
        }
        ctx_pop_temp_root(ctx);
        return arr_v;
    }
    if cu == 123 {              // '{' — object
        p.pos = p.pos + 1;
        let obj_v = ctx_new_object(ctx);
        ctx_push_temp_root(ctx, obj_v);
        let obj = zjs_as_object(obj_v);
        jp_skip_ws(p);
        if jp_peek(p) == '}' { p.pos = p.pos + 1; ctx_pop_temp_root(ctx); return obj_v; }
        while true {
            jp_skip_ws(p);
            // Key must be string.
            if jp_peek(p) != '"' { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
            let k_v = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            jp_skip_ws(p);
            if jp_peek(p) != ':' { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
            p.pos = p.pos + 1;
            jp_skip_ws(p);
            let val = jp_parse_value(ctx, p);
            if p.fail { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            // Use atom-interned key for property name (matches the
            // hidden-class convention).
            let ks = zjs_as_string(k_v);
            let key_atom = ctx_intern_atom(ctx, ks.data, ks.length);
            object_set(ctx, obj, key_atom, val);
            jp_skip_ws(p);
            let cc = jp_peek(p);
            if cc == ',' { p.pos = p.pos + 1; }
            else if cc == '}' { p.pos = p.pos + 1; break; }
            else { p.fail = true; ctx_pop_temp_root(ctx); return zjs_undefined(); }
        }
        ctx_pop_temp_root(ctx);
        return obj_v;
    }
    // Number — optional '-', integer part, optional fraction, optional exponent.
    let is_negative = false;
    if cu == 45 { is_negative = true; p.pos = p.pos + 1; }
    let num_start = p.pos;
    let has_dot = false;
    let has_exp = false;
    while p.pos < p.len {
        let nc = p.src[p.pos];
        let nu = (u8)nc;
        if nu >= 48 && nu <= 57 { p.pos = p.pos + 1; }
        else if nu == 46 && !has_dot { has_dot = true; p.pos = p.pos + 1; }
        else if (nu == 101 || nu == 69) && !has_exp {
            has_exp = true; p.pos = p.pos + 1;
            if p.pos < p.len {
                let sn = (u8)p.src[p.pos];
                if sn == 43 || sn == 45 { p.pos = p.pos + 1; }
            }
        }
        else { break; }
    }
    if p.pos == num_start { p.fail = true; return zjs_undefined(); }
    // strtod the slice via a stack-buffered C string.
    let slice_len = p.pos - num_start;
    let parsed: f64 = 0.0;
    let src = p.src;
    let off = num_start;
    let sl = slice_len;
    raw {
        char buf[64];
        size_t n = sl < 63 ? sl : 63;
        memcpy(buf, src + off, n);
        buf[n] = '\0';
        parsed = strtod(buf, NULL);
    }
    if is_negative { parsed = -parsed; }
    // ECMA-262 §25.5.1 step 9: "-0" parses to -0 (preserves sign).
    // int32 representation can't carry the negative-zero bit, so we
    // route it through double when the input was a literal `-0`.
    if is_negative && parsed == 0.0 { return zjs_double(-0.0); }
    // Prefer int32 representation if it fits.
    let as_int = (i32)parsed;
    if (f64)as_int == parsed { return zjs_int32(as_int); }
    return zjs_double(parsed);
}

// Delete holder[key] for a JSON reviver. The holder is always a value
// produced by JSON.parse, so it's a plain object or an array — handle
// both (array slot → hole, object slot → deleted sentinel). JSON-parsed
// properties are all configurable, so no attr check is needed.
fn json_reviver_delete(ctx: ZjsContext*, holder: ZjsValue, key: ZjsValue) -> void {
    if zjs_is_array(holder) != 0 {
        let a = zjs_as_array(holder);
        let idx = zjs_to_array_index(key);
        if idx >= 0 && (u32)idx < a.length { a.elements[(u32)idx] = zjs_deleted(); }
        return;
    }
    if zjs_is_object(holder) != 0 {
        let o = zjs_as_object(holder);
        let key_str = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
        let name = zjs_as_string(key_str);
        let slot = class_find_slot(o.cls, name);
        // [[Delete]] returns false (no-op, no throw) for a non-configurable
        // property — InternalizeJSONProperty's `Perform ? Delete` discards
        // that false, so the property survives.
        if slot >= 0 {
            let attrs = object_get_attrs(o, (u32)slot);
            if (attrs & PROP_CONFIGURABLE) != 0 { o.slots[(u32)slot] = zjs_deleted(); }
        }
    }
}

// CreateDataProperty(holder, key, *) would fail (return false, no throw)
// when an existing own property is non-configurable — the full data
// descriptor it defines (configurable: true) can't redefine it. Detect
// that so the reviver leaves such a property untouched. Array elements
// carry no per-element attrs in zjs, so they're always configurable.
fn json_prop_non_configurable(ctx: ZjsContext*, holder: ZjsValue, key: ZjsValue) -> bool {
    if zjs_is_object(holder) == 0 { return false; }
    let o = zjs_as_object(holder);
    let key_str = if zjs_is_string(key) != 0 { key } else { zjs_to_string(ctx, key) };
    let name = zjs_as_string(key_str);
    let slot = class_find_slot(o.cls, name);
    if slot < 0 { return false; }
    let attrs = object_get_attrs(o, (u32)slot);
    return (attrs & PROP_CONFIGURABLE) == 0;
}

// ECMA-262 25.5.1.1 InternalizeJSONProperty. Recursive post-order walk:
// recurse into each child (arrays by index, objects by own enumerable
// key, snapshotted), replacing the child with the reviver's result (or
// deleting it when the result is undefined), then call
// reviver(key, value) with `this` = holder and return its result.
fn json_internalize(ctx: ZjsContext*, holder: ZjsValue, key: ZjsValue, reviver: ZjsValue) -> ZjsValue {
    let val = property_get(ctx, holder, key);
    if ctx.pending_throw_active { return zjs_undefined(); }
    ctx_push_temp_root(ctx, val);
    defer ctx_pop_temp_root(ctx);

    if value_is_js_object(val) {
        // Own enumerable keys (arrays → present index strings, objects →
        // own enumerable string keys), snapshotted before the walk.
        let one: ZjsValue[1]; one[0] = val;
        let onep: ZjsValue* = NULL; raw { onep = &one[0]; }
        let keys_v = object_keys_impl(ctx, onep, 1, true);
        if ctx.pending_throw_active { return zjs_undefined(); }
        ctx_push_temp_root(ctx, keys_v);
        defer ctx_pop_temp_root(ctx);
        let ka = zjs_as_array(keys_v);
        let n = ka.length;
        let i: u32 = 0;
        while i < n {
            let k = ka.elements[i];
            let elem = json_internalize(ctx, val, k, reviver);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if zjs_is_undefined(elem) != 0 {
                json_reviver_delete(ctx, val, k);
            } else if !json_prop_non_configurable(ctx, val, k) {
                property_set(ctx, val, k, elem);
                if ctx.pending_throw_active { return zjs_undefined(); }
            }
            i = i + 1;
        }
    }

    let cargs: ZjsValue[2]; cargs[0] = key; cargs[1] = val;
    let cp: ZjsValue* = NULL; raw { cp = &cargs[0]; }
    return zjs_call_value_with_this(ctx, reviver, holder, cp, 2);
}

fn host_json_parse(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // `JSON.parse()` with no args parses the literal string "undefined"
    // which is invalid JSON and throws — covered by the fail path below.
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_string(v) == 0 {
        v = zjs_to_string(ctx, v);
        // If toString/valueOf threw, propagate that — don't mask it
        // with our own "Invalid JSON" SyntaxError.
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    let s = zjs_as_string(v);
    let p: JsonParser;
    p.src = s.data; p.len = s.length; p.pos = 0; p.fail = false;
    let result = jp_parse_value(ctx, &p);
    if !p.fail {
        jp_skip_ws(&p);
        if p.pos != s.length { p.fail = true; }
    }
    if p.fail {
        let err = build_syntax_error(ctx, (char*)"Invalid JSON");
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    // ECMA-262 25.5.1 JSON.parse step 7+: if reviver is callable, wrap the
    // result in a holder { "": result } and InternalizeJSONProperty it.
    if argc >= 2 && zjs_is_callable(args[1]) != 0 {
        ctx_push_temp_root(ctx, result);
        let holder = ctx_new_object(ctx);
        ctx_push_temp_root(ctx, holder);
        let empty_key = ctx_intern_string(ctx, (char*)"", 0);
        property_set(ctx, holder, empty_key, result);
        let revived = json_internalize(ctx, holder, empty_key, args[1]);
        ctx_pop_temp_root(ctx);
        ctx_pop_temp_root(ctx);
        if ctx.pending_throw_active { return zjs_undefined(); }
        return revived;
    }
    return result;
}

// =====================================================================
// RegExp runtime (Phase 3.11)
//
// Compilation is delegated to libregexp (QuickJS-NG), vendored under
// src/third-party/qjs-regex/. We hold pattern + flags + a lazily-
// compiled bytecode buffer (`r.preg`). JS regex syntax is parsed
// natively by lre_compile — lookahead, lookbehind, non-greedy
// quantifiers, named groups, \p{...} all work. Three host callbacks
// (lre_realloc, lre_check_stack_overflow, lre_check_timeout) live in
// src/platform/qjs_regex_shim.c.
// =====================================================================

fn regexp_free_void(p: void*) -> void {
    let r: ZjsRegExp* = NULL;
    raw { r = (ZjsRegExp*)p; }
    if r == NULL { return; }
    if r.preg != NULL {
        /* libregexp's bytecode buffer was allocated through lre_realloc;
         * free via the same callback with size=0. */
        raw { lre_realloc(NULL, r->preg, 0); }
        r.preg = NULL;
    }
    dealloc(r);
}

// Run libregexp against a buffer slice; convert byte-pointer pairs
// back into rm_so/rm_eo offsets so call sites (replace, match, search)
// don't need to know the underlying engine. `pmatch` must be at least
// `total_groups` entries. Returns 0 on match, non-zero (typically 1)
// on no-match — matches the regexec-style convention the rest of
// context.zc was written against.
fn lre_run(preg: void*, hay: char*, hay_len: u32, scan_off: u32,
           pmatch: ZRegMatch*, total_groups: u32) -> int {
    let rc: int = -1;
    raw {
        /* libregexp's capture array is uint8_t* pairs — start/end pointers
         * INTO cbuf. CAPTURE_COUNT_MAX is 255 in libregexp.h, plenty for
         * the regex sizes we ever compile. Allocate inline up to a small
         * static cap (32 groups = 64 ptrs); fall back to malloc if a
         * pattern exceeds that. (Practical npm regexes top out around
         * 8-10 groups.) */
        const int kStaticCap = 32;
        uint8_t* small_caps[64];
        uint8_t** caps = small_caps;
        uint8_t** heap_caps = NULL;
        int n_caps = (int)total_groups;
        if (n_caps > kStaticCap) {
            heap_caps = (uint8_t**)malloc(sizeof(uint8_t*) * 2 * n_caps);
            if (!heap_caps) { rc = LRE_RET_MEMORY_ERROR; goto done; }
            caps = heap_caps;
        }
        int ret = lre_exec(caps, (const uint8_t*)preg,
                           (const uint8_t*)hay, (int)scan_off, (int)hay_len,
                           0 /* cbuf_type = 8-bit */, NULL);
        if (ret == 1) {
            /* Match — fill pmatch with byte offsets. */
            for (int gi = 0; gi < n_caps; gi++) {
                uint8_t* gs = caps[2 * gi];
                uint8_t* ge = caps[2 * gi + 1];
                if (gs == NULL || ge == NULL) {
                    pmatch[gi].rm_so = -1;
                    pmatch[gi].rm_eo = -1;
                } else {
                    pmatch[gi].rm_so = (int)(gs - (const uint8_t*)hay);
                    pmatch[gi].rm_eo = (int)(ge - (const uint8_t*)hay);
                }
            }
            rc = 0;
        } else {
            /* No match (ret == 0) or error (ret < 0). Treat both as
             * "not found" for the caller — failure cases at this level
             * mean the engine ran out of memory/time, which we can't
             * meaningfully recover. */
            rc = 1;
        }
        if (heap_caps) free(heap_caps);
done:
        (void)0;
    }
    return rc;
}

// Compile-on-demand. Returns true if the bytecode is ready to use;
// false if compilation failed (caller falls back to "no match").
// Translates our REGEX_FLAG_* bits (which align with LRE_FLAG_* by
// design) and hands the JS regex source to libregexp's native parser
// — no POSIX rewrite step. The bytecode buffer was allocated through
// lre_realloc; regexp_free_void frees it the same way.
fn regex_ensure_compiled(r: ZjsRegExp*) -> bool {
    if r.compiled { return r.preg != NULL; }
    r.compiled = true;
    if r.source == NULL { return false; }
    let bc: void* = NULL;
    raw {
        char err_msg[64];
        int bc_len = 0;
        /* REGEX_FLAG_* bits 0-6 mirror LRE_FLAG_* (verified in #294).
         * Mask off any internal flags that don't have an lre equivalent. */
        int lre_flags = (int)(r->flags & 0x7f);
        bc = lre_compile(&bc_len, err_msg, (int)sizeof(err_msg),
                         (const char*)r->source->data, r->source->length,
                         lre_flags, NULL);
    }
    if bc == NULL {
        r.preg = NULL;
        return false;
    }
    r.preg = bc;
    return true;
}

// new RegExp(pattern, flags) — constructs a fresh RegExp from
// string arguments. If `pattern` is itself a RegExp, clone its
// source + (overridden) flags.
fn host_regexp_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let pattern_v: ZjsValue = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"", 0) };
    let flags_v:   ZjsValue = if argc >= 2 { args[1] } else { ctx_intern_string(ctx, (char*)"", 0) };
    if zjs_is_regexp(pattern_v) != 0 {
        let src = zjs_as_regexp(pattern_v);
        pattern_v = if src.source != NULL { zjs_cell_from_ptr((void*)src.source) } else { ctx_intern_string(ctx, (char*)"", 0) };
        if argc < 2 {
            flags_v = if src.flags_str != NULL { zjs_cell_from_ptr((void*)src.flags_str) } else { ctx_intern_string(ctx, (char*)"", 0) };
        }
    } else if zjs_is_string(pattern_v) == 0 {
        pattern_v = zjs_to_string(ctx, pattern_v);
    }
    if zjs_is_string(flags_v) == 0 { flags_v = zjs_to_string(ctx, flags_v); }
    let re_v = ctx_new_regexp(ctx, pattern_v, flags_v);
    let nt_proto_r = subclass_proto_for(ctx, ctx.regexp_proto);
    if nt_proto_r != NULL {
        let re = zjs_as_regexp(re_v);
        re.proto = nt_proto_r;
    }
    return re_v;
}

// RegExp.prototype.exec(str): coerce `str`, run the regex, build a
// match array shaped per ECMA-262 §22.2.7.2:
//   result[0]       = full match
//   result[1..]     = capture groups (or undefined if not matched)
//   result.index    = position of full match in the input
//   result.input    = the original string
//   result.groups   = undefined (we don't have named groups yet)
// Returns null on no match. Honors lastIndex advance for g/y.
fn host_regexp_exec(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_regexp(this_val) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"RegExp.prototype.exec called on non-RegExp", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let r = zjs_as_regexp(this_val);
    if !regex_ensure_compiled(r) { return zjs_null(); }
    let arg_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    if zjs_is_string(arg_v) == 0 { arg_v = zjs_to_string(ctx, arg_v); }
    let s = zjs_as_string(arg_v);
    let stateful = (r.flags & (REGEX_FLAG_GLOBAL | REGEX_FLAG_STICKY)) != 0;
    let start_idx: u32 = if stateful { r.last_index } else { 0 };
    if start_idx > s.length {
        if stateful { r.last_index = 0; }
        return zjs_null();
    }
    let preg = r.preg;
    let sdata = s.data;
    let hay_n = s.length;
    // libregexp's bytecode header carries the capture count (group 0 +
    // each (...) group). Sized so pmatch_buf is full-match + N captures.
    let total_groups: u32 = 0;
    raw { total_groups = (uint32_t)lre_get_capture_count((const uint8_t*)preg); }
    let pmatch_buf = alloc_n<ZRegMatch>((usize)total_groups);
    let rc: int = -1;
    raw {
        rc = lre_run(preg, sdata, hay_n, start_idx, pmatch_buf, total_groups);
    }
    if rc != 0 {
        dealloc(pmatch_buf);
        if stateful { r.last_index = 0; }
        return zjs_null();
    }
    // lre_run returns absolute byte offsets into sdata.
    let abs_mstart_i32 = pmatch_buf[0].rm_so;
    let abs_mend_i32   = pmatch_buf[0].rm_eo;
    if (r.flags & REGEX_FLAG_STICKY) != 0 && (u32)abs_mstart_i32 != start_idx {
        dealloc(pmatch_buf);
        r.last_index = 0;
        return zjs_null();
    }
    let abs_mstart: u32 = (u32)abs_mstart_i32;
    let abs_mend:   u32 = (u32)abs_mend_i32;
    if stateful { r.last_index = abs_mend; }

    // Build the result array: [fullMatch, group1, group2, ...].
    let result_v = ctx_new_array(ctx, total_groups);
    ctx_push_temp_root(ctx, result_v);
    defer ctx_pop_temp_root(ctx);
    let result = zjs_as_array(result_v);
    let i: u32 = 0;
    while i < total_groups {
        let gs = pmatch_buf[i].rm_so;
        let ge = pmatch_buf[i].rm_eo;
        if gs < 0 {
            // Group didn't participate in the match.
            result.elements[i] = zjs_undefined();
        } else {
            // lre_run returns absolute offsets into sdata.
            let gabs_s = (u32)gs;
            let gabs_e = (u32)ge;
            let glen = gabs_e - gabs_s;
            let slice = ctx_intern_string(ctx, sdata + gabs_s, glen);
            result.elements[i] = slice;
        }
        i = i + 1;
    }
    result.length = total_groups;
    dealloc(pmatch_buf);

    // .index, .input, .groups via the expando bag.
    if result.props == NULL {
        let pv = ctx_new_object(ctx);
        result.props = zjs_as_object(pv);
    }
    object_set(ctx, result.props, ctx_intern_atom(ctx, (char*)"index", 5), zjs_int32((i32)abs_mstart));
    object_set(ctx, result.props, ctx_intern_atom(ctx, (char*)"input", 5), arg_v);
    object_set(ctx, result.props, ctx_intern_atom(ctx, (char*)"groups", 6), zjs_undefined());
    return result_v;
}

// RegExp.prototype.test(str): coerce `str`, run the regex, advance
// .lastIndex for `g`/`y` patterns, return bool.
fn host_regexp_test(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_regexp(this_val) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"RegExp.prototype.test called on non-RegExp", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let r = zjs_as_regexp(this_val);
    if !regex_ensure_compiled(r) { return zjs_bool(0); }
    // Coerce arg to string.
    let arg_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    if zjs_is_string(arg_v) == 0 { arg_v = zjs_to_string(ctx, arg_v); }
    let s = zjs_as_string(arg_v);
    let stateful = (r.flags & (REGEX_FLAG_GLOBAL | REGEX_FLAG_STICKY)) != 0;
    let start_idx: u32 = if stateful { r.last_index } else { 0 };
    if start_idx > s.length {
        if stateful { r.last_index = 0; }
        return zjs_bool(0);
    }
    // Single capture-group buffer tells us where the match lands; we
    // ignore the captures here (.exec / .match handle them).
    let preg = r.preg;
    let sdata = s.data;
    let hay_n = s.length;
    let pmatch: ZRegMatch[1];
    let rc: int = -1;
    raw {
        rc = lre_run(preg, sdata, hay_n, start_idx, pmatch, 1);
    }
    if rc != 0 {
        if stateful { r.last_index = 0; }
        return zjs_bool(0);
    }
    // lre_run returns absolute byte offsets into sdata.
    let mstart_abs = (u32)pmatch[0].rm_so;
    let mend_abs   = (u32)pmatch[0].rm_eo;
    if (r.flags & REGEX_FLAG_STICKY) != 0 && mstart_abs != start_idx {
        // sticky requires the match begin exactly at lastIndex.
        r.last_index = 0;
        return zjs_bool(0);
    }
    if stateful {
        r.last_index = mend_abs;
    }
    return zjs_bool(1);
}

fn ctx_new_regexp(ctx: ZjsContext*, pattern_v: ZjsValue, flags_v: ZjsValue) -> ZjsValue {
    let r = zjs_regexp_new();
    r.source    = if zjs_is_string(pattern_v) != 0 { zjs_as_string(pattern_v) } else { NULL };
    r.flags_str = if zjs_is_string(flags_v)   != 0 { zjs_as_string(flags_v)   } else { NULL };
    // Parse the flag letters into a bitset.
    if r.flags_str != NULL {
        let fd = r.flags_str.data;
        let fn_len = r.flags_str.length;
        let i: u32 = 0;
        while i < fn_len {
            let c = fd[i];
            if c == (char)'g' { r.flags = r.flags | REGEX_FLAG_GLOBAL; }
            else if c == (char)'i' { r.flags = r.flags | REGEX_FLAG_IGNORE_CASE; }
            else if c == (char)'m' { r.flags = r.flags | REGEX_FLAG_MULTILINE; }
            else if c == (char)'s' { r.flags = r.flags | REGEX_FLAG_DOTALL; }
            else if c == (char)'u' { r.flags = r.flags | REGEX_FLAG_UNICODE; }
            else if c == (char)'y' { r.flags = r.flags | REGEX_FLAG_STICKY; }
            else if c == (char)'d' { r.flags = r.flags | REGEX_FLAG_HAS_INDICES; }
            i = i + 1;
        }
    }
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

// =====================================================================
// Promise runtime (Phase 3.10)
//
// ECMA-262 §27.2. Minimal implementation:
//   - Promise constructor with executor function
//   - Promise.resolve / Promise.reject statics
//   - .then(onFulfilled, onRejected) / .catch / .finally
//   - Microtask queue drained at the end of each zjs_eval entry
//   - Thenable assimilation when handler returns a Promise
//
// Tests-262 still skips a bunch of Promise.* statics (.all, .race,
// .allSettled, .any) and the Symbol.toStringTag tag — those are
// follow-ups.
// =====================================================================

fn promise_attach_reaction(ctx: ZjsContext*, p: ZjsPromise*,
                           on_fulfilled: ZjsValue, on_rejected: ZjsValue,
                           result_promise: ZjsValue) -> void {
    if p.reaction_count + 3 > p.reaction_cap {
        let new_cap: u32 = if p.reaction_cap == 0 { 6 } else { p.reaction_cap * 2 };
        p.reactions = realloc_n<ZjsValue>(p.reactions, (usize)p.reaction_cap, (usize)new_cap);
        p.reaction_cap = new_cap;
    }
    p.reactions[p.reaction_count] = on_fulfilled;
    p.reactions[p.reaction_count + 1] = on_rejected;
    p.reactions[p.reaction_count + 2] = result_promise;
    p.reaction_count = p.reaction_count + 3;
}

fn microtask_enqueue(ctx: ZjsContext*,
                     handler: ZjsValue, arg: ZjsValue,
                     result_promise: ZjsValue, is_fulfilled: bool) -> void {
    let slots_needed = ctx.microtask_count * 4 + 4;
    if slots_needed > ctx.microtask_cap {
        let new_cap: u32 = if ctx.microtask_cap == 0 { 16 } else { ctx.microtask_cap * 2 };
        while new_cap < slots_needed { new_cap = new_cap * 2; }
        ctx.microtask_queue = realloc_n<ZjsValue>(ctx.microtask_queue, (usize)ctx.microtask_cap, (usize)new_cap);
        ctx.microtask_cap = new_cap;
    }
    let base = ctx.microtask_count * 4;
    ctx.microtask_queue[base]     = handler;
    ctx.microtask_queue[base + 1] = arg;
    ctx.microtask_queue[base + 2] = result_promise;
    ctx.microtask_queue[base + 3] = zjs_bool(if is_fulfilled { 1 } else { 0 });
    ctx.microtask_count = ctx.microtask_count + 1;
}

fn promise_settle(ctx: ZjsContext*, pv: ZjsValue, value: ZjsValue, fulfilled: bool) -> void {
    if zjs_is_promise(pv) == 0 { return; }
    let p = zjs_as_promise(pv);
    if p.state != PROMISE_PENDING { return; }
    p.state = if fulfilled { PROMISE_FULFILLED } else { PROMISE_REJECTED };
    p.value = value;
    gc_write_barrier(ctx, (void*)p, value);
    // Fire all attached reactions. Each entry is 3 slots
    // (onFulfilled, onRejected, resultPromise).
    let i: u32 = 0;
    while i < p.reaction_count {
        let on_f = p.reactions[i];
        let on_r = p.reactions[i + 1];
        let rp   = p.reactions[i + 2];
        let handler = if fulfilled { on_f } else { on_r };
        microtask_enqueue(ctx, handler, value, rp, fulfilled);
        i = i + 3;
    }
    // Drop the reactions buffer — they've all been queued.
    p.reaction_count = 0;
}

// ECMA-262 ResolvePromise semantics: if `value` is itself a promise,
// adopt its eventual state (attach a then-style hook); otherwise
// settle directly with the value.
// ECMA-262 NewPromiseResolveThenableJob (27.2.2.2): a microtask that
// calls `then.call(thenable, resolve, reject)` where resolve/reject
// settle the adopting promise. The job's bound state holds the thenable,
// its `then`, and the two resolving functions (#331). If the `then` call
// throws, reject with the thrown value (the resolving functions' own
// already-settled guard makes a late reject a no-op if then already
// resolved).
fn host_promise_thenable_job(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let st_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL; raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        st_v = hf.bound;
    }
    if zjs_is_object(st_v) == 0 { return zjs_undefined(); }
    let st = zjs_as_object(st_v);
    let thenable = object_get(st, ctx_intern_atom(ctx, (char*)"__tj_obj", 8));
    let then_fn  = object_get(st, ctx_intern_atom(ctx, (char*)"__tj_then", 9));
    let res_fn   = object_get(st, ctx_intern_atom(ctx, (char*)"__tj_res", 8));
    let rej_fn   = object_get(st, ctx_intern_atom(ctx, (char*)"__tj_rej", 8));
    let argbuf: ZjsValue[2]; argbuf[0] = res_fn; argbuf[1] = rej_fn;
    let argp: ZjsValue* = NULL; raw { argp = &argbuf[0]; }
    let saved_pt = ctx.pending_throw_active;
    let saved_pv = ctx.pending_throw_value;
    ctx.pending_throw_active = false;
    ctx.pending_throw_value = zjs_undefined();
    raw { (void)zjs_call_value_with_this(ctx, then_fn, thenable, argp, 2); }
    if ctx.pending_throw_active {
        let thrown = ctx.pending_throw_value;
        ctx.pending_throw_active = saved_pt;
        ctx.pending_throw_value = saved_pv;
        let rb: ZjsValue[1]; rb[0] = thrown;
        let rp: ZjsValue* = NULL; raw { rp = &rb[0]; }
        raw { (void)zjs_call_value_with_this(ctx, rej_fn, zjs_undefined(), rp, 1); }
    } else {
        ctx.pending_throw_active = saved_pt;
        ctx.pending_throw_value = saved_pv;
    }
    return zjs_undefined();
}

fn promise_resolve_with(ctx: ZjsContext*, pv: ZjsValue, value: ZjsValue) -> void {
    if zjs_is_promise(value) != 0 {
        // Identity self-reference is a TypeError per spec.
        if zjs_cell_as_ptr(value) == zjs_cell_as_ptr(pv) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Chaining cycle detected", 23);
            promise_settle(ctx, pv, err, false);
            return;
        }
        let inner = zjs_as_promise(value);
        if inner.state == PROMISE_FULFILLED {
            promise_settle(ctx, pv, inner.value, true);
        } else if inner.state == PROMISE_REJECTED {
            promise_settle(ctx, pv, inner.value, false);
        } else {
            // Pending — attach an adopt-reaction that settles pv when inner settles.
            // We piggy-back on the standard reaction shape: a "passthrough"
            // microtask whose handler is undefined and whose result_promise
            // is pv. Both fulfilled and rejected paths feed back into pv.
            promise_attach_reaction(ctx, inner, zjs_undefined(), zjs_undefined(), pv);
        }
        return;
    }
    // Thenable adoption (ECMA-262 27.2.1.3.2 step 8+): a non-promise
    // object with a callable `then` is NOT fulfilled-with directly —
    // `then` is read (a throw rejects), and if callable a thenable-
    // resolution job is enqueued. #331. Without this, Promise.resolve(
    // thenable), new Promise(r => r(thenable)), and every combinator
    // treated thenables as plain values.
    if value_is_js_object(value) {
        let then_v = property_get(ctx, value, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"then", 4)));
        if ctx.pending_throw_active {
            let err = consume_pending_throw(ctx);
            promise_settle(ctx, pv, err, false);
            return;
        }
        if zjs_is_callable(then_v) != 0 {
            let res_ptr: void* = NULL; raw { res_ptr = (void*)host_promise_resolve_fn; }
            let rej_ptr: void* = NULL; raw { rej_ptr = (void*)host_promise_reject_fn; }
            let res_fn = ctx_make_host_function(ctx, (char*)"", res_ptr);
            zjs_as_host_function(res_fn).bound = pv;
            let rej_fn = ctx_make_host_function(ctx, (char*)"", rej_ptr);
            zjs_as_host_function(rej_fn).bound = pv;
            let st_v = ctx_new_object(ctx);
            let st = zjs_as_object(st_v);
            object_set(ctx, st, ctx_intern_atom(ctx, (char*)"__tj_obj", 8), value);
            object_set(ctx, st, ctx_intern_atom(ctx, (char*)"__tj_then", 9), then_v);
            object_set(ctx, st, ctx_intern_atom(ctx, (char*)"__tj_res", 8), res_fn);
            object_set(ctx, st, ctx_intern_atom(ctx, (char*)"__tj_rej", 8), rej_fn);
            let job_ptr: void* = NULL; raw { job_ptr = (void*)host_promise_thenable_job; }
            let job = ctx_make_host_function(ctx, (char*)"", job_ptr);
            zjs_as_host_function(job).bound = st_v;
            microtask_enqueue(ctx, job, zjs_undefined(), zjs_undefined(), true);
            return;
        }
    }
    promise_settle(ctx, pv, value, true);
}

// Drain the microtask queue. Called at the end of zjs_eval (after the
// main script has run). Microtasks may enqueue more microtasks; keep
// draining until empty. Bounded by a safety limit to prevent runaway
// loops in misbehaving programs.
def MICROTASK_DRAIN_LIMIT: u32 = 1000000;

fn drain_microtasks(ctx: ZjsContext*) -> void {
    let safety: u32 = 0;
    while ctx.microtask_count > 0 && safety < MICROTASK_DRAIN_LIMIT {
        // Pop the first microtask: copy fields into locals, then shift.
        // Could be O(n^2) for many microtasks; acceptable for now.
        let handler = ctx.microtask_queue[0];
        let arg     = ctx.microtask_queue[1];
        let rp      = ctx.microtask_queue[2];
        let is_full = zjs_as_bool(ctx.microtask_queue[3]) != 0;
        // Shift remaining.
        let n = ctx.microtask_count - 1;
        let i: u32 = 0;
        while i < n * 4 {
            ctx.microtask_queue[i] = ctx.microtask_queue[i + 4];
            i = i + 1;
        }
        ctx.microtask_count = n;

        let callable: bool = zjs_is_function(handler) != 0
            || zjs_is_closure(handler) != 0
            || zjs_is_host_function(handler) != 0;
        if !callable {
            // Passthrough: propagate value/reason to result_promise.
            if zjs_is_promise(rp) != 0 {
                if is_full { promise_resolve_with(ctx, rp, arg); }
                else       { promise_settle(ctx, rp, arg, false); }
            }
        } else {
            // Call handler(arg). On success, resolve rp with the
            // return value (which itself may be a thenable → adoption).
            // On throw, reject rp with the thrown value.
            let arg_buf: ZjsValue[1];
            arg_buf[0] = arg;
            let argp: ZjsValue* = NULL;
            raw { argp = &arg_buf[0]; }
            // zjs_call_value_with_this signals a JS-side throw via
            // pending_throw_active, not had_error. Save/restore the
            // pending-throw channel so an in-flight throw from the
            // surrounding interpret() (if any) survives this nested
            // synchronous call and isn't lost.
            let saved_pt = ctx.pending_throw_active;
            let saved_pv = ctx.pending_throw_value;
            ctx.pending_throw_active = false;
            ctx.pending_throw_value = zjs_undefined();
            let r: ZjsValue = zjs_undefined();
            raw { r = zjs_call_value_with_this(ctx, handler, zjs_undefined(), argp, 1); }
            if ctx.pending_throw_active {
                let thrown = ctx.pending_throw_value;
                ctx.pending_throw_active = saved_pt;
                ctx.pending_throw_value = saved_pv;
                if zjs_is_promise(rp) != 0 {
                    promise_settle(ctx, rp, thrown, false);
                }
            } else {
                ctx.pending_throw_active = saved_pt;
                ctx.pending_throw_value = saved_pv;
                if zjs_is_promise(rp) != 0 {
                    promise_resolve_with(ctx, rp, r);
                }
            }
        }
        safety = safety + 1;
    }
}

// --- Host fns: Promise.resolve / Promise.reject helpers --------------

// Resume handlers wired into a pending awaited Promise's reactions.
// Both read the ZjsAsyncCont via .bound and re-enter the interpreter
// at the saved ip with the resolved value in the await's dst register
// (fulfilled path) or the rejection threaded through the throw channel
// (rejected path).
// Generator iterator methods. Each reads the iterator from
// ctx.host_this and routes through interpret_resume_generator. The
// return value of iter.next() is the body's iter-result (built by
// Op::Yield or Op::Return).
fn host_generator_next(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_generator(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Generator.prototype.next called on non-generator", 49);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let g = zjs_as_generator(this_v);
    if g.state == GEN_COMPLETED {
        let obj_v = ctx_new_object(ctx);
        let obj = zjs_as_object(obj_v);
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"value", 5), zjs_undefined());
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"done", 4), zjs_bool(1));
        if g.is_async {
            let p = zjs_promise_new();
            ctx_register_cell(ctx, (void*)p);
            let pv = zjs_cell_from_ptr((void*)p);
            promise_resolve_with(ctx, pv, obj_v);
            return pv;
        }
        return obj_v;
    }
    if g.state == GEN_RUNNING {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Generator is already running", 28);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    // For async generators: allocate the result promise up front, so
    // when the body suspends on an await (state -> GEN_AWAITING) the
    // resume host-fns have something to settle later. Stash on the
    // generator for the resume path to find.
    let result_promise_v: ZjsValue = zjs_undefined();
    if g.is_async {
        let rp = zjs_promise_new();
        ctx_register_cell(ctx, (void*)rp);
        result_promise_v = zjs_cell_from_ptr((void*)rp);
        g.pending_next_promise = result_promise_v;
    }
    let r: ZjsValue = zjs_undefined();
    let threw: bool = false;
    raw {
        extern InterpretResult interpret_resume_generator(ZjsContext* ctx, ZjsGenerator* gen, ZjsValue resume_value, bool is_throw);
        InterpretResult ir = interpret_resume_generator(ctx, g, arg, 0);
        r = ir.value;
        threw = ir.is_throw;
    }
    // Body suspended on a pending await — host returns the stashed
    // promise; the resume callbacks will eventually settle it (either
    // with a yielded iter-result or after another await).
    if g.is_async && g.state == GEN_AWAITING {
        return result_promise_v;
    }
    if threw {
        g.state = GEN_COMPLETED;
        if g.is_async {
            promise_settle(ctx, result_promise_v, r, false);
            g.pending_next_promise = zjs_undefined();
            return result_promise_v;
        }
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = r;
        return zjs_undefined();
    }
    if g.is_async {
        promise_resolve_with(ctx, result_promise_v, r);
        g.pending_next_promise = zjs_undefined();
        return result_promise_v;
    }
    return r;
}

// Resume an async generator that suspended on `await pendingPromise`.
// The bound .bound on the host fn is the generator cell; arg[0] is the
// settled value (or rejection reason). Run more body; either yield/
// return (settle pending_next_promise) or await again (leave pending).
fn host_async_gen_resume_common(ctx: ZjsContext*, args: ZjsValue*, argc: u32, is_throw: bool) -> ZjsValue {
    // ctx.current_host_fn points at the currently-invoked host
    // function; we stashed the generator on its .bound slot when
    // Op::Await suspended.
    let gen_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        gen_v = hf.bound;
    }
    if zjs_is_generator(gen_v) == 0 { return zjs_undefined(); }
    let g = zjs_as_generator(gen_v);
    if g.state != GEN_AWAITING { return zjs_undefined(); }
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    let r: ZjsValue = zjs_undefined();
    let threw: bool = false;
    raw {
        extern InterpretResult interpret_resume_generator(ZjsContext* ctx, ZjsGenerator* gen, ZjsValue resume_value, bool is_throw);
        InterpretResult ir = interpret_resume_generator(ctx, g, value, is_throw ? 1 : 0);
        r = ir.value;
        threw = ir.is_throw;
    }
    // Generator suspended again on another await — leave the stashed
    // pending promise unresolved; the next reaction will settle it.
    if g.state == GEN_AWAITING { return zjs_undefined(); }
    let pv = g.pending_next_promise;
    if zjs_is_promise(pv) == 0 { return zjs_undefined(); }
    g.pending_next_promise = zjs_undefined();
    if threw {
        g.state = GEN_COMPLETED;
        promise_settle(ctx, pv, r, false);
        return zjs_undefined();
    }
    // r is the iter-result {value, done}; resolve the next() promise.
    promise_resolve_with(ctx, pv, r);
    return zjs_undefined();
}

fn host_async_gen_resume_fulfilled(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_async_gen_resume_common(ctx, args, argc, false);
}
fn host_async_gen_resume_rejected(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_async_gen_resume_common(ctx, args, argc, true);
}

// `iter[Symbol.iterator]()` returns the iterator itself. Spec sugar
// for generators; we expose it under both the spec key (Symbol-
// derived) and a string-key stand-in until real Symbols land.
fn host_generator_self_iter(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return ctx.host_this;
}

// Generator.prototype.return(value) — terminates the iterator and
// returns { value, done: true }. Doesn't resume the body (a real
// spec impl would feed it through try/finally; for now we just
// complete).
fn host_generator_return(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_generator(this_v) == 0 {
        return zjs_undefined();
    }
    let g = zjs_as_generator(this_v);
    g.state = GEN_COMPLETED;
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"value", 5), value);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"done", 4), zjs_bool(1));
    return obj_v;
}

fn host_generator_throw(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_generator(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Generator.prototype.throw called on non-generator", 50);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let g = zjs_as_generator(this_v);
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    if g.state == GEN_COMPLETED || g.state == GEN_INITIAL {
        // No frame to throw into — propagate immediately. Initial-
        // state .throw also marks the iterator completed.
        g.state = GEN_COMPLETED;
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = reason;
        return zjs_undefined();
    }
    let r: ZjsValue = zjs_undefined();
    let threw: bool = false;
    raw {
        extern InterpretResult interpret_resume_generator(ZjsContext* ctx, ZjsGenerator* gen, ZjsValue resume_value, bool is_throw);
        InterpretResult ir = interpret_resume_generator(ctx, g, reason, 1);
        r = ir.value;
        threw = ir.is_throw;
    }
    if threw {
        g.state = GEN_COMPLETED;
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = r;
        return zjs_undefined();
    }
    return r;
}

// =====================================================================
// Map host functions (2026-05-16). Storage = linear ZjsMapEntry array
// with tombstones; lookups are O(n). Spec semantics: insertion-order
// iteration, SameValueZero key comparison, .size excludes tombstones.
// =====================================================================

fn map_find_slot(m: ZjsMap*, key: ZjsValue) -> i32 {
    let i: u32 = 0;
    while i < m.count {
        let e = m.entries + i;
        if !e.deleted && zjs_same_value_zero(e.key, key) != 0 {
            return (i32)i;
        }
        i = i + 1;
    }
    return -1;
}

fn map_ensure_cap(m: ZjsMap*, want: u32) -> void {
    if want <= m.cap { return; }
    let new_cap: u32 = if m.cap == 0 { 8 } else { m.cap * 2 };
    while new_cap < want { new_cap = new_cap * 2; }
    m.entries = realloc_n<ZjsMapEntry>(m.entries, (usize)m.cap, (usize)new_cap);
    m.cap = new_cap;
}

// ECMA-262 CanonicalizeKeyedCollectionKey — folds -0 to +0 so the
// observable key in Map/Set ops (forEach, iterator value, callback
// args, getOrInsertComputed's callback) matches what the spec says.
// Anything else is returned unchanged.
fn canonicalize_collection_key(key: ZjsValue) -> ZjsValue {
    if zjs_is_double(key) != 0 {
        let d = zjs_as_double(key);
        let is_neg_zero: int = 0;
        raw { is_neg_zero = (d == 0.0 && signbit(d)) ? 1 : 0; }
        if is_neg_zero != 0 { return zjs_double(0.0); }
    }
    return key;
}

fn map_set_entry(m: ZjsMap*, key: ZjsValue, val: ZjsValue) -> void {
    let ck = canonicalize_collection_key(key);
    let slot = map_find_slot(m, ck);
    if slot >= 0 {
        m.entries[(u32)slot].value = val;
        gc_barrier((void*)m, val);
        return;
    }
    map_ensure_cap(m, m.count + 1);
    m.entries[m.count] = ZjsMapEntry{ key: ck, value: val, deleted: false };
    gc_barrier((void*)m, ck);
    gc_barrier((void*)m, val);
    m.count = m.count + 1;
    m.size = m.size + 1;
}

fn map_require_this(ctx: ZjsContext*) -> ZjsMap* {
    let this_v = ctx.host_this;
    if zjs_is_map(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Map method called on non-Map", 28);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return NULL;
    }
    return zjs_as_map(this_v);
}

fn host_map_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = zjs_map_new();
    ctx_register_cell(ctx, (void*)m);
    let nt_proto_m = subclass_proto_for(ctx, ctx.map_proto);
    if nt_proto_m != NULL { m.proto = nt_proto_m; }
    let m_v = zjs_cell_from_ptr((void*)m);
    // Optional iterable arg — each entry must itself be an iterable of
    // [key, value].
    if argc > 0 && zjs_is_undefined(args[0]) == 0 && zjs_is_null(args[0]) == 0 {
        let iter = iter_get(ctx, args[0]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        ctx_push_temp_root(ctx, m_v);
        let safety: u32 = 0;
        while safety < 100000000 {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            if step.done { break; }
            // Pull [key, value] off step.value via property indexing.
            // Spec requires Object coercion; we use property_get which
            // handles arrays directly.
            let k = property_get(ctx, step.value, zjs_int32(0));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            let v = property_get(ctx, step.value, zjs_int32(1));
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            map_set_entry(m, k, v);
            safety = safety + 1;
        }
        ctx_pop_temp_root(ctx);
    }
    return m_v;
}

fn host_map_get(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_undefined(); }
    let slot = map_find_slot(m, args[0]);
    if slot < 0 { return zjs_undefined(); }
    return m.entries[(u32)slot].value;
}

fn host_map_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    let k = if argc > 0 { args[0] } else { zjs_undefined() };
    let v = if argc > 1 { args[1] } else { zjs_undefined() };
    map_set_entry(m, k, v);
    return ctx.host_this;
}

fn host_map_has(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = map_find_slot(m, args[0]);
    if slot < 0 { return zjs_bool(false); }
    return zjs_bool(true);
}

fn host_map_delete(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = map_find_slot(m, args[0]);
    if slot < 0 { return zjs_bool(false); }
    m.entries[(u32)slot].deleted = true;
    m.entries[(u32)slot].key = zjs_undefined();
    m.entries[(u32)slot].value = zjs_undefined();
    m.size = m.size - 1;
    return zjs_bool(true);
}

// ES2026 Map.prototype.getOrInsert(key, defaultValue) — returns the
// existing value if `key` is already in the map; otherwise inserts
// (key, defaultValue) and returns defaultValue.
fn host_map_get_or_insert(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    let k = if argc > 0 { args[0] } else { zjs_undefined() };
    let v = if argc > 1 { args[1] } else { zjs_undefined() };
    let slot = map_find_slot(m, k);
    if slot >= 0 { return m.entries[(u32)slot].value; }
    map_set_entry(m, k, v);
    return v;
}

// ES2026 Map.prototype.getOrInsertComputed(key, callbackfn) — returns
// the existing value if present; otherwise calls callbackfn(key),
// stores (key, result), and returns result. Spec requires the
// callback to be callable.
fn host_map_get_or_insert_computed(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    let k = if argc > 0 { args[0] } else { zjs_undefined() };
    let cb = if argc > 1 { args[1] } else { zjs_undefined() };
    let cb_callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb) != 0
        || zjs_is_host_function(cb) != 0;
    if !cb_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Map.prototype.getOrInsertComputed callbackfn is not callable", 60);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let slot = map_find_slot(m, k);
    if slot >= 0 { return m.entries[(u32)slot].value; }
    let cb_args: ZjsValue[1];
    cb_args[0] = canonicalize_collection_key(k);
    let cap: ZjsValue* = NULL; raw { cap = &cb_args[0]; }
    let result = zjs_call_value(ctx, cb, cap, 1);
    if ctx.pending_throw_active { return zjs_undefined(); }
    // Spec quirk: re-check after the callback in case it mutated the
    // map for this key. Insert only if still absent; otherwise return
    // whatever's now stored.
    let slot2 = map_find_slot(m, k);
    if slot2 >= 0 { return m.entries[(u32)slot2].value; }
    map_set_entry(m, k, result);
    return result;
}

fn host_map_clear(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    m.count = 0;
    m.size = 0;
    return zjs_undefined();
}

fn host_map_size_getter(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    return zjs_int32((i32)m.size);
}

fn host_map_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let m = map_require_this(ctx);
    if m == NULL { return zjs_undefined(); }
    // ECMA-262 24.1.3.5: IsCallable(callbackfn) is checked BEFORE any
    // iteration (and regardless of map size). A non-callable (incl. a
    // missing) argument is a TypeError.
    let cb = if argc > 0 { args[0] } else { zjs_undefined() };
    if zjs_is_callable(cb) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"callback is not a function", 26);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let this_arg = if argc > 1 { args[1] } else { zjs_undefined() };
    let nullp: ZjsValue* = NULL;
    let map_v = ctx.host_this;
    let i: u32 = 0;
    while i < m.count {
        let e = m.entries + i;
        if !e.deleted {
            // Build a small arg buffer: (value, key, map).
            let local_args: ZjsValue[3];
            local_args[0] = e.value;
            local_args[1] = e.key;
            local_args[2] = map_v;
            let lp: ZjsValue* = NULL;
            raw { lp = &local_args[0]; }
            zjs_call_value_with_this(ctx, cb, this_arg, lp, 3);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        i = i + 1;
    }
    return zjs_undefined();
}

// Build an iterator over the map's live entries. `kind`:
//   0 = keys, 1 = values, 2 = entries [k,v]
fn build_map_iterator(ctx: ZjsContext*, m_v: ZjsValue, kind: u32) -> ZjsValue {
    let it = ctx_new_object(ctx);
    let o = zjs_as_object(it);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_map", 4), m_v);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_i", 2),   zjs_int32(0));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_kind", 5), zjs_int32((i32)kind));
    let next_ptr: void* = NULL; raw { next_ptr = (void*)host_map_iter_next; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"next", 4),
               ctx_make_host_function(ctx, (char*)"next", next_ptr));
    let self_ptr: void* = NULL; raw { self_ptr = (void*)host_self_iter; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"@@iterator", 10),
               ctx_make_host_function(ctx, (char*)"[Symbol.iterator]", self_ptr));
    return it;
}

fn host_map_iter_next(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    if zjs_is_object(recv) == 0 {
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let m_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_map", 4)));
    let i_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_i",   2)));
    let k_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_kind",5)));
    if zjs_is_map(m_v) == 0 { return build_iter_result_helper(ctx, zjs_undefined(), true); }
    let m = zjs_as_map(m_v);
    let i: u32 = if zjs_is_int32(i_v) != 0 { (u32)zjs_as_int32(i_v) } else { 0 };
    let kind: u32 = if zjs_is_int32(k_v) != 0 { (u32)zjs_as_int32(k_v) } else { 2 };
    while i < m.count {
        let e = m.entries + i;
        i = i + 1;
        if e.deleted { continue; }
        object_set(ctx, zjs_as_object(recv),
                   ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)i));
        if kind == 0 { return build_iter_result_helper(ctx, e.key, false); }
        if kind == 1 { return build_iter_result_helper(ctx, e.value, false); }
        // entries — pair as a fresh array.
        let pair = ctx_new_array(ctx, 2);
        let pa = zjs_as_array(pair);
        pa.elements[0] = e.key;
        pa.elements[1] = e.value;
        pa.length = 2;
        return build_iter_result_helper(ctx, pair, false);
    }
    object_set(ctx, zjs_as_object(recv),
               ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)m.count));
    return build_iter_result_helper(ctx, zjs_undefined(), true);
}

fn host_map_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if map_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_map_iterator(ctx, ctx.host_this, 0);
}

fn host_map_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if map_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_map_iterator(ctx, ctx.host_this, 1);
}

fn host_map_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if map_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_map_iterator(ctx, ctx.host_this, 2);
}

// =====================================================================
// Set host functions (2026-05-16). Same storage shape minus the value.
// =====================================================================

fn set_find_slot(s: ZjsSet*, v: ZjsValue) -> i32 {
    let i: u32 = 0;
    while i < s.count {
        let e = s.entries + i;
        if !e.deleted && zjs_same_value_zero(e.value, v) != 0 {
            return (i32)i;
        }
        i = i + 1;
    }
    return -1;
}

fn set_ensure_cap(s: ZjsSet*, want: u32) -> void {
    if want <= s.cap { return; }
    let new_cap: u32 = if s.cap == 0 { 8 } else { s.cap * 2 };
    while new_cap < want { new_cap = new_cap * 2; }
    s.entries = realloc_n<ZjsSetEntry>(s.entries, (usize)s.cap, (usize)new_cap);
    s.cap = new_cap;
}

fn set_add_entry(s: ZjsSet*, v: ZjsValue) -> void {
    let cv = canonicalize_collection_key(v);
    let slot = set_find_slot(s, cv);
    if slot >= 0 { return; }
    set_ensure_cap(s, s.count + 1);
    s.entries[s.count] = ZjsSetEntry{ value: cv, deleted: false };
    s.count = s.count + 1;
    s.size = s.size + 1;
    gc_barrier((void*)s, cv);
}

fn set_require_this(ctx: ZjsContext*) -> ZjsSet* {
    let this_v = ctx.host_this;
    if zjs_is_set(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Set method called on non-Set", 28);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return NULL;
    }
    return zjs_as_set(this_v);
}

fn host_set_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = zjs_set_new();
    ctx_register_cell(ctx, (void*)s);
    let nt_proto_s = subclass_proto_for(ctx, ctx.set_proto);
    if nt_proto_s != NULL { s.proto = nt_proto_s; }
    let s_v = zjs_cell_from_ptr((void*)s);
    if argc > 0 && zjs_is_undefined(args[0]) == 0 && zjs_is_null(args[0]) == 0 {
        let iter = iter_get(ctx, args[0]);
        if ctx.pending_throw_active { return zjs_undefined(); }
        ctx_push_temp_root(ctx, s_v);
        let safety: u32 = 0;
        while safety < 100000000 {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { ctx_pop_temp_root(ctx); return zjs_undefined(); }
            if step.done { break; }
            set_add_entry(s, step.value);
            safety = safety + 1;
        }
        ctx_pop_temp_root(ctx);
    }
    return s_v;
}

fn host_set_add(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    let v = if argc > 0 { args[0] } else { zjs_undefined() };
    set_add_entry(s, v);
    return ctx.host_this;
}

fn host_set_has(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = set_find_slot(s, args[0]);
    if slot < 0 { return zjs_bool(false); }
    return zjs_bool(true);
}

fn host_set_delete(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    if argc == 0 { return zjs_bool(false); }
    let slot = set_find_slot(s, args[0]);
    if slot < 0 { return zjs_bool(false); }
    s.entries[(u32)slot].deleted = true;
    s.entries[(u32)slot].value = zjs_undefined();
    s.size = s.size - 1;
    return zjs_bool(true);
}

fn host_set_clear(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    s.count = 0;
    s.size = 0;
    return zjs_undefined();
}

fn host_set_size_getter(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    return zjs_int32((i32)s.size);
}

fn host_set_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = set_require_this(ctx);
    if s == NULL { return zjs_undefined(); }
    // ECMA-262 24.2.3.6: IsCallable(callbackfn) checked before iteration.
    let cb = if argc > 0 { args[0] } else { zjs_undefined() };
    if zjs_is_callable(cb) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"callback is not a function", 26);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let this_arg = if argc > 1 { args[1] } else { zjs_undefined() };
    let set_v = ctx.host_this;
    let i: u32 = 0;
    while i < s.count {
        let e = s.entries + i;
        if !e.deleted {
            let local_args: ZjsValue[3];
            // Spec: forEach passes (value, value, set) — value duplicated
            // to match Map's (value, key, map) shape.
            local_args[0] = e.value;
            local_args[1] = e.value;
            local_args[2] = set_v;
            let lp: ZjsValue* = NULL;
            raw { lp = &local_args[0]; }
            zjs_call_value_with_this(ctx, cb, this_arg, lp, 3);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        i = i + 1;
    }
    return zjs_undefined();
}

fn build_set_iterator(ctx: ZjsContext*, s_v: ZjsValue, kind: u32) -> ZjsValue {
    let it = ctx_new_object(ctx);
    let o = zjs_as_object(it);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_set", 4), s_v);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_i", 2),   zjs_int32(0));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_kind", 5), zjs_int32((i32)kind));
    let next_ptr: void* = NULL; raw { next_ptr = (void*)host_set_iter_next; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"next", 4),
               ctx_make_host_function(ctx, (char*)"next", next_ptr));
    let self_ptr: void* = NULL; raw { self_ptr = (void*)host_self_iter; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"@@iterator", 10),
               ctx_make_host_function(ctx, (char*)"[Symbol.iterator]", self_ptr));
    return it;
}

fn host_set_iter_next(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    if zjs_is_object(recv) == 0 {
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let s_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_set", 4)));
    let i_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_i",   2)));
    let k_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_kind",5)));
    if zjs_is_set(s_v) == 0 { return build_iter_result_helper(ctx, zjs_undefined(), true); }
    let s = zjs_as_set(s_v);
    let i: u32 = if zjs_is_int32(i_v) != 0 { (u32)zjs_as_int32(i_v) } else { 0 };
    let kind: u32 = if zjs_is_int32(k_v) != 0 { (u32)zjs_as_int32(k_v) } else { 1 };
    while i < s.count {
        let e = s.entries + i;
        i = i + 1;
        if e.deleted { continue; }
        object_set(ctx, zjs_as_object(recv),
                   ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)i));
        if kind == 2 {
            // entries — [value, value] pair (Set has no separate key).
            let pair = ctx_new_array(ctx, 2);
            let pa = zjs_as_array(pair);
            pa.elements[0] = e.value;
            pa.elements[1] = e.value;
            pa.length = 2;
            return build_iter_result_helper(ctx, pair, false);
        }
        return build_iter_result_helper(ctx, e.value, false);
    }
    object_set(ctx, zjs_as_object(recv),
               ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)s.count));
    return build_iter_result_helper(ctx, zjs_undefined(), true);
}

fn host_set_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if set_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_set_iterator(ctx, ctx.host_this, 0);
}

fn host_set_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if set_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_set_iterator(ctx, ctx.host_this, 1);
}

fn host_set_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if set_require_this(ctx) == NULL { return zjs_undefined(); }
    return build_set_iterator(ctx, ctx.host_this, 2);
}

// =====================================================================
// ES2024 group-by + ES2025 Set composition (2026-05-18).
// =====================================================================

// Shared groupBy core: walks the iterable, applies callback(value, k),
// and routes each (key, value) pair through `bucket_set`.
// `bucket_storage` is the wrapper-specific accumulator (a ZjsMap* or
// a ZjsObject* — passed as opaque void* so this helper doesn't know
// which is which). `bucket_set` is the per-pair hook.
//
// Returns false on error (pending throw left active). True on success.
fn group_by_walk(ctx: ZjsContext*, items: ZjsValue, cb: ZjsValue,
                 bucket: void*,
                 bucket_set_into_map: bool) -> bool {
    let iter = iter_get(ctx, items);
    if ctx.pending_throw_active { return false; }
    let k: u32 = 0;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return false; }
        if step.done { break; }
        let cb_args: ZjsValue[2];
        cb_args[0] = step.value;
        cb_args[1] = zjs_int32((i32)k);
        let cap: ZjsValue* = NULL; raw { cap = &cb_args[0]; }
        let key_v: ZjsValue = zjs_undefined();
        raw { key_v = zjs_call_value_with_this(ctx, cb, zjs_undefined(), cap, 2); }
        if ctx.pending_throw_active { return false; }
        if bucket_set_into_map {
            // Map.groupBy — SameValueZero on the raw key, value is an
            // array of items grouped under it.
            let m: ZjsMap* = NULL;
            raw { m = (ZjsMap*)bucket; }
            let slot = map_find_slot(m, key_v);
            if slot < 0 {
                let arr_v = ctx_new_array(ctx, 0);
                array_set(zjs_as_array(arr_v), 0, step.value);
                map_set_entry(m, key_v, arr_v);
            } else {
                let arr_v = m.entries[(u32)slot].value;
                if zjs_is_array(arr_v) != 0 {
                    let a = zjs_as_array(arr_v);
                    array_set(a, a.length, step.value);
                }
            }
        } else {
            // Object.groupBy — key is ToPropertyKey'd (string or symbol).
            let o: ZjsObject* = NULL;
            raw { o = (ZjsObject*)bucket; }
            // For our purposes, stringify if not already a string.
            let key_s: ZjsValue =
                if zjs_is_string(key_v) != 0 { key_v }
                else { zjs_to_string(ctx, key_v) };
            if ctx.pending_throw_active { return false; }
            let key_atom = zjs_as_string(key_s);
            // Does the object already have a bucket under this name?
            let slot = class_find_slot(o.cls, key_atom);
            if slot < 0 || zjs_is_deleted(o.slots[(u32)slot]) != 0 {
                let arr_v = ctx_new_array(ctx, 0);
                array_set(zjs_as_array(arr_v), 0, step.value);
                object_set(ctx, o, key_atom, arr_v);
            } else {
                let arr_v = o.slots[(u32)slot];
                if zjs_is_array(arr_v) != 0 {
                    let a = zjs_as_array(arr_v);
                    array_set(a, a.length, step.value);
                }
            }
        }
        k = k + 1;
    }
    return true;
}

fn host_map_group_by(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let items = if argc > 0 { args[0] } else { zjs_undefined() };
    let cb    = if argc > 1 { args[1] } else { zjs_undefined() };
    let cb_callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb) != 0
        || zjs_is_host_function(cb) != 0;
    if !cb_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Map.groupBy callbackfn is not callable", 38);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let m = zjs_map_new();
    ctx_register_cell(ctx, (void*)m);
    let bucket: void* = NULL; raw { bucket = (void*)m; }
    if !group_by_walk(ctx, items, cb, bucket, true) { return zjs_undefined(); }
    return zjs_cell_from_ptr((void*)m);
}

fn host_object_group_by(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let items = if argc > 0 { args[0] } else { zjs_undefined() };
    let cb    = if argc > 1 { args[1] } else { zjs_undefined() };
    let cb_callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb) != 0
        || zjs_is_host_function(cb) != 0;
    if !cb_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Object.groupBy callbackfn is not callable", 41);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let o_v = ctx_new_object(ctx);
    let o = zjs_as_object(o_v);
    // Spec: the returned object has a null prototype. We don't have
    // an easy "null proto" mode (objects come from ctx_new_object
    // wired to object_proto); set it explicitly.
    o.proto = NULL;
    let bucket: void* = NULL; raw { bucket = (void*)o; }
    if !group_by_walk(ctx, items, cb, bucket, false) { return zjs_undefined(); }
    return o_v;
}

// --- Set composition (2026-05-25 / ES2025) ---------------------------

// Internal: produce a stream of values from a "set-like" — a real Set
// (fast path: walk internal entries) or any object with a callable
// keys() method returning an iterator. `callback_fp` is a raw C
// function pointer (`bool (*)(void*, ZjsValue)`) passed as `void*`
// since Zen-c's function-type-as-param doesn't accept plain C
// pointers. Returning `true` from the callback aborts iteration
// early. Returns false on error (pending throw active); true on
// normal completion / early abort.
fn iterate_set_like(ctx: ZjsContext*, other: ZjsValue,
                    callback_fp: void*, state: void*) -> bool {
    if zjs_is_set(other) != 0 {
        let s = zjs_as_set(other);
        let i: u32 = 0;
        while i < s.count {
            let e = s.entries + i;
            if !e.deleted {
                let stop: bool = false;
                raw {
                    typedef bool (*SetCb)(void*, ZjsValue);
                    SetCb fp = (SetCb)callback_fp;
                    stop = fp(state, e->value);
                }
                if stop { return true; }
            }
            i = i + 1;
        }
        return true;
    }
    // Generic set-like: read keys, iterate via the protocol.
    let keys_atom = ctx_intern_atom(ctx, (char*)"keys", 4);
    let keys_fn = property_get(ctx, other, zjs_cell_from_ptr((void*)keys_atom));
    if ctx.pending_throw_active { return false; }
    let nullp: ZjsValue* = NULL;
    let iter: ZjsValue = zjs_undefined();
    raw { iter = zjs_call_value_with_this(ctx, keys_fn, other, nullp, 0); }
    if ctx.pending_throw_active { return false; }
    if !value_is_js_object(iter) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"set-like.keys() did not return an object", 41);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return false;
    }
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return false; }
        if step.done { break; }
        let stop: bool = false;
        raw {
            typedef bool (*SetCb)(void*, ZjsValue);
            SetCb fp = (SetCb)callback_fp;
            stop = fp(state, step.value);
        }
        if stop { return true; }
    }
    return true;
}

// `has` probe on a set-like: delegates to internal slot for real Sets
// or calls .has(value) for generic set-likes.
fn set_like_has(ctx: ZjsContext*, other: ZjsValue, v: ZjsValue) -> bool {
    if zjs_is_set(other) != 0 {
        let s = zjs_as_set(other);
        return set_find_slot(s, v) >= 0;
    }
    let has_atom = ctx_intern_atom(ctx, (char*)"has", 3);
    let has_fn = property_get(ctx, other, zjs_cell_from_ptr((void*)has_atom));
    if ctx.pending_throw_active { return false; }
    let nullp: ZjsValue* = NULL;
    let arg_buf: ZjsValue[1]; arg_buf[0] = v;
    let argp: ZjsValue* = NULL; raw { argp = &arg_buf[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, has_fn, other, argp, 1); }
    if ctx.pending_throw_active { return false; }
    return zjs_to_bool_coerce(r) != 0;
}

// Build a fresh empty Set wrapper (registered for GC, returned by
// reference for use as `out` in the helpers below).
fn make_new_set(ctx: ZjsContext*) -> ZjsSet* {
    let s = zjs_set_new();
    ctx_register_cell(ctx, (void*)s);
    return s;
}

// Callback states + free-fn callbacks for iterate_set_like (Zen-c
// doesn't allow nested fn definitions, so these live at file scope).
struct SetUnionState   { out: ZjsSet*; }
struct SetSymDiffState { self_s: ZjsSet*; out: ZjsSet*; }
struct SetSupOrDjState { self_s: ZjsSet*; flag: bool; }

fn set_union_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetUnionState* = NULL; raw { st = (SetUnionState*)state; }
    set_add_entry(st.out, v);
    return false;
}

fn set_symdiff_other_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetSymDiffState* = NULL; raw { st = (SetSymDiffState*)state; }
    if set_find_slot(st.self_s, v) < 0 { set_add_entry(st.out, v); }
    return false;
}

fn set_superset_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetSupOrDjState* = NULL; raw { st = (SetSupOrDjState*)state; }
    if set_find_slot(st.self_s, v) < 0 {
        st.flag = false;
        return true;
    }
    return false;
}

fn set_disjoint_cb(state: void*, v: ZjsValue) -> bool {
    let st: SetSupOrDjState* = NULL; raw { st = (SetSupOrDjState*)state; }
    if set_find_slot(st.self_s, v) >= 0 {
        st.flag = false;
        return true;
    }
    return false;
}

// =====================================================================
// ECMA-262 Set methods (union/intersection/difference/...). Each follows
// the spec precisely: GetSetRecord(other) reads size -> has -> keys in
// that observable order, and the algorithms branch on relative size to
// decide whether `other.has` or `other.keys()` is invoked. #334.
// =====================================================================

// A validated Set-like record: { obj, size (intSize), has_fn, keys_fn }.
struct SetRec {
    ok:      bool;
    obj:     ZjsValue;
    size:    f64;
    has_fn:  ZjsValue;
    keys_fn: ZjsValue;
}

// ECMA-262 GetSetRecord(obj): Object check, then Get "size" -> ToNumber
// -> NaN throws TypeError -> ToIntegerOrInfinity -> negative throws
// RangeError; then Get "has"/"keys", each must be callable. Order is
// observable and tested. Sets ctx.pending_throw + returns rec.ok=false
// on any failure.
fn get_set_record(ctx: ZjsContext*, mname: char*, mlen: u32, other: ZjsValue) -> SetRec {
    let rec: SetRec;
    rec.ok = false; rec.obj = other; rec.size = 0.0;
    rec.has_fn = zjs_undefined(); rec.keys_fn = zjs_undefined();
    if !value_is_js_object(other) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, mname, mlen);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return rec;
    }
    // size -> ToNumber -> NaN check -> ToIntegerOrInfinity -> >= 0.
    let size_v = property_get(ctx, other, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"size", 4)));
    if ctx.pending_throw_active { return rec; }
    // ECMA-262 GetSetRecord step 4: numSize = ToNumber(size). ToNumber of
    // an object runs ToPrimitive(number) first (its valueOf / Symbol.to-
    // Primitive), which is observable — set-like `size` getters returning
    // a coercible object must be honored. ta_to_number alone treats
    // objects as NaN, so prime it with ToPrimitive here.
    if value_is_js_object(size_v) {
        size_v = zjs_to_primitive(ctx, size_v, false);
        if ctx.pending_throw_active { return rec; }
    }
    let num = ta_to_number(ctx, size_v);
    if ctx.pending_throw_active { return rec; }
    let bad: bool = false;
    let intsize: f64 = 0.0;
    raw {
        if (isnan(num)) { bad = true; }
        else { intsize = isinf(num) ? num : trunc(num); }
    }
    if bad {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"set-like .size is NaN", 21);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return rec;
    }
    if intsize < 0.0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10, (char*)"set-like .size is negative", 26);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return rec;
    }
    rec.size = intsize;
    // has — must be callable.
    let has_v = property_get(ctx, other, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"has", 3)));
    if ctx.pending_throw_active { return rec; }
    if zjs_is_callable(has_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"set-like .has is not callable", 29);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return rec;
    }
    rec.has_fn = has_v;
    // keys — must be callable.
    let keys_v = property_get(ctx, other, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"keys", 4)));
    if ctx.pending_throw_active { return rec; }
    if zjs_is_callable(keys_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"set-like .keys is not callable", 30);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return rec;
    }
    rec.keys_fn = keys_v;
    rec.ok = true;
    return rec;
}

// Call rec.has(v) with this=rec.obj, coerce to bool.
fn set_rec_has(ctx: ZjsContext*, rec: SetRec*, v: ZjsValue) -> bool {
    let arg_buf: ZjsValue[1]; arg_buf[0] = v;
    let argp: ZjsValue* = NULL; raw { argp = &arg_buf[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, rec->has_fn, rec->obj, argp, 1); }
    if ctx.pending_throw_active { return false; }
    return zjs_to_bool_coerce(r) != 0;
}

// Call rec.keys() with this=rec.obj, returning the iterator (validated
// to be an object). Returns undefined + pending throw on failure.
fn set_rec_keys_iter(ctx: ZjsContext*, rec: SetRec*) -> ZjsValue {
    let nullp: ZjsValue* = NULL;
    let iter: ZjsValue = zjs_undefined();
    raw { iter = zjs_call_value_with_this(ctx, rec->keys_fn, rec->obj, nullp, 0); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if !value_is_js_object(iter) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"set-like .keys() did not return an object", 41);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return iter;
}

// Shallow-clone a Set's live entries into a fresh Set (preserves order).
fn set_clone(ctx: ZjsContext*, src: ZjsSet*) -> ZjsSet* {
    let out = make_new_set(ctx);
    let i: u32 = 0;
    while i < src.count {
        let e = src.entries + i;
        if !e.deleted { set_add_entry(out, e.value); }
        i = i + 1;
    }
    return out;
}

// Mark a value deleted in a Set (SameValueZero match), if present.
fn set_delete_value(s: ZjsSet*, v: ZjsValue) -> void {
    let cv = canonicalize_collection_key(v);
    let slot = set_find_slot(s, cv);
    if slot >= 0 {
        s.entries[(u32)slot].deleted = true;
        s.entries[(u32)slot].value = zjs_undefined();
        s.size = s.size - 1;
    }
}

// Set.prototype.difference(other) — entries in `this` that aren't in
// `other`. Spec: clone this, then (size-branch) remove via other.has or
// other.keys().
fn host_set_difference(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    let other = if argc > 0 { args[0] } else { zjs_undefined() };
    let rec = get_set_record(ctx, (char*)"Set.prototype.difference: argument is not a set-like object", 59, other);
    if !rec.ok { return zjs_undefined(); }
    let out = set_clone(ctx, self_s);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    if (f64)self_s.size <= rec.size {
        // Walk this; remove from result any element other.has().
        let i: u32 = 0;
        while i < self_s.count {
            let e = self_s.entries + i;
            if !e.deleted {
                let in_other = set_rec_has(ctx, &rec, e.value);
                if ctx.pending_throw_active { return zjs_undefined(); }
                if in_other { set_delete_value(out, e.value); }
            }
            i = i + 1;
        }
    } else {
        // Iterate other.keys(); remove each from result.
        let iter = set_rec_keys_iter(ctx, &rec);
        if ctx.pending_throw_active { return zjs_undefined(); }
        while true {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if step.done { break; }
            set_delete_value(out, step.value);
        }
    }
    return out_v;
}

fn host_set_intersection(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    let other = if argc > 0 { args[0] } else { zjs_undefined() };
    let rec = get_set_record(ctx, (char*)"Set.prototype.intersection: argument is not a set-like object", 61, other);
    if !rec.ok { return zjs_undefined(); }
    let out = make_new_set(ctx);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    if (f64)self_s.size <= rec.size {
        // Walk this; keep elements other.has(). Result in this-order.
        let i: u32 = 0;
        while i < self_s.count {
            let e = self_s.entries + i;
            if !e.deleted {
                let in_other = set_rec_has(ctx, &rec, e.value);
                if ctx.pending_throw_active { return zjs_undefined(); }
                if in_other { set_add_entry(out, e.value); }
            }
            i = i + 1;
        }
    } else {
        // Iterate other.keys(); keep keys this has. Result in key-order.
        let iter = set_rec_keys_iter(ctx, &rec);
        if ctx.pending_throw_active { return zjs_undefined(); }
        while true {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if step.done { break; }
            if set_find_slot(self_s, step.value) >= 0 { set_add_entry(out, step.value); }
        }
    }
    return out_v;
}

fn host_set_union(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    let other = if argc > 0 { args[0] } else { zjs_undefined() };
    let rec = get_set_record(ctx, (char*)"Set.prototype.union: argument is not a set-like object", 54, other);
    if !rec.ok { return zjs_undefined(); }
    let out = set_clone(ctx, self_s);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    // Iterate other.keys(); add each (set_add_entry dedups + canon -0).
    let iter = set_rec_keys_iter(ctx, &rec);
    if ctx.pending_throw_active { return zjs_undefined(); }
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return zjs_undefined(); }
        if step.done { break; }
        set_add_entry(out, step.value);
    }
    return out_v;
}

fn host_set_symmetric_difference(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    let other = if argc > 0 { args[0] } else { zjs_undefined() };
    let rec = get_set_record(ctx, (char*)"Set.prototype.symmetricDifference: argument is not a set-like object", 68, other);
    if !rec.ok { return zjs_undefined(); }
    // Clone this, then toggle each key from other.keys() against THIS
    // (never other.has): in this -> remove from result; else -> add.
    let out = set_clone(ctx, self_s);
    let out_v = zjs_cell_from_ptr((void*)out);
    ctx_push_temp_root(ctx, out_v);
    defer ctx_pop_temp_root(ctx);
    let iter = set_rec_keys_iter(ctx, &rec);
    if ctx.pending_throw_active { return zjs_undefined(); }
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return zjs_undefined(); }
        if step.done { break; }
        if set_find_slot(self_s, step.value) >= 0 {
            set_delete_value(out, step.value);
        } else {
            set_add_entry(out, step.value);
        }
    }
    return out_v;
}

fn host_set_is_subset_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    let other = if argc > 0 { args[0] } else { zjs_undefined() };
    let rec = get_set_record(ctx, (char*)"Set.prototype.isSubsetOf: argument is not a set-like object", 59, other);
    if !rec.ok { return zjs_undefined(); }
    // A larger set can't be a subset — short-circuit before any has().
    if (f64)self_s.size > rec.size { return zjs_bool(0); }
    let i: u32 = 0;
    while i < self_s.count {
        let e = self_s.entries + i;
        if !e.deleted {
            let in_other = set_rec_has(ctx, &rec, e.value);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if !in_other { return zjs_bool(0); }
        }
        i = i + 1;
    }
    return zjs_bool(1);
}

fn host_set_is_superset_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    let other = if argc > 0 { args[0] } else { zjs_undefined() };
    let rec = get_set_record(ctx, (char*)"Set.prototype.isSupersetOf: argument is not a set-like object", 61, other);
    if !rec.ok { return zjs_undefined(); }
    // A smaller set can't be a superset — short-circuit before any keys().
    if (f64)self_s.size < rec.size { return zjs_bool(0); }
    let iter = set_rec_keys_iter(ctx, &rec);
    if ctx.pending_throw_active { return zjs_undefined(); }
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { return zjs_undefined(); }
        if step.done { break; }
        if set_find_slot(self_s, step.value) < 0 { return zjs_bool(0); }
    }
    return zjs_bool(1);
}

fn host_set_is_disjoint_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let self_s = set_require_this(ctx);
    if self_s == NULL { return zjs_undefined(); }
    let other = if argc > 0 { args[0] } else { zjs_undefined() };
    let rec = get_set_record(ctx, (char*)"Set.prototype.isDisjointFrom: argument is not a set-like object", 63, other);
    if !rec.ok { return zjs_undefined(); }
    if (f64)self_s.size <= rec.size {
        // Walk this; if other.has(e) for any e, not disjoint.
        let i: u32 = 0;
        while i < self_s.count {
            let e = self_s.entries + i;
            if !e.deleted {
                let in_other = set_rec_has(ctx, &rec, e.value);
                if ctx.pending_throw_active { return zjs_undefined(); }
                if in_other { return zjs_bool(0); }
            }
            i = i + 1;
        }
    } else {
        // Iterate other.keys(); if this has any key, not disjoint.
        let iter = set_rec_keys_iter(ctx, &rec);
        if ctx.pending_throw_active { return zjs_undefined(); }
        while true {
            let step = iter_step(ctx, iter);
            if ctx.pending_throw_active { return zjs_undefined(); }
            if step.done { break; }
            if set_find_slot(self_s, step.value) >= 0 { return zjs_bool(0); }
        }
    }
    return zjs_bool(1);
}

// =====================================================================
// Date host functions (2026-05-16). Stores ms since UTC epoch as f64.
// Year math goes through the C library (gmtime/timegm). Locale-aware
// formatting is left for an Intl follow-up.
// =====================================================================

fn host_date_now_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Spec: integer ms since the epoch. std/time::Time::now() returns
    // U64 wall-clock ms (gettimeofday-backed), matching exactly.
    // performance.now() uses CLOCK_MONOTONIC directly for sub-ms
    // resolution — std/time doesn't expose that yet.
    return zjs_double((f64)Time::now());
}

// Format a Date as ISO 8601 — `YYYY-MM-DDTHH:MM:SS.sssZ`. Used by
// host_date_to_iso_string and toJSON.
fn format_iso_string(ctx: ZjsContext*, ms: f64) -> ZjsValue {
    let buf: char[40];
    raw {
        if (ms != ms) {  // NaN check
            snprintf(buf, sizeof(buf), "Invalid Date");
        } else {
            int64_t total_ms = (int64_t)ms;
            int millis = (int)(total_ms % 1000);
            if (millis < 0) millis += 1000;
            time_t secs = (time_t)(total_ms / 1000);
            if (millis != 0 && total_ms < 0) secs -= 1;
            struct tm tm_utc;
            zjs_gmtime_r(&secs, &tm_utc);
            snprintf(buf, sizeof(buf),
                "%04d-%02d-%02dT%02d:%02d:%02d.%03dZ",
                tm_utc.tm_year + 1900,
                tm_utc.tm_mon + 1,
                tm_utc.tm_mday,
                tm_utc.tm_hour,
                tm_utc.tm_min,
                tm_utc.tm_sec,
                millis);
        }
    }
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let len: u32 = 0;
    raw { len = (uint32_t)strlen(bp); }
    return ctx_intern_string(ctx, bp, len);
}

// Compose ms since epoch from broken-down UTC components. Matches
// the spec's MakeDay / MakeTime / MakeDate. Falls through to NaN for
// out-of-range inputs.
fn date_compose_utc_ms(year: f64, month: f64, day: f64,
                       hour: f64, minute: f64, second: f64,
                       ms_part: f64) -> f64 {
    let result: f64 = 0.0;
    raw {
        // Per ECMA-262 §21.4.1.13, MakeDay/MakeTime/MakeDate return
        // NaN if ANY input isn't finite. Without this guard, (int)NaN
        // is impl-defined (typically 0) and `new Date(2026, undefined)`
        // silently becomes Jan 1 2026 instead of an Invalid Date.
        if (!isfinite(year) || !isfinite(month) || !isfinite(day)
            || !isfinite(hour) || !isfinite(minute) || !isfinite(second)
            || !isfinite(ms_part)) {
            result = 0.0/0.0;
        } else {
            // Spec: year < 100 maps to 1900-relative. §21.4.1.13.
            double yr = year;
            if (yr >= 0.0 && yr <= 99.0) yr += 1900.0;
            struct tm t;
            memset(&t, 0, sizeof(t));
            t.tm_year = (int)yr - 1900;
            t.tm_mon  = (int)month;
            t.tm_mday = (int)day;
            t.tm_hour = (int)hour;
            t.tm_min  = (int)minute;
            t.tm_sec  = (int)second;
            time_t secs = zjs_timegm(&t);
            if (secs == (time_t)-1) {
                result = 0.0/0.0;
            } else {
                result = (double)secs * 1000.0 + ms_part;
            }
        }
    }
    return result;
}

// Convenience: install a getter (and optionally setter) as an
// accessor property on `obj`. Used by URL.prototype to expose
// `protocol` / `host` / `pathname` / etc. via accessor semantics
// (so `url.protocol` triggers the host fn). Mirrors the shape of
// Object.defineProperty({get, set}) without going through the public
// JS API.
fn object_define_accessor(ctx: ZjsContext*, obj: ZjsObject*, name: ZjsString*,
                          getter: ZjsValue, setter: ZjsValue) -> void {
    let acc = zjs_accessor_new(getter, setter);
    ctx_register_cell(ctx, (void*)acc);
    let av = zjs_cell_from_ptr((void*)acc);
    object_define_property_slot(ctx, obj, name, av, PROP_ENUMERABLE | PROP_CONFIGURABLE);
}

// =====================================================================
// =====================================================================
// fetch / Headers / Response — web-API Phase D.0 (2026-05-18).
//
// v0.1 limitations (each will be lifted in a follow-up — see #199
// for TLS, #200 for the rest):
//   - GET only. std/net/http::fetch doesn't accept method/body args.
//   - http:// only. https:// rejected at URL validation; TLS gated
//     on #199.
//   - Response body truncated to 4096 bytes — that's the buffer
//     size in std/net/http::fetch. Real fetch will need a chunked
//     read loop that we'll build over std/net/tcp when we move
//     past the std-as-is path.
//   - Synchronous under the hood. The returned Promise settles
//     immediately. Promise.all([fetch(a), fetch(b)]) serializes.
//   - Headers from std/net/http::fetch's response aren't parsed
//     (the std impl only extracts status + body). Response.headers
//     is empty for v0.1.
// =====================================================================

def HDR_BAG_KEY: char* = (char*)"__zjs_hdr_bag__";

// Lowercase a name in a fresh ZjsValue string so case-insensitive
// lookup ("Content-Type" vs "content-type") works.
fn headers_lower(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    let s_v: ZjsValue = if zjs_is_string(v) != 0 { v } else { zjs_to_string(ctx, v) };
    let s = zjs_as_string(s_v);
    if s.length == 0 { return s_v; }
    let buf = alloc_n<char>((usize)(s.length + 1));
    let i: u32 = 0;
    while i < s.length {
        let c = s.data[i];
        raw {
            if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
        }
        buf[i] = c;
        i = i + 1;
    }
    buf[s.length] = (char)0;
    let r = ctx_intern_string(ctx, buf, s.length);
    dealloc(buf);
    return r;
}

fn headers_bag(ctx: ZjsContext*, obj: ZjsObject*) -> ZjsObject* {
    let atom = ctx_intern_atom(ctx, HDR_BAG_KEY, 15);
    let slot = class_find_slot(obj.cls, atom);
    if slot < 0 { return NULL; }
    let v = obj.slots[(u32)slot];
    if zjs_is_object(v) == 0 { return NULL; }
    return zjs_as_object(v);
}

fn host_headers_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let obj_v = ctx.host_this;
    if zjs_is_object(obj_v) == 0 {
        obj_v = ctx_new_object(ctx);
        if ctx.headers_proto != NULL { zjs_as_object(obj_v).proto = ctx.headers_proto; }
    }
    let obj = zjs_as_object(obj_v);
    let bag_v = ctx_new_object(ctx);
    object_set(ctx, obj, ctx_intern_atom(ctx, HDR_BAG_KEY, 15), bag_v);
    let bag = zjs_as_object(bag_v);
    if argc == 0 || zjs_is_undefined(args[0]) != 0 || zjs_is_null(args[0]) != 0 {
        return obj_v;
    }
    let init = args[0];
    // Array of [name, value] pairs.
    if zjs_is_array(init) != 0 {
        let a = zjs_as_array(init);
        let i: u32 = 0;
        while i < a.length {
            let entry = a.elements[i];
            if zjs_is_array(entry) != 0 {
                let ea = zjs_as_array(entry);
                if ea.length >= 2 {
                    let name_lo = headers_lower(ctx, ea.elements[0]);
                    let val_s   = if zjs_is_string(ea.elements[1]) != 0 { ea.elements[1] }
                                  else { zjs_to_string(ctx, ea.elements[1]) };
                    object_set(ctx, bag, zjs_as_string(name_lo), val_s);
                }
            }
            i = i + 1;
        }
        return obj_v;
    }
    // Plain object — walk own properties.
    if zjs_is_object(init) != 0 {
        let io = zjs_as_object(init);
        let cls = io.cls;
        // Reverse-walk class chain to emit names in insertion order.
        let names: ZjsString*[64];
        let slots: u32[64];
        let nc: u32 = 0;
        let c = cls;
        while c != NULL && c.parent != NULL && nc < 64 {
            names[nc] = c.transition_name;
            slots[nc] = c.transition_slot;
            nc = nc + 1;
            c = c.parent;
        }
        let ni: u32 = nc;
        while ni > 0 {
            ni = ni - 1;
            let name = names[ni];
            let slot = slots[ni];
            if name != NULL && zjs_is_deleted(io.slots[slot]) == 0 {
                let name_lo = headers_lower(ctx, zjs_cell_from_ptr((void*)name));
                let val = io.slots[slot];
                let val_s = if zjs_is_string(val) != 0 { val } else { zjs_to_string(ctx, val) };
                object_set(ctx, bag, zjs_as_string(name_lo), val_s);
            }
        }
    }
    return obj_v;
}

fn host_headers_get(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_null(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_null(); }
    let bag = headers_bag(ctx, zjs_as_object(this_v));
    if bag == NULL { return zjs_null(); }
    let name_lo = headers_lower(ctx, args[0]);
    let slot = class_find_slot(bag.cls, zjs_as_string(name_lo));
    if slot < 0 || zjs_is_deleted(bag.slots[(u32)slot]) != 0 { return zjs_null(); }
    return bag.slots[(u32)slot];
}

fn host_headers_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let bag = headers_bag(ctx, zjs_as_object(this_v));
    if bag == NULL { return zjs_undefined(); }
    let name_lo = headers_lower(ctx, args[0]);
    let val_s   = if zjs_is_string(args[1]) != 0 { args[1] } else { zjs_to_string(ctx, args[1]) };
    object_set(ctx, bag, zjs_as_string(name_lo), val_s);
    return zjs_undefined();
}

// Spec: append combines values for the same name with ", " separator.
// (Previously aliased to host_headers_set, which is "set last wins" —
// this surfaced as a real bug in the WinterTC MCA suite.)
fn host_headers_append(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let bag = headers_bag(ctx, zjs_as_object(this_v));
    if bag == NULL { return zjs_undefined(); }
    let name_lo = headers_lower(ctx, args[0]);
    let name_s = zjs_as_string(name_lo);
    let val_s   = if zjs_is_string(args[1]) != 0 { args[1] } else { zjs_to_string(ctx, args[1]) };
    let new_part = zjs_as_string(val_s);

    let slot = class_find_slot(bag.cls, name_s);
    if slot < 0 || zjs_is_deleted(bag.slots[(u32)slot]) != 0
       || zjs_is_string(bag.slots[(u32)slot]) == 0 {
        // First entry — set as-is.
        object_set(ctx, bag, name_s, val_s);
        return zjs_undefined();
    }
    // Existing value: combine as "<old>, <new>" per spec.
    let prev = zjs_as_string(bag.slots[(u32)slot]);
    let total = prev.length + 2 + new_part.length;
    let buf = alloc_n<char>((usize)(total + 1));
    let i: u32 = 0;
    while i < prev.length { buf[i] = prev.data[i]; i = i + 1; }
    buf[prev.length]     = (char)',';
    buf[prev.length + 1] = (char)' ';
    let j: u32 = 0;
    while j < new_part.length { buf[prev.length + 2 + j] = new_part.data[j]; j = j + 1; }
    buf[total] = (char)0;
    let combined = ctx_intern_string(ctx, buf, total);
    dealloc(buf);
    object_set(ctx, bag, name_s, combined);
    return zjs_undefined();
}

fn host_headers_has(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_bool(0); }
    let bag = headers_bag(ctx, zjs_as_object(this_v));
    if bag == NULL { return zjs_bool(0); }
    let name_lo = headers_lower(ctx, args[0]);
    let slot = class_find_slot(bag.cls, zjs_as_string(name_lo));
    if slot < 0 || zjs_is_deleted(bag.slots[(u32)slot]) != 0 { return zjs_bool(0); }
    return zjs_bool(1);
}

fn host_headers_delete(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let bag = headers_bag(ctx, zjs_as_object(this_v));
    if bag == NULL { return zjs_undefined(); }
    let name_lo = headers_lower(ctx, args[0]);
    let slot = class_find_slot(bag.cls, zjs_as_string(name_lo));
    if slot >= 0 { bag.slots[(u32)slot] = zjs_deleted(); }
    return zjs_undefined();
}

// Walk the bag's hidden-class chain to snapshot live header entries
// in insertion order into a fresh ZjsArray of [name0, value0, name1,
// value1, ...]. Used by both forEach and the iterator wrappers below.
fn headers_snapshot_pairs(ctx: ZjsContext*, bag: ZjsObject*) -> ZjsValue {
    let names: ZjsString*[64];
    let slots: u32[64];
    let nc: u32 = 0;
    if bag != NULL {
        let c = bag.cls;
        while c != NULL && c.parent != NULL && nc < 64 {
            names[nc] = c.transition_name;
            slots[nc] = c.transition_slot;
            nc = nc + 1;
            c = c.parent;
        }
    }
    // Count live entries so we can size the array up-front (no incremental growth needed).
    let live: u32 = 0;
    let ni: u32 = nc;
    while ni > 0 {
        ni = ni - 1;
        if names[ni] != NULL && zjs_is_deleted(bag.slots[slots[ni]]) == 0 {
            live = live + 1;
        }
    }
    let arr_v = ctx_new_array(ctx, live * 2);
    let a = zjs_as_array(arr_v);
    let out: u32 = 0;
    ni = nc;
    while ni > 0 {
        ni = ni - 1;
        let name = names[ni];
        let slot = slots[ni];
        if name != NULL && zjs_is_deleted(bag.slots[slot]) == 0 {
            a.elements[out]     = zjs_cell_from_ptr((void*)name);
            a.elements[out + 1] = bag.slots[slot];
            out = out + 2;
        }
    }
    return arr_v;
}

fn host_headers_for_each(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let bag = headers_bag(ctx, zjs_as_object(this_v));
    if bag == NULL { return zjs_undefined(); }
    let cb = args[0];
    let this_arg = if argc > 1 { args[1] } else { zjs_undefined() };
    let pairs_v = headers_snapshot_pairs(ctx, bag);
    let pa = zjs_as_array(pairs_v);
    let i: u32 = 0;
    while i + 1 < pa.length {
        let local_args: ZjsValue[3];
        local_args[0] = pa.elements[i + 1];  // value
        local_args[1] = pa.elements[i];      // name
        local_args[2] = this_v;              // headers obj
        let lp: ZjsValue* = NULL;
        raw { lp = &local_args[0]; }
        zjs_call_value_with_this(ctx, cb, this_arg, lp, 3);
        if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 2;
    }
    return zjs_undefined();
}

// `kind`: 0 = keys, 1 = values, 2 = entries [name, value].
fn build_headers_iterator(ctx: ZjsContext*, headers_v: ZjsValue, kind: u32) -> ZjsValue {
    let it = ctx_new_object(ctx);
    let o = zjs_as_object(it);
    let bag = headers_bag(ctx, zjs_as_object(headers_v));
    let pairs_v = headers_snapshot_pairs(ctx, bag);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_pairs", 6), pairs_v);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32(0));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"_kind", 5), zjs_int32((i32)kind));
    let next_ptr: void* = NULL; raw { next_ptr = (void*)host_headers_iter_next; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"next", 4),
               ctx_make_host_function(ctx, (char*)"next", next_ptr));
    let self_ptr: void* = NULL; raw { self_ptr = (void*)host_self_iter; }
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"@@iterator", 10),
               ctx_make_host_function(ctx, (char*)"[Symbol.iterator]", self_ptr));
    return it;
}

fn host_headers_iter_next(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let recv = zjs_get_host_this(ctx);
    if zjs_is_object(recv) == 0 {
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let pairs_v = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_pairs", 6)));
    let i_v     = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_i",     2)));
    let k_v     = property_get(ctx, recv, zjs_cell_from_ptr((void*)ctx_intern_atom(ctx, (char*)"_kind",  5)));
    if zjs_is_array(pairs_v) == 0 { return build_iter_result_helper(ctx, zjs_undefined(), true); }
    let pa = zjs_as_array(pairs_v);
    let i: u32 = if zjs_is_int32(i_v) != 0 { (u32)zjs_as_int32(i_v) } else { 0 };
    let kind: u32 = if zjs_is_int32(k_v) != 0 { (u32)zjs_as_int32(k_v) } else { 2 };
    if i + 1 >= pa.length {
        object_set(ctx, zjs_as_object(recv),
                   ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)pa.length));
        return build_iter_result_helper(ctx, zjs_undefined(), true);
    }
    let name  = pa.elements[i];
    let value = pa.elements[i + 1];
    object_set(ctx, zjs_as_object(recv),
               ctx_intern_atom(ctx, (char*)"_i", 2), zjs_int32((i32)(i + 2)));
    if kind == 0 { return build_iter_result_helper(ctx, name,  false); }
    if kind == 1 { return build_iter_result_helper(ctx, value, false); }
    let pair = ctx_new_array(ctx, 2);
    let pra = zjs_as_array(pair);
    pra.elements[0] = name;
    pra.elements[1] = value;
    pra.length = 2;
    return build_iter_result_helper(ctx, pair, false);
}

fn host_headers_keys(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    return build_headers_iterator(ctx, this_v, 0);
}

fn host_headers_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    return build_headers_iterator(ctx, this_v, 1);
}

fn host_headers_entries(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    return build_headers_iterator(ctx, this_v, 2);
}

// =====================================================================
// Response. Stored on a plain ZjsObject with hidden fields for
// status/body; .status / .ok / .headers exposed via accessor getters
// on Response.prototype.
// =====================================================================

def RESP_STATUS_KEY:      char* = (char*)"__zjs_resp_status__";
def RESP_BODY_KEY:        char* = (char*)"__zjs_resp_body__";
def RESP_HEADERS_KEY:     char* = (char*)"__zjs_resp_headers__";
def RESP_URL_KEY:         char* = (char*)"__zjs_resp_url__";
def RESP_STATUS_TEXT_KEY: char* = (char*)"__zjs_resp_status_text__";

fn build_response_object(ctx: ZjsContext*, status: i32, body_v: ZjsValue, headers_v: ZjsValue, url_v: ZjsValue) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    if ctx.response_proto != NULL { zjs_as_object(obj_v).proto = ctx.response_proto; }
    let o = zjs_as_object(obj_v);
    object_set(ctx, o, ctx_intern_atom(ctx, RESP_STATUS_KEY,  19), zjs_int32(status));
    object_set(ctx, o, ctx_intern_atom(ctx, RESP_BODY_KEY,    17), body_v);
    object_set(ctx, o, ctx_intern_atom(ctx, RESP_HEADERS_KEY, 20), headers_v);
    object_set(ctx, o, ctx_intern_atom(ctx, RESP_URL_KEY,     16), url_v);
    return obj_v;
}

// new Response(body?, init?). Spec §6.5: body is string / Blob /
// FormData / Uint8Array / ReadableStream / null / undefined; init is
// { status, statusText, headers }. Defaults: status=200, body=null.
fn host_response_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let body_v: ZjsValue = if argc >= 1 { args[0] } else { zjs_null() };
    let init_v: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    // Coerce body to a string for the simple case so .text() / .json()
    // round-trip works on a hand-constructed Response. The real spec
    // lets body be many types — those still flow through verbatim.
    if zjs_is_string(body_v) == 0
       && zjs_is_uint8_array(body_v) == 0
       && zjs_is_null(body_v) == 0
       && zjs_is_undefined(body_v) == 0 {
        body_v = zjs_to_string(ctx, body_v);
    }
    let status: i32 = 200;
    let stext_v: ZjsValue = zjs_undefined();
    let hdrs_v:  ZjsValue = zjs_undefined();
    if zjs_is_object(init_v) != 0 {
        let init_o = zjs_as_object(init_v);
        let st = property_get(ctx, init_v, ctx_intern_string(ctx, (char*)"status", 6));
        if zjs_is_int32(st) != 0 { status = zjs_as_int32(st); }
        else if zjs_is_double(st) != 0 { status = (i32)zjs_as_double(st); }
        stext_v = property_get(ctx, init_v, ctx_intern_string(ctx, (char*)"statusText", 10));
        hdrs_v  = property_get(ctx, init_v, ctx_intern_string(ctx, (char*)"headers", 7));
    }
    if zjs_is_object(hdrs_v) == 0 {
        // Build an empty Headers — host_headers_ctor handles new/this.
        let saved_this = ctx.host_this;
        ctx.host_this = ctx_new_object(ctx);
        hdrs_v = host_headers_ctor(ctx, NULL, 0);
        ctx.host_this = saved_this;
    }
    let obj_v = build_response_object(ctx, status, body_v, hdrs_v,
                                       ctx_intern_string(ctx, (char*)"", 0));
    if zjs_is_string(stext_v) != 0 {
        object_set(ctx, zjs_as_object(obj_v),
                   ctx_intern_atom(ctx, RESP_STATUS_TEXT_KEY, 24), stext_v);
    }
    return obj_v;
}

// Request — opaque, just stores url/method/headers/body. Spec is
// largely shape-only at this layer; fetch() doesn't yet accept a
// Request, but `new Request(url, init)` shouldn't throw, and the
// fields should be readable.
def REQ_URL_KEY:     char* = (char*)"__zjs_req_url__";
def REQ_METHOD_KEY:  char* = (char*)"__zjs_req_method__";
def REQ_HEADERS_KEY: char* = (char*)"__zjs_req_headers__";
def REQ_BODY_KEY:    char* = (char*)"__zjs_req_body__";

fn host_request_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 1 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Request requires an input arg", 29);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let url_v = args[0];
    if zjs_is_string(url_v) == 0 {
        // If it's a Request, copy its url field; otherwise coerce.
        if zjs_is_object(url_v) != 0 {
            let maybe = property_get(ctx, url_v, ctx_intern_string(ctx, REQ_URL_KEY, 16));
            if zjs_is_string(maybe) != 0 { url_v = maybe; }
            else { url_v = zjs_to_string(ctx, url_v); }
        } else {
            url_v = zjs_to_string(ctx, url_v);
        }
    }
    let init_v: ZjsValue = if argc >= 2 { args[1] } else { zjs_undefined() };
    let method_v: ZjsValue = ctx_intern_string(ctx, (char*)"GET", 3);
    let hdrs_v:   ZjsValue = zjs_undefined();
    let body_v:   ZjsValue = zjs_null();
    if zjs_is_object(init_v) != 0 {
        let m = property_get(ctx, init_v, ctx_intern_string(ctx, (char*)"method", 6));
        if zjs_is_string(m) != 0 { method_v = m; }
        hdrs_v = property_get(ctx, init_v, ctx_intern_string(ctx, (char*)"headers", 7));
        let b  = property_get(ctx, init_v, ctx_intern_string(ctx, (char*)"body", 4));
        if zjs_is_undefined(b) == 0 { body_v = b; }
    }
    if zjs_is_object(hdrs_v) == 0 {
        let saved_this = ctx.host_this;
        ctx.host_this = ctx_new_object(ctx);
        hdrs_v = host_headers_ctor(ctx, NULL, 0);
        ctx.host_this = saved_this;
    }
    let obj_v = ctx_new_object(ctx);
    if ctx.request_proto != NULL { zjs_as_object(obj_v).proto = ctx.request_proto; }
    let o = zjs_as_object(obj_v);
    object_set(ctx, o, ctx_intern_atom(ctx, REQ_URL_KEY,     15), url_v);
    object_set(ctx, o, ctx_intern_atom(ctx, REQ_METHOD_KEY,  18), method_v);
    object_set(ctx, o, ctx_intern_atom(ctx, REQ_HEADERS_KEY, 19), hdrs_v);
    object_set(ctx, o, ctx_intern_atom(ctx, REQ_BODY_KEY,    16), body_v);
    return obj_v;
}

fn host_request_url(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let atom = ctx_intern_atom(ctx, REQ_URL_KEY, 15);
    let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
    if slot < 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    return zjs_as_object(this_v).slots[(u32)slot];
}
fn host_request_method(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"GET", 3); }
    let atom = ctx_intern_atom(ctx, REQ_METHOD_KEY, 18);
    let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
    if slot < 0 { return ctx_intern_string(ctx, (char*)"GET", 3); }
    return zjs_as_object(this_v).slots[(u32)slot];
}
fn host_request_headers(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let atom = ctx_intern_atom(ctx, REQ_HEADERS_KEY, 19);
    let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
    if slot < 0 { return zjs_undefined(); }
    return zjs_as_object(this_v).slots[(u32)slot];
}
fn host_request_body(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_null(); }
    let atom = ctx_intern_atom(ctx, REQ_BODY_KEY, 16);
    let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
    if slot < 0 { return zjs_null(); }
    return zjs_as_object(this_v).slots[(u32)slot];
}

fn host_response_status(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_int32(0); }
    let atom = ctx_intern_atom(ctx, RESP_STATUS_KEY, 19);
    let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
    if slot < 0 { return zjs_int32(0); }
    return zjs_as_object(this_v).slots[(u32)slot];
}

fn host_response_ok(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s = host_response_status(ctx, args, argc);
    if zjs_is_int32(s) == 0 { return zjs_bool(0); }
    let v = zjs_as_int32(s);
    return zjs_bool(if v >= 200 && v < 300 { 1 } else { 0 });
}

fn host_response_status_text(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // If the consumer set statusText explicitly via `new Response(body,
    // { statusText: 'Created' })`, prefer that. Otherwise synthesize
    // from status for the common codes.
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) != 0 {
        let atom = ctx_intern_atom(ctx, RESP_STATUS_TEXT_KEY, 24);
        let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
        if slot >= 0 {
            let v = zjs_as_object(this_v).slots[(u32)slot];
            if zjs_is_string(v) != 0 { return v; }
        }
    }
    let s = host_response_status(ctx, args, argc);
    if zjs_is_int32(s) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let v = zjs_as_int32(s);
    // Minimal text for the common statuses; everything else is "".
    if v == 200 { return ctx_intern_string(ctx, (char*)"OK", 2); }
    if v == 201 { return ctx_intern_string(ctx, (char*)"Created", 7); }
    if v == 204 { return ctx_intern_string(ctx, (char*)"No Content", 10); }
    if v == 301 { return ctx_intern_string(ctx, (char*)"Moved Permanently", 17); }
    if v == 302 { return ctx_intern_string(ctx, (char*)"Found", 5); }
    if v == 304 { return ctx_intern_string(ctx, (char*)"Not Modified", 12); }
    if v == 400 { return ctx_intern_string(ctx, (char*)"Bad Request", 11); }
    if v == 401 { return ctx_intern_string(ctx, (char*)"Unauthorized", 12); }
    if v == 403 { return ctx_intern_string(ctx, (char*)"Forbidden", 9); }
    if v == 404 { return ctx_intern_string(ctx, (char*)"Not Found", 9); }
    if v == 500 { return ctx_intern_string(ctx, (char*)"Internal Server Error", 21); }
    return ctx_intern_string(ctx, (char*)"", 0);
}

fn host_response_url(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let atom = ctx_intern_atom(ctx, RESP_URL_KEY, 16);
    let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
    if slot < 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    return zjs_as_object(this_v).slots[(u32)slot];
}

fn host_response_headers_acc(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let atom = ctx_intern_atom(ctx, RESP_HEADERS_KEY, 20);
    let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
    if slot < 0 { return zjs_undefined(); }
    return zjs_as_object(this_v).slots[(u32)slot];
}

// Return body as text — Promise<string>. Body is already a string
// internally (UTF-8 byte-string from zen-c). Resolve immediately.
fn host_response_text(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    let body_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    if zjs_is_object(this_v) != 0 {
        let atom = ctx_intern_atom(ctx, RESP_BODY_KEY, 17);
        let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
        if slot >= 0 { body_v = zjs_as_object(this_v).slots[(u32)slot]; }
    }
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    promise_resolve_with(ctx, pv, body_v);
    return pv;
}

// Return body as a Uint8Array — Promise<Uint8Array>. Copies the
// byte-string into a fresh Uint8Array.
fn host_response_array_buffer(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    let body_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    if zjs_is_object(this_v) != 0 {
        let atom = ctx_intern_atom(ctx, RESP_BODY_KEY, 17);
        let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
        if slot >= 0 { body_v = zjs_as_object(this_v).slots[(u32)slot]; }
    }
    let s = zjs_as_string(body_v);
    let a = zjs_uint8_array_new(s.length);
    ctx_register_cell(ctx, (void*)a);
    let i: u32 = 0;
    while i < s.length { a.bytes[i] = (u8)s.data[i]; i = i + 1; }
    let av = zjs_cell_from_ptr((void*)a);
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    promise_resolve_with(ctx, pv, av);
    return pv;
}

// Return body parsed as JSON — Promise<any>. Routes through the same
// JSON.parse machinery used by the global so spec-correct error
// reporting (SyntaxError on malformed JSON) stays consistent.
fn host_response_json(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    let body_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    if zjs_is_object(this_v) != 0 {
        let atom = ctx_intern_atom(ctx, RESP_BODY_KEY, 17);
        let slot = class_find_slot(zjs_as_object(this_v).cls, atom);
        if slot >= 0 { body_v = zjs_as_object(this_v).slots[(u32)slot]; }
    }
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);

    let parse_args: ZjsValue[1];
    parse_args[0] = body_v;
    let parsed = host_json_parse(ctx, &parse_args[0], 1);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    promise_resolve_with(ctx, pv, parsed);
    return pv;
}

// Walk a JS "headers init" value (Headers / plain object / array of
// [name, value] pairs) and fill name/value char* arrays. Returns the
// number of pairs collected. Header values that aren't strings get
// converted via zjs_to_string. Caps at `cap` pairs — anything beyond
// is silently dropped at v0.1 (overflow into 65th header is exotic).
fn marshal_request_headers(ctx: ZjsContext*, hv: ZjsValue,
                           names: char**, values: char**, cap: usize) -> usize {
    if zjs_is_undefined(hv) != 0 || zjs_is_null(hv) != 0 { return 0; }
    let count: usize = 0;

    // Headers instance — read the hidden bag.
    if zjs_is_object(hv) != 0 && ctx.headers_proto != NULL
       && zjs_as_object(hv).proto == ctx.headers_proto {
        let bag = headers_bag(ctx, zjs_as_object(hv));
        if bag == NULL { return 0; }
        // Walk the bag's hidden-class chain to recover all key/value pairs.
        let cls = bag.cls;
        while cls != NULL && cls.parent != NULL && count < cap {
            let name  = cls.transition_name;
            let slot  = cls.transition_slot;
            if name != NULL && zjs_is_deleted(bag.slots[slot]) == 0 {
                let val = bag.slots[slot];
                let val_s: ZjsValue = if zjs_is_string(val) != 0 { val }
                                       else { zjs_to_string(ctx, val) };
                names[count]  = name.data;
                values[count] = zjs_as_string(val_s).data;
                count = count + 1;
            }
            cls = cls.parent;
        }
        return count;
    }

    // Array of [name, value] pairs.
    if zjs_is_array(hv) != 0 {
        let a = zjs_as_array(hv);
        let i: u32 = 0;
        while i < a.length && count < cap {
            let entry = a.elements[i];
            if zjs_is_array(entry) != 0 {
                let ea = zjs_as_array(entry);
                if ea.length >= 2 {
                    let n_v = ea.elements[0];
                    let v_v = ea.elements[1];
                    let n_s: ZjsValue = if zjs_is_string(n_v) != 0 { n_v } else { zjs_to_string(ctx, n_v) };
                    let v_s: ZjsValue = if zjs_is_string(v_v) != 0 { v_v } else { zjs_to_string(ctx, v_v) };
                    names[count]  = zjs_as_string(n_s).data;
                    values[count] = zjs_as_string(v_s).data;
                    count = count + 1;
                }
            }
            i = i + 1;
        }
        return count;
    }

    // Plain object — walk own properties in insertion order.
    if zjs_is_object(hv) != 0 {
        let o = zjs_as_object(hv);
        let stack_names: ZjsString*[64];
        let stack_slots: u32[64];
        let nc: u32 = 0;
        let c = o.cls;
        while c != NULL && c.parent != NULL && nc < 64 {
            stack_names[nc] = c.transition_name;
            stack_slots[nc] = c.transition_slot;
            nc = nc + 1;
            c = c.parent;
        }
        let ni: u32 = nc;
        while ni > 0 && count < cap {
            ni = ni - 1;
            let name = stack_names[ni];
            let slot = stack_slots[ni];
            if name != NULL && zjs_is_deleted(o.slots[slot]) == 0 {
                let val = o.slots[slot];
                let val_s: ZjsValue = if zjs_is_string(val) != 0 { val } else { zjs_to_string(ctx, val) };
                names[count]  = name.data;
                values[count] = zjs_as_string(val_s).data;
                count = count + 1;
            }
        }
        return count;
    }
    return 0;
}

// fetch(input, init?) — drives the native HTTP backend and wraps the
// result in a Promise. init supports {method, headers, body} at v0.1.
fn host_fetch(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let url_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    if argc >= 1 {
        if zjs_is_string(args[0]) != 0 {
            url_v = args[0];
        } else if zjs_is_object(args[0]) != 0 && ctx.url_proto != NULL
                  && zjs_as_object(args[0]).proto == ctx.url_proto {
            // URL instance — host_url_to_string reads from
            // ctx.host_this, so swap it in for the call.
            let saved = ctx.host_this;
            ctx.host_this = args[0];
            url_v = host_url_to_string(ctx, NULL, 0);
            ctx.host_this = saved;
        } else {
            url_v = zjs_to_string(ctx, args[0]);
        }
    }
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);

    let us = zjs_as_string(url_v);

    // --- Parse init: method / headers / body ---
    let method_cstr: char* = (char*)"GET";
    let body_ptr_req: char* = NULL;
    let body_len_req: usize = 0;
    let hdr_names:  char*[64];
    let hdr_values: char*[64];
    let hdr_count: usize = 0;
    let hdr_flat: char*[128];

    if argc >= 2 && zjs_is_object(args[1]) != 0 {
        let init = zjs_as_object(args[1]);
        let m_atom = ctx_intern_atom(ctx, (char*)"method", 6);
        let m_slot = class_find_slot(init.cls, m_atom);
        if m_slot >= 0 {
            let m_v = init.slots[(u32)m_slot];
            if zjs_is_string(m_v) != 0 {
                method_cstr = zjs_as_string(m_v).data;
            } else if zjs_is_undefined(m_v) == 0 && zjs_is_null(m_v) == 0 {
                method_cstr = zjs_as_string(zjs_to_string(ctx, m_v)).data;
            }
        }

        let h_atom = ctx_intern_atom(ctx, (char*)"headers", 7);
        let h_slot = class_find_slot(init.cls, h_atom);
        if h_slot >= 0 {
            hdr_count = marshal_request_headers(ctx, init.slots[(u32)h_slot],
                                                &hdr_names[0], &hdr_values[0], 64);
        }

        let b_atom = ctx_intern_atom(ctx, (char*)"body", 4);
        let b_slot = class_find_slot(init.cls, b_atom);
        if b_slot >= 0 {
            let b_v = init.slots[(u32)b_slot];
            if zjs_is_string(b_v) != 0 {
                let bs = zjs_as_string(b_v);
                body_ptr_req = bs.data;
                body_len_req = (usize)bs.length;
            } else if zjs_is_uint8_array(b_v) != 0 {
                let ba = zjs_as_uint8_array(b_v);
                raw { body_ptr_req = (char*)ba->bytes; }
                body_len_req = (usize)ba.length;
            } else if zjs_is_undefined(b_v) == 0 && zjs_is_null(b_v) == 0 {
                let bs2 = zjs_as_string(zjs_to_string(ctx, b_v));
                body_ptr_req = bs2.data;
                body_len_req = (usize)bs2.length;
            }
        }
    }

    // Build flat [n0, v0, n1, v1, ...] array the C side expects.
    let hi: usize = 0;
    while hi < hdr_count {
        hdr_flat[2*hi]     = hdr_names[hi];
        hdr_flat[2*hi + 1] = hdr_values[hi];
        hi = hi + 1;
    }

    // AbortSignal — if init.signal.aborted is already true, reject
    // immediately. Mid-request cancellation isn't wired into the
    // native HTTP backend yet (separate plumbing); this handles the
    // common pre-aborted case.
    if argc >= 2 && zjs_is_object(args[1]) != 0 {
        let init2 = zjs_as_object(args[1]);
        let sig_v = property_get(ctx, args[1], ctx_intern_string(ctx, (char*)"signal", 6));
        if zjs_is_object(sig_v) != 0 {
            let ab_v = property_get(ctx, sig_v, ctx_intern_string(ctx, (char*)"aborted", 7));
            if zjs_to_bool_coerce(ab_v) {
                let reason = property_get(ctx, sig_v, ctx_intern_string(ctx, (char*)"reason", 6));
                if zjs_is_undefined(reason) != 0 {
                    reason = build_typed_error(ctx, (char*)"AbortError", 10,
                                               (char*)"The operation was aborted", 25);
                }
                promise_settle(ctx, pv, reason, false);
                return pv;
            }
        }
    }

    // --- Kick off via async ABI; engine event-loop polls the handle. ---
    let url_cstr: char* = us.data;
    let h_ptr: void* = NULL;
    raw {
        ZjsHttpRequest c_req;
        c_req.method = method_cstr;
        c_req.url = url_cstr;
        c_req.req_headers = (const char**)hdr_flat;
        c_req.req_header_count = hdr_count;
        c_req.body = body_ptr_req;
        c_req.body_len = body_len_req;
        c_req.timeout_seconds = 0;
        h_ptr = (void*)zjs_http_request_start(&c_req);
    }
    if h_ptr == NULL {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"fetch: failed to start request", 30);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    ctx_register_pending_fetch(ctx, h_ptr, pv, url_v);
    return pv;
}

fn ctx_register_pending_fetch(ctx: ZjsContext*, handle: void*, promise: ZjsValue, url: ZjsValue) -> void {
    if ctx.pending_fetch_count >= ctx.pending_fetch_cap {
        let new_cap: u32 = if ctx.pending_fetch_cap == 0 { 4 } else { ctx.pending_fetch_cap * 2 };
        let old_cap = ctx.pending_fetch_cap;
        ctx.pending_fetches        = realloc_n<void*>(ctx.pending_fetches, (usize)old_cap, (usize)new_cap);
        ctx.pending_fetch_promises = realloc_n<ZjsValue>(ctx.pending_fetch_promises, (usize)old_cap, (usize)new_cap);
        ctx.pending_fetch_urls     = realloc_n<ZjsValue>(ctx.pending_fetch_urls, (usize)old_cap, (usize)new_cap);
        ctx.pending_fetch_cap = new_cap;
    }
    ctx.pending_fetches[ctx.pending_fetch_count]        = handle;
    ctx.pending_fetch_promises[ctx.pending_fetch_count] = promise;
    ctx.pending_fetch_urls[ctx.pending_fetch_count]     = url;
    ctx.pending_fetch_count = ctx.pending_fetch_count + 1;
}

fn ctx_unregister_pending_fetch_at(ctx: ZjsContext*, idx: u32) -> void {
    if idx >= ctx.pending_fetch_count { return; }
    let last = ctx.pending_fetch_count - 1;
    ctx.pending_fetches[idx]        = ctx.pending_fetches[last];
    ctx.pending_fetch_promises[idx] = ctx.pending_fetch_promises[last];
    ctx.pending_fetch_urls[idx]     = ctx.pending_fetch_urls[last];
    ctx.pending_fetch_count = last;
}

// Walk the pending-fetch list, poll each handle, resolve+remove
// those that have completed. Called every event-loop tick.
fn http_drain_pending_fetches(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    while i < ctx.pending_fetch_count {
        let handle  = ctx.pending_fetches[i];
        let promise = ctx.pending_fetch_promises[i];
        let url_v   = ctx.pending_fetch_urls[i];
        let ready: i32 = 0;
        let status: i32 = 0;
        let body_ptr: char* = NULL;
        let body_len: usize = 0;
        let hdr_ptr: char** = NULL;
        let hdr_count: usize = 0;
        let err_ptr: char* = NULL;
        raw {
            ZjsHttpResponse c_resp;
            c_resp.status = 0; c_resp.body = NULL; c_resp.body_len = 0;
            c_resp.resp_headers = NULL; c_resp.resp_header_count = 0;
            ready    = zjs_http_request_poll((ZjsHttpHandle*)handle, &c_resp, &err_ptr);
            status   = c_resp.status;
            body_ptr = c_resp.body;   body_len  = c_resp.body_len;
            hdr_ptr  = c_resp.resp_headers; hdr_count = c_resp.resp_header_count;
        }
        if ready == 0 { i = i + 1; continue; }
        ctx_unregister_pending_fetch_at(ctx, i);
        if ready < 0 {
            let msg: char* = if err_ptr != NULL { err_ptr } else { (char*)"fetch failed" };
            let msg_len: u32 = 0;
            raw { msg_len = (uint32_t)strlen(msg); }
            let err = build_typed_error(ctx, (char*)"TypeError", 9, msg, msg_len);
            if err_ptr != NULL { raw { free(err_ptr); } }
            promise_settle(ctx, promise, err, false);
        } else {
            let body_zv: ZjsValue = ctx_intern_string(ctx, body_ptr, (u32)body_len);
            let hdrs_v = host_headers_ctor(ctx, NULL, 0);
            if hdr_ptr != NULL && hdr_count > 0 {
                let hbag = headers_bag(ctx, zjs_as_object(hdrs_v));
                if hbag != NULL {
                    let ri: usize = 0;
                    while ri < hdr_count {
                        let n_cstr: char* = NULL;
                        let v_cstr: char* = NULL;
                        let n_len: u32 = 0;
                        let v_len: u32 = 0;
                        raw {
                            n_cstr = hdr_ptr[2*ri];
                            v_cstr = hdr_ptr[2*ri + 1];
                            n_len = n_cstr ? (uint32_t)strlen(n_cstr) : 0;
                            v_len = v_cstr ? (uint32_t)strlen(v_cstr) : 0;
                        }
                        if n_cstr != NULL && v_cstr != NULL {
                            let n_zv = ctx_intern_string(ctx, n_cstr, n_len);
                            let n_lo = headers_lower(ctx, n_zv);
                            let v_zv = ctx_intern_string(ctx, v_cstr, v_len);
                            object_set(ctx, hbag, zjs_as_string(n_lo), v_zv);
                        }
                        ri = ri + 1;
                    }
                }
            }
            raw {
                ZjsHttpResponse __r;
                __r.status = 0; __r.body = body_ptr; __r.body_len = body_len;
                __r.resp_headers = hdr_ptr; __r.resp_header_count = hdr_count;
                zjs_http_response_free(&__r);
            }
            let resp_v = build_response_object(ctx, status, body_zv, hdrs_v, url_v);
            promise_resolve_with(ctx, promise, resp_v);
        }
        raw { zjs_http_request_destroy((ZjsHttpHandle*)handle); }
        // Don't increment i — swapped-in entry needs polling.
    }
}

// =====================================================================
// Uint8Array (2026-05-18) — first real TypedArray. Byte-buffer backed,
// not just an Array tag — `bytes instanceof Uint8Array` works, .length /
// .byteLength match the spec, indexed read/write goes through
// ToUint8 (modulo 256). ArrayBuffer is deferred; .buffer returns
// undefined for v0.1. Other typed widths (Int8/Uint16/...) will
// layer on this same byte-buffer representation when added.
// =====================================================================

fn host_uint8_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // new Uint8Array(N)           — alloc N zero bytes
    // new Uint8Array(iterable)    — copy from iterable
    // new Uint8Array(arrayLike)   — copy from .length + indexed reads
    let length: u32 = 0;
    let from_iterable: bool = false;
    let from_arraylike: bool = false;
    let src_v: ZjsValue = zjs_undefined();
    if argc == 0 || zjs_is_undefined(args[0]) != 0 {
        // empty
    } else if zjs_is_int32(args[0]) != 0 {
        let n = zjs_as_int32(args[0]);
        if n < 0 {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                        (char*)"Uint8Array length is negative", 29);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        length = (u32)n;
    } else if zjs_is_double(args[0]) != 0 {
        let d = zjs_as_double(args[0]);
        let is_finite: int = 0;
        raw { is_finite = (isfinite(d) && d >= 0.0) ? 1 : 0; }
        if is_finite == 0 {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                        (char*)"Uint8Array length is invalid", 28);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        length = (u32)d;
    } else if zjs_is_uint8_array(args[0]) != 0 {
        // Cloning ctor: copy bytes verbatim.
        let other = zjs_as_uint8_array(args[0]);
        let r = zjs_uint8_array_new(other.length);
        ctx_register_cell(ctx, (void*)r);
        let i: u32 = 0;
        while i < other.length { r.bytes[i] = other.bytes[i]; i = i + 1; }
        return zjs_cell_from_ptr((void*)r);
    } else if zjs_is_array(args[0]) != 0 {
        from_arraylike = true;
        src_v = args[0];
        length = zjs_as_array(args[0]).length;
    } else if zjs_is_object(args[0]) != 0 {
        // Iterable / array-like with .length.
        from_iterable = true;
        src_v = args[0];
    }

    let a = zjs_uint8_array_new(length);
    ctx_register_cell(ctx, (void*)a);
    let a_v = zjs_cell_from_ptr((void*)a);

    if from_arraylike {
        let src = zjs_as_array(src_v);
        let i: u32 = 0;
        while i < src.length {
            let v = src.elements[i];
            let b: u32 = 0;
            if zjs_is_int32(v) != 0 { b = (u32)((i32)zjs_as_int32(v) & 0xff); }
            else if zjs_is_double(v) != 0 {
                let d = zjs_as_double(v);
                let finite: int = 0;
                raw { finite = (isfinite(d) && !isnan(d)) ? 1 : 0; }
                if finite != 0 {
                    let t: i64 = 0;
                    raw { t = (int64_t)d; }
                    b = (u32)((u8)((t % 256 + 256) % 256));
                }
            }
            a.bytes[i] = (u8)b;
            i = i + 1;
        }
    } else if from_iterable {
        // Walk via iter_get / iter_step, growing as needed.
        let iter = iter_get(ctx, src_v);
        if !ctx.pending_throw_active {
            let cap: u32 = 16;
            let count: u32 = 0;
            a.bytes = realloc_n<u8>(a.bytes, (usize)a.capacity, (usize)cap);
            a.capacity = cap;
            while true {
                let step = iter_step(ctx, iter);
                if ctx.pending_throw_active { break; }
                if step.done { break; }
                if count >= cap {
                    let new_cap = cap * 2;
                    a.bytes = realloc_n<u8>(a.bytes, (usize)cap, (usize)new_cap);
                    cap = new_cap;
                }
                let v = step.value;
                let b: u32 = 0;
                if zjs_is_int32(v) != 0 { b = (u32)((i32)zjs_as_int32(v) & 0xff); }
                else if zjs_is_double(v) != 0 {
                    let d = zjs_as_double(v);
                    let finite: int = 0;
                    raw { finite = (isfinite(d) && !isnan(d)) ? 1 : 0; }
                    if finite != 0 {
                        let t: i64 = 0;
                        raw { t = (int64_t)d; }
                        b = (u32)((u8)((t % 256 + 256) % 256));
                    }
                }
                a.bytes[count] = (u8)b;
                count = count + 1;
            }
            a.length = count;
            a.capacity = cap;
        }
    }
    return a_v;
}

// Uint8Array.of(...items) — ECMA-262 §23.2.2.2. Constructs a typed
// array of length argc, with each arg coerced to a byte. Used by uuid
// v3/v5 to build the namespace+name byte buffer.
fn host_uint8_array_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let a = zjs_uint8_array_new(argc);
    ctx_register_cell(ctx, (void*)a);
    let i: u32 = 0;
    while i < argc {
        let v = args[i];
        let b: u32 = 0;
        if zjs_is_int32(v) != 0 { b = (u32)((i32)zjs_as_int32(v) & 0xff); }
        else if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let finite: int = 0;
            raw { finite = (isfinite(d) && !isnan(d)) ? 1 : 0; }
            if finite != 0 {
                let t: i64 = 0;
                raw { t = (int64_t)d; }
                b = (u32)((u8)((t % 256 + 256) % 256));
            }
        }
        a.bytes[i] = (u8)b;
        i = i + 1;
    }
    return zjs_cell_from_ptr((void*)a);
}

// Uint8Array.from(source, mapFn?) — copies + optional element mapping.
// Spec §23.2.2.1. uuid doesn't reach this path but adding it alongside
// .of keeps the static-method shape coherent.
fn host_uint8_array_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_cell_from_ptr((void*)zjs_uint8_array_new(0)); }
    let src = args[0];
    let has_map: bool = argc >= 2 && (zjs_is_function(args[1]) != 0
                                   || zjs_is_closure(args[1]) != 0
                                   || zjs_is_host_function(args[1]) != 0);
    let map_v: ZjsValue = if has_map { args[1] } else { zjs_undefined() };
    // Reuse ctor's array-like path when possible.
    if zjs_is_uint8_array(src) != 0 {
        let other = zjs_as_uint8_array(src);
        let r = zjs_uint8_array_new(other.length);
        ctx_register_cell(ctx, (void*)r);
        let i: u32 = 0;
        while i < other.length {
            let b: u8 = other.bytes[i];
            if has_map {
                let cb_args: ZjsValue[2];
                cb_args[0] = zjs_int32((i32)b);
                cb_args[1] = zjs_int32((i32)i);
                let cb_argp: ZjsValue* = NULL;
                raw { cb_argp = cb_args; }
                let cb_r: ZjsValue = zjs_undefined();
                raw { cb_r = zjs_call_value_with_this(ctx, map_v, zjs_undefined(), cb_argp, 2); }
                if zjs_is_int32(cb_r) != 0 { b = (u8)((i32)zjs_as_int32(cb_r) & 0xff); }
            }
            r.bytes[i] = b;
            i = i + 1;
        }
        return zjs_cell_from_ptr((void*)r);
    }
    if zjs_is_array(src) != 0 {
        let arr = zjs_as_array(src);
        let r = zjs_uint8_array_new(arr.length);
        ctx_register_cell(ctx, (void*)r);
        let i: u32 = 0;
        while i < arr.length {
            let v = arr.elements[i];
            if has_map {
                let cb_args: ZjsValue[2];
                cb_args[0] = v;
                cb_args[1] = zjs_int32((i32)i);
                let cb_argp: ZjsValue* = NULL;
                raw { cb_argp = cb_args; }
                raw { v = zjs_call_value_with_this(ctx, map_v, zjs_undefined(), cb_argp, 2); }
            }
            let b: u32 = 0;
            if zjs_is_int32(v) != 0 { b = (u32)((i32)zjs_as_int32(v) & 0xff); }
            else if zjs_is_double(v) != 0 {
                let d = zjs_as_double(v);
                let finite: int = 0;
                raw { finite = (isfinite(d) && !isnan(d)) ? 1 : 0; }
                if finite != 0 {
                    let t: i64 = 0;
                    raw { t = (int64_t)d; }
                    b = (u32)((u8)((t % 256 + 256) % 256));
                }
            }
            r.bytes[i] = (u8)b;
            i = i + 1;
        }
        return zjs_cell_from_ptr((void*)r);
    }
    // Fall through: delegate to ctor with the source as a single arg.
    let ctor_args: ZjsValue[1];
    ctor_args[0] = src;
    let ctor_argp: ZjsValue* = NULL;
    raw { ctor_argp = ctor_args; }
    return host_uint8_array_ctor(ctx, ctor_argp, 1);
}

fn host_uint8_array_fill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_uint8_array(this_v) == 0 { return this_v; }
    let u = zjs_as_uint8_array(this_v);
    let value_byte: u8 = 0;
    if argc >= 1 {
        let v = args[0];
        if zjs_is_int32(v) != 0 { value_byte = (u8)((i32)zjs_as_int32(v) & 0xff); }
        else if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let finite: int = 0;
            raw { finite = (isfinite(d) && !isnan(d)) ? 1 : 0; }
            if finite != 0 {
                let t: i64 = 0;
                raw { t = (int64_t)d; }
                value_byte = (u8)((t % 256 + 256) % 256);
            }
        }
    }
    let len = u.length;
    let start: i64 = 0;
    let end:   i64 = (i64)len;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let sd = zjs_to_double(args[1]);
        raw { if (isnan(sd)) sd = 0; sd = (sd < 0) ? (sd + (double)len) : sd; }
        start = (i64)sd;
        if start < 0 { start = 0; }
        if start > (i64)len { start = (i64)len; }
    }
    if argc >= 3 && zjs_is_undefined(args[2]) == 0 {
        let ed = zjs_to_double(args[2]);
        raw { if (isnan(ed)) ed = 0; ed = (ed < 0) ? (ed + (double)len) : ed; }
        end = (i64)ed;
        if end < 0 { end = 0; }
        if end > (i64)len { end = (i64)len; }
    }
    let i: i64 = start;
    while i < end { u.bytes[(u32)i] = value_byte; i = i + 1; }
    return this_v;
}

fn host_uint8_array_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_uint8_array(this_v) == 0 { return this_v; }
    let u = zjs_as_uint8_array(this_v);
    let len = u.length;
    let start: i64 = 0;
    let end:   i64 = (i64)len;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        let sd = zjs_to_double(args[0]);
        raw { if (isnan(sd)) sd = 0; sd = (sd < 0) ? (sd + (double)len) : sd; }
        start = (i64)sd;
        if start < 0 { start = 0; }
        if start > (i64)len { start = (i64)len; }
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let ed = zjs_to_double(args[1]);
        raw { if (isnan(ed)) ed = 0; ed = (ed < 0) ? (ed + (double)len) : ed; }
        end = (i64)ed;
        if end < 0 { end = 0; }
        if end > (i64)len { end = (i64)len; }
    }
    if end < start { end = start; }
    let n: u32 = (u32)(end - start);
    let r = zjs_uint8_array_new(n);
    ctx_register_cell(ctx, (void*)r);
    let i: u32 = 0;
    while i < n { r.bytes[i] = u.bytes[(u32)start + i]; i = i + 1; }
    return zjs_cell_from_ptr((void*)r);
}

fn host_uint8_array_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_uint8_array(this_v) == 0 || argc == 0 { return zjs_undefined(); }
    let u = zjs_as_uint8_array(this_v);
    let offset: u32 = 0;
    if argc >= 2 && zjs_is_int32(args[1]) != 0 {
        let oi = zjs_as_int32(args[1]);
        if oi >= 0 { offset = (u32)oi; }
    }
    let src = args[0];
    if zjs_is_uint8_array(src) != 0 {
        let s = zjs_as_uint8_array(src);
        let i: u32 = 0;
        while i < s.length && offset + i < u.length {
            u.bytes[offset + i] = s.bytes[i];
            i = i + 1;
        }
        return zjs_undefined();
    }
    if zjs_is_array(src) != 0 {
        let s = zjs_as_array(src);
        let i: u32 = 0;
        while i < s.length && offset + i < u.length {
            let v = s.elements[i];
            let b: u8 = 0;
            if zjs_is_int32(v) != 0 { b = (u8)((i32)zjs_as_int32(v) & 0xff); }
            else if zjs_is_double(v) != 0 {
                let d = zjs_as_double(v);
                let finite: int = 0;
                raw { finite = (isfinite(d) && !isnan(d)) ? 1 : 0; }
                if finite != 0 {
                    let t: i64 = 0;
                    raw { t = (int64_t)d; }
                    b = (u8)((t % 256 + 256) % 256);
                }
            }
            u.bytes[offset + i] = b;
            i = i + 1;
        }
    }
    return zjs_undefined();
}

fn host_uint8_array_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_uint8_array(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let u = zjs_as_uint8_array(this_v);
    if u.length == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    // Worst case "255," per byte = 4 chars.
    let cap: u32 = u.length * 4 + 1;
    let buf = alloc_n<char>((usize)cap);
    let o: u32 = 0;
    let i: u32 = 0;
    while i < u.length {
        if i > 0 { buf[o] = (char)','; o = o + 1; }
        let n: u32 = (u32)u.bytes[i];
        raw {
            if (n >= 100) buf[o++] = (char)('0' + (n / 100));
            if (n >= 10)  buf[o++] = (char)('0' + ((n / 10) % 10));
            buf[o++] = (char)('0' + (n % 10));
        }
        i = i + 1;
    }
    buf[o] = (char)0;
    let r = ctx_intern_string(ctx, buf, o);
    dealloc(buf);
    return r;
}

// =====================================================================
// TypedArray family (Int8 / Uint8Clamped / Int16 / Uint16 / Int32 /
// Uint32 / Float32 / Float64) + ArrayBuffer + DataView (2026-05-18).
//
// Uint8Array remains on its own tag (legacy fast path); everything
// else shares TAG_TYPED_ARRAY with a `kind` byte discriminating the
// element representation. All non-Uint8 typed arrays are views over a
// real ArrayBuffer — multiple views over the same buffer share bytes,
// matching the spec. Cross-family sharing with Uint8Array is via copy
// for now (Uint8Array.buffer copies bytes into a fresh ArrayBuffer).
// =====================================================================

fn ta_proto_for(ctx: ZjsContext*, kind: u8) -> ZjsObject* {
    if kind == TA_INT8           { return ctx.int8_array_proto; }
    if kind == TA_UINT8          { return ctx.uint8_array_proto; }
    if kind == TA_UINT8_CLAMPED  { return ctx.uint8_clamped_array_proto; }
    if kind == TA_INT16          { return ctx.int16_array_proto; }
    if kind == TA_UINT16         { return ctx.uint16_array_proto; }
    if kind == TA_INT32          { return ctx.int32_array_proto; }
    if kind == TA_UINT32         { return ctx.uint32_array_proto; }
    if kind == TA_FLOAT32        { return ctx.float32_array_proto; }
    if kind == TA_FLOAT64        { return ctx.float64_array_proto; }
    return NULL;
}

fn ta_kind_name(kind: u8) -> char* {
    if kind == TA_INT8           { return (char*)"Int8Array"; }
    if kind == TA_UINT8          { return (char*)"Uint8Array"; }
    if kind == TA_UINT8_CLAMPED  { return (char*)"Uint8ClampedArray"; }
    if kind == TA_INT16          { return (char*)"Int16Array"; }
    if kind == TA_UINT16         { return (char*)"Uint16Array"; }
    if kind == TA_INT32          { return (char*)"Int32Array"; }
    if kind == TA_UINT32         { return (char*)"Uint32Array"; }
    if kind == TA_FLOAT32        { return (char*)"Float32Array"; }
    if kind == TA_FLOAT64        { return (char*)"Float64Array"; }
    return (char*)"TypedArray";
}

// Read element at `idx` from a typed array, return as ZjsValue.
fn ta_load(ta: ZjsTypedArray*, idx: u32) -> ZjsValue {
    if ta == NULL || ta.buffer == NULL || idx >= ta.length { return zjs_undefined(); }
    let byte_idx: u32 = ta.byte_offset + idx * (u32)ta.element_size;
    let bytes_p: u8* = ta.buffer.bytes;
    if ta.kind == TA_INT8 {
        let v: i32 = 0;
        raw { v = (int32_t)(int8_t)bytes_p[byte_idx]; }
        return zjs_int32(v);
    }
    if ta.kind == TA_UINT8 || ta.kind == TA_UINT8_CLAMPED {
        return zjs_int32((i32)bytes_p[byte_idx]);
    }
    if ta.kind == TA_INT16 {
        let v: i32 = 0;
        raw { v = (int32_t)(*(int16_t*)(bytes_p + byte_idx)); }
        return zjs_int32(v);
    }
    if ta.kind == TA_UINT16 {
        let v: i32 = 0;
        raw { v = (int32_t)(*(uint16_t*)(bytes_p + byte_idx)); }
        return zjs_int32(v);
    }
    if ta.kind == TA_INT32 {
        let v: i32 = 0;
        raw { v = *(int32_t*)(bytes_p + byte_idx); }
        return zjs_int32(v);
    }
    if ta.kind == TA_UINT32 {
        let lo: i32 = 0;
        raw { lo = (int32_t)(*(uint32_t*)(bytes_p + byte_idx)); }
        // Values above 2^31 must round-trip through double.
        let d: f64 = 0.0;
        raw { d = (double)(*(uint32_t*)(bytes_p + byte_idx)); }
        return zjs_double(d);
    }
    if ta.kind == TA_FLOAT32 {
        let d: f64 = 0.0;
        raw { d = (double)(*(float*)(bytes_p + byte_idx)); }
        return zjs_double(d);
    }
    if ta.kind == TA_FLOAT64 {
        let d: f64 = 0.0;
        raw { d = *(double*)(bytes_p + byte_idx); }
        return zjs_double(d);
    }
    return zjs_undefined();
}

// Convert a ZjsValue to f64 for typed-array coercion. NaN-safe.
fn ta_to_number(ctx: ZjsContext*, v: ZjsValue) -> f64 {
    if zjs_is_int32(v) != 0  { return (f64)zjs_as_int32(v); }
    if zjs_is_double(v) != 0 { return zjs_as_double(v); }
    if zjs_is_bool(v) != 0   { if zjs_as_bool(v) != 0 { return 1.0; } else { return 0.0; } }
    if zjs_is_null(v) != 0   { return 0.0; }
    if zjs_is_undefined(v) != 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return nan;
    }
    return zjs_to_double(v);
}

// Write `v` at element `idx`. Performs the spec's per-kind coercion
// (mod 2^N for ints, NaN→0 for clamped, round-half-to-even for
// clamped, identity for floats).
fn ta_store(ctx: ZjsContext*, ta: ZjsTypedArray*, idx: u32, v: ZjsValue) -> void {
    if ta == NULL || ta.buffer == NULL || idx >= ta.length { return; }
    let d = ta_to_number(ctx, v);
    let byte_idx: u32 = ta.byte_offset + idx * (u32)ta.element_size;
    let bytes_p: u8* = ta.buffer.bytes;

    if ta.kind == TA_INT8 {
        let i: i32 = 0;
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)dd;
            i = (int32_t)(int8_t)(base & 0xFF);
        }
        raw { bytes_p[byte_idx] = (uint8_t)(i & 0xFF); }
        return;
    }
    if ta.kind == TA_UINT8 {
        raw {
            double dd = d;
            uint32_t base = (isnan(dd) || isinf(dd)) ? 0 : (uint32_t)(int64_t)dd;
            bytes_p[byte_idx] = (uint8_t)(base & 0xFF);
        }
        return;
    }
    if ta.kind == TA_UINT8_CLAMPED {
        raw {
            double dd = d;
            uint8_t r;
            if (isnan(dd))      r = 0;
            else if (dd <= 0.0) r = 0;
            else if (dd >= 255.0) r = 255;
            else {
                // Round half to even.
                double floor_v = floor(dd);
                double diff = dd - floor_v;
                if (diff < 0.5)      r = (uint8_t)floor_v;
                else if (diff > 0.5) r = (uint8_t)(floor_v + 1.0);
                else                 r = (uint8_t)(((int64_t)floor_v) & 1 ? floor_v + 1.0 : floor_v);
            }
            bytes_p[byte_idx] = r;
        }
        return;
    }
    if ta.kind == TA_INT16 {
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)(int64_t)dd;
            *(int16_t*)(bytes_p + byte_idx) = (int16_t)(base & 0xFFFF);
        }
        return;
    }
    if ta.kind == TA_UINT16 {
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)(int64_t)dd;
            *(uint16_t*)(bytes_p + byte_idx) = (uint16_t)(base & 0xFFFF);
        }
        return;
    }
    if ta.kind == TA_INT32 {
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)(int64_t)dd;
            *(int32_t*)(bytes_p + byte_idx) = base;
        }
        return;
    }
    if ta.kind == TA_UINT32 {
        raw {
            double dd = d;
            uint32_t base = (isnan(dd) || isinf(dd)) ? 0 : (uint32_t)(int64_t)dd;
            *(uint32_t*)(bytes_p + byte_idx) = base;
        }
        return;
    }
    if ta.kind == TA_FLOAT32 {
        raw { *(float*)(bytes_p + byte_idx) = (float)d; }
        return;
    }
    if ta.kind == TA_FLOAT64 {
        raw { *(double*)(bytes_p + byte_idx) = d; }
        return;
    }
}

// Shared TypedArray constructor body. Handles all the input shapes:
//   new TA(length)
//   new TA(array | typedArray)         — copy with coercion
//   new TA(buffer)                     — view from byte 0, full length
//   new TA(buffer, byteOffset)         — view from offset to end
//   new TA(buffer, byteOffset, length) — view with explicit element count
fn typed_array_ctor(ctx: ZjsContext*, kind: u8, args: ZjsValue*, argc: u32) -> ZjsValue {
    let es = ta_element_size(kind);
    let ta_proto = ta_proto_for(ctx, kind);

    // No args → empty array.
    if argc == 0 {
        let t = zjs_typed_array_new(kind, 0);
        ctx_register_cell(ctx, (void*)t);
        if t.buffer != NULL { ctx_register_cell(ctx, (void*)t.buffer); }
        return zjs_cell_from_ptr((void*)t);
    }

    let a0 = args[0];

    // ArrayBuffer view path.
    if zjs_is_array_buffer(a0) != 0 {
        let buf = zjs_as_array_buffer(a0);
        let byte_offset: u32 = 0;
        let element_count: u32 = 0;
        if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
            byte_offset = (u32)ta_to_number(ctx, args[1]);
        }
        if byte_offset > buf.length || (byte_offset % (u32)es) != 0 {
            // v0.1: range issues fall back to empty view rather than throw.
            element_count = 0;
            byte_offset = 0;
        } else if argc >= 3 && zjs_is_undefined(args[2]) == 0 {
            element_count = (u32)ta_to_number(ctx, args[2]);
        } else {
            element_count = (buf.length - byte_offset) / (u32)es;
        }
        let t = zjs_typed_array_view(kind, buf, byte_offset, element_count);
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }

    // Copy from another typed array (any kind, including Uint8Array).
    if zjs_is_typed_array(a0) != 0 {
        let src = zjs_as_typed_array(a0);
        let t = zjs_typed_array_new(kind, src.length);
        ctx_register_cell(ctx, (void*)t);
        if t.buffer != NULL { ctx_register_cell(ctx, (void*)t.buffer); }
        let i: u32 = 0;
        while i < src.length {
            ta_store(ctx, t, i, ta_load(src, i));
            i = i + 1;
        }
        return zjs_cell_from_ptr((void*)t);
    }
    if zjs_is_uint8_array(a0) != 0 {
        let u = zjs_as_uint8_array(a0);
        let t = zjs_typed_array_new(kind, u.length);
        ctx_register_cell(ctx, (void*)t);
        if t.buffer != NULL { ctx_register_cell(ctx, (void*)t.buffer); }
        let i: u32 = 0;
        while i < u.length {
            ta_store(ctx, t, i, zjs_int32((i32)u.bytes[i]));
            i = i + 1;
        }
        return zjs_cell_from_ptr((void*)t);
    }

    // Copy from a plain Array.
    if zjs_is_array(a0) != 0 {
        let arr = zjs_as_array(a0);
        let t = zjs_typed_array_new(kind, arr.length);
        ctx_register_cell(ctx, (void*)t);
        if t.buffer != NULL { ctx_register_cell(ctx, (void*)t.buffer); }
        let i: u32 = 0;
        while i < arr.length {
            ta_store(ctx, t, i, arr.elements[i]);
            i = i + 1;
        }
        return zjs_cell_from_ptr((void*)t);
    }

    // Length form.
    let length: u32 = (u32)ta_to_number(ctx, a0);
    let t = zjs_typed_array_new(kind, length);
    ctx_register_cell(ctx, (void*)t);
    if t.buffer != NULL { ctx_register_cell(ctx, (void*)t.buffer); }
    return zjs_cell_from_ptr((void*)t);
}

fn host_int8_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_INT8, args, argc); }
fn host_uint8_clamped_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_UINT8_CLAMPED, args, argc); }
fn host_int16_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_INT16, args, argc); }
fn host_uint16_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_UINT16, args, argc); }
fn host_int32_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_INT32, args, argc); }
fn host_uint32_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_UINT32, args, argc); }
fn host_float32_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_FLOAT32, args, argc); }
fn host_float64_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return typed_array_ctor(ctx, TA_FLOAT64, args, argc); }

fn host_typed_array_fill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_typed_array(this_v) == 0 { return this_v; }
    let ta = zjs_as_typed_array(this_v);
    let val = if argc >= 1 { args[0] } else { zjs_int32(0) };
    let i: u32 = 0;
    while i < ta.length { ta_store(ctx, ta, i, val); i = i + 1; }
    return this_v;
}

fn host_typed_array_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_typed_array(this_v) == 0 { return this_v; }
    let ta = zjs_as_typed_array(this_v);
    let start: u32 = 0;
    let end:   u32 = ta.length;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        let s = (i32)ta_to_number(ctx, args[0]);
        if s < 0 { s = s + (i32)ta.length; }
        if s < 0 { s = 0; }
        if (u32)s > ta.length { s = (i32)ta.length; }
        start = (u32)s;
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let e = (i32)ta_to_number(ctx, args[1]);
        if e < 0 { e = e + (i32)ta.length; }
        if e < 0 { e = 0; }
        if (u32)e > ta.length { e = (i32)ta.length; }
        end = (u32)e;
    }
    if end < start { end = start; }
    let n = end - start;
    let r = zjs_typed_array_new(ta.kind, n);
    ctx_register_cell(ctx, (void*)r);
    if r.buffer != NULL { ctx_register_cell(ctx, (void*)r.buffer); }
    let i: u32 = 0;
    while i < n { ta_store(ctx, r, i, ta_load(ta, start + i)); i = i + 1; }
    return zjs_cell_from_ptr((void*)r);
}

fn host_typed_array_subarray(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_typed_array(this_v) == 0 { return this_v; }
    let ta = zjs_as_typed_array(this_v);
    let start: u32 = 0;
    let end:   u32 = ta.length;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        let s = (i32)ta_to_number(ctx, args[0]);
        if s < 0 { s = s + (i32)ta.length; }
        if s < 0 { s = 0; }
        if (u32)s > ta.length { s = (i32)ta.length; }
        start = (u32)s;
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let e = (i32)ta_to_number(ctx, args[1]);
        if e < 0 { e = e + (i32)ta.length; }
        if e < 0 { e = 0; }
        if (u32)e > ta.length { e = (i32)ta.length; }
        end = (u32)e;
    }
    if end < start { end = start; }
    // Subarray shares the buffer — no copy.
    let r = zjs_typed_array_view(ta.kind, ta.buffer,
                                 ta.byte_offset + start * (u32)ta.element_size,
                                 end - start);
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

fn host_typed_array_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_typed_array(this_v) == 0 || argc == 0 { return zjs_undefined(); }
    let ta = zjs_as_typed_array(this_v);
    let dst_off: u32 = 0;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        dst_off = (u32)ta_to_number(ctx, args[1]);
    }
    let src = args[0];
    if zjs_is_typed_array(src) != 0 {
        let s = zjs_as_typed_array(src);
        let i: u32 = 0;
        while i < s.length && dst_off + i < ta.length {
            ta_store(ctx, ta, dst_off + i, ta_load(s, i));
            i = i + 1;
        }
    } else if zjs_is_uint8_array(src) != 0 {
        let u = zjs_as_uint8_array(src);
        let i: u32 = 0;
        while i < u.length && dst_off + i < ta.length {
            ta_store(ctx, ta, dst_off + i, zjs_int32((i32)u.bytes[i]));
            i = i + 1;
        }
    } else if zjs_is_array(src) != 0 {
        let a = zjs_as_array(src);
        let i: u32 = 0;
        while i < a.length && dst_off + i < ta.length {
            ta_store(ctx, ta, dst_off + i, a.elements[i]);
            i = i + 1;
        }
    }
    return zjs_undefined();
}

fn host_typed_array_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_typed_array(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let ta = zjs_as_typed_array(this_v);
    if ta.length == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    // 32 chars per element is plenty even for doubles in scientific form.
    let cap: usize = (usize)ta.length * 32 + 1;
    let buf = alloc_n<char>(cap);
    let pos: u32 = 0;
    let i: u32 = 0;
    while i < ta.length {
        if i > 0 { buf[pos] = (char)','; pos = pos + 1; }
        let s = zjs_as_string(zjs_to_string(ctx, ta_load(ta, i)));
        let j: u32 = 0;
        while j < s.length { buf[pos] = s.data[j]; pos = pos + 1; j = j + 1; }
        i = i + 1;
    }
    buf[pos] = (char)0;
    let r = ctx_intern_string(ctx, buf, pos);
    dealloc(buf);
    return r;
}

// =====================================================================
// ArrayBuffer host functions.
// =====================================================================

fn host_array_buffer_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let length: u32 = 0;
    if argc >= 1 { length = (u32)ta_to_number(ctx, args[0]); }
    let b = zjs_array_buffer_new(length);
    ctx_register_cell(ctx, (void*)b);
    return zjs_cell_from_ptr((void*)b);
}

fn host_array_buffer_slice(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_array_buffer(this_v) == 0 { return this_v; }
    let b = zjs_as_array_buffer(this_v);
    let start: u32 = 0;
    let end:   u32 = b.length;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        let s = (i32)ta_to_number(ctx, args[0]);
        if s < 0 { s = s + (i32)b.length; }
        if s < 0 { s = 0; }
        if (u32)s > b.length { s = (i32)b.length; }
        start = (u32)s;
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let e = (i32)ta_to_number(ctx, args[1]);
        if e < 0 { e = e + (i32)b.length; }
        if e < 0 { e = 0; }
        if (u32)e > b.length { e = (i32)b.length; }
        end = (u32)e;
    }
    if end < start { end = start; }
    let n = end - start;
    let r = zjs_array_buffer_new(n);
    ctx_register_cell(ctx, (void*)r);
    let i: u32 = 0;
    while i < n { r.bytes[i] = b.bytes[start + i]; i = i + 1; }
    return zjs_cell_from_ptr((void*)r);
}

// =====================================================================
// DataView host functions.
// =====================================================================

fn host_data_view_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 || zjs_is_array_buffer(args[0]) == 0 {
        // v0.1: silently return an empty DataView rather than throwing.
        let empty = zjs_array_buffer_new(0);
        ctx_register_cell(ctx, (void*)empty);
        let d = zjs_data_view_new(empty, 0, 0);
        ctx_register_cell(ctx, (void*)d);
        return zjs_cell_from_ptr((void*)d);
    }
    let buf = zjs_as_array_buffer(args[0]);
    let byte_offset: u32 = 0;
    let byte_length: u32 = buf.length;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        byte_offset = (u32)ta_to_number(ctx, args[1]);
        if byte_offset > buf.length { byte_offset = buf.length; }
        byte_length = buf.length - byte_offset;
    }
    if argc >= 3 && zjs_is_undefined(args[2]) == 0 {
        byte_length = (u32)ta_to_number(ctx, args[2]);
        if byte_offset + byte_length > buf.length {
            byte_length = buf.length - byte_offset;
        }
    }
    let d = zjs_data_view_new(buf, byte_offset, byte_length);
    ctx_register_cell(ctx, (void*)d);
    return zjs_cell_from_ptr((void*)d);
}

// Helpers shared by every DataView getter — return the absolute byte
// index (or 0xFFFFFFFF if out-of-range, signalled to the caller).
fn dv_byte_index(dv: ZjsDataView*, offset: u32, width: u32) -> u32 {
    if offset + width > dv.byte_length { return 0xFFFFFFFF; }
    return dv.byte_offset + offset;
}

fn host_data_view_get(ctx: ZjsContext*, args: ZjsValue*, argc: u32, kind: u8) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_data_view(this_v) == 0 || argc == 0 { return zjs_undefined(); }
    let dv = zjs_as_data_view(this_v);
    let off = (u32)ta_to_number(ctx, args[0]);
    let width: u32 = (u32)ta_element_size(kind);
    let idx = dv_byte_index(dv, off, width);
    if idx == 0xFFFFFFFF { return zjs_undefined(); }
    let little_endian: int = 0;
    if argc >= 2 && zjs_is_bool(args[1]) != 0 && zjs_as_bool(args[1]) != 0 { little_endian = 1; }
    let bytes_p: u8* = dv.buffer.bytes;
    // Read width bytes into a temp buffer, swapping if needed.
    let tmp: u8[8];
    if little_endian != 0 {
        let i: u32 = 0;
        while i < width { tmp[i] = bytes_p[idx + i]; i = i + 1; }
    } else {
        let i: u32 = 0;
        while i < width { tmp[i] = bytes_p[idx + width - 1 - i]; i = i + 1; }
    }
    // Now decode by kind using the local tmp[].
    if kind == TA_INT8 {
        let v: i32 = 0;
        raw { v = (int32_t)(int8_t)tmp[0]; }
        return zjs_int32(v);
    }
    if kind == TA_UINT8 { return zjs_int32((i32)tmp[0]); }
    if kind == TA_INT16  { let v: i32 = 0; raw { v = (int32_t)(*(int16_t*)&tmp[0]); }  return zjs_int32(v); }
    if kind == TA_UINT16 { let v: i32 = 0; raw { v = (int32_t)(*(uint16_t*)&tmp[0]); } return zjs_int32(v); }
    if kind == TA_INT32  { let v: i32 = 0; raw { v = *(int32_t*)&tmp[0]; }              return zjs_int32(v); }
    if kind == TA_UINT32 {
        let d: f64 = 0.0; raw { d = (double)(*(uint32_t*)&tmp[0]); } return zjs_double(d);
    }
    if kind == TA_FLOAT32 { let d: f64 = 0.0; raw { d = (double)(*(float*)&tmp[0]); }   return zjs_double(d); }
    if kind == TA_FLOAT64 { let d: f64 = 0.0; raw { d = *(double*)&tmp[0]; }            return zjs_double(d); }
    return zjs_undefined();
}

fn host_data_view_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32, kind: u8) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_data_view(this_v) == 0 || argc < 2 { return zjs_undefined(); }
    let dv = zjs_as_data_view(this_v);
    let off = (u32)ta_to_number(ctx, args[0]);
    let width: u32 = (u32)ta_element_size(kind);
    let idx = dv_byte_index(dv, off, width);
    if idx == 0xFFFFFFFF { return zjs_undefined(); }
    let little_endian: int = 0;
    if argc >= 3 && zjs_is_bool(args[2]) != 0 && zjs_as_bool(args[2]) != 0 { little_endian = 1; }
    let d = ta_to_number(ctx, args[1]);
    let tmp: u8[8];
    // Encode in little-endian then optionally byte-swap.
    if kind == TA_INT8 {
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)dd;
            tmp[0] = (uint8_t)(base & 0xFF);
        }
    } else if kind == TA_UINT8 {
        raw {
            double dd = d;
            uint32_t base = (isnan(dd) || isinf(dd)) ? 0 : (uint32_t)(int64_t)dd;
            tmp[0] = (uint8_t)(base & 0xFF);
        }
    } else if kind == TA_INT16 {
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)(int64_t)dd;
            *(int16_t*)&tmp[0] = (int16_t)(base & 0xFFFF);
        }
    } else if kind == TA_UINT16 {
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)(int64_t)dd;
            *(uint16_t*)&tmp[0] = (uint16_t)(base & 0xFFFF);
        }
    } else if kind == TA_INT32 {
        raw {
            double dd = d;
            int32_t base = (isnan(dd) || isinf(dd)) ? 0 : (int32_t)(int64_t)dd;
            *(int32_t*)&tmp[0] = base;
        }
    } else if kind == TA_UINT32 {
        raw {
            double dd = d;
            uint32_t base = (isnan(dd) || isinf(dd)) ? 0 : (uint32_t)(int64_t)dd;
            *(uint32_t*)&tmp[0] = base;
        }
    } else if kind == TA_FLOAT32 {
        raw { *(float*)&tmp[0] = (float)d; }
    } else if kind == TA_FLOAT64 {
        raw { *(double*)&tmp[0] = d; }
    }
    let bytes_p: u8* = dv.buffer.bytes;
    if little_endian != 0 {
        let i: u32 = 0;
        while i < width { bytes_p[idx + i] = tmp[i]; i = i + 1; }
    } else {
        let i: u32 = 0;
        while i < width { bytes_p[idx + i] = tmp[width - 1 - i]; i = i + 1; }
    }
    return zjs_undefined();
}

fn host_dv_get_int8(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue   { return host_data_view_get(ctx, args, argc, TA_INT8); }
fn host_dv_get_uint8(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue  { return host_data_view_get(ctx, args, argc, TA_UINT8); }
fn host_dv_get_int16(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue  { return host_data_view_get(ctx, args, argc, TA_INT16); }
fn host_dv_get_uint16(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_get(ctx, args, argc, TA_UINT16); }
fn host_dv_get_int32(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue  { return host_data_view_get(ctx, args, argc, TA_INT32); }
fn host_dv_get_uint32(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_get(ctx, args, argc, TA_UINT32); }
fn host_dv_get_float32(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_get(ctx, args, argc, TA_FLOAT32); }
fn host_dv_get_float64(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_get(ctx, args, argc, TA_FLOAT64); }
fn host_dv_set_int8(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue   { return host_data_view_set(ctx, args, argc, TA_INT8); }
fn host_dv_set_uint8(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue  { return host_data_view_set(ctx, args, argc, TA_UINT8); }
fn host_dv_set_int16(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue  { return host_data_view_set(ctx, args, argc, TA_INT16); }
fn host_dv_set_uint16(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_set(ctx, args, argc, TA_UINT16); }
fn host_dv_set_int32(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue  { return host_data_view_set(ctx, args, argc, TA_INT32); }
fn host_dv_set_uint32(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_set(ctx, args, argc, TA_UINT32); }
fn host_dv_set_float32(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_set(ctx, args, argc, TA_FLOAT32); }
fn host_dv_set_float64(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return host_data_view_set(ctx, args, argc, TA_FLOAT64); }

// =====================================================================
// WebSocket — web-API Phase E (2026-05-18).
//
// Constructor opens an NSURLSessionWebSocketTask via the platform
// shim and registers the cell on ctx.websockets for event-loop
// polling. Event handlers (.onopen/.onmessage/.onerror/.onclose) and
// readyState/url/binaryType/bufferedAmount live on the cell; methods
// (send / close) on websocket_proto.
//
// v0.1 limits (lifted in follow-ups):
//   - protocols argument ignored.
//   - bufferedAmount always returns 0.
//   - binaryType always "arraybuffer"; binary messages arrive as
//     fresh Uint8Array regardless of binaryType setting.
//   - No addEventListener; only on* handlers.
//   - Close event is fired client-side immediately when .close() is
//     called; server-initiated close also fires via the receive
//     completion handler when NSURLSession reports the disconnect.
// =====================================================================

fn ctx_register_websocket(ctx: ZjsContext*, w: ZjsWebSocket*) -> void {
    if ctx.websocket_count >= ctx.websocket_cap {
        let new_cap: u32 = if ctx.websocket_cap == 0 { 4 } else { ctx.websocket_cap * 2 };
        let old_cap = ctx.websocket_cap;
        ctx.websockets = realloc_n<ZjsWebSocket*>(ctx.websockets, (usize)old_cap, (usize)new_cap);
        ctx.websocket_cap = new_cap;
    }
    ctx.websockets[ctx.websocket_count] = w;
    ctx.websocket_count = ctx.websocket_count + 1;
}

fn ctx_unregister_websocket(ctx: ZjsContext*, w: ZjsWebSocket*) -> void {
    let i: u32 = 0;
    while i < ctx.websocket_count {
        if ctx.websockets[i] == w {
            // Swap-with-last + decrement.
            ctx.websocket_count = ctx.websocket_count - 1;
            ctx.websockets[i] = ctx.websockets[ctx.websocket_count];
            return;
        }
        i = i + 1;
    }
}

fn host_websocket_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        return build_typed_error(ctx, (char*)"TypeError", 9,
                                 (char*)"WebSocket: url required", 23);
    }
    let url_v: ZjsValue = args[0];
    if zjs_is_string(url_v) == 0 { url_v = zjs_to_string(ctx, url_v); }
    let us = zjs_as_string(url_v);

    // Parse the second arg as a subprotocol — string or array of
    // strings per the WebSocket constructor spec.
    let protos:  char*[16];
    let pcount:  usize = 0;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 && zjs_is_null(args[1]) == 0 {
        let p_arg = args[1];
        if zjs_is_string(p_arg) != 0 {
            protos[0] = zjs_as_string(p_arg).data;
            pcount = 1;
        } else if zjs_is_array(p_arg) != 0 {
            let a = zjs_as_array(p_arg);
            let ai: u32 = 0;
            while ai < a.length && pcount < 16 {
                let pv = a.elements[ai];
                let ps = if zjs_is_string(pv) != 0 { pv } else { zjs_to_string(ctx, pv) };
                protos[pcount] = zjs_as_string(ps).data;
                pcount = pcount + 1;
                ai = ai + 1;
            }
        }
    }

    let w = zjs_websocket_new(us);
    ctx_register_cell(ctx, (void*)w);

    let h: void* = NULL;
    raw {
        h = (void*)zjs_ws_connect(us->data, (const char**)protos, pcount, 30);
    }
    if h == NULL {
        w.ready_state = 3;
        return build_typed_error(ctx, (char*)"TypeError", 9,
                                 (char*)"WebSocket: connection failed", 28);
    }
    w.native = h;
    ctx_register_websocket(ctx, w);
    return zjs_cell_from_ptr((void*)w);
}

fn host_websocket_send(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_websocket(this_v) == 0 || argc == 0 { return zjs_undefined(); }
    let w = zjs_as_websocket(this_v);
    if w.ready_state != 1 { return zjs_undefined(); }
    let data = args[0];
    if zjs_is_uint8_array(data) != 0 {
        let u = zjs_as_uint8_array(data);
        raw { zjs_ws_send_binary((ZjsWsHandle*)w->native, u->bytes, (size_t)u->length); }
        return zjs_undefined();
    }
    if zjs_is_typed_array(data) != 0 {
        let ta = zjs_as_typed_array(data);
        if ta.buffer != NULL {
            raw {
                zjs_ws_send_binary((ZjsWsHandle*)w->native,
                                   ta->buffer->bytes + ta->byte_offset,
                                   (size_t)(ta->length * (uint32_t)ta->element_size));
            }
        }
        return zjs_undefined();
    }
    if zjs_is_array_buffer(data) != 0 {
        let b = zjs_as_array_buffer(data);
        raw { zjs_ws_send_binary((ZjsWsHandle*)w->native, b->bytes, (size_t)b->length); }
        return zjs_undefined();
    }
    // Text fallback — coerce to string.
    let s_v = if zjs_is_string(data) != 0 { data } else { zjs_to_string(ctx, data) };
    let s = zjs_as_string(s_v);
    raw { zjs_ws_send_text((ZjsWsHandle*)w->native, s->data, (size_t)s->length); }
    return zjs_undefined();
}

fn host_websocket_close(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_websocket(this_v) == 0 { return zjs_undefined(); }
    let w = zjs_as_websocket(this_v);
    if w.ready_state == 2 || w.ready_state == 3 { return zjs_undefined(); }
    let code: i32 = 1000;
    let reason_cstr: char* = NULL;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        code = (i32)ta_to_number(ctx, args[0]);
    }
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let rs = if zjs_is_string(args[1]) != 0 { args[1] } else { zjs_to_string(ctx, args[1]) };
        reason_cstr = zjs_as_string(rs).data;
    }
    w.ready_state = 2;
    raw { zjs_ws_close((ZjsWsHandle*)w->native, (int)code, reason_cstr); }
    return zjs_undefined();
}

// Dispatch an event handler. Builds a tiny event-object literal and
// calls handler(event) with this = the WebSocket. Handler may be
// undefined (no-op) or a function.
fn ws_call_handler(ctx: ZjsContext*, w: ZjsWebSocket*, handler: ZjsValue, event_obj: ZjsValue) -> void {
    if zjs_is_function(handler) == 0 && zjs_is_closure(handler) == 0
       && zjs_is_host_function(handler) == 0 { return; }
    let argv: ZjsValue[1];
    argv[0] = event_obj;
    let this_v = zjs_cell_from_ptr((void*)w);
    let argv_p: ZjsValue* = NULL;
    raw { argv_p = &argv[0]; }
    zjs_call_value_with_this(ctx, handler, this_v, argv_p, 1);
}

// Fire an event on a WebSocket: first the matching on* handler, then
// every addEventListener listener whose type matches.
fn ws_dispatch(ctx: ZjsContext*, w: ZjsWebSocket*, handler: ZjsValue, event_obj: ZjsValue) -> void {
    ws_call_handler(ctx, w, handler, event_obj);
    // Read the event's `type` slot to filter the listener array.
    if w.listener_count == 0 { return; }
    if zjs_is_object(event_obj) == 0 { return; }
    let eo = zjs_as_object(event_obj);
    let type_atom = ctx_intern_atom(ctx, (char*)"type", 4);
    let slot = class_find_slot(eo.cls, type_atom);
    if slot < 0 { return; }
    let type_v = eo.slots[(u32)slot];
    if zjs_is_string(type_v) == 0 { return; }
    let type_s = zjs_as_string(type_v);
    // Snapshot count — a listener may add/remove listeners during dispatch.
    let snap = w.listener_count;
    let i: u32 = 0;
    while i < snap {
        let lt = w.listeners[2 * i];
        let lc = w.listeners[2 * i + 1];
        if zjs_is_string(lt) != 0 {
            let lts = zjs_as_string(lt);
            if zjs_string_equals(lts, type_s) != 0 {
                ws_call_handler(ctx, w, lc, event_obj);
            }
        }
        i = i + 1;
    }
}

// addEventListener — append a (type, callback) pair to the pool.
// Duplicates of the same (type, callback) are de-duplicated per the
// EventTarget spec.
fn host_websocket_add_listener(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_websocket(this_v) == 0 || argc < 2 { return zjs_undefined(); }
    let w = zjs_as_websocket(this_v);
    let type_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let cb_v   = args[1];
    if zjs_is_function(cb_v) == 0 && zjs_is_closure(cb_v) == 0
       && zjs_is_host_function(cb_v) == 0 { return zjs_undefined(); }
    let type_s = zjs_as_string(type_v);
    // De-dup: skip if (type, callback) already registered.
    let i: u32 = 0;
    while i < w.listener_count {
        let lt = w.listeners[2 * i];
        let lc = w.listeners[2 * i + 1];
        if zjs_is_string(lt) != 0 && zjs_string_equals(zjs_as_string(lt), type_s) != 0 {
            if lc.bits == cb_v.bits { return zjs_undefined(); }
        }
        i = i + 1;
    }
    // Grow.
    if w.listener_count >= w.listener_cap {
        let new_cap = if w.listener_cap == 0 { 4 } else { w.listener_cap * 2 };
        let old_pairs = w.listener_cap;
        w.listeners = realloc_n<ZjsValue>(w.listeners, (usize)(old_pairs * 2), (usize)(new_cap * 2));
        w.listener_cap = new_cap;
    }
    w.listeners[2 * w.listener_count]     = type_v;
    w.listeners[2 * w.listener_count + 1] = cb_v;
    w.listener_count = w.listener_count + 1;
    return zjs_undefined();
}

// removeEventListener — find (type, callback) and remove via
// swap-with-last. No-op if not registered.
fn host_websocket_remove_listener(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_websocket(this_v) == 0 || argc < 2 { return zjs_undefined(); }
    let w = zjs_as_websocket(this_v);
    let type_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let cb_v   = args[1];
    let type_s = zjs_as_string(type_v);
    let i: u32 = 0;
    while i < w.listener_count {
        let lt = w.listeners[2 * i];
        let lc = w.listeners[2 * i + 1];
        if zjs_is_string(lt) != 0 && zjs_string_equals(zjs_as_string(lt), type_s) != 0 {
            if lc.bits == cb_v.bits {
                let last = w.listener_count - 1;
                w.listeners[2 * i]     = w.listeners[2 * last];
                w.listeners[2 * i + 1] = w.listeners[2 * last + 1];
                w.listener_count = last;
                return zjs_undefined();
            }
        }
        i = i + 1;
    }
    return zjs_undefined();
}

// dispatchEvent(event) — user-side: fires the same dispatch path.
// Returns true unless preventDefault was called (which we don't
// track at v0.1 — always returns true).
fn host_websocket_dispatch_event(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_websocket(this_v) == 0 || argc == 0 { return zjs_bool(0); }
    let w = zjs_as_websocket(this_v);
    let ev = args[0];
    if zjs_is_object(ev) == 0 { return zjs_bool(0); }
    // Look at .type to pick the matching on* handler.
    let eo = zjs_as_object(ev);
    let type_atom = ctx_intern_atom(ctx, (char*)"type", 4);
    let slot = class_find_slot(eo.cls, type_atom);
    let handler = zjs_undefined();
    if slot >= 0 {
        let type_v = eo.slots[(u32)slot];
        if zjs_is_string(type_v) != 0 {
            let ts = zjs_as_string(type_v);
            let td = ts.data;
            let tl = ts.length;
            let is_open: int = 0;
            let is_msg:  int = 0;
            let is_err:  int = 0;
            let is_cls:  int = 0;
            raw {
                is_open = (tl == 4 && memcmp(td, "open",    4) == 0) ? 1 : 0;
                is_msg  = (tl == 7 && memcmp(td, "message", 7) == 0) ? 1 : 0;
                is_err  = (tl == 5 && memcmp(td, "error",   5) == 0) ? 1 : 0;
                is_cls  = (tl == 5 && memcmp(td, "close",   5) == 0) ? 1 : 0;
            }
            if is_open != 0 { handler = w.on_open; }
            if is_msg  != 0 { handler = w.on_message; }
            if is_err  != 0 { handler = w.on_error; }
            if is_cls  != 0 { handler = w.on_close; }
        }
    }
    ws_dispatch(ctx, w, handler, ev);
    return zjs_bool(1);
}

fn ws_make_event(ctx: ZjsContext*, type_str: char*, type_len: u32,
                 target: ZjsValue) -> ZjsValue {
    let ev = ctx_new_object(ctx);
    let o = zjs_as_object(ev);
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"type", 4),
               ctx_intern_string(ctx, type_str, type_len));
    object_set(ctx, o, ctx_intern_atom(ctx, (char*)"target", 6), target);
    return ev;
}

// Drain pending events from every live WebSocket and dispatch
// handlers. Called from zjs_run_pending_timers on each event-loop
// tick.
fn ws_drain_events(ctx: ZjsContext*) -> void {
    let i: u32 = 0;
    while i < ctx.websocket_count {
        let w = ctx.websockets[i];
        let advanced: int = 1;
        // Drain up to N events per tick to avoid starving timers.
        let drained: u32 = 0;
        while drained < 16 {
            if w == NULL || w.native == NULL { break; }
            let kind: i32 = 0;
            let evt_text: char* = NULL;
            let evt_text_len: usize = 0;
            let evt_bin: u8* = NULL;
            let evt_bin_len: usize = 0;
            let evt_code: i32 = 0;
            raw {
                ZjsWsEvent _e;
                _e.kind = 0; _e.text = NULL; _e.text_len = 0;
                _e.binary = NULL; _e.binary_len = 0; _e.code = 0;
                kind = zjs_ws_poll((ZjsWsHandle*)w->native, &_e);
                evt_text = _e.text; evt_text_len = _e.text_len;
                evt_bin  = _e.binary; evt_bin_len = _e.binary_len;
                evt_code = _e.code;
            }
            if kind == 0 { break; }
            let target = zjs_cell_from_ptr((void*)w);

            if kind == 1 {
                // OPEN — evt_text carries the server-selected
                // subprotocol (or "" if none negotiated).
                w.ready_state = 1;
                if evt_text != NULL {
                    let proto_v = ctx_intern_string(ctx, evt_text, (u32)evt_text_len);
                    w.protocol = zjs_as_string(proto_v);
                    raw { free(evt_text); }
                }
                let ev = ws_make_event(ctx, (char*)"open", 4, target);
                ws_dispatch(ctx, w, w.on_open, ev);
            } else if kind == 2 {
                // MESSAGE_TEXT
                let s_v = ctx_intern_string(ctx, evt_text, (u32)evt_text_len);
                let ev = ws_make_event(ctx, (char*)"message", 7, target);
                object_set(ctx, zjs_as_object(ev), ctx_intern_atom(ctx, (char*)"data", 4), s_v);
                ws_dispatch(ctx, w, w.on_message, ev);
                if evt_text != NULL { raw { free(evt_text); } }
            } else if kind == 3 {
                // MESSAGE_BIN — wrap into a Uint8Array (legacy fast path).
                let u = zjs_uint8_array_new((u32)evt_bin_len);
                ctx_register_cell(ctx, (void*)u);
                raw {
                    if (u->length > 0 && evt_bin != NULL) memcpy(u->bytes, evt_bin, u->length);
                }
                let ev = ws_make_event(ctx, (char*)"message", 7, target);
                object_set(ctx, zjs_as_object(ev), ctx_intern_atom(ctx, (char*)"data", 4),
                           zjs_cell_from_ptr((void*)u));
                ws_dispatch(ctx, w, w.on_message, ev);
                if evt_bin != NULL { raw { free(evt_bin); } }
            } else if kind == 4 {
                // ERROR
                let msg_v = if evt_text != NULL { ctx_intern_string(ctx, evt_text, (u32)evt_text_len) }
                                                else { ctx_intern_string(ctx, (char*)"", 0) };
                let ev = ws_make_event(ctx, (char*)"error", 5, target);
                object_set(ctx, zjs_as_object(ev), ctx_intern_atom(ctx, (char*)"message", 7), msg_v);
                ws_dispatch(ctx, w, w.on_error, ev);
                if evt_text != NULL { raw { free(evt_text); } }
            } else if kind == 5 {
                // CLOSE
                w.ready_state = 3;
                let reason_v = if evt_text != NULL { ctx_intern_string(ctx, evt_text, (u32)evt_text_len) }
                                                   else { ctx_intern_string(ctx, (char*)"", 0) };
                let ev = ws_make_event(ctx, (char*)"close", 5, target);
                object_set(ctx, zjs_as_object(ev), ctx_intern_atom(ctx, (char*)"code", 4),
                           zjs_int32(evt_code));
                object_set(ctx, zjs_as_object(ev), ctx_intern_atom(ctx, (char*)"reason", 6), reason_v);
                object_set(ctx, zjs_as_object(ev), ctx_intern_atom(ctx, (char*)"wasClean", 8),
                           zjs_bool(if evt_code == 1000 { 1 } else { 0 }));
                ws_dispatch(ctx, w, w.on_close, ev);
                if evt_text != NULL { raw { free(evt_text); } }
                // Once closed, remove from polling list so we don't
                // keep walking it forever. Note: this mutates the
                // list mid-iteration; we adjust `i` after.
                ctx_unregister_websocket(ctx, w);
                advanced = 0;
                break;
            }
            drained = drained + 1;
        }
        if advanced != 0 { i = i + 1; }
    }
}

// =====================================================================
// Web-API Phase C (2026-05-18) — TextEncoder / TextDecoder + crypto.
//
// v0.1 limitation: TextEncoder.encode returns a plain Array of bytes
// (not Uint8Array — TypedArrays are deferred; see task #197). For
// `Array.from(encoder.encode(s))` -shaped uses this works fine;
// `bytes instanceof Uint8Array` returns false. TextDecoder accepts
// any iterable of integers in [0, 255]. crypto.getRandomValues takes
// the same array type and fills bytes in place.
// =====================================================================

fn host_text_encoder_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // No internal state — encoding is always UTF-8. Just return an
    // object with the prototype set.
    let obj_v = ctx.host_this;
    if zjs_is_object(obj_v) == 0 { obj_v = ctx_new_object(ctx); }
    let obj = zjs_as_object(obj_v);
    // .encoding is "utf-8" per spec.
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"encoding", 8),
               ctx_intern_string(ctx, (char*)"utf-8", 5));
    return obj_v;
}

// UTF-8 encode `s` into a fresh ZjsArray of byte ints.
fn host_text_encoder_encode(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s_v: ZjsValue = if argc == 0 { ctx_intern_string(ctx, (char*)"", 0) }
                       else if zjs_is_string(args[0]) != 0 { args[0] }
                       else { zjs_to_string(ctx, args[0]) };
    let s = zjs_as_string(s_v);
    // Return a real Uint8Array (WebIDL: Uint8Array). We treat the
    // input as bytes — our strings are already byte sequences and
    // source-level UTF-8 escapes were validated during lexing. So
    // copying byte-for-byte produces a UTF-8 encoding for any
    // source-text-built string. Unicode escape-synthesized strings
    // would need real UTF-16 → UTF-8 transcoding; deferred until
    // there's a proper Unicode rope layer.
    let arr = zjs_uint8_array_new(s.length);
    ctx_register_cell(ctx, (void*)arr);
    raw { if (s->length > 0) memcpy(arr->bytes, s->data, s->length); }
    return zjs_cell_from_ptr((void*)arr);
}

fn host_text_decoder_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let obj_v = ctx.host_this;
    if zjs_is_object(obj_v) == 0 { obj_v = ctx_new_object(ctx); }
    let obj = zjs_as_object(obj_v);
    // We only support utf-8. If the caller passed a label, accept
    // common aliases; otherwise spec says RangeError, but v0.1 is
    // permissive and treats anything as utf-8.
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"encoding", 8),
               ctx_intern_string(ctx, (char*)"utf-8", 5));
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"fatal", 5), zjs_bool(0));
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"ignoreBOM", 9), zjs_bool(0));
    return obj_v;
}

// Decode an Array-of-bytes (or any iterable yielding ints 0..255)
// into a JS string. Bytes pass through as-is; we don't validate
// UTF-8 well-formedness yet (the fatal flag is a no-op for v0.1).
fn host_text_decoder_decode(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let src = args[0];
    if zjs_is_undefined(src) != 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    // Fast path: Uint8Array — direct byte copy.
    if zjs_is_uint8_array(src) != 0 {
        let u = zjs_as_uint8_array(src);
        if u.length == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
        return ctx_intern_string(ctx, (char*)u.bytes, u.length);
    }
    // Fast path: real array of small ints.
    if zjs_is_array(src) != 0 {
        let a = zjs_as_array(src);
        if a.length == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
        let buf = alloc_n<char>((usize)(a.length + 1));
        let i: u32 = 0;
        while i < a.length {
            let v = a.elements[i];
            let b: u32 = 0;
            if zjs_is_int32(v) != 0 { b = (u32)zjs_as_int32(v); }
            else if zjs_is_double(v) != 0 { b = (u32)zjs_as_double(v); }
            buf[i] = (char)(b & 0xff);
            i = i + 1;
        }
        buf[a.length] = (char)0;
        let r = ctx_intern_string(ctx, buf, a.length);
        dealloc(buf);
        return r;
    }
    // Generic iterable. Walk via iter_get / iter_step.
    let iter = iter_get(ctx, src);
    if ctx.pending_throw_active { return zjs_undefined(); }
    let cap: u32 = 64;
    let len: u32 = 0;
    let buf = alloc_n<char>((usize)cap);
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { dealloc(buf); return zjs_undefined(); }
        if step.done { break; }
        if len + 1 >= cap {
            let new_cap = cap * 2;
            buf = realloc_n<char>(buf, (usize)cap, (usize)new_cap);
            cap = new_cap;
        }
        let v = step.value;
        let b: u32 = 0;
        if zjs_is_int32(v) != 0 { b = (u32)zjs_as_int32(v); }
        else if zjs_is_double(v) != 0 { b = (u32)zjs_as_double(v); }
        buf[len] = (char)(b & 0xff);
        len = len + 1;
    }
    buf[len] = (char)0;
    let r = ctx_intern_string(ctx, buf, len);
    dealloc(buf);
    return r;
}

// crypto.randomUUID() — v4 UUID via system entropy. Format:
// xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx where y ∈ {8,9,a,b}.
fn host_crypto_random_uuid(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let bytes: u8[16];
    raw {
        zjs_random_bytes(&bytes[0], 16);
        bytes[6] = (uint8_t)((bytes[6] & 0x0F) | 0x40);  // version 4
        bytes[8] = (uint8_t)((bytes[8] & 0x3F) | 0x80);  // variant
    }
    let buf: char[37];
    raw {
        static const char H[] = "0123456789abcdef";
        int o = 0;
        for (int k = 0; k < 16; k++) {
            if (k == 4 || k == 6 || k == 8 || k == 10) buf[o++] = '-';
            buf[o++] = H[(bytes[k] >> 4) & 0xF];
            buf[o++] = H[ bytes[k]       & 0xF];
        }
        buf[o] = 0;
    }
    let bp: char* = NULL;
    raw { bp = &buf[0]; }
    return ctx_intern_string(ctx, bp, 36);
}

// crypto.getRandomValues(typedArray) — fills `typedArray` with
// random bytes. v0.1 accepts plain Array (each element becomes a
// byte int). Returns the same array (per spec) so callers can chain.
fn host_crypto_get_random_values(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let arr_v = args[0];
    // Uint8Array fast path — write directly into the backing bytes.
    // Without this branch, callers passing the canonical spec'd type
    // (Uint8Array) silently get back an unmodified buffer because the
    // generic-array fallback below requires `.elements[]`.
    if zjs_is_uint8_array(arr_v) != 0 {
        let u = zjs_as_uint8_array(arr_v);
        if u.length > 0 { raw { zjs_random_bytes(u->bytes, u->length); } }
        return arr_v;
    }
    if zjs_is_array(arr_v) == 0 { return arr_v; }
    let a = zjs_as_array(arr_v);
    if a.length == 0 { return arr_v; }
    let buf = alloc_n<u8>((usize)a.length);
    raw { zjs_random_bytes(buf, a->length); }
    let i: u32 = 0;
    while i < a.length {
        a.elements[i] = zjs_int32((i32)(u32)buf[i]);
        i = i + 1;
    }
    dealloc(buf);
    return arr_v;
}

// crypto.subtle.digest(algorithm, data) — one-shot message digest.
// Returns a Promise<Uint8Array>. Spec says ArrayBuffer; we hand back
// Uint8Array until the engine grows a clean ArrayBuffer-return path
// from C. Most consumers already wrap with `new Uint8Array(buf)`.
//
// `algorithm` may be the string 'SHA-1' / 'SHA-256' / 'SHA-384' /
// 'SHA-512', or an object `{ name: 'SHA-256' }` (the spec also
// accepts the latter).
fn host_crypto_subtle_digest(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    if argc < 2 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"digest requires (algorithm, data)", 33);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // Resolve algorithm name → numeric algo code.
    let alg_v = args[0];
    if zjs_is_object(alg_v) != 0 && zjs_is_string(alg_v) == 0 {
        alg_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"name", 4));
    }
    if zjs_is_string(alg_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"digest algorithm must be a string", 33);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let algo_str = zjs_as_string(alg_v);
    let algo_n: int = -1;
    raw {
        if (algo_str->length == 5 && memcmp(algo_str->data, "SHA-1", 5) == 0) algo_n = 1;
        else if (algo_str->length == 7 && memcmp(algo_str->data, "SHA-256", 7) == 0) algo_n = 256;
        else if (algo_str->length == 7 && memcmp(algo_str->data, "SHA-384", 7) == 0) algo_n = 384;
        else if (algo_str->length == 7 && memcmp(algo_str->data, "SHA-512", 7) == 0) algo_n = 512;
    }
    if algo_n < 0 {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"Unrecognized digest algorithm", 29);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // Extract data bytes — accept Uint8Array, other TypedArrays, or
    // ArrayBuffer. For first cut, Uint8Array only.
    let data_v = args[1];
    let data_ptr: u8* = NULL;
    let data_len: u32 = 0;
    if zjs_is_uint8_array(data_v) != 0 {
        let u = zjs_as_uint8_array(data_v);
        data_ptr = u.bytes;
        data_len = u.length;
    } else if zjs_is_string(data_v) != 0 {
        // Treat string as utf-8 bytes — convenient for `digest('SHA-256', 'hello')`.
        let s = zjs_as_string(data_v);
        raw { data_ptr = (uint8_t*)s->data; }
        data_len = s.length;
    } else {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"digest data must be a Uint8Array or string", 42);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let out_buf: u8[64];
    let out_len: usize = 0;
    let rc: int = 0;
    raw {
        rc = zjs_digest_oneshot(algo_n, data_ptr, (size_t)data_len, &out_buf[0], &out_len);
    }
    if rc != 0 {
        let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                    (char*)"digest backend failed", 21);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let result = zjs_uint8_array_new((u32)out_len);
    ctx_register_cell(ctx, (void*)result);
    raw { memcpy(result->bytes, &out_buf[0], out_len); }
    promise_settle(ctx, pv, zjs_cell_from_ptr((void*)result), true);
    return pv;
}

// Helpers for crypto.subtle.{importKey,sign,verify}. Resolves the
// HMAC hash algorithm number (1/256/384/512) from a string or
// {name: 'HMAC', hash: 'SHA-256'} object. Returns -1 on unknown.
fn crypto_resolve_hash_algo(ctx: ZjsContext*, alg_v: ZjsValue) -> int {
    let name_v = alg_v;
    if zjs_is_object(alg_v) != 0 && zjs_is_string(alg_v) == 0 {
        // For HMAC the hash sits at .hash (string or object).
        let h = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"hash", 4));
        if zjs_is_object(h) != 0 && zjs_is_string(h) == 0 {
            name_v = property_get(ctx, h, ctx_intern_string(ctx, (char*)"name", 4));
        } else {
            name_v = h;
        }
    }
    if zjs_is_string(name_v) == 0 { return -1; }
    let s = zjs_as_string(name_v);
    let algo: int = -1;
    raw {
        if (s->length == 5 && memcmp(s->data, "SHA-1", 5) == 0) algo = 1;
        else if (s->length == 7 && memcmp(s->data, "SHA-256", 7) == 0) algo = 256;
        else if (s->length == 7 && memcmp(s->data, "SHA-384", 7) == 0) algo = 384;
        else if (s->length == 7 && memcmp(s->data, "SHA-512", 7) == 0) algo = 512;
    }
    return algo;
}

// Extract bytes from a Uint8Array or string. Writes (ptr, len) to
// the output pointers. Returns true on success. String is treated as
// utf-8 bytes (matches digest's input convention).
fn crypto_extract_bytes(v: ZjsValue, out_ptr: u8**, out_len: u32*) -> bool {
    if zjs_is_uint8_array(v) != 0 {
        let u = zjs_as_uint8_array(v);
        out_ptr[0] = u.bytes;
        out_len[0] = u.length;
        return true;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        raw { *out_ptr = (uint8_t*)s->data; }
        out_len[0] = s.length;
        return true;
    }
    return false;
}

// crypto.subtle.importKey(format, keyData, algorithm, extractable, keyUsages)
// MVP: format must be 'raw'; algorithm.name must be 'HMAC'; returns a
// CryptoKey-shaped object carrying the raw bytes + algorithm so sign/
// verify can use them. Not extractable in any meaningful sense.
fn host_crypto_subtle_import_key(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    if argc < 3 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"importKey requires (format, keyData, algorithm, ...)", 51);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // format
    let fmt_v = args[0];
    let fmt_ok: bool = false;
    if zjs_is_string(fmt_v) != 0 {
        let fs = zjs_as_string(fmt_v);
        raw { if (fs->length == 3 && memcmp(fs->data, "raw", 3) == 0) fmt_ok = true; }
    }
    if !fmt_ok {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"Only 'raw' importKey format supported", 37);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // algorithm.name must be HMAC
    let alg = args[2];
    let alg_name_v: ZjsValue = alg;
    if zjs_is_object(alg) != 0 && zjs_is_string(alg) == 0 {
        alg_name_v = property_get(ctx, alg, ctx_intern_string(ctx, (char*)"name", 4));
    }
    if zjs_is_string(alg_name_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"algorithm.name required", 23);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let an = zjs_as_string(alg_name_v);
    let is_hmac:    bool = false;
    let is_aes_gcm: bool = false;
    let is_pbkdf2:  bool = false;
    let is_hkdf:    bool = false;
    raw {
        if (an->length == 4 && memcmp(an->data, "HMAC", 4) == 0) is_hmac = true;
        else if (an->length == 7 && memcmp(an->data, "AES-GCM", 7) == 0) is_aes_gcm = true;
        else if (an->length == 6 && memcmp(an->data, "PBKDF2", 6) == 0) is_pbkdf2 = true;
        else if (an->length == 4 && memcmp(an->data, "HKDF", 4) == 0) is_hkdf = true;
    }
    if !is_hmac && !is_aes_gcm && !is_pbkdf2 && !is_hkdf {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"Only HMAC / AES-GCM / PBKDF2 / HKDF importKey supported", 55);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let hash_algo: int = -1;
    if is_hmac {
        hash_algo = crypto_resolve_hash_algo(ctx, alg);
        if hash_algo < 0 {
            let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                        (char*)"Unrecognized HMAC hash", 22);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
    }
    // keyData → copy bytes into a fresh Uint8Array so mutation
    // through the caller's reference doesn't affect future sign/verify.
    let kd = args[1];
    let kp: u8* = NULL;
    let klen: u32 = 0;
    if !crypto_extract_bytes(kd, &kp, &klen) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"keyData must be Uint8Array or string", 36);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // AES key length must be 128/192/256 bits (16/24/32 bytes).
    if is_aes_gcm && klen != 16 && klen != 24 && klen != 32 {
        let err = build_typed_error(ctx, (char*)"DataError", 9,
                                    (char*)"AES-GCM key must be 16/24/32 bytes", 34);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let key_bytes = zjs_uint8_array_new(klen);
    ctx_register_cell(ctx, (void*)key_bytes);
    if klen > 0 { raw { memcpy(key_bytes->bytes, kp, klen); } }
    // Build the CryptoKey object — opaque shape mirroring the web
    // spec's accessors. Internal slots are prefixed `__` so they're
    // filtered from Object.keys / for-in.
    let key_obj_v = ctx_new_object(ctx);
    let key_obj = zjs_as_object(key_obj_v);
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"type", 4),
               ctx_intern_string(ctx, (char*)"secret", 6));
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"extractable", 11),
               zjs_bool(if argc >= 4 { (if zjs_to_bool_coerce(args[3]) { 1 } else { 0 }) } else { 0 }));
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"algorithm", 9), alg);
    let usages_v = if argc >= 5 { args[4] } else { ctx_new_array(ctx, 0) };
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"usages", 6), usages_v);
    // Internal slots — hidden from Object.keys via the __ prefix.
    // __zjs_key_kind discriminates between HMAC and AES-* keys so
    // sign/verify and encrypt/decrypt know what to do with it.
    // __zjs_key_algo means the HMAC hash code (1/256/384/512) for HMAC
    // keys; for AES it's the key length in bytes (16/24/32).
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_bytes", 15),
               zjs_cell_from_ptr((void*)key_bytes));
    if is_hmac {
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"HMAC", 4));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32((i32)hash_algo));
    } else if is_aes_gcm {
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"AES-GCM", 7));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32((i32)klen));
    } else if is_pbkdf2 {
        // Derivation base key — material is the password; no fixed hash
        // (the digest is chosen per-derive in deriveBits's params).
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"PBKDF2", 6));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32(0));
    } else {
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"HKDF", 4));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32(0));
    }
    promise_settle(ctx, pv, key_obj_v, true);
    return pv;
}

// Read the CryptoKey's __zjs_key_kind string slot. Returns "HMAC" /
// "AES-GCM" / NULL (caller treats NULL as TypeError-worthy).
fn crypto_key_kind(ctx: ZjsContext*, key_v: ZjsValue) -> ZjsString* {
    if zjs_is_object(key_v) == 0 { return NULL; }
    let k = property_get(ctx, key_v, ctx_intern_string(ctx, (char*)"__zjs_key_kind", 14));
    if zjs_is_string(k) == 0 { return NULL; }
    return zjs_as_string(k);
}

fn crypto_key_is_hmac(ctx: ZjsContext*, key_v: ZjsValue) -> bool {
    let k = crypto_key_kind(ctx, key_v);
    if k == NULL { return false; }
    let r: bool = false;
    raw { if (k->length == 4 && memcmp(k->data, "HMAC", 4) == 0) r = true; }
    return r;
}

fn crypto_key_is_aes_gcm(ctx: ZjsContext*, key_v: ZjsValue) -> bool {
    let k = crypto_key_kind(ctx, key_v);
    if k == NULL { return false; }
    let r: bool = false;
    raw { if (k->length == 7 && memcmp(k->data, "AES-GCM", 7) == 0) r = true; }
    return r;
}

// Shared body for crypto.subtle.encrypt / .decrypt. AES-GCM only for
// the first cut — CBC/CTR/RSA-OAEP land later.
//
//   args[0] = algorithm: { name: 'AES-GCM', iv: Uint8Array(12),
//                          additionalData?: Uint8Array, tagLength?: 128 }
//   args[1] = CryptoKey
//   args[2] = data: Uint8Array (plaintext on encrypt;
//                                  ciphertext||tag on decrypt)
fn crypto_encrypt_or_decrypt(ctx: ZjsContext*, args: ZjsValue*, argc: u32, is_decrypt: bool) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    if argc < 3 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"encrypt/decrypt: bad arity", 26);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let alg_v = args[0];
    let key_v = args[1];
    let data_v = args[2];

    // Resolve algorithm name. Accept a bare string or {name:...}.
    let alg_name_v: ZjsValue = alg_v;
    if zjs_is_object(alg_v) != 0 && zjs_is_string(alg_v) == 0 {
        alg_name_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"name", 4));
    }
    if zjs_is_string(alg_name_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"algorithm.name required", 23);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let an = zjs_as_string(alg_name_v);
    let is_aes_gcm: bool = false;
    raw { if (an->length == 7 && memcmp(an->data, "AES-GCM", 7) == 0) is_aes_gcm = true; }
    if !is_aes_gcm {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"Only AES-GCM encrypt/decrypt supported", 38);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    if !crypto_key_is_aes_gcm(ctx, key_v) {
        let err = build_typed_error(ctx, (char*)"InvalidAccessError", 18,
                                    (char*)"key is not an AES-GCM CryptoKey", 31);
        promise_settle(ctx, pv, err, false);
        return pv;
    }

    // IV: required, must be Uint8Array of length 12. (The spec allows
    // 1..2^61-1 bits but in practice 96 bits is the only safe choice
    // and what every consumer uses — we enforce it.)
    let iv_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"iv", 2));
    let iv_p: u8* = NULL;
    let iv_n: u32 = 0;
    if !crypto_extract_bytes(iv_v, &iv_p, &iv_n) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"AES-GCM requires algorithm.iv (Uint8Array)", 42);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    if iv_n != 12 {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"AES-GCM iv must be 12 bytes", 27);
        promise_settle(ctx, pv, err, false);
        return pv;
    }

    // AAD: optional. NULL/0 is fine.
    let aad_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"additionalData", 14));
    let aad_p: u8* = NULL;
    let aad_n: u32 = 0;
    if zjs_is_undefined(aad_v) == 0 {
        if !crypto_extract_bytes(aad_v, &aad_p, &aad_n) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"algorithm.additionalData must be Uint8Array", 43);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
    }

    // tagLength: optional. We only support 128.
    let tl_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"tagLength", 9));
    if zjs_is_undefined(tl_v) == 0 {
        let tl: f64 = zjs_to_double(tl_v);
        if tl != 128.0 {
            let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                        (char*)"AES-GCM tagLength must be 128", 29);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
    }

    // Key bytes.
    let kb_v = property_get(ctx, key_v, ctx_intern_string(ctx, (char*)"__zjs_key_bytes", 15));
    if zjs_is_uint8_array(kb_v) == 0 {
        let err = build_typed_error(ctx, (char*)"InvalidAccessError", 18,
                                    (char*)"key is not a CryptoKey from this engine", 39);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let kb = zjs_as_uint8_array(kb_v);

    // Input bytes.
    let in_p: u8* = NULL;
    let in_n: u32 = 0;
    if !crypto_extract_bytes(data_v, &in_p, &in_n) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"data must be Uint8Array or string", 33);
        promise_settle(ctx, pv, err, false);
        return pv;
    }

    if is_decrypt {
        // Decrypt: input = ciphertext || 16-byte tag.
        if in_n < 16 {
            let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                        (char*)"AES-GCM ciphertext shorter than tag", 35);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
        let ct_n = in_n - 16;
        let result = zjs_uint8_array_new(ct_n);
        ctx_register_cell(ctx, (void*)result);
        let tag: u8[16];
        raw { memcpy(&tag[0], in_p + ct_n, 16); }
        let rc: int = 0;
        raw {
            rc = zjs_aes_gcm_oneshot(0,
                                     kb->bytes, (size_t)kb->length,
                                     iv_p, (size_t)iv_n,
                                     aad_p, (size_t)aad_n,
                                     in_p, (size_t)ct_n,
                                     result->bytes,
                                     &tag[0]);
        }
        if rc != 0 {
            let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                        (char*)"AES-GCM decrypt failed (auth or backend)", 40);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
        promise_settle(ctx, pv, zjs_cell_from_ptr((void*)result), true);
        return pv;
    }

    // Encrypt: output = ciphertext (in_n bytes) || 16-byte tag.
    let result = zjs_uint8_array_new(in_n + 16);
    ctx_register_cell(ctx, (void*)result);
    let tag: u8[16];
    let rc: int = 0;
    raw {
        rc = zjs_aes_gcm_oneshot(1,
                                 kb->bytes, (size_t)kb->length,
                                 iv_p, (size_t)iv_n,
                                 aad_p, (size_t)aad_n,
                                 in_p, (size_t)in_n,
                                 result->bytes,
                                 &tag[0]);
    }
    if rc != 0 {
        let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                    (char*)"AES-GCM encrypt failed", 22);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    raw { memcpy(result->bytes + in_n, &tag[0], 16); }
    promise_settle(ctx, pv, zjs_cell_from_ptr((void*)result), true);
    return pv;
}

fn host_crypto_subtle_encrypt(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return crypto_encrypt_or_decrypt(ctx, args, argc, false);
}
fn host_crypto_subtle_decrypt(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return crypto_encrypt_or_decrypt(ctx, args, argc, true);
}

// crypto.subtle.generateKey(algorithm, extractable, keyUsages).
// AES-GCM uses algorithm.length (bits); HMAC uses algorithm.hash to
// pick a hash and emits a key sized to that hash's block size.
fn host_crypto_subtle_generate_key(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    if argc < 1 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"generateKey requires algorithm", 30);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let alg = args[0];
    let alg_name_v: ZjsValue = alg;
    if zjs_is_object(alg) != 0 && zjs_is_string(alg) == 0 {
        alg_name_v = property_get(ctx, alg, ctx_intern_string(ctx, (char*)"name", 4));
    }
    if zjs_is_string(alg_name_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"algorithm.name required", 23);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let an = zjs_as_string(alg_name_v);
    let is_hmac:    bool = false;
    let is_aes_gcm: bool = false;
    raw {
        if (an->length == 4 && memcmp(an->data, "HMAC", 4) == 0) is_hmac = true;
        else if (an->length == 7 && memcmp(an->data, "AES-GCM", 7) == 0) is_aes_gcm = true;
    }
    if !is_hmac && !is_aes_gcm {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"generateKey: HMAC / AES-GCM only", 32);
        promise_settle(ctx, pv, err, false);
        return pv;
    }

    let key_len: u32 = 0;
    let hash_algo: int = -1;
    if is_aes_gcm {
        let len_v = property_get(ctx, alg, ctx_intern_string(ctx, (char*)"length", 6));
        let bits: f64 = zjs_to_double(len_v);
        if bits != 128.0 && bits != 192.0 && bits != 256.0 {
            let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                        (char*)"AES-GCM length must be 128/192/256", 34);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
        key_len = ((u32)bits) / 8;
    } else {
        hash_algo = crypto_resolve_hash_algo(ctx, alg);
        if hash_algo < 0 {
            let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                        (char*)"Unrecognized HMAC hash", 22);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
        // Block size in bytes per the spec: 64 for SHA-1/256, 128 for SHA-384/512.
        if hash_algo == 1 || hash_algo == 256 { key_len = 64; }
        else { key_len = 128; }
    }

    let key_bytes = zjs_uint8_array_new(key_len);
    ctx_register_cell(ctx, (void*)key_bytes);
    let rc: int = 0;
    raw { rc = zjs_random_bytes_oneshot(key_bytes->bytes, (size_t)key_len); }
    if rc != 0 {
        let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                    (char*)"random source unavailable", 25);
        promise_settle(ctx, pv, err, false);
        return pv;
    }

    let key_obj_v = ctx_new_object(ctx);
    let key_obj = zjs_as_object(key_obj_v);
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"type", 4),
               ctx_intern_string(ctx, (char*)"secret", 6));
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"extractable", 11),
               zjs_bool(if argc >= 2 { (if zjs_to_bool_coerce(args[1]) { 1 } else { 0 }) } else { 1 }));
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"algorithm", 9), alg);
    let usages_v = if argc >= 3 { args[2] } else { ctx_new_array(ctx, 0) };
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"usages", 6), usages_v);
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_bytes", 15),
               zjs_cell_from_ptr((void*)key_bytes));
    if is_hmac {
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"HMAC", 4));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32((i32)hash_algo));
    } else {
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"AES-GCM", 7));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32((i32)key_len));
    }
    promise_settle(ctx, pv, key_obj_v, true);
    return pv;
}

// crypto.subtle.exportKey(format, key) — raw format only for now.
// Returns a copy of the key bytes so caller mutation can't poison the
// internal slot.
fn host_crypto_subtle_export_key(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    if argc < 2 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"exportKey requires (format, key)", 32);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let fmt_v = args[0];
    let key_v = args[1];
    let fmt_ok: bool = false;
    if zjs_is_string(fmt_v) != 0 {
        let fs = zjs_as_string(fmt_v);
        raw { if (fs->length == 3 && memcmp(fs->data, "raw", 3) == 0) fmt_ok = true; }
    }
    if !fmt_ok {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"Only 'raw' exportKey format supported", 37);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let ext_v = property_get(ctx, key_v, ctx_intern_string(ctx, (char*)"extractable", 11));
    if zjs_to_bool_coerce(ext_v) == false {
        let err = build_typed_error(ctx, (char*)"InvalidAccessError", 18,
                                    (char*)"key is not extractable", 22);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let kb_v = property_get(ctx, key_v, ctx_intern_string(ctx, (char*)"__zjs_key_bytes", 15));
    if zjs_is_uint8_array(kb_v) == 0 {
        let err = build_typed_error(ctx, (char*)"InvalidAccessError", 18,
                                    (char*)"key is not a CryptoKey from this engine", 39);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let kb = zjs_as_uint8_array(kb_v);
    let result = zjs_uint8_array_new(kb.length);
    ctx_register_cell(ctx, (void*)result);
    if kb.length > 0 { raw { memcpy(result->bytes, kb->bytes, kb->length); } }
    promise_settle(ctx, pv, zjs_cell_from_ptr((void*)result), true);
    return pv;
}

// Shared sign / verify body. mode=0 sign, mode=1 verify.
fn crypto_sign_or_verify(ctx: ZjsContext*, args: ZjsValue*, argc: u32, is_verify: bool) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    let want_argc: u32 = if is_verify { 4 } else { 3 };
    if argc < want_argc {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"sign/verify: bad arity", 22);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let key_v = args[1];
    if zjs_is_object(key_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"key must be a CryptoKey", 23);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // Reject non-HMAC CryptoKeys (e.g. AES-GCM keys would otherwise
    // pass the int32/Uint8Array check and run HMAC on AES key bytes).
    if !crypto_key_is_hmac(ctx, key_v) {
        let err = build_typed_error(ctx, (char*)"InvalidAccessError", 18,
                                    (char*)"key is not an HMAC CryptoKey", 28);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let algo_v = property_get(ctx, key_v, ctx_intern_string(ctx, (char*)"__zjs_key_algo", 14));
    let key_bytes_v = property_get(ctx, key_v, ctx_intern_string(ctx, (char*)"__zjs_key_bytes", 15));
    if zjs_is_int32(algo_v) == 0 || zjs_is_uint8_array(key_bytes_v) == 0 {
        let err = build_typed_error(ctx, (char*)"InvalidAccessError", 18,
                                    (char*)"key is not a CryptoKey from this engine", 39);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let algo = (int)zjs_as_int32(algo_v);
    let key_arr = zjs_as_uint8_array(key_bytes_v);
    let key_p: u8* = key_arr.bytes;
    let key_n: u32 = key_arr.length;
    let data_idx: u32 = if is_verify { 3 } else { 2 };
    let data_p: u8* = NULL;
    let data_n: u32 = 0;
    if !crypto_extract_bytes(args[data_idx], &data_p, &data_n) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"data must be Uint8Array or string", 33);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let mac: u8[64];
    let mac_len: usize = 0;
    let rc: int = 0;
    raw {
        rc = zjs_hmac_oneshot(algo, key_p, (size_t)key_n,
                              data_p, (size_t)data_n,
                              &mac[0], &mac_len);
    }
    if rc != 0 {
        let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                    (char*)"HMAC backend failed", 19);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    if is_verify {
        let sig_p: u8* = NULL;
        let sig_n: u32 = 0;
        if !crypto_extract_bytes(args[2], &sig_p, &sig_n) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"signature must be Uint8Array", 28);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
        let eq: bool = false;
        if sig_n == (u32)mac_len {
            // Constant-time compare. Compiler is free to optimize but
            // the early-exit ladder we'd write naively leaks timing,
            // so OR the diffs.
            let acc: u32 = 0;
            let i: u32 = 0;
            while i < sig_n {
                acc = acc | (u32)((u8)sig_p[i] ^ mac[i]);
                i = i + 1;
            }
            eq = acc == 0;
        }
        promise_settle(ctx, pv, zjs_bool(if eq { 1 } else { 0 }), true);
        return pv;
    }
    // sign: hand back a Uint8Array with the MAC.
    let result = zjs_uint8_array_new((u32)mac_len);
    ctx_register_cell(ctx, (void*)result);
    raw { memcpy(result->bytes, &mac[0], mac_len); }
    promise_settle(ctx, pv, zjs_cell_from_ptr((void*)result), true);
    return pv;
}

fn host_crypto_subtle_sign(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return crypto_sign_or_verify(ctx, args, argc, false);
}
fn host_crypto_subtle_verify(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return crypto_sign_or_verify(ctx, args, argc, true);
}

// Core key derivation for deriveBits / deriveKey. `alg_v` is the
// algorithm params ({name:'PBKDF2', hash, salt, iterations} or
// {name:'HKDF', hash, salt, info}); key_v is a PBKDF2/HKDF base key.
// Returns a registered Uint8Array of `dklen` bytes on success; sets
// ok[0]=0 (and returns NULL) on any validation/backend failure.
fn crypto_derive_raw(ctx: ZjsContext*, alg_v: ZjsValue, key_v: ZjsValue,
                     dklen: u32, ok: int*) -> ZjsUint8Array* {
    ok[0] = 1;
    let kind = crypto_key_kind(ctx, key_v);
    if kind == NULL { ok[0] = 0; return NULL; }
    let is_pbkdf2: bool = false;
    let is_hkdf:   bool = false;
    raw {
        if (kind->length == 6 && memcmp(kind->data, "PBKDF2", 6) == 0) is_pbkdf2 = true;
        else if (kind->length == 4 && memcmp(kind->data, "HKDF", 4) == 0) is_hkdf = true;
    }
    if !is_pbkdf2 && !is_hkdf { ok[0] = 0; return NULL; }
    let hash_algo = crypto_resolve_hash_algo(ctx, alg_v);
    if hash_algo < 0 { ok[0] = 0; return NULL; }
    let kb_v = property_get(ctx, key_v, ctx_intern_string(ctx, (char*)"__zjs_key_bytes", 15));
    if zjs_is_uint8_array(kb_v) == 0 { ok[0] = 0; return NULL; }
    let kb = zjs_as_uint8_array(kb_v);
    let key_p: u8* = kb.bytes;
    let key_n: u32 = kb.length;
    // salt (PBKDF2 mandatory; HKDF optional → empty).
    let salt_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"salt", 4));
    let salt_p: u8* = NULL;
    let salt_n: u32 = 0;
    if zjs_is_undefined(salt_v) == 0 {
        if !crypto_extract_bytes(salt_v, &salt_p, &salt_n) { ok[0] = 0; return NULL; }
    } else if is_pbkdf2 {
        ok[0] = 0; return NULL;   // PBKDF2 requires a salt
    }
    let out = zjs_uint8_array_new(dklen);
    ctx_register_cell(ctx, (void*)out);
    let out_p: u8* = out.bytes;
    let rc: int = -1;
    if is_pbkdf2 {
        let iter_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"iterations", 10));
        let iters: u32 = (u32)zjs_to_double(iter_v);
        if iters == 0 { ok[0] = 0; return NULL; }
        raw {
            rc = zjs_pbkdf2_oneshot(hash_algo, key_p, (size_t)key_n,
                                    salt_p, (size_t)salt_n, iters,
                                    (size_t)dklen, out_p);
        }
    } else {
        let info_v = property_get(ctx, alg_v, ctx_intern_string(ctx, (char*)"info", 4));
        let info_p: u8* = NULL;
        let info_n: u32 = 0;
        if zjs_is_undefined(info_v) == 0 {
            if !crypto_extract_bytes(info_v, &info_p, &info_n) { ok[0] = 0; return NULL; }
        }
        raw {
            rc = zjs_hkdf_oneshot(hash_algo, key_p, (size_t)key_n,
                                  salt_p, (size_t)salt_n,
                                  info_p, (size_t)info_n,
                                  (size_t)dklen, out_p);
        }
    }
    if rc != 0 { ok[0] = 0; return NULL; }
    return out;
}

// crypto.subtle.deriveBits(algorithm, baseKey, length) → ArrayBuffer
// (returned as a Uint8Array, matching digest's convention). length is
// in BITS and must be a multiple of 8.
fn host_crypto_subtle_derive_bits(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    if argc < 3 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"deriveBits requires (algorithm, baseKey, length)", 48);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let bits = (i64)zjs_to_double(args[2]);
    if bits <= 0 || (bits % 8) != 0 {
        let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                    (char*)"length must be a positive multiple of 8", 39);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let ok: int = 1;
    let out = crypto_derive_raw(ctx, args[0], args[1], (u32)(bits / 8), &ok);
    if ok == 0 || out == NULL {
        let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                    (char*)"key derivation failed (unsupported params or backend)", 53);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    promise_settle(ctx, pv, zjs_cell_from_ptr((void*)out), true);
    return pv;
}

// crypto.subtle.deriveKey(algorithm, baseKey, derivedKeyType,
// extractable, keyUsages) → CryptoKey. Derives raw bits then wraps them
// as an HMAC or AES-GCM key (the two key kinds importKey produces).
fn host_crypto_subtle_derive_key(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    if argc < 3 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"deriveKey requires (algorithm, baseKey, derivedKeyType, ...)", 60);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let dkt = args[2];
    let dkt_name_v: ZjsValue = dkt;
    if zjs_is_object(dkt) != 0 && zjs_is_string(dkt) == 0 {
        dkt_name_v = property_get(ctx, dkt, ctx_intern_string(ctx, (char*)"name", 4));
    }
    if zjs_is_string(dkt_name_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"derivedKeyType.name required", 28);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let dn = zjs_as_string(dkt_name_v);
    let want_hmac: bool = false;
    let want_aes:  bool = false;
    raw {
        if (dn->length == 4 && memcmp(dn->data, "HMAC", 4) == 0) want_hmac = true;
        else if (dn->length == 7 && memcmp(dn->data, "AES-GCM", 7) == 0) want_aes = true;
    }
    if !want_hmac && !want_aes {
        let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                    (char*)"derivedKeyType must be HMAC or AES-GCM", 38);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // Determine derived length in bytes + the key's stored hash/length slot.
    let dk_hash: int = 256;
    let dklen: u32 = 32;
    if want_hmac {
        dk_hash = crypto_resolve_hash_algo(ctx, dkt);
        if dk_hash < 0 {
            let err = build_typed_error(ctx, (char*)"NotSupportedError", 17,
                                        (char*)"Unrecognized HMAC hash", 22);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
        // HMAC key length defaults to the hash's block size.
        if dk_hash == 1 || dk_hash == 256 { dklen = 64; } else { dklen = 128; }
        let len_v = property_get(ctx, dkt, ctx_intern_string(ctx, (char*)"length", 6));
        if zjs_is_undefined(len_v) == 0 {
            let lb = (i64)zjs_to_double(len_v);
            if lb > 0 && (lb % 8) == 0 { dklen = (u32)(lb / 8); }
        }
    } else {
        let len_v = property_get(ctx, dkt, ctx_intern_string(ctx, (char*)"length", 6));
        let lb = (i64)zjs_to_double(len_v);
        if lb != 128 && lb != 192 && lb != 256 {
            let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                        (char*)"AES-GCM length must be 128/192/256", 34);
            promise_settle(ctx, pv, err, false);
            return pv;
        }
        dklen = (u32)(lb / 8);
    }
    let ok: int = 1;
    let derived = crypto_derive_raw(ctx, args[0], args[1], dklen, &ok);
    if ok == 0 || derived == NULL {
        let err = build_typed_error(ctx, (char*)"OperationError", 14,
                                    (char*)"key derivation failed (unsupported params or backend)", 53);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    // Wrap as a CryptoKey mirroring importKey's shape.
    let key_obj_v = ctx_new_object(ctx);
    let key_obj = zjs_as_object(key_obj_v);
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"type", 4),
               ctx_intern_string(ctx, (char*)"secret", 6));
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"extractable", 11),
               zjs_bool(if argc >= 4 { (if zjs_to_bool_coerce(args[3]) { 1 } else { 0 }) } else { 0 }));
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"algorithm", 9), dkt);
    let usages_v = if argc >= 5 { args[4] } else { ctx_new_array(ctx, 0) };
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"usages", 6), usages_v);
    object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_bytes", 15),
               zjs_cell_from_ptr((void*)derived));
    if want_hmac {
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"HMAC", 4));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32((i32)dk_hash));
    } else {
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_kind", 14),
                   ctx_intern_string(ctx, (char*)"AES-GCM", 7));
        object_set(ctx, key_obj, ctx_intern_atom(ctx, (char*)"__zjs_key_algo", 14),
                   zjs_int32((i32)dklen));
    }
    promise_settle(ctx, pv, key_obj_v, true);
    return pv;
}

// zlib one-shot codec backing node:zlib + CompressionStream. Exposed as
// the global __zjs_zlib(fmt, isCompress, data, level). fmt: 0 zlib /
// 1 gzip / 2 raw. Returns a Uint8Array; throws on backend failure or
// when zlib isn't available (Windows).
fn host_zlib_codec(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 3 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"__zjs_zlib(fmt, compress, data[, level])", 41);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let fmt = (int)zjs_to_double(args[0]);
    let is_compress = zjs_to_bool_coerce(args[1]) != 0;
    let dp: u8* = NULL;
    let dn: u32 = 0;
    if !crypto_extract_bytes(args[2], &dp, &dn) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"data must be a Uint8Array or string", 35);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let level: int = if argc >= 4 { (int)zjs_to_double(args[3]) } else { -1 };
    let out_p: u8* = NULL;
    let out_len: usize = 0;
    let rc: int = -1;
    raw {
        if (is_compress) rc = zjs_zlib_compress(fmt, dp, (size_t)dn, level, &out_p, &out_len);
        else             rc = zjs_zlib_decompress(fmt, dp, (size_t)dn, &out_p, &out_len);
    }
    if rc != 0 {
        let err = build_typed_error(ctx, (char*)"Error", 5,
                                    (char*)"zlib operation failed (or zlib unavailable on this platform)", 60);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let result = zjs_uint8_array_new((u32)out_len);
    ctx_register_cell(ctx, (void*)result);
    if out_len > 0 { raw { memcpy(result->bytes, out_p, out_len); } }
    raw { if (out_p) free(out_p); }
    return zjs_cell_from_ptr((void*)result);
}

// =====================================================================
// Timers — web-API Phase B (2026-05-18). setTimeout / setInterval /
// clear* as globals. The engine maintains a queue of pending timers;
// embedders ask "when's the next one?" via zjs_next_timer_ms and
// fire what's ready via zjs_run_pending_timers. The CLI bundles a
// poll-based loop so `zjs run file.js` drives the queue.
// =====================================================================

// Monotonic-now in ms. Same source perf.now() returns.
fn timer_now_ms() -> f64 {
    let ms: f64 = 0.0;
    raw {
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        ms = (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
    }
    return ms;
}

fn timer_install(ctx: ZjsContext*, handler: ZjsValue, delay_ms: f64, period_ms: f64,
                 args: ZjsValue*, argc: u32) -> u32 {
    if ctx.timer_count >= ctx.timer_cap {
        let new_cap: u32 = if ctx.timer_cap == 0 { 8 } else { ctx.timer_cap * 2 };
        ctx.timers = realloc_n<ZjsTimer>(ctx.timers, (usize)ctx.timer_cap, (usize)new_cap);
        ctx.timer_cap = new_cap;
    }
    ctx.next_timer_id = ctx.next_timer_id + 1;
    let id = ctx.next_timer_id;
    let due = timer_now_ms() + delay_ms;
    let t = ctx.timers + ctx.timer_count;
    t.id        = id;
    t.due_ms    = due;
    t.period_ms = period_ms;
    t.cancelled = false;
    t.handler   = handler;
    t.argc      = argc;
    if argc > 0 {
        t.args = alloc_n<ZjsValue>((usize)argc);
        let i: u32 = 0;
        while i < argc { t.args[i] = args[i]; i = i + 1; }
    } else {
        t.args = NULL;
    }
    ctx.timer_count = ctx.timer_count + 1;
    return id;
}

fn timer_cancel(ctx: ZjsContext*, id: u32) -> void {
    let i: u32 = 0;
    while i < ctx.timer_count {
        if ctx.timers[i].id == id { ctx.timers[i].cancelled = true; return; }
        i = i + 1;
    }
}

// Compact: drop cancelled entries from the queue, freeing their args
// buffers. Called after a sweep so the array doesn't accumulate dead
// reservations.
fn timer_compact(ctx: ZjsContext*) -> void {
    let read: u32 = 0;
    let write: u32 = 0;
    while read < ctx.timer_count {
        let t = ctx.timers + read;
        if t.cancelled {
            if t.args != NULL { dealloc(t.args); }
        } else {
            if write != read { ctx.timers[write] = ctx.timers[read]; }
            write = write + 1;
        }
        read = read + 1;
    }
    ctx.timer_count = write;
}

fn coerce_delay_ms(ctx: ZjsContext*, v: ZjsValue) -> f64 {
    if zjs_is_undefined(v) != 0 { return 0.0; }
    let d = zjs_to_double(v);
    raw { if (isnan(d) || d < 0.0) d = 0.0; }
    return d;
}

fn host_set_timeout(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_int32(0); }
    let cb = args[0];
    let callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb)  != 0
        || zjs_is_host_function(cb) != 0;
    if !callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"setTimeout requires a function", 30);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let delay: f64 = if argc >= 2 { coerce_delay_ms(ctx, args[1]) } else { 0.0 };
    let extra_args: ZjsValue* = NULL;
    let extra_n: u32 = if argc > 2 { argc - 2 } else { 0 };
    if extra_n > 0 { extra_args = args + 2; }
    let id = timer_install(ctx, cb, delay, 0.0, extra_args, extra_n);
    return zjs_int32((i32)id);
}

fn host_set_interval(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_int32(0); }
    let cb = args[0];
    let callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb)  != 0
        || zjs_is_host_function(cb) != 0;
    if !callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"setInterval requires a function", 31);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let delay: f64 = if argc >= 2 { coerce_delay_ms(ctx, args[1]) } else { 0.0 };
    // Spec: an interval of < 1ms gets clamped (browsers actually
    // clamp to 4ms after nesting depth 5; we keep a flat 0-floor
    // and let the host loop decide). Use the same value for both
    // initial delay and the repeating period.
    let extra_args: ZjsValue* = NULL;
    let extra_n: u32 = if argc > 2 { argc - 2 } else { 0 };
    if extra_n > 0 { extra_args = args + 2; }
    let id = timer_install(ctx, cb, delay, delay, extra_args, extra_n);
    return zjs_int32((i32)id);
}

fn host_clear_timeout(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    if zjs_is_int32(v) != 0 {
        let id = (u32)zjs_as_int32(v);
        timer_cancel(ctx, id);
    } else if zjs_is_double(v) != 0 {
        timer_cancel(ctx, (u32)zjs_as_double(v));
    }
    return zjs_undefined();
}

fn zjs_has_pending_work(ctx: ZjsContext*) -> int {
    if ctx == NULL { return 0; }
    if ctx.microtask_count > 0 { return 1; }
    let i: u32 = 0;
    while i < ctx.timer_count {
        if !ctx.timers[i].cancelled { return 1; }
        i = i + 1;
    }
    // Live WebSockets force the loop to keep ticking so we can
    // deliver async events (open / message / error / close).
    if ctx.websocket_count > 0 { return 1; }
    if ctx.pending_fetch_count > 0 { return 1; }
    if ctx.net_server_count > 0 { return 1; }
    return 0;
}

// Returns ms until the next timer is due. Negative or 0 means "fire
// now". -1 (or a very negative number) when there are no timers. Use
// in conjunction with zjs_run_pending_timers in an embedder loop:
//
//   while (zjs_has_pending_work(ctx)) {
//       int64_t wait = zjs_next_timer_ms(ctx);
//       if (wait > 0) sleep(wait);
//       zjs_run_pending_timers(ctx);
//   }
fn zjs_next_timer_ms(ctx: ZjsContext*) -> i64 {
    if ctx == NULL { return -1; }
    let now = timer_now_ms();
    let best: f64 = 0.0;
    let have: bool = false;
    let i: u32 = 0;
    while i < ctx.timer_count {
        let t = ctx.timers + i;
        if !t.cancelled {
            let delta = t.due_ms - now;
            if !have || delta < best { best = delta; have = true; }
        }
        i = i + 1;
    }
    if !have { return -1; }
    if best < 0.0 { return 0; }
    return (i64)best;
}

// Fire every timer whose due time has arrived. After each callback,
// drain microtasks (per spec — a task always settles its microtasks
// before the next task). setInterval re-arms; setTimeout deletes.
// Cancellations and throws inside callbacks are absorbed so the loop
// keeps running.
fn zjs_run_pending_timers(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    // Drain any pending WebSocket events FIRST so message handlers
    // run on the same tick as timers (matches platform semantics
    // where I/O completion can race with setTimeout).
    if ctx.websocket_count > 0 { ws_drain_events(ctx); }
    if ctx.pending_fetch_count > 0 { http_drain_pending_fetches(ctx); }
    if ctx.net_server_count > 0 { ctx_net_pump_all(ctx); }
    // Drain microtasks unconditionally. Promise resolutions from
    // fetch / WS event handlers enqueue .then callbacks as
    // microtasks — without this, an async fetch with no timers in
    // the queue would leave its callback un-fired forever.
    drain_microtasks(ctx);
    let now = timer_now_ms();
    // Snapshot which entries are due. Callbacks may install new
    // timers — those have due_ms > now and won't fire in this pass.
    let i: u32 = 0;
    while i < ctx.timer_count {
        let t = ctx.timers + i;
        if !t.cancelled && t.due_ms <= now {
            // Capture before firing — t may shift if the handler
            // mutates the timers array (we'd realloc).
            let handler = t.handler;
            let argc    = t.argc;
            // Copy args into a local buffer so a callback that
            // installs more timers (which may realloc t.args's
            // backing) doesn't yank our argv pointer.
            let argbuf: ZjsValue[16];
            let argp: ZjsValue* = NULL;
            let alloc_local: bool = false;
            if argc <= 16 {
                raw { argp = &argbuf[0]; }
                let ai: u32 = 0;
                while ai < argc { argp[ai] = t.args[ai]; ai = ai + 1; }
            } else {
                argp = alloc_n<ZjsValue>((usize)argc);
                alloc_local = true;
                let ai: u32 = 0;
                while ai < argc { argp[ai] = t.args[ai]; ai = ai + 1; }
            }
            let period = t.period_ms;
            if period > 0.0 {
                t.due_ms = now + period;
            } else {
                t.cancelled = true;
            }
            let r: ZjsValue = zjs_undefined();
            raw { r = zjs_call_value_with_this(ctx, handler, zjs_undefined(), argp, argc); }
            // Surface uncaught throws via had_error so the embedder
            // can decide to bail; clear pending_throw so the next
            // timer still runs.
            if ctx.pending_throw_active {
                ctx.had_error  = true;
                ctx.last_error = consume_pending_throw(ctx);
            }
            if alloc_local { dealloc(argp); }
            drain_microtasks(ctx);
        }
        i = i + 1;
    }
    timer_compact(ctx);
}

// Public ABI: drain pending microtasks now. Embedders call this after
// resolving/rejecting a Promise from C (uv I/O completion, etc.) so
// the .then continuations execute before the next host work item.
// Safe to call at any time; idempotent when the queue is empty.
fn zjs_drain_microtasks(ctx: ZjsContext*) -> void {
    if ctx == NULL { return; }
    drain_microtasks(ctx);
}

// =====================================================================
// WHATWG URL — v0.1 (2026-05-18). A pragmatic parser that covers the
// shapes real npm packages reach for (http/https/file URLs, relative
// resolution against a base, search/hash extraction). Skipped:
// Punycode/IDN, blob:/data: opaque hosts, strict percent-encoding
// validation. URL instances are plain ZjsObjects whose internal
// components live as own properties under __zjs_url_*__ atoms;
// prototype getters read those slots.
// =====================================================================

def URL_PROTOCOL_KEY: char* = (char*)"__zjs_url_protocol__";
def URL_USERNAME_KEY: char* = (char*)"__zjs_url_username__";
def URL_PASSWORD_KEY: char* = (char*)"__zjs_url_password__";
def URL_HOSTNAME_KEY: char* = (char*)"__zjs_url_hostname__";
def URL_PORT_KEY:     char* = (char*)"__zjs_url_port__";
def URL_PATHNAME_KEY: char* = (char*)"__zjs_url_pathname__";
def URL_SEARCH_KEY:   char* = (char*)"__zjs_url_search__";
def URL_HASH_KEY:     char* = (char*)"__zjs_url_hash__";

fn url_set_str(ctx: ZjsContext*, obj: ZjsObject*, key: char*, key_len: u32, data: char*, len: u32) -> void {
    let atom = ctx_intern_atom(ctx, key, key_len);
    let s_v: ZjsValue = if len == 0 { ctx_intern_string(ctx, (char*)"", 0) }
                       else        { ctx_intern_string(ctx, data, len) };
    object_set(ctx, obj, atom, s_v);
}

fn url_get_str(obj: ZjsObject*, ctx: ZjsContext*, key: char*, key_len: u32) -> ZjsValue {
    let atom = ctx_intern_atom(ctx, key, key_len);
    let slot = class_find_slot(obj.cls, atom);
    if slot < 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    return obj.slots[(u32)slot];
}

// Lowercase ASCII alpha in-place. Used for scheme normalization.
fn url_ascii_lower_dup(ctx: ZjsContext*, src: char*, len: u32) -> ZjsValue {
    if len == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let buf = alloc_n<char>((usize)(len + 1));
    let i: u32 = 0;
    while i < len {
        let c = src[i];
        let cl: char = c;
        raw {
            if (c >= 'A' && c <= 'Z') cl = (char)(c + 32);
        }
        buf[i] = cl;
        i = i + 1;
    }
    buf[len] = (char)0;
    let r = ctx_intern_string(ctx, buf, len);
    dealloc(buf);
    return r;
}

// Is the input a valid ASCII scheme prefix? Returns the length of the
// scheme (including the trailing ':') or 0 if no scheme is present.
// Scheme: ALPHA followed by ALPHA / DIGIT / + / - / . , terminated by ':'.
fn url_scan_scheme(data: char*, len: u32) -> u32 {
    if len == 0 { return 0; }
    let c0 = data[0];
    let is_alpha0: bool = false;
    raw { is_alpha0 = ((c0 >= 'a' && c0 <= 'z') || (c0 >= 'A' && c0 <= 'Z')); }
    if !is_alpha0 { return 0; }
    let i: u32 = 1;
    while i < len {
        let c = data[i];
        let ok: bool = false;
        raw {
            ok = ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                || (c >= '0' && c <= '9')
                || c == '+' || c == '-' || c == '.');
        }
        if c == (char)':' { return i + 1; }
        if !ok { return 0; }
        i = i + 1;
    }
    return 0;
}

// Find an ASCII char in [s, s+len). Returns the index (relative to s)
// or len if not found.
fn url_find_char(s: char*, len: u32, target: char) -> u32 {
    let i: u32 = 0;
    while i < len {
        if s[i] == target { return i; }
        i = i + 1;
    }
    return len;
}

// Resolve `dir_len` so that base.pathname[0..dir_len] is the dirname.
// (i.e. the last '/' plus 1; if the base has no '/' we use the whole thing.)
fn url_pathname_dirname_len(s: char*, len: u32) -> u32 {
    let i: u32 = len;
    while i > 0 {
        if s[i - 1] == (char)'/' { return i; }
        i = i - 1;
    }
    return 0;
}

// Normalize `./` and `../` segments in-place on a path buffer.
// Mirrors the helper in module_resolve_specifier; duplicated here so
// URL parsing isn't load-bearing on the module loader's lifetime.
fn url_normalize_path(buf: char*, len: u32) -> u32 {
    let new_len: u32 = len;
    raw {
        char* out = buf;
        char* in_ = buf;
        char* end = buf + len;
        while (in_ < end) {
            if (in_ + 2 < end && in_[0] == '/' && in_[1] == '.' && in_[2] == '/') {
                in_ += 2;
                continue;
            }
            // Trailing "/." (RFC 3986 §5.2.4) -> "/": e.g. "/a/b/." -> "/a/b/".
            if (in_ + 2 == end && in_[0] == '/' && in_[1] == '.') {
                *out++ = '/';
                in_ += 2;
                continue;
            }
            if (in_ + 3 <= end && in_[0] == '/' && in_[1] == '.' && in_[2] == '.'
                && (in_ + 3 == end || in_[3] == '/')) {
                // RFC 3986 §5.2.4: remove the last output segment AND its
                // preceding '/'. The '/' that follows ".." in the input
                // (or, for a trailing "/..", the implicit one we add
                // below) supplies the separator before the next segment,
                // so dropping the preceding slash here avoids a doubled
                // slash (e.g. "/a/b/../d" -> "/a/d", not "/a//d").
                if (out > buf) out--;                          // back over the segment's last char
                while (out > buf && *(out - 1) != '/') out--;  // ... rest of the segment
                if (out > buf) out--;                          // ... and its leading '/'
                in_ += 3;
                // A trailing "/.." (no following slash) must still leave a
                // directory slash, e.g. "/a/b/.." -> "/a/". Re-add it.
                if (in_ == end) { *out++ = '/'; }
                continue;
            }
            *out++ = *in_++;
        }
        new_len = (uint32_t)(out - buf);
    }
    return new_len;
}

// Parse `input` (length `ilen`) into the URL components on `obj`. If
// `base_obj` is non-NULL and `input` is relative, the missing parts
// (protocol, host, etc.) come from the base. Returns true on success.
fn parse_url_into(ctx: ZjsContext*, obj: ZjsObject*, input: char*, ilen: u32, base_obj: ZjsObject*) -> bool {
    // Strip leading and trailing ASCII whitespace.
    let s: u32 = 0;
    let e: u32 = ilen;
    while s < e {
        let c = input[s];
        let is_ws: bool = false;
        raw { is_ws = (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'); }
        if !is_ws { break; }
        s = s + 1;
    }
    while e > s {
        let c = input[e - 1];
        let is_ws: bool = false;
        raw { is_ws = (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'); }
        if !is_ws { break; }
        e = e - 1;
    }
    let body = input + s;
    let bl   = e - s;

    let scheme_len = url_scan_scheme(body, bl);
    let has_scheme = scheme_len > 0;
    let cur: u32 = 0;

    if has_scheme {
        // scheme = body[0..scheme_len-1], plus the ':' is already included
        // (scheme_len includes it).
        url_set_str(ctx, obj, URL_PROTOCOL_KEY, 20, body, scheme_len);
        cur = scheme_len;
    } else if base_obj != NULL {
        // No scheme — inherit from base.
        let proto_v = url_get_str(base_obj, ctx, URL_PROTOCOL_KEY, 20);
        if zjs_is_string(proto_v) != 0 {
            let pp = zjs_as_string(proto_v);
            url_set_str(ctx, obj, URL_PROTOCOL_KEY, 20, pp.data, pp.length);
        } else {
            url_set_str(ctx, obj, URL_PROTOCOL_KEY, 20, (char*)"", 0);
        }
    } else {
        return false;   // no scheme and no base → invalid
    }

    let has_authority: bool = false;
    // Authority is present when "//" follows the scheme, OR for a
    // scheme-relative reference ("//host/path" with no scheme of its own
    // — it inherits only the scheme from base, set above). #327. When
    // there's no scheme we already required a base, so the second arm of
    // the guard always holds there; it's kept explicit for clarity.
    if cur + 2 <= bl && body[cur] == (char)'/' && body[cur + 1] == (char)'/'
       && (has_scheme || base_obj != NULL) {
        cur = cur + 2;
        has_authority = true;
    }

    if has_authority {
        // Authority spans until '/', '?', '#', or end.
        let auth_start = cur;
        while cur < bl {
            let c = body[cur];
            if c == (char)'/' || c == (char)'?' || c == (char)'#' { break; }
            cur = cur + 1;
        }
        let auth_end = cur;
        let auth_data = body + auth_start;
        let auth_len  = auth_end - auth_start;
        // Userinfo split: rightmost '@' inside [auth_data, auth_data+auth_len).
        let at_idx: i32 = -1;
        let scan: u32 = 0;
        while scan < auth_len {
            if auth_data[scan] == (char)'@' { at_idx = (i32)scan; }
            scan = scan + 1;
        }
        let host_start: u32 = 0;
        if at_idx >= 0 {
            // userinfo = [0..at_idx). Split on first ':'.
            let ui_data = auth_data;
            let ui_len  = (u32)at_idx;
            let colon = url_find_char(ui_data, ui_len, (char)':');
            url_set_str(ctx, obj, URL_USERNAME_KEY, 20, ui_data, colon);
            if colon < ui_len {
                url_set_str(ctx, obj, URL_PASSWORD_KEY, 20, ui_data + colon + 1, ui_len - colon - 1);
            } else {
                url_set_str(ctx, obj, URL_PASSWORD_KEY, 20, (char*)"", 0);
            }
            host_start = (u32)at_idx + 1;
        } else {
            url_set_str(ctx, obj, URL_USERNAME_KEY, 20, (char*)"", 0);
            url_set_str(ctx, obj, URL_PASSWORD_KEY, 20, (char*)"", 0);
        }
        // Host[:port] = [host_start..auth_len).
        let host_data = auth_data + host_start;
        let host_len  = auth_len - host_start;
        // Find port colon. IPv6 hosts in [...] aren't fully handled —
        // we look for the last ':' outside brackets.
        let port_at: i32 = -1;
        let in_brackets: bool = false;
        let hi: u32 = 0;
        while hi < host_len {
            let c = host_data[hi];
            if c == (char)'[' { in_brackets = true; }
            else if c == (char)']' { in_brackets = false; }
            else if c == (char)':' && !in_brackets { port_at = (i32)hi; }
            hi = hi + 1;
        }
        if port_at >= 0 {
            url_set_str(ctx, obj, URL_HOSTNAME_KEY, 20, host_data, (u32)port_at);
            url_set_str(ctx, obj, URL_PORT_KEY, 16, host_data + (u32)port_at + 1, host_len - (u32)port_at - 1);
        } else {
            url_set_str(ctx, obj, URL_HOSTNAME_KEY, 20, host_data, host_len);
            url_set_str(ctx, obj, URL_PORT_KEY, 16, (char*)"", 0);
        }
    } else if base_obj != NULL {
        // Inherit authority from base.
        let bp = url_get_str(base_obj, ctx, URL_USERNAME_KEY, 20);
        if zjs_is_string(bp) != 0 {
            let bs = zjs_as_string(bp);
            url_set_str(ctx, obj, URL_USERNAME_KEY, 20, bs.data, bs.length);
        }
        let bq = url_get_str(base_obj, ctx, URL_PASSWORD_KEY, 20);
        if zjs_is_string(bq) != 0 {
            let bs2 = zjs_as_string(bq);
            url_set_str(ctx, obj, URL_PASSWORD_KEY, 20, bs2.data, bs2.length);
        }
        let bh = url_get_str(base_obj, ctx, URL_HOSTNAME_KEY, 20);
        if zjs_is_string(bh) != 0 {
            let bs3 = zjs_as_string(bh);
            url_set_str(ctx, obj, URL_HOSTNAME_KEY, 20, bs3.data, bs3.length);
        }
        let bo = url_get_str(base_obj, ctx, URL_PORT_KEY, 16);
        if zjs_is_string(bo) != 0 {
            let bs4 = zjs_as_string(bo);
            url_set_str(ctx, obj, URL_PORT_KEY, 16, bs4.data, bs4.length);
        }
    } else {
        url_set_str(ctx, obj, URL_USERNAME_KEY, 20, (char*)"", 0);
        url_set_str(ctx, obj, URL_PASSWORD_KEY, 20, (char*)"", 0);
        url_set_str(ctx, obj, URL_HOSTNAME_KEY, 20, (char*)"", 0);
        url_set_str(ctx, obj, URL_PORT_KEY,     16, (char*)"", 0);
    }

    // Path = until '?', '#', or end. Search = '?' to '#' or end.
    // Hash = '#' to end.
    let path_start = cur;
    while cur < bl {
        let c = body[cur];
        if c == (char)'?' || c == (char)'#' { break; }
        cur = cur + 1;
    }
    let path_end = cur;
    let path_data = body + path_start;
    let path_len  = path_end - path_start;

    if path_len > 0 {
        // Relative path with a base — resolve against the base's dirname.
        let resolve_against_base: bool = false;
        if !has_authority && base_obj != NULL && path_data[0] != (char)'/' {
            resolve_against_base = true;
        }
        if resolve_against_base {
            let base_path_v = url_get_str(base_obj, ctx, URL_PATHNAME_KEY, 20);
            if zjs_is_string(base_path_v) != 0 {
                let bps = zjs_as_string(base_path_v);
                let dir_len = url_pathname_dirname_len(bps.data, bps.length);
                let total = dir_len + path_len;
                let buf = alloc_n<char>((usize)(total + 1));
                let i: u32 = 0;
                while i < dir_len { buf[i] = bps.data[i]; i = i + 1; }
                let j: u32 = 0;
                while j < path_len { buf[dir_len + j] = path_data[j]; j = j + 1; }
                buf[total] = (char)0;
                let new_len = url_normalize_path(buf, total);
                url_set_str(ctx, obj, URL_PATHNAME_KEY, 20, buf, new_len);
                dealloc(buf);
            } else {
                url_set_str(ctx, obj, URL_PATHNAME_KEY, 20, path_data, path_len);
            }
        } else {
            url_set_str(ctx, obj, URL_PATHNAME_KEY, 20, path_data, path_len);
        }
    } else if has_authority {
        // Authority-form URL with no path → pathname is "/".
        url_set_str(ctx, obj, URL_PATHNAME_KEY, 20, (char*)"/", 1);
    } else if base_obj != NULL {
        let bp = url_get_str(base_obj, ctx, URL_PATHNAME_KEY, 20);
        if zjs_is_string(bp) != 0 {
            let bs5 = zjs_as_string(bp);
            url_set_str(ctx, obj, URL_PATHNAME_KEY, 20, bs5.data, bs5.length);
        }
    } else {
        url_set_str(ctx, obj, URL_PATHNAME_KEY, 20, (char*)"", 0);
    }

    if cur < bl && body[cur] == (char)'?' {
        let q_start = cur;
        while cur < bl && body[cur] != (char)'#' { cur = cur + 1; }
        url_set_str(ctx, obj, URL_SEARCH_KEY, 18, body + q_start, cur - q_start);
    } else {
        url_set_str(ctx, obj, URL_SEARCH_KEY, 18, (char*)"", 0);
    }
    if cur < bl && body[cur] == (char)'#' {
        url_set_str(ctx, obj, URL_HASH_KEY, 16, body + cur, bl - cur);
    } else {
        url_set_str(ctx, obj, URL_HASH_KEY, 16, (char*)"", 0);
    }
    return true;
}

fn host_url_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"URL constructor: 1 argument required", 36);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    // Coerce input + optional base to strings.
    let in_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    if ctx.pending_throw_active { return zjs_undefined(); }
    let base_v: ZjsValue = zjs_undefined();
    let base_obj: ZjsObject* = NULL;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        base_v = if zjs_is_string(args[1]) != 0 { args[1] } else { zjs_to_string(ctx, args[1]) };
        if ctx.pending_throw_active { return zjs_undefined(); }
        // Parse the base by recursing — fresh obj, no base for the base itself.
        let bo_v = ctx_new_object(ctx);
        let bo = zjs_as_object(bo_v);
        if ctx.url_proto != NULL { bo.proto = ctx.url_proto; }
        let bs = zjs_as_string(base_v);
        if !parse_url_into(ctx, bo, bs.data, bs.length, NULL) {
            let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                        (char*)"Invalid base URL", 16);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = err;
            return zjs_undefined();
        }
        base_obj = bo;
    }
    // Construct the result. NewInvoke sets host_this to a fresh
    // object whose proto is URL.prototype; reuse it if that's how we
    // arrived. Otherwise allocate a new one.
    let obj_v = ctx.host_this;
    if zjs_is_object(obj_v) == 0 {
        obj_v = ctx_new_object(ctx);
        if ctx.url_proto != NULL { zjs_as_object(obj_v).proto = ctx.url_proto; }
    }
    let obj = zjs_as_object(obj_v);
    let is = zjs_as_string(in_v);
    if !parse_url_into(ctx, obj, is.data, is.length, base_obj) {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Invalid URL", 11);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    return obj_v;
}

// Generic component getter, parameterized by the hidden-key constant.
fn url_proto_get(ctx: ZjsContext*, key: char*, key_len: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    return url_get_str(zjs_as_object(this_v), ctx, key, key_len);
}

fn host_url_protocol(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_PROTOCOL_KEY, 20); }
fn host_url_username(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_USERNAME_KEY, 20); }
fn host_url_password(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_PASSWORD_KEY, 20); }
fn host_url_hostname(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_HOSTNAME_KEY, 20); }
fn host_url_port(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_PORT_KEY, 16); }
fn host_url_pathname(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_PATHNAME_KEY, 20); }
fn host_url_search(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_SEARCH_KEY, 18); }
fn host_url_hash(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue { return url_proto_get(ctx, URL_HASH_KEY, 16); }

// Shared setter body. The URL parser stores search and hash WITH their
// '?'/'#' prefix in the slot (host_url_to_string concatenates the slots
// verbatim), so this setter normalizes the incoming value to match:
//
//   prefix == '?' or '#':  ensure the slot value starts with that char
//                          (prepend if missing, leave alone otherwise).
//                          An empty input clears the slot.
//   prefix == 0:           store as-given (used for pathname/hostname/
//                          port — no marker char to manage).
fn url_proto_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32,
                 key: char*, key_len: u32, prefix: char) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    let s_v = if zjs_is_string(v) != 0 { v } else { zjs_to_string(ctx, v) };
    if zjs_is_string(s_v) == 0 { return zjs_undefined(); }
    let s = zjs_as_string(s_v);
    let data: char* = s.data;
    let len:  u32   = s.length;
    if prefix != (char)0 && len > 0 && data[0] != prefix {
        // Prepend the marker so the slot looks the way the parser
        // would have written it.
        let buf = alloc_n<char>((usize)(len + 2));
        buf[0] = prefix;
        let i: u32 = 0; while i < len { buf[i + 1] = data[i]; i = i + 1; }
        buf[len + 1] = (char)0;
        url_set_str(ctx, zjs_as_object(this_v), key, key_len, buf, len + 1);
        dealloc(buf);
        return zjs_undefined();
    }
    url_set_str(ctx, zjs_as_object(this_v), key, key_len, data, len);
    return zjs_undefined();
}

fn host_url_set_pathname(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return url_proto_set(ctx, args, argc, URL_PATHNAME_KEY, 20, (char)0);
}
fn host_url_set_search(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return url_proto_set(ctx, args, argc, URL_SEARCH_KEY, 18, (char)'?');
}
fn host_url_set_hash(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return url_proto_set(ctx, args, argc, URL_HASH_KEY, 16, (char)'#');
}
fn host_url_set_hostname(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return url_proto_set(ctx, args, argc, URL_HOSTNAME_KEY, 20, (char)0);
}
fn host_url_set_port(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return url_proto_set(ctx, args, argc, URL_PORT_KEY, 16, (char)0);
}
fn host_url_set_protocol(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Spec normalizes a trailing ':'; our slot stores it WITH the colon.
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 || argc == 0 { return zjs_undefined(); }
    let v = args[0];
    let s_v = if zjs_is_string(v) != 0 { v } else { zjs_to_string(ctx, v) };
    if zjs_is_string(s_v) == 0 { return zjs_undefined(); }
    let s = zjs_as_string(s_v);
    let data: char* = s.data;
    let len:  u32   = s.length;
    // Ensure trailing ':' — caller may pass "https" or "https:".
    if len > 0 && data[len - 1] != (char)':' {
        let buf = alloc_n<char>((usize)(len + 2));
        let i: u32 = 0; while i < len { buf[i] = data[i]; i = i + 1; }
        buf[len] = (char)':'; buf[len + 1] = (char)0;
        url_set_str(ctx, zjs_as_object(this_v), URL_PROTOCOL_KEY, 20, buf, len + 1);
        dealloc(buf);
    } else {
        url_set_str(ctx, zjs_as_object(this_v), URL_PROTOCOL_KEY, 20, data, len);
    }
    return zjs_undefined();
}

fn host_url_host(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let obj = zjs_as_object(this_v);
    let host = url_get_str(obj, ctx, URL_HOSTNAME_KEY, 20);
    let port = url_get_str(obj, ctx, URL_PORT_KEY, 16);
    if zjs_is_string(port) != 0 && zjs_as_string(port).length > 0 {
        let hs = zjs_as_string(host);
        let ps = zjs_as_string(port);
        let total = hs.length + 1 + ps.length;
        let buf = alloc_n<char>((usize)(total + 1));
        let i: u32 = 0;
        while i < hs.length { buf[i] = hs.data[i]; i = i + 1; }
        buf[hs.length] = (char)':';
        let j: u32 = 0;
        while j < ps.length { buf[hs.length + 1 + j] = ps.data[j]; j = j + 1; }
        buf[total] = (char)0;
        let r = ctx_intern_string(ctx, buf, total);
        dealloc(buf);
        return r;
    }
    return host;
}

fn host_url_origin(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let obj = zjs_as_object(this_v);
    let proto = url_get_str(obj, ctx, URL_PROTOCOL_KEY, 20);
    let host  = host_url_host(ctx, args, argc);
    if zjs_is_string(proto) == 0 || zjs_is_string(host) == 0 {
        return ctx_intern_string(ctx, (char*)"", 0);
    }
    let ps = zjs_as_string(proto);
    let hs = zjs_as_string(host);
    if hs.length == 0 { return ctx_intern_string(ctx, (char*)"null", 4); }
    let total = ps.length + 2 + hs.length;
    let buf = alloc_n<char>((usize)(total + 1));
    let i: u32 = 0;
    while i < ps.length { buf[i] = ps.data[i]; i = i + 1; }
    buf[ps.length]     = (char)'/';
    buf[ps.length + 1] = (char)'/';
    let j: u32 = 0;
    while j < hs.length { buf[ps.length + 2 + j] = hs.data[j]; j = j + 1; }
    buf[total] = (char)0;
    let r = ctx_intern_string(ctx, buf, total);
    dealloc(buf);
    return r;
}

// .href / .toString — reassemble all components into a single string.
// WHATWG "special scheme" — these always carry a `//` authority
// delimiter when serialized, even with an empty host (e.g. file:///).
// `proto` includes the trailing ':'.
fn url_scheme_is_special(proto: char*, len: u32) -> bool {
    let m: bool = false;
    raw {
        m = (len == 5 && memcmp(proto, "file:", 5) == 0)
         || (len == 5 && memcmp(proto, "http:", 5) == 0)
         || (len == 6 && memcmp(proto, "https:", 6) == 0)
         || (len == 3 && memcmp(proto, "ws:", 3) == 0)
         || (len == 4 && memcmp(proto, "wss:", 4) == 0)
         || (len == 4 && memcmp(proto, "ftp:", 4) == 0);
    }
    return m;
}

fn host_url_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let obj = zjs_as_object(this_v);
    let proto = url_get_str(obj, ctx, URL_PROTOCOL_KEY, 20);
    let user  = url_get_str(obj, ctx, URL_USERNAME_KEY, 20);
    let pass  = url_get_str(obj, ctx, URL_PASSWORD_KEY, 20);
    let host  = url_get_str(obj, ctx, URL_HOSTNAME_KEY, 20);
    let port  = url_get_str(obj, ctx, URL_PORT_KEY, 16);
    let path  = url_get_str(obj, ctx, URL_PATHNAME_KEY, 20);
    let srch  = url_get_str(obj, ctx, URL_SEARCH_KEY, 18);
    let hash  = url_get_str(obj, ctx, URL_HASH_KEY, 16);
    let ps = zjs_as_string(proto);
    let us = zjs_as_string(user);
    let pas = zjs_as_string(pass);
    let hs = zjs_as_string(host);
    let ports = zjs_as_string(port);
    let paths = zjs_as_string(path);
    let ss = zjs_as_string(srch);
    let hss = zjs_as_string(hash);
    // Assemble. Pre-size big enough to hold every component + the
    // single-byte separators we inject between them.
    let cap: u32 = ps.length + us.length + pas.length + hs.length + ports.length + paths.length + ss.length + hss.length + 16;
    let buf = alloc_n<char>((usize)cap);
    let n: u32 = 0;
    let i: u32 = 0;
    while i < ps.length { buf[n] = ps.data[i]; n = n + 1; i = i + 1; }
    // A special scheme (file/http/https/ws/wss/ftp) always serializes its
    // `//` authority delimiter, even when the host is empty — e.g.
    // file:///a/b/c. Non-special schemes (mailto:, data:) only get `//`
    // when a host is actually present.
    let has_authority: bool = hs.length > 0 || url_scheme_is_special(ps.data, ps.length);
    if has_authority {
        buf[n] = (char)'/'; n = n + 1;
        buf[n] = (char)'/'; n = n + 1;
        if us.length > 0 || pas.length > 0 {
            let ui: u32 = 0;
            while ui < us.length { buf[n] = us.data[ui]; n = n + 1; ui = ui + 1; }
            if pas.length > 0 {
                buf[n] = (char)':'; n = n + 1;
                let pi: u32 = 0;
                while pi < pas.length { buf[n] = pas.data[pi]; n = n + 1; pi = pi + 1; }
            }
            buf[n] = (char)'@'; n = n + 1;
        }
        let hi: u32 = 0;
        while hi < hs.length { buf[n] = hs.data[hi]; n = n + 1; hi = hi + 1; }
        if ports.length > 0 {
            buf[n] = (char)':'; n = n + 1;
            let pri: u32 = 0;
            while pri < ports.length { buf[n] = ports.data[pri]; n = n + 1; pri = pri + 1; }
        }
    }
    let pathi: u32 = 0;
    while pathi < paths.length { buf[n] = paths.data[pathi]; n = n + 1; pathi = pathi + 1; }
    let si: u32 = 0;
    while si < ss.length { buf[n] = ss.data[si]; n = n + 1; si = si + 1; }
    let hi2: u32 = 0;
    while hi2 < hss.length { buf[n] = hss.data[hi2]; n = n + 1; hi2 = hi2 + 1; }
    let r = ctx_intern_string(ctx, buf, n);
    dealloc(buf);
    return r;
}

// =====================================================================
// URLSearchParams — v0.1 (2026-05-18). Backed by a hidden own
// property `__zjs_usp_pairs__` holding a flat ZjsArray of strings
// at indices [2k, 2k+1] = [name, value]. Constructor accepts:
//   - undefined / "" → empty
//   - string "a=1&b=2&..." → URL-decoded pairs
//   - array of [k, v] pairs
//   - object → enumerable own props
// Out of scope for v0.1: percent-decoding of plus-signs and high
// bytes, iteration objects (we install entries/keys/values but they
// return arrays, not real iterators).
// =====================================================================

def USP_PAIRS_KEY: char* = (char*)"__zjs_usp_pairs__";

fn usp_pairs(ctx: ZjsContext*, obj: ZjsObject*) -> ZjsArray* {
    let atom = ctx_intern_atom(ctx, USP_PAIRS_KEY, 17);
    let slot = class_find_slot(obj.cls, atom);
    if slot < 0 { return NULL; }
    let v = obj.slots[(u32)slot];
    if zjs_is_array(v) == 0 { return NULL; }
    return zjs_as_array(v);
}

// "+" → " ", "%XX" → byte. No UTF-8 awareness — passes bytes through.
fn usp_decode(ctx: ZjsContext*, src: char*, len: u32) -> ZjsValue {
    if len == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let buf = alloc_n<char>((usize)(len + 1));
    let i: u32 = 0;
    let o: u32 = 0;
    while i < len {
        let c = src[i];
        if c == (char)'+' { buf[o] = (char)' '; o = o + 1; i = i + 1; continue; }
        if c == (char)'%' && i + 2 < len {
            let h1 = src[i + 1];
            let h2 = src[i + 2];
            let v1: i32 = -1;
            let v2: i32 = -1;
            raw {
                v1 = (h1 >= '0' && h1 <= '9') ? (h1 - '0')
                   : (h1 >= 'a' && h1 <= 'f') ? (h1 - 'a' + 10)
                   : (h1 >= 'A' && h1 <= 'F') ? (h1 - 'A' + 10) : -1;
                v2 = (h2 >= '0' && h2 <= '9') ? (h2 - '0')
                   : (h2 >= 'a' && h2 <= 'f') ? (h2 - 'a' + 10)
                   : (h2 >= 'A' && h2 <= 'F') ? (h2 - 'A' + 10) : -1;
            }
            if v1 >= 0 && v2 >= 0 {
                buf[o] = (char)((v1 << 4) | v2);
                o = o + 1;
                i = i + 3;
                continue;
            }
        }
        buf[o] = c;
        o = o + 1;
        i = i + 1;
    }
    buf[o] = (char)0;
    let r = ctx_intern_string(ctx, buf, o);
    dealloc(buf);
    return r;
}

// Percent-encode application/x-www-form-urlencoded. ASCII alpha-numerics
// + `-._~` pass through; everything else becomes `%XX` (or `+` for space).
fn usp_encode(ctx: ZjsContext*, src: char*, len: u32) -> ZjsValue {
    let cap: u32 = len * 3 + 1;
    let buf = alloc_n<char>((usize)cap);
    let o: u32 = 0;
    let i: u32 = 0;
    while i < len {
        let c = src[i];
        let pass: bool = false;
        raw {
            pass = ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
                 || (c >= '0' && c <= '9')
                 || c == '-' || c == '.' || c == '_' || c == '~');
        }
        if pass { buf[o] = c; o = o + 1; }
        else if c == (char)' ' { buf[o] = (char)'+'; o = o + 1; }
        else {
            let hex: char[16];
            raw {
                static const char H[] = "0123456789ABCDEF";
                buf[o]     = '%';
                buf[o + 1] = H[((unsigned char)c) >> 4];
                buf[o + 2] = H[((unsigned char)c) & 0xF];
            }
            o = o + 3;
        }
        i = i + 1;
    }
    buf[o] = (char)0;
    let r = ctx_intern_string(ctx, buf, o);
    dealloc(buf);
    return r;
}

// Append (name, value) to the pairs array — both pre-decoded.
fn usp_append_decoded(ctx: ZjsContext*, pairs: ZjsArray*, name_v: ZjsValue, value_v: ZjsValue) -> void {
    array_set(pairs, pairs.length, name_v);
    array_set(pairs, pairs.length, value_v);
}

// Parse `a=1&b=2&...` form into pairs.
fn usp_parse_string(ctx: ZjsContext*, pairs: ZjsArray*, src: char*, len: u32) -> void {
    let i: u32 = 0;
    // Skip a leading '?' if present (so `new URLSearchParams("?a=1")` works).
    if len > 0 && src[0] == (char)'?' { i = 1; }
    while i < len {
        let pair_start = i;
        while i < len && src[i] != (char)'&' { i = i + 1; }
        let pair_end = i;
        let pl = pair_end - pair_start;
        if pl > 0 {
            // Find '=' inside this slice.
            let eq: u32 = pair_start;
            while eq < pair_end && src[eq] != (char)'=' { eq = eq + 1; }
            let name_v = usp_decode(ctx, src + pair_start, eq - pair_start);
            let val_v: ZjsValue = if eq < pair_end { usp_decode(ctx, src + eq + 1, pair_end - eq - 1) }
                                  else            { ctx_intern_string(ctx, (char*)"", 0) };
            usp_append_decoded(ctx, pairs, name_v, val_v);
        }
        if i < len { i = i + 1; }    // skip '&'
    }
}

fn host_url_searchparams_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let obj_v = ctx.host_this;
    if zjs_is_object(obj_v) == 0 {
        obj_v = ctx_new_object(ctx);
        if ctx.usp_proto != NULL { zjs_as_object(obj_v).proto = ctx.usp_proto; }
    }
    let obj = zjs_as_object(obj_v);
    let pairs_v = ctx_new_array(ctx, 0);
    object_set(ctx, obj, ctx_intern_atom(ctx, USP_PAIRS_KEY, 17), pairs_v);
    let pairs = zjs_as_array(pairs_v);
    if argc == 0 || zjs_is_undefined(args[0]) != 0 || zjs_is_null(args[0]) != 0 {
        return obj_v;
    }
    let init = args[0];
    if zjs_is_string(init) != 0 {
        let s = zjs_as_string(init);
        usp_parse_string(ctx, pairs, s.data, s.length);
        return obj_v;
    }
    if zjs_is_array(init) != 0 {
        let a = zjs_as_array(init);
        let i: u32 = 0;
        while i < a.length {
            let entry = a.elements[i];
            if zjs_is_array(entry) != 0 {
                let ea = zjs_as_array(entry);
                let kv = if ea.length >= 1 { ea.elements[0] } else { zjs_undefined() };
                let vv = if ea.length >= 2 { ea.elements[1] } else { zjs_undefined() };
                let ks = if zjs_is_string(kv) != 0 { kv } else { zjs_to_string(ctx, kv) };
                let vs = if zjs_is_string(vv) != 0 { vv } else { zjs_to_string(ctx, vv) };
                usp_append_decoded(ctx, pairs, ks, vs);
            }
            i = i + 1;
        }
        return obj_v;
    }
    if zjs_is_object(init) != 0 {
        let io = zjs_as_object(init);
        let cls = io.cls;
        // Walk the class transition chain to recover names in
        // insertion order.
        let names: ZjsString*[64];
        let slots: u32[64];
        let nc: u32 = 0;
        let c = cls;
        while c != NULL && c.parent != NULL && nc < 64 {
            names[nc] = c.transition_name;
            slots[nc] = c.transition_slot;
            nc = nc + 1;
            c = c.parent;
        }
        // Reverse-walk to emit oldest first.
        let ni: u32 = nc;
        while ni > 0 {
            ni = ni - 1;
            let name = names[ni];
            let slot = slots[ni];
            if name != NULL && zjs_is_deleted(io.slots[slot]) == 0 {
                let v = io.slots[slot];
                let vs = if zjs_is_string(v) != 0 { v } else { zjs_to_string(ctx, v) };
                let name_v = zjs_cell_from_ptr((void*)name);
                usp_append_decoded(ctx, pairs, name_v, vs);
            }
        }
    }
    return obj_v;
}

// Find first index `i` such that pairs[2i] equals `name`. -1 if absent.
fn usp_find(pairs: ZjsArray*, name: ZjsString*) -> i32 {
    let n = pairs.length / 2;
    let i: u32 = 0;
    while i < n {
        let entry = pairs.elements[i * 2];
        if zjs_is_string(entry) != 0 {
            let es = zjs_as_string(entry);
            if es == name { return (i32)i; }
            if es.length == name.length {
                let eq: int = 0;
                raw { eq = (memcmp(es->data, name->data, es->length) == 0) ? 1 : 0; }
                if eq != 0 { return (i32)i; }
            }
        }
        i = i + 1;
    }
    return -1;
}

fn host_usp_get(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_null(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_null(); }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return zjs_null(); }
    let name_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let idx = usp_find(pairs, zjs_as_string(name_v));
    if idx < 0 { return zjs_null(); }
    return pairs.elements[(u32)idx * 2 + 1];
}

fn host_usp_get_all(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let out_v = ctx_new_array(ctx, 0);
    if argc == 0 { return out_v; }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return out_v; }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return out_v; }
    let name_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let name = zjs_as_string(name_v);
    let out = zjs_as_array(out_v);
    let n = pairs.length / 2;
    let i: u32 = 0;
    while i < n {
        let entry = pairs.elements[i * 2];
        if zjs_is_string(entry) != 0 {
            let es = zjs_as_string(entry);
            let same: int = 0;
            if es == name { same = 1; }
            else if es.length == name.length {
                raw { same = (memcmp(es->data, name->data, es->length) == 0) ? 1 : 0; }
            }
            if same != 0 {
                array_set(out, out.length, pairs.elements[i * 2 + 1]);
            }
        }
        i = i + 1;
    }
    return out_v;
}

fn host_usp_has(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_bool(0); }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return zjs_bool(0); }
    let name_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    return zjs_bool(if usp_find(pairs, zjs_as_string(name_v)) >= 0 { 1 } else { 0 });
}

fn host_usp_append(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return zjs_undefined(); }
    let name_v  = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let value_v = if zjs_is_string(args[1]) != 0 { args[1] } else { zjs_to_string(ctx, args[1]) };
    usp_append_decoded(ctx, pairs, name_v, value_v);
    return zjs_undefined();
}

fn host_usp_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return zjs_undefined(); }
    let name_v  = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let value_v = if zjs_is_string(args[1]) != 0 { args[1] } else { zjs_to_string(ctx, args[1]) };
    let name = zjs_as_string(name_v);
    // Find the first matching, replace value, then drop the rest.
    let n = pairs.length / 2;
    let read: u32 = 0;
    let write: u32 = 0;
    let placed: bool = false;
    while read < n {
        let entry = pairs.elements[read * 2];
        let val   = pairs.elements[read * 2 + 1];
        let same: int = 0;
        if zjs_is_string(entry) != 0 {
            let es = zjs_as_string(entry);
            if es == name { same = 1; }
            else if es.length == name.length {
                raw { same = (memcmp(es->data, name->data, es->length) == 0) ? 1 : 0; }
            }
        }
        if same != 0 {
            if !placed {
                pairs.elements[write * 2]     = entry;
                pairs.elements[write * 2 + 1] = value_v;
                write = write + 1;
                placed = true;
            }
            // else: drop additional duplicates
        } else {
            if write != read {
                pairs.elements[write * 2]     = entry;
                pairs.elements[write * 2 + 1] = val;
            }
            write = write + 1;
        }
        read = read + 1;
    }
    if !placed {
        usp_append_decoded(ctx, pairs, name_v, value_v);
    } else {
        pairs.length = write * 2;
    }
    return zjs_undefined();
}

fn host_usp_delete(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return zjs_undefined(); }
    let name_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let name = zjs_as_string(name_v);
    let n = pairs.length / 2;
    let read: u32 = 0;
    let write: u32 = 0;
    while read < n {
        let entry = pairs.elements[read * 2];
        let val   = pairs.elements[read * 2 + 1];
        let same: int = 0;
        if zjs_is_string(entry) != 0 {
            let es = zjs_as_string(entry);
            if es == name { same = 1; }
            else if es.length == name.length {
                raw { same = (memcmp(es->data, name->data, es->length) == 0) ? 1 : 0; }
            }
        }
        if same == 0 {
            if write != read {
                pairs.elements[write * 2]     = entry;
                pairs.elements[write * 2 + 1] = val;
            }
            write = write + 1;
        }
        read = read + 1;
    }
    pairs.length = write * 2;
    return zjs_undefined();
}

fn host_usp_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return ctx_intern_string(ctx, (char*)"", 0); }
    let n = pairs.length / 2;
    if n == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    // Each pair contributes encoded(k) + '=' + encoded(v) + '&'.
    // We over-allocate aggressively then trim.
    let cap: u32 = 64;
    let i: u32 = 0;
    while i < n {
        let kv = pairs.elements[i * 2];
        let vv = pairs.elements[i * 2 + 1];
        let kl: u32 = if zjs_is_string(kv) != 0 { zjs_as_string(kv).length } else { 0 };
        let vl: u32 = if zjs_is_string(vv) != 0 { zjs_as_string(vv).length } else { 0 };
        cap = cap + (kl + vl) * 3 + 8;
        i = i + 1;
    }
    let buf = alloc_n<char>((usize)cap);
    let o: u32 = 0;
    let j: u32 = 0;
    while j < n {
        let kv = pairs.elements[j * 2];
        let vv = pairs.elements[j * 2 + 1];
        let ks_v = if zjs_is_string(kv) != 0 { kv } else { zjs_to_string(ctx, kv) };
        let vs_v = if zjs_is_string(vv) != 0 { vv } else { zjs_to_string(ctx, vv) };
        let ks = zjs_as_string(ks_v);
        let vs = zjs_as_string(vs_v);
        let enc_k = usp_encode(ctx, ks.data, ks.length);
        let enc_v = usp_encode(ctx, vs.data, vs.length);
        let eks = zjs_as_string(enc_k);
        let evs = zjs_as_string(enc_v);
        let ki: u32 = 0;
        while ki < eks.length { buf[o] = eks.data[ki]; o = o + 1; ki = ki + 1; }
        buf[o] = (char)'='; o = o + 1;
        let vi: u32 = 0;
        while vi < evs.length { buf[o] = evs.data[vi]; o = o + 1; vi = vi + 1; }
        if j + 1 < n { buf[o] = (char)'&'; o = o + 1; }
        j = j + 1;
    }
    let r = ctx_intern_string(ctx, buf, o);
    dealloc(buf);
    return r;
}

fn host_usp_size(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_int32(0); }
    let pairs = usp_pairs(ctx, zjs_as_object(this_v));
    if pairs == NULL { return zjs_int32(0); }
    return zjs_int32((i32)(pairs.length / 2));
}

// url.searchParams — returns a fresh URLSearchParams each call (v0.1
// limitation: not live-linked back to the URL; mutations don't
// reflect in url.search until the user assembles a new URL).
fn host_url_search_params(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_object(this_v) == 0 { return zjs_undefined(); }
    let obj = zjs_as_object(this_v);
    let search = url_get_str(obj, ctx, URL_SEARCH_KEY, 18);
    let usp_v = ctx_new_object(ctx);
    if ctx.usp_proto != NULL { zjs_as_object(usp_v).proto = ctx.usp_proto; }
    let pairs_v = ctx_new_array(ctx, 0);
    object_set(ctx, zjs_as_object(usp_v),
               ctx_intern_atom(ctx, USP_PAIRS_KEY, 17), pairs_v);
    if zjs_is_string(search) != 0 {
        let ss = zjs_as_string(search);
        usp_parse_string(ctx, zjs_as_array(pairs_v), ss.data, ss.length);
    }
    return usp_v;
}

fn host_date_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ms: f64 = 0.0;
    if argc == 0 {
        raw {
            struct timespec ts;
            clock_gettime(CLOCK_REALTIME, &ts);
            ms = (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
        }
    } else if argc == 1 {
        let v = args[0];
        // ECMA-262 §21.4.2.1 step 3a: when the sole argument is a Date
        // instance, copy its internal [[DateValue]] directly. Skipping
        // this falls through to ToNumber(date), which goes through
        // ToPrimitive → string → fails to parse → NaN. dayjs's clone()
        // does `new Date(this.$d)` and broke without this.
        if zjs_is_date(v) != 0 {
            let src_d = zjs_as_date(v);
            ms = src_d.time_ms;
        } else if zjs_is_string(v) != 0 {
            // Spec Date.parse — only handle the canonical ISO subset.
            let s = zjs_as_string(v);
            let parsed: f64 = 0.0;
            raw {
                int Y, Mo, D, H = 0, Mn = 0, S = 0, Ms = 0;
                int n = sscanf(s->data, "%d-%d-%dT%d:%d:%d.%dZ", &Y, &Mo, &D, &H, &Mn, &S, &Ms);
                if (n < 3) {
                    n = sscanf(s->data, "%d-%d-%d", &Y, &Mo, &D);
                    H = Mn = S = Ms = 0;
                }
                if (n >= 3) {
                    struct tm t;
                    memset(&t, 0, sizeof(t));
                    t.tm_year = Y - 1900;
                    t.tm_mon  = Mo - 1;
                    t.tm_mday = D;
                    t.tm_hour = H;
                    t.tm_min  = Mn;
                    t.tm_sec  = S;
                    time_t secs = zjs_timegm(&t);
                    parsed = (double)secs * 1000.0 + (double)Ms;
                } else {
                    parsed = 0.0/0.0;
                }
            }
            ms = parsed;
        } else {
            ms = zjs_to_double(v);
        }
    } else {
        let y = zjs_to_double(args[0]);
        let mo = zjs_to_double(args[1]);
        let d = if argc > 2 { zjs_to_double(args[2]) } else { 1.0 };
        let h = if argc > 3 { zjs_to_double(args[3]) } else { 0.0 };
        let mi = if argc > 4 { zjs_to_double(args[4]) } else { 0.0 };
        let se = if argc > 5 { zjs_to_double(args[5]) } else { 0.0 };
        let ml = if argc > 6 { zjs_to_double(args[6]) } else { 0.0 };
        ms = date_compose_utc_ms(y, mo, d, h, mi, se, ml);
    }
    let d = zjs_date_new(ms);
    ctx_register_cell(ctx, (void*)d);
    let nt_proto_d = subclass_proto_for(ctx, ctx.date_proto);
    if nt_proto_d != NULL { d.proto = nt_proto_d; }
    return zjs_cell_from_ptr((void*)d);
}

fn host_date_parse_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_double(0.0/0.0); }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    let parsed: f64 = 0.0;
    raw {
        int Y, Mo, D, H = 0, Mn = 0, S = 0, Ms = 0;
        int n = sscanf(s->data, "%d-%d-%dT%d:%d:%d.%dZ", &Y, &Mo, &D, &H, &Mn, &S, &Ms);
        if (n < 3) {
            n = sscanf(s->data, "%d-%d-%d", &Y, &Mo, &D);
            H = Mn = S = Ms = 0;
        }
        if (n >= 3) {
            struct tm t;
            memset(&t, 0, sizeof(t));
            t.tm_year = Y - 1900;
            t.tm_mon  = Mo - 1;
            t.tm_mday = D;
            t.tm_hour = H;
            t.tm_min  = Mn;
            t.tm_sec  = S;
            time_t secs = zjs_timegm(&t);
            parsed = (double)secs * 1000.0 + (double)Ms;
        } else {
            parsed = 0.0/0.0;
        }
    }
    return zjs_double(parsed);
}

fn host_date_utc_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let y = if argc > 0 { zjs_to_double(args[0]) } else { 0.0/0.0 };
    let mo = if argc > 1 { zjs_to_double(args[1]) } else { 0.0 };
    let d = if argc > 2 { zjs_to_double(args[2]) } else { 1.0 };
    let h = if argc > 3 { zjs_to_double(args[3]) } else { 0.0 };
    let mi = if argc > 4 { zjs_to_double(args[4]) } else { 0.0 };
    let se = if argc > 5 { zjs_to_double(args[5]) } else { 0.0 };
    let ml = if argc > 6 { zjs_to_double(args[6]) } else { 0.0 };
    return zjs_double(date_compose_utc_ms(y, mo, d, h, mi, se, ml));
}

fn date_require_this(ctx: ZjsContext*) -> ZjsDate* {
    let this_v = ctx.host_this;
    if zjs_is_date(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Date method called on non-Date", 30);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return NULL;
    }
    return zjs_as_date(this_v);
}

fn host_date_get_time(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(d.time_ms);
}

fn host_date_set_time(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let ms = if argc > 0 { zjs_to_double(args[0]) } else { 0.0/0.0 };
    d.time_ms = ms;
    return zjs_double(ms);
}

fn host_date_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_date_get_time(ctx, args, argc);
}

fn host_date_to_iso_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    if d.time_ms != d.time_ms {   // NaN
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"Invalid time value", 18);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return format_iso_string(ctx, d.time_ms);
}

fn host_date_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    // toString is locale-formatted in the spec; we emit the ISO form
    // as a serviceable stand-in until Intl lands.
    if d.time_ms != d.time_ms {
        return ctx_intern_string(ctx, (char*)"Invalid Date", 12);
    }
    return format_iso_string(ctx, d.time_ms);
}

fn host_date_to_json(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    if d.time_ms != d.time_ms { return zjs_null(); }
    return format_iso_string(ctx, d.time_ms);
}

// Helper for getter methods. Decomposes ms into the requested UTC
// component (year, month, ...). `field`:
//   0=fullYear  1=month  2=date  3=day(weekday)  4=hours
//   5=minutes   6=seconds  7=milliseconds
fn date_extract_utc(time_ms: f64, field: u32) -> f64 {
    if time_ms != time_ms { return 0.0/0.0; }
    let r: f64 = 0.0;
    raw {
        int64_t total_ms = (int64_t)time_ms;
        int millis = (int)(total_ms % 1000);
        if (millis < 0) millis += 1000;
        time_t secs = (time_t)(total_ms / 1000);
        if (millis != 0 && total_ms < 0) secs -= 1;
        struct tm tm_utc;
        zjs_gmtime_r(&secs, &tm_utc);
        switch (field) {
            case 0: r = (double)(tm_utc.tm_year + 1900); break;
            case 1: r = (double)tm_utc.tm_mon;           break;
            case 2: r = (double)tm_utc.tm_mday;          break;
            case 3: r = (double)tm_utc.tm_wday;          break;
            case 4: r = (double)tm_utc.tm_hour;          break;
            case 5: r = (double)tm_utc.tm_min;           break;
            case 6: r = (double)tm_utc.tm_sec;           break;
            case 7: r = (double)millis;                   break;
            default: r = 0.0/0.0;                         break;
        }
    }
    return r;
}

fn host_date_get_year(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 0));
}
fn host_date_get_month(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 1));
}
fn host_date_get_date(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 2));
}
fn host_date_get_day(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 3));
}
fn host_date_get_hours(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 4));
}
fn host_date_get_minutes(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 5));
}
fn host_date_get_seconds(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 6));
}
fn host_date_get_millis(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    return zjs_double(date_extract_utc(d.time_ms, 7));
}
fn host_date_get_tzoffset(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    // We're UTC-only — spec returns the offset in minutes that UTC
    // is ahead of local. With local=UTC, that's 0.
    return zjs_int32(0);
}

// Replace the chosen UTC components of `time_ms`. The `has_mask` bits
// flag which entries of `vals` (indexed 0..6 = year, month, day, hour,
// minute, second, millisecond) come from the caller; unflagged entries
// are pulled out of `time_ms`. NaN-in → NaN-out unless `nan_to_zero`
// (spec: only setFullYear / setUTCFullYear / setYear allow that).
fn date_set_components(time_ms: f64, has_mask: u32, vals: f64*, nan_to_zero: bool) -> f64 {
    let t = time_ms;
    if t != t {
        if !nan_to_zero { return 0.0/0.0; }
        t = 0.0;
    }
    let y  = if (has_mask & 1)  != 0 { vals[0] } else { date_extract_utc(t, 0) };
    let mo = if (has_mask & 2)  != 0 { vals[1] } else { date_extract_utc(t, 1) };
    let d  = if (has_mask & 4)  != 0 { vals[2] } else { date_extract_utc(t, 2) };
    let h  = if (has_mask & 8)  != 0 { vals[3] } else { date_extract_utc(t, 4) };
    let mn = if (has_mask & 16) != 0 { vals[4] } else { date_extract_utc(t, 5) };
    let s  = if (has_mask & 32) != 0 { vals[5] } else { date_extract_utc(t, 6) };
    let ml = if (has_mask & 64) != 0 { vals[6] } else { date_extract_utc(t, 7) };
    return date_compose_utc_ms(y, mo, d, h, mn, s, ml);
}

// Full ECMA-262 ToNumber for a Date setX argument. zjs_to_double
// handles primitives + strings but returns NaN for object operands
// without invoking ToPrimitive — fine for in-bytecode ops which
// pre-coerce via zjs_to_primitive at the dispatch site, but the
// Date setX host functions get raw object operands and need the
// valueOf/@@toPrimitive walk inline. Symbol throws TypeError per
// §7.1.4 step 4.
fn date_arg_to_number(ctx: ZjsContext*, v: ZjsValue) -> f64 {
    let p = v;
    let tag: u8 = zjs_cell_tag(v);
    if tag == TAG_OBJECT || tag == TAG_ARRAY
       || tag == TAG_FUNCTION || tag == TAG_CLOSURE || tag == TAG_HOST_FUNCTION
       || tag == TAG_DATE || tag == TAG_REGEXP
       || tag == TAG_MAP || tag == TAG_SET {
        p = zjs_to_primitive(ctx, v, false);
        if ctx.pending_throw_active { return 0.0; }
    }
    if zjs_is_symbol(p) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert a Symbol value to a number", 41);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return 0.0;
    }
    return zjs_to_double(p);
}

// Spec for every Date.prototype.setX (§21.4.4.x): step 3 reads
// dateObject.[[DateValue]] into `t` BEFORE any ToNumber on the
// arguments. ToNumber can fire a user valueOf which may itself call
// setTime — so reading t before lets us observe the original time
// and produces the right NaN-or-not decision at step 8. Earlier
// impls read d.time_ms only at date_set_components-call time, so a
// mid-flight valueOf side-effect could change the basis we computed
// against. Capture t at entry, then use t (not d.time_ms) below.
fn host_date_set_millis(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let t: f64 = d.time_ms;
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    // Spec: ToNumber argument before anything else (arg coercion order).
    let ms_v = if argc > 0 { date_arg_to_number(ctx, args[0]) } else { 0.0/0.0 };
    if ctx.pending_throw_active { return zjs_undefined(); }
    vals[6] = ms_v;
    let is_t_nan: int = 0;
    raw { is_t_nan = isnan(t) ? 1 : 0; }
    if is_t_nan != 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    d.time_ms = date_set_components(t, 64, &vals[0], false);
    return zjs_double(d.time_ms);
}

fn host_date_set_seconds(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let t: f64 = d.time_ms;
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    let mask: u32 = 0;
    if argc > 0 { vals[5] = date_arg_to_number(ctx, args[0]); mask = mask | 32; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 1 { vals[6] = date_arg_to_number(ctx, args[1]); mask = mask | 64; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if mask == 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    let is_t_nan: int = 0;
    raw { is_t_nan = isnan(t) ? 1 : 0; }
    if is_t_nan != 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    d.time_ms = date_set_components(t, mask, &vals[0], false);
    return zjs_double(d.time_ms);
}

fn host_date_set_minutes(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let t: f64 = d.time_ms;
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    let mask: u32 = 0;
    if argc > 0 { vals[4] = date_arg_to_number(ctx, args[0]); mask = mask | 16; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 1 { vals[5] = date_arg_to_number(ctx, args[1]); mask = mask | 32; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 2 { vals[6] = date_arg_to_number(ctx, args[2]); mask = mask | 64; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if mask == 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    let is_t_nan: int = 0;
    raw { is_t_nan = isnan(t) ? 1 : 0; }
    if is_t_nan != 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    d.time_ms = date_set_components(t, mask, &vals[0], false);
    return zjs_double(d.time_ms);
}

fn host_date_set_hours(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let t: f64 = d.time_ms;
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    let mask: u32 = 0;
    if argc > 0 { vals[3] = date_arg_to_number(ctx, args[0]); mask = mask | 8; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 1 { vals[4] = date_arg_to_number(ctx, args[1]); mask = mask | 16; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 2 { vals[5] = date_arg_to_number(ctx, args[2]); mask = mask | 32; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 3 { vals[6] = date_arg_to_number(ctx, args[3]); mask = mask | 64; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if mask == 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    let is_t_nan: int = 0;
    raw { is_t_nan = isnan(t) ? 1 : 0; }
    if is_t_nan != 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    d.time_ms = date_set_components(t, mask, &vals[0], false);
    return zjs_double(d.time_ms);
}

fn host_date_set_date(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let t: f64 = d.time_ms;
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    let mask: u32 = 0;
    if argc > 0 { vals[2] = date_arg_to_number(ctx, args[0]); mask = mask | 4; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if mask == 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    let is_t_nan: int = 0;
    raw { is_t_nan = isnan(t) ? 1 : 0; }
    if is_t_nan != 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    d.time_ms = date_set_components(t, mask, &vals[0], false);
    return zjs_double(d.time_ms);
}

fn host_date_set_month(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    let t: f64 = d.time_ms;
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    let mask: u32 = 0;
    if argc > 0 { vals[1] = date_arg_to_number(ctx, args[0]); mask = mask | 2; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 1 { vals[2] = date_arg_to_number(ctx, args[1]); mask = mask | 4; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if mask == 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    let is_t_nan: int = 0;
    raw { is_t_nan = isnan(t) ? 1 : 0; }
    if is_t_nan != 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    d.time_ms = date_set_components(t, mask, &vals[0], false);
    return zjs_double(d.time_ms);
}

fn host_date_set_full_year(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    // setFullYear is the exception — step 3: "If t is NaN, let t be
    // +0𝔽". Captured t is still read before ToNumber per spec.
    let t: f64 = d.time_ms;
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    let mask: u32 = 0;
    if argc > 0 { vals[0] = date_arg_to_number(ctx, args[0]); mask = mask | 1; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 1 { vals[1] = date_arg_to_number(ctx, args[1]); mask = mask | 2; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if argc > 2 { vals[2] = date_arg_to_number(ctx, args[2]); mask = mask | 4; }
    if ctx.pending_throw_active { return zjs_undefined(); }
    if mask == 0 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    d.time_ms = date_set_components(t, mask, &vals[0], true);
    return zjs_double(d.time_ms);
}

// Legacy setYear: year < 100 maps to 1900..1999, else as-is. Otherwise
// behaves like setFullYear(year). NaN year → time becomes NaN.
fn host_date_set_year(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let d = date_require_this(ctx);
    if d == NULL { return zjs_undefined(); }
    if argc < 1 { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    let y = zjs_to_double(args[0]);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if y != y { d.time_ms = 0.0/0.0; return zjs_double(d.time_ms); }
    let yi: f64 = 0.0;
    raw { yi = (double)(int32_t)y; }
    if yi >= 0.0 && yi <= 99.0 { yi = yi + 1900.0; }
    let vals: f64[7]; let i: u32 = 0; while i < 7 { vals[i] = 0.0; i = i + 1; }
    vals[0] = yi;
    d.time_ms = date_set_components(d.time_ms, 1, &vals[0], true);
    return zjs_double(d.time_ms);
}

// =====================================================================
// Symbol host functions (2026-05-16). User-created Symbols get a unique
// `key` string ("@@sym:<id>") derived from ctx.symbol_counter; the
// engine internals use that string when the Symbol is used as a
// property key. Well-known symbols (Symbol.iterator, ...) reuse the
// "@@iterator"-style sentinels the engine already understands.
// =====================================================================

fn ctx_alloc_symbol(ctx: ZjsContext*, description: ZjsString*, key: ZjsString*) -> ZjsValue {
    let s = zjs_symbol_new(description, key);
    ctx_register_cell(ctx, (void*)s);
    return zjs_cell_from_ptr((void*)s);
}

fn ctx_fresh_symbol_key(ctx: ZjsContext*) -> ZjsString* {
    ctx.symbol_counter = ctx.symbol_counter + 1;
    let buf: char[32];
    raw { snprintf(buf, sizeof(buf), "@@sym:%u", (unsigned)ctx->symbol_counter); }
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let len: u32 = 0; raw { len = (uint32_t)strlen(bp); }
    return ctx_intern_atom(ctx, bp, len);
}

fn host_symbol_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262: `new Symbol()` throws TypeError, plain call returns
    // a fresh primitive. We don't distinguish here yet — both work.
    let desc: ZjsString* = NULL;
    if argc > 0 && zjs_is_undefined(args[0]) == 0 {
        let dv = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
        if zjs_is_string(dv) != 0 { desc = zjs_as_string(dv); }
    }
    let key = ctx_fresh_symbol_key(ctx);
    return ctx_alloc_symbol(ctx, desc, key);
}

fn host_symbol_for(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let kv = if argc > 0 { args[0] } else { zjs_undefined() };
    if zjs_is_string(kv) == 0 { kv = zjs_to_string(ctx, kv); }
    let key_str = zjs_as_string(kv);
    let i: u32 = 0;
    while i < ctx.symbol_for_count {
        if zjs_string_equals(ctx.symbol_for_keys[i], key_str) != 0 {
            return zjs_cell_from_ptr((void*)ctx.symbol_for_syms[i]);
        }
        i = i + 1;
    }
    // Symbol.for-created symbols are user-visible under the supplied
    // key, but their internal property-key (for `obj[Symbol.for("x")]`
    // round-trips) needs to be the same string used downstream. Use
    // the registry key directly as the property key — same key implies
    // same Symbol instance per spec.
    let sym = zjs_symbol_new(key_str, key_str);
    ctx_register_cell(ctx, (void*)sym);
    if ctx.symbol_for_count >= ctx.symbol_for_cap {
        let new_cap: u32 = if ctx.symbol_for_cap == 0 { 8 } else { ctx.symbol_for_cap * 2 };
        ctx.symbol_for_keys = realloc_n<ZjsString*>(ctx.symbol_for_keys, (usize)ctx.symbol_for_cap, (usize)new_cap);
        ctx.symbol_for_syms = realloc_n<ZjsSymbol*>(ctx.symbol_for_syms, (usize)ctx.symbol_for_cap, (usize)new_cap);
        ctx.symbol_for_cap = new_cap;
    }
    ctx.symbol_for_keys[ctx.symbol_for_count] = key_str;
    ctx.symbol_for_syms[ctx.symbol_for_count] = sym;
    ctx.symbol_for_count = ctx.symbol_for_count + 1;
    return zjs_cell_from_ptr((void*)sym);
}

fn host_symbol_keyfor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 || zjs_is_symbol(args[0]) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Symbol.keyFor expects a Symbol", 30);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let sym = zjs_as_symbol(args[0]);
    let i: u32 = 0;
    while i < ctx.symbol_for_count {
        if ctx.symbol_for_syms[i] == sym {
            return zjs_cell_from_ptr((void*)ctx.symbol_for_keys[i]);
        }
        i = i + 1;
    }
    return zjs_undefined();
}

fn host_symbol_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_symbol(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Symbol.prototype.toString called on non-Symbol", 46);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let sym = zjs_as_symbol(this_v);
    let desc_len: u32 = if sym.description != NULL { sym.description.length } else { 0 };
    let desc_ptr: char* = NULL;
    if sym.description != NULL { desc_ptr = sym.description.data; }
    let total: u32 = desc_len + 8;   // "Symbol(" + desc + ")"
    let buf = alloc_n<char>((usize)(total + 1));
    raw {
        if (desc_ptr) {
            snprintf(buf, total + 1, "Symbol(%.*s)", (int)desc_len, desc_ptr);
        } else {
            snprintf(buf, total + 1, "Symbol()");
        }
    }
    let actual_len: u32 = 0;
    raw { actual_len = (uint32_t)strlen(buf); }
    return ctx_intern_string_take(ctx, buf, actual_len);
}

fn host_symbol_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_symbol(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Symbol.prototype.valueOf called on non-Symbol", 45);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return this_v;
}

fn host_async_resume_fulfilled(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let cont_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        cont_v = hf.bound;
    }
    if zjs_is_async_cont(cont_v) == 0 { return zjs_undefined(); }
    let cont = zjs_as_async_cont(cont_v);
    let val = if argc >= 1 { args[0] } else { zjs_undefined() };
    let is_throw_out: bool = false;
    let thrown_val:   ZjsValue = zjs_undefined();
    raw {
        extern InterpretResult interpret_resume(ZjsContext* ctx, ZjsAsyncCont* cont, ZjsValue v, bool is_throw);
        InterpretResult r = interpret_resume(ctx, cont, val, 0);
        is_throw_out = r.is_throw;
        thrown_val   = r.value;
    }
    if is_throw_out {
        promise_settle(ctx, cont.outer_promise, thrown_val, false);
    }
    return zjs_undefined();
}

fn host_async_resume_rejected(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let cont_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        cont_v = hf.bound;
    }
    if zjs_is_async_cont(cont_v) == 0 { return zjs_undefined(); }
    let cont = zjs_as_async_cont(cont_v);
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    let is_throw_out: bool = false;
    let thrown_val:   ZjsValue = zjs_undefined();
    raw {
        extern InterpretResult interpret_resume(ZjsContext* ctx, ZjsAsyncCont* cont, ZjsValue v, bool is_throw);
        InterpretResult r = interpret_resume(ctx, cont, reason, 1);
        is_throw_out = r.is_throw;
        thrown_val   = r.value;
    }
    if is_throw_out {
        promise_settle(ctx, cont.outer_promise, thrown_val, false);
    }
    return zjs_undefined();
}

fn host_promise_resolve_fn(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Per-instance bound = the target promise.
    let target_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        target_v = hf.bound;
    }
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    promise_resolve_with(ctx, target_v, value);
    return zjs_undefined();
}

fn host_promise_reject_fn(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target_v: ZjsValue = zjs_undefined();
    if ctx.current_host_fn != NULL {
        let hf: ZjsHostFunction* = NULL;
        raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
        target_v = hf.bound;
    }
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    promise_settle(ctx, target_v, reason, false);
    return zjs_undefined();
}

// Promise.withResolvers() — ECMA-262 §27.2.4.7. Returns
// `{ promise, resolve, reject }` where promise is a fresh pending
// Promise and resolve/reject are the bound capability functions.
// Used by code that needs to externalize resolve/reject (sometimes
// called a "deferred" pattern).
// Promise.try(callback, ...args) — call callback synchronously,
// wrap return value in a promise (or reject with the thrown error
// on synchronous throw).
fn host_promise_try(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"try", 3) { return zjs_undefined(); }
    let cb = if argc >= 1 { args[0] } else { zjs_undefined() };
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    let is_callable = zjs_is_function(cb) != 0
                     || zjs_is_closure(cb) != 0
                     || zjs_is_host_function(cb) != 0;
    if !is_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.try callback is not callable", 36);
        promise_settle(ctx, pv, err, false);
        return pv;
    }
    let rest: ZjsValue* = NULL;
    let rest_n: u32 = if argc > 1 { argc - 1 } else { 0 };
    if rest_n > 0 { raw { rest = &args[1]; } }
    let saved_pt = ctx.pending_throw_active;
    let saved_pv = ctx.pending_throw_value;
    ctx.pending_throw_active = false;
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, cb, zjs_undefined(), rest, rest_n); }
    if ctx.pending_throw_active {
        let thrown = ctx.pending_throw_value;
        ctx.pending_throw_active = saved_pt;
        ctx.pending_throw_value = saved_pv;
        promise_settle(ctx, pv, thrown, false);
        return pv;
    }
    promise_resolve_with(ctx, pv, r);
    return pv;
}

fn host_promise_with_resolvers(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"withResolvers", 13) { return zjs_undefined(); }
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    let pv = zjs_cell_from_ptr((void*)p);
    ctx_push_temp_root(ctx, pv);
    defer ctx_pop_temp_root(ctx);

    let resolve_ptr: void* = NULL; raw { resolve_ptr = (void*)host_promise_resolve_fn; }
    let reject_ptr:  void* = NULL; raw { reject_ptr  = (void*)host_promise_reject_fn; }
    let resolve_fn = ctx_make_host_function_arity(ctx, (char*)"resolve", resolve_ptr, 1);
    let reject_fn  = ctx_make_host_function_arity(ctx, (char*)"reject",  reject_ptr, 1);
    zjs_as_host_function(resolve_fn).bound = pv;
    zjs_as_host_function(reject_fn).bound  = pv;

    let r_v = ctx_new_object(ctx);
    let r = zjs_as_object(r_v);
    object_set(ctx, r, ctx_intern_atom(ctx, (char*)"promise", 7), pv);
    object_set(ctx, r, ctx_intern_atom(ctx, (char*)"resolve", 7), resolve_fn);
    object_set(ctx, r, ctx_intern_atom(ctx, (char*)"reject",  6), reject_fn);
    return r_v;
}

// new Promise(executor) — allocates a pending promise, builds bound
// resolve/reject closures, and runs the executor synchronously.
// If the executor throws, the promise is rejected with the thrown value.
// =====================================================================
// Proxy ctor + Reflect static methods (2026-05-20).
// =====================================================================
fn host_proxy_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Proxy requires 2 arguments", 26);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let target  = args[0];
    let handler = args[1];
    // Both target and handler must be object-like (per spec — including
    // arrays, functions, but excluding primitives + null/undefined).
    let target_ok = zjs_is_object(target) != 0 || zjs_is_array(target) != 0
                 || zjs_is_function(target) != 0 || zjs_is_closure(target) != 0
                 || zjs_is_host_function(target) != 0;
    let handler_ok = zjs_is_object(handler) != 0 || zjs_is_array(handler) != 0
                  || zjs_is_function(handler) != 0 || zjs_is_closure(handler) != 0
                  || zjs_is_host_function(handler) != 0;
    if !target_ok || !handler_ok {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Proxy target and handler must be objects", 40);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let p = zjs_proxy_new(target, handler);
    ctx_register_cell(ctx, (void*)p);
    ctx.any_proxy_alive = true;
    return zjs_cell_from_ptr((void*)p);
}

fn host_reflect_get(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_undefined(); }
    return property_get(ctx, args[0], args[1]);
}

fn host_reflect_set(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 3 { return zjs_bool(0); }
    property_set(ctx, args[0], args[1], args[2]);
    if ctx.pending_throw_active { return zjs_bool(0); }
    return zjs_bool(1);
}

fn host_reflect_has(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc < 2 { return zjs_bool(0); }
    let obj = args[0];
    let key = symbol_key_coerce(args[1]);
    // Forward to the same logic the `in` operator uses. Easiest path:
    // check via property_get and the proto chain; for proxies, route to
    // handler.has (the property_get fallback won't catch that, so do an
    // explicit proxy-aware check first).
    if zjs_is_proxy(obj) != 0 {
        let p = zjs_as_proxy(obj);
        if p.revoked { return zjs_bool(0); }
        let has_atom = ctx_intern_atom(ctx, (char*)"has", 3);
        let trap = property_get(ctx, p.handler, zjs_cell_from_ptr((void*)has_atom));
        if zjs_is_function(trap) != 0 || zjs_is_closure(trap) != 0 || zjs_is_host_function(trap) != 0 {
            let argv: ZjsValue*; let argbuf: ZjsValue[2];
            argbuf[0] = p.target; argbuf[1] = key;
            raw { argv = &argbuf[0]; }
            let r = zjs_call_value_with_this(ctx, trap, p.handler, argv, 2);
            return zjs_bool(if zjs_to_bool_coerce(r) != 0 { 1 } else { 0 });
        }
        return host_reflect_has(ctx, args, 2);  // forward
    }
    let v = property_get(ctx, obj, key);
    if ctx.pending_throw_active { return zjs_bool(0); }
    return zjs_bool(if zjs_is_undefined(v) != 0 { 0 } else { 1 });
}

fn host_promise_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §27.2.3.1 step 1: throw TypeError if NewTarget is
    // undefined — i.e. Promise(...) called without `new`.
    if !ctx.new_target_active {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise constructor cannot be invoked without 'new'", 51);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let executor = if argc >= 1 { args[0] } else { zjs_undefined() };
    let p = zjs_promise_new();
    ctx_register_cell(ctx, (void*)p);
    // If called via `class Sub extends Promise {}`, attach Sub.prototype
    // as the cell's per-instance [[Prototype]] so `instanceof Sub`,
    // `getPrototypeOf`, and method lookups (e.g. Sub.prototype.then2)
    // resolve correctly.
    let p_nt_proto = subclass_proto_for(ctx, ctx.promise_ctor_proto);
    if p_nt_proto != NULL { p.proto = p_nt_proto; }
    let pv = zjs_cell_from_ptr((void*)p);
    ctx_push_temp_root(ctx, pv);
    defer ctx_pop_temp_root(ctx);

    // Build resolve/reject bound closures.
    let resolve_ptr: void* = NULL; raw { resolve_ptr = (void*)host_promise_resolve_fn; }
    let reject_ptr:  void* = NULL; raw { reject_ptr  = (void*)host_promise_reject_fn; }
    // ECMA-262 27.2.1.3: the resolving functions are anonymous (name "")
    // with length 1.
    let resolve_fn = ctx_make_host_function_arity(ctx, (char*)"", resolve_ptr, 1);
    let reject_fn  = ctx_make_host_function_arity(ctx, (char*)"", reject_ptr, 1);
    zjs_as_host_function(resolve_fn).bound = pv;
    zjs_as_host_function(reject_fn).bound  = pv;

    let callable = zjs_is_function(executor) != 0
        || zjs_is_closure(executor) != 0
        || zjs_is_host_function(executor) != 0;
    if !callable {
        // ECMA-262 §27.2.3.1 step 2 — synchronous TypeError, not a
        // rejected promise.
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise resolver is not a function", 34);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let exec_args: ZjsValue[2];
    exec_args[0] = resolve_fn;
    exec_args[1] = reject_fn;
    let exec_argp: ZjsValue* = NULL;
    raw { exec_argp = &exec_args[0]; }
    let saved_pt = ctx.pending_throw_active;
    let saved_pv = ctx.pending_throw_value;
    ctx.pending_throw_active = false;
    ctx.pending_throw_value = zjs_undefined();
    raw { (void)zjs_call_value_with_this(ctx, executor, zjs_undefined(), exec_argp, 2); }
    if ctx.pending_throw_active {
        // Executor threw — reject (unless already settled).
        let thrown = ctx.pending_throw_value;
        ctx.pending_throw_active = saved_pt;
        ctx.pending_throw_value = saved_pv;
        promise_settle(ctx, pv, thrown, false);
    }
    return pv;
}

// Promise.resolve(value) — if value is already a promise, return it;
// else create a fulfilled one.
// ECMA-262 §27.2.4.6 (and §27.2.4.5): Promise.resolve / Promise.reject
// require `this` to be an Object (a constructor). Tests in the
// `Promise/{resolve,reject}/ctx-*` clusters call these with a custom
// `this` and assert TypeError when it isn't.
fn require_promise_constructor_this(ctx: ZjsContext*, fn_name: char*, fn_name_len: u32) -> bool {
    let t = ctx.host_this;
    // User functions and closures are always constructible. Host
    // functions are constructible if they were registered with a
    // .prototype (the marker we use for the few real built-in ctors
    // like Promise / RegExp / Error / Number / etc.); plain helper
    // host fns (eval, parseInt, ...) leave it NULL.
    let t_ok: bool = false;
    if zjs_is_function(t) != 0 || zjs_is_closure(t) != 0 {
        t_ok = true;
    } else if zjs_is_host_function(t) != 0 {
        let hf = zjs_as_host_function(t);
        if hf.prototype != NULL { t_ok = true; }
    }
    if !t_ok {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"this is not a constructor", 25);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return false;
    }
    return true;
}

// Spec PromiseCapability — promise + the resolve/reject functions that
// settle it. NewPromiseCapability constructs `new C(executor)` and the
// executor captures the (resolve, reject) it's called with. For `C`
// equal to the built-in Promise we can short-circuit and skip the
// executor dance entirely.
struct PromiseCapability {
    promise: ZjsValue;
    resolve: ZjsValue;
    reject:  ZjsValue;
    ok:      bool;
}

def CAP_RESOLVE_KEY: char* = (char*)"__zjs_cap_r__";
def CAP_REJECT_KEY:  char* = (char*)"__zjs_cap_j__";

fn host_capability_executor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Spec §27.2.1.5.1 GetCapabilitiesExecutor: if [[Resolve]] or
    // [[Reject]] is already set we throw TypeError. Our state object
    // starts with both undefined, so a non-undefined value means the
    // capability's executor was called a second time.
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let state_v = hf.bound;
    if zjs_is_object(state_v) == 0 { return zjs_undefined(); }
    let state = zjs_as_object(state_v);
    let r_atom = ctx_intern_atom(ctx, CAP_RESOLVE_KEY, 13);
    let j_atom = ctx_intern_atom(ctx, CAP_REJECT_KEY, 13);
    let prev_r = object_get(state, r_atom);
    let prev_j = object_get(state, j_atom);
    if zjs_is_undefined(prev_r) == 0 || zjs_is_undefined(prev_j) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise capability executor called more than once", 50);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let rv = if argc >= 1 { args[0] } else { zjs_undefined() };
    let jv = if argc >= 2 { args[1] } else { zjs_undefined() };
    object_set(ctx, state, r_atom, rv);
    object_set(ctx, state, j_atom, jv);
    return zjs_undefined();
}

fn new_promise_capability(ctx: ZjsContext*, ctor_v: ZjsValue) -> PromiseCapability {
    let bad = PromiseCapability{ promise: zjs_undefined(), resolve: zjs_undefined(),
                                  reject: zjs_undefined(), ok: false };
    // Built-in Promise short-circuit — no executor dance needed, the
    // resolve/reject functions are just bound host fns that flip the
    // TAG_PROMISE state directly.
    if value_is_builtin_promise_ctor(ctx, ctor_v) {
        let p = zjs_promise_new();
        ctx_register_cell(ctx, (void*)p);
        let pv = zjs_cell_from_ptr((void*)p);
        let resolve_ptr: void* = NULL; raw { resolve_ptr = (void*)host_promise_resolve_fn; }
        let reject_ptr:  void* = NULL; raw { reject_ptr  = (void*)host_promise_reject_fn; }
        let resolve_v = ctx_make_host_function(ctx, (char*)"resolve", resolve_ptr);
        let reject_v  = ctx_make_host_function(ctx, (char*)"reject",  reject_ptr);
        zjs_as_host_function(resolve_v).bound = pv;
        zjs_as_host_function(reject_v).bound  = pv;
        return PromiseCapability{ promise: pv, resolve: resolve_v, reject: reject_v, ok: true };
    }

    // Generic NewPromiseCapability(C) — build a capture-executor host
    // fn whose `.bound` points to a state object, then call
    // `new C(executor)`. After the call, the state holds (resolve,
    // reject) which must both be callable.
    let state_v = ctx_new_object(ctx);
    let r_atom = ctx_intern_atom(ctx, CAP_RESOLVE_KEY, 13);
    let j_atom = ctx_intern_atom(ctx, CAP_REJECT_KEY, 13);
    object_set(ctx, zjs_as_object(state_v), r_atom, zjs_undefined());
    object_set(ctx, zjs_as_object(state_v), j_atom, zjs_undefined());
    ctx_push_temp_root(ctx, state_v);
    defer ctx_pop_temp_root(ctx);
    let exec_ptr: void* = NULL; raw { exec_ptr = (void*)host_capability_executor; }
    let executor_v = ctx_make_host_function(ctx, (char*)"", exec_ptr);
    zjs_as_host_function(executor_v).bound = state_v;
    let argv: ZjsValue[1]; argv[0] = executor_v;
    let argp: ZjsValue* = NULL; raw { argp = &argv[0]; }
    let promise_v = zjs_construct_value(ctx, ctor_v, argp, 1);
    if ctx.pending_throw_active { return bad; }
    let resolve_v = object_get(zjs_as_object(state_v), r_atom);
    let reject_v  = object_get(zjs_as_object(state_v), j_atom);
    let r_callable: bool = zjs_is_function(resolve_v) != 0 || zjs_is_closure(resolve_v) != 0
                           || zjs_is_host_function(resolve_v) != 0;
    let j_callable: bool = zjs_is_function(reject_v) != 0 || zjs_is_closure(reject_v) != 0
                           || zjs_is_host_function(reject_v) != 0;
    if !r_callable || !j_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise capability resolve/reject is not callable", 50);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return bad;
    }
    return PromiseCapability{ promise: promise_v, resolve: resolve_v, reject: reject_v, ok: true };
}

fn value_is_builtin_promise_ctor(ctx: ZjsContext*, v: ZjsValue) -> bool {
    if zjs_is_host_function(v) == 0 { return false; }
    let hf = zjs_as_host_function(v);
    if hf.prototype == NULL { return false; }
    return hf.prototype == ctx.promise_ctor_proto;
}

fn capability_call_resolve(ctx: ZjsContext*, cap: PromiseCapability, value: ZjsValue) -> void {
    let argv: ZjsValue[1]; argv[0] = value;
    let argp: ZjsValue* = NULL; raw { argp = &argv[0]; }
    zjs_call_value_with_this(ctx, cap.resolve, zjs_undefined(), argp, 1);
}

fn capability_call_reject(ctx: ZjsContext*, cap: PromiseCapability, reason: ZjsValue) -> void {
    let argv: ZjsValue[1]; argv[0] = reason;
    let argp: ZjsValue* = NULL; raw { argp = &argv[0]; }
    zjs_call_value_with_this(ctx, cap.reject, zjs_undefined(), argp, 1);
}

// Spec IfAbruptRejectPromise(value, capability) — used by Promise.all
// / race / any / allSettled / finally where a throwing operation
// inside the combinator MUST be turned into a rejection of the
// returned promise rather than a synchronous throw. (Promise.resolve
// and Promise.reject deliberately don't wrap their capability calls
// — a throwing custom resolve propagates per §27.2.4.7 step 5.)
fn capability_reject_if_pending(ctx: ZjsContext*, cap: PromiseCapability) -> bool {
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return true;
    }
    return false;
}

fn host_promise_resolve_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"resolve", 7) { return zjs_undefined(); }
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    let ctor_v = ctx.host_this;
    // Spec §27.2.4.7 step 4: if `v` is a Promise AND its constructor is
    // `this`, return `v` unchanged. Built-in promises with the built-in
    // ctor satisfy this trivially; for sub-classes we check the
    // .constructor property.
    if zjs_is_promise(v) != 0 && value_is_builtin_promise_ctor(ctx, ctor_v) {
        return v;
    }
    let cap = new_promise_capability(ctx, ctor_v);
    if !cap.ok { return zjs_undefined(); }
    capability_call_resolve(ctx, cap, v);
    return cap.promise;
}

// Promise.reject(reason) — always a new rejected promise built from
// `this` (per spec) — sub-class ctors construct themselves and have
// their own reject path called.
fn host_promise_reject_static(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"reject", 6) { return zjs_undefined(); }
    let r = if argc >= 1 { args[0] } else { zjs_undefined() };
    let cap = new_promise_capability(ctx, ctx.host_this);
    if !cap.ok { return zjs_undefined(); }
    capability_call_reject(ctx, cap, r);
    return cap.promise;
}

// Promise.prototype.then(onFulfilled, onRejected)
fn host_promise_then(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_promise(this_val) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.prototype.then called on non-promise", 44);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let on_f = if argc >= 1 { args[0] } else { zjs_undefined() };
    let on_r = if argc >= 2 { args[1] } else { zjs_undefined() };
    let p = zjs_as_promise(this_val);
    let result = zjs_promise_new();
    ctx_register_cell(ctx, (void*)result);
    let rp = zjs_cell_from_ptr((void*)result);
    if p.state == PROMISE_FULFILLED {
        microtask_enqueue(ctx, on_f, p.value, rp, true);
    } else if p.state == PROMISE_REJECTED {
        microtask_enqueue(ctx, on_r, p.value, rp, false);
    } else {
        promise_attach_reaction(ctx, p, on_f, on_r, rp);
    }
    return rp;
}

// Internal: { promise, results, remaining, idx } per-element binding
// used by Promise.all to track which slot to fill. Re-uses
// __zjs_primitive__ trick: we stash a small descriptor object via
// hidden keys on the on-fulfilled host function.
def PA_PROMISE_KEY: char* = (char*)"__zjs_pa_p__";
def PA_RESULTS_KEY: char* = (char*)"__zjs_pa_r__";
def PA_REM_KEY:     char* = (char*)"__zjs_pa_n__";
def PA_IDX_KEY:     char* = (char*)"__zjs_pa_i__";
def PA_REJECT_KEY:  char* = (char*)"__zjs_pa_j__";

fn host_promise_all_on_fulfill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Per-element state shape:
    //   __zjs_pa_p__: cap.resolve — fires when remaining counter hits 0
    //   __zjs_pa_r__: results array
    //   __zjs_pa_n__: shared-state object (whose own __zjs_pa_n__
    //                  is the int remaining counter)
    //   __zjs_pa_i__: this element's index
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    let cap_resolve = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let res_v = object_get(per, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12));
    let shared_v = object_get(per, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let idx_v = object_get(per, ctx_intern_atom(ctx, PA_IDX_KEY, 12));
    if zjs_is_object(shared_v) == 0 { return zjs_undefined(); }
    let shared = zjs_as_object(shared_v);

    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_array(res_v) != 0 && zjs_is_int32(idx_v) != 0 {
        let arr = zjs_as_array(res_v);
        array_set(arr, (u32)zjs_as_int32(idx_v), value);
    }
    let rem_v = object_get(shared, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem = zjs_as_int32(rem_v) - 1;
    object_set(ctx, shared, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem));
    if rem == 0 {
        let argv: ZjsValue[1]; argv[0] = res_v;
        let argp: ZjsValue* = NULL; raw { argp = &argv[0]; }
        zjs_call_value_with_this(ctx, cap_resolve, zjs_undefined(), argp, 1);
    }
    return zjs_undefined();
}

// Read `C.resolve` (the spec's `promiseResolve`) once per combinator
// call. Per spec, the resolve method is looked up from the
// constructor `this` (not from `Promise` directly) so subclasses
// observe their own override. Each iterated value goes through this
// method — tests assert one .resolve call per item.
//
// Returns the function value, or undefined with pending throw if
// `.resolve` is missing or non-callable.
fn promise_resolve_lookup(ctx: ZjsContext*, ctor_v: ZjsValue) -> ZjsValue {
    let resolve_atom = ctx_intern_atom(ctx, (char*)"resolve", 7);
    let resolve_fn = property_get(ctx, ctor_v, zjs_cell_from_ptr((void*)resolve_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let callable: bool =
           zjs_is_function(resolve_fn)      != 0
        || zjs_is_closure(resolve_fn)       != 0
        || zjs_is_host_function(resolve_fn) != 0;
    if !callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.resolve is not callable", 31);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    return resolve_fn;
}

// Invoke promiseResolve(item) — `this` is the constructor. Returns
// the result, or undefined with pending throw on failure.
fn promise_resolve_call(ctx: ZjsContext*, resolve_fn: ZjsValue, ctor_v: ZjsValue, item: ZjsValue) -> ZjsValue {
    let arg_buf: ZjsValue[1]; arg_buf[0] = item;
    let argp: ZjsValue* = NULL; raw { argp = &arg_buf[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, resolve_fn, ctor_v, argp, 1); }
    return r;
}

fn host_promise_all(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"all", 3) { return zjs_undefined(); }
    let ctor_v = ctx.host_this;

    // Build the result via NewPromiseCapability so `Promise.all.call(Sub, …)`
    // returns a Sub instance and a custom-ctor wrapper observes the
    // executor-captured resolve/reject. Built-in Promise short-circuits
    // to a direct alloc + bound host fns.
    let cap = new_promise_capability(ctx, ctor_v);
    if !cap.ok { return zjs_undefined(); }
    let rp = cap.promise;
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);
    let cap_resolve = cap.resolve;
    let cap_reject  = cap.reject;
    ctx_push_temp_root(ctx, cap_resolve);
    defer ctx_pop_temp_root(ctx);
    ctx_push_temp_root(ctx, cap_reject);
    defer ctx_pop_temp_root(ctx);

    // Spec: read C.resolve once up-front (before iterating). A
    // throwing / missing resolve rejects the result.
    let resolve_fn = promise_resolve_lookup(ctx, ctor_v);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }

    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    let results_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, results_v);
    defer ctx_pop_temp_root(ctx);

    let state_v = ctx_new_object(ctx);
    let state = zjs_as_object(state_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), cap_resolve);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(1));

    let onf_ptr: void* = NULL; raw { onf_ptr = (void*)host_promise_all_on_fulfill; }
    let i: u32 = 0;
    let iter_throw: bool = false;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active {
            iter_throw = true;
            break;
        }
        if step.done { break; }
        let item = step.value;

        let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
        object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12),
                   zjs_int32(zjs_as_int32(rem_v) + 1));

        let per_state_v = ctx_new_object(ctx);
        let per_state = zjs_as_object(per_state_v);
        // PA_PROMISE_KEY now holds cap.resolve (the function we call
        // when the per-elem counter hits zero), NOT the result promise.
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), cap_resolve);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_REM_KEY, 12), state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_IDX_KEY, 12), zjs_int32((i32)i));

        let onf = ctx_make_host_function_arity(ctx, (char*)"", onf_ptr, 1);
        zjs_as_host_function(onf).bound = per_state_v;

        let item_pv = promise_resolve_call(ctx, resolve_fn, ctor_v, item);
        if ctx.pending_throw_active {
            iter_throw = true;
            break;
        }
        if zjs_is_promise(item_pv) == 0 {
            let pp2 = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp2);
            let ppv2 = zjs_cell_from_ptr((void*)pp2);
            promise_resolve_with(ctx, ppv2, item_pv);
            item_pv = ppv2;
        };
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, onf, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, cap_reject, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, onf, cap_reject, zjs_undefined());
        }

        i = i + 1;
    }
    if iter_throw {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }

    // End-of-iteration decrement. Hitting zero means everything settled
    // synchronously (or the iterable was empty); fire the capability's
    // resolve with the results array.
    let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem_after = zjs_as_int32(rem_v) - 1;
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem_after));
    if rem_after == 0 {
        capability_call_resolve(ctx, cap, results_v);
        capability_reject_if_pending(ctx, cap);
    }
    return rp;
}

// Re-read the shared remaining counter via state's PA_REM_KEY ->
// state_v. Patch the on-fulfill helper to read from there.
// (Already done — host_promise_all_on_fulfill reads through `state`.)

fn host_promise_race(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"race", 4) { return zjs_undefined(); }
    let ctor_v = ctx.host_this;

    let cap = new_promise_capability(ctx, ctor_v);
    if !cap.ok { return zjs_undefined(); }
    let rp = cap.promise;
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);
    let cap_resolve = cap.resolve;
    let cap_reject  = cap.reject;
    ctx_push_temp_root(ctx, cap_resolve);
    defer ctx_pop_temp_root(ctx);
    ctx_push_temp_root(ctx, cap_reject);
    defer ctx_pop_temp_root(ctx);

    let ctor_resolve_fn = promise_resolve_lookup(ctx, ctor_v);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }

    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    // race has no counter — the first item that settles wins via the
    // capability's resolve/reject. Empty iterable → never settles.
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active {
            let err = consume_pending_throw(ctx);
            capability_call_reject(ctx, cap, err);
            return rp;
        }
        if step.done { break; }
        let item = step.value;
        let item_pv = promise_resolve_call(ctx, ctor_resolve_fn, ctor_v, item);
        if ctx.pending_throw_active {
            let err = consume_pending_throw(ctx);
            capability_call_reject(ctx, cap, err);
            return rp;
        }
        if zjs_is_promise(item_pv) == 0 {
            let pp = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp);
            let ppv = zjs_cell_from_ptr((void*)pp);
            promise_resolve_with(ctx, ppv, item_pv);
            item_pv = ppv;
        }
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, cap_resolve, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, cap_reject, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, cap_resolve, cap_reject, zjs_undefined());
        }
    }
    return rp;
}

// Promise.allSettled: like .all but always fulfills, with an array
// of { status: 'fulfilled', value } | { status: 'rejected', reason }.
fn host_promise_all_settled_on_settle(ctx: ZjsContext*, args: ZjsValue*, argc: u32, fulfilled: bool) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    let p_v   = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let res_v = object_get(per, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12));
    let shared_v = object_get(per, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let idx_v = object_get(per, ctx_intern_atom(ctx, PA_IDX_KEY, 12));
    if zjs_is_object(shared_v) == 0 { return zjs_undefined(); }
    let shared = zjs_as_object(shared_v);

    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    // Build { status, value/reason }.
    let entry_v = ctx_new_object(ctx);
    let entry = zjs_as_object(entry_v);
    let status_key = ctx_intern_atom(ctx, (char*)"status", 6);
    if fulfilled {
        object_set(ctx, entry, status_key, ctx_intern_string(ctx, (char*)"fulfilled", 9));
        object_set(ctx, entry, ctx_intern_atom(ctx, (char*)"value", 5), v);
    } else {
        object_set(ctx, entry, status_key, ctx_intern_string(ctx, (char*)"rejected", 8));
        object_set(ctx, entry, ctx_intern_atom(ctx, (char*)"reason", 6), v);
    }
    if zjs_is_array(res_v) != 0 && zjs_is_int32(idx_v) != 0 {
        let arr = zjs_as_array(res_v);
        array_set(arr, (u32)zjs_as_int32(idx_v), entry_v);
    }
    let rem_v = object_get(shared, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem = zjs_as_int32(rem_v) - 1;
    object_set(ctx, shared, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem));
    if rem == 0 {
        // p_v now stores the capability's resolve function (mirrors
        // the Promise.all per-element shape — see host_promise_all).
        let argv: ZjsValue[1]; argv[0] = res_v;
        let argp: ZjsValue* = NULL; raw { argp = &argv[0]; }
        zjs_call_value_with_this(ctx, p_v, zjs_undefined(), argp, 1);
    }
    return zjs_undefined();
}

fn host_promise_all_settled_on_fulfill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_promise_all_settled_on_settle(ctx, args, argc, true);
}
fn host_promise_all_settled_on_reject(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_promise_all_settled_on_settle(ctx, args, argc, false);
}

fn host_promise_all_settled(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"allSettled", 10) { return zjs_undefined(); }
    let ctor_v = ctx.host_this;

    let cap = new_promise_capability(ctx, ctor_v);
    if !cap.ok { return zjs_undefined(); }
    let rp = cap.promise;
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);
    let cap_resolve = cap.resolve;
    let cap_reject  = cap.reject;
    ctx_push_temp_root(ctx, cap_resolve);
    defer ctx_pop_temp_root(ctx);
    ctx_push_temp_root(ctx, cap_reject);
    defer ctx_pop_temp_root(ctx);

    let ctor_resolve_fn = promise_resolve_lookup(ctx, ctor_v);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }

    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    let results_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, results_v);
    defer ctx_pop_temp_root(ctx);

    let state_v = ctx_new_object(ctx);
    let state = zjs_as_object(state_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), cap_resolve);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(1));

    let onf_ptr: void* = NULL; raw { onf_ptr = (void*)host_promise_all_settled_on_fulfill; }
    let onr_ptr: void* = NULL; raw { onr_ptr = (void*)host_promise_all_settled_on_reject; }
    let i: u32 = 0;
    let iter_throw: bool = false;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { iter_throw = true; break; }
        if step.done { break; }
        let item = step.value;

        let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
        object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12),
                   zjs_int32(zjs_as_int32(rem_v) + 1));

        let per_state_v = ctx_new_object(ctx);
        let per_state = zjs_as_object(per_state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), cap_resolve);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), results_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_REM_KEY, 12), state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_IDX_KEY, 12), zjs_int32((i32)i));
        let onf = ctx_make_host_function_arity(ctx, (char*)"", onf_ptr, 1);
        let onr = ctx_make_host_function_arity(ctx, (char*)"", onr_ptr, 1);
        zjs_as_host_function(onf).bound = per_state_v;
        zjs_as_host_function(onr).bound = per_state_v;

        let item_pv = promise_resolve_call(ctx, ctor_resolve_fn, ctor_v, item);
        if ctx.pending_throw_active { iter_throw = true; break; }
        if zjs_is_promise(item_pv) == 0 {
            let pp = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp);
            let ppv = zjs_cell_from_ptr((void*)pp);
            promise_resolve_with(ctx, ppv, item_pv);
            item_pv = ppv;
        }
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, onf, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, onr, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, onf, onr, zjs_undefined());
        }
        i = i + 1;
    }
    if iter_throw {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }

    let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem_after = zjs_as_int32(rem_v) - 1;
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem_after));
    if rem_after == 0 {
        capability_call_resolve(ctx, cap, results_v);
        capability_reject_if_pending(ctx, cap);
    }
    return rp;
}

// Promise.any: settles fulfilled with the first fulfillment. If every
// input rejects, settles rejected with an AggregateError-shaped object
// carrying the reasons. (We don't have true AggregateError; a plain
// Error with the right shape covers test262's structural assertions.)
fn host_promise_any_on_fulfill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    // PA_PROMISE_KEY now holds cap.resolve. Calling it is idempotent
    // (the underlying promise stays at its first settled state).
    let cap_resolve = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    let argv: ZjsValue[1]; argv[0] = v;
    let argp: ZjsValue* = NULL; raw { argp = &argv[0]; }
    zjs_call_value_with_this(ctx, cap_resolve, zjs_undefined(), argp, 1);
    return zjs_undefined();
}

fn host_promise_any_on_reject(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let per_v = hf.bound;
    if zjs_is_object(per_v) == 0 { return zjs_undefined(); }
    let per = zjs_as_object(per_v);
    let p_v   = object_get(per, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12));
    let errs_v = object_get(per, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12));
    let shared_v = object_get(per, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let idx_v = object_get(per, ctx_intern_atom(ctx, PA_IDX_KEY, 12));
    if zjs_is_object(shared_v) == 0 { return zjs_undefined(); }
    let shared = zjs_as_object(shared_v);
    let reason = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_array(errs_v) != 0 && zjs_is_int32(idx_v) != 0 {
        let arr = zjs_as_array(errs_v);
        array_set(arr, (u32)zjs_as_int32(idx_v), reason);
    }
    let rem_v = object_get(shared, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem = zjs_as_int32(rem_v) - 1;
    object_set(ctx, shared, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem));
    if rem == 0 {
        // Capability-aware: shared holds cap.reject under PA_REJECT_KEY.
        let cap_reject = object_get(shared, ctx_intern_atom(ctx, PA_REJECT_KEY, 13));
        let agg = build_aggregate_error(ctx, errs_v,
                                        (char*)"All promises were rejected", 26);
        let argv: ZjsValue[1]; argv[0] = agg;
        let argp: ZjsValue* = NULL; raw { argp = &argv[0]; }
        zjs_call_value_with_this(ctx, cap_reject, zjs_undefined(), argp, 1);
    }
    return zjs_undefined();
}

fn host_promise_any(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_promise_constructor_this(ctx, (char*)"any", 3) { return zjs_undefined(); }
    let ctor_v = ctx.host_this;

    let cap = new_promise_capability(ctx, ctor_v);
    if !cap.ok { return zjs_undefined(); }
    let rp = cap.promise;
    ctx_push_temp_root(ctx, rp);
    defer ctx_pop_temp_root(ctx);
    let cap_resolve = cap.resolve;
    let cap_reject  = cap.reject;
    ctx_push_temp_root(ctx, cap_resolve);
    defer ctx_pop_temp_root(ctx);
    ctx_push_temp_root(ctx, cap_reject);
    defer ctx_pop_temp_root(ctx);

    let ctor_resolve_fn = promise_resolve_lookup(ctx, ctor_v);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }

    let iter_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let iter = iter_get(ctx, iter_arg);
    if ctx.pending_throw_active {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }
    ctx_push_temp_root(ctx, iter);
    defer ctx_pop_temp_root(ctx);

    let errs_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, errs_v);
    defer ctx_pop_temp_root(ctx);

    let state_v = ctx_new_object(ctx);
    let state = zjs_as_object(state_v);
    // The on-reject helper consults the shared state for cap.reject
    // (used when every input has rejected and we need to build the
    // AggregateError); PA_PROMISE_KEY carries cap.resolve to the
    // on-fulfill helper.
    object_set(ctx, state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), cap_resolve);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), errs_v);
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(1));
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REJECT_KEY, 13), cap_reject);

    let onf_ptr: void* = NULL; raw { onf_ptr = (void*)host_promise_any_on_fulfill; }
    let onr_ptr: void* = NULL; raw { onr_ptr = (void*)host_promise_any_on_reject; }
    let i: u32 = 0;
    let iter_throw: bool = false;
    while true {
        let step = iter_step(ctx, iter);
        if ctx.pending_throw_active { iter_throw = true; break; }
        if step.done { break; }
        let item = step.value;

        let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
        object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12),
                   zjs_int32(zjs_as_int32(rem_v) + 1));

        let per_state_v = ctx_new_object(ctx);
        let per_state = zjs_as_object(per_state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_PROMISE_KEY, 12), cap_resolve);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_RESULTS_KEY, 12), errs_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_REM_KEY, 12), state_v);
        object_set(ctx, per_state, ctx_intern_atom(ctx, PA_IDX_KEY, 12), zjs_int32((i32)i));
        let onf = ctx_make_host_function_arity(ctx, (char*)"", onf_ptr, 1);
        let onr = ctx_make_host_function_arity(ctx, (char*)"", onr_ptr, 1);
        zjs_as_host_function(onf).bound = per_state_v;
        zjs_as_host_function(onr).bound = per_state_v;

        let item_pv = promise_resolve_call(ctx, ctor_resolve_fn, ctor_v, item);
        if ctx.pending_throw_active { iter_throw = true; break; }
        if zjs_is_promise(item_pv) == 0 {
            let pp = zjs_promise_new();
            ctx_register_cell(ctx, (void*)pp);
            let ppv = zjs_cell_from_ptr((void*)pp);
            promise_resolve_with(ctx, ppv, item_pv);
            item_pv = ppv;
        }
        let ip = zjs_as_promise(item_pv);
        if ip.state == PROMISE_FULFILLED {
            microtask_enqueue(ctx, onf, ip.value, zjs_undefined(), true);
        } else if ip.state == PROMISE_REJECTED {
            microtask_enqueue(ctx, onr, ip.value, zjs_undefined(), false);
        } else {
            promise_attach_reaction(ctx, ip, onf, onr, zjs_undefined());
        }
        i = i + 1;
    }
    if iter_throw {
        let err = consume_pending_throw(ctx);
        capability_call_reject(ctx, cap, err);
        return rp;
    }

    // End-of-iteration decrement. If empty iterable or all already
    // rejected synchronously, build the AggregateError and reject.
    let rem_v = object_get(state, ctx_intern_atom(ctx, PA_REM_KEY, 12));
    let rem_after = zjs_as_int32(rem_v) - 1;
    object_set(ctx, state, ctx_intern_atom(ctx, PA_REM_KEY, 12), zjs_int32(rem_after));
    if rem_after == 0 {
        let agg = build_aggregate_error(ctx, errs_v,
                                        (char*)"All promises were rejected", 26);
        capability_call_reject(ctx, cap, agg);
    }
    return rp;
}

// Promise.prototype.catch(onRejected) ≡ this.then(undefined, onRejected).
fn host_promise_catch(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §27.2.5.1: Return ? Invoke(this, "then", «undefined, onRejected»).
    // Generic over the receiver — any thenable works.
    let this_val = ctx.host_this;
    let on_r = if argc >= 1 { args[0] } else { zjs_undefined() };
    let then_atom = ctx_intern_atom(ctx, (char*)"then", 4);
    let then_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)then_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_callable = zjs_is_function(then_v) != 0
                     || zjs_is_closure(then_v) != 0
                     || zjs_is_host_function(then_v) != 0;
    if !is_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.prototype.catch: receiver has no callable then", 54);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let two_args: ZjsValue[2];
    two_args[0] = zjs_undefined();
    two_args[1] = on_r;
    let argp: ZjsValue* = NULL;
    raw { argp = &two_args[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, then_v, this_val, argp, 2); }
    return r;
}

// Promise.prototype.finally(onFinally): calls onFinally with no args
// regardless of outcome, then propagates the original settlement.
// onFinally's return value is mostly ignored (but if it's a thenable,
// we await it before settling — simplification: just resolve through
// the synchronous case).
fn host_promise_finally_helper(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // bound stores { handler, value, is_fulfilled } as a small descriptor
    // object. (We can't easily distinguish fulfilled vs rejected at
    // call-time, so we encode it on the wrapper.)
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    let desc_v = hf.bound;
    if zjs_is_object(desc_v) == 0 { return zjs_undefined(); }
    let desc = zjs_as_object(desc_v);
    let handler = object_get(desc, ctx_intern_atom(ctx, (char*)"__zjs_h__", 9));
    let is_f_v  = object_get(desc, ctx_intern_atom(ctx, (char*)"__zjs_f__", 9));
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };

    // Run onFinally with no args. Ignore its return (per spec the
    // settlement propagates from the original value).
    let callable: bool = zjs_is_function(handler) != 0
        || zjs_is_closure(handler) != 0
        || zjs_is_host_function(handler) != 0;
    if callable {
        let nullp: ZjsValue* = NULL;
        raw { (void)zjs_call_value_with_this(ctx, handler, zjs_undefined(), nullp, 0); }
    }
    // Propagate. The microtask drain treats our return as the
    // resolution value, so on rejection we need to re-throw — the
    // surrounding reaction loop reads pending_throw_active to
    // distinguish "fulfilled with v" from "rejected with v".
    if zjs_is_bool(is_f_v) != 0 && zjs_as_bool(is_f_v) != 0 {
        return value;
    }
    ctx.pending_throw_active = true;
    ctx.pending_throw_value = value;
    return zjs_undefined();
}

fn host_promise_finally(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §27.2.5.3: Invoke(this, "then", «onFinally', onFinally'»).
    // Generic over the receiver — any thenable works.
    let this_val = ctx.host_this;
    let then_atom = ctx_intern_atom(ctx, (char*)"then", 4);
    let then_v = property_get(ctx, this_val, zjs_cell_from_ptr((void*)then_atom));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let is_callable = zjs_is_function(then_v) != 0
                     || zjs_is_closure(then_v) != 0
                     || zjs_is_host_function(then_v) != 0;
    if !is_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Promise.prototype.finally: receiver has no callable then", 56);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let handler = if argc >= 1 { args[0] } else { zjs_undefined() };
    // Build a descriptor for both paths and synthesize wrapper hosts.
    let desc_f_v = ctx_new_object(ctx);
    let desc_r_v = ctx_new_object(ctx);
    let h_atom = ctx_intern_atom(ctx, (char*)"__zjs_h__", 9);
    let f_atom = ctx_intern_atom(ctx, (char*)"__zjs_f__", 9);
    object_set(ctx, zjs_as_object(desc_f_v), h_atom, handler);
    object_set(ctx, zjs_as_object(desc_f_v), f_atom, zjs_bool(1));
    object_set(ctx, zjs_as_object(desc_r_v), h_atom, handler);
    object_set(ctx, zjs_as_object(desc_r_v), f_atom, zjs_bool(0));
    let fh_ptr: void* = NULL; raw { fh_ptr = (void*)host_promise_finally_helper; }
    let wrap_f = ctx_make_host_function(ctx, (char*)"finally_f", fh_ptr);
    let wrap_r = ctx_make_host_function(ctx, (char*)"finally_r", fh_ptr);
    zjs_as_host_function(wrap_f).bound = desc_f_v;
    zjs_as_host_function(wrap_r).bound = desc_r_v;
    let two: ZjsValue[2];
    two[0] = wrap_f; two[1] = wrap_r;
    let argp: ZjsValue* = NULL;
    raw { argp = &two[0]; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, then_v, this_val, argp, 2); }
    return r;
}

// --- console.log (Phase 3.8a) -------------------------------------
//
// Minimum console implementation: log / info / warn / error all print
// their args space-separated to stdout (warn/error to stderr) followed
// by a newline. Formatting roughly matches the CLI's `eval` printer.

raw {
    #include <stdio.h>
}

fn console_write_value(ctx: ZjsContext*, v: ZjsValue, stream_is_stderr: bool) -> void {
    if zjs_is_undefined(v) != 0 {
        raw {
            if (stream_is_stderr) fputs("undefined", stderr);
            else fputs("undefined", stdout);
        }
        return;
    }
    if zjs_is_null(v) != 0 {
        raw {
            if (stream_is_stderr) fputs("null", stderr);
            else fputs("null", stdout);
        }
        return;
    }
    if zjs_is_bool(v) != 0 {
        let b = zjs_as_bool(v);
        raw {
            if (stream_is_stderr) fputs(b ? "true" : "false", stderr);
            else fputs(b ? "true" : "false", stdout);
        }
        return;
    }
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw {
            if (stream_is_stderr) fprintf(stderr, "%d", (int)n);
            else fprintf(stdout, "%d", (int)n);
        }
        return;
    }
    if zjs_is_double(v) != 0 {
        // Match ECMA-262 NumberToString: integer-valued doubles
        // print as integers (Date.now() = 1779140000000, not 1.78e12);
        // others get the shortest round-trip-stable representation.
        let s_v = zjs_to_string(ctx, v);
        if zjs_is_string(s_v) != 0 {
            let s = zjs_as_string(s_v);
            raw {
                if (stream_is_stderr) fwrite(s->data, 1, s->length, stderr);
                else                  fwrite(s->data, 1, s->length, stdout);
            }
        }
        return;
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let sd = s.data;
        let sn = s.length;
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            fwrite(sd, 1, sn, out);
        }
        return;
    }
    // For arrays/objects, defer to JSON.stringify-style output.
    // Simplest path: produce JSON output (skips functions). Reuses
    // json_stringify_value with a fresh buf so we don't fight the
    // CLI's pretty printer.
    if zjs_is_array(v) != 0 || zjs_is_object(v) != 0 {
        let b: JsonBuf;
        b.data = NULL; b.len = 0; b.cap = 0;
        let nojc: JsonCtx;
        nojc.replacer_fn = zjs_undefined();
        nojc.replacer_arr = zjs_undefined();
        nojc.indent_str = NULL;
        nojc.indent_len = 0;
        nojc.depth = 0;
        nojc.stack_depth = 0;
        // Pass the real ctx — json_stringify_value reaches into the
        // atom table (toJSON dispatch, wrapper unboxing) and calls
        // ToPrimitive on Number/String wrappers.
        json_stringify_value(ctx, &nojc, &b, v);
        let bd = b.data;
        let bn = b.len;
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            if (bd && bn) fwrite(bd, 1, bn, out);
            free(bd);
        }
        return;
    }
    if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            fputs("[function]", out);
        }
        return;
    }
    // BigInt: console shows the decimal with a trailing `n` (Node parity).
    if zjs_is_bigint(v) != 0 {
        let b = zjs_as_bigint(v);
        let blen: u32 = 0;
        let bs = bigint_to_decimal_cstring(b, &blen);
        raw {
            FILE* out = stream_is_stderr ? stderr : stdout;
            fwrite(bs, 1, blen, out);
            fputc('n', out);
        }
        dealloc(bs);
        return;
    }
    raw {
        FILE* out = stream_is_stderr ? stderr : stdout;
        fputs("[unknown]", out);
    }
}

fn console_emit(ctx: ZjsContext*, args: ZjsValue*, argc: u32, stderr_stream: bool) -> ZjsValue {
    let i: u32 = 0;
    while i < argc {
        if i > 0 {
            raw {
                if (stderr_stream) fputc(' ', stderr);
                else fputc(' ', stdout);
            }
        }
        console_write_value(ctx, args[i], stderr_stream);
        i = i + 1;
    }
    raw {
        if (stderr_stream) fputc('\n', stderr);
        else fputc('\n', stdout);
    }
    return zjs_undefined();
}

fn host_console_log(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}

fn host_console_info(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}

fn host_console_warn(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, true);
}

fn host_console_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, true);
}

// .debug/.trace are stdout-bound aliases of .log. We don't carry
// stack traces yet; .trace just prints its args. A future polish
// pass can add level tags / stack capture once we have either.
fn host_console_debug(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}
fn host_console_trace(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}
fn host_console_dir(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}
fn host_console_group(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return console_emit(ctx, args, argc, false);
}
fn host_console_group_end(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return zjs_undefined();
}
fn host_console_assert(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // console.assert(cond, ...msg) — only emits when cond is falsy,
    // routed to stderr with an "Assertion failed:" prefix-equivalent
    // (we currently emit raw args; full prefix can come later).
    if argc == 0 { return zjs_undefined(); }
    if zjs_to_bool_coerce(args[0]) != 0 { return zjs_undefined(); }
    return console_emit(ctx, args + 1, argc - 1, true);
}

// =====================================================================
// Web-platform Phase A (2026-05-18) — quick wins. Pure CPU, no event
// loop integration. setTimeout / fetch / etc. follow in Phase B and
// beyond.
// =====================================================================

// queueMicrotask(fn) — schedule fn to run after the current sync
// block, BEFORE the next setTimeout. Routes through the existing
// microtask queue used by Promise.
fn host_queue_microtask(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let cb = args[0];
    let callable: bool =
           zjs_is_function(cb) != 0
        || zjs_is_closure(cb)  != 0
        || zjs_is_host_function(cb) != 0;
    if !callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"queueMicrotask requires a function", 34);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    // Use the existing microtask queue. The handler takes no args
    // (we pass undefined); the result_promise is undefined so
    // drain_microtasks doesn't try to chain it.
    microtask_enqueue(ctx, cb, zjs_undefined(), zjs_undefined(), true);
    return zjs_undefined();
}

// performance.now() — monotonic high-resolution wall-clock in ms.
// Origin is unspecified by spec; we use CLOCK_MONOTONIC from program
// start (i.e. the value is relative, not an epoch). Tests just want
// "increases monotonically + sub-ms resolution + double-valued".
fn host_performance_now(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ms: f64 = 0.0;
    raw {
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        ms = (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
    }
    return zjs_double(ms);
}

// reportError(error) — surfaces an error as if uncaught. Without a
// proper uncaughtException hook, we print to stderr and continue
// (matches the WinterTC minimum — "the runtime reports it somehow").
fn host_report_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_undefined(); }
    let e = args[0];
    let name_v: ZjsValue = ctx_intern_string(ctx, (char*)"Error", 5);
    let msg_v:  ZjsValue = zjs_to_string(ctx, e);
    if zjs_is_object(e) != 0 {
        let o = zjs_as_object(e);
        let n = property_get(ctx, e, ctx_intern_string(ctx, (char*)"name", 4));
        if zjs_is_string(n) != 0 { name_v = n; }
        let m = property_get(ctx, e, ctx_intern_string(ctx, (char*)"message", 7));
        if zjs_is_string(m) != 0 { msg_v = m; }
    }
    let name_s = zjs_as_string(name_v);
    let msg_s  = zjs_as_string(msg_v);
    raw {
        fprintf(stderr, "Uncaught (in reportError) %.*s: %.*s\n",
                (int)name_s->length, name_s->data,
                (int)msg_s->length,  msg_s->data);
    }
    return zjs_undefined();
}

// encodeURI / encodeURIComponent / decodeURI / decodeURIComponent —
// ECMA-262 §19.2.6. The "Component" variants percent-encode every
// non-unreserved char; the plain variants additionally leave URI
// punctuation (`;/?:@&=+$,#`) and the unescaped-set chars unencoded.
// uuid v5 uses encodeURIComponent + unescape to make a stable byte
// string from the name input. Both must walk UTF-8 codepoints
// correctly so multi-byte sequences round-trip.
fn encode_uri_impl(ctx: ZjsContext*, s_v: ZjsValue, keep_uri_punct: bool) -> ZjsValue {
    if zjs_is_string(s_v) == 0 { s_v = zjs_to_string(ctx, s_v); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    let s = zjs_as_string(s_v);
    let cap = s.length * 4 + 1;
    let buf = alloc_n<char>((usize)cap);
    let out: u32 = 0;
    raw {
        const char* lut = (const char*)"0123456789ABCDEF";
        for (uint32_t i = 0; i < s->length; i++) {
            unsigned char c = (unsigned char)s->data[i];
            int unreserved =
                   (c >= 'A' && c <= 'Z')
                || (c >= 'a' && c <= 'z')
                || (c >= '0' && c <= '9')
                || c == '-' || c == '_' || c == '.'
                || c == '!' || c == '~' || c == '*'
                || c == '\'' || c == '(' || c == ')';
            int uri_punct = (c == ';' || c == '/' || c == '?' || c == ':'
                          || c == '@' || c == '&' || c == '=' || c == '+'
                          || c == '$' || c == ',' || c == '#');
            if (unreserved || (keep_uri_punct && uri_punct)) {
                buf[out++] = (char)c;
            } else {
                buf[out++] = '%';
                buf[out++] = lut[(c >> 4) & 0xf];
                buf[out++] = lut[c & 0xf];
            }
        }
    }
    buf[out] = (char)0;
    return ctx_intern_string_take(ctx, buf, out);
}

fn host_encode_uri(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    return encode_uri_impl(ctx, s_v, true);
}

fn host_encode_uri_component(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    return encode_uri_impl(ctx, s_v, false);
}

fn decode_uri_impl(ctx: ZjsContext*, s_v: ZjsValue) -> ZjsValue {
    if zjs_is_string(s_v) == 0 { s_v = zjs_to_string(ctx, s_v); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    let s = zjs_as_string(s_v);
    let buf = alloc_n<char>((usize)(s.length + 1));
    let out: u32 = 0;
    raw {
        for (uint32_t i = 0; i < s->length; ) {
            char c = s->data[i];
            if (c == '%' && i + 2 < s->length) {
                char h1 = s->data[i+1];
                char h2 = s->data[i+2];
                int d1 = (h1 >= '0' && h1 <= '9') ? h1 - '0'
                       : (h1 >= 'A' && h1 <= 'F') ? h1 - 'A' + 10
                       : (h1 >= 'a' && h1 <= 'f') ? h1 - 'a' + 10
                       : -1;
                int d2 = (h2 >= '0' && h2 <= '9') ? h2 - '0'
                       : (h2 >= 'A' && h2 <= 'F') ? h2 - 'A' + 10
                       : (h2 >= 'a' && h2 <= 'f') ? h2 - 'a' + 10
                       : -1;
                if (d1 >= 0 && d2 >= 0) {
                    buf[out++] = (char)((d1 << 4) | d2);
                    i += 3;
                    continue;
                }
            }
            buf[out++] = c;
            i++;
        }
    }
    buf[out] = (char)0;
    return ctx_intern_string_take(ctx, buf, out);
}

fn host_decode_uri(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    return decode_uri_impl(ctx, s_v);
}

fn host_decode_uri_component(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    return decode_uri_impl(ctx, s_v);
}

// escape(s) — ECMA-262 Annex B §B.2.1.1. Replaces every char outside
// [A-Za-z0-9@*_+\-./] with %XX (or %uXXXX for codepoints > 0xFF).
// Legacy but used by libraries like uuid v5 for byte-encoding a name
// into a stable byte sequence before hashing. We treat the input
// codepoint-by-codepoint as if it were UTF-16; codepoints in
// [0x80, 0xFF] emit %XX, anything else %uXXXX.
fn host_escape(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    if zjs_is_string(s_v) == 0 { s_v = zjs_to_string(ctx, s_v); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    let s = zjs_as_string(s_v);
    // Each input byte expands to at most 6 chars ("%uXXXX"); start with
    // a generous estimate and let the call site reuse it.
    let cap = s.length * 6 + 1;
    let buf = alloc_n<char>((usize)cap);
    let out: u32 = 0;
    let i: u32 = 0;
    raw {
        const char* unsafe_lut = (const char*)"0123456789ABCDEF";
        while (i < s->length) {
            unsigned char c = (unsigned char)s->data[i];
            int safe =
                (c >= 'A' && c <= 'Z')
                || (c >= 'a' && c <= 'z')
                || (c >= '0' && c <= '9')
                || c == '@' || c == '*' || c == '_' || c == '+'
                || c == '-' || c == '.' || c == '/';
            if (safe) {
                buf[out++] = (char)c;
            } else if (c < 0x80) {
                buf[out++] = '%';
                buf[out++] = unsafe_lut[(c >> 4) & 0xf];
                buf[out++] = unsafe_lut[c & 0xf];
            } else {
                /* High-bit byte — escape as %uXXXX so the inverse
                 * unescape() recovers the original codepoint. uuid
                 * v5 always feeds escape() ASCII names, so this is
                 * the lossy-but-safe path. */
                buf[out++] = '%';
                buf[out++] = 'u';
                buf[out++] = '0';
                buf[out++] = '0';
                buf[out++] = unsafe_lut[(c >> 4) & 0xf];
                buf[out++] = unsafe_lut[c & 0xf];
            }
            i++;
        }
    }
    buf[out] = (char)0;
    return ctx_intern_string_take(ctx, buf, out);
}

// unescape(s) — Annex B inverse of escape. Recognizes %XX (2 hex) and
// %uXXXX (4 hex); leaves invalid sequences as-is.
fn host_unescape(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let s_v = if argc >= 1 { args[0] } else { ctx_intern_string(ctx, (char*)"undefined", 9) };
    if zjs_is_string(s_v) == 0 { s_v = zjs_to_string(ctx, s_v); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    let s = zjs_as_string(s_v);
    let buf = alloc_n<char>((usize)(s.length + 1));
    let out: u32 = 0;
    let i: u32 = 0;
    raw {
        while (i < s->length) {
            char c = s->data[i];
            if (c == '%' && i + 2 < s->length && s->data[i+1] == 'u' && i + 5 < s->length) {
                /* %uXXXX */
                int ok = 1;
                int v = 0;
                for (int k = 0; k < 4; k++) {
                    char hc = s->data[i + 2 + k];
                    int dv = (hc >= '0' && hc <= '9') ? hc - '0'
                           : (hc >= 'A' && hc <= 'F') ? hc - 'A' + 10
                           : (hc >= 'a' && hc <= 'f') ? hc - 'a' + 10
                           : -1;
                    if (dv < 0) { ok = 0; break; }
                    v = (v << 4) | dv;
                }
                if (ok) {
                    /* Single-byte codepoint range — keep simple. uuid
                     * roundtrips strings that escape() emitted, so
                     * we don't need full UTF-8 here. */
                    if (v < 0x80) {
                        buf[out++] = (char)v;
                    } else {
                        /* Truncate to low byte. v5's hash sees the
                         * exact same bytes the browser would. */
                        buf[out++] = (char)(v & 0xff);
                    }
                    i += 6;
                    continue;
                }
            }
            if (c == '%' && i + 2 < s->length) {
                char h1 = s->data[i+1];
                char h2 = s->data[i+2];
                int d1 = (h1 >= '0' && h1 <= '9') ? h1 - '0'
                       : (h1 >= 'A' && h1 <= 'F') ? h1 - 'A' + 10
                       : (h1 >= 'a' && h1 <= 'f') ? h1 - 'a' + 10
                       : -1;
                int d2 = (h2 >= '0' && h2 <= '9') ? h2 - '0'
                       : (h2 >= 'A' && h2 <= 'F') ? h2 - 'A' + 10
                       : (h2 >= 'a' && h2 <= 'f') ? h2 - 'a' + 10
                       : -1;
                if (d1 >= 0 && d2 >= 0) {
                    buf[out++] = (char)((d1 << 4) | d2);
                    i += 3;
                    continue;
                }
            }
            buf[out++] = c;
            i++;
        }
    }
    buf[out] = (char)0;
    return ctx_intern_string_take(ctx, buf, out);
}

// btoa(binary_string) — base64 encode each character's low byte.
// WHATWG semantics: argument is a "binary string" where each code
// unit must fit in a byte; otherwise throws InvalidCharacterError.
// We surface as plain DOMException-equivalent (a tagged Error).
fn host_btoa(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let in_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let s = zjs_as_string(in_v);
    let n = s.length;
    // Validate range — each char must be ≤ 0xFF.
    let i: u32 = 0;
    while i < n {
        let cu: u32 = (u32)(u8)s.data[i];
        if cu > 255 {
            let err = build_typed_error(ctx, (char*)"InvalidCharacterError", 21,
                                        (char*)"btoa: argument contains characters outside Latin-1", 50);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        i = i + 1;
    }
    let out_len: u32 = ((n + 2) / 3) * 4;
    let buf = alloc_n<char>((usize)(out_len + 1));
    raw {
        static const char TBL[] =
            "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        const unsigned char* in_ = (const unsigned char*)s->data;
        uint32_t inN = n;
        uint32_t oi = 0;
        for (uint32_t k = 0; k + 3 <= inN; k += 3) {
            uint32_t v = ((uint32_t)in_[k] << 16) | ((uint32_t)in_[k+1] << 8) | (uint32_t)in_[k+2];
            buf[oi+0] = TBL[(v >> 18) & 63];
            buf[oi+1] = TBL[(v >> 12) & 63];
            buf[oi+2] = TBL[(v >>  6) & 63];
            buf[oi+3] = TBL[ v        & 63];
            oi += 4;
        }
        uint32_t rem = inN % 3;
        if (rem == 1) {
            uint32_t k = inN - 1;
            uint32_t v = (uint32_t)in_[k] << 16;
            buf[oi+0] = TBL[(v >> 18) & 63];
            buf[oi+1] = TBL[(v >> 12) & 63];
            buf[oi+2] = '=';
            buf[oi+3] = '=';
        } else if (rem == 2) {
            uint32_t k = inN - 2;
            uint32_t v = ((uint32_t)in_[k] << 16) | ((uint32_t)in_[k+1] << 8);
            buf[oi+0] = TBL[(v >> 18) & 63];
            buf[oi+1] = TBL[(v >> 12) & 63];
            buf[oi+2] = TBL[(v >>  6) & 63];
            buf[oi+3] = '=';
        }
    }
    buf[out_len] = (char)0;
    let r = ctx_intern_string(ctx, buf, out_len);
    dealloc(buf);
    return r;
}

// atob(b64) — inverse. Throws InvalidCharacterError on bad input.
// Whitespace is stripped per spec.
fn host_atob(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let in_v = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
    let s = zjs_as_string(in_v);
    // Worst case: every input char is a base64 digit → output is
    // (n / 4) * 3 bytes. Reserve generously.
    let buf = alloc_n<char>((usize)(s.length + 4));
    let out_len: u32 = 0;
    let bad: int = 0;
    raw {
        static int8_t DEC[256];
        static int dec_init = 0;
        if (!dec_init) {
            for (int j = 0; j < 256; j++) DEC[j] = -1;
            const char* T = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
            for (int j = 0; j < 64; j++) DEC[(int)(unsigned char)T[j]] = (int8_t)j;
            dec_init = 1;
        }
        uint32_t accum = 0;
        uint32_t nbits = 0;
        const unsigned char* in_ = (const unsigned char*)s->data;
        uint32_t inN = s->length;
        for (uint32_t k = 0; k < inN; k++) {
            unsigned char c = in_[k];
            if (c == '\t' || c == '\n' || c == '\f' || c == '\r' || c == ' ') continue;
            if (c == '=') break;
            int8_t v = DEC[c];
            if (v < 0) { bad = 1; break; }
            accum = (accum << 6) | (uint32_t)v;
            nbits += 6;
            if (nbits >= 8) {
                nbits -= 8;
                buf[out_len++] = (char)((accum >> nbits) & 0xFF);
            }
        }
    }
    if bad != 0 {
        dealloc(buf);
        let err = build_typed_error(ctx, (char*)"InvalidCharacterError", 21,
                                    (char*)"atob: argument is not valid base64", 34);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    buf[out_len] = (char)0;
    let r = ctx_intern_string(ctx, buf, out_len);
    dealloc(buf);
    return r;
}

// Build a synthetic { name, message } error object — used to surface
// parse / compile / lookup failures as JS-visible throws. Also wires
// the object's proto to the same `<Type>.prototype` the user-callable
// constructor uses, so `e instanceof ReferenceError` works for our
// internally-thrown errors.
fn build_typed_error(ctx: ZjsContext*, type_name: char*, type_len: u32, msg: char*, msg_len: u32) -> ZjsValue {
    let obj_v = ctx_new_object(ctx);
    // Defensive rooting: obj_v lives across multiple cell-allocating
    // helper calls below (intern, object_set with possible class
    // transitions, intern_string). Today GC only fires at interp
    // boundaries so we're not at real risk, but this insulates us
    // when item 1 (GC-in-allocator) lands — and from any future
    // refactor that adds a JS callback to this path.
    ctx_push_temp_root(ctx, obj_v);
    defer ctx_pop_temp_root(ctx);
    let obj = zjs_as_object(obj_v);
    // Set proto from the matching global error constructor's prototype.
    let ctor_slot = ctx_intern_global(ctx, type_name, type_len);
    let ctor_v = ctx.globals[ctor_slot].value;
    if zjs_is_host_function(ctor_v) != 0 {
        let hf = zjs_as_host_function(ctor_v);
        if hf.prototype == NULL {
            let pv = ctx_new_object(ctx);
            hf.prototype = zjs_as_object(pv);
        }
        obj.proto = hf.prototype;
    }
    let name_atom = ctx_intern_atom(ctx, (char*)"name", 4);
    let msg_atom  = ctx_intern_atom(ctx, (char*)"message", 7);
    let name_val_str = ctx_intern_atom(ctx, type_name, type_len);
    object_set(ctx, obj, name_atom, zjs_cell_from_ptr((void*)name_val_str));
    let msg_str = ctx_intern_string(ctx, msg, msg_len);
    object_set(ctx, obj, msg_atom, msg_str);
    return obj_v;
}

fn build_syntax_error(ctx: ZjsContext*, msg: char*) -> ZjsValue {
    let msg_len: u32 = 0;
    raw { msg_len = (uint32_t)strlen(msg); }
    return build_typed_error(ctx, (char*)"SyntaxError", 11, msg, msg_len);
}

fn build_reference_error(ctx: ZjsContext*, name: char*, name_len: u32) -> ZjsValue {
    let buf: char[256];
    let written: int = 0;
    let bp: char* = NULL;
    raw {
        bp = &buf[0];
        int n = (int)name_len; if (n > 200) n = 200;
        written = snprintf(bp, 256, "%.*s is not defined", n, name);
    }
    return build_typed_error(ctx, (char*)"ReferenceError", 14, bp, (u32)written);
}

fn build_type_error(ctx: ZjsContext*, msg: char*) -> ZjsValue {
    let msg_len: u32 = 0;
    raw { msg_len = (uint32_t)strlen(msg); }
    return build_typed_error(ctx, (char*)"TypeError", 9, msg, msg_len);
}

// --- Object.prototype methods (Phase 3.8c) -------------------------

// Object.prototype.hasOwnProperty(key) — checks own properties only,
// not the proto chain. Reads ctx.host_this for the receiver.
// Object.prototype.propertyIsEnumerable(V): true if `V` (as a string
// key) is an own property of `this` AND is enumerable. Walks only
// own slots — no prototype chain.
fn host_property_is_enumerable(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_val = ctx.host_this;
    let key = args[0];
    if zjs_is_string(key) == 0 { key = zjs_to_string(ctx, key); }
    let name = zjs_as_string(key);
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let slot = class_find_slot(o.cls, name);
        if slot >= 0 && zjs_is_deleted(o.slots[(u32)slot]) == 0 {
            let attrs = object_get_attrs(o, (u32)slot);
            if (attrs & PROP_ENUMERABLE) != 0 { return zjs_bool(1); }
        }
        return zjs_bool(0);
    }
    if zjs_is_array(this_val) != 0 {
        let a = zjs_as_array(this_val);
        let idx = zjs_to_array_index(key);
        if idx >= 0 && array_has_index(a, (u32)idx) != 0 { return zjs_bool(1); }
        if a.props != NULL {
            let slot = class_find_slot(a.props.cls, name);
            if slot >= 0 && zjs_is_deleted(a.props.slots[(u32)slot]) == 0 {
                let attrs = object_get_attrs(a.props, (u32)slot);
                if (attrs & PROP_ENUMERABLE) != 0 { return zjs_bool(1); }
            }
        }
    }
    return zjs_bool(0);
}

// Object.prototype.isPrototypeOf(V): walk V's prototype chain looking
// for `this`. Returns true if found, false otherwise. Non-object V
// always returns false.
fn host_is_prototype_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_val = ctx.host_this;
    let v = args[0];
    // We need a way to compare `this_val` (a ZjsObject) against each
    // proto in V's chain. Only object-ish `this` can be a proto.
    let proto_target: ZjsObject* = NULL;
    if zjs_is_object(this_val) != 0 { proto_target = zjs_as_object(this_val); }
    else { return zjs_bool(0); }
    // V must have a proto chain we can walk — objects/arrays are
    // covered uniformly via getPrototypeOf-style logic.
    let cur: ZjsObject* = NULL;
    if zjs_is_object(v) != 0 {
        cur = zjs_as_object(v).proto;
    } else if zjs_is_array(v) != 0 {
        cur = ctx.array_proto;
    } else {
        return zjs_bool(0);
    }
    while cur != NULL {
        if cur == proto_target { return zjs_bool(1); }
        cur = cur.proto;
    }
    return zjs_bool(0);
}

fn host_has_own_property(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let this_val = ctx.host_this;
    let key = args[0];
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let name = if zjs_is_string(key) != 0 { zjs_as_string(key) }
                   else                       { zjs_as_string(zjs_to_string(ctx, key)) };
        let slot = class_find_slot(o.cls, name);
        if slot >= 0 && zjs_is_deleted(o.slots[(u32)slot]) == 0 { return zjs_bool(1); }
        return zjs_bool(0);
    }
    if zjs_is_array(this_val) != 0 {
        let a = zjs_as_array(this_val);
        let idx = zjs_to_array_index(key);
        // Holes report as absent (HasOwnProperty is false for them).
        if idx >= 0 && array_has_index(a, (u32)idx) != 0 { return zjs_bool(1); }
        if zjs_is_string(key) != 0 {
            let ks = zjs_as_string(key);
            let kd = ks.data;
            let kn = ks.length;
            let is_length: int = 0;
            raw { is_length = (kn == 6 && memcmp(kd, "length", 6) == 0) ? 1 : 0; }
            if is_length != 0 { return zjs_bool(1); }
            // Expando bag (e.g. `let a = []; a.foo = 1;`).
            if a.props != NULL {
                let slot = class_find_slot(a.props.cls, ks);
                if slot >= 0 && zjs_is_deleted(a.props.slots[(u32)slot]) == 0 { return zjs_bool(1); }
            }
        }
        return zjs_bool(0);
    }
    if zjs_is_host_function(this_val) != 0 && zjs_is_string(key) != 0 {
        // Built-in functions own length + name (and prototype if we've
        // ever read it). Other names fall through to .props.
        let ks = zjs_as_string(key);
        let kd = ks.data;
        let kn = ks.length;
        let m: int = 0;
        raw {
            m = ((kn == 6 && memcmp(kd, "length", 6) == 0)
              || (kn == 4 && memcmp(kd, "name",   4) == 0)) ? 1 : 0;
        }
        let hf = zjs_as_host_function(this_val);
        if m != 0 {
            // `delete fn.name` records the override as a deleted
            // sentinel on hf.props; honor it here so isConfigurable
            // sees the property go away.
            if hf.props != NULL {
                let s_ov = class_find_slot(hf.props.cls, ks);
                if s_ov >= 0 && zjs_is_deleted(hf.props.slots[(u32)s_ov]) != 0 {
                    return zjs_bool(0);
                }
            }
            return zjs_bool(1);
        }
        if hf.props != NULL {
            let slot = class_find_slot(hf.props.cls, ks);
            if slot >= 0 && zjs_is_deleted(hf.props.slots[(u32)slot]) == 0 { return zjs_bool(1); }
        }
        return zjs_bool(0);
    }
    // Plain function / closure: walk .props first so a deleted real
    // slot reports as absent (propertyHelper's isConfigurable depends
    // on `delete fn.name` flipping hasOwnProperty to false).
    if (zjs_is_function(this_val) != 0 || zjs_is_closure(this_val) != 0)
       && zjs_is_string(key) != 0 {
        let ks2 = zjs_as_string(key);
        let pf: ZjsObject* = NULL;
        if zjs_is_function(this_val) != 0 {
            let fp = zjs_cell_as_ptr(this_val);
            let ff: Function* = NULL;
            raw { ff = (Function*)fp; }
            pf = ff.props;
        } else {
            let cl = zjs_as_closure(this_val);
            let fp2 = cl.function;
            let ff2: Function* = NULL;
            raw { ff2 = (Function*)fp2; }
            pf = ff2.props;
        }
        if pf != NULL {
            let slot_pf = class_find_slot(pf.cls, ks2);
            if slot_pf >= 0 {
                // Slot exists (possibly deleted). If deleted, the
                // property is genuinely absent — fall through to the
                // synth-name short-circuit so a deleted "name"/"length"
                // also reads as absent.
                if zjs_is_deleted(pf.slots[(u32)slot_pf]) == 0 { return zjs_bool(1); }
                return zjs_bool(0);
            }
        }
        // Slot doesn't exist (or .props is NULL): fall back to the
        // synth-own check for the intrinsic names.
        let kd2 = ks2.data;
        let kn2 = ks2.length;
        let m2: int = 0;
        raw {
            m2 = ((kn2 == 6 && memcmp(kd2, "length", 6) == 0)
               || (kn2 == 4 && memcmp(kd2, "name",   4) == 0)
               || (kn2 == 9 && memcmp(kd2, "prototype", 9) == 0)) ? 1 : 0;
        }
        if m2 != 0 { return zjs_bool(1); }
        return zjs_bool(0);
    }
    return zjs_bool(0);
}

// Walk an object's own slots, masking off the given attribute bits.
// Used by freeze (clears WRITABLE | CONFIGURABLE) and seal (clears
// just CONFIGURABLE) so getOwnPropertyDescriptor reflects the
// post-operation attributes. Skips deleted slots and accessor slots'
// writable bit (accessors have no [[Writable]]; the spec leaves it
// absent — clearing it on the byte is a harmless no-op since lookups
// of accessor writable already special-case TAG_ACCESSOR).
fn object_clear_attr_bits(obj: ZjsObject*, mask: u8) -> void {
    if obj.attrs == NULL { return; }
    let c = obj.cls;
    let n = if c != NULL { c.prop_count } else { 0u32 };
    let i: u32 = 0;
    while i < n {
        let v = obj.slots[i];
        if zjs_is_deleted(v) == 0 {
            obj.attrs[i] = obj.attrs[i] & mask;
        }
        i = i + 1;
    }
}

// Predicate: every non-deleted own slot satisfies the bit pattern
// `(attrs & required_zero) == 0`. Used by isFrozen / isSealed —
// freeze requires both WRITABLE + CONFIGURABLE to be zero on all
// data slots; seal requires just CONFIGURABLE zero. Accessor slots
// don't have a [[Writable]] field per spec; we treat their byte's
// W-bit as "absent" so isFrozen returns true regardless.
fn object_all_slots_have_zero(obj: ZjsObject*, required_zero: u8) -> bool {
    if obj.attrs == NULL {
        // No attrs array means every slot is PROP_DEFAULT (W+E+C all
        // on). A nonzero requirement against an all-on byte fails.
        let c = obj.cls;
        let n = if c != NULL { c.prop_count } else { 0u32 };
        if n == 0 { return true; }
        return required_zero == 0;
    }
    let c = obj.cls;
    let n = if c != NULL { c.prop_count } else { 0u32 };
    let mask = required_zero;
    let i: u32 = 0;
    while i < n {
        let v = obj.slots[i];
        if zjs_is_deleted(v) == 0 {
            let a = obj.attrs[i];
            if zjs_is_accessor(v) != 0 {
                // Spec: accessor descriptors have no [[Writable]];
                // only CONFIGURABLE matters here. Mask off the W bit
                // before testing.
                let acc_mask = mask & ~PROP_WRITABLE;
                if (a & acc_mask) != 0 { return false; }
            } else {
                if (a & mask) != 0 { return false; }
            }
        }
        i = i + 1;
    }
    return true;
}

// Object.isExtensible — ES2015+: returns true for live extensible
// objects, false for objects with non_extensible set, false for any
// non-object input. ZjsContext is unused but kept for the host-fn
// shape.
fn host_object_is_extensible(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_bool(0); }
    let v = args[0];
    if zjs_is_object(v) != 0 {
        return zjs_bool(if zjs_as_object(v).non_extensible { 0 } else { 1 });
    }
    if zjs_is_array(v) != 0 {
        return zjs_bool(if zjs_as_array(v).non_extensible { 0 } else { 1 });
    }
    if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        // Function/Closure extensibility isn't tracked yet — see
        // future-work. Report "extensible" until the bag rewrite.
        return zjs_bool(1);
    }
    return zjs_bool(0);
}

fn host_object_is_frozen(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    // Spec: Object.isFrozen(non-object) returns true (no mutable
    // state to worry about).
    if argc == 0 { return zjs_bool(1); }
    let v = args[0];
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        if o.frozen { return zjs_bool(1); }
        if !o.non_extensible { return zjs_bool(0); }
        // Sealed but not flagged frozen: still frozen-equivalent if
        // every own data slot is non-writable AND non-configurable.
        let frozen_ok = object_all_slots_have_zero(o, PROP_WRITABLE | PROP_CONFIGURABLE);
        return zjs_bool(if frozen_ok { 1 } else { 0 });
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        if a.frozen { return zjs_bool(1); }
        if !a.non_extensible { return zjs_bool(0); }
        // Mirror: every named slot non-writable + non-configurable
        // AND length non-writable (we conflate length-writability
        // with array non-extensibility — sealing/freezing both lock
        // length, and `.length =` is rejected when non_extensible).
        // Element slots have no per-index attrs; freeze sets
        // a.frozen which the predicate above already matched.
        if a.props != NULL {
            let props_ok = object_all_slots_have_zero(a.props,
                                                      PROP_WRITABLE | PROP_CONFIGURABLE);
            if !props_ok { return zjs_bool(0); }
        }
        // No frozen-flag = element slots are writable, so the array
        // isn't frozen unless it has zero elements.
        return zjs_bool(if a.length == 0 { 1 } else { 0 });
    }
    if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        return zjs_bool(0);
    }
    return zjs_bool(1);
}

fn host_object_is_sealed(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_bool(1); }
    let v = args[0];
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        if o.frozen { return zjs_bool(1); }   // frozen ⇒ sealed
        if !o.non_extensible { return zjs_bool(0); }
        // Sealed = non_extensible + every own slot non-configurable
        // (writable is unconstrained — that's the seal/freeze split).
        let sealed_ok = object_all_slots_have_zero(o, PROP_CONFIGURABLE);
        return zjs_bool(if sealed_ok { 1 } else { 0 });
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        if a.frozen { return zjs_bool(1); }
        if !a.non_extensible { return zjs_bool(0); }
        if a.props != NULL {
            let props_sealed = object_all_slots_have_zero(a.props, PROP_CONFIGURABLE);
            if !props_sealed { return zjs_bool(0); }
        }
        return zjs_bool(1);
    }
    if zjs_is_function(v) != 0 || zjs_is_closure(v) != 0 || zjs_is_host_function(v) != 0 {
        return zjs_bool(0);
    }
    return zjs_bool(1);
}

// Object.preventExtensions — just flip the non_extensible bit. New
// property additions via property_set (object_set's add path,
// array_set's grow path) get rejected; existing writable slots
// remain mutable.
fn host_object_prevent_extensions(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    if zjs_is_object(v) != 0 { zjs_as_object(v).non_extensible = true; }
    else if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        a.non_extensible = true;
        if a.props != NULL { a.props.non_extensible = true; }
    }
    return v;
}

// Object.freeze — make every own slot non-writable + non-configurable
// and flip both `frozen` (fast-path bool for write checks) and
// `non_extensible` (blocks adds). Idempotent.
fn host_object_freeze(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        object_clear_attr_bits(o, ~(PROP_WRITABLE | PROP_CONFIGURABLE));
        o.frozen = true;
        o.non_extensible = true;
    } else if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        a.frozen = true;
        a.non_extensible = true;
        if a.props != NULL {
            object_clear_attr_bits(a.props, ~(PROP_WRITABLE | PROP_CONFIGURABLE));
            a.props.frozen = true;
            a.props.non_extensible = true;
        }
    }
    return v;
}

// Object.seal — like freeze but leaves [[Writable]] alone. Sets
// every own slot's CONFIGURABLE to false and flips non_extensible.
// Does NOT set the `frozen` bool — writes against existing writable
// slots still succeed.
fn host_object_seal(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    if argc == 0 { return zjs_undefined(); }
    let v = args[0];
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        object_clear_attr_bits(o, ~PROP_CONFIGURABLE);
        o.non_extensible = true;
    } else if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        a.non_extensible = true;
        if a.props != NULL {
            object_clear_attr_bits(a.props, ~PROP_CONFIGURABLE);
            a.props.non_extensible = true;
        }
    }
    return v;
}

// Object.prototype.valueOf() — returns the boxed receiver per spec.
// ToObject(this) would be more correct, but ctx.host_this is already
// the object form for non-primitive receivers; primitive receivers
// reach here only through wrappers, which the existing host_wrapper_*
// helpers handle directly.
fn host_object_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = ctx;
    let _u2 = args;
    let _u3 = argc;
    return ctx.host_this;
}

// Object.prototype.toString() — ECMA-262 §20.1.3.6. Discriminates
// built-in types by internal slot tag. Libraries lean on this for
// type checks (moment's isObject(), jquery's $.type(), lodash's
// isRegExp/isDate, etc.); returning a flat "[object Object]" for
// every non-array makes them mis-classify regexes and dates as
// plain objects and merge them as if they had own props.
fn host_object_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    let label: char* = (char*)"[object Object]";
    let label_len: u32 = 15;
    if zjs_is_undefined(this_val) != 0 { label = (char*)"[object Undefined]"; label_len = 18; }
    else if zjs_is_null(this_val) != 0 { label = (char*)"[object Null]";      label_len = 13; }
    else if zjs_is_array(this_val) != 0 { label = (char*)"[object Array]";    label_len = 14; }
    else if zjs_is_string(this_val) != 0 { label = (char*)"[object String]";  label_len = 15; }
    else if zjs_is_regexp(this_val) != 0 { label = (char*)"[object RegExp]";  label_len = 15; }
    else if zjs_is_date(this_val) != 0   { label = (char*)"[object Date]";    label_len = 13; }
    else if zjs_is_map(this_val) != 0    { label = (char*)"[object Map]";     label_len = 12; }
    else if zjs_is_set(this_val) != 0    { label = (char*)"[object Set]";     label_len = 12; }
    else if zjs_is_number(this_val) != 0 { label = (char*)"[object Number]";  label_len = 15; }
    else if zjs_is_bool(this_val) != 0   { label = (char*)"[object Boolean]"; label_len = 16; }
    else if zjs_is_function(this_val) != 0 || zjs_is_closure(this_val) != 0 || zjs_is_host_function(this_val) != 0 {
        label = (char*)"[object Function]"; label_len = 17;
    }
    else if zjs_is_object(this_val) != 0 {
        // Check for our internal tag (Math/JSON/Arguments) — gives
        // `[object Math]` etc. Look up own prop only; the tag is
        // never inherited so a fast own-slot check is enough.
        let o = zjs_as_object(this_val);
        let tag_atom = ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN);
        let s = class_find_slot(o.cls, tag_atom);
        if s >= 0 {
            let tv = o.slots[(u32)s];
            if zjs_is_string(tv) != 0 {
                let tag_str = zjs_as_string(tv);
                let prefix = (char*)"[object ";
                let prefix_len: u32 = 8;
                let suffix_len: u32 = 1;
                let total = prefix_len + tag_str.length + suffix_len;
                let buf = alloc_n<char>((usize)(total + 1));
                mem_copy<char>(buf, prefix, (usize)prefix_len);
                let tail: char* = NULL;
                raw { tail = &buf[prefix_len]; }
                mem_copy<char>(tail, tag_str.data, (usize)tag_str.length);
                buf[prefix_len + tag_str.length] = ']';
                buf[total] = (char)0;
                return ctx_intern_string_take(ctx, buf, total);
            }
        }
    }
    return ctx_intern_string(ctx, label, label_len);
}

// --- Array constructor + helpers (Phase 3.8c) ---------------------

// Resolve the .prototype slot of a constructor value (host function,
// user function, or closure). Lazily creates one if missing. Returns
// NULL only for non-constructable values. Used by built-in ctors to
// honor new.target when called via `class Sub extends Builtin {}`.
fn ctor_prototype_object(ctx: ZjsContext*, c: ZjsValue) -> ZjsObject* {
    if zjs_is_host_function(c) != 0 {
        let hf = zjs_as_host_function(c);
        return hf.prototype;
    }
    if zjs_is_function(c) != 0 {
        let fp = zjs_cell_as_ptr(c);
        let f: Function* = NULL; raw { f = (Function*)fp; }
        if f.prototype == NULL {
            let pv = ctx_new_object(ctx);
            f.prototype = zjs_as_object(pv);
            object_define_property_slot(ctx, f.prototype,
                ctx_intern_atom(ctx, (char*)"constructor", 11),
                c, PROP_WRITABLE | PROP_CONFIGURABLE);
        }
        return f.prototype;
    }
    if zjs_is_closure(c) != 0 {
        let cl = zjs_as_closure(c);
        let fp2 = cl.function;
        let f2: Function* = NULL; raw { f2 = (Function*)fp2; }
        if f2.prototype == NULL {
            let pv = ctx_new_object(ctx);
            f2.prototype = zjs_as_object(pv);
            object_define_property_slot(ctx, f2.prototype,
                ctx_intern_atom(ctx, (char*)"constructor", 11),
                c, PROP_WRITABLE | PROP_CONFIGURABLE);
        }
        return f2.prototype;
    }
    return NULL;
}

// If we're inside `new Sub(...)` where Sub extends a built-in, return
// Sub.prototype so the built-in cell's per-instance [[Prototype]] can
// be set. Returns NULL when not subclassing (plain `new Array()`).
fn subclass_proto_for(ctx: ZjsContext*, builtin_proto: ZjsObject*) -> ZjsObject* {
    if !ctx.new_target_active { return NULL; }
    let np = ctor_prototype_object(ctx, ctx.new_target_value);
    if np == NULL || np == builtin_proto { return NULL; }
    return np;
}

fn host_array_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let nt_proto = subclass_proto_for(ctx, ctx.array_proto);
    // Array() / new Array() → []
    if argc == 0 {
        let arr_v0 = ctx_new_array(ctx, 0);
        if nt_proto != NULL { zjs_as_array(arr_v0).proto = nt_proto; }
        return arr_v0;
    }
    // Array(N) where N is a non-negative integer → array of length N.
    if argc == 1 {
        let v = args[0];
        if zjs_is_int32(v) != 0 {
            let n = zjs_as_int32(v);
            if n < 0 {
                // ECMA-262: RangeError; MVP returns empty.
                let arr_e = ctx_new_array(ctx, 0);
                if nt_proto != NULL { zjs_as_array(arr_e).proto = nt_proto; }
                return arr_e;
            }
            let arr_v = ctx_new_array(ctx, (u32)n);
            let arr = zjs_as_array(arr_v);
            arr.length = (u32)n;
            if nt_proto != NULL { arr.proto = nt_proto; }
            return arr_v;
        }
        if zjs_is_double(v) != 0 {
            let d = zjs_as_double(v);
            let n2 = (i64)d;
            if (f64)n2 == d && n2 >= 0 {
                let arr_v = ctx_new_array(ctx, (u32)n2);
                let arr = zjs_as_array(arr_v);
                arr.length = (u32)n2;
                if nt_proto != NULL { arr.proto = nt_proto; }
                return arr_v;
            }
            let arr_e2 = ctx_new_array(ctx, 0);
            if nt_proto != NULL { zjs_as_array(arr_e2).proto = nt_proto; }
            return arr_e2;
        }
        // Single non-numeric arg → array containing that value.
        let arr_v = ctx_new_array(ctx, 1);
        let arr = zjs_as_array(arr_v);
        arr.elements[0] = v;
        arr.length = 1;
        if nt_proto != NULL { arr.proto = nt_proto; }
        return arr_v;
    }
    // Variadic — copy args into a fresh array.
    let arr_v = ctx_new_array(ctx, argc);
    let arr = zjs_as_array(arr_v);
    let i: u32 = 0;
    while i < argc {
        arr.elements[i] = args[i];
        i = i + 1;
    }
    arr.length = argc;
    if nt_proto != NULL { arr.proto = nt_proto; }
    return arr_v;
}

fn host_array_is_array(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    return zjs_bool(zjs_is_array(args[0]));
}

// --- Function.prototype.{call, apply} (Phase 3.8d) -----------------
//
// `f.call(thisArg, ...args)` and `f.apply(thisArg, argArray)` are
// dispatched as MethodInvoke on f. ctx.host_this at entry is `f`
// itself (the receiver of `.call`/`.apply`). We extract the caller-
// supplied `this` (args[0]) and dispatch the original `f` with it.

raw {
    extern ZjsValue zjs_call_value_with_this(ZjsContext* ctx, ZjsValue callee, ZjsValue this_val, ZjsValue* args, uint32_t argc);
}

fn host_function_call(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target = ctx.host_this;
    let new_this: ZjsValue = zjs_undefined();
    let new_args_ptr: ZjsValue* = NULL;
    let new_argc: u32 = 0;
    if argc >= 1 { new_this = args[0]; }
    if argc >= 2 {
        raw { new_args_ptr = &args[1]; }
        new_argc = argc - 1;
    }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, target, new_this, new_args_ptr, new_argc); }
    return r;
}

fn host_function_apply(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target = ctx.host_this;
    let new_this: ZjsValue = zjs_undefined();
    if argc >= 1 { new_this = args[0]; }
    // Second arg is an array (or null/undefined for no args).
    let new_argc: u32 = 0;
    let new_args_ptr: ZjsValue* = NULL;
    if argc >= 2 && zjs_is_array(args[1]) != 0 {
        let a = zjs_as_array(args[1]);
        new_argc = a.length;
        new_args_ptr = a.elements;
    }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, target, new_this, new_args_ptr, new_argc); }
    return r;
}

// --- Coercion-style constructors (Phase 3.8c) ----------------------
//
// MVP: `Boolean(x)` / `Number(x)` / `String(x)` perform the standard
// ToX coercion. `new Boolean(x)` etc. would normally create a wrapper
// object; we don't model wrapper objects and return the primitive
// instead — close enough for the conformance tests that call them.

// Hidden slot used by the wrapper-object form (`new Number(x)` etc.)
// to stash the primitive value behind a property name that user code
// won't bump into. Read by the prototype's valueOf / toString.
def WRAPPER_VALUE_KEY: char* = (char*)"__zjs_primitive__";
def WRAPPER_VALUE_KEY_LEN: u32 = 17;

// Hidden slot used by closure envs to chain to the enclosing
// function's env. Used by deeply-nested closures to walk past their
// immediate parent (Phase 3.9j).
def OUTER_ENV_KEY: char* = (char*)"__zjs_outer_env__";
def OUTER_ENV_KEY_LEN: u32 = 17;

// Internal class-name tag used by Object.prototype.toString to return
// `[object Math]` / `[object JSON]` / `[object Arguments]` for the
// few specific built-in objects that have a fixed toString tag in the
// spec but aren't a distinct cell type in our taxonomy. Symbol-keyed
// `Symbol.toStringTag` will replace this once we have Symbols.
def TAG_NAME_KEY: char* = (char*)"__zjs_tag__";
def TAG_NAME_KEY_LEN: u32 = 11;

// ECMA-262 §7.1.18 ToObject. Wraps primitives in their corresponding
// wrapper objects (so `Array.prototype.X.call(true, ...)` sees an
// object). For null/undefined, arms a JS-visible TypeError via
// pending_throw_active and returns undefined — callers must check
// pending_throw_active (or simply propagate the undefined and let
// the interpreter's post-host-call epilogue unwind).
//
// Already-object values (object/array/function/closure/host-function)
// pass through unchanged.
fn ctx_to_object(ctx: ZjsContext*, v: ZjsValue) -> ZjsValue {
    if zjs_is_object(v) != 0 { return v; }
    if zjs_is_array(v) != 0 { return v; }
    if zjs_is_function(v) != 0 { return v; }
    if zjs_is_closure(v) != 0 { return v; }
    if zjs_is_host_function(v) != 0 { return v; }
    if zjs_is_regexp(v) != 0 { return v; }
    if zjs_is_promise(v) != 0 { return v; }
    // Host instance types — already "objects" per spec; the
    // generic-Array-method tests rely on `Array.prototype.map.call(
    // someDate, cb)` walking the date as ToObject(date), which is
    // just the date itself.
    if zjs_is_date(v) != 0 { return v; }
    if zjs_is_map(v) != 0 { return v; }
    if zjs_is_set(v) != 0 { return v; }
    if zjs_is_symbol(v) != 0 { return v; }

    if zjs_is_null(v) != 0 || zjs_is_undefined(v) != 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Cannot convert null or undefined to object", 43);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }

    // Primitive — wrap it. Pick the right prototype based on tag.
    let proto: ZjsObject* = NULL;
    if zjs_is_bool(v) != 0 {
        // Boolean.prototype via the Boolean host function's .prototype.
        let bool_g = ctx_find_global(ctx, (char*)"Boolean", 7);
        if bool_g >= 0 {
            let bv = ctx.globals[bool_g].value;
            if zjs_is_host_function(bv) != 0 {
                proto = zjs_as_host_function(bv).prototype;
            }
        }
    } else if zjs_is_int32(v) != 0 || zjs_is_double(v) != 0 {
        let num_g = ctx_find_global(ctx, (char*)"Number", 6);
        if num_g >= 0 {
            let nv = ctx.globals[num_g].value;
            if zjs_is_host_function(nv) != 0 {
                proto = zjs_as_host_function(nv).prototype;
            }
        }
    } else if zjs_is_string(v) != 0 {
        proto = ctx.string_proto;
    }

    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    obj.proto = proto;
    let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
    object_set(ctx, obj, key, v);
    return obj_v;
}

fn wrap_primitive_if_new(ctx: ZjsContext*, primitive: ZjsValue) -> ZjsValue {
    // If invoked via `new`, NewInvoke set ctx.host_this to a fresh
    // object with proto = ctor.prototype. Attach the primitive as a
    // hidden own property and return the wrapper. Otherwise return
    // the primitive directly (plain call).
    if zjs_is_object(ctx.host_this) != 0 {
        let obj = zjs_as_object(ctx.host_this);
        let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        object_set(ctx, obj, key, primitive);
        return ctx.host_this;
    }
    return primitive;
}

fn host_boolean(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc == 0 { zjs_bool(0) } else { zjs_bool(zjs_to_bool_coerce(args[0])) };
    return wrap_primitive_if_new(ctx, v);
}

fn host_number(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let n: ZjsValue = zjs_int32(0);
    if argc > 0 {
        // Number(bigint) is allowed (explicit) and returns the rounded
        // double — unlike implicit ToNumber(bigint), which throws.
        if zjs_is_bigint(args[0]) != 0 {
            let d0 = bigint_to_f64(zjs_as_bigint(args[0]));
            let as_i = (i32)d0;
            if (f64)as_i == d0 { n = zjs_int32(as_i); } else { n = zjs_double(d0); }
            return wrap_primitive_if_new(ctx, n);
        }
        let d = zjs_to_double(args[0]);
        let as_int = (i32)d;
        if (f64)as_int == d { n = zjs_int32(as_int); }
        else { n = zjs_double(d); }
    }
    return wrap_primitive_if_new(ctx, n);
}

// Arm a "Cannot mix BigInt and other types" TypeError on ctx.
fn raise_bigint_mix(ctx: ZjsContext*) -> void {
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
        (char*)"Cannot mix BigInt and other types, use explicit conversions", 59);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value  = err;
}

// BigInt binary-op interception for the arithmetic opcodes.
// kind: 0=add 1=sub 2=mul 3=div 4=mod 5=pow.
// Sets handled[0]=false and returns undefined when neither operand is a
// BigInt (caller proceeds with the Number path). When at least one is a
// BigInt, handled[0]=true; if exactly one is a BigInt it arms a mixing
// TypeError; if both are BigInts it computes the result (arming a
// RangeError on /0, %0, or a negative `**` exponent). On any armed
// throw the return value is undefined and the caller surfaces it.
fn bigint_try_binop(ctx: ZjsContext*, kind: u32, a: ZjsValue, b: ZjsValue, handled: bool*) -> ZjsValue {
    let ab = zjs_is_bigint(a) != 0;
    let bb = zjs_is_bigint(b) != 0;
    if !ab && !bb { handled[0] = false; return zjs_undefined(); }
    handled[0] = true;
    if !ab || !bb { raise_bigint_mix(ctx); return zjs_undefined(); }
    let x = zjs_as_bigint(a);
    let y = zjs_as_bigint(b);
    let r: ZjsBigInt* = NULL;
    if kind == 0 { r = bigint_add(x, y); }
    else if kind == 1 { r = bigint_sub(x, y); }
    else if kind == 2 { r = bigint_mul(x, y); }
    else if kind == 3 {
        if bigint_is_zero(y) {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                (char*)"Division by zero", 16);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        r = bigint_div(x, y);
    }
    else if kind == 4 {
        if bigint_is_zero(y) {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                (char*)"Division by zero", 16);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        r = bigint_mod(x, y);
    }
    else if kind == 5 {
        if y.sign < 0 {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                (char*)"Exponent must be non-negative", 29);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        if !bigint_fits_u64(y) {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                (char*)"Maximum BigInt size exceeded", 28);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        r = bigint_pow_u64(x, bigint_to_u64(y));
    }
    if r == NULL { r = zjs_bigint_new_cap(0); }
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

// Unary negation of a BigInt (the Op::Neg path). Returns a fresh,
// registered cell.
fn bigint_neg_ctx(ctx: ZjsContext*, a: ZjsValue) -> ZjsValue {
    let r = bigint_neg(zjs_as_bigint(a));
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

// Unary `~` on a BigInt (the Op::BitNot path).
fn bigint_not_ctx(ctx: ZjsContext*, a: ZjsValue) -> ZjsValue {
    let r = bigint_not(zjs_as_bigint(a));
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

// BigInt bitwise AND/OR/XOR interception. kind: 0=and 1=or 2=xor.
// Same handled[]/mixing-TypeError contract as bigint_try_binop.
fn bigint_try_bitop(ctx: ZjsContext*, kind: u32, a: ZjsValue, b: ZjsValue, handled: bool*) -> ZjsValue {
    let ab = zjs_is_bigint(a) != 0;
    let bb = zjs_is_bigint(b) != 0;
    if !ab && !bb { handled[0] = false; return zjs_undefined(); }
    handled[0] = true;
    if !ab || !bb { raise_bigint_mix(ctx); return zjs_undefined(); }
    let r = bigint_bitop(zjs_as_bigint(a), zjs_as_bigint(b), kind);
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

// BigInt shift interception. is_left = true for `<<`, false for `>>`.
// A negative shift count flips the direction. Huge left shifts →
// RangeError; huge right shifts saturate to 0n / -1n.
fn bigint_try_shift(ctx: ZjsContext*, is_left: bool, a: ZjsValue, b: ZjsValue, handled: bool*) -> ZjsValue {
    let ab = zjs_is_bigint(a) != 0;
    let bb = zjs_is_bigint(b) != 0;
    if !ab && !bb { handled[0] = false; return zjs_undefined(); }
    handled[0] = true;
    if !ab || !bb { raise_bigint_mix(ctx); return zjs_undefined(); }
    let x = zjs_as_bigint(a);
    let y = zjs_as_bigint(b);
    let left = is_left;
    if y.sign < 0 { left = !left; }
    let r: ZjsBigInt* = NULL;
    if !bigint_fits_u64(y) {
        if left {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                (char*)"Maximum BigInt size exceeded", 28);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        r = if x.sign < 0 { zjs_bigint_from_i64(-1) } else { zjs_bigint_new_cap(0) };
    } else {
        let n = bigint_to_u64(y);
        if n > 134217728 {     // 128M-bit guard — beyond this, OOM territory
            if left {
                let err = build_typed_error(ctx, (char*)"RangeError", 10,
                    (char*)"Maximum BigInt size exceeded", 28);
                ctx.pending_throw_active = true; ctx.pending_throw_value = err;
                return zjs_undefined();
            }
            r = if x.sign < 0 { zjs_bigint_from_i64(-1) } else { zjs_bigint_new_cap(0) };
        } else if left {
            r = bigint_shl(x, n);
        } else {
            r = bigint_shr(x, n);
        }
    }
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

// BigInt.asIntN(bits, bigint) / asUintN(bits, bigint). `bits` is a
// regular Number index (ToIndex); the value must be a BigInt.
fn host_bigint_as_n(ctx: ZjsContext*, args: ZjsValue*, argc: u32, signed_form: bool) -> ZjsValue {
    let bits_v = if argc >= 1 { args[0] } else { zjs_undefined() };
    let val_v  = if argc >= 2 { args[1] } else { zjs_undefined() };
    let bd = zjs_to_double(bits_v);
    let bad: int = 0;
    raw { bad = (!isfinite(bd) || bd < 0 || bd != trunc(bd)) ? 1 : 0; }
    if bad != 0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
            (char*)"Invalid bits argument", 21);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    if zjs_is_bigint(val_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
            (char*)"Cannot convert value to a BigInt", 32);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let bits: u64 = (u64)bd;
    let x = zjs_as_bigint(val_v);
    let r = if signed_form { bigint_asintn(bits, x) } else { bigint_asuintn(bits, x) };
    ctx_register_cell(ctx, (void*)r);
    return zjs_cell_from_ptr((void*)r);
}

fn host_bigint_as_int_n(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_bigint_as_n(ctx, args, argc, true);
}
fn host_bigint_as_uint_n(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_bigint_as_n(ctx, args, argc, false);
}

// BigInt.prototype.toString([radix]) — radix 2..36, default 10.
fn host_bigint_proto_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_bigint(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
            (char*)"BigInt.prototype.toString requires a BigInt receiver", 52);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let radix: u32 = 10;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        let rd = zjs_to_double(args[0]);
        let bad: int = 0;
        raw { bad = (!isfinite(rd) || rd < 2 || rd > 36 || rd != trunc(rd)) ? 1 : 0; }
        if bad != 0 {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                (char*)"toString() radix must be between 2 and 36", 41);
            ctx.pending_throw_active = true; ctx.pending_throw_value = err;
            return zjs_undefined();
        }
        radix = (u32)rd;
    }
    let blen: u32 = 0;
    let bs = bigint_to_radix_cstring(zjs_as_bigint(this_v), radix, &blen);
    return ctx_intern_string_take(ctx, bs, blen);
}

// BigInt.prototype.valueOf() — returns the primitive BigInt receiver.
fn host_bigint_proto_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let this_v = ctx.host_this;
    if zjs_is_bigint(this_v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
            (char*)"BigInt.prototype.valueOf requires a BigInt receiver", 51);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return this_v;
}

// BigInt(value) — ECMA-262 §21.2.1.1. NOT a constructor (`new BigInt()`
// throws, but we don't distinguish call/construct on host fns yet).
// Implements ToBigInt over primitives: bigint→itself, boolean→0n/1n,
// number→NumberToBigInt (RangeError if non-integral), string→
// StringToBigInt (SyntaxError if malformed). undefined/null/symbol
// throw TypeError. Object args (ToPrimitive) are a TODO.
fn host_bigint_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_bigint(v) != 0 { return v; }
    if zjs_is_bool(v) != 0 {
        let b = zjs_bigint_from_i64(if zjs_as_bool(v) != 0 { 1 } else { 0 });
        ctx_register_cell(ctx, (void*)b);
        return zjs_cell_from_ptr((void*)b);
    }
    if zjs_is_number(v) != 0 {
        let d = zjs_to_double(v);
        let bad: int = 0;
        raw { bad = (!isfinite(d) || d != trunc(d)) ? 1 : 0; }
        if bad != 0 {
            let err = build_typed_error(ctx, (char*)"RangeError", 10,
                (char*)"The number is not a safe integer", 32);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = err;
            return zjs_undefined();
        }
        let b = zjs_bigint_from_f64(d);
        ctx_register_cell(ctx, (void*)b);
        return zjs_cell_from_ptr((void*)b);
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let ok: int = 1;
        let b = zjs_bigint_from_string(s.data, s.length, &ok);
        if ok == 0 {
            let err = build_typed_error(ctx, (char*)"SyntaxError", 11,
                (char*)"Cannot convert string to a BigInt", 33);
            ctx.pending_throw_active = true;
            ctx.pending_throw_value  = err;
            return zjs_undefined();
        }
        ctx_register_cell(ctx, (void*)b);
        return zjs_cell_from_ptr((void*)b);
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
        (char*)"Cannot convert value to a BigInt", 32);
    ctx.pending_throw_active = true;
    ctx.pending_throw_value  = err;
    return zjs_undefined();
}

fn host_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // ECMA-262 §22.1.1.1 String(value): the call form short-circuits
    // Symbol via SymbolDescriptiveString rather than the generic
    // ToString (which throws on Symbol). The `new String(symbol)`
    // construct path STILL throws — but we don't currently distinguish
    // call vs construct on host fns, and the common case the tests
    // care about is the call form.
    let s: ZjsValue;
    if argc == 0 {
        s = ctx_intern_string(ctx, (char*)"", 0);
    } else if zjs_is_symbol(args[0]) != 0 {
        let sym = zjs_as_symbol(args[0]);
        let desc_d: char* = NULL;
        let desc_n: u32 = 0;
        if sym.description != NULL {
            desc_d = sym.description.data;
            desc_n = sym.description.length;
        }
        let buf = alloc_n<char>((usize)(desc_n + 9));
        buf[0] = 'S'; buf[1] = 'y'; buf[2] = 'm'; buf[3] = 'b';
        buf[4] = 'o'; buf[5] = 'l'; buf[6] = '(';
        let i: u32 = 0;
        while i < desc_n { buf[7 + i] = desc_d[i]; i = i + 1; }
        buf[7 + desc_n] = ')'; buf[8 + desc_n] = (char)0;
        s = ctx_intern_string_take(ctx, buf, desc_n + 8);
    } else {
        s = zjs_to_string(ctx, args[0]);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    return wrap_primitive_if_new(ctx, s);
}

// Prototype methods that unwrap the boxed primitive. Read host_this's
// hidden slot if it's a wrapper object; otherwise return host_this as-is
// (so e.g. `(123).valueOf()` would also work once we auto-box later).
fn host_wrapper_value_of(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_val = ctx.host_this;
    if zjs_is_object(this_val) != 0 {
        let o = zjs_as_object(this_val);
        let key = ctx_intern_atom(ctx, WRAPPER_VALUE_KEY, WRAPPER_VALUE_KEY_LEN);
        let v = object_get(o, key);
        if zjs_is_undefined(v) == 0 { return v; }
    }
    return this_val;
}

fn host_wrapper_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = host_wrapper_value_of(ctx, args, argc);
    if zjs_is_string(v) != 0 { return v; }
    return zjs_to_string(ctx, v);
}

// Number.prototype.toString(radix) — handles radixes 2..36. Radix
// 10 (or omitted) delegates to the standard NumberToString path so
// shortest-roundtrip / scientific formatting carries through.
fn host_number_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = host_wrapper_value_of(ctx, args, argc);
    let radix: i32 = 10;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        radix = (i32)zjs_to_double(args[0]);
    }
    if radix < 2 || radix > 36 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"toString() radix must be 2..36", 30);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    if radix == 10 {
        if zjs_is_string(v) != 0 { return v; }
        return zjs_to_string(ctx, v);
    }

    let d = zjs_to_double(v);
    let is_nan: int = 0;
    let is_inf: int = 0;
    raw {
        is_nan = isnan(d) ? 1 : 0;
        is_inf = isinf(d) ? 1 : 0;
    }
    if is_nan != 0 { return ctx_intern_string(ctx, (char*)"NaN", 3); }
    if is_inf != 0 {
        if d < 0.0 { return ctx_intern_string(ctx, (char*)"-Infinity", 9); }
        return ctx_intern_string(ctx, (char*)"Infinity", 8);
    }

    let negative: int = 0;
    let abs_d: f64 = d;
    if d < 0.0 { negative = 1; abs_d = -d; }

    // Split into integer + fractional parts.
    let int_part: f64 = 0.0;
    let frac_part: f64 = 0.0;
    raw { int_part = floor(abs_d); frac_part = abs_d - int_part; }

    let buf: char[256];
    let pos: u32 = 0;
    if negative != 0 { buf[pos] = (char)'-'; pos = pos + 1; }

    // Integer digits, produced LSB-first into a scratch buffer then
    // reversed into `buf`.
    let digits: char[80];
    let digit_count: u32 = 0;
    if int_part == 0.0 {
        digits[0] = (char)'0';
        digit_count = 1;
    } else {
        let n = int_part;
        while n >= 1.0 && digit_count < 80 {
            let rem: i32 = 0;
            raw {
                double r_d = (double)radix;
                double q = floor(n / r_d);
                rem = (int32_t)(n - q * r_d);
                n = q;
            }
            let c: char = (char)0;
            raw {
                c = (rem < 10) ? (char)('0' + rem) : (char)('a' + rem - 10);
            }
            digits[digit_count] = c;
            digit_count = digit_count + 1;
        }
    }
    let ri: u32 = digit_count;
    while ri > 0 {
        ri = ri - 1;
        buf[pos] = digits[ri];
        pos = pos + 1;
    }

    // Fractional part — emit up to 20 digits or until the residue
    // hits zero. Same precision cap V8 / SpiderMonkey use.
    if frac_part > 0.0 {
        buf[pos] = (char)'.';
        pos = pos + 1;
        let i: u32 = 0;
        let f = frac_part;
        while i < 20 && f > 0.0 && pos < 250 {
            let digit: i32 = 0;
            raw {
                f = f * (double)radix;
                digit = (int32_t)floor(f);
                f = f - (double)digit;
            }
            let c: char = (char)0;
            raw {
                c = (digit < 10) ? (char)('0' + digit) : (char)('a' + digit - 10);
            }
            buf[pos] = c;
            pos = pos + 1;
            i = i + 1;
        }
    }

    buf[pos] = (char)0;
    let buf_p: char* = NULL;
    raw { buf_p = &buf[0]; }
    return ctx_intern_string(ctx, buf_p, pos);
}

// Number.prototype.toFixed(digits) — render `this` as a decimal
// string with `digits` digits after the decimal point. Spec range
// for digits is 0..100; out-of-range throws RangeError. NaN renders
// as "NaN"; Infinity as "Infinity" / "-Infinity".
fn host_number_to_fixed(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = host_wrapper_value_of(ctx, args, argc);
    let d = zjs_to_double(v);
    let digits: i32 = 0;
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 {
        let dd = zjs_to_double(args[0]);
        raw { if (isnan(dd)) dd = 0; }
        digits = (i32)dd;
    }
    if digits < 0 || digits > 100 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
                                    (char*)"toFixed() digits argument must be between 0 and 100", 52);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let is_nan: int = 0;
    raw { is_nan = isnan(d) ? 1 : 0; }
    if is_nan != 0 { return ctx_intern_string(ctx, (char*)"NaN", 3); }
    let is_inf: int = 0;
    raw { is_inf = isinf(d) ? 1 : 0; }
    if is_inf != 0 {
        if d > 0.0 { return ctx_intern_string(ctx, (char*)"Infinity", 8); }
        return ctx_intern_string(ctx, (char*)"-Infinity", 9);
    }
    let buf: char[140];
    let n: u32 = 0;
    raw {
        n = (uint32_t)snprintf(buf, 140, "%.*f", (int)digits, d);
    }
    let bp: char* = NULL;
    raw { bp = &buf[0]; }
    return ctx_intern_string(ctx, bp, n);
}

// Array.prototype.fill(value, start?, end?) — overwrite [start, end)
// with `value` in place. Negative indices count from length; out-of-
// range get clamped. Returns the array.
fn host_array_fill(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if !require_array_coercible_this(ctx) { return zjs_undefined(); }
    let this_val = ctx.host_this;
    let value = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_array(this_val) != 0 {
        let arr = zjs_as_array(this_val);
        let len = arr.length;
        let start: i64 = 0;
        let end:   i64 = (i64)len;
        if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
            let sd = zjs_to_double(args[1]);
            raw { if (isnan(sd)) sd = 0; sd = (sd < 0) ? (sd + (double)len) : sd; }
            start = (i64)sd;
            if start < 0 { start = 0; }
            if start > (i64)len { start = (i64)len; }
        }
        if argc >= 3 && zjs_is_undefined(args[2]) == 0 {
            let ed = zjs_to_double(args[2]);
            raw { if (isnan(ed)) ed = 0; ed = (ed < 0) ? (ed + (double)len) : ed; }
            end = (i64)ed;
            if end < 0 { end = 0; }
            if end > (i64)len { end = (i64)len; }
        }
        let i: i64 = start;
        while i < end {
            array_set(arr, (u32)i, value);
            i = i + 1;
        }
        return this_val;
    }
    // Generic array-like — operate via property_set against length.
    if zjs_is_object(this_val) == 0 {
        this_val = ctx_to_object(ctx, this_val);
        if ctx.pending_throw_active { return zjs_undefined(); }
    }
    let len = read_length_u32(ctx, this_val);
    let start: i64 = 0;
    let end:   i64 = (i64)len;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let sd = zjs_to_double(args[1]);
        raw { if (isnan(sd)) sd = 0; sd = (sd < 0) ? (sd + (double)len) : sd; }
        start = (i64)sd;
        if start < 0 { start = 0; }
        if start > (i64)len { start = (i64)len; }
    }
    if argc >= 3 && zjs_is_undefined(args[2]) == 0 {
        let ed = zjs_to_double(args[2]);
        raw { if (isnan(ed)) ed = 0; ed = (ed < 0) ? (ed + (double)len) : ed; }
        end = (i64)ed;
        if end < 0 { end = 0; }
        if end > (i64)len { end = (i64)len; }
    }
    let i: i64 = start;
    while i < end {
        property_set(ctx, this_val, zjs_int32((i32)i), value);
        if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    return this_val;
}

// String.raw(strings, ...subs) — tagged-template helper that joins
// strings.raw entries with the substitutions verbatim. Spec §22.1.2.4.
fn host_string_raw(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"String.raw requires a template object", 37);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let strings = args[0];
    let raw_key = ctx_intern_atom(ctx, (char*)"raw", 3);
    let raw_v = property_get(ctx, strings, zjs_cell_from_ptr((void*)raw_key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    // raw must be array-like; we read its length and indexed slots.
    let len_key = ctx_intern_atom(ctx, (char*)"length", 6);
    let len_v = property_get(ctx, raw_v, zjs_cell_from_ptr((void*)len_key));
    if ctx.pending_throw_active { return zjs_undefined(); }
    let len_d = zjs_to_double(len_v);
    let is_nan: int = 0; raw { is_nan = isnan(len_d) ? 1 : 0; }
    if is_nan != 0 || len_d <= 0.0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let len: u32 = (u32)len_d;

    // Build the result by concatenating: raw[0] + sub[0] + raw[1] + ...
    // For each segment we do a string_concat. argc-1 subs are
    // available (args[1..argc)); spec wraps trailing missing ones as
    // empty string.
    let result = property_get(ctx, raw_v, zjs_int32(0));
    if ctx.pending_throw_active { return zjs_undefined(); }
    if zjs_is_string(result) == 0 { result = zjs_to_string(ctx, result); }
    if ctx.pending_throw_active { return zjs_undefined(); }
    let i: u32 = 1;
    while i < len {
        // Substitution at position i-1 in args[1..].
        let sub: ZjsValue = if i < argc { args[i] } else { ctx_intern_string(ctx, (char*)"", 0) };
        if zjs_is_string(sub) == 0 {
            sub = zjs_to_string(ctx, sub);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        result = zjs_string_concat(ctx, result, sub);
        if ctx.pending_throw_active { return zjs_undefined(); }
        let next = property_get(ctx, raw_v, zjs_int32((i32)i));
        if ctx.pending_throw_active { return zjs_undefined(); }
        if zjs_is_string(next) == 0 {
            next = zjs_to_string(ctx, next);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        result = zjs_string_concat(ctx, result, next);
        if ctx.pending_throw_active { return zjs_undefined(); }
        i = i + 1;
    }
    return result;
}

// String.fromCharCode(...codes) — build a string from numeric char codes.
// MVP: ASCII only, takes each arg's truncated u8.
fn host_string_from_char_code(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return ctx_intern_string(ctx, (char*)"", 0); }
    let n = argc;
    let buf = alloc_n<char>((usize)(n + 1));
    let i: u32 = 0;
    while i < argc {
        let cu = (u8)((u32)zjs_to_double(args[i]) & 255);
        buf[i] = (char)cu;
        i = i + 1;
    }
    buf[n] = (char)0;
    return ctx_intern_string_take(ctx, buf, argc);
}

// --- Error subtypes (Phase 3.8c) ----------------------------------
//
// ReferenceError / TypeError / RangeError — each builds an object
// shaped like Error but with a different `.name`. Used both as
// constructors in tests and as the second arg to `assert.throws`.

fn make_named_error(ctx: ZjsContext*, name: char*, name_len: u32, args: ZjsValue*, argc: u32) -> ZjsValue {
    // When invoked via `new Foo(...)`, NewInvoke has already allocated
    // a fresh object with `proto = Foo.prototype` and bound it as
    // ctx.host_this. Decorating that object preserves the proto link
    // so `instanceof Foo` works.
    //
    // When called as a plain function (`Error(...)` / `TypeError(...)`),
    // ECMA-262 still requires the result to be a proper Error subclass
    // instance. Look up the constructor by name and seed obj.proto so
    // `err instanceof TypeError` works for the non-new form too.
    let obj_v: ZjsValue = ctx.host_this;
    if zjs_is_object(obj_v) == 0 {
        obj_v = ctx_new_object(ctx);
        let ctor_slot = ctx_find_global(ctx, name, name_len);
        if ctor_slot >= 0 {
            let ctor_v = ctx.globals[ctor_slot].value;
            if zjs_is_host_function(ctor_v) != 0 {
                let hf = zjs_as_host_function(ctor_v);
                if hf.prototype != NULL {
                    zjs_as_object(obj_v).proto = hf.prototype;
                }
            }
        }
    }
    // Defensive rooting: obj_v is either ctx.host_this (already rooted)
    // or a fresh object held across several cell-allocating calls
    // below. Pushing in both cases is safe and one-liner — host_this is
    // already on the temp_roots path conceptually.
    ctx_push_temp_root(ctx, obj_v);
    defer ctx_pop_temp_root(ctx);
    let obj = zjs_as_object(obj_v);
    // Spec: only set `message` when explicitly provided. An omitted
    // message stays inherited (Error.prototype.message = "" by spec,
    // which our toString defaults sensibly).
    if argc > 0 && zjs_is_undefined(args[0]) == 0 {
        let msg = if zjs_is_string(args[0]) != 0 { args[0] } else { zjs_to_string(ctx, args[0]) };
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"message", 7), msg);
    }
    let name_str = ctx_intern_atom(ctx, name, name_len);
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"name", 4),
               zjs_cell_from_ptr((void*)name_str));
    return obj_v;
}

fn host_reference_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"ReferenceError", 14, args, argc);
}
fn host_type_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"TypeError", 9, args, argc);
}
fn host_range_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"RangeError", 10, args, argc);
}
fn host_syntax_error_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"SyntaxError", 11, args, argc);
}

// ECMA-262 AggregateError(errors, message). `errors` is an iterable;
// the constructed instance has an .errors array of those values.
// Returned instance also gets .name = "AggregateError" and .message
// (if message arg was provided). Used directly by Promise.any when
// every input rejects.
// Build an AggregateError instance directly (no JS call). Used by
// Promise.any when every input rejects — we want the resulting error
// to satisfy `e instanceof AggregateError`, which requires walking
// the prototype chain to AggregateError.prototype. The plain
// build_typed_error path produces a name-tagged Error without the
// right [[Prototype]].
fn build_aggregate_error(ctx: ZjsContext*, errors_v: ZjsValue, msg: char*, msg_len: u32) -> ZjsValue {
    let slot = ctx_find_global(ctx, (char*)"AggregateError", 14);
    if slot < 0 {
        // AggregateError not registered yet (bootstrap edge case);
        // fall back to the plain typed error so we at least surface
        // the rejection with a sensible name.
        let agg = build_typed_error(ctx, (char*)"AggregateError", 14, msg, msg_len);
        if zjs_is_object(agg) != 0 {
            object_set(ctx, zjs_as_object(agg), ctx_intern_atom(ctx, (char*)"errors", 6), errors_v);
        }
        return agg;
    }
    let agg_ctor = ctx.globals[slot].value;
    let obj_v = ctx_new_object(ctx);
    let obj = zjs_as_object(obj_v);
    if zjs_is_host_function(agg_ctor) != 0 {
        let hf = zjs_as_host_function(agg_ctor);
        if hf.prototype != NULL { obj.proto = hf.prototype; }
    }
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"name", 4),
               ctx_intern_string(ctx, (char*)"AggregateError", 14));
    if msg != NULL && msg_len > 0 {
        object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"message", 7),
                   ctx_intern_string(ctx, msg, msg_len));
    }
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"errors", 6), errors_v);
    return obj_v;
}

// Function.prototype.bind(thisArg, ...prependArgs).
//
// Returns a fresh host function whose .bound is an object of shape
//   { target, this, prepend }
// where `prepend` is an array of the bind-time partial-application
// arguments. Invoking the bound function calls the original via
// zjs_call_value_with_this with the bound this and prepend-args
// merged in front of the call-time args.
//
// Works uniformly for user fns, closures, and other host fns —
// `target` is just stored as a ZjsValue and dispatched through
// zjs_call_value_with_this.

def BOUND_TARGET_KEY: char* = (char*)"__zjs_bound_target__";
def BOUND_THIS_KEY:   char* = (char*)"__zjs_bound_this__";
def BOUND_PREPEND_KEY: char* = (char*)"__zjs_bound_prepend__";

fn host_function_bound_trampoline(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let hf: ZjsHostFunction* = NULL;
    raw { hf = (ZjsHostFunction*)ctx->current_host_fn; }
    if hf == NULL { return zjs_undefined(); }
    let state = hf.bound;
    if zjs_is_object(state) == 0 { return zjs_undefined(); }
    let so = zjs_as_object(state);
    let target  = object_get(so, ctx_intern_atom(ctx, BOUND_TARGET_KEY,  20));
    let this_v  = object_get(so, ctx_intern_atom(ctx, BOUND_THIS_KEY,   18));
    let prepend = object_get(so, ctx_intern_atom(ctx, BOUND_PREPEND_KEY, 21));
    let prepend_n: u32 = 0;
    if zjs_is_array(prepend) != 0 { prepend_n = zjs_as_array(prepend).length; }
    let total: u32 = prepend_n + argc;
    // Stack-buffer for small arg counts; fall back to alloc for many.
    let merged: ZjsValue[16];
    let mp: ZjsValue* = NULL;
    let owned: bool = false;
    if total <= 16 {
        raw { mp = &merged[0]; }
    } else {
        mp = alloc_n<ZjsValue>((usize)total);
        owned = true;
    }
    let i: u32 = 0;
    if prepend_n > 0 {
        let pa = zjs_as_array(prepend);
        while i < prepend_n { mp[i] = pa.elements[i]; i = i + 1; }
    }
    let j: u32 = 0;
    while j < argc { mp[prepend_n + j] = args[j]; j = j + 1; }
    let r: ZjsValue = zjs_undefined();
    raw { r = zjs_call_value_with_this(ctx, target, this_v, mp, total); }
    if owned { dealloc(mp); }
    return r;
}

// Function.prototype.toString — ECMA-262 §22.2.5.13. Returns
// "function NAME() { [native code] }" for built-ins and a same-shape
// "function NAME() { [user code] }" for user fns / closures (we don't
// retain source text). The exact body wording isn't pinned by the
// spec but a chunk of npm — lodash, underscore, debug, mocha,
// runtime-detection libraries — regex-tests the result against the
// native pattern to decide whether a probed value is a real binding.
// Returning "[object Function]" caused widespread misclassification
// (#292). This is the named method wired onto Function.prototype;
// zjs_to_string's general ToString path mirrors it.
fn host_function_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = ctx.host_this;
    let is_callable: bool =
           zjs_is_host_function(v) != 0
        || zjs_is_function(v) != 0
        || zjs_is_closure(v) != 0;
    if !is_callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Function.prototype.toString called on non-function", 51);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value  = err;
        return zjs_undefined();
    }
    let nm: char* = NULL;
    let nm_len: u32 = 0;
    let body: char* = (char*)"[native code]";
    let body_len: u32 = 13;
    if zjs_is_host_function(v) != 0 {
        let hf = zjs_as_host_function(v);
        if hf.name != NULL {
            nm = hf.name;
            raw { nm_len = (uint32_t)strlen(nm); }
        }
    } else if zjs_is_function(v) != 0 {
        let fp = zjs_cell_as_ptr(v);
        let f: Function* = NULL;
        raw { f = (Function*)fp; }
        body = (char*)"[user code]";
        body_len = 11;
        if f.props != NULL {
            let nm_atom = ctx_intern_atom(ctx, (char*)"name", 4);
            let slot = class_find_slot(f.props.cls, nm_atom);
            if slot >= 0 {
                let nv: ZjsValue = f.props.slots[(u32)slot];
                if zjs_is_string(nv) != 0 {
                    let ns = zjs_as_string(nv);
                    nm = ns.data; nm_len = ns.length;
                }
            }
        }
    } else if zjs_is_closure(v) != 0 {
        let cl = zjs_as_closure(v);
        body = (char*)"[user code]";
        body_len = 11;
        let fp2 = cl.function;
        let f2: Function* = NULL;
        raw { f2 = (Function*)fp2; }
        if f2.props != NULL {
            let nm_atom = ctx_intern_atom(ctx, (char*)"name", 4);
            let slot = class_find_slot(f2.props.cls, nm_atom);
            if slot >= 0 {
                let nv: ZjsValue = f2.props.slots[(u32)slot];
                if zjs_is_string(nv) != 0 {
                    let ns = zjs_as_string(nv);
                    nm = ns.data; nm_len = ns.length;
                }
            }
        }
    }
    let total: u32 = 9 + nm_len + 5 + body_len + 2;  // "function "(9) + name + "() { "(5) + body + " }"(2)
    let out_buf = alloc_n<char>((usize)(total + 1));
    let off: u32 = 0;
    raw { memcpy(out_buf + off, "function ", 9); }
    off = off + 9;
    if nm_len > 0 { raw { memcpy(out_buf + off, nm, nm_len); } off = off + nm_len; }
    raw { memcpy(out_buf + off, "() { ", 5); }
    off = off + 5;
    raw { memcpy(out_buf + off, body, body_len); }
    off = off + body_len;
    raw { memcpy(out_buf + off, " }", 2); }
    off = off + 2;
    out_buf[off] = (char)0;
    let r = ctx_intern_string(ctx, out_buf, total);
    dealloc(out_buf);
    return r;
}

fn host_function_bind(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let target = ctx.host_this;
    // Spec: target must be callable.
    let callable: bool =
           zjs_is_function(target) != 0
        || zjs_is_closure(target)  != 0
        || zjs_is_host_function(target) != 0;
    if !callable {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
                                    (char*)"Function.prototype.bind called on non-callable", 47);
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let this_arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    let prepend_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, prepend_v);
    defer ctx_pop_temp_root(ctx);
    if argc > 1 {
        let parr = zjs_as_array(prepend_v);
        let pi: u32 = 1;
        while pi < argc {
            array_set(parr, parr.length, args[pi]);
            pi = pi + 1;
        }
    }
    let state_v = ctx_new_object(ctx);
    let state = zjs_as_object(state_v);
    object_set(ctx, state, ctx_intern_atom(ctx, BOUND_TARGET_KEY,  20), target);
    object_set(ctx, state, ctx_intern_atom(ctx, BOUND_THIS_KEY,   18), this_arg);
    object_set(ctx, state, ctx_intern_atom(ctx, BOUND_PREPEND_KEY, 21), prepend_v);
    let tramp_ptr: void* = NULL; raw { tramp_ptr = (void*)host_function_bound_trampoline; }
    let bound_fn = ctx_make_host_function(ctx, (char*)"bound", tramp_ptr);
    zjs_as_host_function(bound_fn).bound = state_v;
    return bound_fn;
}

fn host_aggregate_error_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // make_named_error consumes args[0] as message. AggregateError
    // wants args[0] as errors, args[1] as message — swap before
    // delegating, then attach the errors array.
    let inner_args: ZjsValue[1];
    inner_args[0] = if argc >= 2 { args[1] } else { zjs_undefined() };
    let argp: ZjsValue* = NULL; raw { argp = &inner_args[0]; }
    let inner_argc: u32 = if argc >= 2 { 1 } else { 0 };
    let obj_v = make_named_error(ctx, (char*)"AggregateError", 14, argp, inner_argc);
    if ctx.pending_throw_active { return zjs_undefined(); }
    if zjs_is_object(obj_v) == 0 { return obj_v; }
    let obj = zjs_as_object(obj_v);

    // Build the .errors array from the iterable. iter_get throws on
    // non-iterable; surface that as-is (constructor propagation).
    let errs_v = ctx_new_array(ctx, 0);
    ctx_push_temp_root(ctx, errs_v);
    defer ctx_pop_temp_root(ctx);
    if argc >= 1 && zjs_is_undefined(args[0]) == 0 && zjs_is_null(args[0]) == 0 {
        let iter = iter_get(ctx, args[0]);
        if !ctx.pending_throw_active {
            let arr = zjs_as_array(errs_v);
            while true {
                let step = iter_step(ctx, iter);
                if ctx.pending_throw_active { return zjs_undefined(); }
                if step.done { break; }
                array_set(arr, arr.length, step.value);
            }
        } else {
            return zjs_undefined();
        }
    }
    object_set(ctx, obj, ctx_intern_atom(ctx, (char*)"errors", 6), errs_v);
    return obj_v;
}
fn host_uri_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"URIError", 8, args, argc);
}
fn host_eval_error(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return make_named_error(ctx, (char*)"EvalError", 9, args, argc);
}

// Stub for `eval` — we don't implement runtime eval; return undefined.
// Many tests reference `eval` only for environment checks.
fn host_eval_stub(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Minimal indirect-eval: parse + interpret the source in a fresh
    // top-level program. Does NOT see surrounding locals (matches the
    // spec for indirect eval; direct-eval is a separate feature
    // gate). Lexer now recognizes the full ECMA-262 WhiteSpace +
    // LineTerminator set so the source-text edge tests work.
    if argc == 0 { return zjs_undefined(); }
    let src = args[0];
    if zjs_is_string(src) == 0 { return src; }
    let s = zjs_as_string(src);
    let buf = alloc_n<char>((usize)(s.length + 1));
    if s.length > 0 { mem_copy<char>(buf, s.data, (usize)s.length); }
    buf[s.length] = (char)0;
    let r = zjs_eval(ctx, buf);
    dealloc(buf);
    if ctx.had_error {
        let err = ctx.last_error;
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return r;
}

// new Function(p1, p2, ..., body) — compile a function whose
// parameter list is the leading args and whose body is the last arg.
// Top-level Function() and `new Function()` share semantics here
// (we ignore `this`). Per spec the function's [[Environment]] is the
// global environment, which matches our "no closure capture" model
// for compiled-at-runtime code.
fn host_function_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    // Stringify each argument; collect into a single source buffer
    // shaped like `(function anonymous(p1, p2) {\n body \n})`.
    let body_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    if argc >= 1 {
        body_v = args[argc - 1];
        if zjs_is_string(body_v) == 0 {
            body_v = zjs_to_string(ctx, body_v);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
    }
    let body_s = zjs_as_string(body_v);

    // Build parameter list (concat by ",").
    let comma = ctx_intern_string(ctx, (char*)",", 1);
    let params_v: ZjsValue = ctx_intern_string(ctx, (char*)"", 0);
    let i: u32 = 0;
    let pn: u32 = if argc > 0 { argc - 1 } else { 0 };
    while i < pn {
        let av = args[i];
        if zjs_is_string(av) == 0 {
            av = zjs_to_string(ctx, av);
            if ctx.pending_throw_active { return zjs_undefined(); }
        }
        if i > 0 {
            params_v = zjs_string_concat(ctx, params_v, comma);
        }
        params_v = zjs_string_concat(ctx, params_v, av);
        i = i + 1;
    }
    let params_s = zjs_as_string(params_v);

    // Build the source. Total: "(function anonymous(" + params + "){\n" + body + "\n})\0"
    let prefix_len: u32 = 20;     // "(function anonymous("
    let mid_len: u32    = 3;      // "){\n"
    let suffix_len: u32 = 3;      // "\n})"
    let total: u32 = prefix_len + params_s.length + mid_len + body_s.length + suffix_len + 1;
    let buf = alloc_n<char>((usize)total);
    let cursor: u32 = 0;
    raw {
        memcpy(buf + cursor, "(function anonymous(", 20);
    }
    cursor = cursor + prefix_len;
    if params_s.length > 0 {
        let pd = params_s.data;
        mem_copy<char>(buf + cursor, pd, (usize)params_s.length);
        cursor = cursor + params_s.length;
    }
    raw {
        memcpy(buf + cursor, "){\n", 3);
    }
    cursor = cursor + mid_len;
    if body_s.length > 0 {
        let bd = body_s.data;
        mem_copy<char>(buf + cursor, bd, (usize)body_s.length);
        cursor = cursor + body_s.length;
    }
    raw {
        memcpy(buf + cursor, "\n})", 3);
    }
    cursor = cursor + suffix_len;
    buf[cursor] = (char)0;

    // zjs_eval the wrapped expression. The function value is its result.
    let result = zjs_eval(ctx, buf);
    dealloc(buf);
    // zjs_eval routes parse / compile errors through ctx.had_error +
    // ctx.last_error. Convert them to the JS-visible throw channel.
    if ctx.had_error {
        let err = ctx.last_error;
        ctx.had_error = false;
        ctx.last_error = zjs_undefined();
        ctx.pending_throw_active = true;
        ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    return result;
}

// --- Global Number-coercion helpers (Phase 3.8b) -------------------

fn host_is_nan(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(1); }
    let d = zjs_to_double(args[0]);
    let is_nan: int = 0;
    raw { is_nan = (d != d) ? 1 : 0; }
    return zjs_bool(is_nan);
}

fn host_is_finite(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 { return zjs_bool(0); }
    let d = zjs_to_double(args[0]);
    let is_fin: int = 0;
    raw { is_fin = isfinite(d) ? 1 : 0; }
    return zjs_bool(is_fin);
}

fn host_parse_float(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    let sd = s.data;
    let parsed: f64 = 0.0;
    let n_consumed: int = 0;
    raw {
        char* endp = NULL;
        parsed = strtod(sd, &endp);
        n_consumed = (int)(endp - sd);
    }
    if n_consumed == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let as_int = (i32)parsed;
    if (f64)as_int == parsed { return zjs_int32(as_int); }
    return zjs_double(parsed);
}

fn host_parse_int(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    if argc == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    let v = args[0];
    if zjs_is_string(v) == 0 { v = zjs_to_string(ctx, v); }
    let s = zjs_as_string(v);
    // ECMA-262: if radix is 0/undefined AND the string starts with 0x,
    // radix is 16; else 10. Start at 0 ("unset") and resolve below.
    let radix: int = 0;
    if argc >= 2 && zjs_is_undefined(args[1]) == 0 {
        let r = (i32)zjs_to_double(args[1]);
        if r != 0 { radix = (int)r; }
    }
    let sd = s.data;
    let parsed: i64 = 0;
    let n_consumed: int = 0;
    raw {
        char* endp = NULL;
        // Skip leading whitespace.
        const char* p = sd;
        while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' || *p == '\v' || *p == '\f') p++;
        // Optional sign.
        int neg = 0;
        if (*p == '-') { neg = 1; p++; }
        else if (*p == '+') p++;
        // 0x / 0X prefix selects hex.
        int rdx = radix;
        if ((rdx == 0 || rdx == 16) && p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
            p += 2;
            rdx = 16;
        }
        if (rdx == 0) rdx = 10;
        parsed = strtoll(p, &endp, rdx);
        n_consumed = (int)(endp - p);
        if (neg) parsed = -parsed;
    }
    if n_consumed == 0 {
        let nan: f64 = 0.0;
        raw { nan = (double)NAN; }
        return zjs_double(nan);
    }
    if parsed >= -2147483648 && parsed <= 2147483647 {
        return zjs_int32((i32)parsed);
    }
    return zjs_double((f64)parsed);
}

// =====================================================================
// Temporal (ECMA-262 Temporal proposal) — native, behind
// ZJS_NO_TEMPORAL. T1: Temporal.Duration (complete), Temporal.Now,
// minimal Temporal.Instant. Later phases add the Plain* / ZonedDateTime
// types + the rounding matrix. See ZjsTemporal in value.zc.
// =====================================================================

// --- ISO 8601 proleptic-Gregorian calendar helpers --------------------
// Howard Hinnant's days_from_civil / civil_from_days (epoch = 1970-01-01).

fn iso_is_leap(y: i64) -> bool {
    let r: int = 0;
    raw { r = ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) ? 1 : 0; }
    return r != 0;
}

fn iso_days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 { return if iso_is_leap(y) { 29 } else { 28 }; }
    if m == 4 || m == 6 || m == 9 || m == 11 { return 30; }
    return 31;
}

// y/m/d → days since 1970-01-01 (m in 1..12, proleptic Gregorian).
fn iso_days_from_civil(y: i64, m: i64, d: i64) -> i64 {
    let result: i64 = 0;
    raw {
        int64_t Y = (int64_t)y;
        if (m <= 2) Y -= 1;
        int64_t era = (Y >= 0 ? Y : Y - 399) / 400;
        int64_t yoe = Y - era * 400;                       // [0, 399]
        int64_t mp = (m + (m > 2 ? -3 : 9));               // Mar=0..Feb=11
        int64_t doy = (153 * mp + 2) / 5 + (d - 1);        // [0, 365]
        int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
        result = era * 146097 + doe - 719468;
    }
    return result;
}

// days since 1970-01-01 → y/m/d, written into out[0..2] (year, month, day).
fn iso_civil_from_days(z: i64, out: i64*) -> void {
    raw {
        int64_t zz = (int64_t)z + 719468;
        int64_t era = (zz >= 0 ? zz : zz - 146096) / 146097;
        int64_t doe = zz - era * 146097;                              // [0, 146096]
        int64_t yoe = (doe - doe/1460 + doe/36524 - doe/146096) / 365; // [0, 399]
        int64_t y = yoe + era * 400;
        int64_t doy = doe - (365*yoe + yoe/4 - yoe/100);             // [0, 365]
        int64_t mp = (5*doy + 2)/153;                                // [0, 11]
        int64_t d = doy - (153*mp+2)/5 + 1;                          // [1, 31]
        int64_t m = mp + (mp < 10 ? 3 : -9);                         // [1, 12]
        out[0] = y + (m <= 2 ? 1 : 0);
        out[1] = m;
        out[2] = d;
    }
}

// ISO day of week: 1 = Monday .. 7 = Sunday.
fn iso_day_of_week(y: i64, m: i64, d: i64) -> i64 {
    let days = iso_days_from_civil(y, m, d);
    // 1970-01-01 was a Thursday. ((days + 3) mod 7) gives 0 = Monday.
    let r: i64 = 0;
    raw { r = ((days + 3) % 7 + 7) % 7; }
    return r + 1;
}

// ISO day of year (Jan 1 = 1).
fn iso_day_of_year(y: i64, m: i64, d: i64) -> i64 {
    return iso_days_from_civil(y, m, d) - iso_days_from_civil(y, 1, 1) + 1;
}

// Overall sign of a Duration cell: -1 / 0 / +1. By construction all
// nonzero components share one sign, so the first nonzero decides.
fn temporal_duration_sign(t: ZjsTemporal*) -> int {
    if t.d_years   != 0 { return if t.d_years   < 0 { -1 } else { 1 }; }
    if t.d_months  != 0 { return if t.d_months  < 0 { -1 } else { 1 }; }
    if t.d_weeks   != 0 { return if t.d_weeks   < 0 { -1 } else { 1 }; }
    if t.d_days    != 0 { return if t.d_days    < 0 { -1 } else { 1 }; }
    if t.d_hours   != 0 { return if t.d_hours   < 0 { -1 } else { 1 }; }
    if t.d_minutes != 0 { return if t.d_minutes < 0 { -1 } else { 1 }; }
    if t.d_seconds != 0 { return if t.d_seconds < 0 { -1 } else { 1 }; }
    if t.d_ms      != 0 { return if t.d_ms      < 0 { -1 } else { 1 }; }
    if t.d_us      != 0 { return if t.d_us      < 0 { -1 } else { 1 }; }
    if t.d_ns      != 0 { return if t.d_ns      < 0 { -1 } else { 1 }; }
    return 0;
}

fn i64_abs(v: i64) -> i64 { if v < 0 { return -v; } return v; }

// Render a Duration as an ISO-8601 duration string into `buf`.
// Format: [-]P[nY][nM][nW][nD][T[nH][nM][n[.fff]S]]; empty → "PT0S".
// Sub-second components (ms/us/ns) combine into the fractional seconds
// with carry into the whole-seconds field (matches Node, incl. the
// unbalanced case like {milliseconds:1500} → "PT1.5S").
fn temporal_duration_to_iso(t: ZjsTemporal*, buf: char*, cap: usize) -> void {
    let sign = temporal_duration_sign(t);
    let yr = i64_abs(t.d_years);
    let mo = i64_abs(t.d_months);
    let wk = i64_abs(t.d_weeks);
    let dy = i64_abs(t.d_days);
    let hh = i64_abs(t.d_hours);
    let mm = i64_abs(t.d_minutes);
    let ss = i64_abs(t.d_seconds);
    // Combine sub-second units into total nanoseconds, carry into ss.
    let frac_ns: i64 = i64_abs(t.d_ms) * 1000000 + i64_abs(t.d_us) * 1000 + i64_abs(t.d_ns);
    let carry: i64 = frac_ns / 1000000000;
    let sub: i64 = frac_ns % 1000000000;
    let sec_total: i64 = ss + carry;
    raw {
        char* p = buf;
        char* end = buf + cap;
        if (sign < 0) p += snprintf(p, end - p, "-");
        p += snprintf(p, end - p, "P");
        if (yr) p += snprintf(p, end - p, "%lldY", (long long)yr);
        if (mo) p += snprintf(p, end - p, "%lldM", (long long)mo);
        if (wk) p += snprintf(p, end - p, "%lldW", (long long)wk);
        if (dy) p += snprintf(p, end - p, "%lldD", (long long)dy);
        int have_time = (hh || mm || sec_total || sub);
        // PT0S when the whole duration is empty.
        int empty = !(yr || mo || wk || dy || have_time);
        if (have_time || empty) {
            p += snprintf(p, end - p, "T");
            if (hh) p += snprintf(p, end - p, "%lldH", (long long)hh);
            if (mm) p += snprintf(p, end - p, "%lldM", (long long)mm);
            // Seconds: emitted when there's a seconds value/fraction, or
            // when seconds is the only time content (incl. the empty
            // PT0S case).
            if (sec_total || sub || (!hh && !mm)) {
                if (sub) {
                    char fbuf[10];
                    snprintf(fbuf, sizeof(fbuf), "%09lld", (long long)sub);
                    int flen = 9;
                    while (flen > 1 && fbuf[flen-1] == '0') flen--;
                    p += snprintf(p, end - p, "%lld.%.*sS", (long long)sec_total, flen, fbuf);
                } else {
                    p += snprintf(p, end - p, "%lldS", (long long)sec_total);
                }
            }
        }
    }
}

// Read arg[idx] as an integer Duration component. Missing/undefined → 0.
// Sets ok[0]=0 (RangeError) on a non-integral / non-finite value.
fn temporal_dur_arg(args: ZjsValue*, argc: u32, idx: u32, ok: int*) -> i64 {
    if idx >= argc { return 0; }
    let v = args[idx];
    if zjs_is_undefined(v) != 0 { return 0; }
    let d = zjs_to_double(v);
    let bad: int = 0;
    raw { bad = (!isfinite(d) || d != trunc(d)) ? 1 : 0; }
    if bad != 0 { ok[0] = 0; return 0; }
    return (i64)d;
}

// `new Temporal.Duration(y, mo, w, d, h, m, s, ms, us, ns)`.
fn host_temporal_duration_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ok: int = 1;
    let yr = temporal_dur_arg(args, argc, 0, &ok);
    let mo = temporal_dur_arg(args, argc, 1, &ok);
    let wk = temporal_dur_arg(args, argc, 2, &ok);
    let dy = temporal_dur_arg(args, argc, 3, &ok);
    let hh = temporal_dur_arg(args, argc, 4, &ok);
    let mm = temporal_dur_arg(args, argc, 5, &ok);
    let ss = temporal_dur_arg(args, argc, 6, &ok);
    let ms = temporal_dur_arg(args, argc, 7, &ok);
    let us = temporal_dur_arg(args, argc, 8, &ok);
    let ns = temporal_dur_arg(args, argc, 9, &ok);
    if ok == 0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
            (char*)"Duration components must be integers", 35);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    // All nonzero components must share one sign (ECMA-262 §7.5.x).
    let seen: int = 0;
    let bad_sign: int = 0;
    raw {
        long long comps[10] = {(long long)yr,(long long)mo,(long long)wk,(long long)dy,
                               (long long)hh,(long long)mm,(long long)ss,
                               (long long)ms,(long long)us,(long long)ns};
        for (int i = 0; i < 10; i++) {
            if (comps[i] != 0) {
                int s = comps[i] < 0 ? -1 : 1;
                if (seen == 0) seen = s;
                else if (seen != s) { bad_sign = 1; break; }
            }
        }
    }
    if bad_sign != 0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
            (char*)"Duration components must all have the same sign", 47);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let t = zjs_temporal_new(TMP_DURATION);
    t.d_years = yr; t.d_months = mo; t.d_weeks = wk; t.d_days = dy;
    t.d_hours = hh; t.d_minutes = mm; t.d_seconds = ss;
    t.d_ms = ms; t.d_us = us; t.d_ns = ns;
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Temporal.Duration.from(durationLike). T1: accepts a Duration (clone)
// or a plain object with numeric component properties. (ISO-string
// parsing is a T2 follow-up.)
fn host_temporal_duration_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let f: i64[10];
        let fp: i64* = NULL; raw { fp = &f[0]; }
        let pok = temporal_parse_iso_duration(s.data, s.length, fp);
        if pok == 0 {
            return temporal_range_error(ctx, (char*)"invalid ISO 8601 duration string", 32);
        }
        let t = zjs_temporal_new(TMP_DURATION);
        t.d_years = f[0]; t.d_months = f[1]; t.d_weeks = f[2]; t.d_days = f[3];
        t.d_hours = f[4]; t.d_minutes = f[5]; t.d_seconds = f[6];
        t.d_ms = f[7]; t.d_us = f[8]; t.d_ns = f[9];
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    if zjs_is_temporal_kind(v, TMP_DURATION) != 0 {
        let src = zjs_as_temporal(v);
        let t = zjs_temporal_new(TMP_DURATION);
        t.d_years = src.d_years; t.d_months = src.d_months; t.d_weeks = src.d_weeks;
        t.d_days = src.d_days; t.d_hours = src.d_hours; t.d_minutes = src.d_minutes;
        t.d_seconds = src.d_seconds; t.d_ms = src.d_ms; t.d_us = src.d_us; t.d_ns = src.d_ns;
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    if zjs_is_object(v) != 0 {
        // Pull named numeric fields off the object, build a 10-arg call.
        let argbuf: ZjsValue[10];
        let names0 = (char*)"years"; let _u0 = names0;
        argbuf[0] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"years", 5));
        argbuf[1] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"months", 6));
        argbuf[2] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"weeks", 5));
        argbuf[3] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"days", 4));
        argbuf[4] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"hours", 5));
        argbuf[5] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"minutes", 7));
        argbuf[6] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"seconds", 7));
        argbuf[7] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"milliseconds", 12));
        argbuf[8] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"microseconds", 12));
        argbuf[9] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"nanoseconds", 11));
        let ap: ZjsValue* = NULL; raw { ap = &argbuf[0]; }
        return host_temporal_duration_ctor(ctx, ap, 10);
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
        (char*)"Temporal.Duration.from expects a Duration or object", 51);
    ctx.pending_throw_active = true; ctx.pending_throw_value = err;
    return zjs_undefined();
}

fn host_temporal_duration_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_DURATION) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
            (char*)"not a Temporal.Duration", 23);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let buf: char[512];
    let bp: char* = NULL; raw { bp = &buf[0]; }
    temporal_duration_to_iso(zjs_as_temporal(this_v), bp, 512);
    let n: u32 = 0; raw { n = (uint32_t)strlen(bp); }
    return ctx_intern_string(ctx, bp, n);
}

// Temporal.Duration.prototype.negated() — flip every component's sign.
fn host_temporal_duration_negated(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_DURATION) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.Duration", 23);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let t = zjs_temporal_new(TMP_DURATION);
    t.d_years = -s.d_years; t.d_months = -s.d_months; t.d_weeks = -s.d_weeks;
    t.d_days = -s.d_days; t.d_hours = -s.d_hours; t.d_minutes = -s.d_minutes;
    t.d_seconds = -s.d_seconds; t.d_ms = -s.d_ms; t.d_us = -s.d_us; t.d_ns = -s.d_ns;
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Temporal.Duration.prototype.abs() — every component non-negative.
fn host_temporal_duration_abs(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_DURATION) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.Duration", 23);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let t = zjs_temporal_new(TMP_DURATION);
    t.d_years = i64_abs(s.d_years); t.d_months = i64_abs(s.d_months); t.d_weeks = i64_abs(s.d_weeks);
    t.d_days = i64_abs(s.d_days); t.d_hours = i64_abs(s.d_hours); t.d_minutes = i64_abs(s.d_minutes);
    t.d_seconds = i64_abs(s.d_seconds); t.d_ms = i64_abs(s.d_ms); t.d_us = i64_abs(s.d_us); t.d_ns = i64_abs(s.d_ns);
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Temporal.Now.instant() — current instant as a Temporal.Instant.
fn host_temporal_now_instant(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let ms: f64 = (f64)Time::now();
    // epochNanoseconds = ms * 1e6 (sub-ms resolution unavailable).
    let ns_i64: i64 = 0;
    raw { ns_i64 = (int64_t)ms * 1000000LL; }
    let bi = zjs_bigint_from_i64(ns_i64);
    ctx_register_cell(ctx, (void*)bi);
    let t = zjs_temporal_new(TMP_INSTANT);
    t.epoch_ns = zjs_cell_from_ptr((void*)bi);
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Temporal.Now.timeZoneId() — the host IANA time zone identifier
// (resolved from /etc/localtime); falls back to "UTC".
fn host_temporal_now_timezone_id(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let buf: char[256];
    let got: int = 0;
    raw { got = zjs_host_timezone_id(buf, sizeof(buf)); }
    if got != 0 {
        let bp: char* = NULL; raw { bp = &buf[0]; }
        let n: u32 = 0; raw { n = (uint32_t)strlen(bp); }
        return ctx_intern_string(ctx, bp, n);
    }
    return ctx_intern_string(ctx, (char*)"UTC", 3);
}

// Temporal.Now.zonedDateTimeISO([timeZone]) — current instant in the
// given zone (default: the host zone).
fn host_temporal_now_zoneddatetime_iso(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let tzv = if argc >= 1 && zjs_is_string(args[0]) != 0 { args[0] }
              else { host_temporal_now_timezone_id(ctx, args, 0) };
    let ms: f64 = (f64)Time::now();
    let ns_i64: i64 = 0;
    raw { ns_i64 = (int64_t)ms * 1000000LL; }
    let bi = zjs_bigint_from_i64(ns_i64);
    ctx_register_cell(ctx, (void*)bi);
    let t = zjs_temporal_new(TMP_ZONED_DATETIME);
    t.epoch_ns = zjs_cell_from_ptr((void*)bi);
    t.timezone = zjs_as_string(tzv);
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Break the current wall-clock time into UTC y/m/d/h/mi/s/ms via the C
// library. (Now uses UTC until real tz support in T5.) Writes into the
// caller's out[0..6] = year, month, day, hour, minute, second, ms.
fn temporal_now_fields(out: i64*) -> void {
    let ms: f64 = (f64)Time::now();
    raw {
        int64_t total_ms = (int64_t)ms;
        int millis = (int)(total_ms % 1000); if (millis < 0) millis += 1000;
        time_t secs = (time_t)(total_ms / 1000);
        if (millis != 0 && total_ms < 0) secs -= 1;
        struct tm tm_utc;
        zjs_gmtime_r(&secs, &tm_utc);
        out[0] = tm_utc.tm_year + 1900;
        out[1] = tm_utc.tm_mon + 1;
        out[2] = tm_utc.tm_mday;
        out[3] = tm_utc.tm_hour;
        out[4] = tm_utc.tm_min;
        out[5] = tm_utc.tm_sec;
        out[6] = millis;
    }
}

fn host_temporal_now_plaindatetime_iso(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let f: i64[7];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    temporal_now_fields(fp);
    let t = zjs_temporal_new(TMP_PLAIN_DATETIME);
    t.year = (i32)f[0]; t.month = (i32)f[1]; t.day = (i32)f[2];
    t.hour = (i32)f[3]; t.minute = (i32)f[4]; t.second = (i32)f[5];
    t.millisecond = (i32)f[6];
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

fn host_temporal_now_plaindate_iso(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let f: i64[7];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    temporal_now_fields(fp);
    let t = zjs_temporal_new(TMP_PLAIN_DATE);
    t.year = (i32)f[0]; t.month = (i32)f[1]; t.day = (i32)f[2];
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

fn host_temporal_now_plaintime_iso(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let f: i64[7];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    temporal_now_fields(fp);
    let t = zjs_temporal_new(TMP_PLAIN_TIME);
    t.hour = (i32)f[3]; t.minute = (i32)f[4]; t.second = (i32)f[5];
    t.millisecond = (i32)f[6];
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Temporal.Instant.fromEpochMilliseconds(ms).
fn host_temporal_instant_from_epoch_ms(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ms_v = if argc >= 1 { args[0] } else { zjs_undefined() };
    let ms = zjs_to_double(ms_v);
    let bad: int = 0;
    raw { bad = (!isfinite(ms) || ms != trunc(ms)) ? 1 : 0; }
    if bad != 0 {
        let err = build_typed_error(ctx, (char*)"RangeError", 10,
            (char*)"epoch milliseconds must be an integer", 37);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let ns_i64: i64 = 0;
    raw { ns_i64 = (int64_t)ms * 1000000LL; }
    let bi = zjs_bigint_from_i64(ns_i64);
    ctx_register_cell(ctx, (void*)bi);
    let t = zjs_temporal_new(TMP_INSTANT);
    t.epoch_ns = zjs_cell_from_ptr((void*)bi);
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// --- Rounding (T4b) --------------------------------------------------
// Rounding modes (ECMA-262 Temporal RoundingMode).
def ROUND_TRUNC:       int = 0;
def ROUND_FLOOR:       int = 1;
def ROUND_CEIL:        int = 2;
def ROUND_EXPAND:      int = 3;
def ROUND_HALF_EXPAND: int = 4;
def ROUND_HALF_FLOOR:  int = 5;
def ROUND_HALF_CEIL:   int = 6;
def ROUND_HALF_TRUNC:  int = 7;
def ROUND_HALF_EVEN:   int = 8;

fn temporal_parse_rounding_mode(s: ZjsString*, dflt: int) -> int {
    if s == NULL { return dflt; }
    if tmp_name_is(s, (char*)"trunc", 5)      { return ROUND_TRUNC; }
    if tmp_name_is(s, (char*)"floor", 5)      { return ROUND_FLOOR; }
    if tmp_name_is(s, (char*)"ceil", 4)       { return ROUND_CEIL; }
    if tmp_name_is(s, (char*)"expand", 6)     { return ROUND_EXPAND; }
    if tmp_name_is(s, (char*)"halfExpand", 10){ return ROUND_HALF_EXPAND; }
    if tmp_name_is(s, (char*)"halfFloor", 9)  { return ROUND_HALF_FLOOR; }
    if tmp_name_is(s, (char*)"halfCeil", 8)   { return ROUND_HALF_CEIL; }
    if tmp_name_is(s, (char*)"halfTrunc", 9)  { return ROUND_HALF_TRUNC; }
    if tmp_name_is(s, (char*)"halfEven", 8)   { return ROUND_HALF_EVEN; }
    return dflt;
}

// nanoseconds-per-unit, or 0 if `s` is not a time/day unit name.
fn temporal_unit_to_ns(s: ZjsString*) -> i64 {
    if s == NULL { return 0; }
    if tmp_name_is(s, (char*)"nanosecond", 10)  { return 1; }
    if tmp_name_is(s, (char*)"nanoseconds", 11) { return 1; }
    if tmp_name_is(s, (char*)"microsecond", 11) { return 1000; }
    if tmp_name_is(s, (char*)"microseconds", 12){ return 1000; }
    if tmp_name_is(s, (char*)"millisecond", 11) { return 1000000; }
    if tmp_name_is(s, (char*)"milliseconds", 12){ return 1000000; }
    if tmp_name_is(s, (char*)"second", 6)       { return 1000000000; }
    if tmp_name_is(s, (char*)"seconds", 7)      { return 1000000000; }
    if tmp_name_is(s, (char*)"minute", 6)       { return 60000000000; }
    if tmp_name_is(s, (char*)"minutes", 7)      { return 60000000000; }
    if tmp_name_is(s, (char*)"hour", 4)         { return 3600000000000; }
    if tmp_name_is(s, (char*)"hours", 5)        { return 3600000000000; }
    if tmp_name_is(s, (char*)"day", 3)          { return 86400000000000; }
    if tmp_name_is(s, (char*)"days", 4)         { return 86400000000000; }
    return 0;
}

// Round signed x to a multiple of inc (inc > 0) per `mode`.
fn temporal_round_i64(x: i64, inc: i64, mode: int) -> i64 {
    let out: i64 = 0;
    raw {
        int64_t r = x % inc;
        if (r == 0) { out = x; }
        else {
            int64_t q = x / inc;
            int64_t lower, upper;
            if (x >= 0) { lower = q * inc; upper = lower + inc; }
            else        { upper = q * inc; lower = upper - inc; }
            int64_t dl = x - lower;   /* >= 0 */
            int64_t du = upper - x;   /* >= 0 */
            int64_t chosen;
            switch (mode) {
              case 0: chosen = (x >= 0) ? lower : upper; break;          /* trunc */
              case 1: chosen = lower; break;                              /* floor */
              case 2: chosen = upper; break;                              /* ceil */
              case 3: chosen = (x >= 0) ? upper : lower; break;          /* expand */
              case 5: chosen = (dl <= du) ? lower : upper; break;        /* halfFloor */
              case 6: chosen = (du <= dl) ? upper : lower; break;        /* halfCeil */
              case 7: chosen = (dl < du) ? lower : (du < dl ? upper : ((x >= 0) ? lower : upper)); break; /* halfTrunc */
              case 8: { if (dl < du) chosen = lower; else if (du < dl) chosen = upper;
                        else { int64_t ql = lower / inc; chosen = (ql % 2 == 0) ? lower : upper; } } break; /* halfEven */
              default: chosen = (dl < du) ? lower : (du < dl ? upper : ((x >= 0) ? upper : lower)); break;  /* halfExpand */
            }
            out = chosen;
        }
    }
    return out;
}

// Parse round()/until()/since() options into (unit_ns, increment, mode).
// `optarg` may be a bare smallestUnit string or an options object.
// ok[0]=0 on a missing/invalid smallestUnit. inc_out is the rounding
// increment (default 1); the effective rounding quantum is inc * unit_ns.
fn temporal_rounding_opts(ctx: ZjsContext*, optarg: ZjsValue, dflt_mode: int,
                          unit_ns_out: i64*, inc_out: i64*, mode_out: int*, ok: int*) -> void {
    inc_out[0] = 1;
    mode_out[0] = dflt_mode;
    if zjs_is_string(optarg) != 0 {
        unit_ns_out[0] = temporal_unit_to_ns(zjs_as_string(optarg));
        if unit_ns_out[0] == 0 { ok[0] = 0; }
        return;
    }
    if zjs_is_object(optarg) == 0 { ok[0] = 0; return; }
    let su = property_get(ctx, optarg, ctx_intern_string(ctx, (char*)"smallestUnit", 12));
    if zjs_is_string(su) == 0 { ok[0] = 0; return; }
    unit_ns_out[0] = temporal_unit_to_ns(zjs_as_string(su));
    if unit_ns_out[0] == 0 { ok[0] = 0; return; }
    let ri = property_get(ctx, optarg, ctx_intern_string(ctx, (char*)"roundingIncrement", 17));
    if zjs_is_undefined(ri) == 0 {
        let d = zjs_to_double(ri);
        raw { if (isfinite(d) && d >= 1) inc_out[0] = (int64_t)d; }
    }
    let rm = property_get(ctx, optarg, ctx_intern_string(ctx, (char*)"roundingMode", 12));
    if zjs_is_string(rm) != 0 { mode_out[0] = temporal_parse_rounding_mode(zjs_as_string(rm), dflt_mode); }
}

fn host_temporal_instant_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_INSTANT) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.Instant", 22);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let t = zjs_as_temporal(this_v);
    let ns: i64 = 0;
    if zjs_is_bigint(t.epoch_ns) != 0 { ns = bigint_to_i64(zjs_as_bigint(t.epoch_ns)); }
    // Split into floor seconds + sub-second nanoseconds (UTC + 'Z').
    let secs = i64_floordiv(ns, 1000000000);
    let sub = i64_floormod(ns, 1000000000);
    let buf: char[48];
    raw {
        time_t tt = (time_t)secs;
        struct tm tm_utc;
        zjs_gmtime_r(&tt, &tm_utc);
        int base = snprintf(buf, sizeof(buf), "%04d-%02d-%02dT%02d:%02d:%02d",
            tm_utc.tm_year + 1900, tm_utc.tm_mon + 1, tm_utc.tm_mday,
            tm_utc.tm_hour, tm_utc.tm_min, tm_utc.tm_sec);
        if (sub != 0) {
            char fbuf[10]; snprintf(fbuf, sizeof(fbuf), "%09lld", (long long)sub);
            int flen = 9; while (flen > 1 && fbuf[flen-1] == '0') flen--;
            base += snprintf(buf + base, sizeof(buf) - base, ".%.*s", flen, fbuf);
        }
        snprintf(buf + base, sizeof(buf) - base, "Z");
    }
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let n: u32 = 0; raw { n = (uint32_t)strlen(bp); }
    return ctx_intern_string(ctx, bp, n);
}

// Build an Instant cell from an epoch-nanoseconds BigInt value.
fn temporal_make_instant(ctx: ZjsContext*, epoch_ns: ZjsValue) -> ZjsValue {
    let t = zjs_temporal_new(TMP_INSTANT);
    t.epoch_ns = epoch_ns;
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// new Temporal.Instant(epochNanoseconds) — argument must be a BigInt.
fn host_temporal_instant_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_bigint(v) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
            (char*)"Temporal.Instant requires a BigInt epochNanoseconds", 51);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    return temporal_make_instant(ctx, v);
}

fn host_temporal_instant_from_epoch_ns(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return host_temporal_instant_ctor(ctx, args, argc);
}

// Temporal.Instant.from(Instant | ISO-string-with-offset).
fn host_temporal_instant_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_temporal_kind(v, TMP_INSTANT) != 0 {
        let s = zjs_as_temporal(v);
        return temporal_make_instant(ctx, s.epoch_ns);
    }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let p: TmpIso; let pp: TmpIso* = NULL; raw { pp = &p; }
        temporal_parse_iso(s.data, s.length, pp);
        if p.ok == 0 || p.has_date == 0 || p.has_time == 0 || p.has_offset == 0 {
            return temporal_range_error(ctx, (char*)"Instant.from needs a date-time with offset (Z or +HH:MM)", 56);
        }
        if !temporal_date_valid(p.year, p.month, p.day) {
            return temporal_range_error(ctx, (char*)"invalid ISO date", 16);
        }
        if !temporal_time_valid(p.hour, p.minute, p.second, p.ms, p.us, p.ns) {
            return temporal_range_error(ctx, (char*)"invalid time", 12);
        }
        let days = iso_days_from_civil(p.year, p.month, p.day);
        let secs = days * 86400 + p.hour * 3600 + p.minute * 60 + p.second - p.offset_secs;
        let sub_ns = p.ms * 1000000 + p.us * 1000 + p.ns;
        let secs_b = zjs_bigint_from_i64(secs);
        let g = zjs_bigint_from_i64(1000000000);
        let prod = bigint_mul(secs_b, g);
        let subb = zjs_bigint_from_i64(sub_ns);
        let total = bigint_add(prod, subb);
        bigint_free_void((void*)secs_b);
        bigint_free_void((void*)g);
        bigint_free_void((void*)prod);
        bigint_free_void((void*)subb);
        ctx_register_cell(ctx, (void*)total);
        return temporal_make_instant(ctx, zjs_cell_from_ptr((void*)total));
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
        (char*)"Temporal.Instant.from expects an Instant or string", 50);
    ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
}

// Instant add/subtract: a time-only Duration; date units (years,
// months, weeks, days) → RangeError. sign +1 add / -1 subtract.
fn temporal_instant_add_impl(ctx: ZjsContext*, sign: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_INSTANT) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.Instant", 22);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let f: i64[10];
    let fp: i64* = NULL; raw { fp = &f[0]; }
    let ok: int = 1;
    temporal_read_duration(ctx, if argc >= 1 { args[0] } else { zjs_undefined() }, fp, &ok);
    if ok == 0 { let e = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"invalid duration", 16);
        ctx.pending_throw_active = true; ctx.pending_throw_value = e; return zjs_undefined(); }
    if f[0] != 0 || f[1] != 0 || f[2] != 0 || f[3] != 0 {
        return temporal_range_error(ctx, (char*)"Instant arithmetic allows only time units", 41);
    }
    let delta_ns = sign * temporal_duration_time_ns(fp);
    let cur = if zjs_is_bigint(s.epoch_ns) != 0 { zjs_as_bigint(s.epoch_ns) } else { zjs_bigint_from_i64(0) };
    let db = zjs_bigint_from_i64(delta_ns);
    let r = bigint_add(cur, db);
    bigint_free_void((void*)db);
    ctx_register_cell(ctx, (void*)r);
    return temporal_make_instant(ctx, zjs_cell_from_ptr((void*)r));
}
fn host_temporal_instant_add(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_instant_add_impl(ctx, 1, args, argc);
}
fn host_temporal_instant_subtract(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_instant_add_impl(ctx, -1, args, argc);
}

// Build a time-only Duration (seconds + ms + us + ns) from a signed
// nanosecond total. largestUnit 'second' (the Instant.until default).
fn temporal_duration_from_ns(ctx: ZjsContext*, total_ns: i64) -> ZjsValue {
    let secs = total_ns / 1000000000;
    let rem = total_ns % 1000000000;
    let t = zjs_temporal_new(TMP_DURATION);
    t.d_seconds = secs;
    t.d_ms = rem / 1000000;
    t.d_us = (rem / 1000) % 1000;
    t.d_ns = rem % 1000;
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Instant.until(other) / since(other) → Duration. since = -until.
fn temporal_instant_diff_impl(ctx: ZjsContext*, dir: i64, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    let other = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_temporal_kind(this_v, TMP_INSTANT) == 0 || zjs_is_temporal_kind(other, TMP_INSTANT) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"expects two Temporal.Instants", 29);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let a = zjs_as_temporal(this_v); let b = zjs_as_temporal(other);
    let na = if zjs_is_bigint(a.epoch_ns) != 0 { bigint_to_i64(zjs_as_bigint(a.epoch_ns)) } else { 0 };
    let nb = if zjs_is_bigint(b.epoch_ns) != 0 { bigint_to_i64(zjs_as_bigint(b.epoch_ns)) } else { 0 };
    let diff = (nb - na) * dir;   // until: other - this; since: this - other
    // Optional rounding (args[1]): smallestUnit hour..ns, default
    // 'trunc'. (Calendar-unit rounding needs ZonedDateTime — T5.)
    let optarg = if argc >= 2 { args[1] } else { zjs_undefined() };
    if zjs_is_undefined(optarg) == 0 {
        let unit_ns: i64 = 0; let inc: i64 = 1; let mode: int = ROUND_TRUNC; let ok: int = 1;
        temporal_rounding_opts(ctx, optarg, ROUND_TRUNC, &unit_ns, &inc, &mode, &ok);
        if ok == 0 || unit_ns == 0 { return temporal_range_error(ctx, (char*)"invalid smallestUnit", 20); }
        if unit_ns == 86400000000000 { return temporal_range_error(ctx, (char*)"Instant diff cannot use days", 28); }
        diff = temporal_round_i64(diff, inc * unit_ns, mode);
    }
    return temporal_duration_from_ns(ctx, diff);
}
fn host_temporal_instant_until(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_instant_diff_impl(ctx, 1, args, argc);
}
fn host_temporal_instant_since(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    return temporal_instant_diff_impl(ctx, -1, args, argc);
}

fn host_temporal_instant_compare(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let a = if argc >= 1 { args[0] } else { zjs_undefined() };
    let b = if argc >= 2 { args[1] } else { zjs_undefined() };
    if zjs_is_temporal_kind(a, TMP_INSTANT) == 0 || zjs_is_temporal_kind(b, TMP_INSTANT) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"compare expects two Instants", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let ta = zjs_as_temporal(a); let tb = zjs_as_temporal(b);
    let c = bigint_cmp(zjs_as_bigint(ta.epoch_ns), zjs_as_bigint(tb.epoch_ns));
    return zjs_int32(c);
}

fn host_temporal_instant_equals(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    let other = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_temporal_kind(this_v, TMP_INSTANT) == 0 { return zjs_bool(0); }
    if zjs_is_temporal_kind(other, TMP_INSTANT) == 0 { return zjs_bool(0); }
    let ta = zjs_as_temporal(this_v); let tb = zjs_as_temporal(other);
    return zjs_bool(if bigint_cmp(zjs_as_bigint(ta.epoch_ns), zjs_as_bigint(tb.epoch_ns)) == 0 { 1 } else { 0 });
}

// Instant.prototype.round(options) — smallestUnit in hour..nanosecond
// (day requires a time zone). Default mode halfExpand.
fn host_temporal_instant_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_INSTANT) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.Instant", 22);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let unit_ns: i64 = 0; let inc: i64 = 1; let mode: int = ROUND_HALF_EXPAND; let ok: int = 1;
    temporal_rounding_opts(ctx, if argc >= 1 { args[0] } else { zjs_undefined() },
                           ROUND_HALF_EXPAND, &unit_ns, &inc, &mode, &ok);
    if ok == 0 || unit_ns == 0 { return temporal_range_error(ctx, (char*)"invalid smallestUnit", 20); }
    if unit_ns == 86400000000000 { return temporal_range_error(ctx, (char*)"Instant cannot round to days", 28); }
    let s = zjs_as_temporal(this_v);
    let ns = if zjs_is_bigint(s.epoch_ns) != 0 { bigint_to_i64(zjs_as_bigint(s.epoch_ns)) } else { 0 };
    let rounded = temporal_round_i64(ns, inc * unit_ns, mode);
    let bi = zjs_bigint_from_i64(rounded);
    ctx_register_cell(ctx, (void*)bi);
    return temporal_make_instant(ctx, zjs_cell_from_ptr((void*)bi));
}

// PlainTime.prototype.round(options) — wraps within the day.
fn host_temporal_plaintime_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_TIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainTime", 24);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let unit_ns: i64 = 0; let inc: i64 = 1; let mode: int = ROUND_HALF_EXPAND; let ok: int = 1;
    temporal_rounding_opts(ctx, if argc >= 1 { args[0] } else { zjs_undefined() },
                           ROUND_HALF_EXPAND, &unit_ns, &inc, &mode, &ok);
    if ok == 0 || unit_ns == 0 { return temporal_range_error(ctx, (char*)"invalid smallestUnit", 20); }
    if unit_ns == 86400000000000 { return temporal_range_error(ctx, (char*)"PlainTime cannot round to days", 30); }
    let s = zjs_as_temporal(this_v);
    let rounded = temporal_round_i64(temporal_time_total_ns(s), inc * unit_ns, mode);
    let wrapped = i64_floormod(rounded, 86400000000000);
    let t = zjs_temporal_new(TMP_PLAIN_TIME);
    temporal_set_time_from_ns(t, wrapped);
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// PlainDateTime.prototype.round(options) — day..nanosecond, with day
// carry. Works on epoch-day*86400e9 + time-of-day nanoseconds.
fn host_temporal_plaindatetime_round(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATETIME) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainDateTime", 28);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let unit_ns: i64 = 0; let inc: i64 = 1; let mode: int = ROUND_HALF_EXPAND; let ok: int = 1;
    temporal_rounding_opts(ctx, if argc >= 1 { args[0] } else { zjs_undefined() },
                           ROUND_HALF_EXPAND, &unit_ns, &inc, &mode, &ok);
    if ok == 0 || unit_ns == 0 { return temporal_range_error(ctx, (char*)"invalid smallestUnit", 20); }
    let s = zjs_as_temporal(this_v);
    let days = iso_days_from_civil((i64)s.year, (i64)s.month, (i64)s.day);
    let total = days * 86400000000000 + temporal_time_total_ns(s);
    let rounded = temporal_round_i64(total, inc * unit_ns, mode);
    let out_days = i64_floordiv(rounded, 86400000000000);
    let tod = i64_floormod(rounded, 86400000000000);
    let out: i64[3];
    let op: i64* = NULL; raw { op = &out[0]; }
    iso_civil_from_days(out_days, op);
    let t = zjs_temporal_new(TMP_PLAIN_DATETIME);
    t.year = (i32)out[0]; t.month = (i32)out[1]; t.day = (i32)out[2];
    temporal_set_time_from_ns(t, tod);
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// --- ISO 8601 string parsing (Temporal from() string forms) --------
//
// One parser for the date-time-offset-timezone family; a separate one
// for ISO durations. Both fill caller structs and return ok via a
// field. Lenient on the parts a given type ignores (e.g. PlainDate
// accepts a full datetime and keeps the date).
struct TmpIso {
    ok:         int;
    has_date:   int;
    has_time:   int;
    has_offset: int;
    has_tz:     int;
    year: i64; month: i64; day: i64;
    hour: i64; minute: i64; second: i64;
    ms: i64; us: i64; ns: i64;
    offset_secs: i64;
    tz_off: u32; tz_len: u32;   // [Zone] annotation slice into src
}

// Parse "[+-]YYYY-MM-DD[(T| )HH:MM[:SS[.fff]]][Z|±HH:MM][[Zone]]" or a
// bare time "[T]HH:MM[:SS[.fff]]". Also "YYYY-MM" (year-month) and
// "--MM-DD" / "MM-DD" (month-day) shapes — caller picks the fields.
fn temporal_parse_iso(src: char*, len: u32, p: TmpIso*) -> void {
    p.ok = 0; p.has_date = 0; p.has_time = 0; p.has_offset = 0; p.has_tz = 0;
    p.year = 0; p.month = 1; p.day = 1;
    p.hour = 0; p.minute = 0; p.second = 0; p.ms = 0; p.us = 0; p.ns = 0;
    p.offset_secs = 0; p.tz_off = 0; p.tz_len = 0;
    raw {
        const char* s = src;
        uint32_t i = 0, n = len;
        // skip leading whitespace
        while (i < n && (s[i]==' '||s[i]=='\t')) i++;
        int64_t Y=0, Mo=1, D=1, H=0, Mi=0, S=0, frac_ns=0;
        int has_date=0, has_time=0, has_off=0, has_tz=0;
        int64_t off=0;
        uint32_t tzo=0, tzl=0;

        // month-day "--MM-DD"
        if (i+1 < n && s[i]=='-' && s[i+1]=='-') {
            i += 2;
            if (i+1 < n && isdigit((unsigned char)s[i]) && isdigit((unsigned char)s[i+1])) {
                Mo = (s[i]-'0')*10 + (s[i+1]-'0'); i += 2;
                if (i < n && s[i]=='-') i++;
                if (i+1 < n && isdigit((unsigned char)s[i]) && isdigit((unsigned char)s[i+1])) {
                    D = (s[i]-'0')*10 + (s[i+1]-'0'); i += 2;
                    has_date = 1;
                }
            }
            p->ok = has_date; p->has_date = has_date;
            p->year=1972; p->month=Mo; p->day=D;
            goto done;
        }

        // Leading bare time? "T..." or "HH:MM..."
        int bare_time = 0;
        if (i < n && (s[i]=='T'||s[i]=='t')) { bare_time = 1; i++; }
        else {
            // peek: digits then ':' within first 3 chars → time
            if (i+2 < n && isdigit((unsigned char)s[i]) && isdigit((unsigned char)s[i+1]) && s[i+2]==':')
                bare_time = 1;
        }

        if (!bare_time) {
            // DATE: optional sign + year digits
            int ysign = 1;
            if (i < n && (s[i]=='+'||s[i]=='-')) { if (s[i]=='-') ysign=-1; i++; }
            int yd = 0; int64_t yv = 0;
            while (i < n && isdigit((unsigned char)s[i])) { yv = yv*10 + (s[i]-'0'); i++; yd++; }
            if (yd < 4) { p->ok = 0; goto done; }
            Y = ysign * yv;
            if (i < n && s[i]=='-') i++;
            // month
            if (!(i+1 < n && isdigit((unsigned char)s[i]) && isdigit((unsigned char)s[i+1]))) { p->ok=0; goto done; }
            Mo = (s[i]-'0')*10 + (s[i+1]-'0'); i += 2;
            has_date = 1;
            // optional "-DD"
            if (i < n && s[i]=='-') {
                i++;
                if (i+1 < n && isdigit((unsigned char)s[i]) && isdigit((unsigned char)s[i+1])) {
                    D = (s[i]-'0')*10 + (s[i+1]-'0'); i += 2;
                }
            }
            // date-time separator
            if (i < n && (s[i]=='T'||s[i]=='t'||s[i]==' ')) { i++; bare_time = 1; }
        }

        if (bare_time && i+1 < n && isdigit((unsigned char)s[i])) {
            // TIME HH[:MM[:SS[.fff]]]
            H = (s[i]-'0')*10 + (s[i+1]-'0'); i += 2; has_time = 1;
            if (i < n && s[i]==':') {
                i++;
                if (i+1<n && isdigit((unsigned char)s[i])) { Mi=(s[i]-'0')*10+(s[i+1]-'0'); i+=2; }
                if (i < n && s[i]==':') {
                    i++;
                    if (i+1<n && isdigit((unsigned char)s[i])) { S=(s[i]-'0')*10+(s[i+1]-'0'); i+=2; }
                    if (i < n && (s[i]=='.'||s[i]==',')) {
                        i++;
                        int fd = 0; int64_t f = 0;
                        while (i < n && isdigit((unsigned char)s[i]) && fd < 9) { f = f*10 + (s[i]-'0'); i++; fd++; }
                        while (i < n && isdigit((unsigned char)s[i])) i++;   // drop excess
                        while (fd < 9) { f *= 10; fd++; }
                        frac_ns = f;
                    }
                }
            }
        }

        // OFFSET  Z | ±HH:MM | ±HHMM | ±HH
        if (i < n && (s[i]=='Z'||s[i]=='z')) { has_off=1; off=0; i++; }
        else if (i < n && (s[i]=='+'||s[i]=='-')) {
            int osign = (s[i]=='-') ? -1 : 1; i++;
            int64_t oh=0, om=0;
            if (i+1<n && isdigit((unsigned char)s[i])) { oh=(s[i]-'0')*10+(s[i+1]-'0'); i+=2; }
            if (i < n && s[i]==':') i++;
            if (i+1<n && isdigit((unsigned char)s[i])) { om=(s[i]-'0')*10+(s[i+1]-'0'); i+=2; }
            off = osign * (oh*3600 + om*60); has_off = 1;
        }

        // TIMEZONE annotation [Area/City]
        if (i < n && s[i]=='[') {
            i++;
            // skip a leading '!' (critical flag)
            if (i < n && s[i]=='!') i++;
            uint32_t start = i;
            while (i < n && s[i]!=']') i++;
            tzo = start; tzl = i - start;
            if (i < n && s[i]==']') i++;
            // ignore offset-form annotations like [+05:00] / [u-ca=...]
            if (tzl > 0 && (src[tzo]=='+'||src[tzo]=='-')) { tzl = 0; tzo = 0; }
            else if (tzl >= 5) {
                int eq = 0; for (uint32_t k=tzo; k<tzo+tzl; k++) if (src[k]=='=') { eq=1; break; }
                if (eq) { tzl = 0; tzo = 0; }
            }
            if (tzl > 0) has_tz = 1;
        }

        p->year=Y; p->month=Mo; p->day=D; p->hour=H; p->minute=Mi; p->second=S;
        p->ms = frac_ns/1000000; p->us=(frac_ns/1000)%1000; p->ns=frac_ns%1000;
        p->has_date=has_date; p->has_time=has_time; p->has_offset=has_off; p->has_tz=has_tz;
        p->offset_secs=off; p->tz_off=tzo; p->tz_len=tzl;
        p->ok = (has_date || has_time) ? 1 : 0;
done:;
    }
}

// Parse an ISO duration "[+-]P[nY][nM][nW][nD][T[nH][nM][n[.fff]S]]"
// into f[0..9] = years..nanoseconds. Returns ok (1/0).
fn temporal_parse_iso_duration(src: char*, len: u32, f: i64*) -> int {
    let i: u32 = 0;
    while i < 10 { f[i] = 0; i = i + 1; }
    let ok: int = 0;
    raw {
        const char* s = src; uint32_t n = len, k = 0;
        int sign = 1;
        if (k < n && (s[k]=='+'||s[k]=='-')) { if (s[k]=='-') sign=-1; k++; }
        if (k >= n || (s[k]!='P' && s[k]!='p')) { ok = 0; goto dend; }
        k++;
        int in_time = 0;
        int saw_any = 0;
        while (k < n) {
            if (s[k]=='T'||s[k]=='t') { in_time = 1; k++; continue; }
            if (!isdigit((unsigned char)s[k])) { ok = 0; goto dend; }
            int64_t val = 0; int fd = 0; int64_t frac = 0;
            while (k < n && isdigit((unsigned char)s[k])) { val = val*10 + (s[k]-'0'); k++; }
            if (k < n && (s[k]=='.'||s[k]==',')) {
                k++;
                while (k < n && isdigit((unsigned char)s[k]) && fd < 9) { frac = frac*10 + (s[k]-'0'); k++; fd++; }
                while (k < n && isdigit((unsigned char)s[k])) k++;
                while (fd < 9) { frac *= 10; fd++; }
            }
            if (k >= n) { ok = 0; goto dend; }
            char u = s[k]; k++;
            saw_any = 1;
            if (!in_time) {
                if (u=='Y'||u=='y') f[0]=val*sign;
                else if (u=='M'||u=='m') f[1]=val*sign;
                else if (u=='W'||u=='w') f[2]=val*sign;
                else if (u=='D'||u=='d') f[3]=val*sign;
                else { ok=0; goto dend; }
            } else {
                if (u=='H'||u=='h') f[4]=val*sign;
                else if (u=='M'||u=='m') f[5]=val*sign;
                else if (u=='S'||u=='s') {
                    f[6]=val*sign;
                    // fractional seconds → ms/us/ns
                    f[7]=(frac/1000000)*sign; f[8]=((frac/1000)%1000)*sign; f[9]=(frac%1000)*sign;
                } else { ok=0; goto dend; }
            }
        }
        ok = saw_any ? 1 : 0;
dend:;
    }
    return ok;
}

// Validate an ISO calendar date. ISO year range per spec: the date
// must be within ±(10^8 days) of the epoch, i.e. years -271821..275760.
fn temporal_date_valid(y: i64, m: i64, d: i64) -> bool {
    if m < 1 || m > 12 { return false; }
    if d < 1 || d > iso_days_in_month(y, m) { return false; }
    if y < -271821 || y > 275760 { return false; }
    return true;
}

// Read arg[idx] as an integer, default `dflt` if missing/undefined.
// Sets ok[0]=0 on a non-integral / non-finite value.
fn temporal_int_arg(args: ZjsValue*, argc: u32, idx: u32, dflt: i64, ok: int*) -> i64 {
    if idx >= argc { return dflt; }
    let v = args[idx];
    if zjs_is_undefined(v) != 0 { return dflt; }
    let d = zjs_to_double(v);
    let bad: int = 0;
    raw { bad = (!isfinite(d) || d != trunc(d)) ? 1 : 0; }
    if bad != 0 { ok[0] = 0; return dflt; }
    return (i64)d;
}

fn temporal_range_error(ctx: ZjsContext*, msg: char*, mlen: u32) -> ZjsValue {
    let err = build_typed_error(ctx, (char*)"RangeError", 10, msg, mlen);
    ctx.pending_throw_active = true; ctx.pending_throw_value = err;
    return zjs_undefined();
}

// Clamp a (possibly out-of-range) y/m/d to a valid ISO date
// (overflow:'constrain' — month into 1..12, day into 1..daysInMonth).
// Writes year/month/day into out[0..2].
fn temporal_constrain_date(y: i64, m: i64, d: i64, out: i64*) -> void {
    let cm = m;
    if cm < 1 { cm = 1; }
    if cm > 12 { cm = 12; }
    let dim = iso_days_in_month(y, cm);
    let cd = d;
    if cd < 1 { cd = 1; }
    if cd > dim { cd = dim; }
    out[0] = y; out[1] = cm; out[2] = cd;
}

// Add a calendar duration (years, months, weeks, days) to an ISO date,
// per CalendarDateAdd (overflow:'constrain'): apply years+months with
// day clamping, then weeks*7 + days. Writes y/m/d into out[0..2].
fn temporal_add_to_date(y: i64, m: i64, d: i64, dy: i64, dmo: i64, dw: i64, dd: i64, out: i64*) -> void {
    let fy: i64 = 0;
    let fm: i64 = 0;
    raw {
        int64_t ny = (int64_t)y + (int64_t)dy;
        int64_t total = ny * 12 + ((int64_t)m + (int64_t)dmo - 1);   // 0-based month index
        int64_t q = total >= 0 ? total / 12 : -(((-total) + 11) / 12); // floor div
        fy = q;
        fm = total - q * 12 + 1;                                      // 1..12
    }
    // Clamp the day to the (possibly shorter) target month, then add the
    // day-granularity part via epoch-day arithmetic.
    let dim = iso_days_in_month(fy, fm);
    let cd = if d > dim { dim } else { d };
    let days = iso_days_from_civil(fy, fm, cd) + dw * 7 + dd;
    iso_civil_from_days(days, out);
}

// One duration component off an object: undefined → 0, else the
// truncated integer value.
fn temporal_dur_field(ctx: ZjsContext*, v: ZjsValue, name: char*, len: u32) -> i64 {
    let pv = property_get(ctx, v, ctx_intern_string(ctx, name, len));
    if zjs_is_undefined(pv) != 0 { return 0; }
    let d = zjs_to_double(pv);
    let r: i64 = 0;
    raw { r = (isfinite(d)) ? (int64_t)d : 0; }
    return r;
}

// Read a Duration / duration-like into out[0..9] = years, months,
// weeks, days, hours, minutes, seconds, ms, us, ns. ok[0]=0 on a
// non-object / non-Duration argument (caller throws TypeError).
fn temporal_read_duration(ctx: ZjsContext*, v: ZjsValue, out: i64*, ok: int*) -> void {
    let i: u32 = 0;
    while i < 10 { out[i] = 0; i = i + 1; }
    if zjs_is_temporal_kind(v, TMP_DURATION) != 0 {
        let s = zjs_as_temporal(v);
        out[0] = s.d_years; out[1] = s.d_months; out[2] = s.d_weeks; out[3] = s.d_days;
        out[4] = s.d_hours; out[5] = s.d_minutes; out[6] = s.d_seconds;
        out[7] = s.d_ms; out[8] = s.d_us; out[9] = s.d_ns;
        return;
    }
    if zjs_is_object(v) != 0 {
        out[0] = temporal_dur_field(ctx, v, (char*)"years", 5);
        out[1] = temporal_dur_field(ctx, v, (char*)"months", 6);
        out[2] = temporal_dur_field(ctx, v, (char*)"weeks", 5);
        out[3] = temporal_dur_field(ctx, v, (char*)"days", 4);
        out[4] = temporal_dur_field(ctx, v, (char*)"hours", 5);
        out[5] = temporal_dur_field(ctx, v, (char*)"minutes", 7);
        out[6] = temporal_dur_field(ctx, v, (char*)"seconds", 7);
        out[7] = temporal_dur_field(ctx, v, (char*)"milliseconds", 12);
        out[8] = temporal_dur_field(ctx, v, (char*)"microseconds", 12);
        out[9] = temporal_dur_field(ctx, v, (char*)"nanoseconds", 11);
        return;
    }
    ok[0] = 0;
}

// total time-of-duration in nanoseconds (hours..ns), as i64.
fn temporal_duration_time_ns(f: i64*) -> i64 {
    let secs: i64 = (f[4] * 60 + f[5]) * 60 + f[6];
    let sub: i64 = f[7] * 1000000 + f[8] * 1000 + f[9];
    return secs * 1000000000 + sub;
}

// floor division for i64 (rounds toward -infinity).
fn i64_floordiv(a: i64, b: i64) -> i64 {
    let q: i64 = 0;
    raw { int64_t r = a % b; q = a / b; if ((r != 0) && ((r < 0) != (b < 0))) q -= 1; }
    return q;
}
fn i64_floormod(a: i64, b: i64) -> i64 {
    let r: i64 = 0;
    raw { r = a % b; if ((r != 0) && ((r < 0) != (b < 0))) r += b; }
    return r;
}

// Decompose a nanoseconds-of-day value in [0, 86400e9) into the time
// fields of `t`.
fn temporal_set_time_from_ns(t: ZjsTemporal*, ns_of_day: i64) -> void {
    let n = ns_of_day;
    t.nanosecond  = (i32)(n % 1000); n = n / 1000;
    t.microsecond = (i32)(n % 1000); n = n / 1000;
    t.millisecond = (i32)(n % 1000); n = n / 1000;   // n now = seconds of day
    t.second = (i32)(n % 60); n = n / 60;
    t.minute = (i32)(n % 60); n = n / 60;
    t.hour   = (i32)(n % 24);
}

// Negate all ten duration components in place (for subtract).
fn temporal_negate_dur(f: i64*) -> void {
    let i: u32 = 0;
    while i < 10 { f[i] = -f[i]; i = i + 1; }
}

// new Temporal.PlainDate(year, month, day [, calendar]).
fn host_temporal_plaindate_ctor(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let ok: int = 1;
    let y = temporal_int_arg(args, argc, 0, 0, &ok);
    let m = temporal_int_arg(args, argc, 1, 0, &ok);
    let d = temporal_int_arg(args, argc, 2, 0, &ok);
    if ok == 0 { return temporal_range_error(ctx, (char*)"PlainDate fields must be integers", 32); }
    if !temporal_date_valid(y, m, d) { return temporal_range_error(ctx, (char*)"invalid ISO date", 16); }
    let t = zjs_temporal_new(TMP_PLAIN_DATE);
    t.year = (i32)y; t.month = (i32)m; t.day = (i32)d;
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Temporal.PlainDate.from(item): a PlainDate/PlainDateTime (extract the
// date) or an object with year/month/day. (ISO-string parse is a
// follow-up.)
fn host_temporal_plaindate_from(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let v = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let p: TmpIso; let pp: TmpIso* = NULL; raw { pp = &p; }
        temporal_parse_iso(s.data, s.length, pp);
        if p.ok == 0 || p.has_date == 0 {
            return temporal_range_error(ctx, (char*)"invalid ISO 8601 date string", 28);
        }
        if !temporal_date_valid(p.year, p.month, p.day) {
            return temporal_range_error(ctx, (char*)"invalid ISO date", 16);
        }
        let t = zjs_temporal_new(TMP_PLAIN_DATE);
        t.year = (i32)p.year; t.month = (i32)p.month; t.day = (i32)p.day;
        t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
        ctx_register_cell(ctx, (void*)t);
        return zjs_cell_from_ptr((void*)t);
    }
    if zjs_is_temporal(v) != 0 {
        let s = zjs_as_temporal(v);
        if s.kind == TMP_PLAIN_DATE || s.kind == TMP_PLAIN_DATETIME {
            let t = zjs_temporal_new(TMP_PLAIN_DATE);
            t.year = s.year; t.month = s.month; t.day = s.day;
            t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
            ctx_register_cell(ctx, (void*)t);
            return zjs_cell_from_ptr((void*)t);
        }
    }
    if zjs_is_object(v) != 0 {
        let argbuf: ZjsValue[3];
        argbuf[0] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"year", 4));
        argbuf[1] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"month", 5));
        argbuf[2] = property_get(ctx, v, ctx_intern_string(ctx, (char*)"day", 3));
        if zjs_is_undefined(argbuf[0]) != 0 || zjs_is_undefined(argbuf[1]) != 0 || zjs_is_undefined(argbuf[2]) != 0 {
            return temporal_range_error(ctx, (char*)"PlainDate.from needs year, month, day", 37);
        }
        let ap: ZjsValue* = NULL; raw { ap = &argbuf[0]; }
        return host_temporal_plaindate_ctor(ctx, ap, 3);
    }
    let err = build_typed_error(ctx, (char*)"TypeError", 9,
        (char*)"Temporal.PlainDate.from expects a date or object", 48);
    ctx.pending_throw_active = true; ctx.pending_throw_value = err;
    return zjs_undefined();
}

fn host_temporal_plaindate_to_string(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let _u = args; let _u2 = argc;
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATE) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainDate", 24);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let t = zjs_as_temporal(this_v);
    let buf: char[32];
    raw {
        // ECMA: years outside 0..9999 use a signed 6-digit form.
        if (t->year < 0 || t->year > 9999)
            snprintf(buf, sizeof(buf), "%+07d-%02d-%02d", (int)t->year, (int)t->month, (int)t->day);
        else
            snprintf(buf, sizeof(buf), "%04d-%02d-%02d", (int)t->year, (int)t->month, (int)t->day);
    }
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let n: u32 = 0; raw { n = (uint32_t)strlen(bp); }
    return ctx_intern_string(ctx, bp, n);
}

// Temporal.PlainDate.compare(a, b) → -1 / 0 / 1.
fn host_temporal_plaindate_compare(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let a = if argc >= 1 { args[0] } else { zjs_undefined() };
    let b = if argc >= 2 { args[1] } else { zjs_undefined() };
    if zjs_is_temporal_kind(a, TMP_PLAIN_DATE) == 0 || zjs_is_temporal_kind(b, TMP_PLAIN_DATE) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"compare expects two PlainDates", 30);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let ta = zjs_as_temporal(a); let tb = zjs_as_temporal(b);
    let da = iso_days_from_civil((i64)ta.year, (i64)ta.month, (i64)ta.day);
    let db = iso_days_from_civil((i64)tb.year, (i64)tb.month, (i64)tb.day);
    if da < db { return zjs_int32(-1); }
    if da > db { return zjs_int32(1); }
    return zjs_int32(0);
}

fn host_temporal_plaindate_equals(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    let other = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATE) == 0 { return zjs_bool(0); }
    if zjs_is_temporal_kind(other, TMP_PLAIN_DATE) == 0 { return zjs_bool(0); }
    let ta = zjs_as_temporal(this_v); let tb = zjs_as_temporal(other);
    let eq = ta.year == tb.year && ta.month == tb.month && ta.day == tb.day;
    return zjs_bool(if eq { 1 } else { 0 });
}

// Temporal.PlainDate.prototype.with({ year?, month?, day? }).
fn host_temporal_plaindate_with(ctx: ZjsContext*, args: ZjsValue*, argc: u32) -> ZjsValue {
    let this_v = ctx.host_this;
    if zjs_is_temporal_kind(this_v, TMP_PLAIN_DATE) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9, (char*)"not a Temporal.PlainDate", 24);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err;
        return zjs_undefined();
    }
    let s = zjs_as_temporal(this_v);
    let arg = if argc >= 1 { args[0] } else { zjs_undefined() };
    if zjs_is_object(arg) == 0 {
        return temporal_range_error(ctx, (char*)"with() expects an object", 24);
    }
    let yv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"year", 4));
    let mv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"month", 5));
    let dv = property_get(ctx, arg, ctx_intern_string(ctx, (char*)"day", 3));
    let y: i64 = if zjs_is_undefined(yv) != 0 { (i64)s.year }  else { (i64)zjs_to_double(yv) };
    let m: i64 = if zjs_is_undefined(mv) != 0 { (i64)s.month } else { (i64)zjs_to_double(mv) };
    let d: i64 = if zjs_is_undefined(dv) != 0 { (i64)s.day }   else { (i64)zjs_to_double(dv) };
    // overflow:'constrain' (the default): clamp into a valid date.
    let cc: i64[3];
    let cp: i64* = NULL; raw { cp = &cc[0]; }
    temporal_constrain_date(y, m, d, cp);
    if !temporal_date_valid(cc[0], cc[1], cc[2]) { return temporal_range_error(ctx, (char*)"invalid ISO date", 16); }
    let t = zjs_temporal_new(TMP_PLAIN_DATE);
    t.year = (i32)cc[0]; t.month = (i32)cc[1]; t.day = (i32)cc[2];
    t.calendar = zjs_as_string(ctx_intern_string(ctx, (char*)"iso8601", 7));
    ctx_register_cell(ctx, (void*)t);
    return zjs_cell_from_ptr((void*)t);
}

// Validate ISO wall-clock time components.
fn temporal_time_valid(h: i64, mi: i64, s: i64, ms: i64, us: i64, ns: i64) -> bool {
    if h < 0 || h > 23 { return false; }
    if mi < 0 || mi > 59 { return false; }
    if s < 0 || s > 59 { return false; }   // no leap seconds in Temporal
    if ms < 0 || ms > 999 { return false; }
    if us < 0 || us > 999 { return false; }
    if ns < 0 || ns > 999 { return false; }
    return true;
}

// Total nanoseconds-of-day for a time (used by compare).
fn temporal_time_total_ns(t: ZjsTemporal*) -> i64 {
    let secs: i64 = ((i64)t.hour * 60 + (i64)t.minute) * 60 + (i64)t.second;
    let sub: i64 = (i64)t.millisecond * 1000000 + (i64)t.microsecond * 1000 + (i64)t.nanosecond;
    return secs * 1000000000 + sub;
}

// Append "HH:MM:SS[.fraction]" for a time into buf (caller sized).
fn temporal_time_to_buf(t: ZjsTemporal*, buf: char*, cap: usize) -> void {
    raw {
        int sub = (int)t->millisecond * 1000000 + (int)t->microsecond * 1000 + (int)t->nanosecond;
        if (sub == 0) {
            snprintf(buf, cap, "%02d:%02d:%02d", (int)t->hour, (int)t->minute, (int)t->second);
        } else {
            char fbuf[10];
            snprintf(fbuf, sizeof(fbuf), "%09d", sub);
            // 'auto' precision: trim trailing zeros (no 3/6/9 grouping).
            int flen = 9;
            while (flen > 1 && fbuf[flen-1] == '0') flen--;
            snprintf(buf, cap, "%02d:%02d:%02d.%.*s",
                     (int)t->hour, (int)t->minute, (int)t->second, flen, fbuf);
        }
    }
}

// new Temporal.PlainTime([hour[, minute[, second[, ms[, us[, ns]]]]]]).
