    // sources).
    // Reuse the SAME host-function cell installed on Array.prototype
    // so the fast-path identity check in iter_get matches strings too.
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"@@iterator", 10),
               ctx.array_iter_host_fn);
    ctx.string_proto = string_proto;
    object_set(ctx, string_proto, ctx_intern_atom(ctx, (char*)"constructor", 11), strv_full);
    // Unify with the String constructor's .prototype so
    // `new String(x).slice(...)` reaches the same methods as a
    // primitive string's `.slice(...)`.
    strv_hf.prototype = string_proto;
    // Re-attach valueOf/toString (the host_wrapper_* funcs) onto the
    // unified prototype.
    object_set(ctx, string_proto, valueof_atom,
               ctx_make_host_function(ctx, (char*)"valueOf",  wv_ptr));
    object_set(ctx, string_proto, tostring_atom,
               ctx_make_host_function(ctx, (char*)"toString", wt_ptr));

    // --- JSON namespace (Phase 3.5b) ---
    let json_v = ctx_new_object(ctx);
    let json_o = zjs_as_object(json_v);
    object_set(ctx, json_o, ctx_intern_atom(ctx, TAG_NAME_KEY, TAG_NAME_KEY_LEN),
