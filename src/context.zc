    object_set(ctx, ctx.temporal_yearmonth_proto, ctx_intern_atom(ctx, (char*)"add", 3),
               ctx_make_host_function(ctx, (char*)"add", ymadd_ptr));
    object_set(ctx, ctx.temporal_yearmonth_proto, ctx_intern_atom(ctx, (char*)"subtract", 8),
