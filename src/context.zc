            (char*)"ZonedDateTime requires a BigInt epochNanoseconds", 48);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    if zjs_is_string(tzv) == 0 {
        let err = build_typed_error(ctx, (char*)"TypeError", 9,
            (char*)"ZonedDateTime requires a time zone identifier", 45);
        ctx.pending_throw_active = true; ctx.pending_throw_value = err; return zjs_undefined();
    }
    let t = zjs_temporal_new(TMP_ZONED_DATETIME);
    t.epoch_ns = nv;
