            char fb[10]; snprintf(fb, sizeof(fb), "%09lld", (long long)f[6]);
            int fl = 9; while (fl > 1 && fb[fl-1] == '0') fl--;
            base += snprintf(buf + base, sizeof(buf) - base, ".%.*s", fl, fb);
        }
        base += snprintf(buf + base, sizeof(buf) - base, "%s[%.*s]", offbuf, (int)tzn, tzd);
    }
    let bp: char* = NULL; raw { bp = &buf[0]; }
    let n: u32 = 0; raw { n = (uint32_t)strlen(bp); }
    return ctx_intern_string(ctx, bp, n);
}

