    // Full transcendental + hyperbolic set delegated to libm.
    let sin_ptr:    void* = NULL; raw { sin_ptr    = (void*)host_math_sin; }
    let cos_ptr:    void* = NULL; raw { cos_ptr    = (void*)host_math_cos; }
    let tan_ptr:    void* = NULL; raw { tan_ptr    = (void*)host_math_tan; }
    let asin_ptr:   void* = NULL; raw { asin_ptr   = (void*)host_math_asin; }
    let acos_ptr:   void* = NULL; raw { acos_ptr   = (void*)host_math_acos; }
    let atan_ptr:   void* = NULL; raw { atan_ptr   = (void*)host_math_atan; }
    let atan2_ptr:  void* = NULL; raw { atan2_ptr  = (void*)host_math_atan2; }
    let exp_ptr:    void* = NULL; raw { exp_ptr    = (void*)host_math_exp; }
    let mlog_ptr:   void* = NULL; raw { mlog_ptr   = (void*)host_math_log; }
    let log2_ptr:   void* = NULL; raw { log2_ptr   = (void*)host_math_log2; }
    let log10_ptr:  void* = NULL; raw { log10_ptr  = (void*)host_math_log10; }
    let log1p_ptr:  void* = NULL; raw { log1p_ptr  = (void*)host_math_log1p; }
    let expm1_ptr:  void* = NULL; raw { expm1_ptr  = (void*)host_math_expm1; }
    let sinh_ptr:   void* = NULL; raw { sinh_ptr   = (void*)host_math_sinh; }
    let cosh_ptr:   void* = NULL; raw { cosh_ptr   = (void*)host_math_cosh; }
    let tanh_ptr:   void* = NULL; raw { tanh_ptr   = (void*)host_math_tanh; }
    let asinh_ptr:  void* = NULL; raw { asinh_ptr  = (void*)host_math_asinh; }
