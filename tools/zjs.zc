// zjs CLI — a thin embedder for libzjs plus dev helpers.
//
// Subcommands:
//   --version              print the engine version
//   eval <source>          evaluate source, print the result value
//   lex <source>           tokenize source, dump the token stream
//   parse <source>         parse source, dump the AST as an indented tree

// Platform-native networking (NSURLSession on Apple; WinHTTP on
// Windows; libcurl + libwebsockets on Linux; stub elsewhere) plus the
// portability shims must be linked into the CLI binary too, since the
// CLI is its own `zc build` entry point — directives don't propagate
// via import.
//> macos: framework: Foundation
//> macos: framework: Security
//> macos: cflags:    -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m src/platform/socket_posix.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c src/third-party/aes-gcm/aes_gcm.c
//> ios:   framework: Foundation
//> ios:   framework: Security
//> ios:   cflags:    -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m src/platform/socket_posix.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c src/third-party/aes-gcm/aes_gcm.c
//> linux: cflags:    -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE src/platform/http_linux.c src/platform/ws_linux.c src/platform/http_async.c src/platform/socket_posix.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c
//> linux: link:      -lcurl -lwebsockets
//> windows: cflags:  -Isrc -Isrc/third-party/qjs-regex -DCONFIG_ALL_UNICODE src/platform/http_windows.c src/platform/ws_windows.c src/platform/qjs_regex_shim.c src/third-party/qjs-regex/libregexp.c src/third-party/qjs-regex/libunicode.c
//> windows: link:    -lbcrypt -lpsapi -lwinhttp

import "../src/lib.zc";
import "string.h" as libc_str;
import "std/mem.zc"

raw {
    #include <stdio.h>
    #include <string.h>
    #include <time.h>
    #include <signal.h>
    #include "../src/platform/portability.h"
    #ifdef __APPLE__
    // Avoid including any CoreFoundation header — MacTypes.h's
    // `Duration` typedef collides with zen-c's std/time Duration
    // struct. Forward-declare exactly what we need from CFRunLoop:
    // CFRunLoopRunInMode + kCFRunLoopDefaultMode. Linker resolves
    // them out of CoreFoundation.framework, which is already linked
    // transitively via Foundation.
    typedef const struct __CFString* CFStringRef;
    typedef double CFTimeInterval;
    typedef unsigned char Boolean;
    typedef int32_t SInt32;
    extern const CFStringRef kCFRunLoopDefaultMode;
    extern SInt32 CFRunLoopRunInMode(CFStringRef mode,
                                     CFTimeInterval seconds,
                                     Boolean returnAfterSourceHandled);
    #endif

    // Shutdown flag — set by SIGINT / SIGTERM handler, polled by the
    // event-loop driver. sig_atomic_t is the only type the C standard
    // guarantees can be safely written from a signal handler and read
    // from the main flow without a memory barrier.
    static volatile sig_atomic_t g_shutdown_requested = 0;

    static void zjs_cli_sig_handler(int sig) {
        (void)sig;
        g_shutdown_requested = 1;
    }
}

// Wait `ms` milliseconds while letting platform-level dispatch
// queues drain. On Apple this MUST run a CFRunLoop step — NSURLSession's
// async completion handler is dispatched through that runloop, and
// without a tick here the engine never sees fetch() responses arrive.
// Linux/Windows keep nanosleep — their backends (libcurl/WinHTTP) use
// a worker pthread and have no main-runloop dependency.
fn event_loop_wait(ms: i64) -> void {
    raw {
        #ifdef __APPLE__
            double secs = (double)ms / 1000.0;
            CFRunLoopRunInMode(kCFRunLoopDefaultMode, secs, true);
        #else
            struct timespec _ts;
            _ts.tv_sec  = (time_t)(ms / 1000);
            _ts.tv_nsec = (long)((ms % 1000) * 1000000);
            nanosleep(&_ts, NULL);
        #endif
    }
}

// Install SIGINT + SIGTERM handlers so Ctrl-C and `kill <pid>` set
// the shutdown flag instead of hard-killing the process mid-fetch.
// Called once at CLI startup.
fn install_signal_handlers() -> void {
    raw {
        struct sigaction sa;
        memset(&sa, 0, sizeof(sa));
        sa.sa_handler = zjs_cli_sig_handler;
        sigemptyset(&sa.sa_mask);
        sa.sa_flags = SA_RESTART;
        sigaction(SIGINT,  &sa, NULL);
        sigaction(SIGTERM, &sa, NULL);
    }
}

fn shutdown_requested() -> bool {
    let r: int = 0;
    raw { r = (int)g_shutdown_requested; }
    return r != 0;
}

// Single event-loop driver — used by every CLI subcommand that needs
// to pump async work after the top-level body returns. Replaces three
// near-duplicate copies (run, eval, module run).
//
//   max_wall_ms < 0  → run until no more pending work (daemon shape).
//                      The right choice for `run` / `module run` —
//                      an HTTP server or WebSocket app should keep
//                      ticking forever, exiting only on Ctrl-C / error.
//   max_wall_ms >= 0 → bounded; useful for `eval` where the user
//                      typed a one-shot and we don't want to hang
//                      on a stray setInterval.
//
// Returns 0 on clean drain, 1 if shutdown was requested via SIGINT/TERM.
fn run_event_loop(ctx: ZjsContext*, max_wall_ms: i64) -> int {
    let wall_so_far: i64 = 0;
    while zjs_has_pending_work(ctx) != 0 {
        if shutdown_requested() { return 1; }
        if max_wall_ms >= 0 && wall_so_far >= max_wall_ms { break; }
        let wait_ms = zjs_next_timer_ms(ctx);
        if wait_ms < 0 || wait_ms > 50 { wait_ms = 50; }
        if wait_ms > 0 {
            event_loop_wait(wait_ms);
            wall_so_far = wall_so_far + wait_ms;
        }
        zjs_run_pending_timers(ctx);
        if zjs_had_error(ctx) != 0 { break; }
    }
    return 0;
}

// =====================================================================
// Token-kind label table — used by `lex`.
// =====================================================================

fn tk_label(k: TokenKind) -> char* {
    match k {
        TokenKind::Eof => { return (char*)"Eof"; },
        TokenKind::Invalid => { return (char*)"Invalid"; },
        TokenKind::Identifier => { return (char*)"Identifier"; },
        TokenKind::NumberLit => { return (char*)"NumberLit"; },
        TokenKind::StringLit => { return (char*)"StringLit"; },
        TokenKind::KwVar => { return (char*)"KwVar"; },
        TokenKind::KwLet => { return (char*)"KwLet"; },
        TokenKind::KwConst => { return (char*)"KwConst"; },
        TokenKind::KwFunction => { return (char*)"KwFunction"; },
        TokenKind::KwReturn => { return (char*)"KwReturn"; },
        TokenKind::KwIf => { return (char*)"KwIf"; },
        TokenKind::KwElse => { return (char*)"KwElse"; },
        TokenKind::KwFor => { return (char*)"KwFor"; },
        TokenKind::KwWhile => { return (char*)"KwWhile"; },
        TokenKind::KwDo => { return (char*)"KwDo"; },
        TokenKind::KwBreak => { return (char*)"KwBreak"; },
        TokenKind::KwContinue => { return (char*)"KwContinue"; },
        TokenKind::KwClass => { return (char*)"KwClass"; },
        TokenKind::KwExtends => { return (char*)"KwExtends"; },
        TokenKind::KwSuper => { return (char*)"KwSuper"; },
        TokenKind::KwNew => { return (char*)"KwNew"; },
        TokenKind::KwThis => { return (char*)"KwThis"; },
        TokenKind::KwTrue => { return (char*)"KwTrue"; },
        TokenKind::KwFalse => { return (char*)"KwFalse"; },
        TokenKind::KwNull => { return (char*)"KwNull"; },
        TokenKind::KwUndefined => { return (char*)"KwUndefined"; },
        TokenKind::KwTypeof => { return (char*)"KwTypeof"; },
        TokenKind::KwDelete => { return (char*)"KwDelete"; },
        TokenKind::KwVoid => { return (char*)"KwVoid"; },
        TokenKind::KwIn => { return (char*)"KwIn"; },
        TokenKind::KwOf => { return (char*)"KwOf"; },
        TokenKind::KwInstanceof => { return (char*)"KwInstanceof"; },
        TokenKind::KwThrow => { return (char*)"KwThrow"; },
        TokenKind::KwTry => { return (char*)"KwTry"; },
        TokenKind::KwCatch => { return (char*)"KwCatch"; },
        TokenKind::KwFinally => { return (char*)"KwFinally"; },
        TokenKind::KwSwitch => { return (char*)"KwSwitch"; },
        TokenKind::KwCase => { return (char*)"KwCase"; },
        TokenKind::KwDefault => { return (char*)"KwDefault"; },
        TokenKind::KwAsync => { return (char*)"KwAsync"; },
        TokenKind::KwAwait => { return (char*)"KwAwait"; },
        TokenKind::KwYield => { return (char*)"KwYield"; },
        TokenKind::KwImport => { return (char*)"KwImport"; },
        TokenKind::KwExport => { return (char*)"KwExport"; },
        TokenKind::KwFrom => { return (char*)"KwFrom"; },
        TokenKind::KwAs => { return (char*)"KwAs"; },
        TokenKind::LParen => { return (char*)"LParen"; },
        TokenKind::RParen => { return (char*)"RParen"; },
        TokenKind::LBracket => { return (char*)"LBracket"; },
        TokenKind::RBracket => { return (char*)"RBracket"; },
        TokenKind::LBrace => { return (char*)"LBrace"; },
        TokenKind::RBrace => { return (char*)"RBrace"; },
        TokenKind::Comma => { return (char*)"Comma"; },
        TokenKind::Semicolon => { return (char*)"Semicolon"; },
        TokenKind::Colon => { return (char*)"Colon"; },
        TokenKind::Dot => { return (char*)"Dot"; },
        TokenKind::Ellipsis => { return (char*)"Ellipsis"; },
        TokenKind::Arrow => { return (char*)"Arrow"; },
        TokenKind::Tilde => { return (char*)"Tilde"; },
        TokenKind::Question => { return (char*)"Question"; },
        TokenKind::QuestionDot => { return (char*)"QuestionDot"; },
        TokenKind::QuestionQuestion => { return (char*)"QuestionQuestion"; },
        TokenKind::QuestionQuestionEq => { return (char*)"QuestionQuestionEq"; },
        TokenKind::Bang => { return (char*)"Bang"; },
        TokenKind::BangEq => { return (char*)"BangEq"; },
        TokenKind::BangEqEq => { return (char*)"BangEqEq"; },
        TokenKind::Eq => { return (char*)"Eq"; },
        TokenKind::EqEq => { return (char*)"EqEq"; },
        TokenKind::EqEqEq => { return (char*)"EqEqEq"; },
        TokenKind::Lt => { return (char*)"Lt"; },
        TokenKind::LtEq => { return (char*)"LtEq"; },
        TokenKind::LtLt => { return (char*)"LtLt"; },
        TokenKind::LtLtEq => { return (char*)"LtLtEq"; },
        TokenKind::Gt => { return (char*)"Gt"; },
        TokenKind::GtEq => { return (char*)"GtEq"; },
        TokenKind::GtGt => { return (char*)"GtGt"; },
        TokenKind::GtGtEq => { return (char*)"GtGtEq"; },
        TokenKind::GtGtGt => { return (char*)"GtGtGt"; },
        TokenKind::GtGtGtEq => { return (char*)"GtGtGtEq"; },
        TokenKind::Plus => { return (char*)"Plus"; },
        TokenKind::PlusEq => { return (char*)"PlusEq"; },
        TokenKind::PlusPlus => { return (char*)"PlusPlus"; },
        TokenKind::Minus => { return (char*)"Minus"; },
        TokenKind::MinusEq => { return (char*)"MinusEq"; },
        TokenKind::MinusMinus => { return (char*)"MinusMinus"; },
        TokenKind::Star => { return (char*)"Star"; },
        TokenKind::StarEq => { return (char*)"StarEq"; },
        TokenKind::StarStar => { return (char*)"StarStar"; },
        TokenKind::StarStarEq => { return (char*)"StarStarEq"; },
        TokenKind::Slash => { return (char*)"Slash"; },
        TokenKind::SlashEq => { return (char*)"SlashEq"; },
        TokenKind::Percent => { return (char*)"Percent"; },
        TokenKind::PercentEq => { return (char*)"PercentEq"; },
        TokenKind::Amp => { return (char*)"Amp"; },
        TokenKind::AmpAmp => { return (char*)"AmpAmp"; },
        TokenKind::AmpEq => { return (char*)"AmpEq"; },
        TokenKind::AmpAmpEq => { return (char*)"AmpAmpEq"; },
        TokenKind::Pipe => { return (char*)"Pipe"; },
        TokenKind::PipePipe => { return (char*)"PipePipe"; },
        TokenKind::PipeEq => { return (char*)"PipeEq"; },
        TokenKind::PipePipeEq => { return (char*)"PipePipeEq"; },
        TokenKind::Caret => { return (char*)"Caret"; },
        TokenKind::CaretEq => { return (char*)"CaretEq"; },
    }
    return (char*)"?";
}

fn nk_label(k: NodeKind) -> char* {
    match k {
        NodeKind::Program          => { return (char*)"Program"; },
        NodeKind::NumberExpr       => { return (char*)"NumberExpr"; },
        NodeKind::StringExpr       => { return (char*)"StringExpr"; },
        NodeKind::BoolExpr         => { return (char*)"BoolExpr"; },
        NodeKind::NullExpr         => { return (char*)"NullExpr"; },
        NodeKind::UndefinedExpr    => { return (char*)"UndefinedExpr"; },
        NodeKind::ThisExpr         => { return (char*)"ThisExpr"; },
        NodeKind::IdentExpr        => { return (char*)"IdentExpr"; },
        NodeKind::Binary           => { return (char*)"Binary"; },
        NodeKind::Logical          => { return (char*)"Logical"; },
        NodeKind::Unary            => { return (char*)"Unary"; },
        NodeKind::Postfix          => { return (char*)"Postfix"; },
        NodeKind::Conditional      => { return (char*)"Conditional"; },
        NodeKind::Assignment       => { return (char*)"Assignment"; },
        NodeKind::Call             => { return (char*)"Call"; },
        NodeKind::OptionalCall     => { return (char*)"OptionalCall"; },
        NodeKind::New              => { return (char*)"New"; },
        NodeKind::Member           => { return (char*)"Member"; },
        NodeKind::OptionalMember   => { return (char*)"OptionalMember"; },
        NodeKind::Computed         => { return (char*)"Computed"; },
        NodeKind::OptionalComputed => { return (char*)"OptionalComputed"; },
        NodeKind::Sequence         => { return (char*)"Sequence"; },
        NodeKind::Array            => { return (char*)"Array"; },
        NodeKind::Object           => { return (char*)"Object"; },
        NodeKind::ObjectProp       => { return (char*)"ObjectProp"; },
        NodeKind::Paren            => { return (char*)"Paren"; },
        NodeKind::BlockStmt        => { return (char*)"BlockStmt"; },
        NodeKind::VarDecl          => { return (char*)"VarDecl"; },
        NodeKind::Declarator       => { return (char*)"Declarator"; },
        NodeKind::IfStmt           => { return (char*)"IfStmt"; },
        NodeKind::ReturnStmt       => { return (char*)"ReturnStmt"; },
        NodeKind::WhileStmt        => { return (char*)"WhileStmt"; },
        NodeKind::DoWhileStmt      => { return (char*)"DoWhileStmt"; },
        NodeKind::ForStmt          => { return (char*)"ForStmt"; },
        NodeKind::BreakStmt        => { return (char*)"BreakStmt"; },
        NodeKind::ContinueStmt     => { return (char*)"ContinueStmt"; },
        NodeKind::EmptyStmt        => { return (char*)"EmptyStmt"; },
        NodeKind::FunctionDecl     => { return (char*)"FunctionDecl"; },
        NodeKind::FunctionExpr     => { return (char*)"FunctionExpr"; },
        NodeKind::ArrowFunc        => { return (char*)"ArrowFunc"; },
        NodeKind::ForInStmt        => { return (char*)"ForInStmt"; },
        NodeKind::ForOfStmt        => { return (char*)"ForOfStmt"; },
    }
    return (char*)"?";
}

// =====================================================================
// Subcommand bodies.
// =====================================================================

fn run_version() -> int {
    println "zjs {zjs_version()}";
    return 0;
}

// Recursive value printer. `quoted` controls whether top-level strings
// get surrounded by quotes — top-level eval results print without
// quotes (JS-shell style), but strings nested inside arrays/objects
// print with quotes for readability.
fn write_value(v: ZjsValue, quoted: bool) -> void {
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw { printf("%d", n); }
        return;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        raw {
            if (isnan(d)) { fputs("NaN", stdout); }
            else if (isinf(d)) { fputs(d > 0 ? "Infinity" : "-Infinity", stdout); }
            else { printf("%g", d); }
        }
        return;
    }
    if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { raw { fputs("true", stdout); } }
        else                   { raw { fputs("false", stdout); } }
        return;
    }
    if zjs_is_null(v) != 0      { raw { fputs("null", stdout); }      return; }
    if zjs_is_undefined(v) != 0 { raw { fputs("undefined", stdout); } return; }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let data = s.data;
        let len  = s.length;
        if quoted {
            raw { fputc('"', stdout); fwrite(data, 1, len, stdout); fputc('"', stdout); }
        } else {
            raw { fwrite(data, 1, len, stdout); }
        }
        return;
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        raw { fputc('[', stdout); }
        let i: u32 = 0;
        while i < a.length {
            if i > 0 { raw { fputs(", ", stdout); } }
            let slot = a.elements[i];
            // Array holes display as the empty position — print
            // nothing for the slot (the comma separator already
            // appears for non-leading positions).
            if zjs_is_deleted(slot) == 0 {
                write_value(slot, true);
            }
            i = i + 1;
        }
        raw { fputc(']', stdout); }
        return;
    }
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        raw { fputs("{ ", stdout); }
        // Hidden-class chain walks leaf->root, which yields reverse-
        // insertion order. Collect into a small stack array, then
        // iterate in reverse to print in insertion order.
        let names:  ZjsString*[32];
        let slots:  u32[32];
        let depth: u32 = 0;
        let c = o.cls;
        while c != NULL && c.parent != NULL && depth < 32 {
            names[depth] = c.transition_name;
            slots[depth] = c.transition_slot;
            depth = depth + 1;
            c = c.parent;
        }
        // Walk in reverse for insertion order.
        let count = depth;
        let i: u32 = 0;
        while i < count {
            let idx = count - 1 - i;
            if i > 0 { raw { fputs(", ", stdout); } }
            let name_data = names[idx].data;
            let name_len  = names[idx].length;
            raw { fwrite(name_data, 1, name_len, stdout); fputs(": ", stdout); }
            write_value(o.slots[slots[idx]], true);
            i = i + 1;
        }
        raw { fputs(" }", stdout); }
        return;
    }
    if zjs_is_function(v) != 0 { raw { fputs("[function]", stdout); } return; }
    if zjs_is_closure(v) != 0 { raw { fputs("[function]", stdout); } return; }
    if zjs_is_host_function(v) != 0 { raw { fputs("[function]", stdout); } return; }
    if zjs_is_promise(v) != 0 {
        let p = zjs_as_promise(v);
        if p.state == PROMISE_PENDING {
            raw { fputs("Promise { <pending> }", stdout); }
        } else if p.state == PROMISE_FULFILLED {
            raw { fputs("Promise { ", stdout); }
            write_value(p.value, true);
            raw { fputs(" }", stdout); }
        } else {
            raw { fputs("Promise { <rejected> ", stdout); }
            write_value(p.value, true);
            raw { fputs(" }", stdout); }
        }
        return;
    }
    raw { fputs("[unknown value]", stdout); }
}

fn print_value(v: ZjsValue) -> void {
    write_value(v, false);
    raw { fputc('\n', stdout); }
}

fn run_eval(source: char*) -> int {
    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 1; }
    defer zjs_free_context(ctx);
    let result = zjs_eval(ctx, source);
    print_value(result);

    // `eval` is a one-shot — 10 s wall cap is a safety net against a
    // stray setInterval running forever from a user one-liner.
    let _eval_loop_rc = run_event_loop(ctx, 10000);
    return 0;
}

// `zjs run <path>`: read the file, eval, exit 0 on no-throw / 1 on
// throw. Used by the test262 conformance runner — it only needs the
// throw/no-throw signal plus, on throw, a short diagnostic.
// Build [argv0, script_path, ...user_args] and install on process.argv
// before any JS body runs. Match Node's convention so consumer code
// that does `process.argv.slice(2)` Just Works.
raw {
    extern void zjs_set_process_argv(ZjsContext* ctx, uint32_t argc, char** argv);
}

fn install_process_argv(ctx: ZjsContext*, argv0: char*, script_path: char*,
                        user_argc: u32, user_argv: char**) -> void {
    let total: u32 = 2 + user_argc;
    let buf = alloc_n<char*>((usize)total);
    buf[0] = argv0;
    buf[1] = script_path;
    let i: u32 = 0;
    while i < user_argc {
        buf[2 + i] = user_argv[i];
        i = i + 1;
    }
    raw { zjs_set_process_argv(ctx, (uint32_t)total, buf); }
    dealloc(buf);
}

fn run_module_file_with_argv(path: char*, argv0: char*, user_argc: u32, user_argv: char**) -> int {
    // Resolve to an absolute path so relative imports in the module
    // body see a stable base. realpath() returns NULL when the file
    // doesn't exist; fall back to the literal path in that case so
    // we can still surface "module not found" via the loader.
    let abs_buf: char[4096];
    let abs_p: char* = NULL;
    raw {
        abs_p = zjs_realpath(path, &abs_buf[0]);
        if (!abs_p) abs_p = path;
    }
    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 2; }
    defer zjs_free_context(ctx);
    install_process_argv(ctx, argv0, abs_p, user_argc, user_argv);
    let _ = zjs_eval_module(ctx, abs_p);
    // Daemon shape: run until pending work is drained or Ctrl-C.
    // Long-running modules (HTTP servers, WebSocket apps) need no
    // wall-clock cap — that was a copy-paste from `eval` that broke
    // any module wanting to live past 10 seconds.
    let _loop_rc = run_event_loop(ctx, -1);
    if zjs_had_error(ctx) != 0 {
        let err = zjs_get_error(ctx);
        if zjs_is_object(err) != 0 {
            let o = zjs_as_object(err);
            let name_atom = zjs_string_new((char*)"name", 4);
            let msg_atom  = zjs_string_new((char*)"message", 7);
            let name_v = object_get(o, name_atom);
            let msg_v  = object_get(o, msg_atom);
            raw {
                fputs("zjs: throw: ", stderr);
                if (zjs_is_string(name_v)) {
                    ZjsString* s = zjs_as_string(name_v);
                    fwrite(s->data, 1, s->length, stderr);
                } else {
                    fputs("(unknown)", stderr);
                }
                if (zjs_is_string(msg_v)) {
                    fputs(": ", stderr);
                    ZjsString* s = zjs_as_string(msg_v);
                    fwrite(s->data, 1, s->length, stderr);
                }
                fputc('\n', stderr);
                free(name_atom->data); free(name_atom);
                free(msg_atom->data);  free(msg_atom);
            }
        }
        return 1;
    }
    return 0;
}

// Slurp a file's bytes into a fresh malloc'd buffer + return its
// length. `null_terminate` adds a trailing NUL when true (source
// path); leave it off for bytecode files so the length is precise.
fn slurp_file(path: char*, null_terminate: bool, out_len: usize*) -> char* {
    let fh: void* = NULL;
    raw { fh = (void*)fopen(path, "rb"); }
    if fh == NULL { return NULL; }
    let buf: char* = NULL;
    let len: usize = 0;
    raw {
        FILE* f = (FILE*)fh;
        fseek(f, 0, SEEK_END);
        long sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) sz = 0;
        len = (size_t)sz;
        size_t alloc = null_terminate ? len + 1 : (len > 0 ? len : 1);
        buf = (char*)malloc(alloc);
        if (buf) {
            if (len > 0) { fread(buf, 1, len, f); }
            if (null_terminate) { buf[len] = '\0'; }
        }
        fclose(f);
    }
    if buf == NULL { return NULL; }
    if out_len != NULL { out_len[0] = len; }
    return buf;
}

// "ZJSb" magic at the head of every AOT-compiled program file.
fn buf_is_bytecode(buf: char*, len: usize) -> bool {
    if buf == NULL || len < 8 { return false; }
    if (u8)buf[0] != (u8)'Z' { return false; }
    if (u8)buf[1] != (u8)'J' { return false; }
    if (u8)buf[2] != (u8)'S' { return false; }
    if (u8)buf[3] != (u8)'b' { return false; }
    return true;
}

fn report_uncaught_error(ctx: ZjsContext*) -> void {
    let err = zjs_get_error(ctx);
    if zjs_is_string(err) != 0 {
        let s = zjs_as_string(err);
        let sd = s.data;
        let sn = s.length;
        raw { fputs("zjs: throw: ", stderr); fwrite(sd, 1, sn, stderr); fputc('\n', stderr); }
        return;
    }
    if zjs_is_object(err) != 0 {
        let o = zjs_as_object(err);
        let name_atom = zjs_string_new((char*)"name", 4);
        let msg_atom  = zjs_string_new((char*)"message", 7);
        let name_v = object_get(o, name_atom);
        let msg_v  = object_get(o, msg_atom);
        raw {
            fputs("zjs: throw: ", stderr);
            if (zjs_is_string(name_v)) {
                ZjsString* s = zjs_as_string(name_v);
                fwrite(s->data, 1, s->length, stderr);
            } else {
                fputs("(unknown)", stderr);
            }
            if (zjs_is_string(msg_v)) {
                fputs(": ", stderr);
                ZjsString* s = zjs_as_string(msg_v);
                fwrite(s->data, 1, s->length, stderr);
            }
            fputc('\n', stderr);
            free(name_atom->data); free(name_atom);
            free(msg_atom->data);  free(msg_atom);
        }
        return;
    }
    raw { fputs("zjs: throw\n", stderr); }
}

fn run_file_with_argv(path: char*, gc_stats: bool,
                      argv0: char*, user_argc: u32, user_argv: char**) -> int {
    let len: usize = 0;
    let buf = slurp_file(path, true, &len);
    if buf == NULL { eprintln "zjs: cannot open file"; return 2; }
    defer dealloc(buf);

    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 2; }
    defer zjs_free_context(ctx);
    install_process_argv(ctx, argv0, path, user_argc, user_argv);

    // Auto-detect: AOT-compiled bytecode files start with the ZJSb
    // magic; everything else is treated as source. Lets `zjs run x.js`
    // and `zjs run x.zbc` share the same subcommand.
    let rc: int = 0;
    if buf_is_bytecode(buf, len) {
        let f = aot_deserialize_program(ctx, (u8*)buf, len);
        if f == NULL { eprintln "zjs: invalid bytecode file"; return 1; }
        let _ = zjs_run_function(ctx, f);
        if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); rc = 1; }
    } else {
        let _ = zjs_eval(ctx, buf);
        if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); rc = 1; }
    }

    // Daemon shape — pump until pending work drains or Ctrl-C arrives.
    let _run_loop_rc = run_event_loop(ctx, -1);
    if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); rc = 1; }

    if gc_stats {
        // One-shot dump after the script body + microtask drain. All
        // counters are cumulative across the run; live=cell_count is a
        // snapshot at this moment. peak_rss comes from getrusage
        // ru_maxrss — macOS reports bytes, Linux reports kilobytes;
        // we normalize to megabytes for either platform.
        let n   = zjs_gc_collections(ctx);
        let tot = zjs_gc_pause_ns_total(ctx);
        let mx  = zjs_gc_pause_ns_max(ctx);
        let fr  = zjs_gc_cells_freed(ctx);
        let live = zjs_cell_count(ctx);
        raw {
            uint64_t rss_bytes = zjs_peak_rss_bytes();
            double rss_mb = (double)rss_bytes / (1024.0 * 1024.0);
            fprintf(stderr,
                "[gc] runs=%u  pause_total=%.2fms  pause_max=%.2fms"
                "  freed=%u  live=%u  peak_rss=%.1fMB\n",
                (unsigned)n,
                (double)tot / 1e6,
                (double)mx  / 1e6,
                (unsigned)fr,
                (unsigned)live,
                rss_mb);
        }
    }
    return rc;
}

// `zjs compile <in.js> -o <out.zbc>` — parse + compile source to a
// Function, serialize via the AOT writer, write bytes to disk. The
// resulting file is loadable via `zjs run <out.zbc>` and embeds via
// the zjs_eval_bytecode C ABI.
fn run_compile(in_path: char*, out_path: char*) -> int {
    let len: usize = 0;
    let buf = slurp_file(in_path, true, &len);
    if buf == NULL { eprintln "zjs: cannot open input"; return 2; }
    defer dealloc(buf);

    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 2; }
    defer zjs_free_context(ctx);

    let f = zjs_compile(ctx, buf);
    if f == NULL {
        if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); }
        return 1;
    }
    defer function_free(f);

    let w = aot_serialize_program(ctx, f);
    if w == NULL { eprintln "zjs: serialize failed"; return 1; }
    defer aot_writer_free(w);

    let fh: void* = NULL;
    raw { fh = (void*)fopen(out_path, "wb"); }
    if fh == NULL { eprintln "zjs: cannot open output"; return 2; }
    raw {
        FILE* outf = (FILE*)fh;
        fwrite(w->buf, 1, w->len, outf);
        fclose(outf);
    }
    return 0;
}

fn run_lex(source: char*) -> int {
    let len: usize = 0;
    raw { len = strlen(source); }
    let lex = Lexer::new(source, len);
    while true {
        let tok = lex.next_token();
        raw {
            fprintf(stdout, "%-12s  start=%-4u  length=%-4u  text=\"%.*s\"\n",
                    tk_label(tok.kind),
                    (unsigned)tok.start,
                    (unsigned)tok.length,
                    (int)tok.length,
                    source + tok.start);
        }
        if tok.kind == TokenKind::Eof { return 0; }
    }
    return 0;
}

// --- AST tree printer -----------------------------------------------

fn print_indent(depth: int) -> void {
    let i: int = 0;
    while i < depth {
        raw { fputs("  ", stdout); }
        i = i + 1;
    }
}

fn dump_ast(node: AstNode*, source: char*, depth: int) -> void {
    if node == NULL {
        print_indent(depth);
        raw { puts("(null)"); }
        return;
    }
    print_indent(depth);
    let label = nk_label(node.kind);
    // Pull fields into Zen-c locals before crossing into raw {} — raw
    // blocks are pure C and won't auto-deref `node->field`.
    let n_num         = node.num;
    let n_bool        = node.bool_value;
    let n_op_label    = tk_label(node.op);
    let n_start       = node.start;
    let n_end         = node.end;
    let n_name_start  = node.name_start;
    let n_name_length = node.name_length;

    if node.kind == NodeKind::NumberExpr {
        raw { fprintf(stdout, "%s %g\n", label, n_num); }
    } else if node.kind == NodeKind::BoolExpr {
        raw { fprintf(stdout, "%s %s\n", label, n_bool ? "true" : "false"); }
    } else if node.kind == NodeKind::IdentExpr || node.kind == NodeKind::StringExpr {
        raw {
            fprintf(stdout, "%s \"%.*s\"\n", label,
                    (int)(n_end - n_start),
                    source + n_start);
        }
    } else if node.kind == NodeKind::Binary || node.kind == NodeKind::Logical ||
              node.kind == NodeKind::Unary  || node.kind == NodeKind::Postfix ||
              node.kind == NodeKind::Assignment || node.kind == NodeKind::VarDecl {
        raw { fprintf(stdout, "%s op=%s\n", label, n_op_label); }
    } else if node.kind == NodeKind::Member || node.kind == NodeKind::OptionalMember ||
              node.kind == NodeKind::ObjectProp || node.kind == NodeKind::Declarator {
        raw {
            fprintf(stdout, "%s name=\"%.*s\"\n", label,
                    (int)n_name_length,
                    source + n_name_start);
        }
    } else if node.kind == NodeKind::FunctionDecl || node.kind == NodeKind::FunctionExpr {
        if n_name_length > 0 {
            raw {
                fprintf(stdout, "%s name=\"%.*s\"\n", label,
                        (int)n_name_length, source + n_name_start);
            }
        } else {
            raw { fprintf(stdout, "%s (anonymous)\n", label); }
        }
    } else {
        raw { fprintf(stdout, "%s\n", label); }
    }

    // Recurse into named children, then variadic.
    if node.left != NULL  { dump_ast(node.left,  source, depth + 1); }
    if node.right != NULL { dump_ast(node.right, source, depth + 1); }
    if node.third != NULL { dump_ast(node.third, source, depth + 1); }

    let i: u32 = 0;
    while i < node.children_count {
        dump_ast(node.children[i], source, depth + 1);
        i = i + 1;
    }
}

fn run_parse(source: char*) -> int {
    let len: usize = 0;
    raw { len = strlen(source); }
    let result = parse_program(source, len);
    if result.had_error {
        eprintln "zjs: parse error";
        parser_free_result(result);
        return 1;
    }
    dump_ast(result.root, source, 0);
    parser_free_result(result);
    return 0;
}

fn print_usage() -> int {
    eprintln "usage:";
    eprintln "  zjs --version";
    eprintln "  zjs eval <source>                evaluate source";
    eprintln "  zjs run  <file>                  run a .js source or .zbc bytecode file";
    eprintln "  zjs compile <in.js> -o <out.zbc> AOT-compile source to bytecode";
    eprintln "  zjs lex   <source>               dump the token stream";
    eprintln "  zjs parse <source>               dump the AST";
    eprintln "  zjs module <file>                run a file as an ES module";
    return 1;
}

// --- JIT bytecode bridge (J3b-2) -------------------------------------------
// Layout-matched mirror of the C JitInsn the stitcher consumes.
struct JitDesc {
    op:     char*;
    ra:     i32;
    rb:     i32;
    rc:     i32;
    imm:    i64;
    target: i32;
}
struct JitResult {
    ok:  int;        // 1 = JIT'd + ran; 0 = bailed (unsupported op / non-JIT build)
    val: ZjsValue;   // the function's return value when ok
}

// Top-level `let` compiles to globals, so a script-level loop is all
// global-table access (not JIT-able yet). Register-based locals only exist
// inside a function body — which the compiler stores as a function value in
// the enclosing constant pool. Dig out the first 0-arg inner function so
// `jit-check "(function(){ ...loop... })"` can JIT a real register-based body.
// Authoritative op name via symbolic comparison (the interpreter's name
// TABLE drifts from the enum past Mov; this can't). Debug aid for jit-check.
fn jit_op_name(op: Op) -> char* {
    if op == Op::LoadConst { return (char*)"LoadConst"; }
    if op == Op::LoadInt { return (char*)"LoadInt"; }
    if op == Op::LoadUndefined { return (char*)"LoadUndefined"; }
    if op == Op::LoadHole { return (char*)"LoadHole"; }
    if op == Op::ThrowIfHole { return (char*)"ThrowIfHole"; }
    if op == Op::Mov { return (char*)"Mov"; }
    if op == Op::DefineGlobal { return (char*)"DefineGlobal"; }
    if op == Op::LoadGlobal { return (char*)"LoadGlobal"; }
    if op == Op::StoreGlobal { return (char*)"StoreGlobal"; }
    if op == Op::Add { return (char*)"Add"; }
    if op == Op::Sub { return (char*)"Sub"; }
    if op == Op::Mul { return (char*)"Mul"; }
    if op == Op::AddImm { return (char*)"AddImm"; }
    if op == Op::SubImm { return (char*)"SubImm"; }
    if op == Op::CmpLt { return (char*)"CmpLt"; }
    if op == Op::CmpLtImm { return (char*)"CmpLtImm"; }
    if op == Op::CmpLeImm { return (char*)"CmpLeImm"; }
    if op == Op::Jmp { return (char*)"Jmp"; }
    if op == Op::JmpIfTrue { return (char*)"JmpIfTrue"; }
    if op == Op::JmpIfFalse { return (char*)"JmpIfFalse"; }
    if op == Op::JmpIfNotLt { return (char*)"JmpIfNotLt"; }
    if op == Op::JmpIfNotLtImm { return (char*)"JmpIfNotLtImm"; }
    if op == Op::JmpIfNotLeImm { return (char*)"JmpIfNotLeImm"; }
    if op == Op::Return { return (char*)"Return"; }
    return (char*)"?other";
}

fn jit_mono_ns() -> u64 {
    let ns: u64 = 0;
    raw {
        #include <time.h>
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        ns = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
    }
    return ns;
}

fn jit_find_inner_function(f: Function*) -> Function* {
    let i: u32 = 0;
    while i < f.const_count {
        let cv = f.constants[i];
        if zjs_is_function(cv) != 0 {
            let p: void* = zjs_cell_as_ptr(cv);
            let inner: Function* = NULL;
            raw { inner = (Function*)p; }
            if inner != NULL && inner.param_count == 0 { return inner; }
        }
        i = i + 1;
    }
    return NULL;
}

// JIT a Function* whose body uses only the value-FAITHFUL op subset
// (LoadInt / LoadConst / Mov / Return) — ops the current stencils reproduce
// exactly (load/copy boxed values). Any other op bails (ok=0) so the
// interpreter result always stands. Proves real-bytecode -> stencil -> frame-
// shared run -> correct result + the bail path. Arithmetic/loops (faithful
// NaN-box stencils) are the next step.
fn jit_try_run(ctx: ZjsContext*, f: Function*) -> JitResult {
    let res: JitResult;
    res.ok = 0;
    res.val = zjs_undefined();
    let n: u32 = (u32)f.code_len;
    if n == 0 || n > 250 { return res; }
    let descs = alloc_n<JitDesc>(256);
    let ret_reg: i32 = -1;
    let ok_all: bool = true;
    let i: u32 = 0;
    while i < n {
        let inst = f.code[i];
        // A fused 2-slot jump (below) pre-marks its offset-carrier slot as a
        // Nop; don't remap it as whatever op its bytes happen to encode.
        if descs[i].op != NULL {
            i = i + 1;
            continue;
        }
        descs[i].ra = (i32)inst.a;
        descs[i].rb = (i32)inst.b;
        descs[i].rc = (i32)inst.c;
        descs[i].imm = 0;
        descs[i].target = -1;
        if inst.op == Op::LoadInt {
            descs[i].op = (char*)"LoadConst";
            descs[i].imm = (i64)zjs_int32(inst_bc_i16(inst)).bits;
        } else if inst.op == Op::LoadConst {
            descs[i].op = (char*)"LoadConst";
            descs[i].imm = (i64)f.constants[(u32)inst_bc_u16(inst)].bits;
        } else if inst.op == Op::LoadUndefined {
            descs[i].op = (char*)"LoadConst";
            descs[i].imm = (i64)zjs_undefined().bits;
        } else if inst.op == Op::LoadNull {
            descs[i].op = (char*)"LoadConst";
            descs[i].imm = (i64)zjs_null().bits;
        } else if inst.op == Op::LoadTrue {
            descs[i].op = (char*)"LoadConst";
            descs[i].imm = (i64)zjs_bool(1).bits;
        } else if inst.op == Op::LoadFalse {
            descs[i].op = (char*)"LoadConst";
            descs[i].imm = (i64)zjs_bool(0).bits;
        } else if inst.op == Op::Mov {
            descs[i].op = (char*)"Mov";
        } else if inst.op == Op::LoadHole {
            descs[i].op = (char*)"LoadConst";
            descs[i].imm = (i64)zjs_deleted().bits;
        } else if inst.op == Op::ThrowIfHole {
            descs[i].op = (char*)"ThrowIfHole";
        } else if inst.op == Op::Add {
            descs[i].op = (char*)"Add";
        } else if inst.op == Op::Sub {
            descs[i].op = (char*)"Sub";
        } else if inst.op == Op::Mul {
            descs[i].op = (char*)"Mul";
        } else if inst.op == Op::LoadElem {
            descs[i].op = (char*)"LoadElem";
        } else if inst.op == Op::StoreElem {
            descs[i].op = (char*)"StoreElem";
        } else if inst.op == Op::LoadProp {
            descs[i].op = (char*)"LoadProp";
            let icp: i64 = 0;
            raw { icp = (int64_t)(intptr_t)&f->ics[(unsigned char)inst.c]; }
            descs[i].imm = icp;
        } else if inst.op == Op::StoreProp {
            descs[i].op = (char*)"StoreProp";
            let icp2: i64 = 0;
            raw { icp2 = (int64_t)(intptr_t)&f->ics[(unsigned char)inst.b]; }
            descs[i].imm = icp2;
        } else if inst.op == Op::Invoke {
            descs[i].op = (char*)"Invoke";
            descs[i].imm = (i64)(u32)inst.c;
        } else if inst.op == Op::LoadGlobal {
            descs[i].op = (char*)"LoadGlobal";
            descs[i].imm = (i64)inst_bc_u16(inst);
        } else if inst.op == Op::StoreGlobal || inst.op == Op::DefineGlobal {
            descs[i].op = (char*)"GlobalSet";
            descs[i].imm = (i64)inst_bc_u16(inst);
        } else if inst.op == Op::CmpLt {
            descs[i].op = (char*)"CmpLt";
        } else if inst.op == Op::AddImm {
            descs[i].op = (char*)"AddImm";
            // imm is an i8 in inst.c; the stencil consumes a BOXED int32.
            descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
        } else if inst.op == Op::SubImm {
            descs[i].op = (char*)"SubImm";
            descs[i].imm = (i64)zjs_int32((i32)(i8)inst.c).bits;
        } else if inst.op == Op::Jmp {
            // Unconditional. Interp: ip += off, then the bottom ip+=1 ⇒
            // target = i + off + 1.
            descs[i].op = (char*)"Jmp";
            descs[i].target = (i32)i + inst_bc_i16(inst) + 1;
        } else if inst.op == Op::JmpIfNotLt || inst.op == Op::JmpIfNotLe
               || inst.op == Op::JmpIfNotGt || inst.op == Op::JmpIfNotGe {
            // Register form: a=lhs reg, b=rhs reg; i16 offset in code[i+1].bc.
            // Same index math + Nop carrier as the Imm variant below.
            if i + 1 >= n { ok_all = false; i = n; }
            else {
                if inst.op == Op::JmpIfNotLt { descs[i].op = (char*)"JmpIfNotLt"; }
                else if inst.op == Op::JmpIfNotLe { descs[i].op = (char*)"JmpIfNotLe"; }
                else if inst.op == Op::JmpIfNotGt { descs[i].op = (char*)"JmpIfNotGt"; }
                else { descs[i].op = (char*)"JmpIfNotGe"; }
                descs[i].target = (i32)i + inst_bc_i16(f.code[i + 1]) + 2;
                descs[i + 1].op = (char*)"Nop";
                descs[i + 1].target = -1;
            }
        } else if inst.op == Op::JmpIfNotLtImm || inst.op == Op::JmpIfNotLeImm
               || inst.op == Op::JmpIfNotGtImm || inst.op == Op::JmpIfNotGeImm {
            // Fused 2-slot compare-branch. a=lhs reg, b=i8 imm; the i16 offset
            // lives in code[i+1].bc. Interp: continue (lt) ⇒ ip+=1 then +1 ⇒
            // i+2 (skips the carrier slot); exit ⇒ ip=ip+1+off then +1 ⇒
            // i+off+2. Mark the carrier slot Nop so CONTINUE (→i+1) passes
            // through to i+2, and point TARGET at the exit.
            if i + 1 >= n { ok_all = false; i = n; }
            else {
                if inst.op == Op::JmpIfNotLtImm { descs[i].op = (char*)"JmpIfNotLtImm"; }
                else if inst.op == Op::JmpIfNotLeImm { descs[i].op = (char*)"JmpIfNotLeImm"; }
                else if inst.op == Op::JmpIfNotGtImm { descs[i].op = (char*)"JmpIfNotGtImm"; }
                else { descs[i].op = (char*)"JmpIfNotGeImm"; }
                descs[i].imm = (i64)(i32)(i8)inst.b;
                descs[i].target = (i32)i + inst_bc_i16(f.code[i + 1]) + 2;
                descs[i + 1].op = (char*)"Nop";
                descs[i + 1].target = -1;
            }
        } else if inst.op == Op::Return {
            descs[i].op = (char*)"Return";
            ret_reg = (i32)inst.a;
        } else {
            ok_all = false;
            i = n;
        }
        i = i + 1;
    }
    if !ok_all || ret_reg < 0 {
        dealloc(descs);
        return res;
    }
    let did: int = 0;
    // The global helpers (LoadGlobal/GlobalSet) reach the realm via g_active_ctx,
    // which interpret() sets only for the duration of its own run. This CLI path
    // executes the JIT *outside* interpret(), so set the active ctx ourselves —
    // otherwise the first global op sees a NULL ctx and deopts. (The engine path
    // runs the JIT inside interpret_inner_full, where g_active_ctx is already set.)
    let saved_actx = gc_set_active_ctx(ctx);
    // Frame-back the run on the real reg_stack (J11): the call helper re-derives
    // F's regs base from the top frame after a nested call (a re-entrant call may
    // realloc reg_stack), so the JIT must run on an actual pushed frame, exactly
    // as in the engine path. 0-arg inner fn ⇒ no args to copy.
    let fidx = push_call_frame(ctx, f, NULL, 0, 0);
    let fbase = ctx.frames[fidx].regs_base;
    raw {
        #ifdef ZJS_JIT
        extern void* jit_compile(const void*, int);
        void* code = jit_compile((const void*)descs, (int)n);
        if (code) {
            int deopt = -1;   // J6: -1 = ran to Return; >=0 = deopt at that bc index
            ZjsValue* fr = &ctx->reg_stack[fbase];
            ((void(*)(ZjsValue*, int*))code)(fr, &deopt);
            // A deopt (>=0) means an op met an operand outside its fast domain;
            // the CLI path just reports the interpreter result instead. reg_stack
            // may have relocated during a nested call → re-derive via the index.
            if (deopt < 0) {
                res.val = ctx->reg_stack[fbase + (uint32_t)ret_reg];
                did = 1;
            }
        }
        #endif
    }
    let _rd = pop_call_frame(ctx);
    gc_set_active_ctx(saved_actx);
    if did != 0 { res.ok = 1; }
    dealloc(descs);
    return res;
}

fn main(argc: int, argv: char**) -> int {
    if argc < 2 { return print_usage(); }

    // Trap Ctrl-C / kill so long-running modules (HTTP servers,
    // WebSocket apps, queue workers) can drain on shutdown instead of
    // being torn down mid-handler. The flag is polled inside the
    // event-loop driver; subcommands that don't drive the loop
    // (parse / lex / --version) are unaffected.
    install_signal_handlers();

    // JIT self-test (only present in a ZJS_JIT build; default/iOS builds omit
    // the stitcher entirely). Proves the engine binary contains + runs the
    // copy-and-patch JIT. See docs/jit-impl-notes.md.
    if libc_str::strcmp(argv[1], "jit-selftest") == 0 {
        let pass: int = 0;
        let present: int = 0;
        raw {
            #ifdef ZJS_JIT
            extern int jit_selftest_loop(void);
            present = 1;
            pass = jit_selftest_loop();
            #endif
        }
        if present == 0 {
            raw { printf("jit-selftest: this build has no JIT (rebuild with ZJS_JIT=1)\n"); }
            return 1;
        }
        if pass != 0 { raw { printf("jit-selftest: PASS\n"); } return 0; }
        raw { printf("jit-selftest: FAIL\n"); }
        return 1;
    }

    // jit-check "<expr>": compile, run via interpreter AND via the JIT (when the
    // body is in the supported op subset), and compare. Proves real-bytecode
    // JIT correctness vs the interpreter; BAILs to interpreter-only otherwise.
    if libc_str::strcmp(argv[1], "jit-check") == 0 {
        let src: char* = (char*)"42";
        if argc >= 3 { src = argv[2]; }
        let ctx = zjs_new_context();
        let f = zjs_compile(ctx, src);
        if f == NULL { raw { printf("jit-check: compile failed\n"); } return 1; }
        // Prefer a register-based inner function body (see jit_find_inner_function).
        let target: Function* = f;
        let inner = jit_find_inner_function(f);
        if inner != NULL { target = inner; }
        let do_dump: int = 0;
        raw { do_dump = getenv("JITDUMP") ? 1 : 0; }
        if do_dump != 0 {
            raw { fprintf(stderr, "[dump] code_len=%u regs=%u params=%u\n",
                  (unsigned)target->code_len, (unsigned)target->register_count,
                  (unsigned)target->param_count); }
            let k: u32 = 0;
            while k < (u32)target.code_len {
                let ins = target.code[k];
                let nm = jit_op_name(ins.op);
                raw { fprintf(stderr, "  [%2u] %-15s a=%d b=%d c=%d\n",
                      (unsigned)k, nm, (int)ins.a, (int)ins.b, (int)ins.c); }
                k = k + 1;
            }
        }
        let r = interpret(ctx, target, NULL, 0);
        let jr = jit_try_run(ctx, target);
        if jr.ok == 0 {
            raw { printf("jit-check: BAIL (unsupported ops or non-JIT build)\n"); }
            return 0;
        }
        if jr.val.bits == r.value.bits {
            raw { printf("jit-check: PASS (jit == interp)\n"); }
            return 0;
        }
        raw {
            printf("jit-check: FAIL jit=0x%llx interp=0x%llx\n",
                   (unsigned long long)jr.val.bits, (unsigned long long)r.value.bits);
        }
        return 1;
    }

    // jit-bench "<fn-expr>": time the interpreter vs the JIT on a register-based
    // function body (verifies they agree first, then reports the speedup). The
    // body should be a 0-arg function whose loop stays in the JIT's faithful op
    // subset — e.g. "(function(){ let s=0; for(let i=0;i<1e7;i++) s+=i; return s; })".
    if libc_str::strcmp(argv[1], "jit-bench") == 0 {
        // Default body built in raw{} — a zc string literal containing `{`
        // would trip f-string interpolation (the (char*)"{..." quirk).
        let src: char* = NULL;
        raw { src = (char*)"(function(){ let s=0; for(let i=0;i<10000000;i++){ s+=i; } return s; })"; }
        if argc >= 3 { src = argv[2]; }
        let ctx = zjs_new_context();
        let f = zjs_compile(ctx, src);
        if f == NULL { raw { printf("jit-bench: compile failed\n"); } return 1; }
        let target: Function* = f;
        let inner = jit_find_inner_function(f);
        if inner != NULL { target = inner; }
        // Correctness gate first.
        let ri = interpret(ctx, target, NULL, 0);
        let rj = jit_try_run(ctx, target);
        if rj.ok == 0 { raw { printf("jit-bench: BAIL (body outside JIT subset)\n"); } return 0; }
        if rj.val.bits != ri.value.bits {
            raw { printf("jit-bench: FAIL jit=0x%llx interp=0x%llx\n",
                  (unsigned long long)rj.val.bits, (unsigned long long)ri.value.bits); }
            return 1;
        }
        let K: int = 5;
        let t0 = jit_mono_ns();
        let a: int = 0; while a < K { interpret(ctx, target, NULL, 0); a = a + 1; }
        let t1 = jit_mono_ns();
        let b: int = 0; while b < K { jit_try_run(ctx, target); b = b + 1; }
        let t2 = jit_mono_ns();
        let interp_ns = (t1 - t0) / (u64)K;
        let jit_ns    = (t2 - t1) / (u64)K;
        raw {
            double sp = jit_ns ? (double)interp_ns / (double)jit_ns : 0.0;
            printf("jit-bench: interp=%.2f ms  jit=%.2f ms  speedup=%.2fx  (K=%d, agreed)\n",
                   (double)interp_ns/1e6, (double)jit_ns/1e6, sp, K);
        }
        return 0;
    }

    if libc_str::strcmp(argv[1], "--version") == 0 { return run_version(); }

    if libc_str::strcmp(argv[1], "eval") == 0 {
        let src: char* = (char*)"";
        if argc >= 3 { src = argv[2]; }
        return run_eval(src);
    }

    if libc_str::strcmp(argv[1], "lex") == 0 {
        let src: char* = (char*)"";
        if argc >= 3 { src = argv[2]; }
        return run_lex(src);
    }

    if libc_str::strcmp(argv[1], "parse") == 0 {
        let src: char* = (char*)"";
        if argc >= 3 { src = argv[2]; }
        return run_parse(src);
    }

    if libc_str::strcmp(argv[1], "run") == 0 {
        if argc < 3 { return print_usage(); }
        // Accept `--gc-stats` either before or after the path so
        // `zjs run --gc-stats foo.js` and `zjs run foo.js --gc-stats`
        // both work.
        let path: char* = NULL;
        let gc_stats: bool = false;
        let path_idx: i32 = -1;
        let i: i32 = 2;
        while i < argc {
            if libc_str::strcmp(argv[i], "--gc-stats") == 0 {
                gc_stats = true;
            } else if path == NULL {
                path = argv[i];
                path_idx = i;
            }
            i = i + 1;
        }
        if path == NULL { return print_usage(); }
        // Anything after the script path is forwarded as user argv
        // (process.argv.slice(2) gets these).
        let uargc: u32 = if path_idx + 1 < argc { (u32)(argc - path_idx - 1) } else { 0 };
        let uargv: char** = NULL;
        if uargc > 0 { raw { uargv = &argv[path_idx + 1]; } }
        return run_file_with_argv(path, gc_stats, argv[0], uargc, uargv);
    }
    if libc_str::strcmp(argv[1], "module") == 0 {
        if argc < 3 { return print_usage(); }
        let uargc: u32 = if argc > 3 { (u32)(argc - 3) } else { 0 };
        let uargv: char** = NULL;
        if uargc > 0 { raw { uargv = &argv[3]; } }
        return run_module_file_with_argv(argv[2], argv[0], uargc, uargv);
    }
    if libc_str::strcmp(argv[1], "compile") == 0 {
        // zjs compile <in.js> -o <out.zbc>
        if argc < 5 { return print_usage(); }
        if libc_str::strcmp(argv[3], "-o") != 0 { return print_usage(); }
        return run_compile(argv[2], argv[4]);
    }

    return print_usage();
}
