// zjs CLI — a thin embedder for libzjs plus dev helpers.
//
// Subcommands:
//   --version              print the engine version
//   eval <source>          evaluate source, print the result value
//   lex <source>           tokenize source, dump the token stream
//   parse <source>         parse source, dump the AST as an indented tree

// Platform-native networking (NSURLSession on Apple; WinHTTP / ws_stub
// on Windows; stub elsewhere) plus the portability shims must be
// linked into the CLI binary too, since the CLI is its own `zc build`
// entry point — directives don't propagate via import.
//> macos: framework: Foundation
//> macos: cflags:    -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m
//> ios:   framework: Foundation
//> ios:   cflags:    -fobjc-arc src/platform/http_apple.m src/platform/ws_apple.m
//> linux: cflags:    src/platform/http_stub.c src/platform/ws_stub.c src/platform/http_async.c
//> windows: cflags:  src/platform/http_windows.c src/platform/ws_stub.c src/platform/http_async.c
//> windows: link:    -lbcrypt -lpsapi -lwinhttp

import "../src/lib.zc";
import "string.h" as libc_str;
import "std/mem.zc"

raw {
    #include <stdio.h>
    #include <string.h>
    #include <time.h>
    #include "../src/platform/portability.h"
    #ifdef __APPLE__
    // Avoid including any CoreFoundation header — MacTypes.h's
    // `Duration` typedef collides with zen-c's std/time Duration
    // struct. Forward-declare exactly what we need from CFRunLoop:
    // CFRunLoopRunInMode + kCFRunLoopDefaultMode. Linker resolves
    // them out of CoreFoundation.framework, which is already linked
    // transitively via Foundation.
    typedef const struct __CFString* CFStringRef;
    typedef double CFTimeInterval;
    typedef unsigned char Boolean;
    typedef int32_t SInt32;
    extern const CFStringRef kCFRunLoopDefaultMode;
    extern SInt32 CFRunLoopRunInMode(CFStringRef mode,
                                     CFTimeInterval seconds,
                                     Boolean returnAfterSourceHandled);
    #endif
}

// Wait `ms` milliseconds while letting platform-level dispatch
// queues drain. On Apple this MUST run a CFRunLoop step — NSURLSession's
// async completion handler is dispatched through that runloop, and
// without a tick here the engine never sees fetch() responses arrive.
// Linux/Windows keep nanosleep — their backends (libcurl/WinHTTP) use
// a worker pthread and have no main-runloop dependency.
fn event_loop_wait(ms: i64) -> void {
    raw {
        #ifdef __APPLE__
            double secs = (double)ms / 1000.0;
            CFRunLoopRunInMode(kCFRunLoopDefaultMode, secs, true);
        #else
            struct timespec _ts;
            _ts.tv_sec  = (time_t)(ms / 1000);
            _ts.tv_nsec = (long)((ms % 1000) * 1000000);
            nanosleep(&_ts, NULL);
        #endif
    }
}

// =====================================================================
// Token-kind label table — used by `lex`.
// =====================================================================

fn tk_label(k: TokenKind) -> char* {
    match k {
        TokenKind::Eof => { return (char*)"Eof"; },
        TokenKind::Invalid => { return (char*)"Invalid"; },
        TokenKind::Identifier => { return (char*)"Identifier"; },
        TokenKind::NumberLit => { return (char*)"NumberLit"; },
        TokenKind::StringLit => { return (char*)"StringLit"; },
        TokenKind::KwVar => { return (char*)"KwVar"; },
        TokenKind::KwLet => { return (char*)"KwLet"; },
        TokenKind::KwConst => { return (char*)"KwConst"; },
        TokenKind::KwFunction => { return (char*)"KwFunction"; },
        TokenKind::KwReturn => { return (char*)"KwReturn"; },
        TokenKind::KwIf => { return (char*)"KwIf"; },
        TokenKind::KwElse => { return (char*)"KwElse"; },
        TokenKind::KwFor => { return (char*)"KwFor"; },
        TokenKind::KwWhile => { return (char*)"KwWhile"; },
        TokenKind::KwDo => { return (char*)"KwDo"; },
        TokenKind::KwBreak => { return (char*)"KwBreak"; },
        TokenKind::KwContinue => { return (char*)"KwContinue"; },
        TokenKind::KwClass => { return (char*)"KwClass"; },
        TokenKind::KwExtends => { return (char*)"KwExtends"; },
        TokenKind::KwSuper => { return (char*)"KwSuper"; },
        TokenKind::KwNew => { return (char*)"KwNew"; },
        TokenKind::KwThis => { return (char*)"KwThis"; },
        TokenKind::KwTrue => { return (char*)"KwTrue"; },
        TokenKind::KwFalse => { return (char*)"KwFalse"; },
        TokenKind::KwNull => { return (char*)"KwNull"; },
        TokenKind::KwUndefined => { return (char*)"KwUndefined"; },
        TokenKind::KwTypeof => { return (char*)"KwTypeof"; },
        TokenKind::KwDelete => { return (char*)"KwDelete"; },
        TokenKind::KwVoid => { return (char*)"KwVoid"; },
        TokenKind::KwIn => { return (char*)"KwIn"; },
        TokenKind::KwOf => { return (char*)"KwOf"; },
        TokenKind::KwInstanceof => { return (char*)"KwInstanceof"; },
        TokenKind::KwThrow => { return (char*)"KwThrow"; },
        TokenKind::KwTry => { return (char*)"KwTry"; },
        TokenKind::KwCatch => { return (char*)"KwCatch"; },
        TokenKind::KwFinally => { return (char*)"KwFinally"; },
        TokenKind::KwSwitch => { return (char*)"KwSwitch"; },
        TokenKind::KwCase => { return (char*)"KwCase"; },
        TokenKind::KwDefault => { return (char*)"KwDefault"; },
        TokenKind::KwAsync => { return (char*)"KwAsync"; },
        TokenKind::KwAwait => { return (char*)"KwAwait"; },
        TokenKind::KwYield => { return (char*)"KwYield"; },
        TokenKind::KwImport => { return (char*)"KwImport"; },
        TokenKind::KwExport => { return (char*)"KwExport"; },
        TokenKind::KwFrom => { return (char*)"KwFrom"; },
        TokenKind::KwAs => { return (char*)"KwAs"; },
        TokenKind::LParen => { return (char*)"LParen"; },
        TokenKind::RParen => { return (char*)"RParen"; },
        TokenKind::LBracket => { return (char*)"LBracket"; },
        TokenKind::RBracket => { return (char*)"RBracket"; },
        TokenKind::LBrace => { return (char*)"LBrace"; },
        TokenKind::RBrace => { return (char*)"RBrace"; },
        TokenKind::Comma => { return (char*)"Comma"; },
        TokenKind::Semicolon => { return (char*)"Semicolon"; },
        TokenKind::Colon => { return (char*)"Colon"; },
        TokenKind::Dot => { return (char*)"Dot"; },
        TokenKind::Ellipsis => { return (char*)"Ellipsis"; },
        TokenKind::Arrow => { return (char*)"Arrow"; },
        TokenKind::Tilde => { return (char*)"Tilde"; },
        TokenKind::Question => { return (char*)"Question"; },
        TokenKind::QuestionDot => { return (char*)"QuestionDot"; },
        TokenKind::QuestionQuestion => { return (char*)"QuestionQuestion"; },
        TokenKind::QuestionQuestionEq => { return (char*)"QuestionQuestionEq"; },
        TokenKind::Bang => { return (char*)"Bang"; },
        TokenKind::BangEq => { return (char*)"BangEq"; },
        TokenKind::BangEqEq => { return (char*)"BangEqEq"; },
        TokenKind::Eq => { return (char*)"Eq"; },
        TokenKind::EqEq => { return (char*)"EqEq"; },
        TokenKind::EqEqEq => { return (char*)"EqEqEq"; },
        TokenKind::Lt => { return (char*)"Lt"; },
        TokenKind::LtEq => { return (char*)"LtEq"; },
        TokenKind::LtLt => { return (char*)"LtLt"; },
        TokenKind::LtLtEq => { return (char*)"LtLtEq"; },
        TokenKind::Gt => { return (char*)"Gt"; },
        TokenKind::GtEq => { return (char*)"GtEq"; },
        TokenKind::GtGt => { return (char*)"GtGt"; },
        TokenKind::GtGtEq => { return (char*)"GtGtEq"; },
        TokenKind::GtGtGt => { return (char*)"GtGtGt"; },
        TokenKind::GtGtGtEq => { return (char*)"GtGtGtEq"; },
        TokenKind::Plus => { return (char*)"Plus"; },
        TokenKind::PlusEq => { return (char*)"PlusEq"; },
        TokenKind::PlusPlus => { return (char*)"PlusPlus"; },
        TokenKind::Minus => { return (char*)"Minus"; },
        TokenKind::MinusEq => { return (char*)"MinusEq"; },
        TokenKind::MinusMinus => { return (char*)"MinusMinus"; },
        TokenKind::Star => { return (char*)"Star"; },
        TokenKind::StarEq => { return (char*)"StarEq"; },
        TokenKind::StarStar => { return (char*)"StarStar"; },
        TokenKind::StarStarEq => { return (char*)"StarStarEq"; },
        TokenKind::Slash => { return (char*)"Slash"; },
        TokenKind::SlashEq => { return (char*)"SlashEq"; },
        TokenKind::Percent => { return (char*)"Percent"; },
        TokenKind::PercentEq => { return (char*)"PercentEq"; },
        TokenKind::Amp => { return (char*)"Amp"; },
        TokenKind::AmpAmp => { return (char*)"AmpAmp"; },
        TokenKind::AmpEq => { return (char*)"AmpEq"; },
        TokenKind::AmpAmpEq => { return (char*)"AmpAmpEq"; },
        TokenKind::Pipe => { return (char*)"Pipe"; },
        TokenKind::PipePipe => { return (char*)"PipePipe"; },
        TokenKind::PipeEq => { return (char*)"PipeEq"; },
        TokenKind::PipePipeEq => { return (char*)"PipePipeEq"; },
        TokenKind::Caret => { return (char*)"Caret"; },
        TokenKind::CaretEq => { return (char*)"CaretEq"; },
    }
    return (char*)"?";
}

fn nk_label(k: NodeKind) -> char* {
    match k {
        NodeKind::Program          => { return (char*)"Program"; },
        NodeKind::NumberExpr       => { return (char*)"NumberExpr"; },
        NodeKind::StringExpr       => { return (char*)"StringExpr"; },
        NodeKind::BoolExpr         => { return (char*)"BoolExpr"; },
        NodeKind::NullExpr         => { return (char*)"NullExpr"; },
        NodeKind::UndefinedExpr    => { return (char*)"UndefinedExpr"; },
        NodeKind::ThisExpr         => { return (char*)"ThisExpr"; },
        NodeKind::IdentExpr        => { return (char*)"IdentExpr"; },
        NodeKind::Binary           => { return (char*)"Binary"; },
        NodeKind::Logical          => { return (char*)"Logical"; },
        NodeKind::Unary            => { return (char*)"Unary"; },
        NodeKind::Postfix          => { return (char*)"Postfix"; },
        NodeKind::Conditional      => { return (char*)"Conditional"; },
        NodeKind::Assignment       => { return (char*)"Assignment"; },
        NodeKind::Call             => { return (char*)"Call"; },
        NodeKind::OptionalCall     => { return (char*)"OptionalCall"; },
        NodeKind::New              => { return (char*)"New"; },
        NodeKind::Member           => { return (char*)"Member"; },
        NodeKind::OptionalMember   => { return (char*)"OptionalMember"; },
        NodeKind::Computed         => { return (char*)"Computed"; },
        NodeKind::OptionalComputed => { return (char*)"OptionalComputed"; },
        NodeKind::Sequence         => { return (char*)"Sequence"; },
        NodeKind::Array            => { return (char*)"Array"; },
        NodeKind::Object           => { return (char*)"Object"; },
        NodeKind::ObjectProp       => { return (char*)"ObjectProp"; },
        NodeKind::Paren            => { return (char*)"Paren"; },
        NodeKind::BlockStmt        => { return (char*)"BlockStmt"; },
        NodeKind::VarDecl          => { return (char*)"VarDecl"; },
        NodeKind::Declarator       => { return (char*)"Declarator"; },
        NodeKind::IfStmt           => { return (char*)"IfStmt"; },
        NodeKind::ReturnStmt       => { return (char*)"ReturnStmt"; },
        NodeKind::WhileStmt        => { return (char*)"WhileStmt"; },
        NodeKind::DoWhileStmt      => { return (char*)"DoWhileStmt"; },
        NodeKind::ForStmt          => { return (char*)"ForStmt"; },
        NodeKind::BreakStmt        => { return (char*)"BreakStmt"; },
        NodeKind::ContinueStmt     => { return (char*)"ContinueStmt"; },
        NodeKind::EmptyStmt        => { return (char*)"EmptyStmt"; },
        NodeKind::FunctionDecl     => { return (char*)"FunctionDecl"; },
        NodeKind::FunctionExpr     => { return (char*)"FunctionExpr"; },
        NodeKind::ArrowFunc        => { return (char*)"ArrowFunc"; },
        NodeKind::ForInStmt        => { return (char*)"ForInStmt"; },
        NodeKind::ForOfStmt        => { return (char*)"ForOfStmt"; },
    }
    return (char*)"?";
}

// =====================================================================
// Subcommand bodies.
// =====================================================================

fn run_version() -> int {
    println "zjs {zjs_version()}";
    return 0;
}

// Recursive value printer. `quoted` controls whether top-level strings
// get surrounded by quotes — top-level eval results print without
// quotes (JS-shell style), but strings nested inside arrays/objects
// print with quotes for readability.
fn write_value(v: ZjsValue, quoted: bool) -> void {
    if zjs_is_int32(v) != 0 {
        let n = zjs_as_int32(v);
        raw { printf("%d", n); }
        return;
    }
    if zjs_is_double(v) != 0 {
        let d = zjs_as_double(v);
        raw {
            if (isnan(d)) { fputs("NaN", stdout); }
            else if (isinf(d)) { fputs(d > 0 ? "Infinity" : "-Infinity", stdout); }
            else { printf("%g", d); }
        }
        return;
    }
    if zjs_is_bool(v) != 0 {
        if zjs_as_bool(v) != 0 { raw { fputs("true", stdout); } }
        else                   { raw { fputs("false", stdout); } }
        return;
    }
    if zjs_is_null(v) != 0      { raw { fputs("null", stdout); }      return; }
    if zjs_is_undefined(v) != 0 { raw { fputs("undefined", stdout); } return; }
    if zjs_is_string(v) != 0 {
        let s = zjs_as_string(v);
        let data = s.data;
        let len  = s.length;
        if quoted {
            raw { fputc('"', stdout); fwrite(data, 1, len, stdout); fputc('"', stdout); }
        } else {
            raw { fwrite(data, 1, len, stdout); }
        }
        return;
    }
    if zjs_is_array(v) != 0 {
        let a = zjs_as_array(v);
        raw { fputc('[', stdout); }
        let i: u32 = 0;
        while i < a.length {
            if i > 0 { raw { fputs(", ", stdout); } }
            let slot = a.elements[i];
            // Array holes display as the empty position — print
            // nothing for the slot (the comma separator already
            // appears for non-leading positions).
            if zjs_is_deleted(slot) == 0 {
                write_value(slot, true);
            }
            i = i + 1;
        }
        raw { fputc(']', stdout); }
        return;
    }
    if zjs_is_object(v) != 0 {
        let o = zjs_as_object(v);
        raw { fputs("{ ", stdout); }
        // Hidden-class chain walks leaf->root, which yields reverse-
        // insertion order. Collect into a small stack array, then
        // iterate in reverse to print in insertion order.
        let names:  ZjsString*[32];
        let slots:  u32[32];
        let depth: u32 = 0;
        let c = o.cls;
        while c != NULL && c.parent != NULL && depth < 32 {
            names[depth] = c.transition_name;
            slots[depth] = c.transition_slot;
            depth = depth + 1;
            c = c.parent;
        }
        // Walk in reverse for insertion order.
        let count = depth;
        let i: u32 = 0;
        while i < count {
            let idx = count - 1 - i;
            if i > 0 { raw { fputs(", ", stdout); } }
            let name_data = names[idx].data;
            let name_len  = names[idx].length;
            raw { fwrite(name_data, 1, name_len, stdout); fputs(": ", stdout); }
            write_value(o.slots[slots[idx]], true);
            i = i + 1;
        }
        raw { fputs(" }", stdout); }
        return;
    }
    if zjs_is_function(v) != 0 { raw { fputs("[function]", stdout); } return; }
    if zjs_is_closure(v) != 0 { raw { fputs("[function]", stdout); } return; }
    if zjs_is_host_function(v) != 0 { raw { fputs("[function]", stdout); } return; }
    if zjs_is_promise(v) != 0 {
        let p = zjs_as_promise(v);
        if p.state == PROMISE_PENDING {
            raw { fputs("Promise { <pending> }", stdout); }
        } else if p.state == PROMISE_FULFILLED {
            raw { fputs("Promise { ", stdout); }
            write_value(p.value, true);
            raw { fputs(" }", stdout); }
        } else {
            raw { fputs("Promise { <rejected> ", stdout); }
            write_value(p.value, true);
            raw { fputs(" }", stdout); }
        }
        return;
    }
    raw { fputs("[unknown value]", stdout); }
}

fn print_value(v: ZjsValue) -> void {
    write_value(v, false);
    raw { fputc('\n', stdout); }
}

fn run_eval(source: char*) -> int {
    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 1; }
    defer zjs_free_context(ctx);
    let result = zjs_eval(ctx, source);
    print_value(result);

    // Drain pending async work (timers, microtasks, WebSocket events)
    // so handlers attached during eval get a chance to fire before
    // the process exits. Cap the loop at ~10s of wall time so an
    // accidental infinite stream of events doesn't hang the CLI.
    let max_wall_ms: i64 = 10000;
    let wall_so_far: i64 = 0;
    while zjs_has_pending_work(ctx) != 0 && wall_so_far < max_wall_ms {
        let wait_ms = zjs_next_timer_ms(ctx);
        // No timer? still loop with a short sleep so WS poll can run.
        if wait_ms < 0 || wait_ms > 50 { wait_ms = 50; }
        if wait_ms > 0 {
            event_loop_wait(wait_ms);
            wall_so_far = wall_so_far + wait_ms;
        }
        zjs_run_pending_timers(ctx);
    }
    return 0;
}

// `zjs run <path>`: read the file, eval, exit 0 on no-throw / 1 on
// throw. Used by the test262 conformance runner — it only needs the
// throw/no-throw signal plus, on throw, a short diagnostic.
fn run_module_file(path: char*) -> int {
    // Resolve to an absolute path so relative imports in the module
    // body see a stable base. realpath() returns NULL when the file
    // doesn't exist; fall back to the literal path in that case so
    // we can still surface "module not found" via the loader.
    let abs_buf: char[4096];
    let abs_p: char* = NULL;
    raw {
        abs_p = zjs_realpath(path, &abs_buf[0]);
        if (!abs_p) abs_p = path;
    }
    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 2; }
    defer zjs_free_context(ctx);
    let _ = zjs_eval_module(ctx, abs_p);
    if zjs_had_error(ctx) != 0 {
        let err = zjs_get_error(ctx);
        if zjs_is_object(err) != 0 {
            let o = zjs_as_object(err);
            let name_atom = zjs_string_new((char*)"name", 4);
            let msg_atom  = zjs_string_new((char*)"message", 7);
            let name_v = object_get(o, name_atom);
            let msg_v  = object_get(o, msg_atom);
            raw {
                fputs("zjs: throw: ", stderr);
                if (zjs_is_string(name_v)) {
                    ZjsString* s = zjs_as_string(name_v);
                    fwrite(s->data, 1, s->length, stderr);
                } else {
                    fputs("(unknown)", stderr);
                }
                if (zjs_is_string(msg_v)) {
                    fputs(": ", stderr);
                    ZjsString* s = zjs_as_string(msg_v);
                    fwrite(s->data, 1, s->length, stderr);
                }
                fputc('\n', stderr);
                free(name_atom->data); free(name_atom);
                free(msg_atom->data);  free(msg_atom);
            }
        }
        return 1;
    }
    return 0;
}

// Slurp a file's bytes into a fresh malloc'd buffer + return its
// length. `null_terminate` adds a trailing NUL when true (source
// path); leave it off for bytecode files so the length is precise.
fn slurp_file(path: char*, null_terminate: bool, out_len: usize*) -> char* {
    let fh: void* = NULL;
    raw { fh = (void*)fopen(path, "rb"); }
    if fh == NULL { return NULL; }
    let buf: char* = NULL;
    let len: usize = 0;
    raw {
        FILE* f = (FILE*)fh;
        fseek(f, 0, SEEK_END);
        long sz = ftell(f);
        fseek(f, 0, SEEK_SET);
        if (sz < 0) sz = 0;
        len = (size_t)sz;
        size_t alloc = null_terminate ? len + 1 : (len > 0 ? len : 1);
        buf = (char*)malloc(alloc);
        if (buf) {
            if (len > 0) { fread(buf, 1, len, f); }
            if (null_terminate) { buf[len] = '\0'; }
        }
        fclose(f);
    }
    if buf == NULL { return NULL; }
    if out_len != NULL { out_len[0] = len; }
    return buf;
}

// "ZJSb" magic at the head of every AOT-compiled program file.
fn buf_is_bytecode(buf: char*, len: usize) -> bool {
    if buf == NULL || len < 8 { return false; }
    if (u8)buf[0] != (u8)'Z' { return false; }
    if (u8)buf[1] != (u8)'J' { return false; }
    if (u8)buf[2] != (u8)'S' { return false; }
    if (u8)buf[3] != (u8)'b' { return false; }
    return true;
}

fn report_uncaught_error(ctx: ZjsContext*) -> void {
    let err = zjs_get_error(ctx);
    if zjs_is_string(err) != 0 {
        let s = zjs_as_string(err);
        let sd = s.data;
        let sn = s.length;
        raw { fputs("zjs: throw: ", stderr); fwrite(sd, 1, sn, stderr); fputc('\n', stderr); }
        return;
    }
    if zjs_is_object(err) != 0 {
        let o = zjs_as_object(err);
        let name_atom = zjs_string_new((char*)"name", 4);
        let msg_atom  = zjs_string_new((char*)"message", 7);
        let name_v = object_get(o, name_atom);
        let msg_v  = object_get(o, msg_atom);
        raw {
            fputs("zjs: throw: ", stderr);
            if (zjs_is_string(name_v)) {
                ZjsString* s = zjs_as_string(name_v);
                fwrite(s->data, 1, s->length, stderr);
            } else {
                fputs("(unknown)", stderr);
            }
            if (zjs_is_string(msg_v)) {
                fputs(": ", stderr);
                ZjsString* s = zjs_as_string(msg_v);
                fwrite(s->data, 1, s->length, stderr);
            }
            fputc('\n', stderr);
            free(name_atom->data); free(name_atom);
            free(msg_atom->data);  free(msg_atom);
        }
        return;
    }
    raw { fputs("zjs: throw\n", stderr); }
}

fn run_file(path: char*, gc_stats: bool) -> int {
    let len: usize = 0;
    let buf = slurp_file(path, true, &len);
    if buf == NULL { eprintln "zjs: cannot open file"; return 2; }
    defer dealloc(buf);

    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 2; }
    defer zjs_free_context(ctx);

    // Auto-detect: AOT-compiled bytecode files start with the ZJSb
    // magic; everything else is treated as source. Lets `zjs run x.js`
    // and `zjs run x.zbc` share the same subcommand.
    let rc: int = 0;
    if buf_is_bytecode(buf, len) {
        let f = aot_deserialize_program(ctx, (u8*)buf, len);
        if f == NULL { eprintln "zjs: invalid bytecode file"; return 1; }
        let _ = zjs_run_function(ctx, f);
        if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); rc = 1; }
    } else {
        let _ = zjs_eval(ctx, buf);
        if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); rc = 1; }
    }

    // Event-loop driver — keep running until no timers / microtasks
    // remain. setTimeout / setInterval code stops being a no-op for
    // `zjs run file.js`. nanosleep when the next timer is in the
    // future; fire immediately when due.
    while zjs_has_pending_work(ctx) != 0 {
        let wait_ms = zjs_next_timer_ms(ctx);
        if wait_ms < 0 || wait_ms > 50 { wait_ms = 50; }
        if wait_ms > 0 { event_loop_wait(wait_ms); }
        zjs_run_pending_timers(ctx);
        if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); rc = 1; break; }
    }

    if gc_stats {
        // One-shot dump after the script body + microtask drain. All
        // counters are cumulative across the run; live=cell_count is a
        // snapshot at this moment. peak_rss comes from getrusage
        // ru_maxrss — macOS reports bytes, Linux reports kilobytes;
        // we normalize to megabytes for either platform.
        let n   = zjs_gc_collections(ctx);
        let tot = zjs_gc_pause_ns_total(ctx);
        let mx  = zjs_gc_pause_ns_max(ctx);
        let fr  = zjs_gc_cells_freed(ctx);
        let live = zjs_cell_count(ctx);
        raw {
            uint64_t rss_bytes = zjs_peak_rss_bytes();
            double rss_mb = (double)rss_bytes / (1024.0 * 1024.0);
            fprintf(stderr,
                "[gc] runs=%u  pause_total=%.2fms  pause_max=%.2fms"
                "  freed=%u  live=%u  peak_rss=%.1fMB\n",
                (unsigned)n,
                (double)tot / 1e6,
                (double)mx  / 1e6,
                (unsigned)fr,
                (unsigned)live,
                rss_mb);
        }
    }
    return rc;
}

// `zjs compile <in.js> -o <out.zbc>` — parse + compile source to a
// Function, serialize via the AOT writer, write bytes to disk. The
// resulting file is loadable via `zjs run <out.zbc>` and embeds via
// the zjs_eval_bytecode C ABI.
fn run_compile(in_path: char*, out_path: char*) -> int {
    let len: usize = 0;
    let buf = slurp_file(in_path, true, &len);
    if buf == NULL { eprintln "zjs: cannot open input"; return 2; }
    defer dealloc(buf);

    let ctx = zjs_new_context();
    if ctx == NULL { eprintln "zjs: failed to create context"; return 2; }
    defer zjs_free_context(ctx);

    let f = zjs_compile(ctx, buf);
    if f == NULL {
        if zjs_had_error(ctx) != 0 { report_uncaught_error(ctx); }
        return 1;
    }
    defer function_free(f);

    let w = aot_serialize_program(ctx, f);
    if w == NULL { eprintln "zjs: serialize failed"; return 1; }
    defer aot_writer_free(w);

    let fh: void* = NULL;
    raw { fh = (void*)fopen(out_path, "wb"); }
    if fh == NULL { eprintln "zjs: cannot open output"; return 2; }
    raw {
        FILE* outf = (FILE*)fh;
        fwrite(w->buf, 1, w->len, outf);
        fclose(outf);
    }
    return 0;
}

fn run_lex(source: char*) -> int {
    let len: usize = 0;
    raw { len = strlen(source); }
    let lex = Lexer::new(source, len);
    while true {
        let tok = lex.next_token();
        raw {
            fprintf(stdout, "%-12s  start=%-4u  length=%-4u  text=\"%.*s\"\n",
                    tk_label(tok.kind),
                    (unsigned)tok.start,
                    (unsigned)tok.length,
                    (int)tok.length,
                    source + tok.start);
        }
        if tok.kind == TokenKind::Eof { return 0; }
    }
    return 0;
}

// --- AST tree printer -----------------------------------------------

fn print_indent(depth: int) -> void {
    let i: int = 0;
    while i < depth {
        raw { fputs("  ", stdout); }
        i = i + 1;
    }
}

fn dump_ast(node: AstNode*, source: char*, depth: int) -> void {
    if node == NULL {
        print_indent(depth);
        raw { puts("(null)"); }
        return;
    }
    print_indent(depth);
    let label = nk_label(node.kind);
    // Pull fields into Zen-c locals before crossing into raw {} — raw
    // blocks are pure C and won't auto-deref `node->field`.
    let n_num         = node.num;
    let n_bool        = node.bool_value;
    let n_op_label    = tk_label(node.op);
    let n_start       = node.start;
    let n_end         = node.end;
    let n_name_start  = node.name_start;
    let n_name_length = node.name_length;

    if node.kind == NodeKind::NumberExpr {
        raw { fprintf(stdout, "%s %g\n", label, n_num); }
    } else if node.kind == NodeKind::BoolExpr {
        raw { fprintf(stdout, "%s %s\n", label, n_bool ? "true" : "false"); }
    } else if node.kind == NodeKind::IdentExpr || node.kind == NodeKind::StringExpr {
        raw {
            fprintf(stdout, "%s \"%.*s\"\n", label,
                    (int)(n_end - n_start),
                    source + n_start);
        }
    } else if node.kind == NodeKind::Binary || node.kind == NodeKind::Logical ||
              node.kind == NodeKind::Unary  || node.kind == NodeKind::Postfix ||
              node.kind == NodeKind::Assignment || node.kind == NodeKind::VarDecl {
        raw { fprintf(stdout, "%s op=%s\n", label, n_op_label); }
    } else if node.kind == NodeKind::Member || node.kind == NodeKind::OptionalMember ||
              node.kind == NodeKind::ObjectProp || node.kind == NodeKind::Declarator {
        raw {
            fprintf(stdout, "%s name=\"%.*s\"\n", label,
                    (int)n_name_length,
                    source + n_name_start);
        }
    } else if node.kind == NodeKind::FunctionDecl || node.kind == NodeKind::FunctionExpr {
        if n_name_length > 0 {
            raw {
                fprintf(stdout, "%s name=\"%.*s\"\n", label,
                        (int)n_name_length, source + n_name_start);
            }
        } else {
            raw { fprintf(stdout, "%s (anonymous)\n", label); }
        }
    } else {
        raw { fprintf(stdout, "%s\n", label); }
    }

    // Recurse into named children, then variadic.
    if node.left != NULL  { dump_ast(node.left,  source, depth + 1); }
    if node.right != NULL { dump_ast(node.right, source, depth + 1); }
    if node.third != NULL { dump_ast(node.third, source, depth + 1); }

    let i: u32 = 0;
    while i < node.children_count {
        dump_ast(node.children[i], source, depth + 1);
        i = i + 1;
    }
}

fn run_parse(source: char*) -> int {
    let len: usize = 0;
    raw { len = strlen(source); }
    let result = parse_program(source, len);
    if result.had_error {
        eprintln "zjs: parse error";
        parser_free_result(result);
        return 1;
    }
    dump_ast(result.root, source, 0);
    parser_free_result(result);
    return 0;
}

fn print_usage() -> int {
    eprintln "usage:";
    eprintln "  zjs --version";
    eprintln "  zjs eval <source>                evaluate source";
    eprintln "  zjs run  <file>                  run a .js source or .zbc bytecode file";
    eprintln "  zjs compile <in.js> -o <out.zbc> AOT-compile source to bytecode";
    eprintln "  zjs lex   <source>               dump the token stream";
    eprintln "  zjs parse <source>               dump the AST";
    eprintln "  zjs module <file>                run a file as an ES module";
    return 1;
}

fn main(argc: int, argv: char**) -> int {
    if argc < 2 { return print_usage(); }

    if libc_str::strcmp(argv[1], "--version") == 0 { return run_version(); }

    if libc_str::strcmp(argv[1], "eval") == 0 {
        let src: char* = (char*)"";
        if argc >= 3 { src = argv[2]; }
        return run_eval(src);
    }

    if libc_str::strcmp(argv[1], "lex") == 0 {
        let src: char* = (char*)"";
        if argc >= 3 { src = argv[2]; }
        return run_lex(src);
    }

    if libc_str::strcmp(argv[1], "parse") == 0 {
        let src: char* = (char*)"";
        if argc >= 3 { src = argv[2]; }
        return run_parse(src);
    }

    if libc_str::strcmp(argv[1], "run") == 0 {
        if argc < 3 { return print_usage(); }
        // Accept `--gc-stats` either before or after the path so
        // `zjs run --gc-stats foo.js` and `zjs run foo.js --gc-stats`
        // both work.
        let path: char* = NULL;
        let gc_stats: bool = false;
        let i: i32 = 2;
        while i < argc {
            if libc_str::strcmp(argv[i], "--gc-stats") == 0 {
                gc_stats = true;
            } else if path == NULL {
                path = argv[i];
            }
            i = i + 1;
        }
        if path == NULL { return print_usage(); }
        return run_file(path, gc_stats);
    }
    if libc_str::strcmp(argv[1], "module") == 0 {
        if argc < 3 { return print_usage(); }
        return run_module_file(argv[2]);
    }
    if libc_str::strcmp(argv[1], "compile") == 0 {
        // zjs compile <in.js> -o <out.zbc>
        if argc < 5 { return print_usage(); }
        if libc_str::strcmp(argv[3], "-o") != 0 { return print_usage(); }
        return run_compile(argv[2], argv[4]);
    }

    return print_usage();
}
