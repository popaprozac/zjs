// Opcode names for the bytecode dump. One arm per opcode: the match is
// exhaustive, so adding an opcode without naming it here fails to compile.
import { Op } from "../../engine/bytecode.zs";

export function opName(op: Op): String {
  return match (op) {
    halt => "halt";
    loadConst => "loadConst";
    loadInt => "loadInt";
    loadUndefined => "loadUndefined";
    loadHole => "loadHole";
    throwIfHole => "throwIfHole";
    loadNull => "loadNull";
    loadTrue => "loadTrue";
    loadFalse => "loadFalse";
    mov => "mov";
    defineGlobal => "defineGlobal";
    loadGlobal => "loadGlobal";
    storeGlobal => "storeGlobal";
    loadGlobalOrUndefined => "loadGlobalOrUndefined";
    withEnter => "withEnter";
    withLeave => "withLeave";
    withLookup => "withLookup";
    add => "add";
    sub => "sub";
    mul => "mul";
    div => "div";
    mod => "mod";
    pow => "pow";
    addImm => "addImm";
    subImm => "subImm";
    cmpLtImm => "cmpLtImm";
    cmpLeImm => "cmpLeImm";
    cmpGtImm => "cmpGtImm";
    cmpGeImm => "cmpGeImm";
    bitAnd => "bitAnd";
    bitOr => "bitOr";
    bitXor => "bitXor";
    shl => "shl";
    shr => "shr";
    uShr => "uShr";
    cmpEq => "cmpEq";
    cmpNe => "cmpNe";
    cmpStrictEq => "cmpStrictEq";
    cmpStrictNe => "cmpStrictNe";
    cmpLt => "cmpLt";
    cmpLe => "cmpLe";
    cmpGt => "cmpGt";
    cmpGe => "cmpGe";
    neg => "neg";
    bitNot => "bitNot";
    logicalNot => "logicalNot";
    jmp => "jmp";
    jmpIfTrue => "jmpIfTrue";
    jmpIfFalse => "jmpIfFalse";
    jmpIfNotNullish => "jmpIfNotNullish";
    jmpIfNullish => "jmpIfNullish";
    jmpIfNotLt => "jmpIfNotLt";
    jmpIfNotLe => "jmpIfNotLe";
    jmpIfNotGt => "jmpIfNotGt";
    jmpIfNotGe => "jmpIfNotGe";
    jmpIfNotLtImm => "jmpIfNotLtImm";
    jmpIfNotLeImm => "jmpIfNotLeImm";
    jmpIfNotGtImm => "jmpIfNotGtImm";
    jmpIfNotGeImm => "jmpIfNotGeImm";
    jmpIfNotEq => "jmpIfNotEq";
    jmpIfNotNe => "jmpIfNotNe";
    jmpIfNotStrictEq => "jmpIfNotStrictEq";
    jmpIfNotStrictNe => "jmpIfNotStrictNe";
    returnOp => "returnOp";
    invoke => "invoke";
    tailInvoke => "tailInvoke";
    loadProp => "loadProp";
    storeProp => "storeProp";
    mathSqrt => "mathSqrt";
    mathAbs => "mathAbs";
    mathFloor => "mathFloor";
    mathCeil => "mathCeil";
    iterPrepare => "iterPrepare";
    arrayLength => "arrayLength";
    deleteElem => "deleteElem";
    buildArguments => "buildArguments";
    buildRestArgs => "buildRestArgs";
    importBind => "importBind";
    exportBind => "exportBind";
    dynamicImport => "dynamicImport";
    importMeta => "importMeta";
    awaitOp => "awaitOp";
    yieldOp => "yieldOp";
    generatorStart => "generatorStart";
    templateObject => "templateObject";
    arrayPush => "arrayPush";
    arraySpread => "arraySpread";
    objectSpread => "objectSpread";
    arrayRestFrom => "arrayRestFrom";
    assertCoercible => "assertCoercible";
    iterGet => "iterGet";
    iterGetAsync => "iterGetAsync";
    iterStep => "iterStep";
    iterRestCollect => "iterRestCollect";
    iterClose => "iterClose";
    iterNextRaw => "iterNextRaw";
    spreadInvoke => "spreadInvoke";
    spreadMethodInvoke => "spreadMethodInvoke";
    spreadNewInvoke => "spreadNewInvoke";
    methodInvoke => "methodInvoke";
    tailMethodInvoke => "tailMethodInvoke";
    defineGetter => "defineGetter";
    defineSetter => "defineSetter";
    defineMethodGetter => "defineMethodGetter";
    defineMethodSetter => "defineMethodSetter";
    makeClosure => "makeClosure";
    loadEnv => "loadEnv";
    loadCallee => "loadCallee";
    newRegex => "newRegex";
    newRegexR => "newRegexR";
    newObject => "newObject";
    newArray => "newArray";
    loadElem => "loadElem";
    storeElem => "storeElem";
    throwOp => "throwOp";
    enterTry => "enterTry";
    leaveTry => "leaveTry";
    inOp => "inOp";
    instanceofOp => "instanceofOp";
    loadThis => "loadThis";
    loadNewTarget => "loadNewTarget";
    newInvoke => "newInvoke";
    typeofOp => "typeofOp";
    setProto => "setProto";
    superCall => "superCall";
    defineMethod => "defineMethod";
    defineMethodComputed => "defineMethodComputed";
    setParentCtor => "setParentCtor";
    setFunctionName => "setFunctionName";
    initObjData => "initObjData";
    spreadSuperCall => "spreadSuperCall";
    jmpIfLt => "jmpIfLt";
    jmpIfLe => "jmpIfLe";
    jmpIfGt => "jmpIfGt";
    jmpIfGe => "jmpIfGe";
    jmpIfLtImm => "jmpIfLtImm";
    jmpIfLeImm => "jmpIfLeImm";
    jmpIfGtImm => "jmpIfGtImm";
    jmpIfGeImm => "jmpIfGeImm";
    invokeGlobal => "invokeGlobal";
    privateCheck => "privateCheck";
    throwTypeError => "throwTypeError";
    storeGlobalStrict => "storeGlobalStrict";
    iterCloseQuiet => "iterCloseQuiet";
    jmpIfNotGenReturn => "jmpIfNotGenReturn";
    newEnv => "newEnv";
    loadEnvSlot => "loadEnvSlot";
    storeEnvSlot => "storeEnvSlot";
    objectRest => "objectRest";
    newPrivateName => "newPrivateName";
    defineField => "defineField";
    loadSuper => "loadSuper";
    storeSuper => "storeSuper";
    initClass => "initClass";
    initClassBase => "initClassBase";
    yieldRaw => "yieldRaw";
    envToReg => "envToReg";
    renewEnv => "renewEnv";
    exitEnv => "exitEnv";
    throwConstAssign => "throwConstAssign";
    checkThis => "checkThis";
    yieldDelegate => "yieldDelegate";
    resumeMode => "resumeMode";
    iterNextWith => "iterNextWith";
    iterThrowWith => "iterThrowWith";
    iterReturnWith => "iterReturnWith";
    jmpIfNotReturn => "jmpIfNotReturn";
    iterCallNext => "iterCallNext";
    iterCallThrow => "iterCallThrow";
    iterCallReturn => "iterCallReturn";
    isAbsent => "isAbsent";
    requireIterResult => "requireIterResult";
    inc => "inc";
    dec => "dec";
    toNumeric => "toNumeric";
    bitOrImm => "bitOrImm";
    bitAndImm => "bitAndImm";
    bitXorImm => "bitXorImm";
    shlImm => "shlImm";
    shrImm => "shrImm";
    uShrImm => "uShrImm";
  };
}
